    gamma_arena_test_assert.is_false(failed.ok, "exhausted manual restart is rejected")
    gamma_arena_test_assert.equals(failed.error.code, "GA_FIGHT_INDEX_EXHAUSTED", "manual restart exhaustion code is stable")
    gamma_arena_test_assert.equals(exhausted.orchestrator:runtime_stage_snapshot(), "ACTIVE", "exhausted restart leaves combat active")
    gamma_arena_test_assert.is_false(exhausted.orchestrator.result_action_locked, "exhausted restart does not acquire the action latch")
    gamma_arena_test_assert.equals(exhausted.cleanup_calls, 0, "exhausted restart precedes cleanup")
end

