function runtime_registered_death_owner_tag_failures_route_through_real_callback_router()
    local cases = {
        {
            label = "throw",
            install = function(deps) deps.load_tag = function() error("injected registered victim tag read throw") end end,
            code = "GA_ENTITY_TAG_READ_FAILED"
        },
        {
            label = "Result failure",
            install = function(deps) deps.load_tag = function() return gamma_arena_result.err("GA_TEST_TAG_READ_RESULT", "injected registered victim tag Result failure") end end,
            code = "GA_TEST_TAG_READ_RESULT"
        }
    }
    for _, case in ipairs(cases) do
        local entity_env, entity_deps = fake_entity_environment()
        local adapter = gamma_arena_entity_adapter.new(entity_deps)
        begin_entity_apply(adapter, entity_env, entity_spec(1), "ga_task8_session")
        local applied, active = pump_entity(adapter, entity_env)
        gamma_arena_test_assert.is_true(applied.ok and active.state == "ACTIVE", case.label .. " real adapter reaches ACTIVE")
        local victim_id = active.npcs[1].id
        case.install(entity_deps)

        local env = task8_environment()
        task8_pump_to_active(env)
        env.orchestrator.deps.entities = adapter
        env.orchestrator.deps.teardown = function()
            adapter:cleanup()
            return gamma_arena_result.ok(true)
        end
        local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
        local failed = callbacks.npc_on_death_callback({ id = function() return victim_id end })
        gamma_arena_test_assert.is_false(failed.ok, case.label .. " owner-tag failure remains structured")
        gamma_arena_test_assert.equals(failed.error.code, case.code, case.label .. " preserves the exact owner-tag failure")
        gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, case.label .. " never manufactures a registered death")
        gamma_arena_test_assert.equals(env.fatal_shown, 0, case.label .. " never opens fatal UI inside the death callback")
        callbacks.actor_on_update()
        gamma_arena_test_assert.equals(env.fatal_shown, 1, case.label .. " routes fatal UI on the next actor update")
        gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, case.label .. " enters ERROR")
        gamma_arena_test_assert.is_true(adapter:registry_snapshot().state ~= "ACTIVE", case.label .. " begins common safe cleanup")
    end
end

function runtime_registered_death_mismatching_owner_tag_is_benign()
    local env, deps = fake_entity_environment({ allow_numeric_death = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-owner-mismatch")
