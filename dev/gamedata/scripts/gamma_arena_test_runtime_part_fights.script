    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "RESULT", "failed boundary starts no continuation")
    gamma_arena_test_assert.is_false(env.orchestrator.result_action_locked, "failed boundary rolls back duplicate-action latch")
    gamma_arena_test_assert.equals(env.cleanup_calls, 1, "failed boundary does not restart the already running cleanup")
    gamma_arena_test_assert.equals(env.fatal_shown, 0, "recoverable boundary failure does not replace Result UI with fatal UI")
end

function runtime_manual_restart_reuses_next_fight_once()
    local env = task8_environment(); task8_pump_to_active(env)
    local seed = env.orchestrator.session.session_seed
    local difficulty = env.orchestrator.session.difficulty_id
    local first_fight_id = env.orchestrator.fight_spec:fight_id()
    local accepted = env.orchestrator:restart_arena_action()
    local duplicate = env.orchestrator:restart_arena_action()
    gamma_arena_test_assert.is_true(accepted.ok and accepted.value == true, "manual restart is accepted")
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "duplicate manual restart is inert")
    gamma_arena_test_assert.equals(env.battle_identity_clears, 1, "manual restart hides battle identity immediately and once")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "manual restart enters existing cleanup")
    gamma_arena_test_assert.equals(env.generated, 1, "manual restart creates nothing before cleanup")
    for _ = 1, 5 do env.orchestrator:actor_on_update() end
    gamma_arena_test_assert.equals(env.cleanup_calls, 1, "manual restart cleans once")
    gamma_arena_test_assert.equals(env.reset_actor, 1, "manual restart resets actor once")
    gamma_arena_test_assert.equals(env.orchestrator.session.session_seed, seed, "manual restart preserves seed")
    gamma_arena_test_assert.equals(env.orchestrator.session.difficulty_id, difficulty, "manual restart preserves difficulty")
    gamma_arena_test_assert.equals(env.orchestrator.session.fight_index, 1, "manual restart advances once")
    gamma_arena_test_assert.equals(env.generated, 2, "manual restart generates one replacement FightSpec")
    gamma_arena_test_assert.is_true(env.orchestrator.fight_spec:fight_id() ~= first_fight_id, "manual restart generates a distinct fight")
    gamma_arena_test_assert.equals(#env.battle_identity_models, 1, "replacement identity stays hidden until replacement combat is active")
end

function runtime_manual_restart_inactive_and_exhausted_are_inert()
