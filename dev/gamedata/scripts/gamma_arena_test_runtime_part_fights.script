    local victim_id = active.npcs[1].id
    env.tags[victim_id] = "foreign-session"
    local ignored = adapter:on_npc_death(victim_id)
    gamma_arena_test_assert.is_true(ignored.ok and ignored.value == false, "successful mismatching owner tag is benign")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "mismatching tag does not decrement living count")
end

