    gamma_arena_test_assert.is_true(accepted.ok and accepted.value == true, "victory next owns the transition")
    gamma_arena_test_assert.equals(table.concat(env.ordered_calls, ","), "boundary,clear_result", "input boundary precedes Result UI close")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "locked victory enters cleanup")
end

function runtime_victory_next_boundary_failure_retains_result()
    local env = task8_environment({ boundary_error = true }); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
