local function result_shapes()
    local success = gamma_arena_result.ok("value")
    gamma_arena_test_assert.is_true(success.ok, "Result.ok must set ok=true")
    gamma_arena_test_assert.equals(success.value, "value", "Result.ok must preserve value")

    local failure = gamma_arena_result.err("GA_TEST", "expected failure", { source = "domain" })
    gamma_arena_test_assert.is_false(failure.ok, "Result.err must set ok=false")
    gamma_arena_test_assert.equals(failure.error.code, "GA_TEST", "Result.err must preserve code")
    gamma_arena_test_assert.equals(failure.error.message, "expected failure", "Result.err must preserve message")
    gamma_arena_test_assert.equals(failure.error.context.source, "domain", "Result.err must preserve context")
    gamma_arena_test_assert.is_true(gamma_arena_result.is_ok(success), "Result.is_ok must accept success")
    gamma_arena_test_assert.is_false(gamma_arena_result.is_ok(failure), "Result.is_ok must reject failure")
end

local function log_context_is_safe()
    local hostile_value = setmetatable({}, {
        __tostring = function()
            error("hostile tostring")
        end
    })
    local logged = pcall(gamma_arena_log.info, "GA_TEST_LOG", "context serialization", {
        zeta = hostile_value,
        alpha = "first"
    })
    gamma_arena_test_assert.is_true(logged, "logging must not throw for an unserializable value")
end

local function log_context_key_policy_is_safe()
    local unsupported_key = {}
    local logged = pcall(gamma_arena_log.info, "GA_TEST_LOG_KEYS", "canonical key policy", {
        [1] = "number",
        ["1"] = "string",
        [true] = "boolean",
        [unsupported_key] = "must be skipped"
    })
    gamma_arena_test_assert.is_true(logged, "logging must not depend on unsupported key identity")
end

local function log_native_payload_is_bounded_and_reconstructable()
    local original_printf = printf
    local calls = {}
    printf = function(format, payload)
        calls[#calls + 1] = { format = format, payload = payload }
    end
    local message = string.rep("m", 2600)
    local context_value = string.rep("c", 2600)
    local called, reason = pcall(gamma_arena_log.info, "GA_TEST_LONG", message, { payload = context_value })
    printf = original_printf
    gamma_arena_test_assert.is_true(called, "long logger call remains protected: " .. tostring(reason))
    gamma_arena_test_assert.is_true(#calls > 1, "oversized logical line is split")
    local pieces = {}
    for index, call in ipairs(calls) do
        gamma_arena_test_assert.equals(call.format, "%s", "native logger always uses a constant format")
        gamma_arena_test_assert.is_true(#call.payload <= 1024, "native logger payload stays bounded")
        local part, total, body = string.match(call.payload, "^%[GammaArena%]%[GA_LOG_CHUNK (%d+)/(%d+)%] (.*)$")
        gamma_arena_test_assert.equals(tonumber(part), index, "chunk part is ordered")
        gamma_arena_test_assert.equals(tonumber(total), #calls, "chunk total is stable")
        pieces[#pieces + 1] = body
    end
    local expected = "[GammaArena][GA_TEST_LONG] " .. message
        .. " context={string:7:payload=" .. string.format("%q", context_value) .. "}"
    gamma_arena_test_assert.equals(table.concat(pieces), expected, "chunks reconstruct the complete logical line")
end

local function log_small_payload_remains_one_line()
    local original_printf = printf
    local calls = {}
    printf = function(format, payload) calls[#calls + 1] = { format = format, payload = payload } end
    local called = pcall(gamma_arena_log.info, "GA_TEST_SMALL", "small", { value = true })
    printf = original_printf
    gamma_arena_test_assert.is_true(called, "small logger call remains protected")
    gamma_arena_test_assert.equals(#calls, 1, "small payload remains one native call")
    gamma_arena_test_assert.equals(calls[1].format, "%s", "small payload uses constant format")
    gamma_arena_test_assert.equals(calls[1].payload, "[GammaArena][GA_TEST_SMALL] small context={string:5:value=true}", "small visible line stays exact")
end

local function rng_seed_normalization()
    gamma_arena_test_assert.equals(gamma_arena_rng.normalize_uint32(0), 1, "zero seed")
    gamma_arena_test_assert.equals(gamma_arena_rng.normalize_uint32(1), 1, "one seed")
    gamma_arena_test_assert.equals(gamma_arena_rng.normalize_uint32(2147483646), 2147483646, "maximum Park-Miller state")
    gamma_arena_test_assert.equals(gamma_arena_rng.normalize_uint32(4294967295), 3, "maximum uint32 seed")
end

local function rng_normalizes_non_finite_seed()
    local invalid_seeds = { 0 / 0, math.huge, -math.huge }
    for index = 1, #invalid_seeds do
        local rng = gamma_arena_rng.new(invalid_seeds[index])
        gamma_arena_test_assert.equals(gamma_arena_rng.normalize_uint32(invalid_seeds[index]), 1, "non-finite seed normalization")
        gamma_arena_test_assert.is_true(rng:next_raw() >= 1, "non-finite seed must create a valid Park-Miller state")
    end
end

local function rng_known_sequence()
    local rng = gamma_arena_rng.new(1)
    gamma_arena_test_assert.equals(rng:next_raw(), 48271, "Park-Miller value 1")
    gamma_arena_test_assert.equals(rng:next_raw(), 182605794, "Park-Miller value 2")
    gamma_arena_test_assert.equals(rng:next_raw(), 1291394886, "Park-Miller value 3")
end

local function rng_selection_helpers()
    local rng = gamma_arena_rng.new(1)
    local value = rng:next_int(10, 12)
    gamma_arena_test_assert.is_true(type(value) == "number", "next_int must return a number for a valid range")
    gamma_arena_test_assert.is_true(value >= 10 and value <= 12, "next_int must stay within its range")

    local selected = gamma_arena_rng.new(1):pick({ "a", "b", "c" })
    gamma_arena_test_assert.equals(selected, "b", "pick must return the deterministic selected value")
end

local function rng_rejects_non_finite_bounds()
    local invalid_bounds = { 0 / 0, math.huge, -math.huge }
    for index = 1, #invalid_bounds do
        local invalid = invalid_bounds[index]
        local minimum_result = gamma_arena_rng.new(1):next_int(invalid, 2)
        gamma_arena_test_assert.is_false(minimum_result.ok, "non-finite minimum must fail")
        gamma_arena_test_assert.equals(minimum_result.error.code, "GA_RNG_RANGE_INVALID", "non-finite minimum code")

        local maximum_result = gamma_arena_rng.new(1):next_int(1, invalid)
        gamma_arena_test_assert.is_false(maximum_result.ok, "non-finite maximum must fail")
        gamma_arena_test_assert.equals(maximum_result.error.code, "GA_RNG_RANGE_INVALID", "non-finite maximum code")
    end
end

local function rng_stream_isolation()
    local base = { "skirmish", "stalker", 42, 0, 1, 1, 1 }
    local first_seed = gamma_arena_rng.derive_seed({ base[1], base[2], base[3], base[4], base[5], base[6], base[7], "actor_loadout" })
    local second_seed = gamma_arena_rng.derive_seed({ base[1], base[2], base[3], base[4], base[5], base[6], base[7], "actor_loadout" })
    local other_seed = gamma_arena_rng.derive_seed({ base[1], base[2], base[3], base[4], base[5], base[6], base[7], "enemy_count" })

    gamma_arena_test_assert.equals(gamma_arena_rng.new(first_seed):next_raw(), gamma_arena_rng.new(second_seed):next_raw(), "equal stream keys")
    gamma_arena_test_assert.is_true(gamma_arena_rng.new(first_seed):next_raw() ~= gamma_arena_rng.new(other_seed):next_raw(), "different stream tags")
end

local function state_rejects_forbidden_transition()
    local current = gamma_arena_state_machine.states.IDLE
    local transition = gamma_arena_state_machine.transition(current, gamma_arena_state_machine.events.VICTORY)
    gamma_arena_test_assert.is_false(transition.ok, "forbidden transition must fail")
    gamma_arena_test_assert.equals(transition.error.code, "GA_STATE_TRANSITION_INVALID", "forbidden transition error")
    gamma_arena_test_assert.equals(current, gamma_arena_state_machine.states.IDLE, "transition must not mutate current state")
end

local function state_happy_path()
    local machine = gamma_arena_state_machine
    local current = machine.states.IDLE
    local events = {
        machine.events.START,
        machine.events.PREFLIGHT_SUCCEEDED,
        machine.events.CHECKPOINT_SUCCEEDED,
        machine.events.PREPARATION_SUCCEEDED,
        machine.events.COUNTDOWN_FINISHED,
        machine.events.VICTORY
    }

    for index = 1, #events do
        local transition = machine.transition(current, events[index])
        gamma_arena_test_assert.is_true(transition.ok, "happy-path transition " .. index)
        current = transition.value
    end
    gamma_arena_test_assert.equals(current, machine.states.RESULT, "happy path must reach RESULT")
end

local function catalog_loads_v1()
    local loaded = gamma_arena_catalog.load(gamma_arena_test_generator.fixture_factory())
    gamma_arena_test_assert.is_true(loaded.ok, "catalog fixture must load")
    gamma_arena_test_assert.equals(#loaded.value.difficulty_ids, 4, "all four difficulty ids load")
end

local function generator_is_deterministic_and_valid()
    local catalogs = gamma_arena_catalog.load(gamma_arena_test_generator.fixture_factory()).value
    local request = { session_seed = 1, mode_id = "skirmish", difficulty_id = "stalker", layout_id = "rostok_arena_v1" }
    local resolved = gamma_arena_test_generator.fixture_resolved_layout(catalogs)
    local first = gamma_arena_generator.generate(request, 0, catalogs, resolved)
    local second = gamma_arena_generator.generate(request, 0, catalogs, resolved)
    gamma_arena_test_assert.is_true(first.ok and second.ok, "generator must return a FightSpec")
    gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first.value), gamma_arena_generator.stable_encode(second.value), "same request must encode identically")
    gamma_arena_test_assert.is_true(gamma_arena_validator.validate(first.value, catalogs, resolved).ok, "generated FightSpec must validate")
end

local cases = {
    { name = "result_shapes", fn = result_shapes },
    { name = "log_context_is_safe", fn = log_context_is_safe },
    { name = "log_context_key_policy_is_safe", fn = log_context_key_policy_is_safe },
    { name = "log_native_payload_is_bounded_and_reconstructable", fn = log_native_payload_is_bounded_and_reconstructable },
    { name = "log_small_payload_remains_one_line", fn = log_small_payload_remains_one_line },
    { name = "rng_seed_normalization", fn = rng_seed_normalization },
    { name = "rng_normalizes_non_finite_seed", fn = rng_normalizes_non_finite_seed },
    { name = "rng_known_sequence", fn = rng_known_sequence },
    { name = "rng_selection_helpers", fn = rng_selection_helpers },
    { name = "rng_rejects_non_finite_bounds", fn = rng_rejects_non_finite_bounds },
    { name = "rng_stream_isolation", fn = rng_stream_isolation },
    { name = "state_rejects_forbidden_transition", fn = state_rejects_forbidden_transition },
    { name = "state_happy_path", fn = state_happy_path }
    , { name = "catalog_loads_v1", fn = catalog_loads_v1 }
    , { name = "generator_is_deterministic_and_valid", fn = generator_is_deterministic_and_valid }
}

function run(run_case_fn)
    local all_passed = true
    for index = 1, #cases do
        local case = cases[index]
        if not run_case_fn(case.name, case.fn) then
            all_passed = false
        end
    end
    if not gamma_arena_test_generator.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_catalog_discovery.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_rank_catalog.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_item_catalog.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_custom_config.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_custom_generator.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_layout_adapter.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_migrations.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_fight_spec.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_audio.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_runtime.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_tactical_director.run(run_case_fn) then
        all_passed = false
    end
    if not gamma_arena_test_tactical_adapter.run(run_case_fn) then
        all_passed = false
    end
    return all_passed
end
