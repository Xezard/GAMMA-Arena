    return gamma_arena_test_runtime_part_preflight.clone(...)
end

local function catalogs(...)
    return gamma_arena_test_runtime_part_preflight.catalogs(...)
end

local function fake_store(...)
    return gamma_arena_test_runtime_part_lifecycle.fake_store(...)
end

local function fake_orchestrator_deps(...)
    return gamma_arena_test_runtime_part_lifecycle.fake_orchestrator_deps(...)
end

local function task8_environment(...)
    return gamma_arena_test_runtime_part_fights.task8_environment(...)
end

local function task8_pump_to_active(...)
    return gamma_arena_test_runtime_part_fights.task8_pump_to_active(...)
end

local function task8_pump_integrity_retry_to_active(...)
    return gamma_arena_test_runtime_part_fights.task8_pump_integrity_retry_to_active(...)
