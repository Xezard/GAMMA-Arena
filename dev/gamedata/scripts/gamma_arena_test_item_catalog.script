local function copy_array(values)
    local copied = {}
    for index, value in ipairs(values) do copied[index] = value end
    return copied
end

local function reverse(values)
    local result = {}
    for index = #values, 1, -1 do result[#result + 1] = values[index] end
    return result
end

local function base_sections()
    local function item(kind, cost, weight, slot, x, y, width, height, class)
        return {
            kind = kind, cost = tostring(cost), inv_weight = tostring(weight), slot = tostring(slot),
            inv_grid_x = tostring(x), inv_grid_y = tostring(y), inv_grid_width = tostring(width),
            inv_grid_height = tostring(height), class = class, inv_name = "st_fixture_name",
            ["$spawn"] = "fixture\\" .. class
        }
    end
    local sections = {
        wpn_alpha = item("w_rifle", 4000, 3.2, 2, 1, 2, 5, 2, "WP_AK74"),
        wpn_beta = item("w_pistol", 3500, 1.1, 1, 2, 3, 2, 1, "WP_PM"),
        wpn_gamma = item("w_smg", 7001, 2.4, 1, 3, 4, 4, 2, "WP_LR300"),
        wpn_delta = item("w_shotgun", 6000, 3.8, 2, 4, 5, 5, 2, "WP_BM16"),
        ammo_alpha_fmj = item("w_ammo", 1000, 0.3, 0, 5, 6, 2, 1, "AMMO_S"),
        ammo_alpha_ap = item("w_ammo", 1200, 0.3, 0, 6, 6, 2, 1, "AMMO_S"),
        outfit_field = item("o_medium", 5000, 6.25, 6, 7, 8, 2, 3, "E_STLK"),
        helmet_closed = item("o_helmet", 2000, 1.5, 12, 8, 9, 2, 2, "E_HLMET"),
        wpn_knife = item("w_melee", 1000, 0.182, 0, 9, 10, 2, 1, "WP_KNIFE"),
        medkit = item(nil, 1500, 0.4, 0, 10, 11, 1, 1, "II_MEDKI"),
        wpn_zero = item("w_rifle", 3000, 3, 2, 11, 12, 5, 2, "WP_AK74"),
        wpn_no_icon = item("w_rifle", 3000, 3, 2, 12, 13, 5, 2, "WP_AK74"),
        wpn_unspawnable = item("w_rifle", 3000, 3, 2, 13, 14, 5, 2, "SCRPTART"),
        wpn_weightless = item("w_rifle", 3000, 0, 2, 14, 15, 5, 2, "WP_AK74"),
        wpn_story = item("w_rifle", 4000, 3.2, 2, 15, 16, 5, 2, "WP_AK74")
    }
    sections.wpn_alpha.ammo_class = "ammo_alpha_ap, ammo_alpha_fmj"
    sections.wpn_beta.ammo_class = "ammo_alpha_fmj"
    sections.wpn_gamma.ammo_class = "ammo_alpha_fmj"
    sections.wpn_delta.ammo_class = "ammo_alpha_ap"
    sections.wpn_zero.ammo_class = "ammo_alpha_fmj"
    sections.wpn_no_icon.ammo_class = "ammo_alpha_fmj"
    sections.wpn_no_icon.inv_grid_width = nil
    sections.wpn_unspawnable.ammo_class = "ammo_alpha_fmj"
    sections.wpn_unspawnable["$spawn"] = nil
    sections.wpn_weightless.ammo_class = "ammo_alpha_fmj"
    sections.wpn_story.ammo_class = "ammo_alpha_fmj"
    sections.wpn_story.story_id = "pri_a17_gauss_rifle"
    sections.ammo_alpha_fmj.box_size = "30"
    sections.ammo_alpha_ap.box_size = "20"
    sections.outfit_field.helmet_avaliable = "false"
    sections.outfit_field.additional_inventory_weight = "6.5"
    return sections
end

local function base_loadouts(no_anchors)
    if no_anchors then return { shared = { wpn_zero = "false,1,0" } } end
    return {
        shared = {
            wpn_alpha = "true,3,100", wpn_beta = "true,2,70", wpn_delta = "true,1,60",
            ammo_alpha_fmj = "true,3,30", ammo_alpha_ap = "true,2,24",
            outfit_field = "true,1,50", helmet_closed = "true,1,20", wpn_knife = "false,1,10",
            medkit = "true,2,30", wpn_zero = "false,1,0", wpn_no_icon = "true,1,30",
            wpn_unspawnable = "true,1,30", wpn_weightless = "true,1,30"
        },
        stalker_loadout = { wpn_alpha = "true,1,40" }
    }
end

local function rank_catalog(options)
    local threat = options and options.rank_threat or 100
    return {
        base_budget = 600,
        max_entries = 64,
        max_physical_items_per_participant = options and options.physical_item_cap or 256,
        rank_ids = { "novice", "legend" },
        ranks = {
            novice = { id = "novice", minimum = 0, maximum = 99, threat = threat },
            legend = { id = "legend", minimum = 700, maximum = 899, threat = 400 }
        },
        faction_ids = { "stalker" },
        factions = {
            stalker = {
                id = "stalker", community = "stalker",
                ranks = {
                    novice = {
                        id = "novice", alias = "gamma_arena_stalker_novice",
                        profile_section = "sim_default_stalker_0", community = "stalker",
                        minimum = 0, maximum = 99, loadout_section = "stalker_novice",
                        primary_weapons = { "wpn_alpha" }, secondary_weapons = { "wpn_beta" }, threat = threat
                    },
                    legend = {
                        id = "legend", alias = "gamma_arena_stalker_legend",
                        profile_section = "sim_default_stalker_4", community = "stalker",
                        minimum = 700, maximum = 899, loadout_section = "stalker_legend",
                        primary_weapons = { "wpn_delta" }, secondary_weapons = { "wpn_beta" }, threat = 400
                    }
                }
            }
        }
    }
end

local function legacy_catalog()
    return {
        selection_mode = "dynamic",
        weapon_list = { { section = "wpn_alpha", slot = 2 } },
        medical_item_list = {
            { section = "medkit", category = "health", actor_cost = 3, npc_cost = 2, min_tier = 1, max_count = 1 }
        },
        difficulties = { rookie = { id = "rookie" } },
        generator_version = 7
    }
end

local function fixture_source(options)
    options = options or {}
    local sections = base_sections()
    if options.remove_section ~= nil then sections[options.remove_section] = nil end
    if options.weight ~= nil then sections.wpn_alpha.inv_weight = tostring(options.weight) end
    if options.slot ~= nil then sections.wpn_alpha.slot = tostring(options.slot) end
    if options.ammo_class ~= nil then sections.wpn_alpha.ammo_class = options.ammo_class end
    if options.helmet_avaliable ~= nil then sections.outfit_field.helmet_avaliable = options.helmet_avaliable end
    if options.carry_bonus ~= nil then sections.outfit_field.additional_inventory_weight = tostring(options.carry_bonus) end
    if options.localized_name ~= nil then sections.wpn_alpha.inv_name = options.localized_name end
    if options.spawn_path ~= nil then sections.wpn_alpha["$spawn"] = options.spawn_path end
    local order = {}
    for section in pairs(sections) do order[#order + 1] = section end
    table.sort(order)
    if options.reverse_enumeration then order = reverse(order) end
    local loadouts = { sections = base_loadouts(options.no_anchors) }
    return {
        open_rules = function()
            return { sections = { price_overrides = { wpn_beta = tostring(options.override_price or 55) } } }
        end,
        enumerate_system_sections = function() return copy_array(order) end,
        read_system_string = function(section, key)
            local values = sections[section]
            return values and values[key] or nil
        end,
        read_system_number = function(section, key)
            local values = sections[section]
            return values and tonumber(values[key]) or nil
        end,
        section_spawnable = function(section)
            local values = sections[section]
            return values ~= nil and type(values["$spawn"]) == "string" and values["$spawn"] ~= ""
        end,
        open_loadouts = function() return loadouts end,
        enumerate_loadout_sections = function()
            local values = { "shared", "stalker_loadout" }
            return options.reverse_enumeration and reverse(values) or values
        end,
        enumerate_loadout_keys = function(_, section)
            local values = {}
            for key in pairs(loadouts.sections[section] or {}) do values[#values + 1] = key end
            table.sort(values)
            return options.reverse_enumeration and reverse(values) or values
        end,
        read_loadout_string = function(_, section, key)
            local values = loadouts.sections[section]
            return values and values[key] or nil
        end,
        read_base_carry_weight = function() return 50 end
    }
end

local function assert_item_catalog(options)
    options = options or {}
    local legacy = legacy_catalog()
    local loaded = gamma_arena_item_catalog.load(fixture_source(options), legacy, rank_catalog(options))
    gamma_arena_test_assert.is_true(loaded.ok, "item catalog fixture must load")
    return loaded.value, legacy
end

local function assert_array_same(actual, expected, message)
    gamma_arena_test_assert.equals(#actual, #expected, message .. " length")
    for index, value in ipairs(expected) do
        gamma_arena_test_assert.equals(actual[index], value, message .. " item")
    end
end

local function prices_and_classifies_installed_items()
    local catalog = assert_item_catalog()
    gamma_arena_test_assert.equals(catalog.max_physical_items_per_participant, 256, "authoritative physical item cap")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.category, "weapon", "weapon category")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.price, 40, "maximum GAMMA per-item price")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.price_origin, "gamma", "GAMMA price origin")
    gamma_arena_test_assert.equals(catalog.items.wpn_beta.price, 55, "Arena override")
    gamma_arena_test_assert.equals(catalog.items.wpn_beta.price_origin, "override", "override price origin")
    gamma_arena_test_assert.equals(catalog.items.wpn_gamma.price, 75, "derived price rounds upward")
    gamma_arena_test_assert.equals(catalog.items.wpn_gamma.price_origin, "derived", "derived price origin")
    assert_array_same(catalog.items.wpn_alpha.ammo_sections, { "ammo_alpha_ap", "ammo_alpha_fmj" }, "sorted compatible ammo")
    gamma_arena_test_assert.equals(catalog.items.helmet_closed.category, "helmet", "helmet category")
    gamma_arena_test_assert.equals(catalog.items.ammo_alpha_ap.category, "ammo", "ammo category")
    gamma_arena_test_assert.equals(catalog.items.outfit_field.category, "outfit", "outfit category")
    gamma_arena_test_assert.equals(catalog.items.wpn_knife.category, "knife", "knife category")
    gamma_arena_test_assert.equals(catalog.items.medkit.category, "medicine", "medicine category")
    gamma_arena_test_assert.is_true(catalog.items.medkit.healing, "accepted health medicine heals")
end

local function exposes_physical_metadata_and_legacy_fields()
    local catalog, legacy = assert_item_catalog()
    gamma_arena_test_assert.is_true(catalog.weapon_list == legacy.weapon_list, "legacy random weapon semantics are retained")
    gamma_arena_test_assert.is_true(catalog.difficulties == legacy.difficulties, "legacy random difficulty semantics are retained")
    gamma_arena_test_assert.equals(catalog.selection_mode, legacy.selection_mode, "legacy selection mode is retained")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.weight_mg, 3200, "weight uses integer milligrams")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.ltx_slot, 2, "effective LTX slot is retained")
    gamma_arena_test_assert.equals(catalog.items.ammo_alpha_ap.box_size, 20, "ammo box size is retained")
    gamma_arena_test_assert.is_false(catalog.items.outfit_field.helmet_allowed, "outfit helmet compatibility is retained")
    gamma_arena_test_assert.equals(catalog.items.outfit_field.carry_bonus_mg, 6500, "outfit carry bonus uses milligrams")
    gamma_arena_test_assert.equals(catalog.base_carry_weight, 50000, "actor carry capacity uses milligrams")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.icon.x, 1, "icon x is retained")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.icon.height, 2, "icon height is retained")
    gamma_arena_test_assert.equals(catalog.ranks.novice.threat, 100, "rank metadata is exposed")
    gamma_arena_test_assert.equals(catalog.factions.stalker.community, "stalker", "faction metadata is exposed")
    gamma_arena_test_assert.equals(#catalog.item_ids, 10, "only valid combat items are exposed")
end

local function rejects_invalid_and_zero_price_candidates()
    local catalog = assert_item_catalog()
    for _, section in ipairs({ "wpn_zero", "wpn_no_icon", "wpn_unspawnable", "wpn_weightless" }) do
        gamma_arena_test_assert.equals(catalog.items[section], nil, "invalid candidate is rejected: " .. section)
    end
end

local function excludes_story_items()
    local catalog = assert_item_catalog()
    gamma_arena_test_assert.equals(catalog.items.wpn_story, nil, "supported story item is rejected")
end

local function fingerprint_changes_for_semantic_mutations()
    local baseline = assert_item_catalog()
    for _, mutation in ipairs({
        { remove_section = "wpn_gamma" }, { override_price = 60 }, { weight = 3.3 }, { slot = 1 },
        { ammo_class = "ammo_alpha_fmj" }, { helmet_avaliable = "true" }, { carry_bonus = 7 },
        { spawn_path = "fixture\\changed" }, { rank_threat = 101 }, { physical_item_cap = 255 }
    }) do
        local changed = assert_item_catalog(mutation)
        gamma_arena_test_assert.is_true(changed.fingerprint ~= baseline.fingerprint, "semantic mutation changes fingerprint")
    end
    gamma_arena_test_assert.is_true(string.match(baseline.fingerprint, "^ga%-catalog%-v8%-%x%x%x%x%x%x%x%x$") ~= nil, "fingerprint format")
end

local function fingerprint_is_canonical_and_excludes_localized_names()
    local baseline = assert_item_catalog()
    local shuffled = assert_item_catalog({ reverse_enumeration = true })
    local renamed = assert_item_catalog({ localized_name = "st_translated_fixture_name" })
    gamma_arena_test_assert.equals(shuffled.fingerprint, baseline.fingerprint, "enumeration order is canonical")
    gamma_arena_test_assert.equals(renamed.fingerprint, baseline.fingerprint, "localized names are excluded")
end

local function rejects_unavailable_median_anchors()
    local loaded = gamma_arena_item_catalog.load(fixture_source({ no_anchors = true }), legacy_catalog(), rank_catalog())
    gamma_arena_test_assert.is_false(loaded.ok, "catalog without positive price anchors fails closed")
    gamma_arena_test_assert.equals(loaded.error.code, "GA_ITEM_CATALOG_PRICE_ANCHOR_MISSING", "missing anchor code")
end

local cases = {
    { name = "item_catalog_prices_and_classifies_installed_items", fn = prices_and_classifies_installed_items },
    { name = "item_catalog_exposes_physical_metadata_and_legacy_fields", fn = exposes_physical_metadata_and_legacy_fields },
    { name = "item_catalog_rejects_invalid_and_zero_price_candidates", fn = rejects_invalid_and_zero_price_candidates },
    { name = "item_catalog_excludes_story_items", fn = excludes_story_items },
    { name = "item_catalog_fingerprint_changes_for_semantic_mutations", fn = fingerprint_changes_for_semantic_mutations },
    { name = "item_catalog_fingerprint_is_canonical_and_excludes_localized_names", fn = fingerprint_is_canonical_and_excludes_localized_names },
    { name = "item_catalog_rejects_unavailable_median_anchors", fn = rejects_unavailable_median_anchors }
}

function run(run_case_fn)
    local all_passed = true
    for _, case in ipairs(cases) do
        if not run_case_fn(case.name, case.fn) then all_passed = false end
    end
    return all_passed
end
