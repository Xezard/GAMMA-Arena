local function copy_array(values)
    local copied = {}
    for index, value in ipairs(values) do copied[index] = value end
    return copied
end

local function reverse(values)
    local result = {}
    for index = #values, 1, -1 do result[#result + 1] = values[index] end
    return result
end

local function base_sections()
    local function item(kind, cost, weight, slot, x, y, width, height, class)
        return {
            kind = kind, cost = tostring(cost), inv_weight = tostring(weight), slot = tostring(slot),
            inv_grid_x = tostring(x), inv_grid_y = tostring(y), inv_grid_width = tostring(width),
            inv_grid_height = tostring(height), class = class, inv_name = "st_fixture_name",
            ["$spawn"] = "fixture\\" .. class
        }
    end
    local sections = {
        wpn_alpha = item("w_rifle", 4000, 3.2, 2, 1, 2, 5, 2, "WP_AK74"),
        wpn_beta = item("w_pistol", 3500, 1.1, 1, 2, 3, 2, 1, "WP_PM"),
        wpn_gamma = item("w_smg", 7001, 2.4, 1, 3, 4, 4, 2, "WP_LR300"),
        wpn_delta = item("w_shotgun", 6000, 3.8, 2, 4, 5, 5, 2, "WP_BM16"),
        ammo_alpha_fmj = item("w_ammo", 1000, 0.3, 0, 5, 6, 2, 1, "AMMO_S"),
        ammo_alpha_ap = item("w_ammo", 1200, 0.3, 0, 6, 6, 2, 1, "AMMO_S"),
        outfit_field = item("o_medium", 5000, 6.25, 6, 7, 8, 2, 3, "E_STLK"),
        helmet_closed = item("o_helmet", 2000, 1.5, 12, 8, 9, 2, 2, "E_HLMET"),
        wpn_knife = item("w_melee", 1000, 0.182, 0, 9, 10, 2, 1, "WP_KNIFE"),
        medkit = item(nil, 1500, 0.4, 0, 10, 11, 1, 1, "II_MEDKI"),
        wpn_zero = item("w_rifle", 3000, 3, 2, 11, 12, 5, 2, "WP_AK74"),
        wpn_no_icon = item("w_rifle", 3000, 3, 2, 12, 13, 5, 2, "WP_AK74"),
        wpn_unspawnable = item("w_rifle", 3000, 3, 2, 13, 14, 5, 2, "SCRPTART"),
        wpn_weightless = item("w_rifle", 3000, 0, 2, 14, 15, 5, 2, "WP_AK74"),
        wpn_story = item("w_rifle", 4000, 3.2, 2, 15, 16, 5, 2, "WP_AK74")
    }
    sections.wpn_alpha.ammo_class = "ammo_alpha_ap, ammo_alpha_fmj"
    sections.wpn_beta.ammo_class = "ammo_alpha_fmj"
    sections.wpn_gamma.ammo_class = "ammo_alpha_fmj"
    sections.wpn_delta.ammo_class = "ammo_alpha_ap"
    sections.wpn_zero.ammo_class = "ammo_alpha_fmj"
    sections.wpn_no_icon.ammo_class = "ammo_alpha_fmj"
    sections.wpn_no_icon.inv_grid_width = nil
    sections.wpn_unspawnable.ammo_class = "ammo_alpha_fmj"
    sections.wpn_unspawnable["$spawn"] = nil
    sections.wpn_weightless.ammo_class = "ammo_alpha_fmj"
    sections.wpn_story.ammo_class = "ammo_alpha_fmj"
    sections.wpn_story.story_id = "pri_a17_gauss_rifle"
    sections.ammo_alpha_fmj.box_size = "30"
    sections.ammo_alpha_ap.box_size = "20"
    sections.outfit_field.helmet_avaliable = "false"
    sections.outfit_field.additional_inventory_weight = "6.5"
    sections.device_torch_dummy = item(nil, 1000, 0.2, 9, 16, 17, 1, 1, 'TORCH_S')
    sections.device_torch_nv_1 = item(nil, 2000, 0.25, 9, 17, 17, 1, 1, 'TORCH_S')
    sections.device_torch_nv_2 = item(nil, 3000, 0.3, 9, 18, 17, 1, 1, 'TORCH_S')
    sections.device_torch_nv_3 = item(nil, 4000, 0.35, 9, 19, 17, 1, 1, 'TORCH_S')
    sections.device_torch_nv_1.nv_effect = 'nightvision_1'
    sections.device_torch_nv_2.nv_effect = 'nightvision_2'
    sections.device_torch_nv_3.nv_effect = 'nightvision_3'
    return sections
end

local function base_loadouts(no_anchors)
    if no_anchors then return { shared = { wpn_zero = "false,1,0" } } end
    return {
        shared = {
            wpn_alpha = "true,3,100", wpn_beta = "true,2,70", wpn_delta = "true,1,60",
            ammo_alpha_fmj = "true,3,30", ammo_alpha_ap = "true,2,24",
            outfit_field = "true,1,50", helmet_closed = "true,1,20", wpn_knife = "false,1,10",
            medkit = "true,2,30", wpn_zero = "false,1,0", wpn_no_icon = "true,1,30",
            wpn_unspawnable = "true,1,30", wpn_weightless = "true,1,30"
        },
        stalker_loadout = { wpn_alpha = "true,1,40" }
    }
end

local function rank_catalog(options)
    local threat = options and options.rank_threat or 100
    local catalog = {
        base_budget = 600,
        max_entries = 64,
        max_physical_items_per_participant = options and options.physical_item_cap or 256,
        max_selected_grenades = 2,
        max_quantity_per_grenade = 1,
        second_grenade_price_multiplier = 2,
        rank_ids = { "novice", "legend" },
        ranks = {
            novice = { id = "novice", minimum = 0, maximum = 99, threat = threat },
            legend = { id = "legend", minimum = 700, maximum = 899, threat = 400 }
        },
        faction_ids = { "stalker" },
        factions = {
            stalker = {
                id = "stalker", community = "stalker",
                ranks = {
                    novice = {
                        id = "novice", alias = "gamma_arena_stalker_novice",
                        profile_section = "sim_default_stalker_0", community = "stalker",
                        minimum = 0, maximum = 99, loadout_section = "stalker_novice",
                        primary_weapons = { "wpn_alpha" }, secondary_weapons = { "wpn_beta" }, threat = threat
                    },
                    legend = {
                        id = "legend", alias = "gamma_arena_stalker_legend",
                        profile_section = "sim_default_stalker_4", community = "stalker",
                        minimum = 700, maximum = 899, loadout_section = "stalker_legend",
                        primary_weapons = { "wpn_delta" }, secondary_weapons = { "wpn_beta" }, threat = 400
                    }
                }
            }
        }
    }
    if options and options.physically_rejected_pool_member then
        catalog.factions.stalker.ranks.legend.primary_weapons[#catalog.factions.stalker.ranks.legend.primary_weapons + 1] = "wpn_unspawnable"
    end
    return catalog
end

local function legacy_catalog()
    local function weapon(section, ammo, slot)
        return {
            section = section, ammo = ammo, cost = 5, ammo_box_min = 1,
            ammo_box_max = 2, kind = slot == 1 and "w_pistol" or "w_rifle",
            slot = slot
        }
    end
    return {
        selection_mode = "dynamic",
        weapon_list = {
            weapon("wpn_alpha", "ammo_alpha_fmj", 2),
            weapon("wpn_beta", "ammo_alpha_fmj", 1),
            weapon("wpn_delta", "ammo_alpha_ap", 2),
            weapon("wpn_unspawnable", "ammo_alpha_fmj", 2)
        },
        ammo = {
            ammo_alpha_fmj = { section = "ammo_alpha_fmj", cost = 1 },
            ammo_alpha_ap = { section = "ammo_alpha_ap", cost = 1 }
        },
        medical_item_list = {
            { section = "medkit", category = "health", actor_cost = 3, npc_cost = 2, min_tier = 1, max_count = 1 }
        },
        difficulties = { rookie = { id = "rookie" } },
        devices = {
            headlamp={id='headlamp',section='device_torch_dummy',kind='headlamp',selection_weight=50,nv_effect=nil},
            nv_gen1={id='nv_gen1',section='device_torch_nv_1',kind='gen1',selection_weight=25,nv_effect='nightvision_1'},
            nv_gen2={id='nv_gen2',section='device_torch_nv_2',kind='gen2',selection_weight=18,nv_effect='nightvision_2'},
            nv_gen3={id='nv_gen3',section='device_torch_nv_3',kind='gen3',selection_weight=7,nv_effect='nightvision_3'}
        },
        generator_version = 7
    }
end

local function fixture_source(options)
    options = options or {}
    local sections = base_sections()
    for index = 1, (options.irrelevant_section_count or 0) do
        sections["zone_fixture_" .. tostring(index)] = { kind = "zone" }
    end
    if options.remove_section ~= nil then sections[options.remove_section] = nil end
    if options.weight ~= nil then sections.wpn_alpha.inv_weight = tostring(options.weight) end
    if options.slot ~= nil then sections.wpn_alpha.slot = tostring(options.slot) end
    if options.ammo_class ~= nil then sections.wpn_alpha.ammo_class = options.ammo_class end
    if options.helmet_avaliable ~= nil then sections.outfit_field.helmet_avaliable = options.helmet_avaliable end
    if options.carry_bonus ~= nil then sections.outfit_field.additional_inventory_weight = tostring(options.carry_bonus) end
    if options.localized_name ~= nil then sections.wpn_alpha.inv_name = options.localized_name end
    if options.spawn_path ~= nil then sections.wpn_alpha["$spawn"] = options.spawn_path end
    if type(options.mutate_device) == 'function' then options.mutate_device(sections) end
    local order = {}
    for section in pairs(sections) do order[#order + 1] = section end
    table.sort(order)
    if options.reverse_enumeration then order = reverse(order) end
    local loadouts = { sections = base_loadouts(options.no_anchors) }
    local price_overrides = {
        wpn_beta=tostring(options.override_price or 55),
        device_torch_dummy='25', device_torch_nv_1='75',
        device_torch_nv_2='150', device_torch_nv_3=tostring(options.nv3_price or 300)
    }
    if options.zero_override ~= nil then price_overrides.wpn_zero = tostring(options.zero_override) end
    if options.missing_nv3_price then price_overrides.device_torch_nv_3 = nil end
    return {
        open_rules = function()
            return { sections = { price_overrides = price_overrides } }
        end,
        enumerate_system_sections = function() return copy_array(order) end,
        read_system_string = function(section, key)
            if type(options.system_reads) == "table" then
                options.system_reads[section] = (options.system_reads[section] or 0) + 1
            end
            local values = sections[section]
            return values and values[key] or nil
        end,
        read_system_number = function(section, key)
            local values = sections[section]
            return values and tonumber(values[key]) or nil
        end,
        section_spawnable = function(section)
            local values = sections[section]
            return values ~= nil and type(values["$spawn"]) == "string" and values["$spawn"] ~= ""
        end,
        open_loadouts = function() return loadouts end,
        enumerate_loadout_sections = function()
            local values = { "shared", "stalker_loadout" }
            return options.reverse_enumeration and reverse(values) or values
        end,
        enumerate_loadout_keys = function(_, section)
            local values = {}
            for key in pairs(loadouts.sections[section] or {}) do values[#values + 1] = key end
            table.sort(values)
            return options.reverse_enumeration and reverse(values) or values
        end,
        read_loadout_string = function(_, section, key)
            local values = loadouts.sections[section]
            return values and values[key] or nil
        end,
        read_base_carry_weight = function() return 50 end
    }
end

local function assert_item_catalog(options)
    options = options or {}
    local legacy = legacy_catalog()
    local loaded = gamma_arena_item_catalog.load(fixture_source(options), legacy, rank_catalog(options))
    gamma_arena_test_assert.is_true(loaded.ok, "item catalog fixture must load")
    return loaded.value, legacy
end

local function assert_array_same(actual, expected, message)
    gamma_arena_test_assert.equals(#actual, #expected, message .. " length")
    for index, value in ipairs(expected) do
        gamma_arena_test_assert.equals(actual[index], value, message .. " item")
    end
end

local function prices_and_classifies_installed_items()
    local catalog = assert_item_catalog()
    gamma_arena_test_assert.equals(catalog.max_physical_items_per_participant, 256, "authoritative physical item cap")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.category, "weapon", "weapon category")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.price, 40, "maximum GAMMA per-item price")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.price_origin, "gamma", "GAMMA price origin")
    gamma_arena_test_assert.equals(catalog.items.wpn_beta.price, 55, "Arena override")
    gamma_arena_test_assert.equals(catalog.items.wpn_beta.price_origin, "override", "override price origin")
    gamma_arena_test_assert.equals(catalog.items.wpn_gamma.price, 75, "derived price rounds upward")
    gamma_arena_test_assert.equals(catalog.items.wpn_gamma.price_origin, "derived", "derived price origin")
    assert_array_same(catalog.items.wpn_alpha.ammo_sections, { "ammo_alpha_ap", "ammo_alpha_fmj" }, "sorted compatible ammo")
    gamma_arena_test_assert.equals(catalog.items.helmet_closed.category, "helmet", "helmet category")
    gamma_arena_test_assert.equals(catalog.items.ammo_alpha_ap.category, "ammo", "ammo category")
    gamma_arena_test_assert.equals(catalog.items.outfit_field.category, "outfit", "outfit category")
    gamma_arena_test_assert.equals(catalog.items.wpn_knife.category, "knife", "knife category")
    gamma_arena_test_assert.equals(catalog.items.medkit.category, "medicine", "medicine category")
    gamma_arena_test_assert.is_true(catalog.items.medkit.healing, "accepted health medicine heals")
end

local function exposes_physical_metadata_and_legacy_fields()
    local catalog, legacy = assert_item_catalog()
    gamma_arena_test_assert.is_true(catalog.weapon_list == legacy.weapon_list, "legacy random weapon semantics are retained")
    gamma_arena_test_assert.is_true(catalog.difficulties == legacy.difficulties, "legacy random difficulty semantics are retained")
    gamma_arena_test_assert.equals(catalog.selection_mode, legacy.selection_mode, "legacy selection mode is retained")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.weight_mg, 3200, "weight uses integer milligrams")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.ltx_slot, 2, "effective LTX slot is retained")
    gamma_arena_test_assert.equals(catalog.items.ammo_alpha_ap.box_size, 20, "ammo box size is retained")
    gamma_arena_test_assert.is_false(catalog.items.outfit_field.helmet_allowed, "outfit helmet compatibility is retained")
    gamma_arena_test_assert.equals(catalog.items.outfit_field.carry_bonus_mg, 6500, "outfit carry bonus uses milligrams")
    gamma_arena_test_assert.equals(catalog.base_carry_weight, 50000, "actor carry capacity uses milligrams")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.icon.x, 1, "icon x is retained")
    gamma_arena_test_assert.equals(catalog.items.wpn_alpha.icon.height, 2, "icon height is retained")
    gamma_arena_test_assert.equals(catalog.ranks.novice.threat, 100, "rank metadata is exposed")
    gamma_arena_test_assert.equals(catalog.factions.stalker.community, "stalker", "faction metadata is exposed")
    gamma_arena_test_assert.equals(#catalog.item_ids, 15, "zero grant and exact devices join valid combat items")
end

local function retains_zero_grants_and_rejects_invalid_candidates()
    local catalog = assert_item_catalog()
    local zero = catalog.items.wpn_zero
    gamma_arena_test_assert.is_true(type(zero) == "table", "zero grant remains physically cataloged")
    gamma_arena_test_assert.equals(zero.price, nil, "zero grant has no Custom price")
    gamma_arena_test_assert.equals(zero.price_origin, "zero_grant", "zero grant origin is explicit")
    for _, section in ipairs({ "wpn_no_icon", "wpn_unspawnable", "wpn_weightless" }) do
        gamma_arena_test_assert.equals(catalog.items[section], nil, "invalid candidate is rejected: " .. section)
    end
end

local function explicit_override_prices_zero_grant()
    local catalog = assert_item_catalog({ zero_override = 45 })
    gamma_arena_test_assert.equals(catalog.items.wpn_zero.price, 45, "override prices zero grant")
    gamma_arena_test_assert.equals(catalog.items.wpn_zero.price_origin, "override", "override remains authoritative")
end

local function excludes_story_items()
    local catalog = assert_item_catalog()
    gamma_arena_test_assert.equals(catalog.items.wpn_story, nil, "supported story item is rejected")
end

local function fingerprint_changes_for_semantic_mutations()
    local baseline = assert_item_catalog()
    for _, mutation in ipairs({
        { remove_section = "wpn_gamma" }, { override_price = 60 }, { weight = 3.3 }, { slot = 1 },
        { ammo_class = "ammo_alpha_fmj" }, { helmet_avaliable = "true" }, { carry_bonus = 7 },
        { spawn_path = "fixture\\changed" }, { rank_threat = 101 }, { physical_item_cap = 255 }
    }) do
        local changed = assert_item_catalog(mutation)
        gamma_arena_test_assert.is_true(changed.fingerprint ~= baseline.fingerprint, "semantic mutation changes fingerprint")
    end
    gamma_arena_test_assert.is_true(string.match(baseline.fingerprint, "^ga%-catalog%-v10%-%x%x%x%x%x%x%x%x$") ~= nil, "fingerprint format")
end

local function fingerprint_is_canonical_and_excludes_localized_names()
    local baseline = assert_item_catalog()
    local shuffled = assert_item_catalog({ reverse_enumeration = true })
    local renamed = assert_item_catalog({ localized_name = "st_translated_fixture_name" })
    gamma_arena_test_assert.equals(shuffled.fingerprint, baseline.fingerprint, "enumeration order is canonical")
    gamma_arena_test_assert.equals(renamed.fingerprint, baseline.fingerprint, "localized names are excluded")
end

local function rejects_unavailable_median_anchors()
    local loaded = gamma_arena_item_catalog.load(fixture_source({ no_anchors = true }), legacy_catalog(), rank_catalog())
    gamma_arena_test_assert.is_false(loaded.ok, "catalog without positive price anchors fails closed")
    gamma_arena_test_assert.equals(loaded.error.code, "GA_ITEM_CATALOG_PRICE_ANCHOR_MISSING", "missing anchor code")
end

local function item_catalog_seeds_exact_physical_devices()
    local catalog = assert_item_catalog()
    local expected = {
        headlamp={section='device_torch_dummy',price=25}, nv_gen1={section='device_torch_nv_1',price=75},
        nv_gen2={section='device_torch_nv_2',price=150}, nv_gen3={section='device_torch_nv_3',price=300}
    }
    gamma_arena_test_assert.equals(catalog.schema_version, 10, 'physical catalog schema')
    gamma_arena_test_assert.equals(catalog.revision, 11, 'physical catalog revision')
    gamma_arena_test_assert.equals(catalog.generator_version, 11, 'physical generator version')
    for id, wanted in pairs(expected) do
        local semantic, physical = catalog.devices[id], catalog.items[wanted.section]
        gamma_arena_test_assert.is_true(type(semantic) == 'table' and type(physical) == 'table', id .. ' device exists')
        gamma_arena_test_assert.equals(physical.category, 'device', id .. ' category')
        gamma_arena_test_assert.equals(physical.price, wanted.price, id .. ' price')
        gamma_arena_test_assert.equals(physical.price_origin, 'override', id .. ' origin')
        gamma_arena_test_assert.is_true(physical.weight_mg > 0, id .. ' mass')
        gamma_arena_test_assert.equals(physical.ltx_slot, 9, id .. ' slot')
    end
    gamma_arena_test_assert.is_true(string.match(catalog.fingerprint, '^ga%-catalog%-v10%-%x%x%x%x%x%x%x%x$') ~= nil, 'v10 fingerprint format')
end

local function item_catalog_rejects_invalid_physical_devices()
    local wrong_price = gamma_arena_item_catalog.load(fixture_source({ nv3_price=301 }), legacy_catalog(), rank_catalog())
    gamma_arena_test_assert.is_false(wrong_price.ok, 'Gen3 price 301 is rejected')
    gamma_arena_test_assert.equals(wrong_price.error.code, 'GA_ITEM_CATALOG_DEVICE_PRICE_INVALID', 'wrong exact device price code')
    local missing_price = gamma_arena_item_catalog.load(fixture_source({ missing_nv3_price=true }), legacy_catalog(), rank_catalog())
    gamma_arena_test_assert.is_false(missing_price.ok, 'missing Gen3 price is rejected')
    gamma_arena_test_assert.equals(missing_price.error.code, 'GA_ITEM_CATALOG_DEVICE_PRICE_INVALID', 'missing exact device price code')
    local mutations = {
        function(items) items.device_torch_nv_1.class = 'ARTEFACT' end,
        function(items) items.device_torch_nv_2.slot = '10' end,
        function(items) items.device_torch_nv_3.nv_effect = 'nightvision_2' end,
        function(items) items.device_torch_dummy.inv_weight = '0' end
    }
    for _, mutate in ipairs(mutations) do
        local loaded = gamma_arena_item_catalog.load(fixture_source({ mutate_device=mutate }), legacy_catalog(), rank_catalog())
        gamma_arena_test_assert.is_false(loaded.ok, 'invalid exact physical device fails closed')
    end
end

local function item_catalog_device_mutations_change_fingerprint()
    local baseline = assert_item_catalog()
    local changed = assert_item_catalog({ mutate_device=function(items) items.device_torch_dummy.inv_weight='0.21' end })
    gamma_arena_test_assert.is_true(changed.fingerprint ~= baseline.fingerprint, 'device mutation changes fingerprint')
end

local function item_catalog_prefilters_irrelevant_system_sections()
    local reads = {}
    local catalog = assert_item_catalog({ irrelevant_section_count = 1000, system_reads = reads })
    gamma_arena_test_assert.is_true(type(catalog.items.wpn_alpha) == "table", "combat item survives system prefilter")
    for index = 1, 1000 do
        gamma_arena_test_assert.equals(reads["zone_fixture_" .. tostring(index)], nil,
            "irrelevant system section is rejected before metadata reads")
    end
end

local function item_catalog_reconciles_rank_pools_with_physical_items()
    local baseline = gamma_arena_item_catalog.load(fixture_source(), legacy_catalog(), rank_catalog())
    gamma_arena_test_assert.is_true(baseline.ok, "baseline rank catalog loads")
    local ranks = rank_catalog({ physically_rejected_pool_member = true })
    local source_pool = ranks.factions.stalker.ranks.legend.primary_weapons
    gamma_arena_test_assert.equals(#source_pool, 2, "fixture starts with one physically rejected rank weapon")

    local loaded = gamma_arena_item_catalog.load(fixture_source(), legacy_catalog(), ranks)
    gamma_arena_test_assert.is_true(loaded.ok, "item catalog reconciles a mixed physical rank pool")
    local published = loaded.value.factions.stalker.ranks.legend.primary_weapons
    gamma_arena_test_assert.equals(#published, 1,
        "physically rejected exact-pool member is removed before publication")
    gamma_arena_test_assert.equals(published[1], "wpn_delta",
        "compatible exact-pool member remains authoritative")
    gamma_arena_test_assert.equals(#source_pool, 2,
        "rank reconciliation does not mutate its input")
    gamma_arena_test_assert.equals(source_pool[2], "wpn_unspawnable",
        "input retains the physically rejected pool member")
    gamma_arena_test_assert.equals(loaded.value.fingerprint, baseline.value.fingerprint,
        "rejected rank weapon does not change the authoritative fingerprint")

    local empty_legacy = legacy_catalog()
    local empty_ranks = rank_catalog()
    empty_ranks.factions.stalker.ranks.legend.primary_weapons = { "wpn_unspawnable" }
    empty_ranks.factions.stalker.ranks.legend.secondary_weapons = {}
    local empty = gamma_arena_item_catalog.load(fixture_source(), empty_legacy, empty_ranks)
    gamma_arena_test_assert.is_true(empty.ok,
        "empty Custom rank pool does not disable the shared Random catalog")
    gamma_arena_test_assert.equals(#empty.value.factions.stalker.ranks.legend.primary_weapons, 0,
        "physically empty primary pool is published for Custom validation")
    gamma_arena_test_assert.equals(#empty.value.factions.stalker.ranks.legend.secondary_weapons, 0,
        "physically empty secondary pool is published for Custom validation")
    gamma_arena_test_assert.equals(empty.value.weapon_list, empty_legacy.weapon_list,
        "legacy Random weapon catalog remains available unchanged")

    local malformed_legacy = legacy_catalog()
    malformed_legacy.weapon_list[3].cost = "5"
    local malformed = gamma_arena_item_catalog.load(fixture_source(), malformed_legacy, rank_catalog())
    gamma_arena_test_assert.is_false(malformed.ok,
        "numeric strings in an authoritative legacy weapon fail closed")
    gamma_arena_test_assert.equals(malformed.error.code, "GA_ITEM_CATALOG_RANK_INVALID",
        "malformed legacy weapon reports the exact rank catalog error")

    local unsafe_legacy = legacy_catalog()
    unsafe_legacy.weapon_list[3].cost = 1e20
    local unsafe = gamma_arena_item_catalog.load(fixture_source(), unsafe_legacy, rank_catalog())
    gamma_arena_test_assert.is_false(unsafe.ok,
        "unsafe integer in an authoritative legacy weapon fails closed")
    gamma_arena_test_assert.equals(unsafe.error.code, "GA_ITEM_CATALOG_RANK_INVALID",
        "unsafe legacy weapon reports the exact rank catalog error")

    local duplicate_ranks = rank_catalog()
    duplicate_ranks.factions.stalker.ranks.legend.secondary_weapons[2] = "wpn_delta"
    local duplicate = gamma_arena_item_catalog.load(fixture_source(), legacy_catalog(), duplicate_ranks)
    gamma_arena_test_assert.is_true(duplicate.ok,
        "effective GAMMA injection duplicated across rank pools is reconciled")
    gamma_arena_test_assert.equals(
        #duplicate.value.factions.stalker.ranks.legend.primary_weapons, 1,
        "first deterministic pool retains the duplicated weapon")
    gamma_arena_test_assert.equals(
        #duplicate.value.factions.stalker.ranks.legend.secondary_weapons, 1,
        "later pool drops only the duplicated weapon")
    gamma_arena_test_assert.equals(
        duplicate.value.factions.stalker.ranks.legend.secondary_weapons[1], "wpn_beta",
        "non-duplicated later-pool weapon remains available")
    gamma_arena_test_assert.equals(
        duplicate_ranks.factions.stalker.ranks.legend.secondary_weapons[2], "wpn_delta",
        "cross-pool reconciliation does not mutate the effective GAMMA input")

    local malformed_duplicate_ranks = rank_catalog()
    malformed_duplicate_ranks.factions.stalker.ranks.legend.primary_weapons[2] = "wpn_delta"
    local malformed_duplicate = gamma_arena_item_catalog.load(
        fixture_source(), legacy_catalog(), malformed_duplicate_ranks)
    gamma_arena_test_assert.is_false(malformed_duplicate.ok,
        "duplicate weapon inside one exact rank pool still fails closed")
    gamma_arena_test_assert.equals(malformed_duplicate.error.code, "GA_ITEM_CATALOG_RANK_INVALID",
        "same-pool duplicate reports the exact catalog error")

    local function assert_invalid_rank_catalog(mutate, label)
        local candidate = rank_catalog()
        mutate(candidate)
        local result = gamma_arena_item_catalog.load(fixture_source(), legacy_catalog(), candidate)
        gamma_arena_test_assert.is_false(result.ok, label)
        gamma_arena_test_assert.equals(result.error.code, "GA_ITEM_CATALOG_RANK_INVALID",
            label .. " code")
    end
    assert_invalid_rank_catalog(function(candidate)
        candidate.rank_ids[3] = "novice"
    end, "duplicate named rank id fails closed")
    assert_invalid_rank_catalog(function(candidate)
        candidate.faction_ids[2] = "stalker"
    end, "duplicate faction id fails closed")
    assert_invalid_rank_catalog(function(candidate)
        candidate.ranks.legend.id = "novice"
    end, "named rank id mismatch fails closed")
    assert_invalid_rank_catalog(function(candidate)
        candidate.factions.stalker.id = "bandit"
    end, "faction id mismatch fails closed")
    assert_invalid_rank_catalog(function(candidate)
        candidate.factions.stalker.ranks.legend.id = "novice"
    end, "faction rank id mismatch fails closed")
end

local cases = {
    { name = "item_catalog_prices_and_classifies_installed_items", fn = prices_and_classifies_installed_items },
    { name = "item_catalog_exposes_physical_metadata_and_legacy_fields", fn = exposes_physical_metadata_and_legacy_fields },
    { name = "item_catalog_retains_zero_grants_and_rejects_invalid_candidates", fn = retains_zero_grants_and_rejects_invalid_candidates },
    { name = "item_catalog_explicit_override_prices_zero_grant", fn = explicit_override_prices_zero_grant },
    { name = "item_catalog_excludes_story_items", fn = excludes_story_items },
    { name = "item_catalog_fingerprint_changes_for_semantic_mutations", fn = fingerprint_changes_for_semantic_mutations },
    { name = "item_catalog_fingerprint_is_canonical_and_excludes_localized_names", fn = fingerprint_is_canonical_and_excludes_localized_names },
    { name = "item_catalog_rejects_unavailable_median_anchors", fn = rejects_unavailable_median_anchors },
    { name = "item_catalog_prefilters_irrelevant_system_sections", fn = item_catalog_prefilters_irrelevant_system_sections },
    { name = "item_catalog_reconciles_rank_pools_with_physical_items", fn = item_catalog_reconciles_rank_pools_with_physical_items }
}

function run(run_case_fn)
    local all_passed = true
    local device_cases = {
        { name='item_catalog_seeds_exact_physical_devices', fn=item_catalog_seeds_exact_physical_devices },
        { name='item_catalog_rejects_invalid_physical_devices', fn=item_catalog_rejects_invalid_physical_devices },
        { name='item_catalog_device_mutations_change_fingerprint', fn=item_catalog_device_mutations_change_fingerprint }
    }
    for _, case in ipairs(cases) do
        if not run_case_fn(case.name, case.fn) then all_passed = false end
    end
    for _, case in ipairs(device_cases) do
        if not run_case_fn(case.name, case.fn) then all_passed = false end
    end
    return all_passed
end
