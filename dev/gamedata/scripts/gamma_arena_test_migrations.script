local function character_creation_bridge_is_exact()
    local initial = {}
    for _, key in ipairs(character_keys) do initial[key] = "stale_" .. key end
    local config = fake_config(initial)
    local store = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(), { clock = function() return 100 end, nonce = function() return "bridge" end }).ok, "character bridge requires an issued launch")
    local result = store:write_character_creation(config)
    gamma_arena_test_assert.is_true(result.ok, "character creation bridge writes")
    gamma_arena_test_assert.equals(config.data.bridge_pending, "true", "character bridge persists its crash-safe undo lease")
    for key, value in pairs(character_write_values) do
        gamma_arena_test_assert.equals(config.data[key], value, "fixed character bridge value: " .. key)
        gamma_arena_test_assert.equals(config.persisted[key], value, "fixed persisted character bridge value: " .. key)
    end
    for _, key in ipairs(character_remove_keys) do
        gamma_arena_test_assert.equals(config.data[key], nil, "stale character mode removed: " .. key)
        gamma_arena_test_assert.equals(config.persisted[key], nil, "stale persisted character mode removed: " .. key)
    end
end

local function character_snapshot(initial)
    local snapshot = {}
    for _, key in ipairs(character_keys) do snapshot[key] = initial[key] end
    return snapshot
end

local function assert_character_snapshot(config, expected, message)
    for _, key in ipairs(character_keys) do
        gamma_arena_test_assert.equals(config.data[key], expected[key], message .. " working: " .. key)
        gamma_arena_test_assert.equals(config.persisted[key], expected[key], message .. " persisted: " .. key)
    end
end

local function bridge_fixture(label)
    local initial = {}
    for index, key in ipairs(character_keys) do
        if index % 3 == 0 then initial[key] = "" elseif index % 2 == 0 then initial[key] = label .. "_" .. key end
    end
    local config = fake_config(initial)
    local store = gamma_arena_session_store.new_store()
    local issued = store:issue_launch(config, valid_request(), {
        clock = function() return 100 end,
        nonce = function() return label end
    })
    gamma_arena_test_assert.is_true(issued.ok, label .. " launch issues")
    gamma_arena_test_assert.is_true(store:write_character_creation(config).ok, label .. " bridge writes")
    return config, store, character_snapshot(initial)
end

local function character_creation_reconcile_rejects_malformed_matching_lease()
    local missing_config = bridge_fixture("missing_snapshot_field")
    missing_config:corrupt("gamma_arena", "bridge_new_game_character_name_present", nil)
    local missing = gamma_arena_session_store.new_store():reconcile_character_creation(missing_config)
    gamma_arena_test_assert.is_false(missing.ok, "matching lease with a missing snapshot field rejects")
    gamma_arena_test_assert.equals(missing.error.code, "GA_CHARACTER_CREATION_LEASE_INVALID", "missing snapshot field uses the lease error taxonomy")
    gamma_arena_test_assert.equals(missing_config.data.bridge_pending, "true", "invalid snapshot remains fail-closed")

    local empty_token_config = bridge_fixture("empty_matching_token")
    empty_token_config:corrupt("gamma_arena", "bridge_launch_token", "")
    empty_token_config:corrupt("gamma_arena", "launch_token", "")
    local empty_token = gamma_arena_session_store.new_store():reconcile_character_creation(empty_token_config)
    gamma_arena_test_assert.is_false(empty_token.ok, "matching empty lease token rejects")
    gamma_arena_test_assert.equals(empty_token.error.code, "GA_CHARACTER_CREATION_LEASE_INVALID", "empty lease token uses the lease error taxonomy")
    gamma_arena_test_assert.equals(empty_token_config.data.bridge_pending, "true", "empty-token lease remains fail-closed")
end

local function character_creation_bridge_restores_exactly_from_fresh_store()
    local config, _, expected = bridge_fixture("fresh_bridge")
    local restored = gamma_arena_session_store.new_store():restore_character_creation(config)
    gamma_arena_test_assert.is_true(restored.ok and restored.value == true, "fresh Store restores a durable bridge lease")
    assert_character_snapshot(config, expected, "fresh Store exact restore")
    gamma_arena_test_assert.equals(config.data.bridge_pending, nil, "successful restore consumes the durable lease")
    local repeated = gamma_arena_session_store.new_store():restore_character_creation(config)
    gamma_arena_test_assert.is_true(repeated.ok and repeated.value == false, "repeated bridge recovery is idempotent")
    assert_character_snapshot(config, expected, "idempotent exact restore")
end

local function character_creation_bridge_accepts_engine_nil_for_present_empty_values()
    local config, _, expected = bridge_fixture("engine_empty_bridge")
    local read = config.r_string_ex
    function config:r_string_ex(section, key)
        local value = read(self, section, key)
        if self:line_exist(section, key) and value == "" then return nil end
        return value
    end
    local restored = gamma_arena_session_store.new_store():restore_character_creation(config)
    gamma_arena_test_assert.is_true(restored.ok and restored.value == true, "engine nil for a present empty value restores safely")
    assert_character_snapshot(config, expected, "engine empty-value exact restore")
    gamma_arena_test_assert.equals(config.data.bridge_pending, nil, "engine empty-value restore consumes the durable lease")
end

local function ordinary_character_creation_without_lease_is_untouched()
    local initial = { new_game_character_name = "Ordinary_Stalker", new_game_faction = "loner", new_game_story_mode = "true" }
    local config = fake_config(initial)
    local restored = gamma_arena_session_store.new_store():restore_character_creation(config)
    gamma_arena_test_assert.is_true(restored.ok and restored.value == false, "no bridge lease is an inert restore")
    assert_character_snapshot(config, character_snapshot(initial), "ordinary character creation")
end

local function character_creation_bridge_restores_on_every_launch_terminal_route()
    local success_config, success_store, success_expected = bridge_fixture("consumed_bridge")
    local consumed = success_store:consume_launch(success_config, { clock = function() return 100 end })
    gamma_arena_test_assert.is_true(consumed.ok, "successfully consumed launch restores its bridge")
    assert_character_snapshot(success_config, success_expected, "successful consume")

    local expired_config, expired_store, expired_expected = bridge_fixture("expired_bridge")
    local expired = expired_store:consume_launch(expired_config, { clock = function() return 701 end })
    gamma_arena_test_assert.is_false(expired.ok, "expired launch is rejected")
    gamma_arena_test_assert.equals(expired.error.code, "GA_LAUNCH_TOKEN_EXPIRED", "expired launch preserves its exact reason")
    assert_character_snapshot(expired_config, expired_expected, "expired launch")

    local rejected_config, _, rejected_expected = bridge_fixture("rejected_bridge")
    local rejected = gamma_arena_session_store.new_store():consume_launch(rejected_config, { clock = function() return 100 end })
    gamma_arena_test_assert.is_false(rejected.ok, "fresh Store rejects a process-orphaned launch")
    assert_character_snapshot(rejected_config, rejected_expected, "rejected launch")

    local stale_config, _, stale_expected = bridge_fixture("stale_bridge")
    local stale = gamma_arena_session_store.new_store():issue_launch(stale_config, valid_request(77), {
        clock = function() return 100 end,
        nonce = function() return "replacement" end
    })
    gamma_arena_test_assert.is_false(stale.ok, "stale launch is cleared before replacement")
    gamma_arena_test_assert.equals(stale.error.code, "GA_LAUNCH_STALE_CLEARED", "stale launch preserves the retry contract")
    assert_character_snapshot(stale_config, stale_expected, "stale launch")

    local cleared_config, cleared_store, cleared_expected = bridge_fixture("cleared_bridge")
    gamma_arena_test_assert.is_true(cleared_store:clear_transient(cleared_config).ok, "common transient cleanup succeeds")
    assert_character_snapshot(cleared_config, cleared_expected, "common cleanup")
end

local function character_creation_bridge_faults_fail_closed()
    local read_config, read_store, read_expected = bridge_fixture("read_fault_bridge")
    read_config:arm_read_fault(1)
    local read_failed = read_store:restore_character_creation(read_config)
    gamma_arena_test_assert.is_false(read_failed.ok, "bridge recovery read faults are structured")
    read_config:clear_fault()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.new_store():restore_character_creation(read_config).ok, "bridge recovery retries after read fault")
    assert_character_snapshot(read_config, read_expected, "read-fault retry")

    local write_config, write_store, write_expected = bridge_fixture("write_fault_bridge")
    write_config:arm_fault(1, "false")
    local write_failed = write_store:restore_character_creation(write_config)
    gamma_arena_test_assert.is_false(write_failed.ok, "bridge recovery mutation faults are structured")
    write_config:clear_fault()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.new_store():restore_character_creation(write_config).ok, "bridge recovery retries after mutation fault")
    assert_character_snapshot(write_config, write_expected, "mutation-fault retry")

    local save_config, save_store, save_expected = bridge_fixture("save_fault_bridge")
    local base_save = save_config.save
    local fail_save_once = true
    function save_config:save()
        if fail_save_once then fail_save_once = false; return false end
        return base_save(self)
    end
    local save_failed = save_store:restore_character_creation(save_config)
    gamma_arena_test_assert.is_false(save_failed.ok, "bridge recovery save faults are structured")
    gamma_arena_test_assert.is_true(gamma_arena_session_store.new_store():restore_character_creation(save_config).ok, "bridge recovery retries after save fault")
    assert_character_snapshot(save_config, save_expected, "save-fault retry")

    local recovery_config, recovery_store, recovery_expected = bridge_fixture("recovery_fault_bridge")
    recovery_config:arm_fault(1)
    recovery_config:arm_recovery_fault(1, "false")
    local recovery_failed = recovery_store:restore_character_creation(recovery_config)
    gamma_arena_test_assert.is_false(recovery_failed.ok, "failed touched-key recovery quarantines bridge restoration")
    recovery_config:clear_fault()
    gamma_arena_test_assert.is_true(gamma_arena_config_tx.recover(recovery_config).ok, "explicit touched-key recovery unblocks bridge restoration")
    gamma_arena_test_assert.is_true(gamma_arena_session_store.new_store():restore_character_creation(recovery_config).ok, "fresh Store completes bridge restoration after recovery")
    assert_character_snapshot(recovery_config, recovery_expected, "recovery-fault retry")
end

local function start_game_failures_restore_bridge_immediately()
    local cases = {
        { label = "missing", owner = {} , code = "GA_START_GAME_UNAVAILABLE" },
        { label = "throwing", owner = { StartGame = function() error("injected StartGame failure") end }, code = "GA_START_GAME_FAILED" },
        { label = "false", owner = { StartGame = function() return false end }, code = "GA_START_GAME_FAILED" }
    }
    for _, case in ipairs(cases) do
        local config, _, expected = bridge_fixture(case.label .. "_start")
        local result = gamma_arena_ui_start.handoff_start_game(case.owner, config)
        gamma_arena_test_assert.is_false(result.ok, case.label .. " StartGame fails structurally")
        gamma_arena_test_assert.equals(result.error.code, case.code, case.label .. " StartGame failure code")
        assert_character_snapshot(config, expected, case.label .. " StartGame immediate restore")
        assert_keys_absent(config, launch_keys, case.label .. " StartGame clears launch intent")
    end
end

local function defeat_main_menu_fresh_fight_promotes_once()
    local config = {}
    local shown_model
    local promoted_request
    local promoted_token
    local bridge_calls = 0
    local start_game_calls = 0
    local menu = { hidden = 0, shown = 0, dialog_shown = 0 }
    function menu:HideDialog() self.hidden = self.hidden + 1 end
    function menu:Show(value) if value then self.shown = self.shown + 1 end end
    function menu:ShowDialog(value) if value then self.dialog_shown = self.dialog_shown + 1 end end

    local ports = {
        config = config,
        peek_defeat = function(candidate)
            gamma_arena_test_assert.equals(candidate, config, "defeat peek receives injected config")
            return gamma_arena_result.ok({
                schema_version = 1,
                session_id = "ga_dead_session",
                session_nonce = "ga_dead_nonce",
                mode_id = "skirmish",
                difficulty_id = "master",
                token = "gad1:1000:menu"
            })
        end,
        show_result = function(model) shown_model = model; return gamma_arena_result.ok(true) end,
        random_session_seed = function() return gamma_arena_result.ok(987654321) end,
        issue_launch_from_defeat = function(candidate, token, request)
            gamma_arena_test_assert.equals(candidate, config, "defeat promotion receives injected config")
            promoted_token = token
            promoted_request = request
            return gamma_arena_result.ok({ token = "ga1:1001:fresh" })
        end,
        write_character_creation = function(candidate)
            gamma_arena_test_assert.equals(candidate, config, "fresh bridge receives injected config")
            bridge_calls = bridge_calls + 1
            return gamma_arena_result.ok(true)
        end,
        handoff_start_game = function(owner, candidate)
            gamma_arena_test_assert.equals(owner, menu, "fresh handoff retains main-menu owner")
            gamma_arena_test_assert.equals(candidate, config, "fresh handoff receives injected config")
            start_game_calls = start_game_calls + 1
            return gamma_arena_result.ok(true)
        end
    }

    local displayed = gamma_arena_main_menu.show_confirmed_defeat(menu, ports)
    gamma_arena_test_assert.is_true(displayed.ok, "confirmed defeat opens after the stock death transition")
    gamma_arena_test_assert.equals(menu.hidden, 1, "confirmed defeat hides the ordinary main menu")
    gamma_arena_test_assert.equals(shown_model.kind, "defeat", "main-menu handoff opens defeat UI")
    gamma_arena_test_assert.equals(shown_model.title_key, "st_gamma_arena_result_defeat", "defeat title remains exact")
    gamma_arena_test_assert.equals(shown_model.next_title_key, "st_gamma_arena_result_new_fight", "defeat primary action says new fight")

    local launched = shown_model.on_next()
    gamma_arena_test_assert.is_true(launched.ok, "fresh fight launch succeeds")
    gamma_arena_test_assert.equals(promoted_token, "gad1:1000:menu", "fresh fight consumes the confirmed token through promotion")
    gamma_arena_test_assert.equals(promoted_request.mode_id, "skirmish", "fresh fight keeps mode")
    gamma_arena_test_assert.equals(promoted_request.difficulty_id, "master", "fresh fight keeps difficulty")
    gamma_arena_test_assert.equals(promoted_request.seed_mode, "random", "fresh fight always rerolls")
    gamma_arena_test_assert.equals(promoted_request.session_seed, 987654321, "fresh fight uses new seed")
    gamma_arena_test_assert.equals(bridge_calls, 1, "fresh fight writes one character-creation bridge")
    gamma_arena_test_assert.equals(start_game_calls, 1, "fresh fight invokes engine StartGame once")
end

local function defeat_main_menu_exit_consumes_without_launch()
    local config = {}
    local shown_model
    local consumed_token
    local launch_calls = 0
    local clear_result_calls = 0
    local menu = { hidden = 0, shown = 0, dialog_shown = 0 }
    function menu:HideDialog() self.hidden = self.hidden + 1 end
    function menu:Show(value) if value then self.shown = self.shown + 1 end end
    function menu:ShowDialog(value) if value then self.dialog_shown = self.dialog_shown + 1 end end
    local ports = {
        config = config,
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:exit" }) end,
        show_result = function(model) shown_model = model; return gamma_arena_result.ok(true) end,
        consume_defeat = function(_, token) consumed_token = token; return gamma_arena_result.ok(true) end,
        issue_launch_from_defeat = function() launch_calls = launch_calls + 1; return gamma_arena_result.ok(true) end,
        clear_result = function() clear_result_calls = clear_result_calls + 1; return gamma_arena_result.ok(true) end
    }

    gamma_arena_test_assert.is_true(gamma_arena_main_menu.show_confirmed_defeat(menu, ports).ok, "exit fixture displays defeat")
    local exited = shown_model.on_main_menu()
    gamma_arena_test_assert.is_true(exited.ok, "defeat main-menu action succeeds")
    gamma_arena_test_assert.equals(consumed_token, "gad1:1000:exit", "main-menu exit consumes the defeat")
    gamma_arena_test_assert.equals(launch_calls, 0, "main-menu exit never issues a launch")
    gamma_arena_test_assert.equals(clear_result_calls, 1, "main-menu exit clears Arena result UI")
    gamma_arena_test_assert.equals(menu.dialog_shown, 1, "main-menu exit restores ShowDialog")
    gamma_arena_test_assert.equals(menu.shown, 1, "main-menu exit restores Show")
end

local function defeat_main_menu_waits_for_first_stock_update()
    local events = {}
    local show_calls = 0
    local menu = {}
    function menu:Update()
        events[#events + 1] = "stock_update"
    end
    function menu:HideDialog()
        events[#events + 1] = "menu_hidden"
    end
    function menu:Show(value)
        if value == false then events[#events + 1] = "menu_invisible" end
    end

    local ports = {
        config = {},
        peek_defeat = function()
            return gamma_arena_result.ok({
                schema_version = 1,
                session_id = "ga_deferred_session",
                session_nonce = "ga_deferred_nonce",
                mode_id = "skirmish",
                difficulty_id = "master",
                token = "gad1:1000:deferred"
            })
        end,
        show_result = function()
            show_calls = show_calls + 1
            events[#events + 1] = "result_shown"
            return gamma_arena_result.ok(true)
        end
    }

    local deferred = gamma_arena_main_menu.defer_confirmed_defeat(menu, ports)
    gamma_arena_test_assert.is_true(deferred.ok and deferred.value == true, "confirmed defeat is queued during menu construction")
    gamma_arena_test_assert.equals(#events, 0, "menu construction does not open or hide either dialog")
    gamma_arena_test_assert.equals(show_calls, 0, "result is not shown inside main_menu_on_init timing")

    menu:Update()
    gamma_arena_test_assert.equals(events[1], "stock_update", "stock menu completes its first Update before Arena changes dialog ownership")
    gamma_arena_test_assert.equals(events[2], "menu_hidden", "deferred defeat hides the active stock menu")
    gamma_arena_test_assert.equals(events[3], "menu_invisible", "deferred defeat hides the stock menu visuals")
    gamma_arena_test_assert.equals(events[4], "result_shown", "deferred defeat then opens the Arena result")
    gamma_arena_test_assert.equals(show_calls, 1, "deferred result opens exactly once")

    menu:Update()
    gamma_arena_test_assert.equals(show_calls, 1, "later menu updates do not reopen the Arena result")
end

local function defeat_main_menu_deferred_failures_fail_open()
    local function fixture(with_update)
        local calls = { clear_result = 0, clear_fatal = 0, clear_defeat = 0, restored = 0 }
        local menu = {}
        if with_update then function menu:Update() end end
        function menu:ShowDialog(value)
            if value then calls.restored = calls.restored + 1 end
        end
        function menu:Show() end
        local ports = {
            config = {},
            clear_result = function() calls.clear_result = calls.clear_result + 1; return gamma_arena_result.ok(true) end,
            clear_fatal = function() calls.clear_fatal = calls.clear_fatal + 1; return gamma_arena_result.ok(true) end,
            clear_defeat = function() calls.clear_defeat = calls.clear_defeat + 1; return gamma_arena_result.ok(true) end
        }
        return menu, ports, calls
    end

    local init_menu, init_ports, init_calls = fixture(true)
    init_ports.peek_defeat = function()
        return gamma_arena_result.err("GA_DEFEAT_READ_FAILED", "fixture init read failure")
    end
    local init_failed = gamma_arena_main_menu.defer_confirmed_defeat(init_menu, init_ports)
    gamma_arena_test_assert.is_false(init_failed.ok, "scheduling read failure remains observable")
    gamma_arena_test_assert.equals(init_calls.clear_result, 1, "scheduling read failure clears partial result UI")
    gamma_arena_test_assert.equals(init_calls.clear_fatal, 1, "scheduling read failure clears partial fatal UI")
    gamma_arena_test_assert.equals(init_calls.clear_defeat, 1, "scheduling read failure clears defeat intent")
    gamma_arena_test_assert.equals(init_calls.restored, 1, "scheduling read failure restores stock menu")

    local update_menu, update_ports, update_calls = fixture(true)
    local peek_calls = 0
    update_ports.peek_defeat = function()
        peek_calls = peek_calls + 1
        if peek_calls == 1 then
            return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:update_failure" })
        end
        return gamma_arena_result.err("GA_DEFEAT_READ_FAILED", "fixture deferred read failure")
    end
    gamma_arena_test_assert.is_true(gamma_arena_main_menu.defer_confirmed_defeat(update_menu, update_ports).ok, "deferred failure fixture queues")
    update_menu:Update()
    gamma_arena_test_assert.equals(update_calls.clear_result, 1, "deferred display failure clears partial result UI")
    gamma_arena_test_assert.equals(update_calls.clear_fatal, 1, "deferred display failure clears partial fatal UI")
    gamma_arena_test_assert.equals(update_calls.clear_defeat, 1, "deferred display failure clears defeat intent")
    gamma_arena_test_assert.equals(update_calls.restored, 1, "deferred display failure restores stock menu")
    update_menu:Update()
    gamma_arena_test_assert.equals(peek_calls, 2, "failed deferred display is never retried on later updates")

    local hook_menu, hook_ports, hook_calls = fixture(false)
    hook_ports.peek_defeat = function()
        return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:hook_failure" })
    end
    local hook_failed = gamma_arena_main_menu.defer_confirmed_defeat(hook_menu, hook_ports)
    gamma_arena_test_assert.is_false(hook_failed.ok, "missing Update hook fails structurally")
    gamma_arena_test_assert.equals(hook_failed.error.code, "GA_MAIN_MENU_UPDATE_UNAVAILABLE", "missing Update hook uses exact code")
    gamma_arena_test_assert.equals(hook_calls.clear_result, 1, "hook failure clears partial result UI")
    gamma_arena_test_assert.equals(hook_calls.clear_fatal, 1, "hook failure clears partial fatal UI")
    gamma_arena_test_assert.equals(hook_calls.clear_defeat, 1, "hook failure clears defeat intent")
    gamma_arena_test_assert.equals(hook_calls.restored, 1, "hook failure restores stock menu")
end

local function matching_resume_cleanup_is_session_scoped()
    local intent = {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        next_fight_index = 4,
        checkpoint_name = "_gamma_arena_checkpoint"
    }
    local config = fake_config()
    local store = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "resume cleanup fixture issued")
    local foreign = valid_session(3)
    foreign.session_id = "session-2"
    local skipped = store:clear_resume_if_matches(config, foreign)
    gamma_arena_test_assert.is_true(skipped.ok and skipped.value == false, "foreign session cannot clear this resume route")
    gamma_arena_test_assert.equals(config.data.resume_pending, "true", "foreign cleanup leaves matching route persisted")
    local cleared = store:clear_resume_if_matches(config, valid_session(3))
    gamma_arena_test_assert.is_true(cleared.ok, "matching session clears its own resume route")
    assert_keys_absent(config, resume_keys, "matching cleanup clears only resume keys")
    assert_keys_absent({ data = config.persisted }, resume_keys, "matching cleanup persists exact resume-key removal")

    local malformed = fake_config({
        resume_pending = "true",
        resume_session_id = "../foreign",
        resume_session_nonce = "foreign_nonce",
        resume_next_fight_index = "4",
        resume_checkpoint_name = "_gamma_arena_checkpoint",
        resume_schema_version = "1"
    })
    local rejected = gamma_arena_session_store.new_store():clear_resume_if_matches(malformed, valid_session(3))
    gamma_arena_test_assert.is_false(rejected.ok, "malformed foreign intent is not broadly deleted")
    gamma_arena_test_assert.equals(malformed.data.resume_pending, "true", "malformed unmatched intent remains for explicit quarantine")
end

local function prepared_resume_consume_rejects_persisted_drift()
    local intent = {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        next_fight_index = 4,
        checkpoint_name = "_gamma_arena_checkpoint"
    }
    local config = fake_config()
    local store = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "prepared consume fixture issued")
    local prepared = store:prepare_resume(config, valid_session(3))
    gamma_arena_test_assert.is_true(prepared.ok, "persisted intent is prepared without consumption")
    config.data.resume_next_fight_index = "5"
    config.persisted.resume_next_fight_index = "5"
    local drifted = store:consume_resume(config, valid_session(3), prepared.value)
    gamma_arena_test_assert.is_false(drifted.ok, "consume rejects persisted intent drift")
    gamma_arena_test_assert.equals(drifted.error.code, "GA_CHECKPOINT_RECOVERY_MISMATCH", "prepared drift uses recovery mismatch code")
    assert_keys_absent(config, resume_keys, "drifted resume is cleared fail-closed")

    gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "matching prepared consume fixture reissued")
    prepared = store:prepare_resume(config, valid_session(3))
    local consumed = store:consume_resume(config, valid_session(3), prepared.value)
    gamma_arena_test_assert.is_true(consumed.ok, "unchanged prepared intent consumes once")
    gamma_arena_test_assert.equals(consumed.value.next_fight_index, 4, "matching prepared continuation is preserved")
end

