local function copy_table(source)
    local result = {}
    for key, value in pairs(source or {}) do
        result[key] = value
    end
    return result
end

local function copy_into(target, source)
    for key in pairs(target) do target[key] = nil end
    for key, value in pairs(source or {}) do target[key] = value end
end

local function fake_backend(initial)
    return {
        working = copy_table(initial),
        persisted = copy_table(initial)
    }
end

local function fake_config(initial, shared_backend)
    local backend = shared_backend or fake_backend(initial)
    local config = {
        backend = backend,
        data = backend.working,
        persisted = backend.persisted,
        cache = {},
        stale_cache = copy_table(backend.working),
        writes = {},
        removals = {},
        save_count = 0,
        gamma_arena_boolean_returns = true,
        recovery_active = false,
        faults = {
            primary = { index = 0 },
            read = { index = 0 },
            recovery = { index = 0 }
        }
    }

    for key, value in pairs(backend.working) do
        config.cache["gamma_arena&" .. key] = value
        config.cache["character_creation&" .. key] = value
    end

    function config:set_fault(channel, position, mode)
        self.faults[channel] = { index = 0, at = position, mode = mode or "throw", used = false }
    end

    function config:arm_fault(position, mode)
        self:set_fault("primary", position, mode)
    end

    function config:arm_read_fault(position, mode)
        self:set_fault("read", position, mode)
    end

    function config:arm_recovery_fault(position, mode)
        self:set_fault("recovery", position, mode)
    end

    function config:clear_fault()
        self.faults.primary = { index = 0 }
        self.faults.read = { index = 0 }
        self.faults.recovery = { index = 0 }
        self.recovery_active = false
    end

    function config:maybe_fail(channel, operation)
        local fault = self.faults[channel]
        fault.index = fault.index + 1
        if not fault.used and fault.at == fault.index then
            fault.used = true
            if fault.mode == "false" then
                return true, false
            end
            error("injected " .. channel .. " " .. operation .. " failure at " .. tostring(fault.index))
        end
        return false, nil
    end

    function config:corrupt(section, key, value)
        if value == nil then
            backend.working[key] = nil
            backend.persisted[key] = nil
            self.cache[section .. "&" .. key] = nil
            self.stale_cache[key] = nil
        else
            backend.working[key] = tostring(value)
            backend.persisted[key] = tostring(value)
            self.cache[section .. "&" .. key] = tostring(value)
            self.stale_cache[key] = tostring(value)
        end
    end

    function config:r_string_ex(section, key)
        local failed, result = self:maybe_fail("read", "r_string_ex")
        if failed then return result end
        if section ~= "gamma_arena" and section ~= "character_creation" then return nil end
        return backend.working[key]
    end

    function config:r_value(section, key, _, default)
        local value = self.cache[section .. "&" .. key]
        if value == nil then value = self.stale_cache[key] end
        if value == nil then return default end
        return value
    end

    function config:line_exist(section, key)
        local failed, result = self:maybe_fail("read", "line_exist")
        if failed then return result end
        return backend.working[key] ~= nil
    end

    function config:w_value(section, key, value)
        local failed, result = self:maybe_fail("primary", "write")
        if failed then return result end
        gamma_arena_test_assert.is_true(value ~= nil, "tests forbid nil w_value")
        backend.working[key] = tostring(value)
        self.cache[section .. "&" .. key] = tostring(value)
        self.stale_cache[key] = tostring(value)
        self.writes[#self.writes + 1] = section .. "." .. key .. "=" .. tostring(value)
        return true
    end

    function config:remove_line(section, key)
        local failed, result = self:maybe_fail("primary", "remove")
        if failed then return result end
        backend.working[key] = nil
        self.removals[#self.removals + 1] = section .. "." .. key
        return true
    end

    function config:save()
        local channel = self.recovery_active and "recovery" or "primary"
        local failed, result = self:maybe_fail(channel, "save")
        if failed then return result end
        copy_into(backend.persisted, backend.working)
        self.save_count = self.save_count + 1
        self.recovery_active = false
        return true
    end

    local raw_ini = { gamma_arena_boolean_returns = true }
    config.ini = raw_ini

    function raw_ini:w_string(section, key, value)
        config.recovery_active = true
        local failed, result = config:maybe_fail("recovery", "raw_write")
        if failed then return result end
        backend.working[key] = tostring(value)
        return true
    end

    function raw_ini:remove_line(section, key)
        config.recovery_active = true
        local failed, result = config:maybe_fail("recovery", "raw_remove")
        if failed then return result end
        backend.working[key] = nil
        return true
    end

    return config
end

local function valid_session(fight_index)
    return {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        mode_id = "skirmish",
        difficulty_id = "stalker",
        session_seed = 42,
        fight_index = fight_index or 3,
        generator_version = 1,
        catalog_revision = 1,
        layout_id = "rostok_arena_v1",
        checkpoint_name = "_gamma_arena_checkpoint",
        phase = "CHECKPOINT_READY"
    }
end

local function assert_keys_absent(config, keys, message)
    for _, key in ipairs(keys) do
        gamma_arena_test_assert.equals(config.data[key], nil, message .. ": " .. key)
    end
end

local launch_keys = { "launch_pending", "launch_token", "launch_mode_id", "launch_difficulty_id", "launch_seed_mode", "launch_session_seed", "launch_stage", "launch_deferred_level", "launch_target_level" }
local resume_keys = { "resume_pending", "resume_session_id", "resume_session_nonce", "resume_next_fight_index", "resume_checkpoint_name", "resume_schema_version" }
local defeat_keys = { "defeat_pending", "defeat_token", "defeat_schema_version", "defeat_stage", "defeat_session_id", "defeat_session_nonce", "defeat_mode_id", "defeat_difficulty_id", "defeat_issued_at" }
local character_write_values = {
    new_game_difficulty = "2",
    new_game_economy = "2",
    new_game_economy_treasure = "2",
    new_game_character_name = "Arena_Fighter",
    new_game_faction = "dolg",
    new_game_map = "makeshift_barracks",
    new_game_money = "0"
}
local character_remove_keys = {
    "new_game_loadout", "new_game_story_mode", "new_game_icon",
    "new_game_hardcore_mode", "new_game_hardcore_mode_lives", "new_game_hardcore_mode_regenerate",
    "new_game_survival_mode", "new_game_azazel_mode", "new_game_warfare",
    "new_game_campfire_mode", "new_game_conditions_mode", "new_game_timer_mode",
    "new_game_opened_routes", "new_game_test"
}
local character_keys = {}
for key in pairs(character_write_values) do character_keys[#character_keys + 1] = key end
for _, key in ipairs(character_remove_keys) do character_keys[#character_keys + 1] = key end

local function valid_request(seed)
    return {
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = "stalker",
        seed_mode = "manual",
        session_seed = seed or 42
    }
end

local function valid_defeat_context()
    return {
        schema_version = 1,
        session_id = "ga_session_1",
        session_nonce = "ga_nonce_1",
        mode_id = "skirmish",
        difficulty_id = "master"
    }
end

local function defeat_intent_is_transactional_and_cross_vm_safe()
    local context = valid_defeat_context()
    local discarded_config = fake_config()
    local discarded_store = gamma_arena_session_store.new_store()
    local discarded = discarded_store:arm_defeat(discarded_config, context, {
        clock = function() return 1000 end,
        nonce = function() return "discarded" end
    })
    gamma_arena_test_assert.is_true(discarded.ok, "discard fixture arms")
    gamma_arena_test_assert.equals(discarded_store:peek_defeat(discarded_config, { clock = function() return 1001 end }).value, false, "armed defeat is not menu-visible")
    assert_keys_absent(discarded_config, defeat_keys, "armed defeat peek clears all keys")
    assert_keys_absent({ data = discarded_config.persisted }, defeat_keys, "armed defeat peek persists all-key clear")

    local failed_clear_config = fake_config()
    local failed_clear_store = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(failed_clear_store:arm_defeat(failed_clear_config, context, {
        clock = function() return 1000 end,
        nonce = function() return "failed_clear" end
    }).ok, "failed-clear fixture arms")
    failed_clear_config:arm_fault(1)
    local failed_clear = failed_clear_store:peek_defeat(failed_clear_config, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_false(failed_clear.ok, "armed peek fails when transactional discard fails")
    gamma_arena_test_assert.equals(failed_clear.error.code, "GA_DEFEAT_CLEAR_FAILED", "armed peek returns structured clear failure")
    assert_keys_absent(failed_clear_config, defeat_keys, "failed armed peek is fail-closed")
    assert_keys_absent({ data = failed_clear_config.persisted }, defeat_keys, "failed armed peek persisted state is fail-closed")

    local config = fake_config()
    local store = gamma_arena_session_store.new_store()
    local armed = store:arm_defeat(config, context, {
        clock = function() return 1000 end,
        nonce = function() return "death_1" end
    })
    gamma_arena_test_assert.is_true(armed.ok, "confirmation fixture arms")
    gamma_arena_test_assert.equals(armed.value.token, "gad1:1000:death_1", "defeat token grammar")
    gamma_arena_test_assert.is_true(store:confirm_defeat(config, armed.value.token, { clock = function() return 1001 end }).ok, "death confirms")
    gamma_arena_test_assert.equals(store:peek_defeat(config, { clock = function() return 1002 end }).value.difficulty_id, "master", "confirmed context survives")
    gamma_arena_test_assert.is_true(store:confirm_defeat(config, armed.value.token, { clock = function() return 1002 end }).ok, "duplicate confirmation is idempotent")
    gamma_arena_test_assert.equals(store:arm_defeat(config, context, {
        clock = function() return 1000 end,
        nonce = function() return "death_1" end
    }).value.token, armed.value.token, "duplicate arm is idempotent")

    local process_b = gamma_arena_session_store.new_store()
    config:corrupt("gamma_arena", "settings_schema_version", "1")
    config:corrupt("gamma_arena", "last_difficulty_id", "rookie")
    config:corrupt("gamma_arena", "last_seed_mode", "random")
    config:corrupt("gamma_arena", "addon_version", "0.2.0")
    gamma_arena_test_assert.is_true(gamma_arena_migrations.migrate(config).ok, "migration preserves confirmed defeat handoff")
    gamma_arena_test_assert.equals(process_b:peek_defeat(config, { clock = function() return 1600 end }).value.session_id, context.session_id, "confirmed defeat crosses VM boundary")
    gamma_arena_test_assert.equals(process_b:peek_defeat(config, { clock = function() return 1601 end }).value, false, "defeat expires after 600 seconds")
    assert_keys_absent(config, defeat_keys, "expired defeat clears all keys")

    local malformed = valid_defeat_context()
    malformed.session_nonce = "bad nonce!"
    gamma_arena_test_assert.equals(store:arm_defeat(fake_config(), malformed, { clock = function() return 1000 end }).error.code, "GA_DEFEAT_SESSION_NONCE_INVALID", "malformed defeat context rejects")

    local one_shot = fake_config()
    local one_shot_store = gamma_arena_session_store.new_store()
    local armed_one_shot = one_shot_store:arm_defeat(one_shot, context, { clock = function() return 1000 end, nonce = function() return "one_shot" end })
    gamma_arena_test_assert.is_true(one_shot_store:confirm_defeat(one_shot, armed_one_shot.value.token, { clock = function() return 1001 end }).ok, "one-shot fixture confirms")
    gamma_arena_test_assert.is_true(one_shot_store:consume_defeat(one_shot, armed_one_shot.value.token).ok, "confirmed defeat consumes")
    gamma_arena_test_assert.equals(one_shot_store:consume_defeat(one_shot, armed_one_shot.value.token).error.code, "GA_DEFEAT_NOT_PENDING", "defeat is one-shot")

    local armed_only = fake_config()
    local armed_only_store = gamma_arena_session_store.new_store()
    local armed_only_token = armed_only_store:arm_defeat(armed_only, context, { clock = function() return 1000 end, nonce = function() return "armed_only" end }).value.token
    gamma_arena_test_assert.equals(armed_only_store:consume_defeat(armed_only, armed_only_token).error.code, "GA_DEFEAT_NOT_CONFIRMED", "armed defeat cannot consume")
    gamma_arena_test_assert.is_true(armed_only_store:clear_defeat(armed_only).ok, "armed defeat clears explicitly")
    assert_keys_absent(armed_only, defeat_keys, "explicit armed clear removes all defeat keys")
end

local function defeat_duplicate_arm_uses_persisted_token()
    local config = fake_config()
    local store = gamma_arena_session_store.new_store()
    local context = valid_defeat_context()
    local clock = function() return 1000 end
    local first = store:arm_defeat(config, context, { clock = clock })
    gamma_arena_test_assert.is_true(first.ok, "default-nonce defeat arm succeeds")
    local persisted_token = config.data.defeat_token
    local duplicate = store:arm_defeat(config, context, { clock = clock })
    gamma_arena_test_assert.is_true(duplicate.ok, "duplicate arm without nonce override is idempotent")
    gamma_arena_test_assert.equals(duplicate.value.token, first.value.token, "duplicate arm returns original token")
    gamma_arena_test_assert.equals(config.data.defeat_token, persisted_token, "duplicate arm does not replace persisted nonce")
end

local function defeat_promotion_is_atomic_and_conflict_safe()
    local context = valid_defeat_context()
    local config = fake_config()
    local store = gamma_arena_session_store.new_store()
    local token = store:arm_defeat(config, context, { clock = function() return 1000 end, nonce = function() return "promote" end }).value.token
    gamma_arena_test_assert.is_true(store:confirm_defeat(config, token, { clock = function() return 1001 end }).ok, "promotion fixture confirms")
    local request = valid_request(123)
    request.seed_mode = "random"
    local promoted = store:issue_launch_from_defeat(config, token, request, { clock = function() return 1002 end, nonce = function() return "launch_from_death" end })
    gamma_arena_test_assert.is_true(promoted.ok, "confirmed defeat promotes to launch")
    gamma_arena_test_assert.equals(promoted.value.token, "ga1:1002:launch_from_death", "promotion issues distinct launch token")
    assert_keys_absent(config, defeat_keys, "promotion atomically removes defeat")
    gamma_arena_test_assert.equals(config.data.launch_pending, "true", "promotion atomically writes launch marker")
    gamma_arena_test_assert.equals(store:issue_launch_from_defeat(config, token, request, { clock = function() return 1003 end }).error.code, "GA_DEFEAT_NOT_PENDING", "promoted defeat cannot replay")

    local mismatch = fake_config()
    local mismatch_store = gamma_arena_session_store.new_store()
    local mismatch_token = mismatch_store:arm_defeat(mismatch, context, { clock = function() return 1000 end, nonce = function() return "mismatch" end }).value.token
    gamma_arena_test_assert.is_true(mismatch_store:confirm_defeat(mismatch, mismatch_token, { clock = function() return 1001 end }).ok, "mismatch fixture confirms")
    local wrong = valid_request(1)
    wrong.seed_mode = "random"
    wrong.difficulty_id = "rookie"
    gamma_arena_test_assert.equals(mismatch_store:issue_launch_from_defeat(mismatch, mismatch_token, wrong, { clock = function() return 1002 end }).error.code, "GA_DEFEAT_REQUEST_MISMATCH", "promotion binds mode and difficulty")
    gamma_arena_test_assert.equals(mismatch_store:issue_launch(mismatch, request, { clock = function() return 1002 end }).error.code, "GA_INTENT_CONFLICT", "ordinary launch cannot overwrite confirmed defeat")
    gamma_arena_test_assert.equals(mismatch_store:issue_resume(mismatch, {
        schema_version = 1, session_id = "session-1", session_nonce = "session_nonce_1", next_fight_index = 0, checkpoint_name = "_gamma_arena_checkpoint"
    }).error.code, "GA_INTENT_CONFLICT", "resume cannot overwrite confirmed defeat")

    local conflict = fake_config({ launch_pending = "true", defeat_pending = "true" })
    local inspected = gamma_arena_session_store.inspect_intents(conflict)
    gamma_arena_test_assert.equals(inspected.error.code, "GA_INTENT_CONFLICT", "launch and defeat conflict rejects")
    assert_keys_absent(conflict, launch_keys, "launch and defeat conflict clears launch")
    assert_keys_absent(conflict, defeat_keys, "launch and defeat conflict clears defeat")

    for fault_at = 1, 16 do
        local faulted = fake_config()
        local fault_store = gamma_arena_session_store.new_store()
        local fault_token = fault_store:arm_defeat(faulted, context, { clock = function() return 1000 end, nonce = function() return "fault_" .. tostring(fault_at) end }).value.token
        gamma_arena_test_assert.is_true(fault_store:confirm_defeat(faulted, fault_token, { clock = function() return 1001 end }).ok, "fault promotion fixture confirms")
        faulted:arm_fault(fault_at)
        local result = fault_store:issue_launch_from_defeat(faulted, fault_token, request, { clock = function() return 1002 end, nonce = function() return "retry_" .. tostring(fault_at) end })
        if not result.ok then
            assert_keys_absent(faulted, launch_keys, "failed promotion leaves no launch fragment")
            gamma_arena_test_assert.is_true(faulted.data.defeat_pending == nil or faulted.data.defeat_pending == "true", "failed promotion has no torn defeat marker")
        end
    end
end

local function migrations_cover_absent_v0_v1_and_future()
    local absent = fake_config()
    local absent_result = gamma_arena_migrations.migrate(absent)
    gamma_arena_test_assert.is_true(absent_result.ok, "absent settings migrate")
    gamma_arena_test_assert.equals(absent.data.settings_schema_version, "1", "absent schema becomes v1")
    gamma_arena_test_assert.equals(absent.save_count, 1, "migration saves exactly once")
    gamma_arena_test_assert.is_true(#absent_result.value.events > 0, "migration reports events")

    local v0 = fake_config({ last_difficulty_id = "veteran", last_seed_mode = "manual" })
    local v0_result = gamma_arena_migrations.migrate(v0)
    gamma_arena_test_assert.is_true(v0_result.ok, "v0 settings migrate")
    gamma_arena_test_assert.equals(v0.data.last_difficulty_id, "veteran", "v0 difficulty preserved")
    gamma_arena_test_assert.equals(v0.data.last_seed_mode, "manual", "v0 seed mode preserved")

    local future = fake_config({ settings_schema_version = "2" })
    local future_result = gamma_arena_migrations.migrate(future)
    gamma_arena_test_assert.is_false(future_result.ok, "future settings reject")
    gamma_arena_test_assert.equals(future_result.error.code, "GA_SETTINGS_SCHEMA_NEWER", "future schema code")
    gamma_arena_test_assert.equals(future.save_count, 0, "future settings remain untouched")
end

local function versioned_v1_config(addon_version)
    local initial = {
        settings_schema_version = "1",
        last_difficulty_id = "master",
        last_seed_mode = "random"
    }
    if addon_version ~= nil then initial.addon_version = addon_version end
    for _, key in ipairs(launch_keys) do initial[key] = "stale_launch" end
    for _, key in ipairs(resume_keys) do initial[key] = "stale_resume" end
    return fake_config(initial)
end

local function schema_v1_without_addon_version_is_incompatible()
    local config = versioned_v1_config(nil)
    local result = gamma_arena_migrations.migrate(config)
    gamma_arena_test_assert.is_true(result.ok, "unversioned v1 settings are adopted fail-closed")
    gamma_arena_test_assert.equals(config.data.addon_version, "0.4.0", "unversioned v1 records current addon")
    gamma_arena_test_assert.equals(config.save_count, 1, "unversioned v1 writes exactly once")
    assert_keys_absent(config, launch_keys, "unversioned v1 clears launch intent")
    assert_keys_absent(config, resume_keys, "unversioned v1 clears resume intent")
    gamma_arena_test_assert.equals(result.value.events[1].code, "GA_ADDON_VERSION_UNKNOWN", "unversioned v1 reports unknown addon")
    gamma_arena_test_assert.is_false(result.value.events[1].active_fight_compatible, "unversioned v1 never claims active fight compatibility")
end

local function schema_v1_current_addon_preserves_transient_intents()
    local config = versioned_v1_config("0.4.0")
    local result = gamma_arena_migrations.migrate(config)
    gamma_arena_test_assert.is_true(result.ok, "current v1 settings are idempotent")
    gamma_arena_test_assert.equals(config.save_count, 0, "current v1 does not save")
    gamma_arena_test_assert.equals(config.data.launch_pending, "stale_launch", "current addon does not clear launch intent")
    gamma_arena_test_assert.equals(config.data.resume_pending, "stale_resume", "current addon does not clear resume intent")
    gamma_arena_test_assert.equals(#result.value.events, 0, "current addon reports no migration event")
end

local function schema_v1_different_addon_clears_transient_intents()
    local config = versioned_v1_config("0.0.9")
    local result = gamma_arena_migrations.migrate(config)
    gamma_arena_test_assert.is_true(result.ok, "different addon version migrates")
    gamma_arena_test_assert.equals(config.data.addon_version, "0.4.0", "different addon records current version")
    gamma_arena_test_assert.equals(config.save_count, 1, "different addon writes exactly once")
    assert_keys_absent(config, launch_keys, "different addon clears launch intent")
    assert_keys_absent(config, resume_keys, "different addon clears resume intent")
    gamma_arena_test_assert.equals(result.value.events[1].code, "GA_ADDON_VERSION_CHANGED", "different addon reports version change")
    gamma_arena_test_assert.is_false(result.value.events[1].active_fight_compatible, "different addon never claims active fight compatibility")
end

local function request_validation_is_total_and_fail_closed()
    for _, text in ipairs({ "", "-1", "+1", "1.0", "1e3", "4294967296", " 1", "1 " }) do
        local result = gamma_arena_session_store.parse_manual_seed(text)
        gamma_arena_test_assert.is_false(result.ok, "invalid decimal seed rejects: " .. text)
    end
    gamma_arena_test_assert.equals(gamma_arena_session_store.parse_manual_seed("0").value, 0, "zero seed")
    gamma_arena_test_assert.equals(gamma_arena_session_store.parse_manual_seed("4294967295").value, 4294967295, "maximum seed")

    for _, seed in ipairs({ math.huge, -math.huge, 0/0, -1, 4294967296, 1.5 }) do
        local result = gamma_arena_session_store.validate_start_request(valid_request(seed))
        gamma_arena_test_assert.is_false(result.ok, "invalid numeric seed rejects")
    end
    gamma_arena_test_assert.equals(gamma_arena_session_store.validate_start_request(nil).error.code, "GA_START_REQUEST_INVALID", "nil request is Result error")
    gamma_arena_test_assert.equals(gamma_arena_session_store.validate_start_request({}).error.code, "GA_START_REQUEST_SCHEMA_INVALID", "missing schema is Result error")
end

local function random_seed_uses_injected_generator()
    local first = gamma_arena_session_store.random_session_seed(function() return 123456789 end)
    local second = gamma_arena_session_store.random_session_seed(function() return 123456789 end)
    gamma_arena_test_assert.is_true(first.ok and second.ok, "injected random generation succeeds")
    gamma_arena_test_assert.equals(first.value, second.value, "injected random generation is deterministic")
    gamma_arena_test_assert.equals(first.value, 123456789, "injected seed retained")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.random_session_seed(function() return math.huge end).ok, "invalid injected random rejects")
end

local function durable_preferences_are_exact()
    local config = fake_config({ unrelated = "keep" })
    local result = gamma_arena_session_store.save_preferences(config, "master", "manual")
    gamma_arena_test_assert.is_true(result.ok, "preferences save")
    gamma_arena_test_assert.equals(config.save_count, 1, "preferences transaction saves once")
    gamma_arena_test_assert.equals(#config.writes, 3, "only three durable keys written")
    gamma_arena_test_assert.equals(config.data.unrelated, "keep", "unrelated config preserved")
    gamma_arena_test_assert.equals(config.data.launch_pending, nil, "launch is not durable preference")
    gamma_arena_test_assert.equals(config.cache["gamma_arena&settings_schema_version"], nil, "successful transaction invalidates touched wrapper cache")
end

local function launch_token_is_volatile_ttl_bound_and_one_shot()
    local config = fake_config()
    local store = gamma_arena_session_store.new_store()
    local issued = store:issue_launch(config, valid_request(99), {
        clock = function() return 1000 end,
        nonce = function() return "nonce_1" end
    })
    gamma_arena_test_assert.is_true(issued.ok, "launch intent issued")
    gamma_arena_test_assert.equals(issued.value.token, "ga1:1000:nonce_1", "launch token grammar")
    gamma_arena_test_assert.equals(config.save_count, 1, "launch write saves once")

    local parsed = gamma_arena_session_store.parse_launch_token(issued.value.token, 1600)
    gamma_arena_test_assert.is_true(parsed.ok, "token valid at TTL boundary")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.parse_launch_token(issued.value.token, 1601).ok, "expired token rejects")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.parse_launch_token("ga1:bad:nonce", 1000).ok, "malformed token rejects")

    local ownership = store:validate_launch_ownership(config, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_true(ownership.ok, "fresh launch ownership validates without consumption")
    gamma_arena_test_assert.equals(ownership.value.session_seed, 99, "ownership validation returns the exact request")
    gamma_arena_test_assert.equals(config.save_count, 1, "ownership validation performs no persisted mutation")
    gamma_arena_test_assert.equals(config.data.launch_pending, "true", "ownership validation leaves the launch pending")
    local expired_ownership = store:validate_launch_ownership(config, { clock = function() return 1601 end })
    gamma_arena_test_assert.equals(expired_ownership.error.code, "GA_LAUNCH_TOKEN_EXPIRED", "ownership validation enforces token TTL")
    gamma_arena_test_assert.equals(config.save_count, 1, "rejected ownership validation remains non-mutating")
    gamma_arena_test_assert.equals(config.data.launch_pending, "true", "rejected validation leaves cleanup to fatal routing")

    local consumed = store:consume_launch(config, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_true(consumed.ok, "fresh volatile launch consumes")
    gamma_arena_test_assert.equals(consumed.value.session_seed, 99, "consumed request restored")
    gamma_arena_test_assert.equals(config.save_count, 2, "launch consume saves once")
    gamma_arena_test_assert.equals(config.data.launch_pending, nil, "launch keys removed")

    local repeated = store:consume_launch(config, { clock = function() return 1002 end })
    gamma_arena_test_assert.is_false(repeated.ok, "stale-cache repeated consume rejects")
    gamma_arena_test_assert.equals(repeated.error.code, "GA_LAUNCH_NOT_PENDING", "repeated consume code")

    local stale = fake_config({
        launch_pending = "true", launch_token = "ga1:1000:prior_process", launch_mode_id = "skirmish",
        launch_difficulty_id = "stalker", launch_seed_mode = "manual", launch_session_seed = "99", launch_stage = "issued"
    })
    local stale_result = gamma_arena_session_store.consume_launch(stale, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_false(stale_result.ok, "persisted prior-process token rejects")
    gamma_arena_test_assert.equals(stale_result.error.code, "GA_LAUNCH_HANDOFF_REQUIRED", "cross-VM launch requires a bridge lease")
end

local function launch_survives_vm_reload_with_matching_bridge_lease()
    local backend = fake_backend()
    local first_config = fake_config(nil, backend)
    local first_store = gamma_arena_session_store.new_store()
    local issued = first_store:issue_launch(first_config, valid_request(42), {
        clock = function() return 1000 end,
        nonce = function() return "cross_vm" end
    })
    gamma_arena_test_assert.is_true(issued.ok, "cross-VM launch issues")
    gamma_arena_test_assert.is_true(first_store:write_character_creation(first_config).ok, "cross-VM bridge persists")

    local second_config = fake_config(nil, backend)
    local second_store = gamma_arena_session_store.new_store()
    local consumed = second_store:consume_launch(second_config, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_true(consumed.ok, "matching bridge lease survives VM reload")
    gamma_arena_test_assert.equals(consumed.value.session_seed, 42, "cross-VM request remains exact")
    assert_keys_absent(second_config, launch_keys, "cross-VM launch consumes once")
    gamma_arena_test_assert.equals(second_config.data.bridge_pending, nil, "cross-VM bridge lease clears")
end

local function launch_bridge_survives_fake_start_and_target_migrations()
    local backend = fake_backend()
    local menu_config = fake_config(nil, backend)
    gamma_arena_test_assert.is_true(gamma_arena_migrations.migrate(menu_config).ok, "menu VM migration initializes current settings")

    local menu_store = gamma_arena_session_store.new_store()
    local issued = menu_store:issue_launch(menu_config, valid_request(43), {
        clock = function() return 1000 end,
        nonce = function() return "migration_handoff" end
    })
    gamma_arena_test_assert.is_true(issued.ok, "migration handoff launch issues")
    gamma_arena_test_assert.is_true(menu_store:write_character_creation(menu_config).ok, "migration handoff bridge persists")

    local fake_start_config = fake_config(nil, backend)
    gamma_arena_test_assert.is_true(gamma_arena_migrations.migrate(fake_start_config).ok, "fake_start VM migration succeeds")
    gamma_arena_test_assert.equals(fake_start_config.data.bridge_pending, "true", "fake_start migration preserves the active bridge lease")
    gamma_arena_test_assert.is_true(
        gamma_arena_session_store.new_store():mark_launch_deferred(fake_start_config, "fake_start", "l05_bar").ok,
        "fake_start VM records the serialized target-level handoff"
    )

    local target_config = fake_config(nil, backend)
    gamma_arena_test_assert.is_true(gamma_arena_migrations.migrate(target_config).ok, "target VM migration succeeds")
    gamma_arena_test_assert.equals(target_config.data.bridge_pending, "true", "target migration preserves the active bridge lease")
    local target_store = gamma_arena_session_store.new_store()
    local activation = target_store:validate_launch_activation(target_config, { serialized = true, current_level = "l05_bar", expected_level = "l05_bar" })
    gamma_arena_test_assert.is_true(activation.ok, "target VM accepts exact l05_bar serialized proof")
    gamma_arena_test_assert.equals(activation.value.route, "deferred", "target VM retains deferred activation route")
    local consumed = gamma_arena_session_store.new_store():consume_launch(target_config, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_true(consumed.ok, "target VM consumes the launch after both migrations")
    gamma_arena_test_assert.equals(consumed.value.session_seed, 43, "migration handoff request remains exact")
end

local function migration_invalidation_restores_active_bridge()
    local backend = fake_backend({
        settings_schema_version = "1",
        addon_version = "0.0.9",
        last_difficulty_id = "stalker",
        last_seed_mode = "manual",
        new_game_character_name = "Original_Stalker",
        new_game_faction = "loner"
    })
    local menu_config = fake_config(nil, backend)
    local menu_store = gamma_arena_session_store.new_store()
    local issued = menu_store:issue_launch(menu_config, valid_request(44), {
        clock = function() return 1000 end,
        nonce = function() return "invalidated_handoff" end
    })
    gamma_arena_test_assert.is_true(issued.ok, "old-version launch issues")
    gamma_arena_test_assert.is_true(menu_store:write_character_creation(menu_config).ok, "old-version bridge persists")

    local target_config = fake_config(nil, backend)
    local migrated = gamma_arena_migrations.migrate(target_config)
    gamma_arena_test_assert.is_true(migrated.ok, "version transition succeeds")
    gamma_arena_test_assert.equals(target_config.data.launch_pending, nil, "version transition invalidates launch")
    gamma_arena_test_assert.equals(target_config.data.bridge_pending, nil, "version transition consumes invalidated bridge")
    gamma_arena_test_assert.equals(target_config.data.new_game_character_name, "Original_Stalker", "version transition restores character name")
    gamma_arena_test_assert.equals(target_config.data.new_game_faction, "loner", "version transition restores faction")
end

local function launch_handoff_rejects_mismatched_or_expired_lease()
    local mismatch_backend = fake_backend()
    local mismatch_config = fake_config(nil, mismatch_backend)
    local mismatch_issuer = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(mismatch_issuer:issue_launch(mismatch_config, valid_request(51), {
        clock = function() return 1000 end,
        nonce = function() return "mismatch" end
    }).ok, "mismatch launch issues")
    gamma_arena_test_assert.is_true(mismatch_issuer:write_character_creation(mismatch_config).ok, "mismatch bridge persists")
    mismatch_config:corrupt("gamma_arena", "bridge_launch_token", "ga1:1000:other")
    local mismatch = gamma_arena_session_store.new_store():consume_launch(fake_config(nil, mismatch_backend), {
        clock = function() return 1001 end
    })
    gamma_arena_test_assert.is_false(mismatch.ok, "mismatched bridge token rejects")
    gamma_arena_test_assert.equals(mismatch.error.code, "GA_LAUNCH_HANDOFF_INVALID", "mismatched bridge token has stable code")

    local expired_backend = fake_backend()
    local expired_config = fake_config(nil, expired_backend)
    local expired_issuer = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(expired_issuer:issue_launch(expired_config, valid_request(52), {
        clock = function() return 1000 end,
        nonce = function() return "expired" end
    }).ok, "expired launch issues")
    gamma_arena_test_assert.is_true(expired_issuer:write_character_creation(expired_config).ok, "expired bridge persists")
    local expired = gamma_arena_session_store.new_store():consume_launch(fake_config(nil, expired_backend), {
        clock = function() return 1601 end
    })
    gamma_arena_test_assert.is_false(expired.ok, "expired cross-VM token rejects")
    gamma_arena_test_assert.equals(expired.error.code, "GA_LAUNCH_TOKEN_EXPIRED", "expired cross-VM token preserves TTL code")
end

local function serialized_launch_requires_fake_start_phase_proof()
    local backend = fake_backend()
    local issuer_config = fake_config(nil, backend)
    local issuer = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(issuer:issue_launch(issuer_config, valid_request(53), {
        clock = function() return 1000 end,
        nonce = function() return "serialized_route" end
    }).ok, "serialized launch issues")
    gamma_arena_test_assert.is_true(issuer:write_character_creation(issuer_config).ok, "serialized bridge persists")

    local target_store = gamma_arena_session_store.new_store()
    local target_config = fake_config(nil, backend)
    local wrong_direct = target_store:validate_launch_activation(target_config, {
        serialized = false,
        current_level = "l01_escape",
        expected_level = "l05_bar"
    })
    gamma_arena_test_assert.is_false(wrong_direct.ok, "non-serialized launch rejects an unexpected current level")
    gamma_arena_test_assert.equals(wrong_direct.error.code, "GA_LAUNCH_REQUIRES_NEW_GAME", "unexpected direct route preserves public code")
    gamma_arena_test_assert.is_true(target_store:validate_launch_activation(target_config, {
        serialized = false,
        current_level = "l05_bar",
        expected_level = "l05_bar"
    }).ok, "non-serialized launch accepts the exact target level")
    gamma_arena_test_assert.is_true(target_store:validate_launch_activation(target_config, {
        serialized = false,
        current_level = "fake_start",
        expected_level = "l05_bar"
    }).ok, "non-serialized launch accepts the character-creation handoff level")
    local unproven = target_store:validate_launch_activation(target_config, {
        serialized = true,
        current_level = "l05_bar",
        expected_level = "l05_bar"
    })
    gamma_arena_test_assert.is_false(unproven.ok, "serialized target without fake_start proof rejects")
    gamma_arena_test_assert.equals(unproven.error.code, "GA_LAUNCH_REQUIRES_NEW_GAME", "unproven serialized route preserves public code")

    local fake_start_store = gamma_arena_session_store.new_store()
    gamma_arena_test_assert.is_true(fake_start_store:mark_launch_deferred(fake_config(nil, backend), "fake_start", "l05_bar").ok, "fake_start phase persists")
    gamma_arena_test_assert.is_true(gamma_arena_session_store.new_store():validate_launch_activation(fake_config(nil, backend), {
        serialized = false,
        current_level = "fake_start",
        expected_level = "l05_bar"
    }).ok, "repeated fake_start update accepts the exact persisted deferred route")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.new_store():validate_launch_activation(fake_config(nil, backend), {
        serialized = false,
        current_level = "l05_bar",
        expected_level = "l05_bar"
    }).ok, "deferred target requires serialized fake_start proof")
    local proven = gamma_arena_session_store.new_store():validate_launch_activation(fake_config(nil, backend), {
        serialized = true,
        current_level = "l05_bar",
        expected_level = "l05_bar"
    })
    gamma_arena_test_assert.is_true(proven.ok, "matching serialized target accepts exact fake_start proof")
end

local function stale_launch_is_recovered_by_new_store()
    local backend = fake_backend()
    local process_a_config = fake_config(nil, backend)
    local process_a = gamma_arena_session_store.new_store()
    local process_b = gamma_arena_session_store.new_store()
    local first = process_a:issue_launch(process_a_config, valid_request(11), {
        clock = function() return 1000 end,
        nonce = function() return "process_a" end
    })
    gamma_arena_test_assert.is_true(first.ok, "process A launch issued")
    local duplicate = process_a:issue_launch(process_a_config, valid_request(12), {
        clock = function() return 1001 end,
        nonce = function() return "duplicate" end
    })
    gamma_arena_test_assert.equals(duplicate.error.code, "GA_LAUNCH_ALREADY_PENDING", "same-store duplicate rejects")

    local process_b_config = fake_config(nil, backend)
    local recovered = process_b:issue_launch(process_b_config, valid_request(22), {
        clock = function() return 1001 end,
        nonce = function() return "process_b" end
    })
    gamma_arena_test_assert.equals(recovered.error.code, "GA_LAUNCH_STALE_CLEARED", "new process reports cleared orphan")
    local process_b_fresh = process_b:issue_launch(process_b_config, valid_request(22), {
        clock = function() return 1002 end,
        nonce = function() return "process_b_fresh" end
    })
    gamma_arena_test_assert.is_true(process_b_fresh.ok, "fresh retry succeeds after orphan cleanup")
    gamma_arena_test_assert.equals(process_b_fresh.value.request.session_seed, 22, "fresh retry replaces orphan")

    for _, stale_token in ipairs({ "ga1:1:expired", "malformed" }) do
        local stale_backend = fake_backend({
            launch_pending = "true", launch_token = stale_token, launch_mode_id = "skirmish",
            launch_difficulty_id = "stalker", launch_seed_mode = "manual", launch_session_seed = "7"
        })
        local stale_config = fake_config(nil, stale_backend)
        local store = gamma_arena_session_store.new_store()
        local fresh = store:issue_launch(stale_config, valid_request(33), {
            clock = function() return 1000 end,
            nonce = function() return "fresh" end
        })
        gamma_arena_test_assert.equals(fresh.error.code, "GA_LAUNCH_STALE_CLEARED", "expired/malformed launch cleanup is reported")
        local retried = store:issue_launch(stale_config, valid_request(33), {
            clock = function() return 1001 end,
            nonce = function() return "fresh_retry" end
        })
        gamma_arena_test_assert.is_true(retried.ok, "expired/malformed launch retry succeeds")
        gamma_arena_test_assert.equals(stale_backend.working.launch_session_seed, "33", "fresh payload is complete")
    end

    for _, stale_backend in ipairs({
        fake_backend({ launch_pending = "maybe" }),
        fake_backend({ launch_difficulty_id = "stalker" })
    }) do
        local store = gamma_arena_session_store.new_store()
        local fresh = store:issue_launch(fake_config(nil, stale_backend), valid_request(44), {
            clock = function() return 1000 end,
            nonce = function() return "missing_token" end
        })
        gamma_arena_test_assert.equals(fresh.error.code, "GA_LAUNCH_STALE_CLEARED", "marker/payload without token is cleared")
        local retry_config = fake_config(nil, stale_backend)
        gamma_arena_test_assert.is_true(store:issue_launch(retry_config, valid_request(44), {
            clock = function() return 1001 end,
            nonce = function() return "missing_token_retry" end
        }).ok, "tokenless stale retry succeeds")
    end
end

local function same_store_corrupt_launch_is_replaced()
    local corruptions = {
        { key = "launch_pending", value = "maybe" },
        { key = "launch_token", value = nil },
        { key = "launch_token", value = "ga1:1000:forged" },
        { key = "launch_mode_id", value = nil },
        { key = "launch_mode_id", value = "survival" },
        { key = "launch_difficulty_id", value = nil },
        { key = "launch_difficulty_id", value = "impossible" },
        { key = "launch_seed_mode", value = nil },
        { key = "launch_seed_mode", value = "implicit" },
        { key = "launch_session_seed", value = nil },
        { key = "launch_session_seed", value = "0001" },
        { key = "launch_session_seed", value = "1e3" }
    }
    for index, corruption in ipairs(corruptions) do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        local issued = store:issue_launch(config, valid_request(10), {
            clock = function() return 1000 end,
            nonce = function() return "permitted_" .. tostring(index) end
        })
        gamma_arena_test_assert.is_true(issued.ok, "same-store corruption fixture issued")
        config:corrupt("gamma_arena", corruption.key, corruption.value)

        local replaced = store:issue_launch(config, valid_request(20 + index), {
            clock = function() return 1001 end,
            nonce = function() return "replacement_" .. tostring(index) end
        })
        gamma_arena_test_assert.equals(replaced.error.code, "GA_LAUNCH_STALE_CLEARED", "corrupt same-store pending launch is cleared: " .. corruption.key)
        local retried = store:issue_launch(config, valid_request(20 + index), {
            clock = function() return 1002 end,
            nonce = function() return "replacement_retry_" .. tostring(index) end
        })
        gamma_arena_test_assert.is_true(retried.ok, "same-store fresh retry succeeds")
        gamma_arena_test_assert.equals(config.persisted.launch_session_seed, tostring(20 + index), "replacement is persisted completely")
    end
end

local function resume_intent_requires_matching_nonce_and_is_one_shot()
    local config = fake_config()
    local intent = {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        next_fight_index = 3,
        checkpoint_name = "_gamma_arena_checkpoint"
    }
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(config, intent).ok, "resume intent issued")
    local wrong_nonce = valid_session(3)
    wrong_nonce.session_nonce = "wrong"
    local mismatch = gamma_arena_session_store.consume_resume(config, wrong_nonce)
    gamma_arena_test_assert.is_false(mismatch.ok, "resume nonce mismatch rejects")
    gamma_arena_test_assert.equals(mismatch.error.code, "GA_RESUME_NONCE_MISMATCH", "resume mismatch code")

    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(config, intent).ok, "resume can be reissued")
    local consumed = gamma_arena_session_store.consume_resume(config, valid_session(3))
    gamma_arena_test_assert.is_true(consumed.ok, "matching resume consumes")
    gamma_arena_test_assert.equals(consumed.value.checkpoint_name, "_gamma_arena_checkpoint", "checkpoint retained")
    gamma_arena_test_assert.equals(gamma_arena_session_store.consume_resume(config, valid_session(3)).error.code, "GA_RESUME_NOT_PENDING", "resume is one-shot")

    local already_pending = fake_config()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(already_pending, intent).ok, "first resume issuance succeeds")
    local duplicate = gamma_arena_session_store.issue_resume(already_pending, intent)
    gamma_arena_test_assert.is_false(duplicate.ok, "existing resume cannot be overwritten")
    gamma_arena_test_assert.equals(duplicate.error.code, "GA_RESUME_ALREADY_PENDING", "duplicate resume code")

    local conflict = fake_config()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(conflict, intent).ok, "resume for conflict fixture issued")
    conflict.data.launch_pending = "true"
    local conflicted = gamma_arena_session_store.consume_resume(conflict, valid_session(3))
    gamma_arena_test_assert.is_false(conflicted.ok, "simultaneous launch and resume reject")
    gamma_arena_test_assert.equals(conflicted.error.code, "GA_INTENT_CONFLICT", "resume conflict code")
    gamma_arena_test_assert.equals(conflict.data.resume_pending, nil, "conflicted resume is cleared")

    local tokenless_conflict = fake_config({ launch_pending = "true", resume_pending = "true" })
    local launch_conflict = gamma_arena_session_store.consume_launch(tokenless_conflict, { clock = function() return 1000 end })
    gamma_arena_test_assert.equals(launch_conflict.error.code, "GA_INTENT_CONFLICT", "tokenless launch/resume conflict is structured")
    assert_keys_absent(tokenless_conflict, launch_keys, "tokenless conflict clears launch")
    assert_keys_absent(tokenless_conflict, resume_keys, "tokenless conflict clears resume")

    local malformed = fake_config({ resume_pending = "maybe" })
    local malformed_result = gamma_arena_session_store.consume_resume(malformed, valid_session(3))
    gamma_arena_test_assert.is_false(malformed_result.ok, "malformed resume marker rejects")
    gamma_arena_test_assert.equals(malformed_result.error.code, "GA_RESUME_PENDING_INVALID", "malformed resume code")
    gamma_arena_test_assert.equals(malformed.data.resume_pending, nil, "malformed resume marker is cleared")

    local baseline_config = fake_config()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(baseline_config, intent).ok, "baseline override resume issued")
    local baseline_consumed = gamma_arena_session_store.consume_resume(baseline_config, valid_session(0))
    gamma_arena_test_assert.is_true(baseline_consumed.ok, "clean checkpoint baseline may advance to external next fight index")
    gamma_arena_test_assert.equals(baseline_consumed.value.next_fight_index, 3, "external next fight index survives clean checkpoint validation")

    local backward_config = fake_config()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(backward_config, intent).ok, "backward resume fixture issued")
    local backward = gamma_arena_session_store.consume_resume(backward_config, valid_session(4))
    gamma_arena_test_assert.equals(backward.error.code, "GA_RESUME_FIGHT_INDEX_MISMATCH", "resume intent cannot move behind checkpoint baseline")
    assert_keys_absent(backward_config, resume_keys, "backward resume intent is consumed fail-closed")

    local unbounded_intent = copy_table(intent)
    unbounded_intent.next_fight_index = 4294967296
    gamma_arena_test_assert.equals(gamma_arena_session_store.issue_resume(fake_config(), unbounded_intent).error.code, "GA_RESUME_FIGHT_INDEX_INVALID", "resume fight index is bounded uint32")
end

local function prepared_resume_mismatches_use_recovery_taxonomy()
    local intent = {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        next_fight_index = 3,
        checkpoint_name = "_gamma_arena_checkpoint"
    }
    local cases = {
        { label = "session id", mutate = function(session) session.session_id = "wrong" end },
        { label = "session nonce", mutate = function(session) session.session_nonce = "wrong" end },
        { label = "checkpoint", mutate = function(session) session.checkpoint_name = "wrong" end },
        { label = "fight index", mutate = function(session) session.fight_index = 4 end }
    }
    for _, case in ipairs(cases) do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, case.label .. " recovery fixture issued")
        local expected = valid_session(3)
        case.mutate(expected)
        local prepared = store:prepare_resume(config, expected)
        gamma_arena_test_assert.is_false(prepared.ok, case.label .. " preparation mismatch rejects")
        gamma_arena_test_assert.equals(prepared.error.code, "GA_CHECKPOINT_RECOVERY_MISMATCH", case.label .. " preparation uses the limited recovery taxonomy")
        assert_keys_absent(config, resume_keys, case.label .. " preparation clears the rejected route")
    end
end

local function resume_rejects_tampered_expected_session()
    local intent = {
        schema_version = 1, session_id = "session-1", session_nonce = "session_nonce_1",
        next_fight_index = 3, checkpoint_name = "_gamma_arena_checkpoint"
    }
    for _, mutation in ipairs({
        function(session) session.checkpoint_name = "_gamma_arena_other" end,
        function(session) session.schema_version = 2 end,
        function(session) session.generator_version = 2 end,
        function(session) session.catalog_revision = 2 end,
        function(session) session.fight_index = 4 end,
        function(session) session.mode_id = "unknown" end
    }) do
        local config = fake_config()
        gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(config, intent).ok, "tamper fixture issued")
        local session = valid_session(3)
        mutation(session)
        local rejected = gamma_arena_session_store.consume_resume(config, session)
        gamma_arena_test_assert.is_false(rejected.ok, "tampered expected session rejects")
        assert_keys_absent(config, resume_keys, "tampered resume clears once")
        gamma_arena_test_assert.equals(gamma_arena_session_store.consume_resume(config, valid_session(3)).error.code, "GA_RESUME_NOT_PENDING", "tampered resume cannot replay")
    end

    local bad_checkpoint_intent = copy_table(intent)
    bad_checkpoint_intent.checkpoint_name = "_gamma_arena_other"
    gamma_arena_test_assert.equals(gamma_arena_session_store.issue_resume(fake_config(), bad_checkpoint_intent).error.code, "GA_RESUME_CHECKPOINT_INVALID", "resume intent checkpoint is reserved")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.consume_resume(fake_config({ resume_pending = "true" }), nil).ok, "nil expected session returns Result")
end

local function assert_table_equals(actual, expected, keys, message)
    for _, key in ipairs(keys) do
        gamma_arena_test_assert.equals(actual[key], expected[key], message .. ": " .. key)
    end
end

local function mutation_failure_matrix_is_crash_safe()
    for fault_at = 1, 4 do
        local config = fake_config({ unrelated = "keep" })
        config:arm_fault(fault_at)
        local failed = gamma_arena_migrations.migrate(config)
        gamma_arena_test_assert.is_false(failed.ok, "migration injected fault " .. fault_at)
        gamma_arena_test_assert.equals(config.data.settings_schema_version, nil, "migration marker rolled back")
        gamma_arena_test_assert.equals(config.data.last_difficulty_id, nil, "migration difficulty rolled back")
        gamma_arena_test_assert.equals(config.data.last_seed_mode, nil, "migration seed mode rolled back")
        gamma_arena_test_assert.equals(config.persisted.settings_schema_version, nil, "failed migration does not advance persisted marker")
        config:clear_fault()
        gamma_arena_test_assert.is_true(gamma_arena_migrations.migrate(config).ok, "migration retry succeeds")
    end

    for fault_at = 1, 4 do
        local baseline = { settings_schema_version = "1", last_difficulty_id = "rookie", last_seed_mode = "random" }
        local config = fake_config(baseline)
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(gamma_arena_session_store.save_preferences(config, "master", "manual").ok, "preferences injected fault")
        assert_table_equals(config.data, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "preferences rollback")
        assert_table_equals(config.persisted, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "preferences persisted rollback")
        config:clear_fault()
        gamma_arena_test_assert.is_true(gamma_arena_session_store.save_preferences(config, "master", "manual").ok, "preferences retry succeeds")
    end

    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        config:arm_fault(fault_at)
        local failed = store:issue_launch(config, valid_request(9), { clock = function() return 100 end, nonce = function() return "fault" end })
        gamma_arena_test_assert.is_false(failed.ok, "launch issue injected fault")
        assert_keys_absent(config, launch_keys, "failed launch issue leaves no torn intent")
        assert_keys_absent({ data = config.persisted }, launch_keys, "failed launch issue does not persist torn intent")
        config:clear_fault()
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(9), { clock = function() return 101 end, nonce = function() return "retry" end }).ok, "launch issue retry succeeds")
    end

    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(9), { clock = function() return 100 end, nonce = function() return "consume" end }).ok, "launch consume fixture issued")
        config:arm_fault(fault_at)
        local failed = store:consume_launch(config, { clock = function() return 101 end })
        gamma_arena_test_assert.is_false(failed.ok, "launch consume injected fault")
        assert_keys_absent(config, launch_keys, "failed launch consume is fail-closed")
        assert_keys_absent({ data = config.persisted }, launch_keys, "failed launch consume persisted state is fail-closed")
        config:clear_fault()
        gamma_arena_test_assert.equals(store:consume_launch(config, { clock = function() return 102 end }).error.code, "GA_LAUNCH_NOT_PENDING", "failed consume cannot replay")
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(10), { clock = function() return 103 end, nonce = function() return "after" end }).ok, "new launch succeeds after failed consume")
    end

    local intent = { schema_version = 1, session_id = "session-1", session_nonce = "session_nonce_1", next_fight_index = 3, checkpoint_name = "_gamma_arena_checkpoint" }
    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(store:issue_resume(config, intent).ok, "resume issue injected fault")
        assert_keys_absent(config, resume_keys, "failed resume issue leaves no torn intent")
        assert_keys_absent({ data = config.persisted }, resume_keys, "failed resume issue does not persist torn intent")
        config:clear_fault()
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "resume issue retry succeeds")
    end

    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "resume consume fixture issued")
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(store:consume_resume(config, valid_session(3)).ok, "resume consume injected fault")
        assert_keys_absent(config, resume_keys, "failed resume consume is fail-closed")
        assert_keys_absent({ data = config.persisted }, resume_keys, "failed resume consume persisted state is fail-closed")
        config:clear_fault()
        gamma_arena_test_assert.equals(store:consume_resume(config, valid_session(3)).error.code, "GA_RESUME_NOT_PENDING", "failed resume consume cannot replay")
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "new resume succeeds after failed consume")
    end

    for fault_at = 1, 22 do
        local baseline = {}
        for _, key in ipairs(character_keys) do baseline[key] = "old_" .. key end
        local config = fake_config(baseline)
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(gamma_arena_session_store.write_character_creation(config).ok, "character bridge injected fault")
        assert_table_equals(config.data, baseline, character_keys, "character bridge rollback")
        assert_table_equals(config.persisted, baseline, character_keys, "character bridge persisted rollback")
        config:clear_fault()
        gamma_arena_test_assert.is_true(gamma_arena_session_store.write_character_creation(config).ok, "character bridge retry succeeds")
    end
end

local function recovery_failure_quarantines_transaction()
    local baseline = { settings_schema_version = "1", last_difficulty_id = "rookie", last_seed_mode = "random" }
    for _, recovery_fault in ipairs({
        { position = 1, mode = "throw" },
        { position = 1, mode = "false" },
        { position = 4, mode = "throw" },
        { position = 4, mode = "false" }
    }) do
        local config = fake_config(baseline)
        config:arm_fault(2)
        config:arm_recovery_fault(recovery_fault.position, recovery_fault.mode)
        local failed = gamma_arena_session_store.save_preferences(config, "master", "manual")
        gamma_arena_test_assert.is_false(failed.ok, "primary plus recovery fault rejects")
        gamma_arena_test_assert.is_true(gamma_arena_config_tx.is_quarantined(config), "incomplete recovery quarantines config")
        gamma_arena_test_assert.equals(config.save_count, 0, "incomplete recovery never invokes a successful save")
        assert_table_equals(config.persisted, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "incomplete recovery does not advance persisted backend")

        local blocked = gamma_arena_session_store.save_preferences(config, "veteran", "manual")
        gamma_arena_test_assert.equals(blocked.error.code, "GA_CONFIG_QUARANTINED", "quarantine blocks later Arena transaction")
        local blocked_snapshot = gamma_arena_config_tx.snapshot(config, "gamma_arena", { "settings_schema_version" })
        gamma_arena_test_assert.equals(blocked_snapshot.error.code, "GA_CONFIG_QUARANTINED", "public snapshot is blocked while recovery is quarantined")
        local blocked_settings_read = gamma_arena_migrations.read_settings(config)
        gamma_arena_test_assert.equals(blocked_settings_read.error.code, "GA_CONFIG_QUARANTINED", "quarantine blocks later Arena settings reads")

        config:clear_fault()
        local recovered = gamma_arena_config_tx.recover(config)
        gamma_arena_test_assert.is_true(recovered.ok, "explicit touched-key recovery succeeds")
        gamma_arena_test_assert.is_false(gamma_arena_config_tx.is_quarantined(config), "successful recovery clears quarantine")
        gamma_arena_test_assert.is_true(gamma_arena_config_tx.snapshot(config, "gamma_arena", { "settings_schema_version" }).ok, "public snapshot succeeds after explicit recovery")
        assert_table_equals(config.data, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "working backend restored")
        assert_table_equals(config.persisted, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "persisted backend restored")
        gamma_arena_test_assert.equals(config.cache["gamma_arena&settings_schema_version"], nil, "recovery invalidates touched wrapper cache")
        gamma_arena_test_assert.is_true(gamma_arena_session_store.save_preferences(config, "veteran", "manual").ok, "retry is allowed only after recovery")
    end

    local recovery_read = fake_config(baseline)
    local raw_ini = recovery_read.ini
    recovery_read.ini = nil
    recovery_read:arm_fault(2)
    gamma_arena_test_assert.is_false(gamma_arena_session_store.save_preferences(recovery_read, "master", "manual").ok, "missing raw recovery port rejects")
    gamma_arena_test_assert.is_true(gamma_arena_config_tx.is_quarantined(recovery_read), "recovery read/port failure quarantines config")
    assert_table_equals(recovery_read.persisted, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "recovery read failure preserves persisted backend")
    recovery_read.ini = raw_ini
    recovery_read:clear_fault()
    gamma_arena_test_assert.is_true(gamma_arena_config_tx.recover(recovery_read).ok, "restored raw port recovers quarantine")

    local marker_config = fake_config()
    local marker_store = gamma_arena_session_store.new_store()
    marker_config:arm_fault(7)
    marker_config:arm_recovery_fault(1)
    local marker_failure = marker_store:issue_launch(marker_config, valid_request(5), {
        clock = function() return 100 end,
        nonce = function() return "quarantined_marker" end
    })
    gamma_arena_test_assert.is_false(marker_failure.ok, "primary save plus marker rollback failure rejects")
    gamma_arena_test_assert.is_true(marker_failure.error.context.persisted_state_may_be_unknown, "primary save failure reports persisted-state uncertainty")
    gamma_arena_test_assert.equals(marker_store:consume_launch(marker_config, { clock = function() return 101 end }).error.code, "GA_CONFIG_QUARANTINED", "working marker is never consumable while quarantined")
    assert_keys_absent({ data = marker_config.persisted }, launch_keys, "failed marker save does not advance fake persisted backend")
    marker_config:clear_fault()
    gamma_arena_test_assert.is_true(gamma_arena_config_tx.recover(marker_config).ok, "marker quarantine recovers through raw port")
    assert_keys_absent(marker_config, launch_keys, "marker recovery clears working intent")
    assert_keys_absent({ data = marker_config.persisted }, launch_keys, "marker recovery clears persisted intent")
end

local function read_and_false_return_faults_are_safe()
    local read_fault = fake_config()
    read_fault:arm_read_fault(1)
    local unreadable = gamma_arena_session_store.new_store():issue_launch(read_fault, valid_request(1), {
        clock = function() return 100 end,
        nonce = function() return "read_fault" end
    })
    gamma_arena_test_assert.is_false(unreadable.ok, "read fault rejects before mutation")
    assert_keys_absent(read_fault, launch_keys, "read fault leaves working backend untouched")
    assert_keys_absent({ data = read_fault.persisted }, launch_keys, "read fault leaves persisted backend untouched")
    gamma_arena_test_assert.is_false(gamma_arena_config_tx.is_quarantined(read_fault), "pre-mutation read fault does not poison config")

    local false_read = fake_config({ resume_pending = "false" })
    false_read:arm_read_fault(2, "false")
    local false_read_result = gamma_arena_session_store.new_store():issue_launch(false_read, valid_request(1), {
        clock = function() return 100 end,
        nonce = function() return "false_read" end
    })
    gamma_arena_test_assert.equals(false_read_result.error.code, "GA_CONFIG_READ_FAILED", "declared false-return session read rejects")
    assert_keys_absent(false_read, launch_keys, "false-return session read leaves working backend untouched")

    local false_settings_read = fake_config({ settings_schema_version = "1", last_difficulty_id = "rookie", last_seed_mode = "random" })
    false_settings_read:arm_read_fault(1, "false")
    local false_settings_result = gamma_arena_migrations.read_settings(false_settings_read)
    gamma_arena_test_assert.equals(false_settings_result.error.code, "GA_SETTINGS_READ_FAILED", "declared false-return settings read rejects")

    for _, primary_fault in ipairs({
        { position = 1, mode = "false" },
        { position = 7, mode = "false" }
    }) do
        local config = fake_config()
        config:arm_fault(primary_fault.position, primary_fault.mode)
        local failed = gamma_arena_session_store.new_store():issue_launch(config, valid_request(2), {
            clock = function() return 100 end,
            nonce = function() return "false_return" end
        })
        gamma_arena_test_assert.is_false(failed.ok, "declared false-return primary failure rejects")
        assert_keys_absent(config, launch_keys, "false-return primary failure restores working backend")
        assert_keys_absent({ data = config.persisted }, launch_keys, "false-return primary failure restores persisted backend")
    end

    local nil_success = fake_config()
    nil_success.gamma_arena_boolean_returns = false
    local original_write = nil_success.w_value
    local original_remove = nil_success.remove_line
    local original_save = nil_success.save
    function nil_success:w_value(section, key, value) original_write(self, section, key, value) end
    function nil_success:remove_line(section, key) original_remove(self, section, key) end
    function nil_success:save() original_save(self) end
    local accepted = gamma_arena_session_store.new_store():issue_launch(nil_success, valid_request(3), {
        clock = function() return 100 end,
        nonce = function() return "nil_success" end
    })
    gamma_arena_test_assert.is_true(accepted.ok, "nil returns remain success for adapters without boolean contract")
end

local function present_empty_config_values_snapshot_as_empty_strings()
    local config = fake_config()
    local original_line_exist = config.line_exist
    local original_r_string_ex = config.r_string_ex
    function config:line_exist(section, key)
        if section == "character_creation" and key == "new_game_hardcore_mode" then return true end
        return original_line_exist(self, section, key)
    end
    function config:r_string_ex(section, key)
        if section == "character_creation" and key == "new_game_hardcore_mode" then return nil end
        return original_r_string_ex(self, section, key)
    end

    local snapshot = gamma_arena_config_tx.snapshot(config, "character_creation", { "new_game_hardcore_mode" })
    gamma_arena_test_assert.is_true(snapshot.ok, "present empty config value is a valid snapshot entry")
    gamma_arena_test_assert.is_true(snapshot.value.entries.new_game_hardcore_mode.present, "empty config value retains key presence")
    gamma_arena_test_assert.equals(snapshot.value.entries.new_game_hardcore_mode.value, "", "empty config value normalizes to an empty string")
end

local function stale_cleanup_and_conflict_faults_are_safe()
    for fault_at = 1, 7 do
        local config = fake_config({
            launch_pending = "true", launch_token = "ga1:1:prior", launch_mode_id = "skirmish",
            launch_difficulty_id = "stalker", launch_seed_mode = "manual", launch_session_seed = "7"
        })
        config:arm_fault(fault_at)
        local store = gamma_arena_session_store.new_store()
        local failed = store:issue_launch(config, valid_request(8), {
            clock = function() return 1000 end,
            nonce = function() return "stale_retry" end
        })
        gamma_arena_test_assert.is_false(failed.ok, "stale cleanup injected fault")
        assert_keys_absent(config, launch_keys, "failed stale cleanup is fail-closed in working backend")
        assert_keys_absent({ data = config.persisted }, launch_keys, "failed stale cleanup is fail-closed in persisted backend")
        config:clear_fault()
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(8), {
            clock = function() return 1001 end,
            nonce = function() return "stale_recovered" end
        }).ok, "stale cleanup can retry after complete recovery")
    end

    local intent = { schema_version = 1, session_id = "session-1", session_nonce = "session_nonce_1", next_fight_index = 3, checkpoint_name = "_gamma_arena_checkpoint" }
    for fault_at = 1, 13 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "conflict-clear fixture issued")
        config:corrupt("gamma_arena", "launch_pending", "true")
        config:arm_fault(fault_at)
        local failed = store:consume_resume(config, valid_session(3))
        gamma_arena_test_assert.is_false(failed.ok, "conflict clear injected fault")
        assert_keys_absent(config, launch_keys, "failed conflict clear removes launch working keys")
        assert_keys_absent(config, resume_keys, "failed conflict clear removes resume working keys")
        assert_keys_absent({ data = config.persisted }, launch_keys, "failed conflict clear removes launch persisted keys")
        assert_keys_absent({ data = config.persisted }, resume_keys, "failed conflict clear removes resume persisted keys")
    end
end

local function dxml_fixture(options)
    options = options or {}
    local menu = { kids = {} }
    local pause = { kids = {} }
    local names = options.without_new_game
        and { "btn_load", "btn_lastsave", "btn_options", "btn_mcm", "btn_originals", "btn_quit" }
        or { "btn_newgame", "btn_load", "btn_lastsave", "btn_options", "btn_mcm", "btn_originals", "btn_quit" }
    for _, name in ipairs(names) do
        menu.kids[#menu.kids + 1] = { name = name, parent = menu }
    end
    for _, name in ipairs({ "btn_ret", "btn_lastsave", "btn_load", "btn_save", "btn_options", "btn_mcm", "btn_quit_to_mm", "btn_quit" }) do
        pause.kids[#pause.kids + 1] = { name = name, parent = pause }
    end

    local xml = { insertions = 0, menu = menu, pause = pause }
    function xml:query(selector)
        if selector == "menu_main btn[name=btn_gamma_arena]" then
            for _, child in ipairs(self.menu.kids) do
                if child.name == "btn_gamma_arena" then return { child } end
            end
            return {}
        end
        if selector == "menu_main" then return { self.menu } end
        if selector == "menu_main > btn[name=btn_newgame]" then
            for _, child in ipairs(self.menu.kids) do
                if child.name == "btn_newgame" then
                    if options.parent_mismatch then
                        return { { name = child.name, parent = { kids = { child } } } }
                    end
                    return { child }
                end
            end
            return {}
        end
        if selector == "menu_main_single btn[name=btn_gamma_arena_restart]" then
            for _, child in ipairs(self.pause.kids) do
                if child.name == "btn_gamma_arena_restart" then return { child } end
            end
            return {}
        end
        if selector == "menu_main_single" then return { self.pause } end
        if selector == "menu_main_single > btn[name=btn_ret]" then
            for _, child in ipairs(self.pause.kids) do
                if child.name == "btn_ret" then return { child } end
            end
            return {}
        end
        return {}
    end
    if not options.without_position_api then
        function xml:getElementPosition(element)
            if options.invalid_position then return 0 end
            for index, child in ipairs(element.parent.kids) do
                if child == element then return index end
            end
        end
    end
    function xml:insertFromXMLString(value, parent, position)
        local name = string.find(value, "btn_gamma_arena_restart", 1, true) and "btn_gamma_arena_restart" or "btn_gamma_arena"
        table.insert(parent.kids, position, { name = name, parent = parent })
        self.insertions = self.insertions + 1
    end
    return xml
end

local function dxml_accepts_canonical_callback_path()
    local canonical = dxml_fixture()
    gamma_arena_test_assert.is_true(modxml_gamma_arena.apply("ui\\ui_mm_main.xml", canonical).ok, "canonical DXML callback path is accepted")
    gamma_arena_test_assert.equals(canonical.insertions, 2, "canonical callback inserts both Arena entries once")

    local normalized = dxml_fixture()
    gamma_arena_test_assert.is_true(modxml_gamma_arena.apply("UI/UI_MM_MAIN.XML", normalized).ok, "case and slash normalization is accepted")
    gamma_arena_test_assert.equals(normalized.insertions, 2, "normalized canonical callback inserts both Arena entries once")

    local gamma_widescreen = dxml_fixture()
    gamma_arena_test_assert.is_true(modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", gamma_widescreen).ok, "effective GAMMA 16:9 DXML callback path is accepted")
    gamma_arena_test_assert.equals(gamma_widescreen.insertions, 2, "effective GAMMA 16:9 callback inserts both Arena entries once")

    local unrelated = dxml_fixture()
    gamma_arena_test_assert.is_true(modxml_gamma_arena.apply("other/ui_mm_main.xml", unrelated).ok, "unrelated DXML callback is ignored without error")
    gamma_arena_test_assert.equals(unrelated.insertions, 0, "same basename outside ui is rejected")
    gamma_arena_test_assert.equals(modxml_gamma_arena.apply("ui_mm_main.xml", unrelated).value, false, "bare basename alias is rejected")

    local unrelated_widescreen = dxml_fixture()
    gamma_arena_test_assert.is_true(modxml_gamma_arena.apply("other/ui_mm_main_16.xml", unrelated_widescreen).ok, "unrelated 16:9 DXML callback is ignored without error")
    gamma_arena_test_assert.equals(unrelated_widescreen.insertions, 0, "16:9 basename outside ui is rejected")
    gamma_arena_test_assert.equals(modxml_gamma_arena.apply("ui_mm_main_16.xml", unrelated_widescreen).value, false, "bare 16:9 basename alias is rejected")
end

local function dxml_registers_both_arena_menu_clicks()
    local callbacks = {}
    local result = modxml_gamma_arena.register(function(name, callback)
        callbacks[name] = callback
    end)
    gamma_arena_test_assert.is_true(result.ok, "early DXML registration succeeds")
    gamma_arena_test_assert.is_true(type(callbacks.on_xml_read) == "function", "XML callback is registered early")
    gamma_arena_test_assert.is_true(type(callbacks.main_menu_on_init) == "function", "first main-menu callback is registered early")

    local bound = {}
    local menu = {}
    function menu:AddCallback(name, event, callback, owner)
        bound[name] = { event = event, callback = callback, owner = owner }
    end
    callbacks.main_menu_on_init(menu)
    gamma_arena_test_assert.is_true(type(bound.btn_gamma_arena.callback) == "function", "first main menu binds Arena click")
    gamma_arena_test_assert.is_true(type(bound.btn_gamma_arena_restart.callback) == "function", "first in-game menu binds Arena restart click")
    gamma_arena_test_assert.equals(bound.btn_gamma_arena.owner, menu, "Arena click retains the menu owner")
    gamma_arena_test_assert.equals(bound.btn_gamma_arena_restart.owner, menu, "Arena restart retains the menu owner")
end

local function main_menu_restart_is_acceptance_gated()
    local function menu_fixture()
        local menu = { returned = 0 }
        function menu:OnButton_return_game() self.returned = self.returned + 1 end
        return menu
    end

    local accepted_menu = menu_fixture()
    local accepted = gamma_arena_main_menu.request_restart(accepted_menu, {
        request_restart = function() return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_true(accepted.ok and accepted.value == true, "accepted restart closes the pause menu")
    gamma_arena_test_assert.equals(accepted_menu.returned, 1, "accepted restart resumes frame updates")

    local inert_menu = menu_fixture()
    local inert = gamma_arena_main_menu.request_restart(inert_menu, {
        request_restart = function() return gamma_arena_result.ok(false) end
    })
    gamma_arena_test_assert.is_true(inert.ok and inert.value == false, "inactive Arena restart is inert")
    gamma_arena_test_assert.equals(inert_menu.returned, 0, "inactive Arena leaves the pause menu open")

    for _, callback in ipairs({
        function() return gamma_arena_result.err("GA_TEST_RESTART", "injected restart failure") end,
        function() return nil end,
        function() error("injected restart exception") end
    }) do
        local failed_menu = menu_fixture()
        local failed = gamma_arena_main_menu.request_restart(failed_menu, { request_restart = callback })
        gamma_arena_test_assert.is_false(failed.ok, "restart dependency failure remains structured")
        gamma_arena_test_assert.equals(failed_menu.returned, 0, "failed restart leaves the pause menu open")
    end

    local close_failed = gamma_arena_main_menu.request_restart({}, {
        request_restart = function() return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_false(close_failed.ok, "missing stock return action fails closed")
    gamma_arena_test_assert.equals(close_failed.error.code, "GA_ARENA_RESTART_MENU_CLOSE_FAILED", "menu close failure code is stable")
end

local function dxml_registration_failures_are_structured()
    local unavailable = modxml_gamma_arena.register(nil)
    gamma_arena_test_assert.is_false(unavailable.ok, "missing registrar is rejected")
    gamma_arena_test_assert.equals(unavailable.error.code, "GA_DXML_REGISTRAR_UNAVAILABLE", "missing registrar uses exact error code")

    local throwing = modxml_gamma_arena.register(function()
        error("injected registration failure")
    end)
    gamma_arena_test_assert.is_false(throwing.ok, "throwing registrar is contained")
    gamma_arena_test_assert.equals(throwing.error.code, "GA_DXML_REGISTER_FAILED", "throwing registrar uses exact error code")
end

local function dxml_places_arena_after_new_game()
    local ordered = dxml_fixture()
    local inserted = modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", ordered)
    gamma_arena_test_assert.is_true(inserted.ok and inserted.value == true, "Arena is inserted into the effective GAMMA menu")
    gamma_arena_test_assert.equals(ordered.menu.kids[1].name, "btn_newgame", "New Game remains first")
    gamma_arena_test_assert.equals(ordered.menu.kids[2].name, "btn_gamma_arena", "Arena is directly below New Game")
    gamma_arena_test_assert.equals(ordered.menu.kids[3].name, "btn_load", "former second item follows Arena")

    local duplicate = modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", ordered)
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "second DXML pass is a no-op")
    gamma_arena_test_assert.equals(ordered.insertions, 2, "both Arena entries are inserted exactly once")
    gamma_arena_test_assert.equals(#ordered.menu.kids, 8, "duplicate pass does not grow the menu")
end

local function dxml_places_restart_after_return()
    local ordered = dxml_fixture()
    local inserted = modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", ordered)
    gamma_arena_test_assert.is_true(inserted.ok and inserted.value == true, "in-game Arena restart is inserted")
    gamma_arena_test_assert.equals(ordered.pause.kids[1].name, "btn_ret", "Return to Game remains first")
    gamma_arena_test_assert.equals(ordered.pause.kids[2].name, "btn_gamma_arena_restart", "Restart Arena is directly below Return to Game")
    gamma_arena_test_assert.equals(ordered.pause.kids[3].name, "btn_lastsave", "former second in-game item follows Restart Arena")

    local duplicate = modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", ordered)
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "second restart DXML pass is a no-op")
    gamma_arena_test_assert.equals(ordered.insertions, 2, "duplicate pass inserts neither Arena entry twice")
    gamma_arena_test_assert.equals(#ordered.pause.kids, 9, "duplicate pass does not grow the in-game menu")
end

local function dxml_placement_failures_are_structured()
    local missing_new_game = dxml_fixture({ without_new_game = true })
    local missing = modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", missing_new_game)
