    gamma_arena_test_assert.equals(missing_new_game.insertions, 0, "missing New Game does not mutate the menu")

    local missing_api = dxml_fixture({ without_position_api = true })
    local unavailable = modxml_gamma_arena.apply("ui\\ui_mm_main_16.xml", missing_api)
    gamma_arena_test_assert.is_false(unavailable.ok, "missing position API fails closed")
