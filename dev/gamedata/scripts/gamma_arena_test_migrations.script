local function copy_table(source)
    local result = {}
    for key, value in pairs(source or {}) do
        result[key] = value
    end
    return result
end

local function fake_config(initial, shared_backend)
    local config = {
        data = shared_backend or copy_table(initial),
        writes = {},
        removals = {},
        save_count = 0,
        stale_cache = copy_table(initial),
        mutation_index = 0,
        fault_at = nil,
        fault_used = false
    }

    function config:arm_fault(position)
        self.mutation_index = 0
        self.fault_at = position
        self.fault_used = false
    end

    function config:clear_fault()
        self.fault_at = nil
        self.fault_used = false
        self.mutation_index = 0
    end

    function config:maybe_fail(operation)
        self.mutation_index = self.mutation_index + 1
        if not self.fault_used and self.fault_at == self.mutation_index then
            self.fault_used = true
            error("injected " .. operation .. " failure at " .. tostring(self.mutation_index))
        end
    end

    function config:r_string_ex(section, key)
        if section ~= "gamma_arena" and section ~= "character_creation" then
            return nil
        end
        return self.data[key]
    end

    function config:r_value(section, key, _, default)
        local value = self.stale_cache[key]
        if value == nil then
            return default
        end
        return value
    end

    function config:line_exist(section, key)
        return self.data[key] ~= nil
    end

    function config:w_value(section, key, value)
        self:maybe_fail("write")
        gamma_arena_test_assert.is_true(value ~= nil, "tests forbid nil w_value")
        self.data[key] = tostring(value)
        self.stale_cache[key] = tostring(value)
        self.writes[#self.writes + 1] = section .. "." .. key .. "=" .. tostring(value)
    end

    function config:remove_line(section, key)
        self:maybe_fail("remove")
        self.data[key] = nil
        self.removals[#self.removals + 1] = section .. "." .. key
    end

    function config:save()
        self:maybe_fail("save")
        self.save_count = self.save_count + 1
    end

    return config
end

local function valid_session(fight_index)
    return {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        mode_id = "skirmish",
        difficulty_id = "stalker",
        session_seed = 42,
        fight_index = fight_index or 3,
        generator_version = 1,
        catalog_revision = 1,
        layout_id = "rostok_arena_v1",
        checkpoint_name = "_gamma_arena_checkpoint",
        phase = "CHECKPOINT_READY"
    }
end

local function assert_keys_absent(config, keys, message)
    for _, key in ipairs(keys) do
        gamma_arena_test_assert.equals(config.data[key], nil, message .. ": " .. key)
    end
end

local launch_keys = { "launch_pending", "launch_token", "launch_mode_id", "launch_difficulty_id", "launch_seed_mode", "launch_session_seed" }
local resume_keys = { "resume_pending", "resume_session_id", "resume_session_nonce", "resume_next_fight_index", "resume_checkpoint_name", "resume_schema_version" }

local function valid_request(seed)
    return {
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = "stalker",
        seed_mode = "manual",
        session_seed = seed or 42
    }
end

local function migrations_cover_absent_v0_v1_and_future()
    local absent = fake_config()
    local absent_result = gamma_arena_migrations.migrate(absent)
    gamma_arena_test_assert.is_true(absent_result.ok, "absent settings migrate")
    gamma_arena_test_assert.equals(absent.data.settings_schema_version, "1", "absent schema becomes v1")
    gamma_arena_test_assert.equals(absent.save_count, 1, "migration saves exactly once")
    gamma_arena_test_assert.is_true(#absent_result.value.events > 0, "migration reports events")

    local v0 = fake_config({ last_difficulty_id = "veteran", last_seed_mode = "manual" })
    local v0_result = gamma_arena_migrations.migrate(v0)
    gamma_arena_test_assert.is_true(v0_result.ok, "v0 settings migrate")
    gamma_arena_test_assert.equals(v0.data.last_difficulty_id, "veteran", "v0 difficulty preserved")
    gamma_arena_test_assert.equals(v0.data.last_seed_mode, "manual", "v0 seed mode preserved")

    local v1 = fake_config({ settings_schema_version = "1", last_difficulty_id = "master", last_seed_mode = "random" })
    local v1_result = gamma_arena_migrations.migrate(v1)
    gamma_arena_test_assert.is_true(v1_result.ok, "v1 migration is idempotent")
    gamma_arena_test_assert.equals(v1.save_count, 0, "idempotent v1 does not save")

    local future = fake_config({ settings_schema_version = "2" })
    local future_result = gamma_arena_migrations.migrate(future)
    gamma_arena_test_assert.is_false(future_result.ok, "future settings reject")
    gamma_arena_test_assert.equals(future_result.error.code, "GA_SETTINGS_SCHEMA_NEWER", "future schema code")
    gamma_arena_test_assert.equals(future.save_count, 0, "future settings remain untouched")
end

local function request_validation_is_total_and_fail_closed()
    for _, text in ipairs({ "", "-1", "+1", "1.0", "1e3", "4294967296", " 1", "1 " }) do
        local result = gamma_arena_session_store.parse_manual_seed(text)
        gamma_arena_test_assert.is_false(result.ok, "invalid decimal seed rejects: " .. text)
    end
    gamma_arena_test_assert.equals(gamma_arena_session_store.parse_manual_seed("0").value, 0, "zero seed")
    gamma_arena_test_assert.equals(gamma_arena_session_store.parse_manual_seed("4294967295").value, 4294967295, "maximum seed")

    for _, seed in ipairs({ math.huge, -math.huge, 0/0, -1, 4294967296, 1.5 }) do
        local result = gamma_arena_session_store.validate_start_request(valid_request(seed))
        gamma_arena_test_assert.is_false(result.ok, "invalid numeric seed rejects")
    end
    gamma_arena_test_assert.equals(gamma_arena_session_store.validate_start_request(nil).error.code, "GA_START_REQUEST_INVALID", "nil request is Result error")
    gamma_arena_test_assert.equals(gamma_arena_session_store.validate_start_request({}).error.code, "GA_START_REQUEST_SCHEMA_INVALID", "missing schema is Result error")
end

local function random_seed_uses_injected_generator()
    local first = gamma_arena_session_store.random_session_seed(function() return 123456789 end)
    local second = gamma_arena_session_store.random_session_seed(function() return 123456789 end)
    gamma_arena_test_assert.is_true(first.ok and second.ok, "injected random generation succeeds")
    gamma_arena_test_assert.equals(first.value, second.value, "injected random generation is deterministic")
    gamma_arena_test_assert.equals(first.value, 123456789, "injected seed retained")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.random_session_seed(function() return math.huge end).ok, "invalid injected random rejects")
end

local function durable_preferences_are_exact()
    local config = fake_config({ unrelated = "keep" })
    local result = gamma_arena_session_store.save_preferences(config, "master", "manual")
    gamma_arena_test_assert.is_true(result.ok, "preferences save")
    gamma_arena_test_assert.equals(config.save_count, 1, "preferences transaction saves once")
    gamma_arena_test_assert.equals(#config.writes, 3, "only three durable keys written")
    gamma_arena_test_assert.equals(config.data.unrelated, "keep", "unrelated config preserved")
    gamma_arena_test_assert.equals(config.data.launch_pending, nil, "launch is not durable preference")
end

local function launch_token_is_volatile_ttl_bound_and_one_shot()
    local config = fake_config()
    local issued = gamma_arena_session_store.issue_launch(config, valid_request(99), {
        clock = function() return 1000 end,
        nonce = function() return "nonce_1" end
    })
    gamma_arena_test_assert.is_true(issued.ok, "launch intent issued")
    gamma_arena_test_assert.equals(issued.value.token, "ga1:1000:nonce_1", "launch token grammar")
    gamma_arena_test_assert.equals(config.save_count, 1, "launch write saves once")

    local parsed = gamma_arena_session_store.parse_launch_token(issued.value.token, 1600)
    gamma_arena_test_assert.is_true(parsed.ok, "token valid at TTL boundary")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.parse_launch_token(issued.value.token, 1601).ok, "expired token rejects")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.parse_launch_token("ga1:bad:nonce", 1000).ok, "malformed token rejects")

    local consumed = gamma_arena_session_store.consume_launch(config, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_true(consumed.ok, "fresh volatile launch consumes")
    gamma_arena_test_assert.equals(consumed.value.session_seed, 99, "consumed request restored")
    gamma_arena_test_assert.equals(config.save_count, 2, "launch consume saves once")
    gamma_arena_test_assert.equals(config.data.launch_pending, nil, "launch keys removed")

    local repeated = gamma_arena_session_store.consume_launch(config, { clock = function() return 1002 end })
    gamma_arena_test_assert.is_false(repeated.ok, "stale-cache repeated consume rejects")
    gamma_arena_test_assert.equals(repeated.error.code, "GA_LAUNCH_NOT_PENDING", "repeated consume code")

    local stale = fake_config({
        launch_pending = "true", launch_token = "ga1:1000:prior_process", launch_mode_id = "skirmish",
        launch_difficulty_id = "stalker", launch_seed_mode = "manual", launch_session_seed = "99"
    })
    local stale_result = gamma_arena_session_store.consume_launch(stale, { clock = function() return 1001 end })
    gamma_arena_test_assert.is_false(stale_result.ok, "persisted prior-process token rejects")
    gamma_arena_test_assert.equals(stale_result.error.code, "GA_LAUNCH_TOKEN_NOT_VOLATILE", "volatile permit code")
end

local function stale_launch_is_recovered_by_new_store()
    local backend = {}
    local process_a_config = fake_config(nil, backend)
    local process_b_config = fake_config(nil, backend)
    local process_a = gamma_arena_session_store.new_store()
    local process_b = gamma_arena_session_store.new_store()
    local first = process_a:issue_launch(process_a_config, valid_request(11), {
        clock = function() return 1000 end,
        nonce = function() return "process_a" end
    })
    gamma_arena_test_assert.is_true(first.ok, "process A launch issued")
    local duplicate = process_a:issue_launch(process_a_config, valid_request(12), {
        clock = function() return 1001 end,
        nonce = function() return "duplicate" end
    })
    gamma_arena_test_assert.equals(duplicate.error.code, "GA_LAUNCH_ALREADY_PENDING", "same-store duplicate rejects")

    local recovered = process_b:issue_launch(process_b_config, valid_request(22), {
        clock = function() return 1001 end,
        nonce = function() return "process_b" end
    })
    gamma_arena_test_assert.is_true(recovered.ok, "new process clears orphan and issues fresh launch")
    gamma_arena_test_assert.equals(recovered.value.request.session_seed, 22, "fresh request replaces orphan")
    gamma_arena_test_assert.equals(recovered.value.events[1].code, "GA_LAUNCH_STALE_CLEARED", "orphan cleanup is reported")

    for _, stale_token in ipairs({ "ga1:1:expired", "malformed" }) do
        local stale_backend = {
            launch_pending = "true", launch_token = stale_token, launch_mode_id = "skirmish",
            launch_difficulty_id = "stalker", launch_seed_mode = "manual", launch_session_seed = "7"
        }
        local stale_config = fake_config(nil, stale_backend)
        local store = gamma_arena_session_store.new_store()
        local fresh = store:issue_launch(stale_config, valid_request(33), {
            clock = function() return 1000 end,
            nonce = function() return "fresh" end
        })
        gamma_arena_test_assert.is_true(fresh.ok, "expired/malformed launch is replaced")
        gamma_arena_test_assert.equals(fresh.value.events[1].code, "GA_LAUNCH_STALE_CLEARED", "stale replacement event")
        gamma_arena_test_assert.equals(stale_backend.launch_session_seed, "33", "fresh payload is complete")
    end

    for _, stale_backend in ipairs({
        { launch_pending = "maybe" },
        { launch_difficulty_id = "stalker" }
    }) do
        local store = gamma_arena_session_store.new_store()
        local fresh = store:issue_launch(fake_config(nil, stale_backend), valid_request(44), {
            clock = function() return 1000 end,
            nonce = function() return "missing_token" end
        })
        gamma_arena_test_assert.is_true(fresh.ok, "marker/payload without a token is replaced")
        gamma_arena_test_assert.equals(fresh.value.events[1].code, "GA_LAUNCH_STALE_CLEARED", "tokenless stale replacement event")
    end
end

local function resume_intent_requires_matching_nonce_and_is_one_shot()
    local config = fake_config()
    local intent = {
        schema_version = 1,
        session_id = "session-1",
        session_nonce = "session_nonce_1",
        next_fight_index = 3,
        checkpoint_name = "_gamma_arena_checkpoint"
    }
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(config, intent).ok, "resume intent issued")
    local wrong_nonce = valid_session(3)
    wrong_nonce.session_nonce = "wrong"
    local mismatch = gamma_arena_session_store.consume_resume(config, wrong_nonce)
    gamma_arena_test_assert.is_false(mismatch.ok, "resume nonce mismatch rejects")
    gamma_arena_test_assert.equals(mismatch.error.code, "GA_RESUME_NONCE_MISMATCH", "resume mismatch code")

    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(config, intent).ok, "resume can be reissued")
    local consumed = gamma_arena_session_store.consume_resume(config, valid_session(3))
    gamma_arena_test_assert.is_true(consumed.ok, "matching resume consumes")
    gamma_arena_test_assert.equals(consumed.value.checkpoint_name, "_gamma_arena_checkpoint", "checkpoint retained")
    gamma_arena_test_assert.equals(gamma_arena_session_store.consume_resume(config, valid_session(3)).error.code, "GA_RESUME_NOT_PENDING", "resume is one-shot")

    local already_pending = fake_config()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(already_pending, intent).ok, "first resume issuance succeeds")
    local duplicate = gamma_arena_session_store.issue_resume(already_pending, intent)
    gamma_arena_test_assert.is_false(duplicate.ok, "existing resume cannot be overwritten")
    gamma_arena_test_assert.equals(duplicate.error.code, "GA_RESUME_ALREADY_PENDING", "duplicate resume code")

    local conflict = fake_config()
    gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(conflict, intent).ok, "resume for conflict fixture issued")
    conflict.data.launch_pending = "true"
    local conflicted = gamma_arena_session_store.consume_resume(conflict, valid_session(3))
    gamma_arena_test_assert.is_false(conflicted.ok, "simultaneous launch and resume reject")
    gamma_arena_test_assert.equals(conflicted.error.code, "GA_INTENT_CONFLICT", "resume conflict code")
    gamma_arena_test_assert.equals(conflict.data.resume_pending, nil, "conflicted resume is cleared")

    local tokenless_conflict = fake_config({ launch_pending = "true", resume_pending = "true" })
    local launch_conflict = gamma_arena_session_store.consume_launch(tokenless_conflict, { clock = function() return 1000 end })
    gamma_arena_test_assert.equals(launch_conflict.error.code, "GA_INTENT_CONFLICT", "tokenless launch/resume conflict is structured")
    assert_keys_absent(tokenless_conflict, launch_keys, "tokenless conflict clears launch")
    assert_keys_absent(tokenless_conflict, resume_keys, "tokenless conflict clears resume")

    local malformed = fake_config({ resume_pending = "maybe" })
    local malformed_result = gamma_arena_session_store.consume_resume(malformed, valid_session(3))
    gamma_arena_test_assert.is_false(malformed_result.ok, "malformed resume marker rejects")
    gamma_arena_test_assert.equals(malformed_result.error.code, "GA_RESUME_PENDING_INVALID", "malformed resume code")
    gamma_arena_test_assert.equals(malformed.data.resume_pending, nil, "malformed resume marker is cleared")
end

local function resume_rejects_tampered_expected_session()
    local intent = {
        schema_version = 1, session_id = "session-1", session_nonce = "session_nonce_1",
        next_fight_index = 3, checkpoint_name = "_gamma_arena_checkpoint"
    }
    for _, mutation in ipairs({
        function(session) session.checkpoint_name = "_gamma_arena_other" end,
        function(session) session.schema_version = 2 end,
        function(session) session.generator_version = 2 end,
        function(session) session.catalog_revision = 2 end,
        function(session) session.fight_index = 4 end,
        function(session) session.mode_id = "unknown" end
    }) do
        local config = fake_config()
        gamma_arena_test_assert.is_true(gamma_arena_session_store.issue_resume(config, intent).ok, "tamper fixture issued")
        local session = valid_session(3)
        mutation(session)
        local rejected = gamma_arena_session_store.consume_resume(config, session)
        gamma_arena_test_assert.is_false(rejected.ok, "tampered expected session rejects")
        assert_keys_absent(config, resume_keys, "tampered resume clears once")
        gamma_arena_test_assert.equals(gamma_arena_session_store.consume_resume(config, valid_session(3)).error.code, "GA_RESUME_NOT_PENDING", "tampered resume cannot replay")
    end

    local bad_checkpoint_intent = copy_table(intent)
    bad_checkpoint_intent.checkpoint_name = "_gamma_arena_other"
    gamma_arena_test_assert.equals(gamma_arena_session_store.issue_resume(fake_config(), bad_checkpoint_intent).error.code, "GA_RESUME_CHECKPOINT_INVALID", "resume intent checkpoint is reserved")
    gamma_arena_test_assert.is_false(gamma_arena_session_store.consume_resume(fake_config({ resume_pending = "true" }), nil).ok, "nil expected session returns Result")
end

local function assert_table_equals(actual, expected, keys, message)
    for _, key in ipairs(keys) do
        gamma_arena_test_assert.equals(actual[key], expected[key], message .. ": " .. key)
    end
end

local function mutation_failure_matrix_is_crash_safe()
    for fault_at = 1, 4 do
        local config = fake_config({ unrelated = "keep" })
        config:arm_fault(fault_at)
        local failed = gamma_arena_migrations.migrate(config)
        gamma_arena_test_assert.is_false(failed.ok, "migration injected fault " .. fault_at)
        gamma_arena_test_assert.equals(config.data.settings_schema_version, nil, "migration marker rolled back")
        gamma_arena_test_assert.equals(config.data.last_difficulty_id, nil, "migration difficulty rolled back")
        gamma_arena_test_assert.equals(config.data.last_seed_mode, nil, "migration seed mode rolled back")
        config:clear_fault()
        gamma_arena_test_assert.is_true(gamma_arena_migrations.migrate(config).ok, "migration retry succeeds")
    end

    for fault_at = 1, 4 do
        local baseline = { settings_schema_version = "1", last_difficulty_id = "rookie", last_seed_mode = "random" }
        local config = fake_config(baseline)
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(gamma_arena_session_store.save_preferences(config, "master", "manual").ok, "preferences injected fault")
        assert_table_equals(config.data, baseline, { "settings_schema_version", "last_difficulty_id", "last_seed_mode" }, "preferences rollback")
        config:clear_fault()
        gamma_arena_test_assert.is_true(gamma_arena_session_store.save_preferences(config, "master", "manual").ok, "preferences retry succeeds")
    end

    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        config:arm_fault(fault_at)
        local failed = store:issue_launch(config, valid_request(9), { clock = function() return 100 end, nonce = function() return "fault" end })
        gamma_arena_test_assert.is_false(failed.ok, "launch issue injected fault")
        assert_keys_absent(config, launch_keys, "failed launch issue leaves no torn intent")
        config:clear_fault()
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(9), { clock = function() return 101 end, nonce = function() return "retry" end }).ok, "launch issue retry succeeds")
    end

    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(9), { clock = function() return 100 end, nonce = function() return "consume" end }).ok, "launch consume fixture issued")
        config:arm_fault(fault_at)
        local failed = store:consume_launch(config, { clock = function() return 101 end })
        gamma_arena_test_assert.is_false(failed.ok, "launch consume injected fault")
        assert_keys_absent(config, launch_keys, "failed launch consume is fail-closed")
        config:clear_fault()
        gamma_arena_test_assert.equals(store:consume_launch(config, { clock = function() return 102 end }).error.code, "GA_LAUNCH_NOT_PENDING", "failed consume cannot replay")
        gamma_arena_test_assert.is_true(store:issue_launch(config, valid_request(10), { clock = function() return 103 end, nonce = function() return "after" end }).ok, "new launch succeeds after failed consume")
    end

    local intent = { schema_version = 1, session_id = "session-1", session_nonce = "session_nonce_1", next_fight_index = 3, checkpoint_name = "_gamma_arena_checkpoint" }
    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(store:issue_resume(config, intent).ok, "resume issue injected fault")
        assert_keys_absent(config, resume_keys, "failed resume issue leaves no torn intent")
        config:clear_fault()
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "resume issue retry succeeds")
    end

    for fault_at = 1, 7 do
        local config = fake_config()
        local store = gamma_arena_session_store.new_store()
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "resume consume fixture issued")
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(store:consume_resume(config, valid_session(3)).ok, "resume consume injected fault")
        assert_keys_absent(config, resume_keys, "failed resume consume is fail-closed")
        config:clear_fault()
        gamma_arena_test_assert.equals(store:consume_resume(config, valid_session(3)).error.code, "GA_RESUME_NOT_PENDING", "failed resume consume cannot replay")
        gamma_arena_test_assert.is_true(store:issue_resume(config, intent).ok, "new resume succeeds after failed consume")
    end

    local character_keys = { "new_game_difficulty", "new_game_economy", "new_game_character_name", "new_game_faction", "new_game_map", "new_game_money", "new_game_loadout", "new_game_story_mode" }
    for fault_at = 1, 9 do
        local baseline = { new_game_difficulty = "4", new_game_loadout = "old", new_game_story_mode = "true" }
        local config = fake_config(baseline)
        config:arm_fault(fault_at)
        gamma_arena_test_assert.is_false(gamma_arena_session_store.write_character_creation(config).ok, "character bridge injected fault")
        assert_table_equals(config.data, baseline, character_keys, "character bridge rollback")
        config:clear_fault()
        gamma_arena_test_assert.is_true(gamma_arena_session_store.write_character_creation(config).ok, "character bridge retry succeeds")
    end
end

local function character_creation_bridge_is_exact()
    local config = fake_config({ new_game_loadout = "old", new_game_story_mode = "true" })
    local result = gamma_arena_session_store.write_character_creation(config)
    gamma_arena_test_assert.is_true(result.ok, "character creation bridge writes")
    gamma_arena_test_assert.equals(config.save_count, 1, "character bridge saves once")
    gamma_arena_test_assert.equals(#config.writes, 6, "six fixed bridge keys")
    gamma_arena_test_assert.equals(#config.removals, 2, "optional bridge keys removed")
    gamma_arena_test_assert.equals(config.data.new_game_loadout, nil, "loadout removed")
    gamma_arena_test_assert.equals(config.data.new_game_story_mode, nil, "story mode removed")
end

local cases = {
    { name = "settings_migrations", fn = migrations_cover_absent_v0_v1_and_future },
    { name = "start_request_validation", fn = request_validation_is_total_and_fail_closed },
    { name = "random_seed_injection", fn = random_seed_uses_injected_generator },
    { name = "durable_preferences", fn = durable_preferences_are_exact },
    { name = "launch_token_one_shot", fn = launch_token_is_volatile_ttl_bound_and_one_shot },
    { name = "stale_launch_recovery", fn = stale_launch_is_recovered_by_new_store },
    { name = "resume_intent_one_shot", fn = resume_intent_requires_matching_nonce_and_is_one_shot },
    { name = "resume_expected_session_validation", fn = resume_rejects_tampered_expected_session },
    { name = "mutation_failure_matrix", fn = mutation_failure_matrix_is_crash_safe },
    { name = "character_creation_bridge", fn = character_creation_bridge_is_exact }
}

function run(run_case_fn)
    local all_passed = true
    for index = 1, #cases do
        if not run_case_fn(cases[index].name, cases[index].fn) then
            all_passed = false
        end
    end
    return all_passed
end
