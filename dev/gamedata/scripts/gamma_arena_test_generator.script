function run(run_case_fn)
    local all_passed = true
    for _, case in ipairs({{name="catalog_enforces_max_count_viability",fn=catalog_enforces_max_count_viability},{name="catalog_rejects_malformed_data",fn=catalog_rejects_malformed_data},{name="validator_never_throws_for_malformed_specs",fn=validator_never_throws_for_malformed_specs},{name="validator_rejects_unknown_spawn_path",fn=validator_rejects_unknown_spawn_path},{name="validator_rejects_duplicate_spawn_path",fn=validator_rejects_duplicate_spawn_path},{name="validator_rejects_redistributed_slot_budget",fn=validator_rejects_redistributed_slot_budget},{name="generator_10000_seeds",fn=generator_10000_seeds},{name="stable_encode_v1",fn=stable_and_fight_index},{name="finite_integer_guards",fn=finite_integer_guards},{name="golden_fights_v1",fn=golden_fights_v1}}) do if not run_case_fn(case.name,case.fn) then all_passed=false end end
    return all_passed
end
