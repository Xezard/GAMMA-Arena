local function dense_array_length(values)
    if type(values) ~= "table" then return nil end
    local count, maximum = 0, 0
    for key in pairs(values) do
        if not gamma_arena_number.is_positive_integer(key) then return nil end
        count = count + 1
        maximum = math.max(maximum, key)
    end
    return count == maximum and count or nil
end

local function grenade_loadouts_are_deterministic_uncosted_and_prefix_stable()
    local snapshot = catalogs()
    local pool = { grenade_f1=true, grenade_rgd5=true, ["grenade_gd-05"]=true }
    for seed = 0,511 do
        local session,fight_index=request(seed,"master"),seed%32
        local first=generate_fixture(session,fight_index,snapshot)
        local second=generate_fixture(session,fight_index,snapshot)
        gamma_arena_test_assert.is_true(first.ok and second.ok,"grenade seed sweep generates")
        gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first.value),gamma_arena_generator.stable_encode(second.value),"grenades reproduce deterministically")
        gamma_arena_test_assert.is_true(category_count(first.value.actor,snapshot,"grenade")<=2,"actor receives at most two grenades")
        for _, participant in ipairs({first.value.actor,unpack(first.value.opponents)}) do
            for _, item in ipairs(participant.items) do
                if snapshot.items[item.section].category=="grenade" then gamma_arena_test_assert.is_true(pool[item.section],"grenades exclude smoke") end
            end
        end
        for _, opponent in ipairs(first.value.opponents) do gamma_arena_test_assert.is_true(category_count(opponent,snapshot,"grenade")<=1,"opponent receives at most one grenade") end
        assert_actor_budget(session,fight_index,snapshot,first.value)
        gamma_arena_test_assert.is_true(validate_fixture(first.value,snapshot).ok,"grenade physical items validate")
    end
    local session,fight_index=request(9137,"master"),11
    local function section_for(slot)
        local function tagged(tag)
            return gamma_arena_rng.new(gamma_arena_rng.derive_seed({session.mode_id,session.difficulty_id,session.session_seed,fight_index,6,2,tag}))
        end
        return gamma_arena_grenade_generator.generate_enemy(snapshot,{
            presence=tagged("enemy_grenade_presence:"..slot),section=tagged("enemy_grenade_section:"..slot)
        }).value.sections[1] or ""
    end
    local short,extended={},{}
    for slot=1,3 do short[slot]=section_for(slot) end
    for slot=1,10 do extended[slot]=section_for(slot) end
    for slot=1,3 do gamma_arena_test_assert.equals(short[slot],extended[slot],"indexed grenade draws retain prefix stability") end
    local validated=validate_fixture(generate_fixture(request(701,"master"),9,snapshot).value,snapshot)
    gamma_arena_test_assert.is_true(validated.ok,"immutable-copy fixture validates")
    local actor=validated.value.actor()
    local actor_count=#actor.items
    actor.items[actor_count+1]={section="grenade_f1",quantity=1}
    gamma_arena_test_assert.equals(#validated.value.actor().items,actor_count,"validated actor items are immutable copies")
    local opponents=validated.value.opponents()
    local opponent_count=#opponents[1].items
    opponents[1].items[opponent_count+1]={section="grenade_f1",quantity=1}
    gamma_arena_test_assert.equals(#validated.value.opponents()[1].items,opponent_count,"validated opponent items are immutable copies")
end

local function validator_rejects_forged_grenade_arrays()
    local snapshot=catalogs()
    local function control(actor)
        for seed=0,512 do
            local generated=generate_fixture(request(seed,"master"),seed%17,snapshot)
            gamma_arena_test_assert.is_true(generated.ok,"grenade forgery control generates")
            local participant=actor and generated.value.actor or generated.value.opponents[1]
            local grenade=selected_item(participant,snapshot,"grenade")
            if grenade then return generated.value,participant,grenade end
        end
        error("grenade forgery requires a reachable grenade")
    end
    for _, actor in ipairs({true,false}) do
        for _, mutation in ipairs({
            {code="GA_FIGHTSPEC_ITEM_UNKNOWN",fn=function(entry) entry.section="grenade_smoke" end},
            {code="GA_FIGHTSPEC_ITEM_INVALID",fn=function(entry) entry.quantity=0 end},
            {code="GA_FIGHTSPEC_ITEM_LIMIT",fn=function(entry) entry.quantity=257 end},
            {code="GA_FIGHTSPEC_INTEGRITY_INVALID",fn=function(entry) entry.quantity=entry.quantity+1 end},
            {code="GA_FIGHTSPEC_INTEGRITY_INVALID",fn=function(entry) entry.section=entry.section=="grenade_f1" and "grenade_rgd5" or "grenade_f1" end}
        }) do
            local spec,participant,grenade=control(actor)
            mutation.fn(grenade)
            local result=validate_fixture(spec,snapshot)
            gamma_arena_test_assert.is_false(result.ok,"forged grenade physical items fail")
            gamma_arena_test_assert.equals(result.error.code,mutation.code,"grenade forgery reaches physical or integrity invariant")
        end
        local spec,participant=control(actor)
        participant.items[1]=nil
        gamma_arena_test_assert.equals(validate_fixture(spec,snapshot).error.code,"GA_FIGHTSPEC_ARRAY_INVALID","sparse physical arrays fail closed")
    end
end

local function universal_v9_random_device_generation()
    local snapshot = catalogs()
    local original = gamma_arena_device_generator.generate
    local calls = 0
    gamma_arena_device_generator.generate = function(...)
        calls = calls + 1
        return original(...)
    end
    local completed, generated = pcall(gamma_arena_fight_builder.generate,
        request(3735928559, "veteran"), 7, snapshot,
        fixture_resolved_layout(snapshot))
    gamma_arena_device_generator.generate = original
    gamma_arena_test_assert.is_true(completed and generated.ok, "v9 random fight generates")
    gamma_arena_test_assert.equals(calls, 1, "builder and validator do not rerun Random device selection")
    gamma_arena_test_assert.equals(generated.value.schema_version, 9, "only v9 emits")
    gamma_arena_test_assert.equals(generated.value.identity.generator_version, 11, "generator identity")
    gamma_arena_test_assert.is_true(string.sub(generated.value.identity.fight_id, 1, 4) == "ga9-", "v9 fight id")
    gamma_arena_test_assert.equals(generated.value.mode_id, nil, "mode is erased")
    gamma_arena_test_assert.is_true(#generated.value.actor.items > 0, "actor uses universal items")
    gamma_arena_test_assert.is_true(#generated.value.opponents[1].items > 0, "opponent uses universal items")
    local function selected_device(spec)
        local count, selected = 0, nil
        for _, entry in ipairs(spec.actor.items) do
            if snapshot.items[entry.section].category == "device" then
                count, selected = count + 1, entry
            end
        end
        gamma_arena_test_assert.equals(count, 1, "Random emits exactly one actor device")
        gamma_arena_test_assert.equals(selected.quantity, 1, "Random device quantity is exactly one")
        gamma_arena_test_assert.equals(selected.equipped_slot, "device", "Random device owns the device slot")
        for _, opponent in ipairs(spec.opponents) do
            for _, entry in ipairs(opponent.items) do
                gamma_arena_test_assert.is_false(snapshot.items[entry.section].category == "device", "opponents never receive devices")
            end
        end
        return selected.section
    end
    local selected = selected_device(generated.value)
    local replay = gamma_arena_fight_builder.generate(
        request(3735928559, "veteran"), 7, snapshot, fixture_resolved_layout(snapshot))
    gamma_arena_test_assert.equals(selected_device(replay.value), selected, "same Random input reproduces its device")
    local isolated = gamma_arena_fight_builder.generate(
        request(3735928559, "rookie"), 7, snapshot, fixture_resolved_layout(snapshot))
    gamma_arena_test_assert.equals(selected_device(isolated.value), selected, "Random device stream is difficulty independent")
    local variants = {}
    for seed = 0, 31 do
        local changed = gamma_arena_fight_builder.generate(
            request(seed, "rookie"), 0, snapshot, fixture_resolved_layout(snapshot))
        variants[selected_device(changed.value)] = true
    end
    local variant_count = 0
    for _ in pairs(variants) do variant_count = variant_count + 1 end
    gamma_arena_test_assert.is_true(variant_count > 1, "changed Random seeds vary the selected device")
end

local function medical_tuning_does_not_reroll_core_fight()
    local baseline,tuned=catalogs(),catalogs()
    tuned.difficulties.master.medical_weights={bleed=0,health=100,boost=0,rare=0}
    local first=generate_fixture(request(9137,"master"),11,baseline)
    local second=generate_fixture(request(9137,"master"),11,tuned)
    gamma_arena_test_assert.is_true(first.ok and second.ok,"medical tuning isolation fixtures generate")
    gamma_arena_test_assert.equals(#first.value.opponents,#second.value.opponents,"medicine cannot reroll opponent count")
    gamma_arena_test_assert.equals(item_signature(first.value.actor,baseline,{medicine=true}),item_signature(second.value.actor,tuned,{medicine=true}),"medicine cannot reroll actor equipment, ammo, bonus, grenades or devices")
    for index,opponent in ipairs(first.value.opponents) do
        local changed=second.value.opponents[index]
        gamma_arena_test_assert.equals(opponent.profile,changed.profile,"medicine cannot reroll profile")
        gamma_arena_test_assert.equals(opponent.spawn_slot_id,changed.spawn_slot_id,"medicine cannot reroll spawn")
        gamma_arena_test_assert.equals(opponent.tactical_route,changed.tactical_route,"medicine cannot reroll route")
        gamma_arena_test_assert.equals(item_signature(opponent,baseline,{medicine=true}),item_signature(changed,tuned,{medicine=true}),"medicine cannot reroll enemy equipment")
    end
end

function run(run_case_fn)
    local all_passed = true
    if not run_case_fn("random_faction_selection_uses_only_nonempty_pools", random_faction_selection_uses_only_nonempty_pools) then all_passed = false end
    if not run_case_fn("random_draft_matches_frozen_semantic_snapshot", random_draft_matches_frozen_semantic_snapshot) then all_passed = false end
    if not run_case_fn("random_numeric_rank_stream_is_isolated", random_numeric_rank_stream_is_isolated) then all_passed = false end
    if not run_case_fn("random_draft_pipeline_canonicalizes_and_strictly_validates", random_draft_pipeline_canonicalizes_and_strictly_validates) then all_passed = false end
    if not run_case_fn("random_builder_skips_items_outside_universal_catalog", random_builder_skips_items_outside_universal_catalog) then all_passed = false end
    if not run_case_fn("random_builder_uses_effective_universal_weapon_slot", random_builder_uses_effective_universal_weapon_slot) then all_passed = false end
    if not run_case_fn("random_builder_rejects_incomplete_device_manifest", random_builder_rejects_incomplete_device_manifest) then all_passed = false end
    if not run_case_fn("random_catalog_diagnostics_identify_missing_physical_pool", random_catalog_diagnostics_identify_missing_physical_pool) then all_passed = false end
    if not run_case_fn("random_draft_malformed_inputs_are_total_results", random_draft_malformed_inputs_are_total_results) then all_passed = false end
    if not run_case_fn("random_draft_nested_malformed_and_throwing_inputs_are_total_results", random_draft_nested_malformed_and_throwing_inputs_are_total_results) then all_passed = false end
    if not run_case_fn("random_draft_malformed_dependency_results_are_normalized", random_draft_malformed_dependency_results_are_normalized) then all_passed = false end
    if not run_case_fn("universal_v9_random_device_generation", universal_v9_random_device_generation) then all_passed = false end
    local cases = {
        { name="catalog_enforces_max_count_viability", fn=catalog_enforces_max_count_viability },
        { name="catalog_exposes_approved_player_weight_rows", fn=catalog_exposes_approved_player_weight_rows },
        { name="catalog_normalizes_weapon_magazine_capacity", fn=catalog_normalizes_weapon_magazine_capacity },
        { name="grenade_catalog_and_probability_boundaries", fn=grenade_catalog_and_probability_boundaries },
        { name="device_catalog_and_probability_boundaries", fn=device_catalog_and_probability_boundaries },
        { name="device_generator_rejects_malformed_arguments", fn=device_generator_rejects_malformed_arguments },
        { name="device_catalog_rejects_effective_mismatch", fn=device_catalog_rejects_effective_mismatch },
        { name="grenade_generator_rejects_malformed_arguments", fn=grenade_generator_rejects_malformed_arguments },
        { name="catalog_exposes_medical_pool_and_budgets", fn=catalog_exposes_medical_pool_and_budgets },
        { name="catalog_skips_optional_missing_medicine", fn=catalog_skips_optional_missing_medicine },
        { name="actor_medical_generation_enforces_budget_and_healer", fn=actor_medical_generation_enforces_budget_and_healer },
        { name="actor_medical_generation_reaches_master_rare", fn=actor_medical_generation_reaches_master_rare },
        { name="enemy_medical_generation_spends_team_budget", fn=enemy_medical_generation_spends_team_budget },
        { name="medical_generation_100000_fights", fn=medical_generation_100000_fights },
        { name="fight_spec_v9_separates_gear_medical_and_grenades", fn=fight_spec_v9_separates_gear_medical_and_grenades },
        { name="grenade_loadouts_are_deterministic_uncosted_and_prefix_stable", fn=grenade_loadouts_are_deterministic_uncosted_and_prefix_stable },
        { name="validator_rejects_forged_grenade_arrays", fn=validator_rejects_forged_grenade_arrays },
        { name="medical_tuning_does_not_reroll_core_fight", fn=medical_tuning_does_not_reroll_core_fight },
        { name="catalog_augments_effective_system_without_cartesian_product", fn=catalog_augments_from_effective_system_without_cartesian_product },
        { name="catalog_enumerates_effective_system_once_per_load", fn=catalog_enumerates_effective_system_once_per_load },
        { name="catalog_enumeration_failure_is_memoized", fn=catalog_enumeration_failure_is_memoized },
        { name="random_draft_accepts_unclassified_bonus_ammo", fn=random_draft_accepts_unclassified_bonus_ammo },
        { name="weapon_quarantine_is_exact_and_global", fn=weapon_quarantine_is_exact_and_global },
        { name="catalog_rejects_malformed_data", fn=catalog_rejects_malformed_data },
        { name="validator_never_throws_for_malformed_specs", fn=validator_never_throws_for_malformed_specs },
        { name="validator_rejects_unknown_spawn_path", fn=validator_rejects_unknown_spawn_path },
        { name="validator_rejects_duplicate_spawn_path", fn=validator_rejects_duplicate_spawn_path },
        { name="validator_rejects_redistributed_slot_budget", fn=validator_rejects_redistributed_slot_budget },
        { name="weighted_player_class_pair_selection", fn=weighted_player_class_pair_selection },
        { name="player_class_pair_ignores_concrete_cardinality", fn=player_class_pair_ignores_concrete_cardinality },
        { name="generator_10000_seeds", fn=generator_10000_seeds },
        { name="master_player_class_diversity", fn=master_player_class_diversity },
        { name="master_powered_exo_rate_is_rare", fn=master_powered_exo_rate_is_rare },
        { name="generator_role_first_balance", fn=generator_role_first_balance },
        { name="generator_primary_pool_affordability_falls_back", fn=generator_primary_pool_affordability_falls_back },
        { name="stable_encode_v9", fn=stable_and_fight_index },
        { name="player_ammo_scaling_policy_is_uncapped_and_prefix_stable", fn=player_ammo_scaling_policy_is_uncapped_and_prefix_stable },
        { name="generated_actor_ammo_is_final_and_outside_budget", fn=generated_actor_ammo_is_final_and_outside_budget },
        { name="player_ammo_scaling_is_stream_isolated", fn=player_ammo_scaling_is_stream_isolated },
        { name="bonus_ammo_category_boundaries_and_fallback", fn=bonus_ammo_category_boundaries_and_fallback },
        { name="actor_bonus_ammo_is_deterministic_and_outside_budget", fn=actor_bonus_ammo_is_deterministic_and_outside_budget },
        { name="bonus_ammo_seed_sweep_and_stream_isolation", fn=bonus_ammo_seed_sweep_and_stream_isolation },
        { name="validator_rejects_invalid_bonus_ammo", fn=validator_rejects_invalid_bonus_ammo },
        { name="validator_rejects_forged_final_actor_ammo", fn=validator_rejects_forged_final_actor_ammo },
        { name="finite_integer_guards", fn=finite_integer_guards },
        { name="golden_fights_v9", fn=golden_fights_v9 }
    }
    if not run_case_fn('device_selector_rejects_forged_exact_catalogs', device_selector_rejects_forged_exact_catalogs) then all_passed = false end
    if not run_case_fn('device_generator_is_mode_free_and_deterministic', device_generator_is_mode_free_and_deterministic) then all_passed = false end
    for _, case in ipairs(cases) do if not run_case_fn(case.name, case.fn) then all_passed = false end end
    return all_passed
end
