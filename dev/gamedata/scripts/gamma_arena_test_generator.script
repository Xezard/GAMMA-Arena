local function section(values) return values end

function fixture_factory(options)
    if type(options) ~= "table" then options = { rookie_enemy_budget = options } end
    local game_sections = { wpn_pm=true, wpn_mp5=true, wpn_ak74u=true, wpn_ak74=true, wpn_wincheaster1300=true, wpn_knife=true, wpn_knife2=true, wpn_knife3=true, wpn_knife4=true, wpn_knife5=true, wpn_knife6=true, wpn_knife7=true, wpn_knife8=true, wpn_knife9=true, ammo_9x18_fmj=true, ammo_9x19_fmj=true, ["ammo_5.45x39_fmj"]=true, ammo_12x70_buck=true, novice_outfit=true, stalker_outfit=true, banditmerc_outfit=true, grenade_f1=true, grenade_rgd5=true, ["grenade_gd-05"]=true, grenade_smoke=true, device_torch_dummy=true, device_torch_nv_1=true, device_torch_nv_2=true, device_torch_nv_3=true, bandage=true, jgut=true, stimpack=true, medkit=true, analgetic=true, drug_booster=true, stimpack_army=true, salicidic_acid=true, cocaine=true, medkit_army=true, stimpack_scientic=true, morphine=true, medkit_scientic=true, adrenalin=true, survival_kit=true, rebirth=true, gamma_arena_bandit_novice=true, gamma_arena_bandit_trainee=true, gamma_arena_bandit_experienced=true, gamma_arena_bandit_veteran=true }
    local system_sections = options.system_sections
    local loadout_sections = options.loadout_sections
    if type(system_sections) == "table" then
        for _, faction in ipairs({ "stalker", "bandit", "csky", "army", "dolg", "freedom", "ecolog", "killer", "monolith" }) do
            for _, rank in ipairs({ "novice", "trainee", "experienced", "veteran" }) do
                game_sections["gamma_arena_" .. faction .. "_" .. rank] = true
            end
        end
    end
    local catalog = { sections = {
        meta=section{schema_version="9",revision="10",generator_version="10"}, profiles=section{ids="novice,trainee,experienced,veteran"},
        profile_novice=section{section="gamma_arena_bandit_novice",cost="1"}, profile_trainee=section{section="gamma_arena_bandit_trainee",cost="2"}, profile_experienced=section{section="gamma_arena_bandit_experienced",cost="3"}, profile_veteran=section{section="gamma_arena_bandit_veteran",cost="4"},
        weapons=section{ids="pm,mp5,ak74u,ak74,wincheaster1300"}, weapon_pm=section{section="wpn_pm",ammo="ammo_9x18_fmj",cost="2",ammo_box_min="1",ammo_box_max="2",kind="w_pistol",slot="1"}, weapon_mp5=section{section="wpn_mp5",ammo="ammo_9x19_fmj",cost="4",ammo_box_min="1",ammo_box_max="2",kind="w_smg",slot="1"}, weapon_ak74u=section{section="wpn_ak74u",ammo="ammo_5.45x39_fmj",cost="5",ammo_box_min="1",ammo_box_max="2",kind="w_rifle",slot="2"}, weapon_ak74=section{section="wpn_ak74",ammo="ammo_5.45x39_fmj",cost="6",ammo_box_min="1",ammo_box_max="2",kind="w_rifle",slot="2"}, weapon_wincheaster1300=section{section="wpn_wincheaster1300",ammo="ammo_12x70_buck",cost="5",ammo_box_min="1",ammo_box_max="2",kind="w_shotgun",slot="2"},
        ammo=section{ids="ammo_9x18_fmj,ammo_9x19_fmj,ammo_5.45x39_fmj,ammo_12x70_buck"}, ammo_ammo_9x18_fmj=section{section="ammo_9x18_fmj",cost="1"}, ammo_ammo_9x19_fmj=section{section="ammo_9x19_fmj",cost="1"}, ["ammo_ammo_5.45x39_fmj"]=section{section="ammo_5.45x39_fmj",cost="2"}, ammo_ammo_12x70_buck=section{section="ammo_12x70_buck",cost="2"},
        outfits=section{ids="novice,stalker,banditmerc"}, outfit_novice=section{section="novice_outfit",cost="1",armor_class="light"}, outfit_stalker=section{section="stalker_outfit",cost="3",armor_class="medium"}, outfit_banditmerc=section{section="banditmerc_outfit",cost="4",armor_class="scientific"},
        knives=section{ids="knife,knife2,knife3,knife4,knife5,knife6,knife7,knife8,knife9"}, knife_knife=section{section="wpn_knife"}, knife_knife2=section{section="wpn_knife2"}, knife_knife3=section{section="wpn_knife3"}, knife_knife4=section{section="wpn_knife4"}, knife_knife5=section{section="wpn_knife5"}, knife_knife6=section{section="wpn_knife6"}, knife_knife7=section{section="wpn_knife7"}, knife_knife8=section{section="wpn_knife8"}, knife_knife9=section{section="wpn_knife9"},
        grenades=section{ids="f1,rgd5,gd05",npc_ids="f1,rgd5,gd05"}, grenade_f1=section{section="grenade_f1"}, grenade_rgd5=section{section="grenade_rgd5"}, grenade_gd05=section{section="grenade_gd-05"},
        devices=section{ids="headlamp,nv_gen1,nv_gen2,nv_gen3"}, device_headlamp=section{section="device_torch_dummy",kind="headlamp",weight="50",nv_effect="none"}, device_nv_gen1=section{section="device_torch_nv_1",kind="gen1",weight="25",nv_effect="nightvision_1"}, device_nv_gen2=section{section="device_torch_nv_2",kind="gen2",weight="18",nv_effect="nightvision_2"}, device_nv_gen3=section{section="device_torch_nv_3",kind="gen3",weight="7",nv_effect="nightvision_3"},
        consumables=section{ids="bandage,medkit"}, consumable_bandage=section{section="bandage",cost="1"}, consumable_medkit=section{section="medkit",cost="2"},
        medical_items=section{ids="bandage,jgut,stimpack,medkit,analgetic,drug_booster,stimpack_army,salicidic_acid,cocaine,medkit_army,stimpack_scientic,morphine,medkit_scientic,adrenalin,survival_kit,rebirth"},
        medical_bandage=section{section="bandage",category="bleed",actor_cost="1",npc_cost="1",min_tier="1",max_count="2"}, medical_jgut=section{section="jgut",category="bleed",actor_cost="2",npc_cost="0",min_tier="1",max_count="1"}, medical_stimpack=section{section="stimpack",category="health",actor_cost="2",npc_cost="0",min_tier="1",max_count="1"}, medical_medkit=section{section="medkit",category="health",actor_cost="3",npc_cost="2",min_tier="1",max_count="1"}, medical_analgetic=section{section="analgetic",category="boost",actor_cost="2",npc_cost="0",min_tier="1",max_count="1"}, medical_drug_booster=section{section="drug_booster",category="boost",actor_cost="2",npc_cost="0",min_tier="1",max_count="1"}, medical_stimpack_army=section{section="stimpack_army",category="health",actor_cost="3",npc_cost="0",min_tier="2",max_count="1"}, medical_salicidic_acid=section{section="salicidic_acid",category="boost",actor_cost="3",npc_cost="0",min_tier="2",max_count="1"}, medical_cocaine=section{section="cocaine",category="boost",actor_cost="3",npc_cost="0",min_tier="2",max_count="1"}, medical_medkit_army=section{section="medkit_army",category="health",actor_cost="4",npc_cost="0",min_tier="3",max_count="1"}, medical_stimpack_scientic=section{section="stimpack_scientic",category="health",actor_cost="4",npc_cost="0",min_tier="3",max_count="1"}, medical_morphine=section{section="morphine",category="boost",actor_cost="4",npc_cost="0",min_tier="3",max_count="1"}, medical_medkit_scientic=section{section="medkit_scientic",category="health",actor_cost="5",npc_cost="0",min_tier="4",max_count="1"}, medical_adrenalin=section{section="adrenalin",category="boost",actor_cost="5",npc_cost="0",min_tier="4",max_count="1"}, medical_survival_kit=section{section="survival_kit",category="rare",actor_cost="6",npc_cost="0",min_tier="4",max_count="1"}, medical_rebirth=section{section="rebirth",category="rare",actor_cost="7",npc_cost="0",min_tier="4",max_count="1"} } }
    local difficulties = { sections = { meta=section{schema_version="4",revision="5"}, ga_difficulty_rookie=section{tier="1",enemy_min="2",enemy_max="3",enemy_total_budget=tostring(options.rookie_enemy_budget or 25),player_gear_budget="7",player_medical_budget="4",primary_share_percent="50",medical_weight_bleed="35",medical_weight_health="50",medical_weight_boost="15",medical_weight_rare="0",weapon_weight_pistol="50",weapon_weight_smg="30",weapon_weight_shotgun="15",weapon_weight_rifle="5",weapon_weight_sniper="0",armor_weight_light="55",armor_weight_medium="30",armor_weight_scientific="10",armor_weight_heavy="5",armor_weight_powered_exo="0"}, ga_difficulty_stalker=section{tier="2",enemy_min="3",enemy_max="5",enemy_total_budget="50",player_gear_budget="10",player_medical_budget="5",primary_share_percent="60",medical_weight_bleed="25",medical_weight_health="50",medical_weight_boost="25",medical_weight_rare="0",weapon_weight_pistol="25",weapon_weight_smg="35",weapon_weight_shotgun="20",weapon_weight_rifle="18",weapon_weight_sniper="2",armor_weight_light="30",armor_weight_medium="40",armor_weight_scientific="20",armor_weight_heavy="9",armor_weight_powered_exo="1"}, ga_difficulty_veteran=section{tier="3",enemy_min="5",enemy_max="7",enemy_total_budget="75",player_gear_budget="13",player_medical_budget="6",primary_share_percent="75",medical_weight_bleed="20",medical_weight_health="45",medical_weight_boost="30",medical_weight_rare="5",weapon_weight_pistol="10",weapon_weight_smg="25",weapon_weight_shotgun="20",weapon_weight_rifle="38",weapon_weight_sniper="7",armor_weight_light="15",armor_weight_medium="30",armor_weight_scientific="25",armor_weight_heavy="25",armor_weight_powered_exo="5"}, ga_difficulty_master=section{tier="4",enemy_min="7",enemy_max="10",enemy_total_budget="100",player_gear_budget="15",player_medical_budget="8",primary_share_percent="80",medical_weight_bleed="15",medical_weight_health="40",medical_weight_boost="35",medical_weight_rare="10",weapon_weight_pistol="5",weapon_weight_smg="15",weapon_weight_shotgun="15",weapon_weight_rifle="50",weapon_weight_sniper="15",armor_weight_light="10",armor_weight_medium="25",armor_weight_scientific="25",armor_weight_heavy="35",armor_weight_powered_exo="5"} } }
    local layouts = { sections = { meta=section{schema_version="2",revision="2"}, ga_layout_rostok_arena_v1=section{level="l05_bar",actor_spawn_path="t_way",actor_look_path="t_look",opponent_spawn_paths="bar_arena_walk_3_1,bar_arena_walk_3_2,bar_arena_walk_6_1,bar_arena_walk_6_3,bar_arena_walk_6_6,bar_arena_walk_1_1",virtual_capacity="10",virtual_radii="1.5,2.5",max_height_delta="1.0",min_opponent_separation="1.75",min_actor_separation="8.0",max_base_distance="3.0"} } }
    if type(options.mutate) == "function" then options.mutate(catalog, difficulties, layouts, game_sections, system_sections) end
    catalog.sections.meta = section{schema_version='10',revision='11',generator_version='11'}
    for _, id in ipairs({ 'headlamp', 'nv_gen1', 'nv_gen2', 'nv_gen3' }) do
        local device = catalog.sections['device_' .. id]
        device.selection_weight, device.weight = device.weight, nil
    end
    if type(options.mutate_normalized) == 'function' then options.mutate_normalized(catalog, system_sections) end
    local factory = {
        open=function(path) if options.throw_open then error("fixture open failure") end; if string.find(path,"catalogs") then return catalog elseif string.find(path,"difficulties") then return difficulties else return layouts end end,
        section_exists=function(name) if options.throw_section_exists then error("fixture section failure") end; return game_sections[name] == true or (type(system_sections) == "table" and type(system_sections[name]) == "table") end,
        enumerate_sections=options.enumerate_sections,
        enumerate_keys=options.enumerate_keys,
        read_loadout_string=options.read_loadout_string,
        enumerate_loadout_keys=options.enumerate_loadout_keys
    }
    local default_device_system = {
        device_torch_dummy={class="TORCH_S",slot="9"},
        device_torch_nv_1={class="TORCH_S",slot="9",nv_effect="nightvision_1"},
        device_torch_nv_2={class="TORCH_S",slot="9",nv_effect="nightvision_2"},
        device_torch_nv_3={class="TORCH_S",slot="9",nv_effect="nightvision_3"}
    }
    if type(system_sections) == "table" then
        factory.enumerate_system_sections = function()
            local values = {}
            for name in pairs(system_sections) do values[#values + 1] = name end
            if options.reverse_system_order then table.sort(values, function(left, right) return left > right end) end
            return values
        end
    end
    factory.read_system_string = function(name, key)
        local values = type(system_sections) == "table" and system_sections[name] or nil
        values = values or default_device_system[name]
        return values and values[key] or nil
    end
    do
        factory.read_system_u32 = function(name, key)
            if key == "ammo_mag_size" and options.missing_magazine_size then return nil end
            if key == "ammo_mag_size" and options.throw_magazine_size then error("fixture magazine read failure") end
            local values = type(system_sections) == "table" and system_sections[name] or nil
            if values ~= nil then return tonumber(values[key]) end
            local device = default_device_system[name]
            if device ~= nil then return tonumber(device[key]) end
            local base_box_sizes = { ammo_9x18_fmj = 30, ammo_9x19_fmj = 30, ["ammo_5.45x39_fmj"] = 30, ammo_12x70_buck = 10 }
            local magazine_sizes = { wpn_pm = 8, wpn_mp5 = 30, wpn_ak74u = 30, wpn_ak74 = 30, wpn_wincheaster1300 = 8 }
            if key == "box_size" then return base_box_sizes[name] end
            return key == "ammo_mag_size" and magazine_sizes[name] or nil
        end
    end
    if type(loadout_sections) == "table" then
        factory.open_loadouts = function() return { sections=loadout_sections } end
    end
    gamma_arena_test_generator_fixtures.attach(factory, catalog, game_sections, system_sections)
    return factory
end

local function catalogs()
    local result = gamma_arena_catalog.load(fixture_factory())
    local detail = result.ok and "" or (": " .. tostring(result.error and result.error.code))
    gamma_arena_test_assert.is_true(result.ok, "catalog fixture must load" .. detail)
    return result.value
end
local function request(seed, difficulty) return { session_seed=seed, mode_id="skirmish", difficulty_id=difficulty, layout_id="rostok_arena_v1" } end
local function item_by_section(values, section_name)
    for _, item in pairs(values or {}) do if type(item) == "table" and item.section == section_name then return item end end
end

local function sequence_rng(values)
    local index = 0
    return {
        next_int = function(_, minimum, maximum)
            index = index + 1
            local value = values[index]
            gamma_arena_test_assert.is_true(type(value) == "number" and value >= minimum and value <= maximum, "fixture draw stays in range")
            return value
        end,
        pick = function(_, candidates)
            index = index + 1
            return candidates[values[index]]
        end
    }
end

local function grenade_catalog_and_probability_boundaries()
    local snapshot = catalogs()
    gamma_arena_test_assert.equals(#snapshot.actor_grenade_list, 3, "actor grenade pool excludes smoke")
    gamma_arena_test_assert.equals(#snapshot.npc_grenade_list, 3, "opponent grenade pool excludes smoke")
    for _, pool in ipairs({ snapshot.actor_grenade_list, snapshot.npc_grenade_list }) do
        for _, item in ipairs(pool) do
            gamma_arena_test_assert.is_false(item.section == "grenade_smoke", "participant pools never contain smoke")
        end
    end
    for draw, count in pairs({ [1] = 2, [2] = 1, [6] = 1, [7] = 0, [100] = 0 }) do
        local generated = gamma_arena_grenade_generator.generate_actor(snapshot, {
            count = sequence_rng({ draw }),
            sections = { sequence_rng({ 1 }), sequence_rng({ 1 }) }
        })
        gamma_arena_test_assert.is_true(generated.ok, "actor grenade boundary succeeds")
        gamma_arena_test_assert.equals(#generated.value.sections, count, "actor grenade boundary count")
    end
    local duplicate = gamma_arena_grenade_generator.generate_actor(snapshot, {
        count = sequence_rng({ 1 }),
        sections = { sequence_rng({ 3 }), sequence_rng({ 3 }) }
    })
    gamma_arena_test_assert.equals(duplicate.value.sections[1], "grenade_gd-05", "first actor selection is independent")
    gamma_arena_test_assert.equals(duplicate.value.sections[2], "grenade_gd-05", "duplicate actor selections remain valid")
    local present = gamma_arena_grenade_generator.generate_enemy(snapshot, {
        presence = sequence_rng({ 10 }), section = sequence_rng({ 3 })
    })
    gamma_arena_test_assert.equals(present.value.sections[1], "grenade_gd-05", "opponent upper presence boundary")
    local absent = gamma_arena_grenade_generator.generate_enemy(snapshot, {
        presence = sequence_rng({ 11 }), section = sequence_rng({ 1 })
    })
    gamma_arena_test_assert.equals(#absent.value.sections, 0, "opponent absence boundary")
end

local function grenade_generator_rejects_malformed_arguments()
    local snapshot = catalogs()
    local missing_pool = gamma_arena_grenade_generator.generate_actor({}, {
        count = sequence_rng({ 100 }), sections = { sequence_rng({ 1 }), sequence_rng({ 1 }) }
    })
    gamma_arena_test_assert.is_false(missing_pool.ok, "actor generation rejects a missing catalog pool")
    gamma_arena_test_assert.equals(missing_pool.error.code, "GA_GRENADE_ARGUMENT_INVALID", "actor malformed argument code")
    local missing_stream = gamma_arena_grenade_generator.generate_enemy(snapshot, { presence = sequence_rng({ 1 }) })
    gamma_arena_test_assert.is_false(missing_stream.ok, "opponent generation rejects a missing selection stream")
    gamma_arena_test_assert.equals(missing_stream.error.code, "GA_GRENADE_ARGUMENT_INVALID", "opponent malformed argument code")
end

local function device_catalog_and_probability_boundaries()
    local snapshot = catalogs()
    gamma_arena_test_assert.equals(snapshot.schema_version, 10, 'catalog schema')
    gamma_arena_test_assert.equals(snapshot.revision, 11, 'catalog revision')
    gamma_arena_test_assert.equals(snapshot.generator_version, 11, 'generator version')
    local expected = {
        headlamp={section='device_torch_dummy',selection_weight=50,effect=nil},
        nv_gen1={section='device_torch_nv_1',selection_weight=25,effect='nightvision_1'},
        nv_gen2={section='device_torch_nv_2',selection_weight=18,effect='nightvision_2'},
        nv_gen3={section='device_torch_nv_3',selection_weight=7,effect='nightvision_3'}
    }
    for id, wanted in pairs(expected) do
        local semantic = snapshot.devices[id]
        gamma_arena_test_assert.equals(semantic.section, wanted.section, id .. ' exact section')
        gamma_arena_test_assert.equals(semantic.selection_weight, wanted.selection_weight, id .. ' selection weight')
        gamma_arena_test_assert.equals(semantic.weight, nil, id .. ' legacy weight removed')
        gamma_arena_test_assert.equals(semantic.nv_effect, wanted.effect, id .. ' exact effect')
    end
    gamma_arena_test_assert.equals(#snapshot.device_list, 4, "actor device allowlist has four entries")
    gamma_arena_test_assert.equals(snapshot.devices.headlamp.nv_effect, nil, "headlamp effect marker normalizes to nil")
    gamma_arena_test_assert.equals(snapshot.devices.nv_gen1.nv_effect, "nightvision_1", "Gen 1 effect remains exact")
    gamma_arena_test_assert.equals(snapshot.devices.nv_gen2.nv_effect, "nightvision_2", "Gen 2 effect remains exact")
    gamma_arena_test_assert.equals(snapshot.devices.nv_gen3.nv_effect, "nightvision_3", "Gen 3 effect remains exact")
    local boundaries = {
        { draw=1, section="device_torch_dummy" }, { draw=50, section="device_torch_dummy" },
        { draw=51, section="device_torch_nv_1" }, { draw=75, section="device_torch_nv_1" },
        { draw=76, section="device_torch_nv_2" }, { draw=93, section="device_torch_nv_2" },
        { draw=94, section="device_torch_nv_3" }, { draw=100, section="device_torch_nv_3" }
    }
    for _, boundary in ipairs(boundaries) do
        local selected = gamma_arena_device_generator.select(snapshot, sequence_rng({ boundary.draw }))
        gamma_arena_test_assert.is_true(selected.ok, "device boundary selection succeeds")
        gamma_arena_test_assert.equals(selected.value.section, boundary.section, "device probability boundary maps exactly")
    end
    local counts = {}
    for draw = 1, 100 do
        local selected = gamma_arena_device_generator.select(snapshot, sequence_rng({ draw }))
        counts[selected.value.section] = (counts[selected.value.section] or 0) + 1
    end
    gamma_arena_test_assert.equals(counts.device_torch_dummy, 50, "headlamp complete-domain count")
    gamma_arena_test_assert.equals(counts.device_torch_nv_1, 25, "Gen 1 complete-domain count")
    gamma_arena_test_assert.equals(counts.device_torch_nv_2, 18, "Gen 2 complete-domain count")
    gamma_arena_test_assert.equals(counts.device_torch_nv_3, 7, "Gen 3 complete-domain count")
end

local function device_generator_is_mode_free_and_deterministic()
    local snapshot = catalogs()
    local identity = { session_seed=77, fight_index=3, generator_version=11, layout_version=2 }
    local first = gamma_arena_device_generator.generate(snapshot, identity)
    local second = gamma_arena_device_generator.generate(snapshot, identity)
    gamma_arena_test_assert.is_true(first.ok and second.ok, 'mode-free device generation succeeds')
    gamma_arena_test_assert.equals(first.value.section, second.value.section, 'mode-free device replay is deterministic')
    identity.generator_version = 10
    local stale = gamma_arena_device_generator.generate(snapshot, identity)
    gamma_arena_test_assert.is_false(stale.ok, 'stale generator identity is rejected')
    gamma_arena_test_assert.equals(stale.error.code, 'GA_DEVICE_ARGUMENT_INVALID', 'stale generator identity code')
end

local function device_selector_rejects_forged_exact_catalogs()
    local function forged(mutate)
        local snapshot, list = catalogs(), {}
        for index, item in ipairs(snapshot.device_list) do
            local copy = {}
            for key, value in pairs(item) do copy[key] = value end
            list[index] = copy
        end
        local catalog = { schema_version=10, revision=11, generator_version=11, device_list=list }
        mutate(catalog)
        local selected = gamma_arena_device_generator.select(catalog, sequence_rng({ 1 }))
        gamma_arena_test_assert.is_false(selected.ok, 'forged exact device catalog is rejected')
        gamma_arena_test_assert.equals(selected.error.code, 'GA_DEVICE_ARGUMENT_INVALID', 'forged device catalog code')
    end
    for _, mutate in ipairs({
        function(c) c.schema_version=9 end, function(c) c.revision=10 end, function(c) c.generator_version=10 end,
        function(c) c.device_list[2].id='headlamp' end, function(c) c.device_list[2].id='forged' end,
        function(c) c.device_list[2].section='device_torch_nv_3' end, function(c) c.device_list[2].kind='gen3' end,
        function(c) c.device_list[1].selection_weight=49; c.device_list[2].selection_weight=26 end,
        function(c) c.device_list[4].nv_effect='nightvision_2' end,
        function(c) c.device_list[4].weight=7 end
    }) do forged(mutate) end
end

local function device_generator_rejects_malformed_arguments()
    local snapshot = catalogs()
    for _, result in ipairs({
        gamma_arena_device_generator.select({}, sequence_rng({ 1 })),
        gamma_arena_device_generator.select(snapshot, {}),
        gamma_arena_device_generator.generate(snapshot, {})
    }) do
        gamma_arena_test_assert.is_false(result.ok, "device generator rejects malformed arguments")
        gamma_arena_test_assert.equals(result.error.code, "GA_DEVICE_ARGUMENT_INVALID", "device malformed argument code")
    end
end

local function device_catalog_rejects_effective_mismatch()
    local wrong_class = gamma_arena_catalog.load(fixture_factory({ system_sections={ device_torch_nv_1={class='ARTEFACT',slot='9',nv_effect='nightvision_1'} } }))
    gamma_arena_test_assert.is_false(wrong_class.ok, 'device catalog rejects non-TORCH_S class')
    local wrong_effect = gamma_arena_catalog.load(fixture_factory({ system_sections={ device_torch_nv_3={class='TORCH_S',slot='9',nv_effect='nightvision_2'} } }))
    gamma_arena_test_assert.is_false(wrong_effect.ok, 'device catalog rejects mismatched NV effect')
    local missing = gamma_arena_catalog.load(fixture_factory({ mutate_normalized=function(catalog) catalog.sections.devices.ids='headlamp,nv_gen1,nv_gen2' end }))
    gamma_arena_test_assert.is_false(missing.ok, 'device catalog rejects missing device')
    local extra = gamma_arena_catalog.load(fixture_factory({ mutate_normalized=function(catalog) catalog.sections.devices.ids='headlamp,nv_gen1,nv_gen2,nv_gen3,extra' end }))
    gamma_arena_test_assert.is_false(extra.ok, 'device catalog rejects extra device')
    local legacy = gamma_arena_catalog.load(fixture_factory({ mutate_normalized=function(catalog) catalog.sections.device_headlamp.weight='50' end }))
    gamma_arena_test_assert.is_false(legacy.ok, 'device catalog rejects legacy weight field')
    local semantic = gamma_arena_catalog.load(fixture_factory({ mutate=function(catalog) catalog.sections.device_nv_gen3.weight="8" end }))
    gamma_arena_test_assert.is_false(semantic.ok, "device catalog rejects altered weight")
    local effective = gamma_arena_catalog.load(fixture_factory({ system_sections={ device_torch_nv_2={class="TORCH_S",slot="10",nv_effect="nightvision_2"} } }))
    gamma_arena_test_assert.is_false(effective.ok, "device catalog rejects altered effective slot")
end

local function all_available_pairs()
    local weapons = { "w_pistol", "w_smg", "w_shotgun", "w_rifle", "w_sniper" }
    local armors = { "light", "medium", "scientific", "heavy", "powered_exo" }
    local pairs = {}
    for _, weapon_class in ipairs(weapons) do
        for _, armor_class in ipairs(armors) do
            pairs[#pairs + 1] = { weapon_class = weapon_class, armor_class = armor_class, available = true }
        end
    end
    return pairs
end

function fixture_resolved_layout(snapshot, capacity)
    local layout = snapshot.layouts.rostok_arena_v1
    local result = {
        id = layout.id,
        version = layout.version,
        level = layout.level,
        capacity = capacity or 10,
        actor_spawn_path = layout.actor_spawn_path,
        actor_look_path = layout.actor_look_path,
        tactical_routes = {},
        opponent_spawn_slots = {}
    }
    for index, path in ipairs(layout.opponent_spawn_paths) do result.tactical_routes[index] = path end
    for index = 1, result.capacity do
        local route = layout.opponent_spawn_paths[((index - 1) % #layout.opponent_spawn_paths) + 1]
        result.opponent_spawn_slots[index] = {
            id = index <= #layout.opponent_spawn_paths and ("native:" .. route) or ("virtual:" .. (index - #layout.opponent_spawn_paths)),
            base_route = route,
            native = index <= #layout.opponent_spawn_paths,
            position = { x = index * 4, y = 0, z = index % 2 == 0 and 4 or -4 },
            level_vertex_id = 1000 + index,
            game_vertex_id = 77
        }
    end
    return result
end

local function generate_fixture(start_request, fight_index, snapshot, capacity)
    return gamma_arena_generator.generate(start_request, fight_index, snapshot, fixture_resolved_layout(snapshot, capacity))
end

local function validate_fixture(spec, snapshot, capacity)
    return gamma_arena_validator.validate(spec, snapshot, fixture_resolved_layout(snapshot, capacity))
end


local function participant_items(participant)
    return participant.items or participant.loadout.items
end

local function selected_item(participant, snapshot, category)
    for _, entry in ipairs(participant_items(participant)) do
        if snapshot.items[entry.section].category == category then return entry end
    end
end

local function category_count(participant, snapshot, category)
    local count = 0
    for _, entry in ipairs(participant_items(participant)) do
        if snapshot.items[entry.section].category == category then count = count + entry.quantity end
    end
    return count
end

local function medical_cost(participant, snapshot, actor)
    local cost = 0
    for _, entry in ipairs(participant_items(participant)) do
        local medical = item_by_section(snapshot.medical_item_list, entry.section)
        if medical then cost = cost + entry.quantity * (actor and medical.actor_cost or medical.npc_cost) end
    end
    return cost
end

local function item_signature(participant, snapshot, excluded)
    local parts = {}
    for _, entry in ipairs(participant_items(participant)) do
        if not excluded or not excluded[snapshot.items[entry.section].category] then
            parts[#parts + 1] = entry.section .. ":" .. entry.quantity .. ":" .. (entry.equipped_slot or "")
        end
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

local function assert_actor_budget(session, fight_index, snapshot, spec)
    local difficulty = snapshot.difficulties[session.difficulty_id]
    local normalized = request(gamma_arena_rng.normalize_uint32(session.session_seed), session.difficulty_id)
    local gear = gamma_arena_random_generator.player_loadout(normalized, fight_index, snapshot, difficulty)
    gamma_arena_test_assert.is_true(gear.ok, "actor equipment selection succeeds")
    gamma_arena_test_assert.equals(selected_item(spec.actor, snapshot, "weapon").section, gear.value.weapon, "emitted weapon matches budgeted selection")
    gamma_arena_test_assert.equals(selected_item(spec.actor, snapshot, "outfit").section, gear.value.outfit, "emitted outfit matches budgeted selection")
    gamma_arena_test_assert.is_true(gear.value.cost - snapshot.consumables.bandage.cost <= difficulty.player_gear_budget, "actor gear fits dedicated budget")
    gamma_arena_test_assert.is_true(medical_cost(spec.actor, snapshot, true) <= difficulty.player_medical_budget, "actor medicine fits dedicated budget")
end

local function canonical_draft(draft, session, fight_index, snapshot, layout)
    return gamma_arena_fight_spec.canonicalize(draft, {
        session_seed = session.session_seed, fight_index = fight_index, generator_version = snapshot.generator_version,
        catalog_schema_version = snapshot.schema_version, catalog_revision = snapshot.revision,
        catalog_fingerprint = snapshot.fingerprint, layout_version = layout.version,
        layout_hash = gamma_arena_fight_spec.layout_hash(layout)
    }, snapshot, layout)
end

local function generator_10000_seeds()
    local snapshot = catalogs()
    for _, difficulty_id in ipairs({ "rookie", "stalker", "veteran", "master" }) do
        for seed = 0, 9999 do
            local session = request(seed, difficulty_id)
            local generated = generate_fixture(session, seed % 32, snapshot)
            gamma_arena_test_assert.is_true(generated.ok, "10k generation must succeed")
            assert_actor_budget(session, seed % 32, snapshot, generated.value)
            gamma_arena_test_assert.is_true(validate_fixture(generated.value, snapshot).ok, "10k generated FightSpec must validate")
        end
    end
end

local function weighted_player_class_pair_selection()
    local snapshot = catalogs()
    local pair = gamma_arena_random_generator.select_player_class_pair(
        { next_int = function(_, minimum, maximum) return maximum end },
        snapshot.difficulties.master,
        all_available_pairs()
    )
    gamma_arena_test_assert.is_true(pair.ok, "weighted pair selection succeeds")
    gamma_arena_test_assert.equals(pair.value.weapon_class, "w_sniper", "last weighted bucket is reachable")
    gamma_arena_test_assert.equals(pair.value.armor_class, "powered_exo", "last armor bucket is reachable")

    local renormalized = gamma_arena_random_generator.select_player_class_pair(
        { next_int = function(_, minimum, maximum) return maximum end },
        snapshot.difficulties.master,
        {
            { weapon_class = "w_pistol", armor_class = "light", available = false },
            { weapon_class = "invalid", armor_class = "light", available = true },
            { weapon_class = "w_smg", armor_class = "medium", available = true }
        }
    )
    gamma_arena_test_assert.is_true(renormalized.ok, "unavailable and zero-weight pairs are removed")
    gamma_arena_test_assert.equals(renormalized.value.weapon_class, "w_smg", "remaining pair weight is renormalized")
    gamma_arena_test_assert.equals(renormalized.value.armor_class, "medium", "remaining armor pair is retained")
end

local function player_class_pair_ignores_concrete_cardinality()
    local baseline, duplicated = catalogs(), catalogs()
    baseline.selection_mode, duplicated.selection_mode = "staged", "staged"
    baseline.minimum_loadout_cost, duplicated.minimum_loadout_cost = 1, 1
    local baseline_exo = { section = "synthetic_powered_exo", cost = 1, armor_class = "powered_exo" }
    local duplicated_exo = { section = "synthetic_powered_exo", cost = 1, armor_class = "powered_exo" }
    baseline.outfits[baseline_exo.section] = baseline_exo
    baseline.outfit_list[#baseline.outfit_list + 1] = baseline_exo
    duplicated.outfits[duplicated_exo.section] = duplicated_exo
    duplicated.outfit_list[#duplicated.outfit_list + 1] = duplicated_exo
    duplicated.weapon_list[#duplicated.weapon_list + 1] = duplicated.weapons.ak74
    duplicated.weapon_list[#duplicated.weapon_list + 1] = duplicated.weapons.ak74
    duplicated.outfit_list[#duplicated.outfit_list + 1] = duplicated_exo
    duplicated.outfit_list[#duplicated.outfit_list + 1] = duplicated_exo
    for seed = 0, 255 do
        local first = gamma_arena_random_generator.player_loadout(request(seed, "master"), seed % 32, baseline, baseline.difficulties.master)
        local second = gamma_arena_random_generator.player_loadout(request(seed, "master"), seed % 32, duplicated, duplicated.difficulties.master)
        gamma_arena_test_assert.is_true(first.ok and second.ok, "duplicate concrete records still generate")
        gamma_arena_test_assert.equals(item_by_section(baseline.weapons, first.value.weapon).kind, item_by_section(duplicated.weapons, second.value.weapon).kind, "duplicate rifles do not change the selected weapon class")
        gamma_arena_test_assert.equals(item_by_section(baseline.outfits, first.value.outfit).armor_class, item_by_section(duplicated.outfits, second.value.outfit).armor_class, "duplicate exos do not change the selected armor class")
    end
end

local function master_player_class_diversity()
    local snapshot = catalogs()
    local ammo = snapshot.ammo.ammo_9x18_fmj
    local function add_weapon(section, kind)
        local weapon = { section = section, ammo = ammo.section, ammo_variants = { { section = ammo.section, category = "standard", box_size = 30 } }, magazine_size = 30, cost = 2, ammo_box_min = 1, ammo_box_max = 1, kind = kind, slot = 2 }
        snapshot.weapons[section] = weapon
        snapshot.weapon_list[#snapshot.weapon_list + 1] = weapon
    end
    local function add_outfit(section, armor_class)
        local outfit = { section = section, cost = 1, armor_class = armor_class }
        snapshot.outfits[section] = outfit
        snapshot.outfit_list[#snapshot.outfit_list + 1] = outfit
    end
    add_weapon("synthetic_sniper", "w_sniper")
    gamma_arena_test_weapon_safety.audited_catalog(snapshot)
    add_outfit("synthetic_heavy", "heavy")
    add_outfit("synthetic_powered_exo", "powered_exo")
    snapshot.selection_mode = "staged"
    snapshot.minimum_loadout_cost = 1
    local seen_weapons, seen_armors = {}, {}
    for seed = 0, 9999 do
        local generated = gamma_arena_random_generator.player_loadout(request(seed, "master"), seed % 32, snapshot, snapshot.difficulties.master)
        gamma_arena_test_assert.is_true(generated.ok, "synthetic Master generation succeeds")
        local loadout = generated.value
        seen_weapons[item_by_section(snapshot.weapons, loadout.weapon).kind] = true
        seen_armors[item_by_section(snapshot.outfits, loadout.outfit).armor_class] = true
    end
    local weapon_count, armor_count = 0, 0
    for _ in pairs(seen_weapons) do weapon_count = weapon_count + 1 end
    for _ in pairs(seen_armors) do armor_count = armor_count + 1 end
    gamma_arena_test_assert.is_true(weapon_count >= 4, "Master selection reaches at least four affordable weapon classes")
    gamma_arena_test_assert.is_true(seen_weapons.w_sniper == true, "audited synthetic sniper remains reachable")
    gamma_arena_test_assert.is_true(armor_count >= 4, "Master selection reaches at least four affordable armor classes")
end
local function catalog_enforces_max_count_viability()
    local loaded = gamma_arena_catalog.load(fixture_factory())
    gamma_arena_test_assert.is_true(loaded.ok, "v2 catalog must be viable at every enemy_max")
    local minimum_profile_cost = loaded.value.profile_list[1].cost
    for _, profile in ipairs(loaded.value.profile_list) do minimum_profile_cost = math.min(minimum_profile_cost, profile.cost) end
    local minimum = minimum_profile_cost + loaded.value.combinations[1].cost
    for _, difficulty_id in ipairs(loaded.value.difficulty_ids) do
        local difficulty = loaded.value.difficulties[difficulty_id]
        gamma_arena_test_assert.is_true(difficulty.enemy_total_budget >= difficulty.enemy_max * minimum, "difficulty max count must fit minimum enemies")
    end
    local rejected = gamma_arena_catalog.load(fixture_factory(17))
    gamma_arena_test_assert.is_false(rejected.ok, "infeasible difficulty fixture must fail closed")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_DIFFICULTY_MANIFEST_INVALID", "same-revision difficulty drift code")
end

local function catalog_exposes_approved_player_weight_rows()
    local snapshot = catalogs()
    local expected = {
        rookie = { gear_budget=7, medical_budget=4, weapons={w_pistol=50,w_smg=30,w_shotgun=15,w_rifle=5,w_sniper=0}, armor={light=55,medium=30,scientific=10,heavy=5,powered_exo=0} },
        stalker = { gear_budget=10, medical_budget=5, weapons={w_pistol=25,w_smg=35,w_shotgun=20,w_rifle=18,w_sniper=2}, armor={light=30,medium=40,scientific=20,heavy=9,powered_exo=1} },
        veteran = { gear_budget=13, medical_budget=6, weapons={w_pistol=10,w_smg=25,w_shotgun=20,w_rifle=38,w_sniper=7}, armor={light=15,medium=30,scientific=25,heavy=25,powered_exo=5} },
        master = { gear_budget=15, medical_budget=8, weapons={w_pistol=5,w_smg=15,w_shotgun=15,w_rifle=50,w_sniper=15}, armor={light=10,medium=25,scientific=25,heavy=35,powered_exo=5} }
    }
    for difficulty_id, expected_row in pairs(expected) do
        local actual = snapshot.difficulties[difficulty_id]
        gamma_arena_test_assert.equals(actual.player_gear_budget, expected_row.gear_budget, "approved player gear budget")
        gamma_arena_test_assert.equals(actual.player_medical_budget, expected_row.medical_budget, "approved player medical budget")
        for kind, weight in pairs(expected_row.weapons) do gamma_arena_test_assert.equals(actual.player_weapon_weights[kind], weight, "approved weapon weight") end
        for armor_class, weight in pairs(expected_row.armor) do gamma_arena_test_assert.equals(actual.player_armor_weights[armor_class], weight, "approved armor weight") end
    end
end
local function catalog_normalizes_weapon_magazine_capacity()
    local snapshot = catalogs()
    gamma_arena_test_assert.equals(snapshot.weapons.pm.magazine_size, 8, "fallback pistol magazine capacity")
    gamma_arena_test_assert.equals(snapshot.weapons.mp5.magazine_size, 30, "fallback SMG magazine capacity")
end
local function master_powered_exo_rate_is_rare()
    local snapshot = catalogs()
    local ammo = snapshot.ammo.ammo_9x18_fmj
    local sniper = { section="synthetic_sniper_rate", ammo=ammo.section, ammo_variants={ { section=ammo.section, category="standard", box_size=30 } }, magazine_size=30, cost=2, ammo_box_min=1, ammo_box_max=1, kind="w_sniper", slot=2 }
    local heavy = { section="synthetic_heavy_rate", cost=1, armor_class="heavy" }
    local exo = { section="synthetic_exo_rate", cost=1, armor_class="powered_exo" }
    snapshot.weapons[sniper.section] = sniper
    snapshot.weapon_list[#snapshot.weapon_list + 1] = sniper
    gamma_arena_test_weapon_safety.audited_catalog(snapshot)
    snapshot.outfits[heavy.section] = heavy
    snapshot.outfit_list[#snapshot.outfit_list + 1] = heavy
    snapshot.outfits[exo.section] = exo
    snapshot.outfit_list[#snapshot.outfit_list + 1] = exo
    snapshot.selection_mode = "staged"
    snapshot.minimum_loadout_cost = 1
    local exo_count = 0
    for seed = 0, 9999 do
        local generated = gamma_arena_random_generator.player_loadout(request(seed, "master"), seed % 32, snapshot, snapshot.difficulties.master)
        gamma_arena_test_assert.is_true(generated.ok, "Master rate sample generates")
        local armor_class = item_by_section(snapshot.outfits, generated.value.outfit).armor_class
        if armor_class == "powered_exo" then exo_count = exo_count + 1 end
    end
    gamma_arena_test_assert.is_true(exo_count >= 400 and exo_count <= 600, "Master powered exo rate stays near five percent")
end

local function catalog_augments_from_effective_system_without_cartesian_product()
    local function has_unique_sections(values)
        local seen = {}
        for _, value in ipairs(values) do
            if seen[value.section] then return false end
            seen[value.section] = true
        end
        return true
    end
    local system_sections = {
        wpn_dynamic_fixture = { kind="w_rifle", slot="2", ammo_mag_size="30", ammo_class="ammo_dynamic_fixture" },
        ammo_dynamic_fixture = { kind="w_ammo", box_size="30" },
        wpn_pm = { kind="w_pistol", slot="1", ammo_mag_size="8", ammo_class="ammo_9x18_fmj,ammo_9x18_hp,ammo_9x18_ap" },
        ammo_9x18_fmj = { kind="w_ammo", box_size="50" },
        ammo_9x18_hp = { kind="w_ammo", box_size="50" },
        ammo_9x18_ap = { kind="w_ammo", box_size="50" },
        dynamic_fixture_outfit = { kind="o_medium", slot="6" }
    }
    local loadout_sections = {
        stalker_novice = { primary="stalker_novice_primary", secondary="stalker_novice_secondary" },
        stalker_novice_primary = {
            ["wpn_dynamic_fixture:0:0:10"]="",
            ["wpn_not_installed_fixture:0:0:90"]=""
        },
        stalker_novice_secondary = {
            ["wpn_pm:0:0:10"]=""
        }
    }
    local loadout_reads = 0
    local first = gamma_arena_catalog.load(fixture_factory({
        system_sections=system_sections,
        loadout_sections=loadout_sections,
        read_loadout_string=function(_, section_name, key)
            loadout_reads = loadout_reads + 1
            local values = loadout_sections[section_name]
            return values and values[key] or nil
        end,
        enumerate_loadout_keys=function(_, section_name)
            loadout_reads = loadout_reads + 1
            local values = {}
            for key in pairs(loadout_sections[section_name] or {}) do values[#values + 1] = key end
            return values
        end
    }))
    local reordered = gamma_arena_catalog.load(fixture_factory({ system_sections=system_sections, loadout_sections=loadout_sections, reverse_system_order=true }))
    gamma_arena_test_assert.is_true(first.ok and reordered.ok, "effective system catalog augmentation succeeds")
    gamma_arena_test_assert.equals(first.value.selection_mode, "staged", "large dynamic catalogs use staged selection")
    gamma_arena_test_assert.is_true(first.value.combinations == nil, "dynamic catalog never builds a weapon/outfit Cartesian product")
    gamma_arena_test_assert.equals(first.value.weapons.wpn_dynamic_fixture.section, "wpn_dynamic_fixture", "installed weapon is keyed by exact section")
    gamma_arena_test_assert.equals(first.value.ammo.ammo_dynamic_fixture.section, "ammo_dynamic_fixture", "installed ammo is keyed by exact section")
    gamma_arena_test_assert.equals(#first.value.weapons.pm.ammo_variants, 3, "installed fallback weapon record adopts clean discovered ammo variants")
    gamma_arena_test_assert.equals(first.value.weapons.pm.ammo_variants[2].category, "special", "installed fallback weapon retains discovered special variant")
    gamma_arena_test_assert.equals(first.value.weapons.pm.ammo_variants[3].category, "armor_piercing", "installed fallback weapon retains discovered AP variant")
    gamma_arena_test_assert.equals(first.value.weapons.wpn_pm, nil, "fallback overlap does not add a second section-keyed weapon record")
    gamma_arena_test_assert.is_true(has_unique_sections(first.value.weapon_list), "normalized weapon list has unique sections after fallback overlap")
    gamma_arena_test_assert.is_true(has_unique_sections(first.value.outfit_list), "normalized outfit list has unique sections after dynamic augmentation")
    gamma_arena_test_assert.is_true(has_unique_sections(first.value.knife_list), "normalized knife list has unique sections after dynamic augmentation")
    gamma_arena_test_assert.is_true(type(first.value.ammo.ammo_9x18_hp) == "table" and type(first.value.ammo.ammo_9x18_ap) == "table", "fallback weapon variants are materialized in the ammo catalog")
    gamma_arena_test_assert.equals(first.value.outfits.dynamic_fixture_outfit.section, "dynamic_fixture_outfit", "installed outfit is keyed by exact section")
    gamma_arena_test_assert.equals(first.value.generator_version, 11, "dynamic selection has an explicit generator version")
    gamma_arena_test_assert.equals(first.value.weapons.wpn_dynamic_fixture.magazine_size, 30, "discovered weapon retains effective magazine capacity")
    gamma_arena_test_assert.is_true(gamma_arena_number.is_positive_integer(first.value.minimum_loadout_cost), "dynamic catalog exposes minimum viable loadout cost")
    gamma_arena_test_assert.equals(#first.value.weapon_pools_by_profile.gamma_arena_stalker_novice.primary, 1, "faction primary pool intersects effective eligible firearms")
    gamma_arena_test_assert.equals(first.value.weapon_pools_by_profile.gamma_arena_stalker_novice.primary[1].section, "wpn_dynamic_fixture", "faction primary pool stores normalized weapon records")
    gamma_arena_test_assert.equals(#first.value.weapon_pools_by_profile.gamma_arena_stalker_novice.secondary, 1, "faction secondary pool remains separate")
    gamma_arena_test_assert.equals(first.value.weapon_pools_by_profile.gamma_arena_stalker_novice.secondary[1].section, "wpn_pm", "faction secondary pool stores normalized weapon records")
    gamma_arena_test_assert.is_true(loadout_reads > 0, "extended GAMMA loadout readers are used")
    gamma_arena_test_assert.equals(first.value.fingerprint, reordered.value.fingerprint, "catalog fingerprint ignores system enumeration order")
    local changed_sections = {
        wpn_dynamic_fixture = system_sections.wpn_dynamic_fixture,
        ammo_dynamic_fixture = system_sections.ammo_dynamic_fixture,
        dynamic_fixture_outfit = system_sections.dynamic_fixture_outfit,
        wpn_second_dynamic_fixture = { kind="w_smg", slot="1", ammo_mag_size="20", ammo_class="ammo_dynamic_fixture" }
    }
    local changed = gamma_arena_catalog.load(fixture_factory({ system_sections=changed_sections }))
    gamma_arena_test_assert.is_true(changed.ok, "changed installed catalog remains valid")
    gamma_arena_test_assert.is_true(changed.value.fingerprint ~= first.value.fingerprint, "accepted installed content changes catalog fingerprint revision")
    local selected_dynamic_weapon, selected_dynamic_outfit = false, false
    local seen_factions = {}
    local function profile_for(section_name)
        for _, profile in ipairs(first.value.profile_list) do
            if profile.section == section_name then return profile end
        end
    end
    for seed = 0, 255 do
        local generated = generate_fixture(request(seed, "rookie"), seed % 8, first.value)
        gamma_arena_test_assert.is_true(generated.ok, "dynamic catalog generation succeeds across seeds")
        gamma_arena_test_assert.is_true(validate_fixture(generated.value, first.value).ok, "dynamic generated FightSpec validates")
        if selected_item(generated.value.actor, first.value, "weapon").section == "wpn_dynamic_fixture" then selected_dynamic_weapon = true end
        if selected_item(generated.value.actor, first.value, "outfit").section == "dynamic_fixture_outfit" then selected_dynamic_outfit = true end
        local cohort
        for _, opponent in ipairs(generated.value.opponents) do
            local profile = profile_for(opponent.profile)
            gamma_arena_test_assert.is_true(type(profile) == "table" and type(profile.faction) == "string", "dynamic opponent profile declares a faction")
            cohort = cohort or profile.faction
            gamma_arena_test_assert.equals(profile.faction, cohort, "one generated fight contains one faction cohort")
            gamma_arena_test_assert.equals(opponent.faction, profile.community, "FightSpec carries expected profile community")
        end
        seen_factions[cohort] = true
    end
    gamma_arena_test_assert.is_true(selected_dynamic_weapon, "installed weapon participates in deterministic actor selection")
    gamma_arena_test_assert.is_true(selected_dynamic_outfit, "installed outfit participates in deterministic actor selection")
    local faction_count = 0
    for _ in pairs(seen_factions) do faction_count = faction_count + 1 end
    gamma_arena_test_assert.is_true(faction_count >= 3, "different deterministic seeds exercise multiple human factions")
    local sample = generate_fixture(request(777, "rookie"), 0, first.value)
    local valid_runtime = gamma_arena_validator.validate_runtime(sample.value, first.value, fixture_resolved_layout(first.value), {
        effective_profile = function(section_name)
            local profile = profile_for(section_name)
            return { class="AI_STL_S", community=profile.runtime_community }
        end
    })
    gamma_arena_test_assert.is_true(valid_runtime.ok, "runtime validator accepts each isolated Arena community")
    local mismatch = gamma_arena_validator.validate_runtime(sample.value, first.value, fixture_resolved_layout(first.value), {
        effective_profile = function() return { class="AI_STL_S", community="community_mismatch" } end
    })
    gamma_arena_test_assert.is_false(mismatch.ok, "runtime validator rejects an effective community mismatch")
    gamma_arena_test_assert.equals(mismatch.error.code, "GA_FIGHTSPEC_PROFILE_RUNTIME_INVALID", "community mismatch preserves stable code")
end

local function weapon_quarantine_is_exact_and_global()
    local snapshot = { max_physical_items_per_participant = 256, items = {} }
    local blocked = { "wpn_dtmdr", "wpn_eft_mts_255_uh2", "wpn_vssk_ekp8_18" }
    local siblings = { "wpn_dtmdr_acog", "wpn_dtmdr_eot", "wpn_eft_mts_255", "wpn_eft_mts_255_acog", "wpn_vssk", "wpn_vssk_acog" }
    for _, sections in ipairs({ blocked, siblings }) do
        for _, section in ipairs(sections) do
            snapshot.items[section] = { category = "weapon", ltx_slot = 2, ammo_sections = {} }
        end
    end
    gamma_arena_test_weapon_safety.audited_catalog(snapshot)
    for _, section in ipairs(blocked) do
        gamma_arena_test_assert.is_false(gamma_arena_weapon_safety.allowed(snapshot, section), "exact manual blacklist is global")
        local result = gamma_arena_item_materializer.descriptors({ { section = section, quantity = 1 } }, snapshot)
        gamma_arena_test_assert.equals(result.error.code, "GA_WEAPON_UNSAFE", "actor and NPC shared materialization rejects manual blacklist")
    end
    for _, section in ipairs(siblings) do
        gamma_arena_test_assert.is_true(gamma_arena_weapon_safety.allowed(snapshot, section), "healthy sibling variants remain eligible")
    end
end

local function validator_rejects_unknown_spawn_path()
    local snapshot = catalogs()
    local generated = generate_fixture(request(1, "rookie"), 0, snapshot)
    gamma_arena_test_assert.is_true(generated.ok, "path validation fixture must generate")
    generated.value.opponents[1].tactical_route = "not_an_arena_path"
    local rejected = validate_fixture(generated.value, snapshot)
    gamma_arena_test_assert.is_false(rejected.ok, "validator must reject an unknown spawn path")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_FIGHTSPEC_ROUTE_INVALID", "unknown tactical route code")
end
local function catalog_rejects_malformed_data()
    local cases = {
        { code="GA_CATALOG_SECTION_MISSING", mutate=function(c) c.sections.profiles=nil end },
        { code="GA_CATALOG_EMPTY", mutate=function(c) c.sections.profiles.ids="" end },
        { code="GA_CATALOG_DUPLICATE_ID", mutate=function(c) c.sections.profiles.ids="novice,novice" end },
        { code="GA_CATALOG_PROFILE_NOT_HUMAN", mutate=function(c,d,l,s) c.sections.profile_novice.section="sim_default_bloodsucker";s.sim_default_bloodsucker=true end },
        { code="GA_CATALOG_AMMO_INVALID", mutate=function(c) c.sections.weapon_pm.ammo="ammo_9x19_fmj" end },
        { code="GA_CATALOG_UNKNOWN_KEY", mutate=function(c) c.sections.profile_novice.unexpected="1" end },
        { code="GA_CATALOG_UNKNOWN_SECTION", mutate=function(c) c.sections.unexpected={} end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.profiles.ids=true end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.outfits.ids="novice,stalker,banditmerc,exo";c.sections.outfit_exo={section="exo_outfit",cost="10"} end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.outfits.ids="novice,stalker";c.sections.outfit_banditmerc=nil end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.consumables.ids="bandage,medkit,grenade";c.sections.consumable_grenade={section="grenade_f1",cost="3"} end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.consumables.ids="medkit";c.sections.consumable_bandage=nil end },
        { code="GA_CATALOG_DUPLICATE_ID", mutate=function(c) c.sections.grenades.npc_ids="f1,rgd5,rgd5" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.grenades.npc_ids="f1,rgd5,smoke" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.grenades.ids="f1,rgd5,gd05,smoke";c.sections.grenade_smoke={section="grenade_smoke"} end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.profile_novice.cost="2" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.weapon_pm.cost="3" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.weapon_pm.ammo_box_max="3" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.ammo_ammo_9x18_fmj.cost="2" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.outfit_novice.cost="2" end },
        { code="GA_CATALOG_MANIFEST_INVALID", mutate=function(c) c.sections.consumable_bandage.cost="2" end },
        { code="GA_CATALOG_INVALID", mutate=function(c) c.sections.profile_novice.cost=math.huge end },
        { code="GA_CATALOG_INVALID", mutate=function(c) c.sections.profile_novice.cost=-math.huge end },
        { code="GA_CATALOG_INVALID", mutate=function(c,d) d.sections.ga_difficulty_rookie.enemy_min=0/0 end },
        { code="GA_CATALOG_VERSION_UNSUPPORTED", mutate=function(c,d) d.sections.meta.schema_version="1" end },
        { code="GA_CATALOG_VERSION_UNSUPPORTED", mutate=function(c,d,l) l.sections.meta.revision="1" end },
        { code="GA_DIFFICULTY_MANIFEST_INVALID", mutate=function(c,d) d.sections.ga_difficulty_rookie.enemy_total_budget="13" end },
        { code="GA_LAYOUT_MANIFEST_INVALID", mutate=function(c,d,l) l.sections.ga_layout_rostok_arena_v1.opponent_spawn_paths="bar_arena_walk_3_2,bar_arena_walk_3_1,bar_arena_walk_6_1,bar_arena_walk_6_3,bar_arena_walk_6_6,bar_arena_walk_1_1" end },
        { code="GA_LAYOUT_INVALID", mutate=function(c,d,l) l.sections.ga_layout_rostok_arena_v1.actor_spawn_path="" end },
        { code="GA_LAYOUT_INVALID", mutate=function(c,d,l) l.sections.ga_layout_rostok_arena_v1.actor_look_path=l.sections.ga_layout_rostok_arena_v1.actor_spawn_path end },
        { code="GA_LAYOUT_INVALID", mutate=function(c,d,l) l.sections.ga_layout_rostok_arena_v1.opponent_spawn_paths="bar_arena_walk_3_1,bar_arena_walk_3_2,bar_arena_walk_6_1,bar_arena_walk_6_3,bar_arena_walk_6_6,bar_arena_walk_3_1" end }
    }
    for _, case in ipairs(cases) do
        local result = gamma_arena_catalog.load(fixture_factory({ mutate=case.mutate }))
        gamma_arena_test_assert.is_false(result.ok, "malformed catalog must fail closed")
        gamma_arena_test_assert.equals(result.error.code, case.code, "malformed catalog error code")
    end
    local open_failure = gamma_arena_catalog.load(fixture_factory({ throw_open=true }))
    gamma_arena_test_assert.equals(open_failure.error.code, "GA_CATALOG_OPEN_FAILED", "throwing open must be structured")
    local section_failure = gamma_arena_catalog.load(fixture_factory({ throw_section_exists=true }))
    gamma_arena_test_assert.equals(section_failure.error.code, "GA_CATALOG_SECTION_CHECK_FAILED", "throwing section_exists must be structured")
    local section_enumeration = gamma_arena_catalog.load(fixture_factory({ enumerate_sections=function() error("enumeration failure") end }))
    gamma_arena_test_assert.equals(section_enumeration.error.code, "GA_CATALOG_ENUMERATION_FAILED", "throwing section enumeration must be structured")
    local key_enumeration = gamma_arena_catalog.load(fixture_factory({ enumerate_keys=function() error("enumeration failure") end }))
    gamma_arena_test_assert.equals(key_enumeration.error.code, "GA_CATALOG_ENUMERATION_FAILED", "throwing key enumeration must be structured")
    local invalid_open = gamma_arena_catalog.load({ open=function() return true end, section_exists=function() return true end })
    gamma_arena_test_assert.is_false(invalid_open.ok, "invalid opened objects must fail closed")
    gamma_arena_test_assert.is_true(string.sub(invalid_open.error.code,1,11) == "GA_CATALOG_", "invalid opened object code")
    for _, options in ipairs({ { missing_magazine_size = true }, { throw_magazine_size = true } }) do
        local invalid_magazine = gamma_arena_catalog.load(fixture_factory(options))
        gamma_arena_test_assert.is_false(invalid_magazine.ok, "fallback weapon magazine size must fail closed")
        gamma_arena_test_assert.equals(invalid_magazine.error.code, "GA_CATALOG_MAGAZINE_INVALID", "fallback magazine capacity error code")
    end
    for _, options in ipairs({
        { system_sections = { ammo_9x18_fmj = { box_size = "zero" } } },
        { system_sections = { ammo_9x18_fmj = { box_size = "0" } } },
        { system_sections = { ammo_9x18_fmj = { box_size = "-1" } } },
        { system_sections = { ammo_9x18_fmj = { box_size = "4294967296" } } }
    }) do
        local invalid_variant = gamma_arena_catalog.load(fixture_factory(options))
        gamma_arena_test_assert.is_false(invalid_variant.ok, "fallback ammo box size must fail closed")
        gamma_arena_test_assert.equals(invalid_variant.error.code, "GA_CATALOG_AMMO_VARIANT_INVALID", "fallback ammo variant error code")
    end
end
local function validator_never_throws_for_malformed_specs()
    local snapshot = catalogs()
    local mutations = {
        {code="GA_FIGHTSPEC_FORBIDDEN_FIELD",fn=function(spec) spec.mode_id="survival" end},
        {code="GA_FIGHTSPEC_ARENA_INVALID",fn=function(spec) spec.arena.layout_id="missing" end},
        {code="GA_FIGHTSPEC_ARENA_INVALID",fn=function(spec) spec.arena.level="bad" end},
        {code="GA_FIGHTSPEC_VERSION_INVALID",fn=function(spec) spec.schema_version=math.huge end},
        {code="GA_FIGHTSPEC_OPPONENT_INVALID",fn=function(spec) spec.opponents[1].slot=math.huge end},
        {code="GA_FIGHTSPEC_OPPONENT_SLOT_DUPLICATE",fn=function(spec) spec.opponents[2].slot=spec.opponents[1].slot end},
        {code="GA_FIGHTSPEC_OPPONENT_INVALID",fn=function(spec) spec.opponents="bad" end},
        {code="GA_FIGHTSPEC_TYPE_INVALID",fn=function(spec) spec.actor="bad" end},
        {code="GA_FIGHTSPEC_ARRAY_INVALID",fn=function(spec) spec.actor.items="bad" end},
        {code="GA_FIGHTSPEC_ARRAY_INVALID",fn=function(spec) spec.actor.items[1]=nil end},
        {code="GA_FIGHTSPEC_ITEM_INVALID",fn=function(spec) spec.actor.items[1].section=4 end},
        {code="GA_FIGHTSPEC_ITEM_UNKNOWN",fn=function(spec) spec.actor.items[1].section="unknown_outfit" end},
        {code="GA_FIGHTSPEC_ITEM_INVALID",fn=function(spec) spec.actor.items[1].quantity="1" end},
        {code="GA_FIGHTSPEC_ITEM_INVALID",fn=function(spec) spec.actor.items[1].quantity=0/0 end},
        {code="GA_FIGHTSPEC_ITEM_INVALID",fn=function(spec) spec.actor.items[1].quantity=-1 end},
        {code="GA_FIGHTSPEC_ITEM_EQUIPMENT_INVALID",fn=function(spec) selected_item(spec.actor,snapshot,"outfit").equipped_slot="knife" end},
        {code="GA_FIGHTSPEC_PROFILE_INVALID",fn=function(spec) spec.opponents[1].profile="gamma_arena_bandit_unknown" end},
        {code="GA_FIGHTSPEC_RANK_INVALID",fn=function(spec) spec.opponents[1].rank.value=-1 end}
    }
    for _, field in ipairs({ "session_seed", "fight_index", "generator_version", "catalog_revision", "layout_version" }) do
        for _, value in ipairs({ math.huge, -math.huge, 0/0, "1", -1 }) do
            local identity_field, invalid_value = field, value
            mutations[#mutations + 1] = { code="GA_FIGHTSPEC_IDENTITY_INVALID", fn=function(spec) spec.identity[identity_field]=invalid_value end }
        end
    end
    for _, mutation in ipairs(mutations) do
        local generated = generate_fixture(request(17,"rookie"),0,snapshot)
        gamma_arena_test_assert.is_true(generated.ok, "malformed-spec control generates")
        gamma_arena_test_assert.is_true(validate_fixture(generated.value,snapshot).ok, "control validates before mutation")
        mutation.fn(generated.value)
        local called, result = pcall(validate_fixture, generated.value, snapshot)
        gamma_arena_test_assert.is_true(called, "malformed FightSpec validation must not throw")
        gamma_arena_test_assert.is_false(result.ok, "malformed FightSpec must fail")
        gamma_arena_test_assert.equals(result.error.code, mutation.code, "malformed FightSpec reaches intended invariant")
    end
end
local function validator_rejects_duplicate_spawn_path()
    local snapshot = catalogs()
    local generated = generate_fixture(request(5,"stalker"),0,snapshot)
    gamma_arena_test_assert.is_true(generated.ok and #generated.value.opponents >= 2, "duplicate path fixture needs two valid opponents")
    generated.value.opponents[2].spawn_slot_id = generated.value.opponents[1].spawn_slot_id
    generated.value.opponents[2].spawn = generated.value.opponents[1].spawn
    local rejected = validate_fixture(generated.value,snapshot)
    gamma_arena_test_assert.is_false(rejected.ok,"duplicate spawn paths must fail validation")
    gamma_arena_test_assert.equals(rejected.error.code,"GA_FIGHTSPEC_SPAWN_INVALID","validator must reach duplicate physical-slot branch")
end
local function validator_rejects_redistributed_slot_budget()
    local snapshot = catalogs()
    local generated = generate_fixture(request(1,"stalker"),0,snapshot)
    gamma_arena_test_assert.is_true(generated.ok, "redistribution control generates")
    local spec = generated.value
    local first = selected_item(spec.opponents[1], snapshot, "ammo")
    local second = selected_item(spec.opponents[2], snapshot, "ammo")
    gamma_arena_test_assert.is_true(first ~= nil and second ~= nil, "both opponents have ammunition")
    gamma_arena_test_assert.is_true(first.quantity > 1, "donor retains compatible ammunition after redistribution")
    gamma_arena_test_assert.equals(snapshot.ammo[first.section].cost, snapshot.ammo[second.section].cost, "redistributed boxes have equal unit costs")
    local total_boxes = first.quantity + second.quantity
    first.quantity = first.quantity - 1
    second.quantity = second.quantity + 1
    gamma_arena_test_assert.equals(first.quantity + second.quantity, total_boxes, "redistribution preserves aggregate ammunition cost")
    local rejected = validate_fixture(spec,snapshot)
    gamma_arena_test_assert.is_false(rejected.ok, "physical loadout redistribution invalidates canonical content integrity")
    gamma_arena_test_assert.equals(rejected.error.code,"GA_FIGHTSPEC_INTEGRITY_INVALID","redistribution reaches integrity rather than obsolete budget fields")
end
local function stable_and_fight_index()
    local snapshot = catalogs()
    local first = generate_fixture(request(3735928559,"veteran"),7,snapshot).value
    local second = generate_fixture(request(3735928559,"veteran"),7,snapshot).value
    gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first),gamma_arena_generator.stable_encode(second),"same request stable encoding")
    local zero = generate_fixture(request(0,"veteran"),7,snapshot).value
    local wrapped = generate_fixture(request(4294967295,"veteran"),7,snapshot).value
    gamma_arena_test_assert.equals(zero.identity.session_seed, 0, "uint32 zero remains a distinct identity")
    gamma_arena_test_assert.equals(wrapped.identity.session_seed, 4294967295, "uint32 maximum remains exact")
    local validated = validate_fixture(first,snapshot)
    gamma_arena_test_assert.is_true(validated.ok,"generated FightSpec exposes a validated view")
    gamma_arena_test_assert.equals(validated.value.session_seed(),first.identity.session_seed,"validated view session seed")
    gamma_arena_test_assert.equals(validated.value.fight_index(),first.identity.fight_index,"validated view fight index")
    for _, changed in ipairs({
        generate_fixture(request(3735928559,"veteran"),8,snapshot).value,
        generate_fixture(request(3735928560,"veteran"),7,snapshot).value
    }) do
        gamma_arena_test_assert.is_true(first.identity.fight_id ~= changed.identity.fight_id, "changed identity changes fight id")
        gamma_arena_test_assert.is_true(item_signature(first.actor, snapshot) ~= item_signature(changed.actor, snapshot)
            or first.opponents[1].profile ~= changed.opponents[1].profile
            or first.opponents[1].spawn_slot_id ~= changed.opponents[1].spawn_slot_id, "identity alters procedural content")
    end
end

local function bonus_ammo_category_boundaries_and_fallback()
    local weapon = {
        ammo = "ammo_bonus_fmj",
        ammo_variants = {
            { section = "ammo_bonus_fmj", category = "standard", box_size = 30 },
            { section = "ammo_bonus_hp", category = "special", box_size = 30 },
            { section = "ammo_bonus_ap", category = "armor_piercing", box_size = 30 }
        }
    }
    local function select(draw)
        return gamma_arena_random_generator.select_bonus_ammo(
            { next_int = function() return draw end },
            { pick = function(_, values) return values[#values] end },
            weapon
        )
    end
    gamma_arena_test_assert.equals(select(1).requested_category, "standard", "bonus category lower standard boundary")
    gamma_arena_test_assert.equals(select(60).requested_category, "standard", "bonus category upper standard boundary")
    gamma_arena_test_assert.equals(select(61).requested_category, "special", "bonus category lower special boundary")
    gamma_arena_test_assert.equals(select(75).requested_category, "special", "bonus category upper special boundary")
    gamma_arena_test_assert.equals(select(76).requested_category, "armor_piercing", "bonus category lower AP boundary")
    gamma_arena_test_assert.equals(select(100).requested_category, "armor_piercing", "bonus category upper AP boundary")
    gamma_arena_test_assert.equals(select(61).section, "ammo_bonus_hp", "available category selects a compatible variant")
    local fallback_weapon = { ammo = "ammo_bonus_fmj", ammo_variants = { weapon.ammo_variants[1] } }
    local fallback = gamma_arena_random_generator.select_bonus_ammo({ next_int = function() return 76 end }, { pick = function(_, values) return values[1] end }, fallback_weapon)
    gamma_arena_test_assert.equals(fallback.requested_category, "armor_piercing", "fallback preserves requested category")
    gamma_arena_test_assert.equals(fallback.resolved_category, "standard", "missing category resolves to standard")
    gamma_arena_test_assert.equals(fallback.section, "ammo_bonus_fmj", "missing category selects the base ammo")
    gamma_arena_test_assert.equals(fallback.boxes, 1, "bonus always grants one actor-only box")
end

local function player_ammo_scaling_policy_is_uncapped_and_prefix_stable()
    local rates = { w_pistol=40, w_smg=25, w_shotgun=25, w_rifle=20, w_sniper=10 }
    local representative_opponent_counts = { 1, 5, 20, 100 }
    for kind, threshold in pairs(rates) do
        for _, opponent_count in ipairs(representative_opponent_counts) do
            local all_fail = gamma_arena_random_generator.scaled_ammo_boxes(function()
                return { next_int=function() return threshold + 1 end }
            end, kind, opponent_count)
            gamma_arena_test_assert.is_true(all_fail.ok, kind .. " all-fail policy result")
            gamma_arena_test_assert.equals(all_fail.value, 1, kind .. " retains one guaranteed box at N=" .. opponent_count)
            local all_pass = gamma_arena_random_generator.scaled_ammo_boxes(function()
                return { next_int=function() return threshold end }
            end, kind, opponent_count)
            gamma_arena_test_assert.is_true(all_pass.ok, kind .. " all-pass policy result")
            gamma_arena_test_assert.equals(all_pass.value, opponent_count + 1, kind .. " has no policy ceiling at N=" .. opponent_count)
        end
    end

    local identity = { "skirmish", "master", 3735928559, 7, 6, 2 }
    local function prefix_run(opponent_count, draws, requested)
        return gamma_arena_random_generator.scaled_ammo_boxes(function(index)
            requested[#requested + 1] = index
            local rng = gamma_arena_rng.new(gamma_arena_rng.derive_seed({ identity[1], identity[2], identity[3], identity[4], identity[5], identity[6], "actor_scaled_ammo:" .. tostring(index) }))
            return { next_int=function(_, minimum, maximum)
                local draw = rng:next_int(minimum, maximum)
                draws[index] = draw
                return draw
            end }
        end, "w_pistol", opponent_count)
    end
    local short_draws, short_requested, long_draws, long_requested = {}, {}, {}, {}
    local short = prefix_run(5, short_draws, short_requested)
    local long = prefix_run(20, long_draws, long_requested)
    gamma_arena_test_assert.is_true(short.ok and long.ok, "short and long indexed scaling prefixes succeed")
    for index = 1, 5 do
        gamma_arena_test_assert.equals(short_requested[index], index, "short scaling requests stable logical opponent indices")
        gamma_arena_test_assert.equals(long_requested[index], index, "long scaling requests the same logical prefix")
        gamma_arena_test_assert.equals(short_draws[index], long_draws[index], "longer rosters preserve every indexed prefix draw")
    end
    local tail_successes = 0
    for index = 6, 20 do
        gamma_arena_test_assert.equals(long_requested[index], index, "long scaling requests each appended logical opponent")
        if long_draws[index] <= rates.w_pistol then tail_successes = tail_successes + 1 end
    end
    gamma_arena_test_assert.equals(long.value, short.value + tail_successes, "longer rosters append rolls without rerolling the prefix")

    local samples, opponents_per_sample = 256, 100
    for kind, threshold in pairs(rates) do
        local successes = 0
        for sample = 1, samples do
            local scaled = gamma_arena_random_generator.scaled_ammo_boxes(function(index)
                return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ "player_ammo_rate_sweep", kind, sample, index }))
            end, kind, opponents_per_sample)
            gamma_arena_test_assert.is_true(scaled.ok, kind .. " deterministic rate sweep result")
            successes = successes + scaled.value - 1
        end
        local observed_rate = successes / (samples * opponents_per_sample)
        gamma_arena_test_assert.is_true(math.abs(observed_rate - threshold / 100) <= 0.02, kind .. " observed rate remains within two percentage points")
    end
end

local function generated_actor_ammo_is_final_and_outside_budget()
    local snapshot = catalogs()
    for seed = 0, 255 do
        local session, fight_index = request(seed, "master"), seed % 32
        local generated = generate_fixture(session, fight_index, snapshot)
        gamma_arena_test_assert.is_true(generated.ok, "scaled actor ammo fixture generates")
        local spec = generated.value
        local normalized = request(gamma_arena_rng.normalize_uint32(seed), "master")
        local gear = gamma_arena_random_generator.player_loadout(normalized, fight_index, snapshot, snapshot.difficulties.master).value
        local weapon = item_by_section(snapshot.weapons, gear.weapon)
        local minimum_boxes = math.ceil(3 * weapon.magazine_size / weapon.ammo_variants[1].box_size)
        local scaled = gamma_arena_random_generator.scaled_ammo_boxes(function(index)
            return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ session.mode_id, session.difficulty_id,
                gamma_arena_rng.normalize_uint32(seed), fight_index, 6, spec.identity.layout_version, "actor_scaled_ammo:" .. tostring(index) }))
        end, weapon.kind, #spec.opponents)
        gamma_arena_test_assert.is_true(scaled.ok, "scaling recomputes from the generator request")
        local ammo = selected_item(spec.actor, snapshot, "ammo")
        gamma_arena_test_assert.equals(ammo.quantity, math.max(gear.ammo_boxes, minimum_boxes) + scaled.value + 1, "canonical ammo merges exact final boxes and one standard bonus")
        assert_actor_budget(session, fight_index, snapshot, spec)
        gamma_arena_test_assert.equals(spec.actor.loadout, nil, "canonical items erase private ammo provenance")
    end
end

local function player_ammo_scaling_is_stream_isolated()
    local original = gamma_arena_random_generator.scaled_ammo_boxes
    local snapshot, low, high = catalogs()
    local called, reason = pcall(function()
        gamma_arena_random_generator.scaled_ammo_boxes = function() return gamma_arena_result.ok(1) end
        low = generate_fixture(request(3735928559, "veteran"), 7, snapshot)
        gamma_arena_random_generator.scaled_ammo_boxes = function() return gamma_arena_result.ok(4) end
        high = generate_fixture(request(3735928559, "veteran"), 7, snapshot)
    end)
    gamma_arena_random_generator.scaled_ammo_boxes = original
    if not called then error(reason) end
    gamma_arena_test_assert.is_true(low.ok and high.ok, "controlled scaling-isolation fixtures generate")
    local low_ammo = selected_item(low.value.actor, snapshot, "ammo")
    local high_ammo = selected_item(high.value.actor, snapshot, "ammo")
    gamma_arena_test_assert.equals(high_ammo.quantity, low_ammo.quantity + 3, "only final actor ammo quantity changes")
    high_ammo.quantity = low_ammo.quantity
    high.value.identity.fight_id = low.value.identity.fight_id
    gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(low.value), gamma_arena_generator.stable_encode(high.value), "scaling preserves all other canonical content")
end

local function actor_bonus_ammo_is_deterministic_and_outside_budget()
    local snapshot = catalogs()
    local session, fight_index = request(3735928559, "veteran"), 7
    local first = generate_fixture(session, fight_index, snapshot)
    local second = generate_fixture(session, fight_index, snapshot)
    gamma_arena_test_assert.is_true(first.ok and second.ok, "bonus fixture generates")
    gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first.value), gamma_arena_generator.stable_encode(second.value), "same seed reproduces bonus physical items")
    local selector = gamma_arena_random_generator.select_bonus_ammo
    local without_bonus
    local called, reason = pcall(function()
        gamma_arena_random_generator.select_bonus_ammo = function(...)
            local bonus = selector(...)
            bonus.boxes = 2
            return bonus
        end
        without_bonus = generate_fixture(session, fight_index, snapshot)
    end)
    gamma_arena_random_generator.select_bonus_ammo = selector
    if not called then error(reason) end
    gamma_arena_test_assert.is_true(without_bonus.ok, "controlled bonus fixture generates")
    local base = selected_item(first.value.actor,snapshot,"ammo")
    local changed = selected_item(without_bonus.value.actor,snapshot,"ammo")
    gamma_arena_test_assert.equals(changed.quantity,base.quantity+1,"one additional bonus box changes exactly one physical box")
    changed.quantity = base.quantity
    without_bonus.value.identity.fight_id = first.value.identity.fight_id
    gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first.value),gamma_arena_generator.stable_encode(without_bonus.value),"bonus does not alter other content or opponent ammunition")
    assert_actor_budget(session, fight_index, snapshot, first.value)
end

local function add_bonus_variants(snapshot)
    for _, weapon in ipairs(snapshot.weapon_list) do
        local base = weapon.ammo_variants[1]
        weapon.ammo_variants = { base }
        for _, variant in ipairs({ { suffix="_hp", category="special" }, { suffix="_ap", category="armor_piercing" } }) do
            local section = weapon.ammo .. variant.suffix
            weapon.ammo_variants[#weapon.ammo_variants + 1] = { section=section, category=variant.category, box_size=base.box_size }
            if snapshot.items[section] == nil then
                local item = {}
                for key, value in pairs(snapshot.items[weapon.ammo]) do item[key] = value end
                item.section = section
                snapshot.items[section] = item
                snapshot.item_ids[#snapshot.item_ids + 1] = section
                snapshot.ammo[section] = { section=section, cost=snapshot.ammo[weapon.ammo].cost }
            end
            snapshot.items[weapon.section].ammo_sections[#snapshot.items[weapon.section].ammo_sections + 1] = section
        end
    end
    table.sort(snapshot.item_ids)
end

local function bonus_ammo_seed_sweep_and_stream_isolation()
    local enriched, base, seen = catalogs(), catalogs(), {}
    add_bonus_variants(enriched)
    for seed = 0, 1023 do
        local session, fight_index = request(seed,"rookie"), seed % 32
        local generated = generate_fixture(session,fight_index,enriched)
        gamma_arena_test_assert.is_true(generated.ok, "bonus category seed sweep generates")
        local weapon = item_by_section(enriched.weapon_list,selected_item(generated.value.actor,enriched,"weapon").section)
        local function tagged(tag)
            return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ session.mode_id,session.difficulty_id,
                gamma_arena_rng.normalize_uint32(seed),fight_index,6,generated.value.identity.layout_version,tag }))
        end
        local bonus_ammo = gamma_arena_random_generator.select_bonus_ammo(tagged("actor_bonus_ammo_category"),tagged("actor_bonus_ammo_section"),weapon)
        gamma_arena_test_assert.is_true(bonus_ammo.requested_category == "standard" or bonus_ammo.requested_category == "special"
            or bonus_ammo.requested_category == "armor_piercing", "selector requests a supported bonus category")
        seen[bonus_ammo.requested_category] = true
        gamma_arena_test_assert.equals(bonus_ammo.resolved_category,bonus_ammo.requested_category,"available bonus category never falls back")
        gamma_arena_test_assert.equals(bonus_ammo.boxes,1,"selector produces exactly one bonus box before canonical merging")
        local physical = item_by_section(generated.value.actor.items,bonus_ammo.section)
        gamma_arena_test_assert.is_true(physical ~= nil and physical.quantity >= 1,"selected bonus is materialized")
        if bonus_ammo.section ~= weapon.ammo then gamma_arena_test_assert.equals(physical.quantity,bonus_ammo.boxes,"nonstandard bonus preserves the selector's exact box quantity") end
        if seed < 128 then
            local baseline = generate_fixture(session,fight_index,base)
            gamma_arena_test_assert.is_true(baseline.ok,"baseline bonus isolation generates")
            gamma_arena_test_assert.equals(item_signature(baseline.value.actor,base,{ammo=true}),item_signature(generated.value.actor,enriched,{ammo=true}),"bonus variants cannot reroll actor gear or medicine")
            for index, opponent in ipairs(baseline.value.opponents) do
                gamma_arena_test_assert.equals(item_signature(opponent,base),item_signature(generated.value.opponents[index],enriched),"bonus variants cannot reroll opponents")
            end
        end
    end
    for _, category in ipairs({ "standard", "special", "armor_piercing" }) do gamma_arena_test_assert.is_true(seen[category],"every bonus category is reached") end
end

local function validator_rejects_invalid_bonus_ammo()
    local snapshot = catalogs()
    local mutations = {
        { code="GA_FIGHTSPEC_ITEM_UNKNOWN", fn=function(spec) selected_item(spec.actor,snapshot,"ammo").section="ammo_missing" end },
        { code="GA_FIGHTSPEC_ITEM_UNKNOWN", fn=function(spec) selected_item(spec.actor,snapshot,"ammo").section="ammo_bad" end },
        { code="GA_FIGHTSPEC_ITEM_INVALID", fn=function(spec) selected_item(spec.actor,snapshot,"ammo").quantity=0 end },
        { code="GA_FIGHTSPEC_INTEGRITY_INVALID", fn=function(spec) local ammo=selected_item(spec.actor,snapshot,"ammo"); ammo.quantity=ammo.quantity+1 end }
    }
    for _, mutation in ipairs(mutations) do
        local generated = generate_fixture(request(17,"rookie"),0,snapshot)
        gamma_arena_test_assert.is_true(generated.ok,"bonus forgery control generates")
        mutation.fn(generated.value)
        local rejected = validate_fixture(generated.value,snapshot)
        gamma_arena_test_assert.is_false(rejected.ok,"invalid physical bonus ammunition is rejected")
        gamma_arena_test_assert.equals(rejected.error.code,mutation.code,"bonus forgery reaches its physical invariant")
    end
    local generated = generate_fixture(request(17,"rookie"),0,snapshot).value
    local ammo = selected_item(generated.actor,snapshot,"ammo")
    snapshot.items[ammo.section].box_size=0
    local rejected=validate_fixture(generated,snapshot)
    gamma_arena_test_assert.equals(rejected.error.code,"GA_FIGHTSPEC_CATALOG_INVALID","physical ammo requires a positive catalog box size")
end

local function validator_rejects_forged_final_actor_ammo()
    local snapshot = catalogs()
    for _, actor in ipairs({ true, false }) do
        for _, delta in ipairs({ -1, 1 }) do
            local spec = generate_fixture(request(17,"master"),0,snapshot).value
            local participant = actor and spec.actor or spec.opponents[1]
            local ammo = selected_item(participant,snapshot,"ammo")
            ammo.quantity = ammo.quantity + delta
            local rejected = validate_fixture(spec,snapshot)
            gamma_arena_test_assert.is_false(rejected.ok,"forged actor or opponent ammunition is rejected")
            gamma_arena_test_assert.equals(rejected.error.code,ammo.quantity > 0 and "GA_FIGHTSPEC_INTEGRITY_INVALID" or "GA_FIGHTSPEC_ITEM_INVALID","ammo forgery reaches quantity or content integrity")
        end
    end
    for _, value in ipairs({ 0/0, math.huge, -1, 1.5, "2" }) do
        local spec = generate_fixture(request(17,"master"),0,snapshot).value
        selected_item(spec.actor,snapshot,"ammo").quantity=value
        gamma_arena_test_assert.equals(validate_fixture(spec,snapshot).error.code,"GA_FIGHTSPEC_ITEM_INVALID","final ammunition must be a bounded positive integer")
    end
end

local function finite_integer_guards()
    for _, value in ipairs({math.huge,-math.huge,0/0}) do
        gamma_arena_test_assert.is_false(gamma_arena_number.is_finite(value),"non-finite value must fail the shared guard")
        gamma_arena_test_assert.is_false(gamma_arena_number.is_integer(value),"non-finite value must not be an integer")
    end
    local snapshot = catalogs()
    for _, value in ipairs({math.huge,-math.huge,0/0}) do
        local bad_seed = generate_fixture(request(value,"rookie"),0,snapshot)
        gamma_arena_test_assert.equals(bad_seed.error.code,"GA_SESSION_SEED_INVALID","generator must reject non-finite seed")
        local bad_index = generate_fixture(request(1,"rookie"),value,snapshot)
        gamma_arena_test_assert.equals(bad_index.error.code,"GA_FIGHT_INDEX_INVALID","generator must reject non-finite fight index")
    end
end
local function generator_role_first_balance()
    local snapshot = catalogs()
    for _, difficulty_id in ipairs({ "rookie", "stalker", "veteran", "master" }) do
        local difficulty = snapshot.difficulties[difficulty_id]
        for seed = 0, 255 do
            local session = request(seed, difficulty_id)
            local generated = generate_fixture(session, seed % 16, snapshot)
            gamma_arena_test_assert.is_true(generated.ok, "role-first generation succeeds")
            local spec, primary, spent, seen = generated.value, 0, 0, {}
            gamma_arena_test_assert.is_true(#spec.opponents >= difficulty.enemy_min and #spec.opponents <= difficulty.enemy_max, "difficulty count envelope")
            local base, remainder = math.floor(difficulty.enemy_total_budget / #spec.opponents), difficulty.enemy_total_budget % #spec.opponents
            for index, opponent in ipairs(spec.opponents) do
                gamma_arena_test_assert.is_true(seen[opponent.spawn_slot_id] == nil, "physical slots are unique")
                seen[opponent.spawn_slot_id] = true
                gamma_arena_test_assert.equals(opponent.slot, index, "participant slots remain dense")
                if opponent.role ~= "secondary" then primary = primary + 1 end
                local profile = item_by_section(snapshot.profile_list, opponent.profile)
                local gear_cost = profile.cost
                for _, entry in ipairs(opponent.items) do
                    local definition = item_by_section(snapshot.weapon_list, entry.section)
                        or item_by_section(snapshot.outfit_list, entry.section) or item_by_section(snapshot.ammo, entry.section)
                    if definition then gear_cost = gear_cost + definition.cost * entry.quantity end
                end
                gamma_arena_test_assert.is_true(gear_cost <= base + (index <= remainder and 1 or 0) - 1, "gear fits deterministic slot allocation before team medicine")
                spent = spent + gear_cost + medical_cost(opponent, snapshot, false)
            end
            gamma_arena_test_assert.is_true(primary * 100 >= #spec.opponents * difficulty.primary_share_percent, "primary firearm share")
            gamma_arena_test_assert.is_true(spent <= difficulty.enemy_total_budget, "enemy total budget")
            assert_actor_budget(session, seed % 16, snapshot, spec)
        end
    end
end

local function generator_primary_pool_affordability_falls_back()
    local snapshot = catalogs()
    for _, profile in ipairs(snapshot.profile_list) do
        snapshot.weapon_pools_by_profile[profile.section] = {
            primary = { snapshot.weapons.ak74 },
            secondary = { snapshot.weapons.pm }
        }
    end
    local observed_ten = false
    for seed = 0, 1023 do
        local generated = generate_fixture(request(seed, "master"), seed % 16, snapshot)
        if generated.ok and #generated.value.opponents == 10 then observed_ten = true; break end
    end
    gamma_arena_test_assert.is_true(observed_ten, "unaffordable faction primary pool falls back to affordable global primary gear")
end

local function golden_fights_v9()
    local snapshot = catalogs()
    for _, expected in ipairs(gamma_arena_test_generator_fixtures.golden_fights()) do
        local session = request(expected.seed, expected.difficulty)
        local first = generate_fixture(session, expected.fight, snapshot)
        local second = generate_fixture(session, expected.fight, snapshot)
        gamma_arena_test_assert.is_true(first.ok and second.ok, "golden request must generate")
        local encoded = gamma_arena_generator.stable_encode(first.value)
        gamma_arena_test_assert.equals(encoded, expected.expected, "exact current-schema golden for seed " .. tostring(expected.seed))
        gamma_arena_test_assert.equals(encoded, gamma_arena_generator.stable_encode(second.value), "golden replay is byte-exact")
        gamma_arena_test_assert.is_true(validate_fixture(first.value,snapshot).ok,"exact golden passes strict validation")
    end
end

local function random_faction_selection_uses_only_nonempty_pools()
    local loaded = gamma_arena_catalog.load(fixture_factory({ system_sections = {} }))
    gamma_arena_test_assert.is_true(loaded.ok, "dynamic faction fixture loads")
    local snapshot = loaded.value
    local bandit, stalker = snapshot.profiles_by_faction.bandit, snapshot.profiles_by_faction.stalker
    gamma_arena_test_assert.is_true(type(bandit) == "table" and #bandit > 0 and type(stalker) == "table" and #stalker > 0, "two supported Random cohorts are available")
    snapshot.profiles_by_faction = { bandit = bandit, stalker = stalker }
    for seed = 0, 31 do
        snapshot.faction_ids = { "isg", "stalker", "army", "bandit" }
        local first = generate_fixture(request(seed, "rookie"), 0, snapshot)
        gamma_arena_test_assert.is_true(first.ok, "missing pools cannot enter the faction draw")
        gamma_arena_test_assert.equals(table.concat(snapshot.faction_ids, ","), "isg,stalker,army,bandit", "Random filtering does not mutate the shared Custom manifest")
        local cohort = first.value.opponents[1].faction
        gamma_arena_test_assert.is_true(cohort == "bandit" or cohort == "stalker", "only nonempty cohorts are selected")
        for _, opponent in ipairs(first.value.opponents) do
            gamma_arena_test_assert.equals(opponent.faction, cohort, "all opponents remain in the selected cohort")
        end
        snapshot.faction_ids = { "bandit", "army", "stalker", "isg" }
        local reordered = generate_fixture(request(seed, "rookie"), 0, snapshot)
        gamma_arena_test_assert.is_true(reordered.ok, "reordered shared manifest still generates")
        gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first.value), gamma_arena_generator.stable_encode(reordered.value), "faction enumeration order does not change the fight")
    end
    snapshot.profiles_by_faction.army = {}
    local empty = generate_fixture(request(0, "rookie"), 0, snapshot)
    gamma_arena_test_assert.is_false(empty.ok, "an explicitly empty profile pool remains malformed")
    gamma_arena_test_assert.equals(empty.error.code, "GA_RANDOM_CATALOG_INVALID", "empty array validation is not weakened by filtering")
    snapshot.profiles_by_faction = {}
    local rejected = generate_fixture(request(0, "rookie"), 0, snapshot)
    gamma_arena_test_assert.is_false(rejected.ok, "no Random cohort must not fall back to the mixed global pool")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_RANDOM_CATALOG_INVALID", "empty cohort selection fails at the Random catalog boundary")
end

local function random_draft_catalogs()
    return catalogs()
end

local function random_draft_accepts_unclassified_bonus_ammo()
    local snapshot = random_draft_catalogs()
    local weapon = snapshot.weapon_list[1]
    local extra = snapshot.weapon_list[2].ammo
    weapon.ammo_variants[#weapon.ammo_variants + 1] = {
        section = extra,
        category = nil,
        box_size = 30
    }
    local generated = gamma_arena_random_generator.build_draft(
        request(1, "stalker"), 0, snapshot, fixture_resolved_layout(snapshot))
    gamma_arena_test_assert.is_true(generated.ok,
        "Random accepts an optional ammo variant without a special category")
end

local function catalog_enumerates_effective_system_once_per_load()
    local enumerations = 0
    local factory = fixture_factory({
        system_sections = {
            wpn_dynamic_fixture = { kind="w_rifle", slot="2", ammo_mag_size="30", ammo_class="ammo_dynamic_fixture" },
            ammo_dynamic_fixture = { kind="w_ammo", box_size="30" },
            dynamic_fixture_outfit = { kind="o_medium", slot="6" }
        }
    })
    local enumerate = factory.enumerate_system_sections
    factory.enumerate_system_sections = function()
        enumerations = enumerations + 1
        return enumerate()
    end
    local loaded = gamma_arena_catalog.load(factory)
    gamma_arena_test_assert.is_true(loaded.ok, "memoized effective catalog fixture loads")
    gamma_arena_test_assert.equals(enumerations, 1,
        "one catalog load enumerates effective system sections once")
end

local function catalog_enumeration_failure_is_memoized()
    local enumerations = 0
    local factory = fixture_factory({ system_sections = {} })
    factory.enumerate_system_sections = function()
        enumerations = enumerations + 1
        error("fixture enumeration failure")
    end
    local loaded = gamma_arena_catalog.load(factory)
    gamma_arena_test_assert.is_true(loaded.ok, "optional discovery failure retains the validated explicit fallback catalog")
    gamma_arena_test_assert.equals(loaded.value.selection_mode, "combinations", "failed discovery never activates dynamic selection")
    gamma_arena_test_assert.equals(enumerations, 1,
        "one catalog load replays the first enumeration failure without retrying")
    factory.item_source.enumerate_system_sections = function() error("fixture physical enumeration failure") end
    local physical_failure = gamma_arena_catalog.load(factory)
    gamma_arena_test_assert.is_false(physical_failure.ok, "authoritative physical enumeration still fails closed")
    gamma_arena_test_assert.equals(physical_failure.error.code, "GA_ITEM_CATALOG_ENUMERATION_FAILED", "physical enumeration failure is not replaced by legacy fallback")
    gamma_arena_test_assert.equals(enumerations, 2, "each catalog load attempts optional discovery only once")
end

local function random_draft_semantics(seed, difficulty, fight_index, draft)
    local snapshot = catalogs()
    local parts = { "seed=" .. seed .. ",difficulty=" .. difficulty .. ",fight=" .. fight_index,
        "actor=" .. item_signature(draft.actor,snapshot) }
    for index, opponent in ipairs(draft.opponents) do
        parts[#parts+1] = index .. ":" .. opponent.faction .. "," .. opponent.profile .. ","
            .. item_signature(opponent,snapshot) .. "," .. opponent.spawn_slot_id .. "," .. opponent.tactical_route
    end
    return table.concat(parts,"|")
end

local function random_draft_pipeline_canonicalizes_and_strictly_validates()
    local snapshot = random_draft_catalogs()
    local layout = fixture_resolved_layout(snapshot)
    local session, fight_index = request(3735928559, "veteran"), 7
    local generated = gamma_arena_random_generator.build_draft(session, fight_index, snapshot, layout)
    gamma_arena_test_assert.is_true(generated.ok, "real random draft pipeline generates")
    gamma_arena_test_assert.equals(generated.value.actor.loadout.kind, "items", "draft uses the universal item tag")
    local canonical = canonical_draft(generated.value, session, fight_index, snapshot, layout)
    gamma_arena_test_assert.is_true(canonical.ok, "universal random draft canonicalizes")
    gamma_arena_test_assert.is_true(#canonical.value.actor.items > 0 and #canonical.value.opponents[1].items > 0, "random pipeline retains nonempty physical items")
    gamma_arena_test_assert.equals(canonical.value.opponents[1].profile, generated.value.opponents[1].profile, "canonical profile preserves authoritative alias")
    gamma_arena_test_assert.is_true(gamma_arena_fight_validator_v9.validate(canonical.value, snapshot, layout).ok, "canonical random draft passes strict v9 validation")
end

local function random_builder_skips_items_outside_universal_catalog()
    local snapshot = random_draft_catalogs()
    local missing = snapshot.outfit_list[1].section
    snapshot.items[missing] = nil
    for index, section in ipairs(snapshot.item_ids) do
        if section == missing then table.remove(snapshot.item_ids, index); break end
    end

    local layout = fixture_resolved_layout(snapshot)
    layout.capacity = #layout.opponent_spawn_slots
    local generated = gamma_arena_fight_builder.generate(
        request(3735928559, "veteran"), 7, snapshot, layout)

    gamma_arena_test_assert.is_true(generated.ok,
        "Random ignores legacy items outside the universal catalog")
    for _, item in ipairs(generated.value.actor.items) do
        gamma_arena_test_assert.is_true(snapshot.items[item.section] ~= nil,
            "actor item is universally cataloged")
        gamma_arena_test_assert.is_true(item.section ~= missing,
            "missing legacy outfit is never emitted")
    end
    for _, opponent in ipairs(generated.value.opponents) do
        for _, item in ipairs(opponent.items) do
            gamma_arena_test_assert.is_true(snapshot.items[item.section] ~= nil,
                "opponent item is universally cataloged")
        end
    end
end

local function random_builder_uses_effective_universal_weapon_slot()
    local legacy = { section = "wpn_mp5", slot = 1, cost = 4 }
    local effective = gamma_arena_random_generator.effective_weapon(legacy, {
        section = "wpn_mp5", category = "weapon", ltx_slot = 2
    })
    gamma_arena_test_assert.is_true(type(effective) == "table",
        "Random reconciles legacy weapon metadata with the effective universal catalog")
    gamma_arena_test_assert.equals(effective.slot, 2,
        "effective universal LTX slot owns Random equipment placement")
    gamma_arena_test_assert.equals(legacy.slot, 1,
        "slot reconciliation does not mutate the legacy catalog")
end

local function random_builder_rejects_incomplete_device_manifest()
    local snapshot = random_draft_catalogs()
    snapshot.device_list[4] = nil
    local layout = fixture_resolved_layout(snapshot)
    layout.capacity = #layout.opponent_spawn_slots
    local generated = gamma_arena_fight_builder.generate(
        request(3735928559, "veteran"), 7, snapshot, layout)
    gamma_arena_test_assert.is_false(generated.ok,
        "Random rejects an incomplete exact device manifest")
    gamma_arena_test_assert.equals(generated.error.code, "GA_RANDOM_CATALOG_INVALID",
        "incomplete device manifest fails at the Random catalog boundary")
end

local function random_catalog_diagnostics_identify_missing_physical_pool()
    local filled = function() return { { fixture = true } } end
    local catalog = {
        profile_list = filled(), weapon_list = filled(), primary_weapon_list = filled(),
        secondary_weapon_list = filled(), outfit_list = filled(), knife_list = {},
        actor_grenade_list = filled(), npc_grenade_list = filled(), medical_item_list = filled(),
        ammo = { ammo_fixture = {} }, consumables = { bandage = {} },
        medical_items = { medkit = {} }, selection_mode = "staged",
        difficulties = { stalker = {} }
    }
    gamma_arena_test_assert.is_true(type(gamma_arena_random_generator.catalog_failure_context) == "function",
        "Random catalog diagnostic API exists")
    local context = gamma_arena_random_generator.catalog_failure_context(catalog, "stalker")
    gamma_arena_test_assert.equals(context.requirement, "knife_list",
        "catalog failure identifies missing pool")
end

local function random_draft_malformed_inputs_are_total_results()
    local function malformed_route()
        local snapshot = random_draft_catalogs()
        local layout = fixture_resolved_layout(snapshot)
        layout.tactical_routes[1] = { invalid = true }
        return snapshot, layout
    end
    local route_catalog, route_layout = malformed_route()
    local valid_catalog = random_draft_catalogs()
    local malformed_profiles = random_draft_catalogs(); malformed_profiles.profile_list = "invalid"
    local cases = {
        { catalog = {}, layout = {}, code = "GA_RANDOM_CATALOG_INVALID" },
        { catalog = valid_catalog, layout = {}, code = "GA_RESOLVED_LAYOUT_INVALID" },
        { catalog = route_catalog, layout = route_layout, code = "GA_RESOLVED_LAYOUT_INVALID" },
        { catalog = malformed_profiles, layout = fixture_resolved_layout(malformed_profiles), code = "GA_RANDOM_CATALOG_INVALID" }
    }
    for _, case in ipairs(cases) do
        local called, result = pcall(function()
            return gamma_arena_random_generator.build_draft(request(1, "stalker"), 0, case.catalog, case.layout)
        end)
        gamma_arena_test_assert.is_true(called, "malformed random draft input never throws")
        gamma_arena_test_assert.is_true(type(result) == "table" and result.ok == false, "malformed random draft input returns failed Result")
        gamma_arena_test_assert.equals(result.error.code, case.code, "malformed random draft Result code")
    end
end

local function random_draft_nested_malformed_and_throwing_inputs_are_total_results()
    local malformed_cases = {
        {
            name = "nested difficulty field",
            mutate = function(snapshot) snapshot.difficulties.stalker.enemy_max = {} end
        },
        {
            name = "profile entry",
            mutate = function(snapshot) snapshot.profile_list[1] = "invalid-profile" end
        },
        {
            name = "loadout entry",
            mutate = function(snapshot)
                snapshot.selection_mode = "combinations"
                snapshot.combinations = { "invalid-loadout" }
            end
        },
        {
            name = "weapon entry",
            mutate = function(snapshot) snapshot.weapon_list[1] = "invalid-weapon" end
        }
    }
    for _, case in ipairs(malformed_cases) do
        local snapshot = random_draft_catalogs()
        local layout = fixture_resolved_layout(snapshot)
        case.mutate(snapshot)
        local called, result = pcall(function()
            return gamma_arena_random_generator.build_draft(request(1, "stalker"), 0, snapshot, layout)
        end)
        gamma_arena_test_assert.is_true(called, "nested malformed " .. case.name .. " never throws")
        gamma_arena_test_assert.is_true(type(result) == "table" and result.ok == false, "nested malformed " .. case.name .. " returns failed Result")
        gamma_arena_test_assert.equals(result.error.code, "GA_RANDOM_CATALOG_INVALID", "nested malformed " .. case.name .. " catalog code")
    end

    local snapshot = random_draft_catalogs()
    local layout = fixture_resolved_layout(snapshot)
    local generate_actor = gamma_arena_medical_generator.generate_actor
    gamma_arena_medical_generator.generate_actor = function() error({ private_payload = snapshot }) end
    local called, result = pcall(function()
        return gamma_arena_random_generator.build_draft(request(1, "stalker"), 0, snapshot, layout)
    end)
    gamma_arena_medical_generator.generate_actor = generate_actor
    gamma_arena_test_assert.is_true(called, "throwing medical dependency never escapes build_draft")
    gamma_arena_test_assert.is_true(type(result) == "table" and result.ok == false, "throwing medical dependency returns failed Result")
    gamma_arena_test_assert.equals(result.error.code, "GA_RANDOM_GENERATION_FAILED", "unexpected generation failure code")
    gamma_arena_test_assert.equals(result.error.message, "Random fight generation failed", "unexpected generation failure message is deterministic")
    gamma_arena_test_assert.equals(result.error.context.phase, "build_draft", "unexpected generation failure exposes only a bounded phase")
    local context_keys = 0
    for _ in pairs(result.error.context) do context_keys = context_keys + 1 end
    gamma_arena_test_assert.equals(context_keys, 1, "unexpected generation context cannot leak thrown values")
end

local function random_draft_malformed_dependency_results_are_normalized()
    local snapshot = random_draft_catalogs()
    local malformed_results = {
        { name = "incomplete failure", value = { ok = false, private_payload = snapshot } },
        { name = "malformed failure fields", value = { ok = false, error = { code = {}, message = 7, context = { private_payload = snapshot } } } },
        { name = "failure with extra payload", value = { ok = false, error = { code = "GA_INJECTED", message = "Injected failure", context = {} }, private_payload = snapshot } },
        { name = "success without draft", value = { ok = true, private_payload = snapshot } }
    }
    for _, case in ipairs(malformed_results) do
        local generate_actor = gamma_arena_medical_generator.generate_actor
        gamma_arena_medical_generator.generate_actor = function() return case.value end
        local called, result = pcall(function()
            return gamma_arena_random_generator.build_draft(request(1, "stalker"), 0, snapshot, fixture_resolved_layout(snapshot))
        end)
        gamma_arena_medical_generator.generate_actor = generate_actor
        gamma_arena_test_assert.is_true(called, "malformed dependency " .. case.name .. " never escapes build_draft")
        gamma_arena_test_assert.is_true(type(result) == "table" and result.ok == false, "malformed dependency " .. case.name .. " returns failed Result")
        gamma_arena_test_assert.equals(result.error.code, "GA_RANDOM_GENERATION_FAILED", "malformed dependency " .. case.name .. " uses generic code")
        gamma_arena_test_assert.equals(result.error.message, "Random fight generation failed", "malformed dependency " .. case.name .. " uses deterministic message")
        gamma_arena_test_assert.equals(result.error.context.phase, "build_draft", "malformed dependency " .. case.name .. " exposes bounded context")
        local context_keys = 0
        for _ in pairs(result.error.context) do context_keys = context_keys + 1 end
        gamma_arena_test_assert.equals(context_keys, 1, "malformed dependency " .. case.name .. " cannot leak payload fields")
    end
end

local function random_draft_matches_frozen_semantic_snapshot()
    local snapshot = random_draft_catalogs()
    local layout = fixture_resolved_layout(snapshot)
    for _, expected in ipairs(gamma_arena_test_generator_fixtures.golden_fights()) do
        local session = request(expected.seed,expected.difficulty)
        local draft = gamma_arena_random_generator.build_draft(session,expected.fight,snapshot,layout)
        gamma_arena_test_assert.is_true(draft.ok,"frozen draft request generates")
        local canonical = canonical_draft(draft.value,session,expected.fight,snapshot,layout)
        gamma_arena_test_assert.is_true(canonical.ok,"frozen universal draft canonicalizes")
        gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(canonical.value),expected.expected,"draft pipeline preserves exact frozen canonical semantics")
        for _, opponent in ipairs(draft.value.opponents) do
            local profile = snapshot.factions[opponent.faction].ranks[opponent.rank.id]
            gamma_arena_test_assert.is_true(opponent.rank.value >= profile.minimum and opponent.rank.value <= profile.maximum,"numeric rank stays inside authoritative intersection")
        end
    end
end

local function random_numeric_rank_stream_is_isolated()
    local baseline, shifted = random_draft_catalogs(), random_draft_catalogs()
    for rank_id, profile in pairs(shifted.factions.bandit.ranks) do
        profile.minimum = profile.minimum + 10000
        profile.maximum = profile.maximum + 10000
        shifted.ranks[rank_id].minimum = shifted.ranks[rank_id].minimum + 10000
        if shifted.ranks[rank_id].maximum ~= nil then
            shifted.ranks[rank_id].maximum = shifted.ranks[rank_id].maximum + 10000
        end
    end
    local session, fight_index = request(4294967295, "master"), 31
    local first = gamma_arena_random_generator.build_draft(session, fight_index, baseline, fixture_resolved_layout(baseline))
    local second = gamma_arena_random_generator.build_draft(session, fight_index, shifted, fixture_resolved_layout(shifted))
    gamma_arena_test_assert.is_true(first.ok and second.ok, "rank stream isolation drafts generate")
    gamma_arena_test_assert.equals(random_draft_semantics(4294967295, "master", fight_index, first.value), random_draft_semantics(4294967295, "master", fight_index, second.value), "rank bounds cannot reroll frozen random semantics")
    for index, opponent in ipairs(first.value.opponents) do
        gamma_arena_test_assert.equals(second.value.opponents[index].rank.value, opponent.rank.value + 10000, "isolated rank stream uses changed intersection without consuming legacy streams")
    end
end

