local function catalog_skips_optional_missing_medicine()
    local loaded = gamma_arena_catalog.load(fixture_factory({ mutate = function(_, _, _, game_sections)
        game_sections.rebirth = nil
    end }))
    gamma_arena_test_assert.is_true(loaded.ok, "missing optional medicine must not invalidate the catalog")
    gamma_arena_test_assert.is_true(loaded.value.medical_items.rebirth == nil, "missing optional medicine is excluded")
    gamma_arena_test_assert.equals(loaded.value.medical_skipped[1], "rebirth", "skipped medical sections are diagnostic data")
end

local function medical_scripted_rng(draw, pick_index)
    return {
        next_int = function(_, minimum, maximum)
            if draw == "maximum" then return maximum end
            if draw == "minimum" then return minimum end
            return math.max(minimum, math.min(maximum, draw or minimum))
        end,
        pick = function(_, values)
            local index = pick_index == "last" and #values or (pick_index or 1)
            return values[index]
        end
    }
end

local function actor_medical_generation_enforces_budget_and_healer()
    local snapshot = catalogs()
    local streams = {
        required_category = medical_scripted_rng("minimum"),
        required_section = medical_scripted_rng("minimum", 1),
        optional_category = { medical_scripted_rng("maximum"), medical_scripted_rng("minimum"), medical_scripted_rng("maximum") },
        optional_section = { medical_scripted_rng("minimum", 1), medical_scripted_rng("minimum", 1), medical_scripted_rng("minimum", 1) }
    }
    local generated = gamma_arena_medical_generator.generate_actor(snapshot, snapshot.difficulties.master, streams)
    gamma_arena_test_assert.is_true(generated.ok, "actor medical generation succeeds")
    gamma_arena_test_assert.equals(generated.value.sections[1], "bandage", "mandatory bandage remains first")
    gamma_arena_test_assert.is_true(generated.value.medical_cost <= snapshot.difficulties.master.player_medical_budget, "actor medical budget")
    local healing = false
    for _, section_name in ipairs(generated.value.sections) do
        local medical = snapshot.medical_items[section_name]
        if medical and (medical.category == "health" or medical.category == "rare") then healing = true end
    end
    gamma_arena_test_assert.is_true(healing, "actor receives a healing-capable item")
end

local function actor_medical_generation_reaches_master_rare()
    local snapshot = catalogs()
    local streams = {
        required_category = medical_scripted_rng("maximum"),
        required_section = medical_scripted_rng("minimum", 1),
        optional_category = {}, optional_section = {}
    }
    local generated = gamma_arena_medical_generator.generate_actor(snapshot, snapshot.difficulties.master, streams)
    gamma_arena_test_assert.is_true(generated.ok, "Master rare medical generation succeeds")
    gamma_arena_test_assert.equals(generated.value.sections[2], "rebirth", "Master required-healer draw can reach rebirth")
    gamma_arena_test_assert.equals(generated.value.medical_cost, 8, "bandage plus rebirth exactly spends Master medical budget")
end

local function enemy_medical_generation_spends_team_budget()
    local snapshot = catalogs()
    local opponents = {
        { role = "leader" }, { role = "primary" }, { role = "primary" },
        { role = "primary" }, { role = "primary" }, { role = "secondary" }, { role = "secondary" }
    }
    local streams = { mix = medical_scripted_rng("maximum"), recipients = {} }
    for _, section_name in ipairs({ "medkit", "bandage" }) do
        streams.recipients[section_name] = {}
        for index = 1, #opponents do streams.recipients[section_name][index] = medical_scripted_rng("minimum") end
    end
    local generated = gamma_arena_medical_generator.allocate_enemies(snapshot, opponents, streams)
    gamma_arena_test_assert.is_true(generated.ok, "enemy medical allocation succeeds")
    gamma_arena_test_assert.equals(generated.value.medkit_count, 2, "seven enemies cap medkits at ceil(N/4)")
    gamma_arena_test_assert.equals(generated.value.bandage_count, 3, "remaining team budget becomes bandages")
    gamma_arena_test_assert.equals(generated.value.medical_cost, #opponents, "enemy team medical cost exactly equals count")
    for _, allocation in ipairs(generated.value.allocations) do
        local seen = {}
        for _, section_name in ipairs(allocation.sections) do
            gamma_arena_test_assert.is_true(seen[section_name] == nil, "one NPC cannot receive a duplicate medical section")
            seen[section_name] = true
        end
    end
end

local function medical_generation_100000_fights()
    local snapshot = catalogs()
    local function rng(seed, tag) return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ "medical_sweep", seed, tag })) end
    for difficulty_index, difficulty_id in ipairs({ "rookie", "stalker", "veteran", "master" }) do
        local difficulty = snapshot.difficulties[difficulty_id]
        local seen = {}
        for seed = 0, 24999 do
            local streams = { required_category = rng(seed, difficulty_id .. ":required_category"), required_section = rng(seed, difficulty_id .. ":required_section"), optional_category = {}, optional_section = {} }
            for index = 1, 3 do
                streams.optional_category[index] = rng(seed, difficulty_id .. ":optional_category:" .. index)
                streams.optional_section[index] = rng(seed, difficulty_id .. ":optional_section:" .. index)
            end
            local actor = gamma_arena_medical_generator.generate_actor(snapshot, difficulty, streams)
            gamma_arena_test_assert.is_true(actor.ok, "100k actor medical generation succeeds")
            gamma_arena_test_assert.is_true(actor.value.medical_cost <= difficulty.player_medical_budget, "100k actor medical budget")
            gamma_arena_test_assert.equals(actor.value.sections[1], "bandage", "100k mandatory bandage ordering")
            seen[table.concat(actor.value.sections, ",")] = true

            local enemy_count = 2 + ((seed + difficulty_index) % 9)
            local opponents, enemy_streams = {}, { mix = rng(seed, difficulty_id .. ":mix"), recipients = { medkit = {}, bandage = {} } }
            for index = 1, enemy_count do
                opponents[index] = { role = index == 1 and "leader" or (index <= math.ceil(enemy_count * 0.7) and "primary" or "secondary") }
                enemy_streams.recipients.medkit[index] = rng(seed, difficulty_id .. ":medkit:" .. index)
                enemy_streams.recipients.bandage[index] = rng(seed, difficulty_id .. ":bandage:" .. index)
            end
            local enemies = gamma_arena_medical_generator.allocate_enemies(snapshot, opponents, enemy_streams)
            gamma_arena_test_assert.is_true(enemies.ok, "100k enemy medical allocation succeeds")
            gamma_arena_test_assert.equals(enemies.value.medical_cost, enemy_count, "100k enemy medical budget")
            gamma_arena_test_assert.is_true(enemies.value.medkit_count >= 1 and enemies.value.medkit_count <= math.ceil(enemy_count / 4), "100k enemy medkit cap")
        end
        local combination_count = 0; for _ in pairs(seen) do combination_count = combination_count + 1 end
        gamma_arena_test_assert.is_true(combination_count >= 2, "every difficulty produces varied medical combinations")
    end
end

local function fight_spec_v7_separates_gear_medical_and_grenades()
    local snapshot = catalogs()
    local generated = generate_fixture(request(37, "master"), 5, snapshot)
    gamma_arena_test_assert.is_true(generated.ok, "FightSpec v7 generation succeeds")
    gamma_arena_test_assert.equals(generated.value.schema_version, 7, "FightSpec schema advances to v7")
    local actor = generated.value.actor.loadout
    gamma_arena_test_assert.equals(actor.cost, actor.gear_cost + actor.medical_cost, "actor total decomposes exactly")
    gamma_arena_test_assert.is_true(actor.gear_cost <= snapshot.difficulties.master.player_gear_budget, "actor gear budget")
    gamma_arena_test_assert.is_true(actor.medical_cost <= snapshot.difficulties.master.player_medical_budget, "actor medical budget")
    local enemy_medical = 0
    for _, opponent in ipairs(generated.value.opponents) do
        gamma_arena_test_assert.equals(opponent.loadout.cost, opponent.loadout.gear_cost + opponent.loadout.medical_cost, "enemy total decomposes exactly")
        enemy_medical = enemy_medical + opponent.loadout.medical_cost
    end
    gamma_arena_test_assert.equals(enemy_medical, #generated.value.opponents, "enemy medical team budget equals count")
    gamma_arena_test_assert.is_true(validate_fixture(generated.value, snapshot).ok, "FightSpec v7 validates")
end

local function dense_array_length(values)
    if type(values) ~= "table" then return nil end
    local count, maximum = 0, 0
    for key in pairs(values) do
        if not gamma_arena_number.is_positive_integer(key) then return nil end
        count = count + 1
        maximum = math.max(maximum, key)
    end
    return count == maximum and count or nil
end

local function grenade_loadouts_are_deterministic_uncosted_and_prefix_stable()
    local snapshot = catalogs()
    local actor_pool = { grenade_f1=true, grenade_rgd5=true, ["grenade_gd-05"]=true }
    local npc_pool = { grenade_f1=true, grenade_rgd5=true, ["grenade_gd-05"]=true }
    for seed = 0, 511 do
        local first = generate_fixture(request(seed, "master"), seed % 32, snapshot)
        local second = generate_fixture(request(seed, "master"), seed % 32, snapshot)
        gamma_arena_test_assert.is_true(first.ok and second.ok, "grenade FightSpec seed sweep generates")
        gamma_arena_test_assert.equals(gamma_arena_generator.stable_encode(first.value), gamma_arena_generator.stable_encode(second.value), "grenade FightSpec generation is deterministic")
        local actor = first.value.actor.loadout
        local actor_count = dense_array_length(actor.grenades)
        gamma_arena_test_assert.is_true(actor_count ~= nil and actor_count <= 2, "actor grenade array is dense and capped")
        for _, section in ipairs(actor.grenades) do gamma_arena_test_assert.is_true(actor_pool[section] == true, "actor grenade comes from its pool") end
        gamma_arena_test_assert.equals(actor.cost, actor.gear_cost + actor.medical_cost, "actor grenades are outside all budgets")
        for _, opponent in ipairs(first.value.opponents) do
            local count = dense_array_length(opponent.loadout.grenades)
            gamma_arena_test_assert.is_true(count ~= nil and count <= 1, "opponent grenade array is dense and capped")
            for _, section in ipairs(opponent.loadout.grenades) do gamma_arena_test_assert.is_true(npc_pool[section] == true, "opponent grenade excludes smoke") end
            gamma_arena_test_assert.equals(opponent.loadout.cost, opponent.loadout.gear_cost + opponent.loadout.medical_cost, "opponent grenades are outside all budgets")
        end
        gamma_arena_test_assert.is_true(validate_fixture(first.value, snapshot).ok, "generated grenade arrays validate")
    end

    local identity = request(9137, "master")
    local function section_for(slot)
        local function tagged(tag)
            return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ identity.mode_id, identity.difficulty_id, identity.session_seed, 11, 6, snapshot.layouts[identity.layout_id].version, tag }))
        end
        return gamma_arena_grenade_generator.generate_enemy(snapshot, {
            presence = tagged("enemy_grenade_presence:" .. slot),
            section = tagged("enemy_grenade_section:" .. slot)
        }).value.sections[1] or ""
    end
    local short, extended = {}, {}
    for slot = 1, 3 do short[slot] = section_for(slot) end
    for slot = 1, 10 do extended[slot] = section_for(slot) end
    for slot = 1, 3 do gamma_arena_test_assert.equals(short[slot], extended[slot], "longer rosters preserve every indexed grenade prefix draw") end

    local immutable_spec = generate_fixture(request(701, "master"), 9, snapshot).value
    local validated = validate_fixture(immutable_spec, snapshot)
    gamma_arena_test_assert.is_true(validated.ok, "grenade immutable-copy fixture validates")
    local first_actor = validated.value.actor()
    local actor_count = #first_actor.loadout.grenades
    first_actor.loadout.grenades[actor_count + 1] = "grenade_f1"
    gamma_arena_test_assert.equals(#validated.value.actor().loadout.grenades, actor_count, "validated actor grenade array is an immutable copy")
    local first_opponents = validated.value.opponents()
    local opponent_count = #first_opponents[1].loadout.grenades
    first_opponents[1].loadout.grenades[opponent_count + 1] = "grenade_f1"
    gamma_arena_test_assert.equals(#validated.value.opponents()[1].loadout.grenades, opponent_count, "validated opponent grenade array is an immutable copy")
end

local function validator_rejects_forged_grenade_arrays()
    local snapshot = catalogs()
    local function generated(seed)
        local result = generate_fixture(request(seed, "master"), seed % 17, snapshot)
        gamma_arena_test_assert.is_true(result.ok, "grenade forgery fixture generates")
        return result.value
    end
    local function rejected(spec, mutate, message)
        mutate(spec)
        local result = validate_fixture(spec, snapshot)
        gamma_arena_test_assert.is_false(result.ok, message)
        gamma_arena_test_assert.equals(result.error.code, "GA_LOADOUT_GRENADE_INVALID", message .. " code")
    end
    rejected(generated(1), function(spec) spec.actor.loadout.grenades = nil end, "missing actor grenade array is rejected")
    rejected(generated(2), function(spec) spec.actor.loadout.grenades = { [2] = "grenade_f1" } end, "sparse actor grenade array is rejected")
    rejected(generated(3), function(spec) spec.actor.loadout.grenades = { "grenade_f1", "grenade_rgd5", "grenade_gd-05" } end, "actor third grenade is rejected")
    rejected(generated(4), function(spec) spec.opponents[1].loadout.grenades = { "grenade_f1", "grenade_rgd5" } end, "opponent second grenade is rejected")
    rejected(generated(5), function(spec) spec.opponents[1].loadout.grenades = { "grenade_smoke" } end, "opponent smoke grenade is rejected")
    rejected(generated(8), function(spec) spec.actor.loadout.grenades = { "grenade_smoke" } end, "actor smoke grenade is rejected")
    rejected(generated(6), function(spec)
        local grenades = spec.actor.loadout.grenades
        if #grenades == 0 then grenades[1] = "grenade_f1"
        else grenades[1] = grenades[1] == "grenade_f1" and "grenade_rgd5" or "grenade_f1" end
    end, "wrong deterministic actor grenade result is rejected")
    rejected(generated(7), function(spec)
        local grenades = spec.opponents[1].loadout.grenades
        if #grenades == 0 then grenades[1] = "grenade_f1" else spec.opponents[1].loadout.grenades = {} end
    end, "wrong deterministic opponent presence is rejected")
    local section_spec
    for seed = 8, 512 do
        local candidate = generated(seed)
        for _, opponent in ipairs(candidate.opponents) do
            if #opponent.loadout.grenades == 1 then section_spec = candidate; break end
        end
        if section_spec then break end
    end
    gamma_arena_test_assert.is_true(section_spec ~= nil, "seed sweep finds an opponent grenade")
    rejected(section_spec, function(spec)
        for _, opponent in ipairs(spec.opponents) do
            if #opponent.loadout.grenades == 1 then
                local current = opponent.loadout.grenades[1]
                opponent.loadout.grenades[1] = current == "grenade_f1" and "grenade_rgd5" or "grenade_f1"
                return
            end
        end
    end, "wrong deterministic opponent section is rejected")
end

local function medical_tuning_does_not_reroll_core_fight()
    local baseline, tuned = catalogs(), catalogs()
    tuned.difficulties.master.medical_weights = { bleed = 0, health = 100, boost = 0, rare = 0 }
    local first = generate_fixture(request(9137, "master"), 11, baseline)
    local second = generate_fixture(request(9137, "master"), 11, tuned)
    gamma_arena_test_assert.is_true(first.ok and second.ok, "medical tuning isolation fixtures generate")
    local left, right = first.value, second.value
    gamma_arena_test_assert.equals(#left.opponents, #right.opponents, "medical tuning cannot reroll enemy count")
    for _, key in ipairs({ "weapon", "ammo", "ammo_boxes", "outfit", "knife" }) do gamma_arena_test_assert.equals(left.actor.loadout[key], right.actor.loadout[key], "medical tuning cannot reroll actor " .. key) end
    gamma_arena_test_assert.equals(left.actor.loadout.bonus_ammo.section, right.actor.loadout.bonus_ammo.section, "medical tuning cannot reroll actor bonus ammo")
    for index, left_opponent in ipairs(left.opponents) do
        local right_opponent = right.opponents[index]
        gamma_arena_test_assert.equals(left_opponent.profile, right_opponent.profile, "medical tuning cannot reroll profile")
        gamma_arena_test_assert.equals(left_opponent.spawn_slot_id, right_opponent.spawn_slot_id, "medical tuning cannot reroll spawn")
        gamma_arena_test_assert.equals(left_opponent.tactical_route, right_opponent.tactical_route, "medical tuning cannot reroll route")
        for _, key in ipairs({ "weapon", "ammo", "ammo_boxes", "outfit", "knife", "gear_cost" }) do gamma_arena_test_assert.equals(left_opponent.loadout[key], right_opponent.loadout[key], "medical tuning cannot reroll enemy " .. key) end
    end
end

function run(run_case_fn)
    local all_passed = true
    local cases = {
        { name="catalog_enforces_max_count_viability", fn=catalog_enforces_max_count_viability },
        { name="catalog_exposes_approved_player_weight_rows", fn=catalog_exposes_approved_player_weight_rows },
        { name="catalog_normalizes_weapon_magazine_capacity", fn=catalog_normalizes_weapon_magazine_capacity },
        { name="grenade_catalog_and_probability_boundaries", fn=grenade_catalog_and_probability_boundaries },
        { name="device_catalog_and_probability_boundaries", fn=device_catalog_and_probability_boundaries },
        { name="device_generator_rejects_malformed_arguments", fn=device_generator_rejects_malformed_arguments },
        { name="device_catalog_rejects_effective_mismatch", fn=device_catalog_rejects_effective_mismatch },
        { name="grenade_generator_rejects_malformed_arguments", fn=grenade_generator_rejects_malformed_arguments },
        { name="catalog_exposes_medical_pool_and_budgets", fn=catalog_exposes_medical_pool_and_budgets },
        { name="catalog_skips_optional_missing_medicine", fn=catalog_skips_optional_missing_medicine },
        { name="actor_medical_generation_enforces_budget_and_healer", fn=actor_medical_generation_enforces_budget_and_healer },
        { name="actor_medical_generation_reaches_master_rare", fn=actor_medical_generation_reaches_master_rare },
        { name="enemy_medical_generation_spends_team_budget", fn=enemy_medical_generation_spends_team_budget },
        { name="medical_generation_100000_fights", fn=medical_generation_100000_fights },
        { name="fight_spec_v7_separates_gear_medical_and_grenades", fn=fight_spec_v7_separates_gear_medical_and_grenades },
        { name="grenade_loadouts_are_deterministic_uncosted_and_prefix_stable", fn=grenade_loadouts_are_deterministic_uncosted_and_prefix_stable },
        { name="validator_rejects_forged_grenade_arrays", fn=validator_rejects_forged_grenade_arrays },
        { name="medical_tuning_does_not_reroll_core_fight", fn=medical_tuning_does_not_reroll_core_fight },
        { name="catalog_augments_effective_system_without_cartesian_product", fn=catalog_augments_from_effective_system_without_cartesian_product },
        { name="actor_weapon_quarantine_is_exact_and_actor_only", fn=actor_weapon_quarantine_is_exact_and_actor_only },
        { name="catalog_rejects_malformed_data", fn=catalog_rejects_malformed_data },
        { name="validator_never_throws_for_malformed_specs", fn=validator_never_throws_for_malformed_specs },
        { name="validator_rejects_unknown_spawn_path", fn=validator_rejects_unknown_spawn_path },
        { name="validator_rejects_duplicate_spawn_path", fn=validator_rejects_duplicate_spawn_path },
        { name="validator_rejects_redistributed_slot_budget", fn=validator_rejects_redistributed_slot_budget },
        { name="weighted_player_class_pair_selection", fn=weighted_player_class_pair_selection },
        { name="player_class_pair_ignores_concrete_cardinality", fn=player_class_pair_ignores_concrete_cardinality },
        { name="generator_10000_seeds", fn=generator_10000_seeds },
        { name="master_player_class_diversity", fn=master_player_class_diversity },
        { name="master_powered_exo_rate_is_rare", fn=master_powered_exo_rate_is_rare },
        { name="generator_role_first_balance", fn=generator_role_first_balance },
        { name="generator_primary_pool_affordability_falls_back", fn=generator_primary_pool_affordability_falls_back },
        { name="stable_encode_v7", fn=stable_and_fight_index },
        { name="player_ammo_scaling_policy_is_uncapped_and_prefix_stable", fn=player_ammo_scaling_policy_is_uncapped_and_prefix_stable },
        { name="generated_actor_ammo_is_final_and_outside_budget", fn=generated_actor_ammo_is_final_and_outside_budget },
        { name="player_ammo_scaling_is_stream_isolated", fn=player_ammo_scaling_is_stream_isolated },
        { name="bonus_ammo_category_boundaries_and_fallback", fn=bonus_ammo_category_boundaries_and_fallback },
        { name="actor_bonus_ammo_is_deterministic_and_outside_budget", fn=actor_bonus_ammo_is_deterministic_and_outside_budget },
        { name="bonus_ammo_seed_sweep_and_stream_isolation", fn=bonus_ammo_seed_sweep_and_stream_isolation },
        { name="validator_rejects_invalid_bonus_ammo", fn=validator_rejects_invalid_bonus_ammo },
        { name="validator_rejects_forged_final_actor_ammo", fn=validator_rejects_forged_final_actor_ammo },
        { name="finite_integer_guards", fn=finite_integer_guards },
        { name="golden_fights_v7", fn=golden_fights_v7 }
    }
    for _, case in ipairs(cases) do if not run_case_fn(case.name, case.fn) then all_passed = false end end
    return all_passed
end
