local function weapon(section, slot, ammo)
    return {
        section = section,
        category = "weapon",
        equipped_slot = slot,
        selected_ammo = ammo
    }
end

local function fixture(options)
    options = options or {}
    local env = { storage = {}, fills = {}, capacity_reads = {} }
    local supported = options.supported or { rifle_a = true, pistol_b = true }
    local defaults = options.defaults or { rifle_a = "mag_a", pistol_b = "mag_b" }
    local capacities = options.capacities or { mag_a = 30, mag_b = 12 }
    local api = {
        is_supported_weapon = function(section) return supported[section] == true end,
        default_magazine = function(section) return defaults[section] end,
        read_magazine = function(id) return env.storage[id] end,
        is_carried = function() return options.carried ~= false end,
        fill_magazine = function(id, section, amount, ammo)
            env.fills[#env.fills + 1] = { id = id, section = section, amount = amount, ammo = ammo }
            local loaded = {}
            for index = 1, amount do
                loaded[index] = options.wrong_ammo and "ammo_wrong" or ammo
            end
            env.storage[id] = { section = section, loaded = loaded }
            return options.fill_result == nil and true or options.fill_result
        end
    }
    local adapter = gamma_arena_mags_redux.new({
        resolve_api = function()
            if options.absent then return nil end
            if options.partial then return { is_supported_weapon = api.is_supported_weapon } end
            return api
        end,
        magazine_capacity = function(section)
            env.capacity_reads[#env.capacity_reads + 1] = section
            return capacities[section]
        end
    })
    return env, adapter
end

local function absent_api_is_a_noop()
    local _, adapter = fixture({ absent = true })
    local result = adapter:bonus_descriptors({ weapon("rifle_a", "weapon_2", "ammo_a") })
    gamma_arena_test_assert.is_true(result.ok, "absent Mags Redux is compatible")
    gamma_arena_test_assert.equals(#result.value, 0, "absent Mags Redux plans no bonus items")
end

local function partial_api_fails_closed()
    local _, adapter = fixture({ partial = true })
    local result = adapter:bonus_descriptors({ weapon("rifle_a", "weapon_2", "ammo_a") })
    gamma_arena_test_assert.is_false(result.ok, "partial Mags Redux API fails closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_MAGS_REDUX_API_INVALID", "partial API has a stable error")
end

local function unsupported_weapon_is_skipped()
    local _, adapter = fixture({ supported = {} })
    local result = adapter:bonus_descriptors({ weapon("rifle_a", "weapon_2", "ammo_a") })
    gamma_arena_test_assert.is_true(result.ok, "unsupported weapon planning succeeds")
    gamma_arena_test_assert.equals(#result.value, 0, "unsupported weapon receives no magazines")
end

local function supported_weapons_receive_two_each()
    local _, adapter = fixture()
    local result = adapter:bonus_descriptors({
        weapon("rifle_a", "weapon_2", "ammo_a"),
        weapon("pistol_b", "weapon_1", "ammo_b")
    })
    gamma_arena_test_assert.is_true(result.ok, "supported weapon planning succeeds")
    gamma_arena_test_assert.equals(#result.value, 4, "two supported weapons receive four magazines")
    gamma_arena_test_assert.equals(result.value[1].section, "mag_a", "rifle default magazine is selected")
    gamma_arena_test_assert.equals(result.value[1].selected_ammo, "ammo_a", "rifle ammunition is retained")
    gamma_arena_test_assert.equals(result.value[2].reserve_ordinal, 2, "second rifle reserve ordinal is stable")
    gamma_arena_test_assert.equals(result.value[3].section, "mag_b", "pistol default magazine is selected")
    gamma_arena_test_assert.equals(result.value[4].magazine_capacity, 12, "pistol magazine capacity is retained")
end

local function initialization_verifies_loaded_content()
    local env, adapter = fixture()
    local planned = adapter:bonus_descriptors({ weapon("rifle_a", "weapon_2", "ammo_a") })
    local result = adapter:initialize(701, planned.value[1])
    gamma_arena_test_assert.is_true(result.ok, "new reserve magazine initializes")
    gamma_arena_test_assert.is_true(result.value.carried, "available pouch slot is reported")
    gamma_arena_test_assert.equals(#env.storage[701].loaded, 30, "reserve magazine is full")
    gamma_arena_test_assert.equals(env.storage[701].loaded[30], "ammo_a", "last loaded round is verified")
end

local function pouch_exhaustion_is_not_a_loadout_failure()
    local _, adapter = fixture({ carried = false })
    local planned = adapter:bonus_descriptors({ weapon("rifle_a", "weapon_2", "ammo_a") })
    local result = adapter:initialize(702, planned.value[1])
    gamma_arena_test_assert.is_true(result.ok, "full inventory magazine survives pouch exhaustion")
    gamma_arena_test_assert.is_false(result.value.carried, "pouch exhaustion is reported")
end

local function wrong_loaded_ammo_fails_verification()
    local _, adapter = fixture({ wrong_ammo = true })
    local planned = adapter:bonus_descriptors({ weapon("rifle_a", "weapon_2", "ammo_a") })
    local result = adapter:initialize(703, planned.value[1])
    gamma_arena_test_assert.is_false(result.ok, "wrong vendor ammunition fails verification")
    gamma_arena_test_assert.equals(result.error.code, "GA_MAGS_REDUX_VERIFY_FAILED", "wrong ammunition has a stable error")
end

local cases = {
    { name = "mags_redux_absent_api_is_a_noop", fn = absent_api_is_a_noop },
    { name = "mags_redux_partial_api_fails_closed", fn = partial_api_fails_closed },
    { name = "mags_redux_unsupported_weapon_is_skipped", fn = unsupported_weapon_is_skipped },
    { name = "mags_redux_supported_weapons_receive_two_each", fn = supported_weapons_receive_two_each },
    { name = "mags_redux_initialization_verifies_loaded_content", fn = initialization_verifies_loaded_content },
    { name = "mags_redux_pouch_exhaustion_is_not_a_loadout_failure", fn = pouch_exhaustion_is_not_a_loadout_failure },
    { name = "mags_redux_wrong_loaded_ammo_fails_verification", fn = wrong_loaded_ammo_fails_verification }
}

function run(run_case_fn)
    local all_passed = true
    for index = 1, #cases do
        local case = cases[index]
        if not run_case_fn(case.name, case.fn) then all_passed = false end
    end
    return all_passed
end
