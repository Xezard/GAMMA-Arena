    local applied = task6_drive_items_ready(items, items:apply(owner, {
        { section = 'device_torch_dummy', quantity = 1, equipped_slot = 'device' }
    }, catalog))
    gamma_arena_test_assert.is_true(applied.ok and applied.value.ready == true,
        'online-parent cleanup fixture reaches READY')
    local server_device = env.created[1]
    local runtime_device = runtime_items[server_device.runtime_id]
    gamma_arena_test_assert.is_true(runtime_device ~= server_device,
        'cleanup fixture separates ALife and online object identities')
    gamma_arena_test_assert.equals(runtime_device.torch_enabled, nil,
        'cleanup fixture leaves the issued torch untouched')
    server_device.parent_runtime_id = 65535
    env.lifecycle = {}
    local cleaned = items:cleanup()
    gamma_arena_test_assert.is_true(cleaned.ok and cleaned.value.pending == true,
        'online actor parent proves ownership when ALife parent changes')
    gamma_arena_test_assert.equals(env.shutdown_calls[1].item, runtime_device,
        'fallback proof preserves the exact online device for shutdown')
    gamma_arena_test_assert.equals(env.lifecycle[1], 'shutdown',
        'fallback-owned device shuts down before release')
    gamma_arena_test_assert.equals(#env.releases, 1,
        'fallback-owned transaction releases every issued item')
    gamma_arena_test_assert.is_true(items:cleanup().ok,
        'fallback-owned records retire after absence reprobe')
end

