function runtime_universal_actor_device_cleanup_runtime_parent_never_replaces_token()
    local owner = { id = function() return 77 end }
    local catalog = universal_catalog()
    catalog.items.device_torch_dummy = { category = 'device', ltx_slot = 9 }
    for _, replacement in ipairs({ false, 'ga_foreign_owner' }) do
        local env, ports = task11_production_item_ports()
        local items = gamma_arena_bootstrap.new_actor_item_port(ports)
        local applied = task6_drive_items_ready(items, items:apply(owner, {
            { section = 'device_torch_dummy', quantity = 1, equipped_slot = 'device' }
        }, catalog))
        gamma_arena_test_assert.is_true(applied.ok, 'token boundary fixture materializes')
        local device = env.created[1]
        local issued_token = env.tags[device.runtime_id]
        device.parent_runtime_id = 65535
        if replacement == false then env.tags[device.runtime_id] = nil
        else env.tags[device.runtime_id] = replacement end
        local cleaned = items:cleanup()
        gamma_arena_test_assert.is_true(cleaned.ok and cleaned.value == true,
            'runtime actor parent cannot authorize release after token drift, but cleanup continues')
        gamma_arena_test_assert.equals(#env.shutdown_calls, 1,
            'token drift uses one global-only device shutdown')
        gamma_arena_test_assert.equals(env.shutdown_calls[1].item, nil,
            'token drift never passes the mismatched object to shutdown')
        gamma_arena_test_assert.equals(env.shutdown_calls[1].id, nil,
            'token drift never passes the reused id to shutdown')
        gamma_arena_test_assert.equals(env.shutdown_calls[1].section, 'device_torch_dummy',
            'token drift retains only the issued device section for global NV shutdown')
        gamma_arena_test_assert.equals(#env.releases, 0,
            'token drift quarantines the record without releasing a current object')
        gamma_arena_test_assert.equals(#items:records_snapshot(), 0,
            'token drift retires the stale ownership record for actor inventory drain')
        gamma_arena_test_assert.is_true(issued_token ~= replacement,
            'fixture changes the issued ownership proof')
    end
end

