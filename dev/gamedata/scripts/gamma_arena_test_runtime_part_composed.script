function runtime_composed_actor_sets_and_verifies_real_weapon_ammo_type()
    local original_system_ini = rawget(gamma_arena_bootstrap, "system_ini")
    local called, reason = pcall(function()
        gamma_arena_bootstrap.system_ini = function()
            return {
                line_exist = function(_, section, key) return section == "rifle" and key == "ammo_mag_size" end,
                r_u32 = function(_, section, key)
                    if section ~= "rifle" or key ~= "ammo_mag_size" then error("unexpected effective metadata read") end
                    return 30
                end
            }
        end
        local owner = { id = function() return 77 end }
        local selected = {
            { section = "rifle", quantity = 1, equipped_slot = "weapon_2" },
            { section = "ammo_b", quantity = 1 }
        }
        local function composed_items(options)
            local env, item_ports = task11_production_item_ports(options)
            item_ports.fill_magazine = nil
            item_ports.magazine_ammo = nil
            local deps = fake_orchestrator_deps(fake_store())
            deps.actor = nil
            deps.actor_item_ports = item_ports
            local orchestrator = gamma_arena_bootstrap.compose(deps)
            orchestrator.session = {
                schema_version = 2,
                session_id = "ga_task11_custom_session",
                session_nonce = "ga_task11_custom_nonce",
                custom_config = { roster = { { rank = "novice" } }, actor_items = clone(selected) }
            }
            return env, orchestrator.deps.actor.deps.items
        end

        local env, items = composed_items()
        local applied = items:apply(owner, selected, universal_catalog())
        applied = task6_drive_items_ready(items, applied)
        gamma_arena_test_assert.is_true(applied.ok and applied.value.ready == true, 'production magazine path reaches READY through updates')
        gamma_arena_test_assert.is_true(applied.ok, "production magazine path accepts a selected non-first ammunition type")
        local weapon = env.created[1]
        gamma_arena_test_assert.equals(#weapon.ammo_type_sets, 1, "production magazine path invokes the real ammo-type setter once")
        gamma_arena_test_assert.equals(weapon.ammo_type_sets[1], 1, "second FightSpec ammo section maps to the engine's zero-based ammo type")
        gamma_arena_test_assert.equals(weapon:get_ammo_type(), 1, "production magazine path verifies the real ammo-type getter")
        gamma_arena_test_assert.equals(weapon:get_ammo_in_magazine(), 30, "production magazine path fills the real magazine after selecting ammo type")

        local mismatched_env, mismatched_items = composed_items({ ammo_type_mismatch = true })
        local mismatched = mismatched_items:apply(owner, selected, universal_catalog())
        mismatched = task6_drive_items_ready(mismatched_items, mismatched)
        gamma_arena_test_assert.is_false(mismatched.ok, "ammo-type setter/getter mismatch rejects materialization")
        gamma_arena_test_assert.equals(mismatched.error.code, "GA_ACTOR_ITEMS_AMMO_TYPE_VERIFY_FAILED", "ammo-type mismatch remains exact")
        gamma_arena_test_assert.equals(#mismatched_env.releases, #mismatched_env.created, "ammo-type mismatch rolls back every created entity")
    end)
    gamma_arena_bootstrap.system_ini = original_system_ini
    if not called then error(reason) end
end

function runtime_composed_actor_tag_failures_rollback_provisional_items_exactly()
    local owner = { id = function() return 77 end }
    local selected = { { section = "medkit", quantity = 3 } }
    local cases = {
        { name = "write", options = { fail_tag_write_at = 3 }, code = "GA_TEST_TAG_WRITE" },
        { name = "read", options = { fail_tag_read_at = 3 }, code = "GA_TEST_TAG_READ" },
        { name = "mismatch", options = { mismatch_tag_read_at = 3 }, code = "GA_ACTOR_ITEMS_TAG_VERIFY_FAILED" }
    }
    for _, case in ipairs(cases) do
        local env, item_ports = task11_production_item_ports(case.options)
        local deps = fake_orchestrator_deps(fake_store())
        deps.actor = nil
        deps.actor_item_ports = item_ports
        local orchestrator = gamma_arena_bootstrap.compose(deps)
        orchestrator.session = {
            schema_version = 2,
            session_id = "ga_task11_custom_session",
            session_nonce = "ga_task11_custom_nonce",
            custom_config = { roster = { { rank = "novice" } }, actor_items = clone(selected) }
        }
        local items = orchestrator.deps.actor.deps.items
        local failed = items:apply(owner, selected, universal_catalog())
        gamma_arena_test_assert.is_false(failed.ok, case.name .. " tag failure is surfaced")
        gamma_arena_test_assert.equals(failed.error.code, case.code, case.name .. " tag failure preserves the original cause after rollback")
        gamma_arena_test_assert.equals(#env.created, 3, case.name .. " failure occurs after the third physical item is created")
        gamma_arena_test_assert.equals(#env.releases, 3, case.name .. " failure releases every transaction-owned item")
        for index, id in ipairs(env.releases) do
            gamma_arena_test_assert.equals(id, env.created[#env.created - index + 1].runtime_id, case.name .. " rollback remains reverse creation order")
            local occurrences = 0
            for _, released_id in ipairs(env.releases) do if released_id == id then occurrences = occurrences + 1 end end
            gamma_arena_test_assert.equals(occurrences, 1, case.name .. " rollback releases each exact item once")
            gamma_arena_test_assert.equals(env.by_id[id], nil, case.name .. " rollback removes the released item")
        end
        gamma_arena_test_assert.is_true(items:cleanup().ok, case.name .. " cleanup retires absence-proven provisional records")
        gamma_arena_test_assert.is_true(items:cleanup().ok, case.name .. " cleanup remains idempotent")
        gamma_arena_test_assert.equals(#items.records_snapshot(), 0, case.name .. " registry is eventually empty")
    end
end

function runtime_composed_default_actor_materializes_universal_inventory_and_restores_template()
    local catalog = universal_catalog()
    catalog.items.grenade_f1 = { category = "grenade" }
    catalog.items.grenade_rgd5 = { category = "grenade" }
    local selected = universal_items()
    selected[#selected + 1] = { section = "grenade_f1", quantity = 1 }
    selected[#selected + 1] = { section = "grenade_rgd5", quantity = 1 }
    local owner = { id = function() return 77 end }
    local env, item_ports = task11_production_item_ports()
    local deps = fake_orchestrator_deps(fake_store())
    deps.actor = nil
    deps.actor_item_ports = item_ports
    local orchestrator = gamma_arena_bootstrap.compose(deps)
    orchestrator.session = {
        schema_version = 2,
        session_id = "ga_task11_custom_session",
        session_nonce = "ga_task11_custom_nonce",
        custom_config = { roster = { { rank = "novice" } }, actor_items = clone(selected) }
    }
    local items = orchestrator.deps.actor.deps.items
    gamma_arena_test_assert.equals(items.kind, "universal_materializer", "composed default actor exposes the production universal materializer")
    local applied = items:apply(owner, selected, catalog)
    gamma_arena_test_assert.is_true(applied.ok, "composed default actor materializes the universal inventory")
    local ready = task6_drive_items_ready(items, applied)
    gamma_arena_test_assert.is_true(ready.ok and ready.value.ready == true, "bounded universal materialization reports exact readiness")
    gamma_arena_test_assert.equals(#env.created, 14, "all equipped, carried, ammo, medicine, and grenade quantities become physical entities")
    local expected = "outfit|helmet|knife|pistol|rifle|carried|ammo_a|ammo_a|ammo_b|medkit|medkit|medkit|grenade_f1|grenade_rgd5"
    local created_sections = {}
    for index, entity in ipairs(env.created) do
        created_sections[index] = entity.section_value
        gamma_arena_test_assert.is_true(type(env.tags[entity.runtime_id]) == "string", "every physical actor entity has a durable ownership tag")
    end
    gamma_arena_test_assert.equals(table.concat(created_sections, "|"), expected, "production materializer preserves exact universal item order and quantities")
    gamma_arena_test_assert.equals(env.slots.outfit.section_value, "outfit", "outfit occupies its exact logical slot")
    gamma_arena_test_assert.equals(env.slots.helmet.section_value, "helmet", "helmet occupies its exact logical slot")
    gamma_arena_test_assert.equals(env.slots.knife.section_value, "knife", "knife occupies its exact logical slot")
    gamma_arena_test_assert.equals(env.slots.weapon_1.section_value, "pistol", "weapon_1 remains equipped")
    gamma_arena_test_assert.equals(env.slots.weapon_2.section_value, "rifle", "weapon_2 remains equipped")
    gamma_arena_test_assert.equals(env.active_slot, "weapon_2", "weapon_2 remains the active universal slot")
    gamma_arena_test_assert.equals(env.magazines[env.slots.weapon_1.runtime_id], "ammo_b", "weapon_1 retains its compatible selected ammo")
    gamma_arena_test_assert.equals(env.magazines[env.slots.weapon_2.runtime_id], "ammo_a", "weapon_2 retains its compatible selected ammo")

    local cleanup = items:cleanup()
    gamma_arena_test_assert.is_true(cleanup.ok and cleanup.value.pending == true, "victory cleanup submits every owned item release")
    gamma_arena_test_assert.is_true(items:cleanup().ok, "victory cleanup proves exact absence on the next poll")
    local restored = items:apply(owner, selected, catalog)
    gamma_arena_test_assert.is_true(restored.ok, "victory reset reapplies the immutable actor template")
    local restored_sections = {}
    for index = 15, #env.created do restored_sections[#restored_sections + 1] = env.created[index].section_value end
    gamma_arena_test_assert.equals(table.concat(restored_sections, "|"), expected, "post-victory physical inventory exactly matches the original template")

    local failed_env, failed_ports = task11_production_item_ports({ fail_slot = "weapon_2" })
    local failed_deps = fake_orchestrator_deps(fake_store())
    failed_deps.actor = nil
    failed_deps.actor_item_ports = failed_ports
    local failed_orchestrator = gamma_arena_bootstrap.compose(failed_deps)
    failed_orchestrator.session = orchestrator.session
    local failed_items = failed_orchestrator.deps.actor.deps.items
    gamma_arena_test_assert.equals(failed_items.kind, "universal_materializer", "rollback trace also uses the composed production materializer")
    local failed = task6_drive_items_ready(failed_items, failed_items:apply(owner, selected, catalog))
    gamma_arena_test_assert.is_false(failed.ok, "late universal equip failure is surfaced")
    gamma_arena_test_assert.equals(failed.error.code, "GA_TEST_UNIVERSAL_EQUIP", "rollback retains the original materializer failure")
    gamma_arena_test_assert.equals(#failed_env.releases, #failed_env.created, "rollback releases every created universal entity")
    for index, id in ipairs(failed_env.releases) do
        gamma_arena_test_assert.equals(id, failed_env.created[#failed_env.created - index + 1].runtime_id, "rollback releases universal entities in reverse creation order")
    end
end

function runtime_custom_defeat_opens_fresh_default_setup_without_loadout()
    local shown_model = nil
    local opened = 0
    local promoted = 0
    local config = task11_memory_config()
    local store = gamma_arena_session_store.new_store()
    local armed = store:arm_defeat(config, {
        schema_version = 1,
        session_id = "ga_custom_defeat",
        session_nonce = "ga_custom_nonce",
        mode_id = "skirmish",
        generation_recipe = "custom"
    }, { clock = function() return 1000 end, nonce = function() return "custom" end })
    gamma_arena_test_assert.is_true(armed.ok, "real Store arms a custom defeat")
    gamma_arena_test_assert.equals(armed.value.token, "gad1:1000:custom", "real Store uses the production defeat token grammar")
    gamma_arena_test_assert.is_true(store:confirm_defeat(config, armed.value.token, { clock = function() return 1001 end }).ok, "real Store confirms the custom defeat")
    local persisted = store:peek_defeat(config, { clock = function() return 1002 end })
    gamma_arena_test_assert.is_true(persisted.ok and type(persisted.value) == "table", "real Store exposes the confirmed custom defeat")
    gamma_arena_test_assert.equals(persisted.value.schema_version, 1, "persisted defeat remains production schema v1")
    gamma_arena_test_assert.equals(persisted.value.generation_recipe, "custom", "persisted defeat retains only the custom recipe")
    gamma_arena_test_assert.equals(persisted.value.difficulty_id, nil, "custom defeat persists no random difficulty")
    gamma_arena_test_assert.equals(persisted.value.custom_config, nil, "custom defeat persists no loadout")
    local menu = {
        HideDialog = function() end,
        ShowDialog = function() end,
        Show = function() end
    }
    local result = gamma_arena_main_menu.show_confirmed_defeat(menu, {
        config = config,
        peek_defeat = function()
            return store:peek_defeat(config, { clock = function() return 1002 end })
        end,
        show_result = function(model) shown_model = model; return gamma_arena_result.ok(true) end,
        clear_result = function() return gamma_arena_result.ok(true) end,
        consume_defeat = function(_, token)
            gamma_arena_test_assert.equals(token, "gad1:1000:custom", "custom defeat consumes its exact production token")
            return store:consume_defeat(config, token)
        end,
        open_custom_setup = function(owner, defeated)
            gamma_arena_test_assert.is_true(owner == menu, "fresh custom setup retains main-menu owner")
            gamma_arena_test_assert.equals(defeated.custom_config, nil, "defeated loadout is never handed to the fresh selector")
            opened = opened + 1
            return gamma_arena_result.ok(true)
        end,
        issue_launch_from_defeat = function() promoted = promoted + 1; return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_true(result.ok and shown_model ~= nil, "custom defeat result is shown")
    gamma_arena_test_assert.equals(shown_model.next_title_key, "st_gamma_arena_result_new_fight", "custom defeat retains the established new-fight action label")
    local next_result = shown_model.on_next()
    gamma_arena_test_assert.is_true(next_result.ok, "custom defeat opens a fresh selector")
    gamma_arena_test_assert.equals(store:peek_defeat(config, { clock = function() return 1003 end }).value, false, "custom defeat intent is consumed once")
    gamma_arena_test_assert.equals(opened, 1, "custom defeat opens one default custom setup")
    gamma_arena_test_assert.equals(promoted, 0, "custom defeat never auto-promotes the defeated loadout")
end
