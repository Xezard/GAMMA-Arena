function task11_distinct_runtime_device_ports(owner)
    local env, ports = task11_production_item_ports()
    local runtime_items = {}
    local resolve_item = ports.resolve_item
    ports.resolve_item = function(entity)
        if entity == nil then return nil end
        local id = entity.runtime_id
        if runtime_items[id] ~= nil then return runtime_items[id] end
        local server = resolve_item(entity)
        if server == nil then return nil end
        local item = {
            runtime_id = server.runtime_id,
            runtime_parent_object = owner,
            runtime_section_value = server.section_value
        }
        function item:id() return self.runtime_id end
        function item:parent() return self.runtime_parent_object end
        function item:section() return self.runtime_section_value end
        function item:set_condition(value) self.condition_value = value; return true end
        function item:condition() return self.condition_value end
        function item:enable_torch(value) self.torch_enabled = value; return true end
        runtime_items[id] = item
        return item
    end
    return env, ports, runtime_items
end

function runtime_universal_actor_device_cleanup_accepts_online_actor_parent_proof()
