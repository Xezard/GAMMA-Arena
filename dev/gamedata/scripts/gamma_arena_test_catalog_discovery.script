        },
        ammo_addon_fmj = { kind = "w_ammo", box_size = "30" },
        ammo_addon_hp = { kind = "w_ammo", box_size = "30" },
        ammo_addon_ap = { kind = "w_ammo", box_size = "30" },
        ammo_addon_hp_mag = { kind = "w_ammo", box_size = "30" },
        ammo_addon_bad = { kind = "w_ammo", box_size = "30" },
        ammo_addon_verybad = { kind = "w_ammo", box_size = "30" },
        ammo_addon_self = { kind = "w_ammo", box_size = "30" },
