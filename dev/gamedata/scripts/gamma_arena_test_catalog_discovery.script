local function discovers_powered_exo_separately_from_heavy()
    local sections = installed_sections()
    sections.heavy_fixture_outfit = { kind = "o_heavy", slot = "6", repair_type = "outfit_heavy" }
    sections.exo_fixture_outfit = { kind = "o_heavy", slot = "6", repair_type = "outfit_exo" }
    sections.stalker_proto_exo_outfit = { kind = "o_heavy", slot = "6" }
    local result = gamma_arena_catalog_discovery.discover(source(sections))
    gamma_arena_test_assert.is_true(result.ok, "armor-class discovery succeeds")
    gamma_arena_test_assert.equals(outfit_by_section(result.value.outfits, "heavy_fixture_outfit").armor_class, "heavy", "ordinary heavy stays heavy")
    gamma_arena_test_assert.equals(outfit_by_section(result.value.outfits, "exo_fixture_outfit").armor_class, "powered_exo", "repair_type outfit_exo wins")
    gamma_arena_test_assert.equals(outfit_by_section(result.value.outfits, "stalker_proto_exo_outfit").armor_class, "powered_exo", "installed Powered Exos proto rule wins without repair_type")
end

local function discovers_semantic_installed_gear()
    local result = gamma_arena_catalog_discovery.discover(source(installed_sections()))
    gamma_arena_test_assert.is_true(result.ok, "semantic discovery returns a Result")
    gamma_arena_test_assert.equals(result.value.mode, "dynamic", "available enumeration enables dynamic mode")
    gamma_arena_test_assert.equals(#result.value.weapons, 1, "only complete supported firearm is accepted")
    gamma_arena_test_assert.equals(result.value.weapons[1].section, "wpn_addon_rifle", "new firearm needs no Arena allowlist entry")
    gamma_arena_test_assert.equals(result.value.weapons[1].ammo, "ammo_addon_fmj", "first compatible valid ammo is deterministic")
    gamma_arena_test_assert.equals(result.value.weapons[1].cost, 5, "rifle cost is derived from semantic kind")
    gamma_arena_test_assert.equals(result.value.weapons[1].kind, "w_rifle", "weapon semantic kind is retained")
    gamma_arena_test_assert.equals(result.value.weapons[1].slot, 2, "weapon inventory slot is retained")
    gamma_arena_test_assert.equals(#result.value.ammo, 4, "every clean compatible ammo variant is materialized")
    gamma_arena_test_assert.equals(result.value.ammo[1].section, "ammo_addon_fmj", "selected ammo record is exact")
    gamma_arena_test_assert.equals(#result.value.outfits, 3, "all wearable outfit classes are discovered")
    gamma_arena_test_assert.equals(result.value.outfits[1].section, "addon_medium_outfit", "new outfit needs no Arena allowlist entry")
    gamma_arena_test_assert.equals(#result.value.knives, 1, "usable knife family is discovered")
    gamma_arena_test_assert.equals(result.value.knives[1].section, "wpn_knife_addon", "knife section is exact")
    gamma_arena_test_assert.is_true(result.value.skipped >= 3, "unsafe firearm-shaped sections are skipped individually")
end

local function catalog_discovery_filters_weapon_variants_by_parent_attachment_compatibility()
    local function firearm(kind, slot, parent, scopes)
        return {
            kind = kind,
            slot = tostring(slot),
            ammo_mag_size = "30",
            ammo_class = "ammo_variant_fixture",
            parent_section = parent,
            scopes = scopes
        }
    end
    local sections = {
        ammo_variant_fixture = { kind = "w_ammo", box_size = "30" },
        ammo_rejected_fixture = { kind = "w_ammo", box_size = "30" },
        wpn_family_alpha = firearm("w_rifle", 2, "wpn_family_alpha", "optic_shared, optic_alpha"),
        wpn_family_alpha_optic_shared = firearm("w_rifle", 2, "wpn_family_alpha"),
        wpn_family_alpha_optic_orphan = firearm("w_rifle", 2, "wpn_family_alpha"),
        wpn_family_alpha_alias = firearm("w_rifle", 2, "wpn_family_alpha"),
        wpn_family_beta = firearm("w_smg", 1, "wpn_family_beta", "optic_beta"),
        wpn_family_beta_optic_beta = firearm("w_smg", 1, "wpn_family_beta"),
        wpn_family_beta_optic_shared = firearm("w_smg", 1, "wpn_family_beta"),
        wpn_unknown_optic_shared = firearm("w_rifle", 2, "wpn_missing"),
        wpn_legacy_standalone = firearm("w_shotgun", 2)
    }
    sections.wpn_unknown_optic_shared.ammo_class = "ammo_rejected_fixture"
    local result = gamma_arena_catalog_discovery.discover(source(sections))
    gamma_arena_test_assert.is_true(result.ok, "weapon compatibility discovery succeeds")
    gamma_arena_test_assert.equals(#result.value.weapons, 5, "only standalone and compatible weapon variants survive")
    for _, section in ipairs({
        "wpn_family_alpha", "wpn_family_alpha_optic_shared",
        "wpn_family_beta", "wpn_family_beta_optic_beta", "wpn_legacy_standalone"
    }) do
        gamma_arena_test_assert.is_true(record_by_section(result.value.weapons, section) ~= nil, section .. " remains eligible")
    end
    for _, section in ipairs({
        "wpn_family_alpha_optic_orphan", "wpn_family_alpha_alias",
        "wpn_family_beta_optic_shared", "wpn_unknown_optic_shared"
    }) do
        gamma_arena_test_assert.equals(record_by_section(result.value.weapons, section), nil, section .. " is rejected")
        gamma_arena_test_assert.equals(string.find(table.concat(result.value.fingerprint_parts, "|"), section, 1, true), nil, section .. " is absent from fingerprint")
    end
    gamma_arena_test_assert.equals(record_by_section(result.value.ammo, "ammo_rejected_fixture"), nil, "rejected child contributes no ammunition")
    gamma_arena_test_assert.equals(string.find(table.concat(result.value.fingerprint_parts, "|"), "ammo_rejected_fixture", 1, true), nil, "rejected child ammunition is absent from fingerprint")
    gamma_arena_test_assert.equals(result.value.skipped, 4, "every incompatible child is counted as skipped")
end

local function catalog_discovery_parent_metadata_failures_are_fail_closed()
    local sections = {
        ammo_guard_fixture = { kind = "w_ammo", box_size = "30" },
        wpn_guard_parent = {
            kind = "w_rifle", slot = "2", ammo_mag_size = "30", ammo_class = "ammo_guard_fixture",
            parent_section = "wpn_guard_parent", scopes = "optic_guard"
        },
        wpn_guard_parent_optic_guard = {
            kind = "w_rifle", slot = "2", ammo_mag_size = "30", ammo_class = "ammo_guard_fixture",
            parent_section = "wpn_guard_parent"
        }
    }
    local child_failure = gamma_arena_catalog_discovery.discover(source(sections, nil, false, nil, {
        ["wpn_guard_parent_optic_guard:parent_section"] = true
    }))
    gamma_arena_test_assert.is_true(child_failure.ok, "child parent metadata failure remains controlled")
    gamma_arena_test_assert.is_true(record_by_section(child_failure.value.weapons, "wpn_guard_parent") ~= nil, "readable standalone parent remains eligible")
    gamma_arena_test_assert.equals(record_by_section(child_failure.value.weapons, "wpn_guard_parent_optic_guard"), nil, "unreadable child parent metadata fails closed")
    gamma_arena_test_assert.equals(child_failure.value.skipped, 1, "unreadable child is counted as skipped")

    local parent_failure = gamma_arena_catalog_discovery.discover(source(sections, { "wpn_guard_parent_optic_guard" }, false, nil, {
        ["wpn_guard_parent:parent_section"] = true
    }))
    gamma_arena_test_assert.is_true(parent_failure.ok, "parent ancestry metadata failure remains controlled")
    gamma_arena_test_assert.equals(#parent_failure.value.weapons, 0, "unreadable parent ancestry rejects its child")
    gamma_arena_test_assert.equals(parent_failure.value.skipped, 1, "child of unreadable parent is counted as skipped")
end

local function catalog_discovery_retains_clean_compatible_ammo_variants()
    local result = gamma_arena_catalog_discovery.discover(source(installed_sections()))
    local variants = result.value.weapons[1].ammo_variants
    gamma_arena_test_assert.equals(#variants, 4, "clean compatible variants survive while low-condition variants are rejected")
    gamma_arena_test_assert.equals(variants[1].section, "ammo_addon_fmj", "base variant preserves declared order")
    gamma_arena_test_assert.equals(variants[4].section, "ammo_addon_hp_mag", "clean hp_mag variant survives")
end

local function catalog_discovery_classifies_bonus_ammo_categories()
    local result = gamma_arena_catalog_discovery.discover(source(installed_sections()))
    local variants = result.value.weapons[1].ammo_variants
    gamma_arena_test_assert.equals(variants[1].category, "standard", "first clean base is standard")
    gamma_arena_test_assert.equals(variants[2].category, "special", "hp is special")
    gamma_arena_test_assert.equals(variants[3].category, "armor_piercing", "ap is armor piercing")
    gamma_arena_test_assert.equals(variants[4].category, "special", "hp_mag is special")
end

local function catalog_discovery_classifies_all_bonus_suffixes()
    local sections = installed_sections()
    sections.wpn_suffix_fixture = {
        kind = "w_shotgun", slot = "2", ammo_mag_size = "8",
        ammo_class = "ammo_suffix_base,ammo_suffix_pbp,ammo_suffix_pmm,ammo_suffix_zhekan,ammo_suffix_hydro,ammo_suffix_ep,ammo_suffix_ss190,ammo_suffix_dart,ammo_suffix_unknown"
    }
    for _, name in ipairs({ "base", "pbp", "pmm", "zhekan", "hydro", "ep", "ss190", "dart", "unknown" }) do
        sections["ammo_suffix_" .. name] = { kind = "w_ammo", box_size = "16" }
    end
    local result = gamma_arena_catalog_discovery.discover(source(sections))
    gamma_arena_test_assert.is_true(result.ok, "suffix fixture discovers safely")
    local variants = result.value.weapons[2].ammo_variants
    gamma_arena_test_assert.equals(variants[1].category, "standard", "first clean base record is standard")
    for _, index in ipairs({ 2, 3, 4, 5, 6, 7 }) do gamma_arena_test_assert.equals(variants[index].category, "special", "documented special suffix is classified") end
    gamma_arena_test_assert.equals(variants[8].category, "armor_piercing", "dart suffix is armor-piercing")
    gamma_arena_test_assert.equals(variants[9].category, nil, "unknown clean suffix stays unclassified")
end

local function catalog_discovery_skips_invalid_variants_and_fingerprints_metadata()
    local sections = installed_sections()
    local first = gamma_arena_catalog_discovery.discover(source(sections))
    sections.wpn_addon_rifle.ammo_class = "ammo_addon_fmj,ammo_addon_ap,ammo_addon_hp,ammo_addon_hp_mag"
    local reordered = gamma_arena_catalog_discovery.discover(source(sections))
    sections.ammo_addon_ap.box_size = "31"
    local resized = gamma_arena_catalog_discovery.discover(source(sections))
    gamma_arena_test_assert.is_true(first.ok and reordered.ok and resized.ok, "invalid variants are rejected without rejecting their weapon")
    gamma_arena_test_assert.equals(#first.value.weapons[1].ammo_variants, 4, "missing, non-ammo, zero-box, duplicate, and low-condition entries never survive")
    gamma_arena_test_assert.is_true(table.concat(first.value.fingerprint_parts, "|") ~= table.concat(reordered.value.fingerprint_parts, "|"), "variant order changes the fingerprint")
    gamma_arena_test_assert.is_true(table.concat(reordered.value.fingerprint_parts, "|") ~= table.concat(resized.value.fingerprint_parts, "|"), "variant box size changes the fingerprint")
    gamma_arena_test_assert.is_true(string.find(table.concat(first.value.fingerprint_parts, "|"), "ammo_variant:wpn_addon_rifle:ammo_addon_hp:special:30", 1, true) ~= nil, "variant category metadata is part of the fingerprint")
end

local function discovery_order_is_stable()
    local sections = installed_sections()
    sections.wpn_second_rifle = {
        kind = "w_rifle",
        slot = "2",
        ammo_mag_size = "20",
        ammo_class = "ammo_addon_ap"
    }
    local forward = {
        "wpn_second_rifle", "ammo_addon_ap", "wpn_addon_rifle", "ammo_addon_fmj",
        "addon_medium_outfit", "wpn_knife_addon", "wpn_launcher_fixture", "ammo_rocket",
        "wpn_incomplete_fixture", "wpn_wrong_slot_fixture", "addon_helmet_fixture"
    }
    local reverse = {}
    for index = #forward, 1, -1 do reverse[#reverse + 1] = forward[index] end
    local first = gamma_arena_catalog_discovery.discover(source(sections, forward))
    local second = gamma_arena_catalog_discovery.discover(source(sections, reverse))
    gamma_arena_test_assert.is_true(first.ok and second.ok, "both enumeration orders discover safely")
    gamma_arena_test_assert.equals(first.value.weapons[1].section, second.value.weapons[1].section, "weapon order is normalized")
    gamma_arena_test_assert.equals(first.value.weapons[2].section, second.value.weapons[2].section, "all weapon order is normalized")
    gamma_arena_test_assert.equals(table.concat(first.value.fingerprint_parts, "|"), table.concat(second.value.fingerprint_parts, "|"), "fingerprint input ignores engine enumeration order")
end

local function enumeration_failure_falls_back()
    local result = gamma_arena_catalog_discovery.discover(source({}, nil, true))
    gamma_arena_test_assert.is_true(result.ok, "third-party enumeration failure stays controlled")
    gamma_arena_test_assert.equals(result.value.mode, "fallback", "enumeration failure preserves known-good fallback mode")
    gamma_arena_test_assert.equals(#result.value.weapons, 0, "fallback discovery contributes no unverified weapons")
    gamma_arena_test_assert.equals(result.value.fingerprint_parts[1], "fallback", "fallback fingerprint is explicit")
end

local cases = {
    { name = "catalog_discovery_accepts_semantic_installed_gear", fn = discovers_semantic_installed_gear },
    { name = "catalog_discovery_powered_exo_is_separate_from_heavy", fn = discovers_powered_exo_separately_from_heavy },
    { name = "catalog_discovery_prefilters_irrelevant_system_sections", fn = discovery_prefilters_irrelevant_system_sections },
    { name = "catalog_discovery_filters_weapon_variants_by_parent_attachment_compatibility", fn = catalog_discovery_filters_weapon_variants_by_parent_attachment_compatibility },
    { name = "catalog_discovery_parent_metadata_failures_are_fail_closed", fn = catalog_discovery_parent_metadata_failures_are_fail_closed },
    { name = "catalog_discovery_is_order_stable", fn = discovery_order_is_stable },
    { name = "catalog_discovery_enumeration_failure_falls_back", fn = enumeration_failure_falls_back },
    { name = "catalog_discovery_retains_clean_compatible_ammo_variants", fn = catalog_discovery_retains_clean_compatible_ammo_variants },
    { name = "catalog_discovery_classifies_bonus_ammo_categories", fn = catalog_discovery_classifies_bonus_ammo_categories },
    { name = "catalog_discovery_classifies_all_bonus_suffixes", fn = catalog_discovery_classifies_all_bonus_suffixes },
    { name = "catalog_discovery_skips_invalid_variants_and_fingerprints_metadata", fn = catalog_discovery_skips_invalid_variants_and_fingerprints_metadata }
}

function run(run_case_fn)
    local all_passed = true
    for _, case in ipairs(cases) do
        if not run_case_fn(case.name, case.fn) then all_passed = false end
    end
    return all_passed
end
