function runtime_actor_normalization_does_not_query_legacy_boundary()
    for _, inside in ipairs({ true, false }) do
        local env, adapter = fake_actor_adapter_env()
        env.boundary_inside = inside
        local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
        gamma_arena_test_assert.is_true(result.ok, "normalization uses resolved ingress regardless of legacy boundary state")
        gamma_arena_test_assert.equals(env.actor.position_value.x, 1, "normalization positions actor at the resolved ingress")
        gamma_arena_test_assert.equals(env.boundary_checks, 0, "normalization never queries the removed boundary port")
    end
end
