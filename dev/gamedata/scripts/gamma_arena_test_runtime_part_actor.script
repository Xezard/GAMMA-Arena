    gamma_arena_test_assert.equals(env.release_requests[13], 1, "newly surfaced item is submitted once")
    env:advance(1)
    adapter:begin_update()
    gamma_arena_test_assert.is_false(adapter:verify_inventory_empty().value, "unchanged submitted items remain pending")
    gamma_arena_test_assert.equals(env.release_requests[13], 1, "later polls never duplicate new-item submission")

    env:add_item(99)
