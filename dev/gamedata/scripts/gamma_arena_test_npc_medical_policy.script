local function fake_ini(values, options)
    local settings = values or {}
    local behavior = options or {}
    return {
        line_exist = function(_, section, key)
            if behavior.throw_line_exist then error("line_exist failed") end
            return section == "plugin" and settings[key] ~= nil
        end,
        r_string_ex = function(_, section, key)
            if behavior.throw_read then error("r_string_ex failed") end
            if section ~= "plugin" then return nil end
            return settings[key]
        end
    }
end

local cases = {
    { name = "missing_keys", values = {}, owner = "arena", enable = false, in_combat = false },
    { name = "enable_true", values = { enable = "TrUe", in_combat = "true", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "enable_on", values = { enable = "ON", in_combat = "true", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "enable_yes", values = { enable = "YeS", in_combat = "true", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "enable_one", values = { enable = "1", in_combat = "true", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
