    { name = "enable_off", values = { enable = "OFF", in_combat = "true", medkits = "medkit" }, owner = "arena", enable = false, in_combat = true, medkit_overlap = true },
    { name = "enable_no", values = { enable = "nO", in_combat = "true", medkits = "medkit" }, owner = "arena", enable = false, in_combat = true, medkit_overlap = true },
    { name = "enable_zero", values = { enable = "0", in_combat = "true", medkits = "medkit" }, owner = "arena", enable = false, in_combat = true, medkit_overlap = true },
    { name = "in_combat_true", values = { enable = "true", in_combat = "TrUe", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "in_combat_on", values = { enable = "true", in_combat = "ON", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "in_combat_yes", values = { enable = "true", in_combat = "YeS", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "in_combat_one", values = { enable = "true", in_combat = "1", medkits = "medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "in_combat_false", values = { enable = "true", in_combat = "FaLsE", medkits = "medkit" }, owner = "arena", enable = true, in_combat = false, medkit_overlap = true },
    { name = "in_combat_off", values = { enable = "true", in_combat = "OFF", medkits = "medkit" }, owner = "arena", enable = true, in_combat = false, medkit_overlap = true },
    { name = "in_combat_no", values = { enable = "true", in_combat = "nO", medkits = "medkit" }, owner = "arena", enable = true, in_combat = false, medkit_overlap = true },
    { name = "in_combat_zero", values = { enable = "true", in_combat = "0", medkits = "medkit" }, owner = "arena", enable = true, in_combat = false, medkit_overlap = true },
    { name = "non_overlap", values = { enable = "true", in_combat = "true", medkits = "medkit_army", bandages = "bandage_old" }, owner = "arena", enable = true, in_combat = true },
    { name = "medkit_overlap", values = { enable = "yes", in_combat = "1", medkits = "medkit_army, medkit" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true },
    { name = "bandage_overlap", values = { enable = "on", in_combat = "true", bandages = "bandage" }, owner = "external", enable = true, in_combat = true, bandage_overlap = true },
    { name = "both_overlaps", values = { enable = "TRUE", in_combat = "YES", medkits = "medkit", bandages = "bandage" }, owner = "external", enable = true, in_combat = true, medkit_overlap = true, bandage_overlap = true },
    { name = "whitespace_empty_tokens", values = { enable = " true ", in_combat = " on ", medkits = " ,  , ", bandages = "   " }, owner = "arena", enable = true, in_combat = true },
    { name = "exact_matching", values = { enable = "true", in_combat = "true", medkits = "medkit_army, medkits", bandages = "bandage_old" }, owner = "arena", enable = true, in_combat = true },
    { name = "malformed_enable", values = { enable = "sometimes", in_combat = "true" }, error = "GA_NPC_MEDICAL_POLICY_INVALID" },
    { name = "malformed_in_combat", values = { enable = "true", in_combat = "sometimes" }, error = "GA_NPC_MEDICAL_POLICY_INVALID" },
