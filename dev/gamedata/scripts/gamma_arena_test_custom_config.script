local function clone(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then error("cyclic fixture") end
    seen[value] = true
    local copied = {}
    for key, child in pairs(value) do copied[key] = clone(child, seen) end
    seen[value] = nil
    return copied
end

function make_catalog()
    local function item(section, category, price, weight_mg, extra)
        local value = {
            section = section, category = category, price = price, weight_mg = weight_mg,
            ammo_sections = {}, healing = false, helmet_allowed = true, carry_bonus_mg = 0
        }
        for key, child in pairs(extra or {}) do value[key] = child end
        return value
    end
    local items = {
        outfit_field = item("outfit_field", "outfit", 100, 5000, { carry_bonus_mg = 10000 }),
        helmet_open = item("helmet_open", "helmet", 50, 1000),
        wpn_knife = item("wpn_knife", "knife", 50, 500),
        wpn_alpha = item("wpn_alpha", "weapon", 100, 3000, { ltx_slot = 2, ammo_sections = { "ammo_alpha" } }),
        ammo_alpha = item("ammo_alpha", "ammo", 20, 100),
        medkit = item("medkit", "medicine", 30, 100, { healing = true }),
        grenade_f1 = item("grenade_f1", "grenade", 40, 400),
        grenade_rgd5 = item("grenade_rgd5", "grenade", 70, 500),
        grenade_gd05 = item("grenade_gd05", "grenade", 30, 300)
    }
    return {
        schema_version = 9, revision = 10, generator_version = 10,
        fingerprint = "ga-catalog-v9-custom001",
        layouts = { rostok_arena_v1 = { id = "rostok_arena_v1", virtual_capacity = 10 } },
        base_budget = 600, max_entries = 64, max_physical_items_per_participant = 256,
        max_selected_grenades = 2, max_quantity_per_grenade = 1,
        second_grenade_price_multiplier = 2, base_carry_weight = 50000,
        rank_ids = { "novice", "legend" },
        ranks = {
            novice = { id = "novice", threat = 100 },
            legend = { id = "legend", threat = 400 }
        },
        faction_ids = { "stalker" },
        factions = {
            stalker = { id = "stalker", ranks = { novice = { id = "novice" }, legend = { id = "legend" } } }
        },
        items = items
    }
end

function make_context(catalog)
    return { catalog = catalog or make_catalog(), layout = { id = "rostok_arena_v1", virtual_capacity = 10 } }
end

function make_valid_config(catalog)
    catalog = catalog or make_catalog()
    return {
        schema_version = 1,
        faction = "stalker",
        roster = { { rank = "novice" } },
        actor_items = {
            { section = "outfit_field", quantity = 1, equipped_slot = "outfit" },
            { section = "wpn_alpha", quantity = 1, equipped_slot = "weapon_2" },
            { section = "ammo_alpha", quantity = 2 },
            { section = "wpn_knife", quantity = 1, equipped_slot = "knife" },
            { section = "medkit", quantity = 1 },
            { section = "grenade_f1", quantity = 1 },
            { section = "grenade_rgd5", quantity = 1 }
        },
        catalog_fingerprint = catalog.fingerprint
    }
end

local function assert_code(result, code, message)
    gamma_arena_test_assert.is_false(result.ok, message)
    gamma_arena_test_assert.equals(result.error.code, code, message .. " code")
end

local function custom_config_accepts_and_copies_valid_ordered_input()
    local catalog = make_catalog()
    local value = make_valid_config(catalog)
    local validated = gamma_arena_custom_config.validate(value, make_context(catalog))
    gamma_arena_test_assert.is_true(validated.ok, "valid custom config")
    gamma_arena_test_assert.equals(validated.value.actor_items[6].section, "grenade_f1", "first grenade order")
    gamma_arena_test_assert.equals(validated.value.actor_items[7].section, "grenade_rgd5", "second grenade order")
    value.roster[1].rank = "legend"
    value.actor_items[6].section = "grenade_rgd5"
    gamma_arena_test_assert.equals(validated.value.roster[1].rank, "novice", "roster is copied")
    gamma_arena_test_assert.equals(validated.value.actor_items[6].section, "grenade_f1", "items are copied")
    local budget = gamma_arena_custom_config.budget(validated.value.roster, catalog)
    local totals = gamma_arena_custom_config.totals(validated.value, catalog)
    gamma_arena_test_assert.equals(budget.value, 700, "budget is base plus threat")
    gamma_arena_test_assert.equals(totals.value.points, 500, "second grenade receives multiplier")
    gamma_arena_test_assert.equals(totals.value.weight_mg, 9700, "physical weight is authoritative")
    gamma_arena_test_assert.equals(totals.value.weight_limit_mg, 60000, "outfit increases carry limit")
end

local function custom_config_rejects_roster_catalog_and_shape_matrix()
    local catalog = make_catalog()
    local context = make_context(catalog)
    local function reject(mutate, code, label)
        local value = make_valid_config(catalog)
        mutate(value)
        assert_code(gamma_arena_custom_config.validate(value, context), code, label)
    end
    reject(function(value) value.roster = {} end, "GA_CUSTOM_ROSTER_LIMIT", "zero roster")
    reject(function(value) for index = 2, 11 do value.roster[index] = { rank = "novice" } end end, "GA_CUSTOM_ROSTER_LIMIT", "eleven roster")
    reject(function(value) value.faction = "unknown" end, "GA_CUSTOM_FACTION_UNKNOWN", "unknown faction")
    reject(function(value) value.roster[1].rank = "unknown" end, "GA_CUSTOM_RANK_UNKNOWN", "unknown rank")
    reject(function(value) value.actor_items[5].section = "unknown" end, "GA_CUSTOM_ITEM_UNKNOWN", "unknown section")
    reject(function(value) value.catalog_fingerprint = "ga-catalog-v9-stale" end, "GA_CUSTOM_CATALOG_STALE", "stale fingerprint")
    reject(function(value) value.actor_items[7].section = value.actor_items[6].section end, "GA_CUSTOM_ITEM_DUPLICATE", "duplicate section")
    reject(function(value) value.points = 500 end, "GA_CUSTOM_UNKNOWN_FIELD", "supplied derived total")

    local too_many = make_valid_config(catalog)
    for index = #too_many.actor_items + 1, 65 do
        local section = "fixture_item_" .. tostring(index)
        catalog.items[section] = { section = section, category = "medicine", price = 1, weight_mg = 1, healing = false, ammo_sections = {} }
        too_many.actor_items[index] = { section = section, quantity = 1 }
    end
    assert_code(gamma_arena_custom_config.validate(too_many, context), "GA_CUSTOM_ENTRY_LIMIT", "65 entries")

    reject(function(value) value.actor_items[3].quantity = 251 end, "GA_CUSTOM_PHYSICAL_LIMIT", "257 physical items")
end

local function custom_config_rejects_equipment_compatibility_and_budget_matrix()
    local catalog = make_catalog()
    local context = make_context(catalog)
    local function reject(mutate_config, mutate_catalog, code, label)
        local local_catalog = clone(catalog)
        local value = make_valid_config(local_catalog)
        if mutate_config then mutate_config(value) end
        if mutate_catalog then mutate_catalog(local_catalog) end
        assert_code(gamma_arena_custom_config.validate(value, make_context(local_catalog)), code, label)
    end
    reject(function(value) value.actor_items[5].equipped_slot = "weapon_1" end, nil, "GA_CUSTOM_SLOT_INVALID", "illegal slot")
    reject(function(value) table.insert(value.actor_items, 2, { section = "helmet_open", quantity = 1, equipped_slot = "helmet" }) end,
        function(value) value.items.outfit_field.helmet_allowed = false end, "GA_CUSTOM_HELMET_INCOMPATIBLE", "incompatible helmet")
    reject(nil, function(value) value.items.wpn_alpha.ammo_sections = { "ammo_other" } end, "GA_CUSTOM_AMMO_INCOMPATIBLE", "incompatible ammo")
    reject(function(value) table.remove(value.actor_items, 5) end, nil, "GA_CUSTOM_HEALING_REQUIRED", "missing healing")
    reject(nil, function(value) value.items.medkit.price = 1000 end, "GA_CUSTOM_OVERSPEND", "overspend")
    reject(nil, function(value) value.items.wpn_alpha.weight_mg = 70000 end, "GA_CUSTOM_OVERWEIGHT", "overweight")
    reject(function(value) value.actor_items[6].quantity = 2 end, nil, "GA_CUSTOM_GRENADE_LIMIT", "grenade quantity two")
    reject(function(value) value.actor_items[#value.actor_items + 1] = { section = "grenade_gd05", quantity = 1 } end, nil, "GA_CUSTOM_GRENADE_LIMIT", "third grenade")
end

local function custom_config_rejects_non_unit_physical_equipment()
    local catalog = make_catalog()
    local context = make_context(catalog)
    local function reject(mutate, label)
        local value = make_valid_config(catalog)
        mutate(value)
        assert_code(gamma_arena_custom_config.validate(value, context), "GA_CUSTOM_EQUIPMENT_QUANTITY", label)
    end
    reject(function(value) value.actor_items[1].quantity = 2 end, "outfit quantity two")
    reject(function(value) value.actor_items[4].quantity = 2 end, "knife quantity two")
    reject(function(value)
        table.insert(value.actor_items, 2, { section = "helmet_open", quantity = 2, equipped_slot = "helmet" })
    end, "helmet quantity two")
    reject(function(value) value.actor_items[2].quantity = 2 end, "equipped weapon quantity two")
end

local function custom_config_preserves_legitimate_inventory_stacks()
    local catalog = make_catalog()
    catalog.items.wpn_spare = {
        section = "wpn_spare", category = "weapon", price = 1, weight_mg = 1,
        ltx_slot = 2, ammo_sections = { "ammo_alpha" }, healing = false,
        helmet_allowed = true, carry_bonus_mg = 0
    }
    local value = make_valid_config(catalog)
    value.actor_items[5].quantity = 2
    table.insert(value.actor_items, 6, { section = "wpn_spare", quantity = 2 })
    local validated = gamma_arena_custom_config.validate(value, make_context(catalog))
    gamma_arena_test_assert.is_true(validated.ok, "medicine and unequipped weapon stacks remain valid")
    gamma_arena_test_assert.equals(validated.value.actor_items[5].quantity, 2, "medicine stack is preserved")
    gamma_arena_test_assert.equals(validated.value.actor_items[6].quantity, 2, "unequipped weapon stack is preserved")
end

local function custom_config_grenade_order_is_semantic()
    local catalog = make_catalog()
    local forward = make_valid_config(catalog)
    local reverse_order = make_valid_config(catalog)
    reverse_order.actor_items[6], reverse_order.actor_items[7] = reverse_order.actor_items[7], reverse_order.actor_items[6]
    local first = gamma_arena_custom_config.totals(forward, catalog)
    local second = gamma_arena_custom_config.totals(reverse_order, catalog)
    gamma_arena_test_assert.equals(first.value.points, 500, "RGD5 is multiplied when second")
    gamma_arena_test_assert.equals(second.value.points, 470, "F1 is multiplied when second")
end

local function custom_setup_model_preserves_order_and_recalculates_budget()
    local catalog = make_catalog()
    catalog.faction_ids = { "stalker", "monolith" }
    catalog.factions.monolith = clone(catalog.factions.stalker)
    catalog.factions.monolith.id = "monolith"
    local model = gamma_arena_custom_setup_model.new(catalog, make_context(catalog).layout)
    local initial = model:snapshot()
    gamma_arena_test_assert.equals(initial.count, 1, "draft starts with one opponent")
    gamma_arena_test_assert.equals(initial.roster[1].rank, "novice", "draft starts at novice")
    gamma_arena_test_assert.equals(initial.faction, nil, "draft requires explicit faction")
    gamma_arena_test_assert.is_false(model:validation().ok, "initial draft is not launchable")

    gamma_arena_test_assert.is_true(model:set_count(3).ok, "count growth is accepted")
    gamma_arena_test_assert.is_true(model:set_rank(2, "legend").ok, "visible row rank changes")
    gamma_arena_test_assert.is_true(model:set_faction("stalker").ok, "shared faction is selected")
    local grown = model:snapshot()
    gamma_arena_test_assert.equals(grown.roster[1].rank, "novice", "first rank survives growth")
    gamma_arena_test_assert.equals(grown.roster[2].rank, "legend", "changed rank survives growth")
    gamma_arena_test_assert.equals(grown.roster[3].rank, "novice", "growth appends novice")
    gamma_arena_test_assert.equals(grown.budget, 1200, "budget is 600 plus ordered threats")
    gamma_arena_test_assert.equals(grown.config.roster[1].faction, nil, "rows never store faction")

    gamma_arena_test_assert.is_true(model:set_count(2).ok, "tail shrink is accepted")
    gamma_arena_test_assert.is_true(model:set_count(3).ok, "regrowth is accepted")
    gamma_arena_test_assert.is_true(model:set_faction("monolith").ok, "one faction changes the whole roster")
    local regrown = model:snapshot()
    gamma_arena_test_assert.equals(regrown.roster[1].rank, "novice", "shrink preserves first row")
    gamma_arena_test_assert.equals(regrown.roster[2].rank, "legend", "shrink preserves second row")
    gamma_arena_test_assert.equals(regrown.roster[3].rank, "novice", "regrowth creates novice tail")
    gamma_arena_test_assert.equals(regrown.config.faction, "monolith", "single config faction is authoritative")
    gamma_arena_test_assert.equals(regrown.budget, 1200, "regrowth recalculates budget")
    gamma_arena_test_assert.is_false(model:set_count(11).ok, "layout capacity rejects eleventh row")
    gamma_arena_test_assert.equals(model:snapshot().count, 3, "rejected count does not mutate")
end

local function custom_setup_model_progressively_assembles_valid_equipment_and_categories()
    local catalog = make_catalog()
    catalog.categories = {
        weapon = { "wpn_alpha" }, ammo = { "ammo_alpha" }, outfit = { "outfit_field" },
        helmet = { "helmet_open" }, knife = { "wpn_knife" }, medicine = { "medkit" },
        grenade = { "grenade_f1", "grenade_rgd5", "grenade_gd05" }
    }
    catalog.item_ids = {
        "ammo_alpha", "grenade_f1", "grenade_gd05", "grenade_rgd5", "helmet_open",
        "medkit", "outfit_field", "wpn_alpha", "wpn_knife"
    }
    local model = gamma_arena_custom_setup_model.new(catalog, make_context(catalog).layout)
    gamma_arena_test_assert.is_true(model:set_faction("stalker").ok, "faction edit commits while draft is incomplete")
    gamma_arena_test_assert.is_true(model:add_item("outfit_field", 1).ok, "outfit is progressively selected")
    gamma_arena_test_assert.is_true(model:equip("outfit_field", "outfit").ok, "outfit equips")
    gamma_arena_test_assert.is_true(model:add_item("wpn_alpha", 1).ok, "weapon is progressively selected")
    gamma_arena_test_assert.is_true(model:equip("wpn_alpha", "weapon_2").ok, "weapon equips to effective slot")
    gamma_arena_test_assert.is_true(model:add_item("ammo_alpha", 2).ok, "ammo quantity is selected")
    gamma_arena_test_assert.is_true(model:add_item("wpn_knife", 1).ok, "knife is progressively selected")
    gamma_arena_test_assert.is_true(model:equip("wpn_knife", "knife").ok, "knife equips")
    gamma_arena_test_assert.is_true(model:add_item("medkit", 1).ok, "healing is progressively selected")
    gamma_arena_test_assert.is_true(model:validation().ok, "complete equipment passes authoritative validation")

    local browsed = model:snapshot()
    gamma_arena_test_assert.equals(#browsed.categories.weapon, 1, "weapon category browses installed item")
    gamma_arena_test_assert.equals(#browsed.categories.ammo, 1, "ammo category browses installed item")
    gamma_arena_test_assert.equals(#browsed.categories.outfit, 1, "outfit category browses installed item")
    gamma_arena_test_assert.equals(#browsed.categories.helmet, 1, "helmet category browses installed item")
    gamma_arena_test_assert.equals(#browsed.categories.knife, 1, "knife category browses installed item")
    gamma_arena_test_assert.equals(#browsed.categories.medicine, 1, "medicine category browses installed item")
    gamma_arena_test_assert.equals(#browsed.categories.grenade, 3, "grenade category browses curated actor pool")
    gamma_arena_test_assert.equals(browsed.spent, 320, "progressive equipment points are derived")
    gamma_arena_test_assert.equals(browsed.physical_count, 6, "physical quantities are derived")

    local illegal = model:equip("medkit", "weapon_1")
    assert_code(illegal, "GA_CUSTOM_SLOT_INVALID", "medicine cannot equip")
    gamma_arena_test_assert.equals(model:snapshot().config.actor_items[5].equipped_slot, nil, "rejected equip does not mutate")
    gamma_arena_test_assert.is_true(model:unequip("outfit_field").ok, "required equipment may be removed from draft")
    gamma_arena_test_assert.is_false(model:validation().ok, "unequipped outfit disables launch")
    gamma_arena_test_assert.is_true(model:equip("outfit_field", "outfit").ok, "outfit can be restored")
    gamma_arena_test_assert.is_true(model:validation().ok, "restored equipment reenables launch")
end

local function custom_setup_model_grenade_selection_removal_and_reorder_are_semantic()
    local catalog = make_catalog()
    local model = gamma_arena_custom_setup_model.new(catalog, make_context(catalog).layout)
    model:set_faction("stalker")
    model:add_item("outfit_field", 1); model:equip("outfit_field", "outfit")
    model:add_item("wpn_alpha", 1); model:equip("wpn_alpha", "weapon_2")
    model:add_item("ammo_alpha", 2)
    model:add_item("wpn_knife", 1); model:equip("wpn_knife", "knife")
    model:add_item("medkit", 1)

    gamma_arena_test_assert.is_true(model:add_item("grenade_f1", 1).ok, "first grenade is selected")
    gamma_arena_test_assert.is_true(model:add_item("grenade_rgd5", 1).ok, "second grenade is selected")
    local selected = model:snapshot().selected_grenades
    gamma_arena_test_assert.equals(selected[1].section, "grenade_f1", "F1 remains first")
    gamma_arena_test_assert.equals(selected[1].base_price, 40, "first grenade exposes base price")
    gamma_arena_test_assert.equals(selected[1].effective_price, 40, "first grenade uses base price")
    gamma_arena_test_assert.equals(selected[2].section, "grenade_rgd5", "RGD5 remains second")
    gamma_arena_test_assert.equals(selected[2].multiplier, 2, "second grenade exposes multiplier")
    gamma_arena_test_assert.equals(selected[2].effective_price, 140, "second grenade doubles its own base price")

    local rejected = model:add_item("grenade_gd05", 1)
    assert_code(rejected, "GA_CUSTOM_GRENADE_LIMIT", "third grenade is rejected")
    gamma_arena_test_assert.equals(#model:snapshot().selected_grenades, 2, "third grenade rejection does not mutate")
    gamma_arena_test_assert.equals(model:snapshot().last_operation.error.code, "GA_CUSTOM_GRENADE_LIMIT", "rejected attempt stays observable")

    gamma_arena_test_assert.is_true(model:remove_item("grenade_f1").ok, "first grenade removes")
    local survivor = model:snapshot().selected_grenades
    gamma_arena_test_assert.equals(survivor[1].section, "grenade_rgd5", "survivor becomes first")
    gamma_arena_test_assert.equals(survivor[1].effective_price, 70, "survivor returns to base price")
    gamma_arena_test_assert.is_true(model:add_item("grenade_f1", 1).ok, "removed grenade can be appended")
    local reordered = model:snapshot().selected_grenades
    gamma_arena_test_assert.equals(reordered[1].section, "grenade_rgd5", "survivor retains first order")
    gamma_arena_test_assert.equals(reordered[1].effective_price, 70, "first remains base price")
    gamma_arena_test_assert.equals(reordered[2].section, "grenade_f1", "re-added grenade becomes second")
    gamma_arena_test_assert.equals(reordered[2].effective_price, 80, "new second grenade doubles its base price")
end

local function custom_codec_round_trip_preserves_bounded_order()
    local catalog = make_catalog()
    local context = make_context(catalog)
    local value = gamma_arena_custom_config.validate(make_valid_config(catalog), context).value
    local encoded = gamma_arena_custom_codec.encode(value, "launch_custom_")
    gamma_arena_test_assert.is_true(encoded.ok, "valid config encodes")
    local persisted = {}
    for _, operation in ipairs(encoded.value) do
        if operation.action == "write" then persisted[operation.key] = tostring(operation.value)
        else persisted[operation.key] = nil end
    end
    local decoded = gamma_arena_custom_codec.decode(function(key) return persisted[key] end, "launch_custom_", context)
    gamma_arena_test_assert.is_true(decoded.ok, "persisted config decodes")
    gamma_arena_test_assert.equals(decoded.value.actor_items[6].section, "grenade_f1", "round trip first grenade")
    gamma_arena_test_assert.equals(decoded.value.actor_items[7].section, "grenade_rgd5", "round trip second grenade")
    gamma_arena_test_assert.equals(#gamma_arena_custom_codec.keys("launch_custom_"), 207, "codec key space is bounded")
end

local function custom_codec_rejects_sparse_and_oversized_shapes()
    local catalog = make_catalog()
    local context = make_context(catalog)
    local sparse = make_valid_config(catalog)
    sparse.actor_items[3] = nil
    assert_code(gamma_arena_custom_codec.encode(sparse, "launch_custom_"), "GA_CUSTOM_CODEC_INVALID", "sparse encode")
    local persisted = {
        launch_custom_schema_version = "1", launch_custom_faction = "stalker",
        launch_custom_catalog_fingerprint = catalog.fingerprint,
        launch_custom_roster_count = "1", launch_custom_actor_item_count = "65",
        launch_custom_roster_1_rank = "novice"
    }
    assert_code(gamma_arena_custom_codec.decode(function(key) return persisted[key] end, "launch_custom_", context),
        "GA_CUSTOM_CODEC_INVALID", "oversized decode")
    persisted.launch_custom_actor_item_count = "7"
    persisted.launch_custom_roster_2_rank = "legend"
    assert_code(gamma_arena_custom_codec.decode(function(key) return persisted[key] end, "launch_custom_", context),
        "GA_CUSTOM_CODEC_TRAILING_KEY", "trailing indexed key")
end

local function custom_codec_encode_rejects_unknown_fields_and_malformed_scalars()
    local catalog = make_catalog()
    local function reject(mutate, label)
        local value = make_valid_config(catalog)
        mutate(value)
        assert_code(gamma_arena_custom_codec.encode(value, "launch_custom_"), "GA_CUSTOM_CODEC_INVALID", label)
    end
    reject(function(value) value.future = true end, "codec top-level unknown field")
    reject(function(value) value.roster[1].future = true end, "codec roster unknown field")
    reject(function(value) value.actor_items[1].future = true end, "codec item unknown field")
    reject(function(value) value.faction = nil end, "codec missing top-level scalar")
    reject(function(value) value.roster[1].rank = nil end, "codec missing roster scalar")
    reject(function(value) value.actor_items[1].section = nil end, "codec missing item section")
    reject(function(value) value.actor_items[1].quantity = nil end, "codec missing item quantity")
    reject(function(value) value.faction = "" end, "codec empty faction")
    reject(function(value) value.catalog_fingerprint = "" end, "codec empty fingerprint")
    reject(function(value) value.roster[1].rank = {} end, "codec malformed roster rank")
    reject(function(value) value.actor_items[1].section = false end, "codec malformed item section")
    reject(function(value) value.actor_items[1].quantity = "1" end, "codec malformed item quantity")
    reject(function(value) value.actor_items[1].equipped_slot = 1 end, "codec malformed equipped slot")
end

local function custom_codec_encode_uses_canonical_decimal_quantities()
    local catalog = make_catalog()
    local value = make_valid_config(catalog)
    value.actor_items[3].quantity = 9007199254740991
    local encoded = gamma_arena_custom_codec.encode(value, "launch_custom_")
    gamma_arena_test_assert.is_true(encoded.ok, "maximum safe quantity encodes structurally")
    local quantity
    for _, operation in ipairs(encoded.value) do
        if operation.key == "launch_custom_actor_item_3_quantity" then quantity = operation.value; break end
    end
    gamma_arena_test_assert.equals(quantity, "9007199254740991", "quantity encoding is canonical decimal text")
end

local cases = {
    { name = "custom_config_accepts_and_copies_valid_ordered_input", fn = custom_config_accepts_and_copies_valid_ordered_input },
    { name = "custom_config_rejects_roster_catalog_and_shape_matrix", fn = custom_config_rejects_roster_catalog_and_shape_matrix },
    { name = "custom_config_rejects_equipment_compatibility_and_budget_matrix", fn = custom_config_rejects_equipment_compatibility_and_budget_matrix },
    { name = "custom_config_rejects_non_unit_physical_equipment", fn = custom_config_rejects_non_unit_physical_equipment },
    { name = "custom_config_preserves_legitimate_inventory_stacks", fn = custom_config_preserves_legitimate_inventory_stacks },
    { name = "custom_config_grenade_order_is_semantic", fn = custom_config_grenade_order_is_semantic },
    { name = "custom_setup_model_preserves_order_and_recalculates_budget", fn = custom_setup_model_preserves_order_and_recalculates_budget },
    { name = "custom_setup_model_progressively_assembles_valid_equipment_and_categories", fn = custom_setup_model_progressively_assembles_valid_equipment_and_categories },
    { name = "custom_setup_model_grenade_selection_removal_and_reorder_are_semantic", fn = custom_setup_model_grenade_selection_removal_and_reorder_are_semantic },
    { name = "custom_codec_round_trip_preserves_bounded_order", fn = custom_codec_round_trip_preserves_bounded_order }
    ,{ name = "custom_codec_rejects_sparse_and_oversized_shapes", fn = custom_codec_rejects_sparse_and_oversized_shapes }
    ,{ name = "custom_codec_encode_rejects_unknown_fields_and_malformed_scalars", fn = custom_codec_encode_rejects_unknown_fields_and_malformed_scalars }
    ,{ name = "custom_codec_encode_uses_canonical_decimal_quantities", fn = custom_codec_encode_uses_canonical_decimal_quantities }
}

function run(run_case_fn)
    local all_passed = true
    for _, case in ipairs(cases) do if not run_case_fn(case.name, case.fn) then all_passed = false end end
    return all_passed
end
