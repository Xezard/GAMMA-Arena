local has_run = false

function run_case(name, fn)
    local ok, err = pcall(fn)
    if ok then
        printf("[GammaArenaTest] PASS %s", name)
        return true
    end
    printf("[GammaArenaTest] FAIL %s :: %s", name, tostring(err))
    return false
end

function on_game_start()
    if has_run then
        return
    end
    has_run = true

    local run_id = "0"
    if type(time_global) == "function" then
        local ok, value = pcall(time_global)
        if ok then
            run_id = tostring(value)
        end
    end
    printf("[GammaArenaTest] BEGIN run_id=%s", run_id)

    local suite_ok, all_passed = pcall(function()
        return gamma_arena_test_domain.run(run_case)
    end)
    if suite_ok and all_passed then
        printf("[GammaArenaTest] ALL PASS")
    else
        if not suite_ok then
            printf("[GammaArenaTest] FAIL suite :: %s", tostring(all_passed))
        end
        printf("[GammaArenaTest] SUITE FAILED")
    end
end
