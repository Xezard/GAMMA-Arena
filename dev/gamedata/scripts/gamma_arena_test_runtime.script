    gamma_arena_test_assert.equals(env.clear_intent, 1, "defeat main menu clears matching intent")
    gamma_arena_test_assert.equals(env.disconnected, 1, "defeat main menu disconnects only after cleanup")
end

local function runtime_task9_restore_failure_enters_error_with_safe_menu_only()
    local env = task8_environment({ restore_error = true }); task8_pump_to_active(env)
