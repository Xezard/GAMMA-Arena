local function runtime_start_launch_recovers_only_confirmed_defeat_conflict()
    local request = {
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = "master",
        seed_mode = "random",
        session_seed = 123
    }
    local issue_calls = 0
    local peek_calls = 0
    local clear_calls = 0
    local recovered = gamma_arena_ui_start.issue_launch_with_defeat_recovery({}, request, {
        issue_launch = function()
            issue_calls = issue_calls + 1
            if issue_calls == 1 then return gamma_arena_result.err("GA_INTENT_CONFLICT", "Launch and defeat intents cannot coexist") end
            return gamma_arena_result.ok({ token = "ga1:1000:recovered" })
        end,
        peek_defeat = function()
            peek_calls = peek_calls + 1
            return gamma_arena_result.ok({ token = "gad1:1000:stale" })
        end,
        clear_defeat = function()
            clear_calls = clear_calls + 1
            return gamma_arena_result.ok(true)
        end
    })
    gamma_arena_test_assert.is_true(recovered.ok, "explicit Arena start recovers a confirmed defeat conflict")
    gamma_arena_test_assert.equals(issue_calls, 2, "confirmed defeat recovery retries launch exactly once")
    gamma_arena_test_assert.equals(peek_calls, 1, "intent conflict is classified through the defeat store")
    gamma_arena_test_assert.equals(clear_calls, 1, "only the confirmed defeat is cleared")

    local resume_issue_calls = 0
    local resume_clear_calls = 0
    local resume_conflict = gamma_arena_ui_start.issue_launch_with_defeat_recovery({}, request, {
        issue_launch = function()
            resume_issue_calls = resume_issue_calls + 1
            return gamma_arena_result.err("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist")
        end,
        peek_defeat = function() return gamma_arena_result.ok(false) end,
        clear_defeat = function()
            resume_clear_calls = resume_clear_calls + 1
            return gamma_arena_result.ok(true)
        end
    })
    gamma_arena_test_assert.is_false(resume_conflict.ok, "non-defeat intent conflicts remain fail-closed")
    gamma_arena_test_assert.equals(resume_issue_calls, 1, "non-defeat conflict is never retried")
    gamma_arena_test_assert.equals(resume_clear_calls, 0, "resume state is never erased by defeat recovery")
end

local function death_neutralization_fixture(actor)
    local env = { stops = 0, cleared = {}, held = {}, tags = {}, online = {} }
    local tactical = {}
    function tactical:stop() env.stops = env.stops + 1; return gamma_arena_result.ok(true) end
    local deps = {
        tactical = tactical,
        load_tag = function(id) return env.tags[id] end,
        online_object = function(id) return env.online[id] end,
        actor_object = function() return actor end,
        clear_enemy = function(npc) env.cleared[#env.cleared + 1] = npc.runtime_id; return gamma_arena_result.ok(true) end,
        set_actor_hold = function(npc) env.held[#env.held + 1] = npc.runtime_id; return gamma_arena_result.ok(true) end
    }
    local adapter = gamma_arena_entity_adapter.new(deps)
    adapter.session_id = "ga_owned_session"
    adapter.tactical_started = true
    adapter.registry.npcs = {
        { id = 1, released = false },
        { id = 2, released = false },
        { id = 3, released = true },
        { id = 4, released = false }
    }
    env.tags = { [1] = "ga_owned_session", [2] = "ga_owned_session", [3] = "ga_owned_session", [4] = "ambient_session" }
    local function object(id, alive)
        return { runtime_id = id, alive = function() return alive end }
    end
    env.online = { [1] = object(1, true), [2] = object(2, false), [3] = object(3, true), [4] = object(4, true) }
    env.adapter = adapter
    return env
end

local function runtime_entity_death_neutralization_is_owned_living_and_idempotent()
    local env = death_neutralization_fixture({ runtime_id = 99 })
    local first = env.adapter:neutralize_owned_opponents()
    local second = env.adapter:neutralize_owned_opponents()
    gamma_arena_test_assert.is_true(first.ok and second.ok, "owned opponent neutralization is a total idempotent operation")
    gamma_arena_test_assert.equals(table.concat(env.cleared, ","), "1", "only the registered living owned NPC clears its enemy")
    gamma_arena_test_assert.equals(table.concat(env.held, ","), "1", "only the registered living owned NPC receives actor hold")
    gamma_arena_test_assert.equals(env.stops, 1, "tactical stop is idempotent")
    gamma_arena_test_assert.is_true(env.adapter.registry.npcs[1].death_neutralized, "attempted owned living NPC is latched")
    gamma_arena_test_assert.equals(env.adapter.registry.npcs[4].death_neutralized, nil, "foreign-tag ambient NPC record remains untouched")
end

local function runtime_entity_death_neutralization_without_actor_still_clears_enemy()
    local env = death_neutralization_fixture(nil)
    local result = env.adapter:neutralize_owned_opponents()
    gamma_arena_test_assert.is_true(result.ok, "missing dead actor object is benign")
    gamma_arena_test_assert.equals(table.concat(env.cleared, ","), "1", "enemy target clears without an actor object")
    gamma_arena_test_assert.equals(#env.held, 0, "relation calls are skipped without an actor object")
end

local function runtime_entity_death_neutralization_aggregates_every_failure()
    local env = death_neutralization_fixture({ runtime_id = 99 })
    env.adapter.registry.npcs = {
        { id = 1, released = false }, { id = 2, released = false }, { id = 3, released = false },
        { id = 4, released = false }, { id = 5, released = false }
    }
    env.tags = { [1] = "ga_owned_session", [2] = "ga_owned_session", [3] = "ga_owned_session", [4] = "ga_owned_session", [5] = "ga_owned_session" }
    env.adapter.deps.load_tag = function(id)
        if id == 2 then return gamma_arena_result.err("GA_TEST_TAG", "tag failure") end
        return env.tags[id]
    end
    local function living(id) return { runtime_id = id, alive = function() return true end } end
    env.adapter.deps.online_object = function(id)
        if id == 3 then return gamma_arena_result.err("GA_TEST_ONLINE", "online failure") end
        if id == 4 then return { runtime_id = id, alive = function() error("alive failure") end } end
        return living(id)
    end
    env.adapter.deps.tactical.stop = function() return gamma_arena_result.err("GA_TEST_STOP", "stop failure") end
    env.adapter.deps.clear_enemy = function(npc)
        env.cleared[#env.cleared + 1] = npc.runtime_id
        if npc.runtime_id == 1 then return gamma_arena_result.err("GA_TEST_CLEAR", "clear failure") end
        return gamma_arena_result.ok(true)
    end
    env.adapter.deps.set_actor_hold = function(npc)
        env.held[#env.held + 1] = npc.runtime_id
        if npc.runtime_id == 1 then return gamma_arena_result.err("GA_TEST_HOLD", "hold failure") end
        return gamma_arena_result.ok(true)
    end
    local result = env.adapter:neutralize_owned_opponents()
    gamma_arena_test_assert.is_false(result.ok, "neutralization reports aggregate failure only after all records")
    gamma_arena_test_assert.equals(result.error.code, "GA_ENTITY_DEATH_NEUTRALIZE_FAILED", "aggregate failure code is stable")
    gamma_arena_test_assert.equals(#result.error.context.errors, 6, "stop, tag, online, alive, clear, and hold failures are all retained")
    gamma_arena_test_assert.equals(table.concat(env.cleared, ","), "1,5", "later owned living records are attempted after earlier failures")
    gamma_arena_test_assert.equals(table.concat(env.held, ","), "1,5", "relation attempts continue independently of clear failures")
end

local function runtime_task9_countdown_escape_model_routes_main_menu_cleanup()
    local env = task8_environment(); task8_pump_to_countdown(env)
    local model = env.countdown_models[1]
    gamma_arena_test_assert.is_true(type(model) == "table" and model.value == 3, "countdown seam receives a structured model")
    gamma_arena_test_assert.is_true(type(model.on_main_menu) == "function", "countdown model exposes the common Arena main-menu action")
    local requested = model.on_main_menu()
    gamma_arena_test_assert.is_true(requested.ok, "countdown Escape action enters ordinary Arena main-menu cleanup")
    gamma_arena_test_assert.equals(env.clear_intent, 1, "countdown Escape clears only the matching Arena intent")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "CLEANING", "countdown Escape never silently closes the shared window")
    gamma_arena_test_assert.is_false(env.orchestrator:is_active(), "countdown Escape deactivates Arena before disconnect")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.disconnected, 1, "countdown Escape disconnects only after common cleanup proof")

    local failed = task8_environment({ clear_countdown_error = true }); task8_pump_to_countdown(failed)
    local routed = failed.countdown_models[1].on_main_menu()
    gamma_arena_test_assert.is_false(routed.ok, "countdown Escape cleanup failure remains observable")
    gamma_arena_test_assert.equals(failed.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "countdown Escape cleanup errors route through the common fatal boundary")
    gamma_arena_test_assert.equals(failed.fatal_shown, 1, "countdown Escape cleanup error opens fatal UI once")
end

local function runtime_task9_resume_failures_normalize_to_restore_failed()
    local function resume_environment()
        local session = valid_session()
        local store = fake_store({ launch_pending = false, resume_pending = true })
        store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
        local deps = fake_orchestrator_deps(store)
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:load_state({ gamma_arena_session = session })
        orchestrator:on_game_load()
        return orchestrator, deps, store
    end
    local function assert_restore_failure(result, cause_code, label)
        gamma_arena_test_assert.is_false(result.ok, label .. " enters fatal routing")
        gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_RESTORE_FAILED", label .. " exposes one top-level recovery contract")
        gamma_arena_test_assert.equals(result.error.context.cause.code, cause_code, label .. " preserves its exact cause code")
    end

    local missing, missing_deps = resume_environment()
    missing.loaded_session = nil
    assert_restore_failure(missing:actor_on_first_update(), "GA_RESUME_SESSION_MISSING", "missing embedded session")

    local preparation, preparation_deps, preparation_store = resume_environment()
    preparation_store.resume_result = gamma_arena_result.err("GA_RESUME_NONCE_MISMATCH", "injected preparation mismatch")
    assert_restore_failure(preparation:actor_on_first_update(), "GA_RESUME_NONCE_MISMATCH", "prepared intent mismatch")

    local malformed, malformed_deps, malformed_store = resume_environment()
    malformed_store.resume_result = gamma_arena_result.ok("not-an-intent")
    assert_restore_failure(malformed:actor_on_first_update(), "GA_RESUME_INVALID", "malformed prepared intent")

    local binding, binding_deps = resume_environment()
    binding_deps.checkpoint.begin_resume_recovery = function() return gamma_arena_result.err("GA_CHECKPOINT_RECOVERY_MISSING", "injected checkpoint binding failure") end
    assert_restore_failure(binding:actor_on_first_update(), "GA_CHECKPOINT_RECOVERY_MISSING", "checkpoint binding failure")

    local refused, refused_deps = resume_environment()
    refused_deps.checkpoint.begin_resume_recovery = function() return gamma_arena_result.ok(false) end
    assert_restore_failure(refused:actor_on_first_update(), "GA_CHECKPOINT_RECOVERY_FAILED", "checkpoint binding refusal")

    local missing_resume, missing_resume_deps = resume_environment()
    missing_resume_deps.checkpoint.take_resume = function() return gamma_arena_result.err("GA_CHECKPOINT_RESUME_MISSING", "injected missing resume") end
    gamma_arena_test_assert.is_true(missing_resume:actor_on_first_update().ok, "missing resume fixture enters re-hide")
    missing_resume:actor_on_update()
    assert_restore_failure(missing_resume:actor_on_update(), "GA_CHECKPOINT_RESUME_MISSING", "missing completed resume")

    local mismatched, mismatched_deps = resume_environment()
    mismatched_deps.checkpoint.take_resume = function() return gamma_arena_result.ok({ next_fight_index = 99 }) end
    gamma_arena_test_assert.is_true(mismatched:actor_on_first_update().ok, "mismatch fixture enters re-hide")
    mismatched:actor_on_update()
    assert_restore_failure(mismatched:actor_on_update(), "GA_CHECKPOINT_RECOVERY_MISMATCH", "completed resume mismatch")
end

local function runtime_task9_resume_pending_invalid_loaded_session_normalizes()
    local invalid_payload = { schema_version = 99 }
    local resume_store = fake_store({ launch_pending = false, resume_pending = true })
    local resume_orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(resume_store))
    local decoded = resume_orchestrator:load_state({ gamma_arena_session = invalid_payload })
    gamma_arena_test_assert.is_false(decoded.ok, "malformed loaded ArenaSession is captured before activation")
    gamma_arena_test_assert.equals(decoded.error.code, "GA_SESSION_SCHEMA_INVALID", "malformed fixture has the exact validation cause")
    resume_orchestrator:on_game_load()
    local resume_failed = resume_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(resume_failed.ok, "pending ResumeIntent rejects malformed loaded ArenaSession")
    gamma_arena_test_assert.equals(resume_failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "pending resume exposes the stable checkpoint recovery boundary")
    gamma_arena_test_assert.equals(resume_failed.error.context.cause.code, "GA_SESSION_SCHEMA_INVALID", "pending resume preserves the loaded-session validation cause")

    local launch_store = fake_store({ launch_pending = true, resume_pending = false })
    local launch_orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(launch_store))
    launch_orchestrator:load_state({ gamma_arena_session = invalid_payload })
    launch_orchestrator:on_game_load()
    local launch_failed = launch_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(launch_failed.ok, "ordinary launch still rejects malformed loaded metadata")
    gamma_arena_test_assert.equals(launch_failed.error.code, "GA_SESSION_SCHEMA_INVALID", "non-resume activation retains its original validation code")
end

local function runtime_task9_restoring_state_read_failure_normalizes()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "RESTORING fault fixture activates a pending resume")
    orchestrator.runtime_stage = "RESTORING"
    deps.checkpoint.current = "LOADING"
    deps.checkpoint.state = function() error("injected RESTORING state read failure") end
    local failed = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "RESTORING state-read exception remains observable")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "RESTORING state-read exception uses the stable recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_CHECKPOINT_STATE_FAILED", "RESTORING state-read exception preserves its exact cause")
end

local function runtime_task9_resume_completion_transition_failure_normalizes()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "transition fault fixture enters resume re-hide")
    local original_advance = orchestrator.advance
    orchestrator.advance = function(self, event)
        if self.runtime_stage == "RESUME_REHIDING" and event == gamma_arena_state_machine.events.CHECKPOINT_SUCCEEDED then
            return gamma_arena_result.err("GA_TEST_RESUME_TRANSITION", "injected resume completion transition failure")
        end
        return original_advance(self, event)
    end
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "first re-hide poll remains pending")
    local failed = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "resume completion transition failure remains observable")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "resume completion transition uses the stable recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_TEST_RESUME_TRANSITION", "resume completion transition preserves its exact cause")
end

local function active_medical_entity_fixture()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    gamma_arena_test_assert.is_true(begin_entity_apply(adapter, env, entity_spec(1), "session-medical").ok, "medical fixture begins")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "medical fixture reaches ACTIVE")
    return env, adapter, snapshot
end

local function registered_medical(snapshot, npc_id, section)
    for _, record in ipairs(snapshot.items) do
        if record.parent_id == npc_id and record.role == "consumable" and record.section == section then return record end
    end
    return nil
end

local function runtime_entity_consumes_owned_medical_item_once()
    local env, adapter, snapshot = active_medical_entity_fixture()
    local npc = snapshot.npcs[1]
    local medkit = registered_medical(snapshot, npc.id, "medkit")
    local bandage = registered_medical(snapshot, npc.id, "bandage")
    gamma_arena_test_assert.is_true(medkit ~= nil and bandage ~= nil and medkit.id ~= bandage.id, "each generated medical entry has a distinct registered entity")

    local consumed = adapter:consume_medical_item("ga-entity-test", npc.id, "medkit")
    gamma_arena_test_assert.is_true(consumed.ok and consumed.value.item_id == medkit.id, "owned physical medkit is consumed")
    gamma_arena_test_assert.equals(consumed.value.section, "medkit", "consumption returns the proved section")
    gamma_arena_test_assert.equals(env.release_requests[#env.release_requests], medkit.id, "consumption uses the safe release port")

    local release_count = #env.release_requests
    local duplicate = adapter:consume_medical_item("ga-entity-test", npc.id, "medkit")
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "duplicate consumption is idempotent")
    gamma_arena_test_assert.equals(#env.release_requests, release_count, "duplicate consumption never releases twice")

    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "teardown accepts a consumed child")
    pump_entity(adapter, env)
    local medkit_releases = 0
    for _, id in ipairs(env.release_requests) do if id == medkit.id then medkit_releases = medkit_releases + 1 end end
    gamma_arena_test_assert.equals(medkit_releases, 1, "teardown ignores the consumed child")
end

local function runtime_entity_medical_consumption_rejects_stale_foreign_and_absent_items()
    local env, adapter, snapshot = active_medical_entity_fixture()
    local npc = snapshot.npcs[1]
    local stale = adapter:consume_medical_item("ga-stale-fight", npc.id, "medkit")
    gamma_arena_test_assert.is_false(stale.ok, "stale fight identity is rejected")
    gamma_arena_test_assert.equals(stale.error.code, "GA_ENTITY_MEDICAL_FIGHT_STALE", "stale fight uses a stable error")

    local medkit = registered_medical(snapshot, npc.id, "medkit")
    env.objects[medkit.id].parent_id = 9999
    local transferred = adapter:consume_medical_item("ga-entity-test", npc.id, "medkit")
    gamma_arena_test_assert.is_true(transferred.ok and transferred.value == false, "transferred medicine cancels without an effect token")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "foreign medicine is never released")

    local bandage = registered_medical(snapshot, npc.id, "bandage")
    env:remove_entity(bandage.id)
    local absent = adapter:consume_medical_item("ga-entity-test", npc.id, "bandage")
    gamma_arena_test_assert.is_true(absent.ok and absent.value == false, "looted or absent medicine cancels without an effect token")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "absent medicine is never released")
end

local function npc_medical_fixture(values)
    values = values or {}
    local env = {
        now = 0, health = values.health or 0.5, bleeding = values.bleeding or 0.3,
        alive = true, combat_capable = true, consumed = {}, health_pulses = 0,
        bleeding_caps = {}, hidden_clears = 0, logs = {}
    }
    env.npc = { runtime_id = 301 }
    local registry = {
        state = "ACTIVE",
        npcs = { { id = 301, slot = 1, section = values.profile or "gamma_arena_bandit_veteran", terminal_state = "ALIVE", released = false } },
        items = {
            { id = 401, parent_id = 301, section = "medkit", role = "consumable", source = "assigned", released = false },
            { id = 402, parent_id = 301, section = "bandage", role = "consumable", source = "assigned", released = false }
        }
    }
    local controller = gamma_arena_npc_medical.new({
        clock = function() return env.now end,
        registry_snapshot = function() return clone(registry) end,
        clear_hidden_charge = function() env.hidden_clears = env.hidden_clears + 1; return gamma_arena_result.ok(true) end,
        status = function()
            return gamma_arena_result.ok({ npc = env.npc, health = env.health, bleeding = env.bleeding, alive = env.alive, combat_capable = env.combat_capable })
        end,
        consume_medical_item = function(fight_id, npc_id, section)
            if values.consume_false then return gamma_arena_result.ok(false) end
            env.consumed[#env.consumed + 1] = section
            for _, item in ipairs(registry.items) do if item.parent_id == npc_id and item.section == section then item.released = true end end
            return gamma_arena_result.ok({ npc = env.npc, item_id = section == "medkit" and 401 or 402, section = section })
        end,
        change_health = function(npc, delta)
            env.health_pulses = env.health_pulses + 1
            env.health = math.min(1, env.health + delta)
            return gamma_arena_result.ok(true)
        end,
        cap_bleeding = function(npc, maximum)
            env.bleeding = math.min(env.bleeding, maximum)
            env.bleeding_caps[#env.bleeding_caps + 1] = maximum
            return gamma_arena_result.ok(true)
        end,
        log = function(code) env.logs[#env.logs + 1] = code; return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_true(controller:start({ fight_id = "ga-medical-test" }).ok, "medical controller starts")
    function env:advance(delta) self.now = (self.now + delta) % 4294967296 end
    return env, controller, registry
end

local function runtime_npc_medical_prioritizes_health_and_applies_thirteen_bounded_pulses()
    local env, controller = npc_medical_fixture({ health = 0.4, bleeding = 0.8 })
    gamma_arena_test_assert.is_true(controller:update().ok, "low health schedules medicine")
    env:advance(1000)
    gamma_arena_test_assert.is_true(controller:update().ok, "veteran delay expires deterministically")
    gamma_arena_test_assert.equals(env.consumed[1], "medkit", "health has priority over bleeding")
    for _ = 1, 12 do env:advance(250); gamma_arena_test_assert.is_true(controller:update().ok, "medkit pulse advances") end
    gamma_arena_test_assert.equals(env.health_pulses, 13, "medkit applies exactly thirteen pulses")
    gamma_arena_test_assert.is_true(env.health <= 1, "medkit pulses never exceed full health")
    gamma_arena_test_assert.is_true(env.bleeding <= 0.01, "medkit caps bleeding")
    gamma_arena_test_assert.is_true(env.hidden_clears >= 13, "hidden healing charge is cleared on every reconciliation")
end

local function runtime_npc_medical_bandage_threshold_and_cancellation_are_fail_closed()
    local env, controller = npc_medical_fixture({ health = 0.6, bleeding = 0.15 })
    gamma_arena_test_assert.is_true(controller:update().ok, "exact thresholds do not schedule")
    env:advance(1000); controller:update()
    gamma_arena_test_assert.equals(#env.consumed, 0, "exact health and bleeding thresholds are strict")
    env.bleeding = 0.16
    env:advance(250); controller:update()
    env:advance(1000); controller:update()
    gamma_arena_test_assert.equals(env.consumed[1], "bandage", "bleeding above threshold consumes bandage")
    gamma_arena_test_assert.equals(env.bleeding, 0.07, "bandage caps bleeding without adding health")
    gamma_arena_test_assert.equals(env.health_pulses, 0, "bandage never heals health")

    local cancelled, stopped = npc_medical_fixture({ health = 0.4, bleeding = 0.8 })
    stopped:update()
    cancelled.alive = false
    cancelled:advance(1000); stopped:update()
    gamma_arena_test_assert.equals(#cancelled.consumed, 0, "death cancels a pending action before consumption")
    gamma_arena_test_assert.is_true(stopped:stop("teardown").ok, "teardown stops medical controller")
    cancelled.alive = true; cancelled:advance(1000); stopped:update()
    gamma_arena_test_assert.equals(#cancelled.consumed, 0, "stopped controller cannot consume or pulse")
end

local function runtime_save_guard_suppresses_only_owned_save_commands()
    local env = { calls = {}, checkpoints = {}, removed = {}, now = 100 }
    local function original(command, ...)
        env.calls[#env.calls + 1] = { command = command, args = { ... } }
        return "delegated", select("#", ...)
    end
    env.execute = original
    local guard = gamma_arena_save_guard.new({
        get_execute = function() return env.execute end,
        set_execute = function(value) env.execute = value; return true end,
        remove_time_event = function(kind, name) env.removed[#env.removed + 1] = { kind = kind, name = name }; return true end,
        clock = function() return env.now end,
        checkpoint = function(code, context) env.checkpoints[#env.checkpoints + 1] = { code = code, context = context }; return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_true(guard:install().ok, "save guard installs")
    gamma_arena_test_assert.is_true(guard:install().ok, "save guard installation is idempotent")
    gamma_arena_test_assert.is_true(guard:arm({ level = "fake_start", launch = "owned" }).ok, "Arena launch arms guard")
    local blocked = { env.execute("  SaVe player - autosave", "sentinel") }
    gamma_arena_test_assert.equals(#env.calls, 0, "armed Arena save never reaches original console executor")
    gamma_arena_test_assert.equals(#blocked, 0, "suppressed save has no fabricated engine result")
    local first, second = env.execute("cfg_save", "one", "two")
    gamma_arena_test_assert.equals(first, "delegated", "non-save command preserves first result")
    gamma_arena_test_assert.equals(second, 2, "non-save command preserves exact varargs")
    gamma_arena_test_assert.equals(env.calls[1].command, "cfg_save", "cfg_save is not misclassified as a game save")
    gamma_arena_test_assert.is_true(guard:maintain().ok, "known GAMMA timer cancellation succeeds")
    gamma_arena_test_assert.equals(env.removed[1].kind, 0, "known GAMMA timer uses event type zero")
    gamma_arena_test_assert.equals(env.removed[1].name, "delay_new_game_autosave", "known GAMMA autosave event is cancelled")
    gamma_arena_test_assert.is_true(guard:disarm({ reason = "test" }).ok, "guard disarms")
    env.execute("save campaign")
    gamma_arena_test_assert.equals(env.calls[2].command, "save campaign", "disarmed campaign save delegates unchanged")
    gamma_arena_test_assert.equals(env.checkpoints[2].code, "GA_SAVE_COMMAND_SUPPRESSED", "blocked save emits compact evidence")
end

local function runtime_diagnostics_checkpoint_is_bounded_flushed_and_closed()
    local env = { writes = {}, flushes = 0, closes = 0 }
    local handle = {}
    function handle:write(value) env.writes[#env.writes + 1] = value; return true end
    function handle:flush() env.flushes = env.flushes + 1; return true end
    function handle:close() env.closes = env.closes + 1; return true end
    local journal = gamma_arena_diagnostics.new({
        path = "gamma_arena_diagnostics.log",
        open = function(path, mode)
            gamma_arena_test_assert.equals(path, "gamma_arena_diagnostics.log", "journal uses injected path")
            gamma_arena_test_assert.equals(mode, "a", "journal is append-only")
            return handle
        end,
        clock = function() return 123 end,
        level = function() return "l05_bar" end,
        fallback_log = function() end
    })
    local written = journal:checkpoint("GA_TEST_CHECKPOINT", { aaa_noise = string.rep("x", 1500), weapon_section = "wpn_exact_evidence", nested = { forbidden = true } })
    gamma_arena_test_assert.is_true(written.ok, "checkpoint succeeds")
    gamma_arena_test_assert.is_true(#env.writes[1] <= 1024, "checkpoint line stays within native-safe bound")
    gamma_arena_test_assert.equals(env.flushes, 1, "checkpoint flushes immediately")
    gamma_arena_test_assert.equals(env.closes, 1, "checkpoint closes immediately")
    gamma_arena_test_assert.is_true(not env.writes[1]:find("forbidden", 1, true), "nested fields are excluded")
    gamma_arena_test_assert.is_true(env.writes[1]:find("weapon_section=wpn_exact_evidence", 1, true) ~= nil, "critical weapon identity survives bounded truncation")
end

local function runtime_diagnostics_checkpoint_rejects_nil_io_results()
    for _, failed_method in ipairs({ "write", "flush", "close" }) do
        local handle = {}
        function handle:write() if failed_method == "write" then return nil, "disk full" end; return true end
        function handle:flush() if failed_method == "flush" then return nil, "flush failed" end; return true end
        function handle:close() if failed_method == "close" then return nil, "close failed" end; return true end
        local fallbacks = 0
        local journal = gamma_arena_diagnostics.new({
            path = "gamma_arena_diagnostics.log",
            open = function() return handle end,
            fallback_log = function() fallbacks = fallbacks + 1 end
        })
        local result = journal:checkpoint("GA_TEST_IO_FAILURE", { weapon_section = "wpn_test" })
        gamma_arena_test_assert.is_false(result.ok, failed_method .. " nil result rejects the durable checkpoint")
        gamma_arena_test_assert.equals(result.error.code, "GA_DIAGNOSTICS_WRITE_FAILED", failed_method .. " failure code is stable")
        gamma_arena_test_assert.equals(fallbacks, 1, failed_method .. " failure reaches fallback logging once")
    end
end

local function runtime_diagnostics_checkpoint_rejects_oversized_required_metadata()
    local opens, fallbacks = 0, 0
    local journal = gamma_arena_diagnostics.new({
        path = "gamma_arena_diagnostics.log",
        open = function()
            opens = opens + 1
            return nil
        end,
        fallback_log = function() fallbacks = fallbacks + 1 end
    })
    local result = journal:checkpoint("GA_ACTOR_WEAPON_PRE_ACTIVATE", {
        weapon_section = "wpn_test",
        hud_item_visual = string.rep("x", 1500)
    })
    gamma_arena_test_assert.is_false(result.ok, "oversized required metadata rejects the durable checkpoint")
    gamma_arena_test_assert.equals(result.error.code, "GA_DIAGNOSTICS_RECORD_TOO_LARGE", "oversized metadata failure code is stable")
    gamma_arena_test_assert.equals(opens, 0, "oversized required metadata is rejected before opening the journal")
    gamma_arena_test_assert.equals(fallbacks, 1, "oversized required metadata reaches fallback logging once")
end

local function runtime_weapon_diagnostics_reads_effective_hud_metadata()
    local sections = {
        wpn_test = {
            kind="w_rifle", slot="2", ammo_class="ammo_test, ammo_test_ap", parent_section="wpn_test",
            visual="dynamics\\weapons\\wpn_test\\wpn_test_world.ogf", hud="wpn_test_hud"
        },
        wpn_test_hud = {
            item_visual="dynamics\\weapons\\wpn_test\\wpn_test_hud.ogf",
            anm_show="test_draw", anm_idle="test_idle", anm_idle_empty="test_idle_empty", anm_hide="test_holster"
        }
    }
    local result = gamma_arena_weapon_diagnostics.snapshot({
        read_string = function(section, key)
            local values = sections[section]
            return values and values[key] or nil
        end,
        object_id = function(object) return object:id() end
    }, {
        session_id="ga-metadata-session", fight_index=7, fight_id="ga-metadata-fight", phase="pre_activate",
        weapon_section="wpn_test", ammo_section="ammo_test", actor={ id=function() return 77 end }, item={ id=function() return 991 end }
    })
    gamma_arena_test_assert.is_true(result.ok, "effective weapon metadata snapshot succeeds")
    local fields = result.value
    gamma_arena_test_assert.equals(fields.actor_id, 77, "metadata includes actor identity")
    gamma_arena_test_assert.equals(fields.item_id, 991, "metadata includes item identity")
    gamma_arena_test_assert.equals(fields.weapon_kind, "w_rifle", "metadata includes effective weapon kind")
    gamma_arena_test_assert.equals(fields.weapon_slot, "2", "metadata includes effective weapon slot")
    gamma_arena_test_assert.equals(fields.ammo_section, "ammo_test", "metadata includes selected ammo section")
    gamma_arena_test_assert.equals(fields.ammo_class, "ammo_test, ammo_test_ap", "metadata includes effective ammo class")
    gamma_arena_test_assert.equals(fields.parent_section, "wpn_test", "metadata includes effective parent section")
    gamma_arena_test_assert.equals(fields.world_visual, "dynamics\\weapons\\wpn_test\\wpn_test_world.ogf", "metadata includes world visual")
    gamma_arena_test_assert.equals(fields.hud_section, "wpn_test_hud", "metadata includes effective HUD section")
    gamma_arena_test_assert.equals(fields.hud_item_visual, "dynamics\\weapons\\wpn_test\\wpn_test_hud.ogf", "metadata includes HUD visual")
    gamma_arena_test_assert.equals(fields.hud_anm_show, "test_draw", "metadata includes show animation")
    gamma_arena_test_assert.equals(fields.hud_anm_idle, "test_idle", "metadata includes idle animation")
    gamma_arena_test_assert.equals(fields.hud_anm_idle_empty, "test_idle_empty", "metadata includes empty-idle animation")
    gamma_arena_test_assert.equals(fields.hud_anm_hide, "test_holster", "metadata includes hide animation")
end

local function runtime_weapon_diagnostics_missing_reads_are_unavailable()
    local result = gamma_arena_weapon_diagnostics.snapshot({
        read_string = function() error("injected effective INI read failure") end,
        object_id = function() error("injected object id failure") end
    }, {
        session_id="ga-metadata-session", fight_index=8, fight_id="ga-metadata-missing", phase="selected",
        weapon_section="wpn_missing", ammo_section="ammo_missing", actor={}
    })
    gamma_arena_test_assert.is_true(result.ok, "metadata read failures never reject an otherwise valid weapon")
    for _, key in ipairs({ "actor_id", "item_id", "weapon_kind", "weapon_slot", "ammo_class", "parent_section", "world_visual", "hud_section", "hud_item_visual", "hud_anm_show", "hud_anm_idle", "hud_anm_idle_empty", "hud_anm_hide" }) do
        gamma_arena_test_assert.equals(result.value[key], "unavailable", "missing metadata is explicit: " .. key)
    end
end

local function runtime_entity_forensics_are_bounded_non_mutating_and_classified()
    local env = { now = 1000, tags = { [7] = "ga_forensic_session" } }
    local npc = {
        health = 1,
        bleeding = 0,
        id = function() return 7 end,
        alive = function() return true end,
        critically_wounded = function() return false end
    }
    local source = { id = function() return 7 end }
    local adapter = gamma_arena_entity_adapter.new({
        clock = function() return env.now end,
        load_tag = function(id) return env.tags[id] end,
        object_health = function(object) return object.health end,
        object_bleeding = function(object) return object.bleeding end,
        object_position = function() return { x = 0, y = 0, z = 0 } end,
        last_hitter_name = function() return nil end,
        last_hitter_section = function() return nil end,
        entity_section = function(object) return object == source and "self_source" or "arena_victim" end,
        is_critically_wounded = function(object) return object:critically_wounded() end
    })
    adapter.state_value = "ACTIVE"
    adapter.session_id = "ga_forensic_session"
    adapter.active_started_at = 1000
    local record = {
        kind = "npc", id = 7, slot = 1, tagged = true, released = false,
        terminal_state = "ALIVE", spawn_position = { x = 0, y = 0, z = 0 },
        forensic_hits = {}, forensic_samples = {}
    }
    adapter.npc_by_id[7] = record
    adapter.registry.npcs = { record }
    local hit = { draftsman = source, power = 0.75, impulse = 2, type = 3, weapon_id = 9 }
    local flags = { ret = false }
    gamma_arena_test_assert.is_true(adapter:on_npc_before_hit(npc, hit, 4, flags).ok, "owned before-hit evidence is captured")
    gamma_arena_test_assert.equals(hit.power, 0.75, "forensics never mutates hit power")
    gamma_arena_test_assert.equals(hit.impulse, 2, "forensics never mutates hit impulse")
    gamma_arena_test_assert.is_false(flags.ret, "forensics never mutates callback flags")
    gamma_arena_test_assert.equals(record.forensic_hits[1].source_id, 7, "before-hit source identity is copied")
    for index = 1, 20 do
        env.now = env.now + 10
        adapter:on_npc_hit(npc, index / 100, { x = 1, y = 0, z = 0 }, source, 4)
    end
    gamma_arena_test_assert.equals(#record.forensic_hits, 12, "hit ring retains only the newest twelve entries")
    for index = 1, 20 do adapter:sample_forensics(record, npc, 1000 + index * 250) end
    gamma_arena_test_assert.equals(#record.forensic_samples, 12, "state ring retains only the newest twelve entries")
    gamma_arena_test_assert.is_false(adapter:sample_forensics(record, npc, 22000), "periodic sampling stops after twenty seconds")
    gamma_arena_test_assert.equals(adapter:classify_forensics(record), "self_hit_observed", "proved self hit has diagnostic priority")

    local function classified(hits, baseline, samples)
        local candidate = { id = 7, forensic_hits = hits or {}, forensic_baseline = baseline, forensic_samples = samples or {} }
        return adapter:classify_forensics(candidate)
    end
    gamma_arena_test_assert.equals(classified({ { source_id = 8 } }), "external_hit_observed", "different hit source is external")
    gamma_arena_test_assert.equals(classified({}, { health = 1, bleeding = 0 }, { { health = 0.8, bleeding = 0, displacement = 0 } }), "health_decay_without_hit", "health decay without hit is distinguished")
    gamma_arena_test_assert.equals(classified({}, { health = 1, bleeding = 0 }, { { health = 0.8, bleeding = 0, displacement = 3 } }), "position_or_collision_candidate", "movement plus health loss is a collision candidate")
    gamma_arena_test_assert.equals(classified({}, nil, {}), "unresolved", "missing evidence remains unresolved")
    gamma_arena_test_assert.equals(classified({ { source_id = nil } }, { health = 1 }, { { health = 0.5 } }), "unresolved", "captured hit with unreadable source is not mislabeled as hit-free decay")
    gamma_arena_test_assert.is_true(adapter:on_npc_before_hit({ id = function() return 99 end }, hit, 4, flags).value == false, "foreign NPCs are ignored")
end

local function runtime_battle_identity_formatter_is_exact()
    local translated = function(key)
        return ({
            st_gamma_arena_battle_seed = "Seed",
            st_gamma_arena_battle_fight = "Fight"
        })[key]
    end
    local first = gamma_arena_ui_battle.format_identity({ session_seed = 1, fight_index = 0 }, translated)
    gamma_arena_test_assert.is_true(first.ok, "minimum battle identity formats")
    gamma_arena_test_assert.equals(first.value, "Fight: 1 | Seed: 1", "first fight is one-based and fight-first")
    local maximum = gamma_arena_ui_battle.format_identity({
        session_seed = 2147483646,
        fight_index = 4294967295
    }, translated)
    gamma_arena_test_assert.is_true(maximum.ok, "maximum battle identity formats")
    gamma_arena_test_assert.equals(maximum.value, "Fight: 4294967296 | Seed: 2147483646", "maximum identity stays exact")
    for _, model in ipairs({
        {},
        { session_seed = 0, fight_index = 0 },
        { session_seed = 1.5, fight_index = 0 },
        { session_seed = 1, fight_index = -1 },
        { session_seed = 1, fight_index = 4294967296 }
    }) do
        gamma_arena_test_assert.is_false(gamma_arena_ui_battle.format_identity(model, translated).ok, "invalid battle identity rejects")
    end
    gamma_arena_test_assert.is_false(gamma_arena_ui_battle.format_identity({ session_seed = 1, fight_index = 0 }, function() error("translate") end).ok, "translation exception is structured")
end

local function runtime_battle_identity_adapter_owns_one_window()
    local env = { adds = 0, removes = 0, created = 0 }
    local hud = {
        AddDialogToRender = function(_, window) env.adds = env.adds + 1; env.added = window end,
        RemoveDialogToRender = function(_, window) env.removes = env.removes + 1; env.removed = window end
    }
    local ui = gamma_arena_ui_battle.new({
        translate = function(key) return key == "st_gamma_arena_battle_seed" and "Seed" or "Fight" end,
        hud = function() return hud end,
        create_window = function(text)
            env.created = env.created + 1
            return {
                text = text,
                SetIdentity = function(self, value) self.text = value end
            }
        end
    })
    gamma_arena_test_assert.is_true(ui:show_identity({ session_seed = 42, fight_index = 0 }).ok, "battle identity shows")
    gamma_arena_test_assert.is_true(ui:show_identity({ session_seed = 42, fight_index = 1 }).ok, "battle identity refreshes")
    gamma_arena_test_assert.equals(env.created, 1, "one battle identity window is owned")
    gamma_arena_test_assert.equals(env.adds, 1, "battle identity window is registered once")
    gamma_arena_test_assert.equals(env.added.text, "Fight: 2 | Seed: 42", "existing battle identity window refreshes")
    gamma_arena_test_assert.is_true(ui:clear_identity().ok, "battle identity clears")
    gamma_arena_test_assert.is_true(ui:clear_identity().ok, "duplicate battle identity clear is idempotent")
    gamma_arena_test_assert.equals(env.removes, 1, "owned battle identity window is removed once")
    gamma_arena_test_assert.equals(env.removed, env.added, "battle identity removes the exact owned window")
end

local function runtime_battle_identity_removal_failure_is_retryable()
    local attempts = 0
    local window = { SetIdentity = function() end }
    local hud = {
        AddDialogToRender = function() end,
        RemoveDialogToRender = function()
            attempts = attempts + 1
            if attempts == 1 then error("remove") end
        end
    }
    local ui = gamma_arena_ui_battle.new({
        translate = function(key) return key == "st_gamma_arena_battle_seed" and "Seed" or "Fight" end,
        hud = function() return hud end,
        create_window = function() return window end
    })
    gamma_arena_test_assert.is_true(ui:show_identity({ session_seed = 42, fight_index = 0 }).ok, "retry fixture shows")
    gamma_arena_test_assert.is_false(ui:clear_identity().ok, "first battle identity removal failure is structured")
    gamma_arena_test_assert.is_true(ui:clear_identity().ok, "second battle identity removal retries")
    gamma_arena_test_assert.equals(attempts, 2, "failed battle identity removal retains ownership")
end

local function runtime_battle_identity_initialization_failure_prevents_registration()
    local adds = 0
    local ui = gamma_arena_ui_battle.new({
        translate = function(key) return key == "st_gamma_arena_battle_seed" and "Seed" or "Fight" end,
        hud = function()
            return { AddDialogToRender = function() adds = adds + 1 end }
        end,
        create_window = function()
            return {
                initialization_result = gamma_arena_result.err(
                    "GA_TEST_BATTLE_UI_TEXT_FAILED",
                    "injected SetIdentity failure"
                ),
                SetIdentity = function() end
            }
        end
    })
    local shown = ui:show_identity({ session_seed = 42, fight_index = 0 })
    gamma_arena_test_assert.is_false(shown.ok, "failed battle identity initialization is structured")
    gamma_arena_test_assert.equals(shown.error.code, "GA_TEST_BATTLE_UI_TEXT_FAILED", "SetIdentity failure is preserved")
    gamma_arena_test_assert.equals(adds, 0, "uninitialized battle identity is never registered")
    gamma_arena_test_assert.is_true(ui:clear_identity().ok, "failed initialization owns no window")
end

local function runtime_battle_identity_partial_add_is_rolled_back_or_retryable()
    local env = { adds = 0, removes = 0, fail_add = true, fail_remove = true }
    local window = { SetIdentity = function() end }
    local hud = {
        AddDialogToRender = function(_, added)
            env.adds = env.adds + 1
            env.registered = added
            if env.fail_add then error("after add") end
        end,
        RemoveDialogToRender = function(_, removed)
            env.removes = env.removes + 1
            gamma_arena_test_assert.equals(removed, window, "rollback removes the exact pending window")
            if env.fail_remove then error("remove") end
            env.registered = nil
        end
    }
    local ui = gamma_arena_ui_battle.new({
        translate = function(key) return key == "st_gamma_arena_battle_seed" and "Seed" or "Fight" end,
        hud = function() return hud end,
        create_window = function() return window end
    })
    local shown = ui:show_identity({ session_seed = 42, fight_index = 0 })
    gamma_arena_test_assert.is_false(shown.ok, "throw-after-add remains a structured show failure")
    gamma_arena_test_assert.equals(env.adds, 1, "partial add is attempted once")
    gamma_arena_test_assert.equals(env.removes, 1, "partial add triggers immediate rollback")
    gamma_arena_test_assert.equals(env.registered, window, "failed rollback retains pending ownership")
    env.fail_add = false
    env.fail_remove = false
    gamma_arena_test_assert.is_true(ui:show_identity({ session_seed = 42, fight_index = 1 }).ok, "later show cleans pending registration and retries add")
    gamma_arena_test_assert.equals(env.adds, 2, "show retry performs a fresh native add")
    gamma_arena_test_assert.equals(env.removes, 2, "show retry first resolves the failed rollback")
    gamma_arena_test_assert.equals(env.registered, window, "show retry confirms the newly registered window")
    gamma_arena_test_assert.is_true(ui:clear_identity().ok, "confirmed retry remains removable")
    gamma_arena_test_assert.equals(env.removes, 3, "confirmed retry is removed once")
    gamma_arena_test_assert.equals(env.registered, nil, "retry removes the pending window")
end

local function runtime_battle_identity_main_hud_visibility_is_safe()
    gamma_arena_test_assert.is_true(gamma_arena_ui_battle.main_hud_visible(function() return true end), "visible main HUD shows battle identity")
    gamma_arena_test_assert.is_false(gamma_arena_ui_battle.main_hud_visible(function() return false end), "hidden main HUD hides battle identity")
    gamma_arena_test_assert.is_false(gamma_arena_ui_battle.main_hud_visible(function() error("hud") end), "HUD visibility exception hides safely")
    gamma_arena_test_assert.is_false(gamma_arena_ui_battle.main_hud_visible(nil), "missing HUD visibility port hides safely")
end

local function runtime_battle_identity_visibility_sync_is_structured()
    local root = {
        Show = function(self, visible)
            self.visible = visible
            self.transitions = (self.transitions or 0) + 1
        end
    }
    local visible = gamma_arena_ui_battle.sync_visibility(root, function() return true end)
    gamma_arena_test_assert.is_true(visible.ok, "visible HUD visibility sync succeeds")
    gamma_arena_test_assert.is_true(root.visible, "visible main HUD shows battle identity")
    local failed = gamma_arena_ui_battle.sync_visibility(root, function() error("hud") end)
    gamma_arena_test_assert.is_false(failed.ok, "visibility port error is structured")
    gamma_arena_test_assert.is_false(root.visible, "visibility port error hides an already visible identity")
    gamma_arena_test_assert.equals(root.transitions, 2, "visibility failure performs an explicit fail-closed transition")
    gamma_arena_test_assert.is_false(gamma_arena_ui_battle.sync_visibility({}, function() return true end).ok, "missing root Show is structured")
end

local function runtime_battle_identity_visibility_failure_reporting_is_bounded()
    local owner = {}
    local reports = {}
    local reporter = function(result) reports[#reports + 1] = result.error.code end
    local failed = gamma_arena_result.err("GA_TEST_VISIBILITY", "injected visibility failure")
    gamma_arena_test_assert.is_true(gamma_arena_ui_battle.report_visibility_failure_once(owner, failed, reporter).ok, "first visibility error is reportable")
    gamma_arena_test_assert.is_true(gamma_arena_ui_battle.report_visibility_failure_once(owner, failed, reporter).ok, "duplicate visibility error is bounded")
    gamma_arena_test_assert.equals(#reports, 1, "contiguous visibility error is reported once")
    gamma_arena_test_assert.is_true(gamma_arena_ui_battle.report_visibility_failure_once(owner, gamma_arena_result.ok(false), reporter).ok, "visibility recovery resets the bound")
    gamma_arena_test_assert.is_true(gamma_arena_ui_battle.report_visibility_failure_once(owner, failed, reporter).ok, "post-recovery visibility error is reportable")
    gamma_arena_test_assert.equals(#reports, 2, "post-recovery visibility error reports once again")
end

