local function clone(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then return seen[value] end
    local copy = {}
    seen[value] = copy
    for key, item in pairs(value) do copy[clone(key, seen)] = clone(item, seen) end
    return copy
end

local function valid_session()
    return {
        schema_version = 1,
        session_id = "ga_test_session",
        session_nonce = "ga_test_nonce",
        mode_id = "skirmish",
        difficulty_id = "stalker",
        session_seed = 42,
        fight_index = 0,
        generator_version = 1,
        catalog_revision = 1,
        layout_id = "rostok_arena_v1",
        checkpoint_name = "_gamma_arena_checkpoint",
        phase = "CHECKPOINTING"
    }
end

local function catalogs()
    local loaded = gamma_arena_catalog.load(gamma_arena_test_generator.fixture_factory())
    gamma_arena_test_assert.is_true(loaded.ok, "runtime tests require the v1 catalog fixture")
    return loaded.value
end

local function all_sections(snapshot)
    local sections = {}
    for _, profile in ipairs(snapshot.profile_list) do sections[profile.section] = { class = "AI_STL_S", community = profile.runtime_community } end
    for _, weapon in ipairs(snapshot.weapon_list) do sections[weapon.section] = { slot = weapon.slot, ammo_mag_size = 30 } end
    for _, ammo in pairs(snapshot.ammo) do sections[ammo.section] = { box_size = 20 } end
    for _, outfit in ipairs(snapshot.outfit_list) do sections[outfit.section] = { slot = 6 } end
    for _, knife in ipairs(snapshot.knife_list) do sections[knife.section] = { slot = 0 } end
    for _, device in ipairs(snapshot.device_list or {}) do sections[device.section] = { class = "TORCH_S", slot = 9, nv_effect = device.nv_effect } end
    for _, consumable in pairs(snapshot.consumables) do sections[consumable.section] = {} end
    for _, medical in pairs(snapshot.medical_items or {}) do sections[medical.section] = {} end
    return sections
end

local function callable_object(fn)
    return setmetatable({}, {
        __call = function(_, ...)
            return fn(...)
        end
    })
end

local function valid_preflight_probes()
    local snapshot = catalogs()
    local sections = all_sections(snapshot)
    local positions = {}
    local paths = {
        snapshot.layouts.rostok_arena_v1.actor_spawn_path,
        snapshot.layouts.rostok_arena_v1.actor_look_path,
        bar_arena_walk_attack
    }
    for _, path in ipairs(snapshot.layouts.rostok_arena_v1.opponent_spawn_paths) do paths[#paths + 1] = path end
    for index, path in ipairs(paths) do
        local point = { x = index * 10, y = 0, z = index * 20 }
        function point:sub(other)
            local result = { x = self.x - other.x, y = self.y - other.y, z = self.z - other.z }
            function result:getH() return 0 end
            function result:sub(value) return self end
            return result
        end
        function point:getH() return 0 end
        positions[path] = point
    end

    local system = {}
    function system:section_exist(section) return sections[section] ~= nil end
    function system:line_exist(section, key) return sections[section] and sections[section][key] ~= nil end
    function system:r_string_ex(section, key) return sections[section] and sections[section][key] or nil end
    function system:r_u32(section, key) return sections[section] and sections[section][key] or nil end

    local config = {}
    function config:r_value() return nil end
    function config:r_string_ex() return nil end
    function config:line_exist() return false end
    function config:w_value() return true end
    function config:remove_line() return true end
    function config:save() return true end

    local tactical_values = {
        observation_interval_ms = 500,
        report_delay_min_ms = 1000,
        report_delay_max_ms = 3000,
        assignment_dwell_ms = 5000,
        visual_aging_ms = 20000,
        evidence_expiry_ms = 60000,
        hint_delay_ms = 60000,
        hint_cooldown_ms = 60000,
        look_path = "bar_arena_walk_attack"
    }
    local tactical_sections = { meta = true, director = true }
    for _, path in ipairs(snapshot.layouts.rostok_arena_v1.opponent_spawn_paths) do
        tactical_sections["logic@ga_" .. path] = true
        tactical_sections["walker@ga_" .. path] = true
    end
    local tactical_ini = {}
    function tactical_ini:section_exist(section) return tactical_sections[section] == true end
    function tactical_ini:line_exist(section, key) return section == "director" and tactical_values[key] ~= nil end
    function tactical_ini:r_u32(section, key) return section == "director" and tactical_values[key] or nil end
    function tactical_ini:r_string_ex(section, key) return section == "director" and tactical_values[key] or nil end

    local npc_medical_values = {}
    local npc_medical_ini = {}
    function npc_medical_ini:section_exist(section) return section == "plugin" end
    function npc_medical_ini:line_exist(section, key) return section == "plugin" and npc_medical_values[key] ~= nil end
    function npc_medical_ini:r_string_ex(section, key) return section == "plugin" and npc_medical_values[key] or nil end

    local fs = {}
    function fs:update_path() return "C:\\fake\\appdata\\savedgames\\" end
    function fs:exist() return false end
    function fs:file_rename() return true end
    function fs:file_delete() return true end

    local actor = {}
    function actor:iterate_inventory() end
    function actor:id() return 1 end
    function actor:money() return 0 end
    function actor:give_money() return true end
    function actor:set_health_ex() return true end
    actor.power = 0.25
    actor.radiation = 0.5
    actor.bleeding = 0.75
    actor.psy_health = 0.5
    function actor:set_actor_position() return true end
    function actor:set_actor_direction() return true end
    function actor:set_invulnerable() return true end
    function actor:position() return positions[snapshot.layouts.rostok_arena_v1.actor_spawn_path] end
    function actor:move_to_slot() return true end
    function actor:item_in_slot() return nil end
    function actor:make_item_active() return true end
    function actor:active_item() return nil end
    local arena_zone = {}
    function arena_zone:inside() return true end

    local probes = {
        RegisterScriptCallback = function() end,
        UnregisterScriptCallback = function() end,
        ini_file = function() return {} end,
        system_ini = function() return system end,
        alife = function() return { get_children = function() return {} end, object = function() return nil end, set_switch_online = function() return true end, set_switch_offline = function() return true end } end,
        alife_create = function() return {} end,
        alife_create_item = function() return {} end,
        alife_release_id = function() return true end,
        getFS = function() return fs end,
        exec_console_cmd = function() return true end,
        time_global = function() return 0 end,
        se_save_var = function() return true end,
        se_load_var = function() return true end,
        patrol = function(path)
            local patrol_object = {}
            function patrol_object:point() return clone(positions[path]) end
            function patrol_object:level_vertex_id() return 100 + #path end
            function patrol_object:game_vertex_id() return 200 + #path end
            return patrol_object
        end,
        level = {
            name = function() return "l05_bar" end,
            patrol_path_exists = function(path) return positions[path] ~= nil end,
            object_by_id = function() return nil end,
            disable_input = function() return true end,
            enable_input = function() return true end
        },
        db = { actor = actor, zone_by_name = { bar_arena_sr = arena_zone } },
        game_object = { friend = 1, enemy = 2, name = function() return "test_npc" end, change_health = function() return true end, set_ammo_elapsed = function() end, get_ammo_in_magazine = function() return 0 end, condition = function() return 1 end, set_condition = function() end, enable_torch = function() end, critically_wounded = function() return false end },
        xr_logic = {
            configure_schemes = function() return true end,
            activate_by_section = function() return true end,
            switch_to_section = function() return true end
        },
        modules = { stype_stalker = 1 },
        tactical_ini = function() return tactical_ini end,
        npc_medical_ini = function() return npc_medical_ini end,
        relation_registry = { set_goodwill = function() return true end },
        axr_main = { config = config },
        safe_release_manager = { release = function() return true end },
        item_device = { is_nv_active=function() return false end, set_nightvision=function() end, is_torch_active=function() return false end, toggle_torch=function() end },
        catalogs = snapshot,
        _sections = sections,
        _positions = positions,
        _tactical_values = tactical_values,
        _tactical_sections = tactical_sections,
        _npc_medical_values = npc_medical_values
    }
    return probes
end

local function error_codes(result)
    local values = {}
    local errors = result.error and result.error.context and result.error.context.errors or {}
    for index = 1, #errors do values[#values + 1] = errors[index].code end
    return table.concat(values, ",")
end

local function preflight_accepts_complete_environment()
    local result = gamma_arena_compat.preflight(valid_preflight_probes())
    gamma_arena_test_assert.is_true(result.ok, "complete injected environment must pass preflight")
end

local function preflight_accepts_natural_death_without_invulnerability()
    local probes = valid_preflight_probes()
    probes.db.actor.set_invulnerable = nil
    probes.db.actor.invulnerable = nil
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_true(result.ok, "natural actor death must not require an invulnerability port")
end

local function preflight_accepts_callable_engine_objects()
    local probes = valid_preflight_probes()
    probes.ini_file = callable_object(probes.ini_file)
    probes.patrol = callable_object(probes.patrol)
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_true(result.ok, "callable engine objects must pass preflight even when Lua type is not function")
end

local function preflight_accepts_actor_condition_properties()
    local probes = valid_preflight_probes()
    probes.db.actor.set_power = nil
    probes.db.actor.set_radiation = nil
    probes.db.actor.set_bleeding = nil
    probes.db.actor.set_psy_health = nil
    probes.db.actor.power = 0.25
    probes.db.actor.radiation = 0.5
    probes.db.actor.bleeding = 0.75
    probes.db.actor.psy_health = 0.5
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_true(result.ok, "real Anomaly actor condition properties must satisfy preflight")
end

local function preflight_requires_tactical_director_apis()
    local cases = {
        { label = "configure", mutate = function(p) p.xr_logic.configure_schemes = nil end },
        { label = "activate", mutate = function(p) p.xr_logic.activate_by_section = nil end },
        { label = "switch", mutate = function(p) p.xr_logic.switch_to_section = nil end },
        { label = "stalker type", mutate = function(p) p.modules.stype_stalker = nil end },
        { label = "tactical ini", mutate = function(p) p.tactical_ini = nil end }
    }
    for _, case in ipairs(cases) do
        local probes = valid_preflight_probes()
        case.mutate(probes)
        local result = gamma_arena_compat.preflight(probes)
        gamma_arena_test_assert.is_false(result.ok, "missing tactical API fails: " .. case.label)
        gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_PREFLIGHT_DIRECTOR_API_MISSING", 1, true) ~= nil, "stable tactical API code: " .. case.label)
    end
end

local function preflight_requires_tactical_director_config()
    local cases = {
        {
            label = "invalid observation interval",
            code = "GA_PREFLIGHT_DIRECTOR_CONFIG_INVALID",
            mutate = function(p) p._tactical_values.observation_interval_ms = 0 end
        },
        {
            label = "missing route section",
            code = "GA_PREFLIGHT_DIRECTOR_SECTION_MISSING",
            mutate = function(p) p._tactical_sections["walker@ga_bar_arena_walk_3_1"] = nil end
        },
        {
            label = "missing look path",
            code = "GA_PREFLIGHT_DIRECTOR_LOOK_PATH_MISSING",
            mutate = function(p)
                local original = p.level.patrol_path_exists
                p.level.patrol_path_exists = function(path)
                    if path == "bar_arena_walk_attack" then return false end
                    return original(path)
                end
            end
        }
    }
    for _, case in ipairs(cases) do
        local probes = valid_preflight_probes()
        case.mutate(probes)
        local result = gamma_arena_compat.preflight(probes)
        gamma_arena_test_assert.is_false(result.ok, "invalid tactical config fails: " .. case.label)
        gamma_arena_test_assert.is_true(string.find(error_codes(result), case.code, 1, true) ~= nil, "stable tactical config code: " .. case.label)
    end
end

local function preflight_rejects_npc_medical_ai_conflict()
    for _, key in ipairs({ "medkits", "bandages" }) do
        local probes = valid_preflight_probes()
        probes._npc_medical_values[key] = key == "medkits" and "medkit" or "bandage"
        local result = gamma_arena_compat.preflight(probes)
        gamma_arena_test_assert.is_false(result.ok, "stock physical-item consumer conflict fails: " .. key)
        gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_NPC_MEDICAL_AI_CONFLICT", 1, true) ~= nil, "stock consumer conflict has a stable code: " .. key)
    end
end

local function preflight_aggregates_in_stable_order()
    local probes = valid_preflight_probes()
    probes.RegisterScriptCallback = nil
    probes.UnregisterScriptCallback = nil
    probes.ini_file = nil
    probes.safe_release_manager = nil
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "missing independent APIs must fail")
    gamma_arena_test_assert.equals(error_codes(result), "GA_PREFLIGHT_API_MISSING,GA_PREFLIGHT_API_MISSING,GA_PREFLIGHT_API_MISSING,GA_PREFLIGHT_API_MISSING", "API failures must be stably ordered")
    local errors = result.error.context.errors
    gamma_arena_test_assert.equals(errors[1].context.capability, "RegisterScriptCallback", "first required API")
    gamma_arena_test_assert.equals(errors[2].context.capability, "UnregisterScriptCallback", "rollback API order")
    gamma_arena_test_assert.equals(errors[3].context.capability, "ini_file", "third required API")
    gamma_arena_test_assert.equals(errors[4].context.capability, "safe_release_manager.release", "safe release API order")
end

local function preflight_requires_task6_actor_checkpoint_ports()
    local cases = {
        { capability = "exec_console_cmd", mutate = function(probes) probes.exec_console_cmd = nil end },
        { capability = "level.disable_input", mutate = function(probes) probes.level.disable_input = nil end },
        { capability = "db.actor.iterate_inventory", mutate = function(probes) probes.db.actor.iterate_inventory = nil end },
        { capability = "getFS.file_rename", mutate = function(probes) probes.getFS = function() return {} end end }
    }
    for _, case in ipairs(cases) do
        local probes = valid_preflight_probes()
        case.mutate(probes)
        local result = gamma_arena_compat.preflight(probes)
        gamma_arena_test_assert.is_false(result.ok, "missing Task 6 port must fail: " .. case.capability)
        local found = false
        for _, item in ipairs(result.error.context.errors or {}) do
            if item.context and item.context.capability == case.capability then found = true end
        end
        gamma_arena_test_assert.is_true(found, "preflight identifies missing Task 6 capability: " .. case.capability)
    end
end

local function preflight_requires_task7_entity_ports_and_ammo_metadata()
    local cases = {
        { capability = "alife().get_children", mutate = function(probes) probes.alife = function() return { object = function() end, set_switch_online = function() end, set_switch_offline = function() end } end end },
        { capability = "alife().object", mutate = function(probes) probes.alife = function() return { get_children = function() end, set_switch_online = function() end, set_switch_offline = function() end } end end },
        { capability = "alife().set_switch_online", mutate = function(probes) probes.alife = function() return { get_children = function() end, object = function() end, set_switch_offline = function() end } end end },
        { capability = "alife().set_switch_offline", mutate = function(probes) probes.alife = function() return { get_children = function() end, object = function() end, set_switch_online = function() end } end end },
        { capability = "se_load_var", mutate = function(probes) probes.se_load_var = nil end },
        { capability = "level.object_by_id", mutate = function(probes) probes.level.object_by_id = nil end },
        { capability = "game_object.friend", mutate = function(probes) probes.game_object.friend = nil end },
        { capability = "game_object.enemy", mutate = function(probes) probes.game_object.enemy = nil end },
        { capability = "system_ini.r_u32", mutate = function(probes) probes.system_ini().r_u32 = nil end }
    }
    for _, case in ipairs(cases) do
        local probes = valid_preflight_probes()
        case.mutate(probes)
        local result = gamma_arena_compat.preflight(probes)
        gamma_arena_test_assert.is_false(result.ok, "missing Task 7 port must fail: " .. case.capability)
        local found = false
        for _, item in ipairs(result.error.context.errors or {}) do
            if item.context and item.context.capability == case.capability then found = true end
        end
        gamma_arena_test_assert.is_true(found, "preflight identifies missing Task 7 capability: " .. case.capability)
    end

    local invalid = valid_preflight_probes()
    for _, ammo in pairs(invalid.catalogs.ammo) do invalid._sections[ammo.section].box_size = 0 end
    local result = gamma_arena_compat.preflight(invalid)
    gamma_arena_test_assert.is_false(result.ok, "nonpositive effective ammo box_size fails preflight")
    gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_AMMO_BOX_SIZE_INVALID", 1, true) ~= nil, "invalid effective ammo box_size has a deterministic code")
end

local function wrong_level_skips_patrol_resolution()
    local probes = valid_preflight_probes()
    local patrol_calls = 0
    probes.level.name = function() return "l01_escape" end
    probes.level.patrol_path_exists = function() patrol_calls = patrol_calls + 1; return true end
    probes.patrol = function() patrol_calls = patrol_calls + 1; error("must not resolve on wrong level") end
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "wrong level must fail")
    gamma_arena_test_assert.equals(result.error.context.errors[1].code, "GA_PREFLIGHT_LEVEL_INVALID", "wrong-level error")
    gamma_arena_test_assert.equals(patrol_calls, 0, "dependent patrol probes must be skipped")
end

local function preflight_requires_arena_boundary_restrictor()
    local missing = valid_preflight_probes()
    missing.db.zone_by_name.bar_arena_sr = nil
    local missing_result = gamma_arena_compat.preflight(missing)
    gamma_arena_test_assert.is_false(missing_result.ok, "missing Arena boundary restrictor fails preflight")
    gamma_arena_test_assert.is_true(string.find(error_codes(missing_result), "GA_PREFLIGHT_BOUNDARY_MISSING", 1, true) ~= nil, "missing boundary has stable code")

    local invalid = valid_preflight_probes()
    invalid.db.zone_by_name.bar_arena_sr.inside = nil
    local invalid_result = gamma_arena_compat.preflight(invalid)
    gamma_arena_test_assert.is_false(invalid_result.ok, "Arena boundary without inside API fails preflight")
    gamma_arena_test_assert.is_true(string.find(error_codes(invalid_result), "GA_PREFLIGHT_BOUNDARY_INVALID", 1, true) ~= nil, "invalid boundary has stable code")
end

local function preflight_rejects_missing_patrol()
    local probes = valid_preflight_probes()
    probes.level.patrol_path_exists = function(path) return path ~= "bar_arena_walk_6_3" end
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "missing patrol must fail")
    gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_PREFLIGHT_PATROL_MISSING", 1, true) ~= nil, "missing patrol code")
end

local function preflight_rejects_invalid_patrol_resolution()
    local probes = valid_preflight_probes()
    probes._positions.bar_arena_walk_3_1.x = 0 / 0
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "non-finite patrol point must fail")
    gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_PREFLIGHT_PATROL_INVALID", 1, true) ~= nil, "invalid patrol code")

    probes = valid_preflight_probes()
    local base_patrol = probes.patrol
    probes.patrol = function(path)
        local object = base_patrol(path)
        if path == "bar_arena_walk_3_1" then function object:level_vertex_id() return 4294967295 end end
        return object
    end
    result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "invalid X-Ray vertex sentinel must fail")
    gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_PREFLIGHT_PATROL_INVALID", 1, true) ~= nil, "vertex sentinel code")
end

local function preflight_rejects_missing_catalog_section()
    local probes = valid_preflight_probes()
    probes._sections.wpn_pm = nil
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "missing effective catalog section must fail")
    gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_PREFLIGHT_SECTION_MISSING", 1, true) ~= nil, "missing section code")
end

local function preflight_rejects_effective_mutant_class()
    local probes = valid_preflight_probes()
    probes._sections.gamma_arena_bandit_novice.class = "SM_POLTER"
    local result = gamma_arena_compat.preflight(probes)
    gamma_arena_test_assert.is_false(result.ok, "effective mutant class must fail")
    gamma_arena_test_assert.is_true(string.find(error_codes(result), "GA_NPC_CLASS_INVALID", 1, true) ~= nil, "human-only error")
end

local function has_profile_error(result, code, section)
    local errors = result.error and result.error.context and result.error.context.errors or {}
    for index = 1, #errors do
        local item = errors[index]
        if item.code == code and item.context and item.context.section == section then return true end
    end
    return false
end

local function preflight_requires_community_for_every_custom_profile()
    for _, profile in ipairs(catalogs().profile_list) do
        local section = profile.section

        local missing = valid_preflight_probes()
        missing._sections[section].community = nil
        local missing_result = gamma_arena_compat.preflight(missing)
        gamma_arena_test_assert.is_false(missing_result.ok, "missing effective community must fail for " .. section)
        gamma_arena_test_assert.is_true(has_profile_error(missing_result, "GA_NPC_COMMUNITY_MISSING", section), "missing community code for " .. section)

        local wrong = valid_preflight_probes()
        wrong._sections[section].community = "dolg"
        local wrong_result = gamma_arena_compat.preflight(wrong)
        gamma_arena_test_assert.is_false(wrong_result.ok, "wrong effective community must fail for " .. section)
        gamma_arena_test_assert.is_true(has_profile_error(wrong_result, "GA_NPC_COMMUNITY_INVALID", section), "wrong community code for " .. section)

        local throwing = valid_preflight_probes()
        local throwing_system = throwing.system_ini()
        local base_read = throwing_system.r_string_ex
        function throwing_system:r_string_ex(candidate, key)
            if candidate == section and key == "community" then error("injected community read failure") end
            return base_read(self, candidate, key)
        end
        local throw_result = gamma_arena_compat.preflight(throwing)
        gamma_arena_test_assert.is_false(throw_result.ok, "throwing effective community read must fail for " .. section)
        gamma_arena_test_assert.is_true(has_profile_error(throw_result, "GA_NPC_COMMUNITY_READ_FAILED", section), "community read failure code for " .. section)
    end
end

local function preflight_requires_human_class_for_every_custom_profile()
    for _, profile in ipairs(catalogs().profile_list) do
        local section = profile.section

        local missing = valid_preflight_probes()
        missing._sections[section].class = nil
        local missing_result = gamma_arena_compat.preflight(missing)
        gamma_arena_test_assert.is_true(has_profile_error(missing_result, "GA_NPC_CLASS_MISSING", section), "missing class code for " .. section)

        local wrong = valid_preflight_probes()
        wrong._sections[section].class = "SM_POLTER"
        local wrong_result = gamma_arena_compat.preflight(wrong)
        gamma_arena_test_assert.is_true(has_profile_error(wrong_result, "GA_NPC_CLASS_INVALID", section), "invalid class code for " .. section)

        local throwing = valid_preflight_probes()
        local throwing_system = throwing.system_ini()
        local base_read = throwing_system.r_string_ex
        function throwing_system:r_string_ex(candidate, key)
            if candidate == section and key == "class" then error("injected class read failure") end
            return base_read(self, candidate, key)
        end
        local throw_result = gamma_arena_compat.preflight(throwing)
        gamma_arena_test_assert.is_true(has_profile_error(throw_result, "GA_NPC_CLASS_READ_FAILED", section), "class read failure code for " .. section)
    end
end

local function preflight_rejects_missing_profile_value_apis()
    local no_line_exist = valid_preflight_probes()
    no_line_exist.system_ini().line_exist = nil
    local line_result = gamma_arena_compat.preflight(no_line_exist)
    gamma_arena_test_assert.is_false(line_result.ok, "missing effective line_exist must fail")
    for _, profile in ipairs(no_line_exist.catalogs.profile_list) do
        gamma_arena_test_assert.is_true(has_profile_error(line_result, "GA_NPC_CLASS_API_MISSING", profile.section), "class API error for " .. profile.section)
        gamma_arena_test_assert.is_true(has_profile_error(line_result, "GA_NPC_COMMUNITY_API_MISSING", profile.section), "community API error for " .. profile.section)
    end

    local no_reader = valid_preflight_probes()
    no_reader.system_ini().r_string_ex = nil
    local reader_result = gamma_arena_compat.preflight(no_reader)
    gamma_arena_test_assert.is_false(reader_result.ok, "missing effective r_string_ex must fail")
    for _, profile in ipairs(no_reader.catalogs.profile_list) do
        gamma_arena_test_assert.is_true(has_profile_error(reader_result, "GA_NPC_CLASS_API_MISSING", profile.section), "class reader error for " .. profile.section)
        gamma_arena_test_assert.is_true(has_profile_error(reader_result, "GA_NPC_COMMUNITY_API_MISSING", profile.section), "community reader error for " .. profile.section)
    end
end

local function preflight_normalizes_effective_arena_enemy_community()
    local probes = valid_preflight_probes()
    for _, profile in ipairs(probes.catalogs.profile_list) do probes._sections[profile.section].community = "  ARENA_ENEMY\t" end
    gamma_arena_test_assert.is_true(gamma_arena_compat.preflight(probes).ok, "normalized effective arena_enemy community must pass")
end

local function fake_store(intent_state)
    local store = {
        intent_state = intent_state or { launch_pending = false, resume_pending = false },
        consume_launch_count = 0,
        prepare_resume_count = 0,
        clear_count = 0,
        inspect_count = 0,
        mark_deferred_count = 0,
        validate_launch_activation_count = 0,
        validate_launch_ownership_count = 0,
        launch_deferred = false
    }
    function store:inspect_intents()
        self.inspect_count = self.inspect_count + 1
        if self.inspect_error then return self.inspect_error end
        return gamma_arena_result.ok(clone(self.intent_state))
    end
    function store:consume_launch()
        self.consume_launch_count = self.consume_launch_count + 1
        self.intent_state.launch_pending = false
        return self.launch_result or gamma_arena_result.ok({ schema_version = 1, mode_id = "skirmish", difficulty_id = "stalker", seed_mode = "manual", session_seed = 42 })
    end
    function store:mark_launch_deferred(_, current_level, expected_level)
        self.mark_deferred_count = self.mark_deferred_count + 1
        self.launch_deferred = true
        self.deferred_current_level = current_level
        self.deferred_expected_level = expected_level
        return gamma_arena_result.ok(true)
    end
    function store:validate_launch_activation(_, context)
        self.validate_launch_activation_count = self.validate_launch_activation_count + 1
        if self.activation_result then return self.activation_result end
        if context.serialized ~= true and context.current_level ~= context.expected_level and context.current_level ~= "fake_start" then
            return gamma_arena_result.err("GA_LAUNCH_REQUIRES_NEW_GAME", "direct launch is outside the target or fake_start route")
        end
        if context.serialized == true and (not self.launch_deferred
            or self.deferred_current_level ~= "fake_start"
            or self.deferred_expected_level ~= context.expected_level
            or context.current_level ~= context.expected_level) then
            return gamma_arena_result.err("GA_LAUNCH_REQUIRES_NEW_GAME", "serialized launch lacks fake_start handoff proof")
        end
        return gamma_arena_result.ok(true)
    end
    function store:validate_launch_ownership()
        self.validate_launch_ownership_count = self.validate_launch_ownership_count + 1
        return self.launch_validation_result or gamma_arena_result.ok({ schema_version = 1, mode_id = "skirmish", difficulty_id = "stalker", seed_mode = "manual", session_seed = 42 })
    end
    function store:prepare_resume(_, expected)
        self.prepare_resume_count = self.prepare_resume_count + 1
        return self.resume_result or gamma_arena_result.ok(clone(self.issued_resume or { schema_version = 1, session_id = expected.session_id, session_nonce = expected.session_nonce, next_fight_index = expected.fight_index, checkpoint_name = expected.checkpoint_name }))
    end
    function store:issue_resume(_, intent)
        self.issue_resume_count = (self.issue_resume_count or 0) + 1
        self.issued_resume = clone(intent)
        self.intent_state.resume_pending = true
        return self.issue_resume_result or gamma_arena_result.ok(true)
    end
    function store:consume_resume(_, expected, prepared)
        self.consume_resume_count = (self.consume_resume_count or 0) + 1
        self.consumed_expected = clone(expected)
        self.consumed_prepared = clone(prepared)
        if self.consume_resume_result then return self.consume_resume_result end
        local current = clone(self.issued_resume)
        if prepared and (not current or current.schema_version ~= prepared.schema_version
            or current.session_id ~= prepared.session_id or current.session_nonce ~= prepared.session_nonce
            or current.next_fight_index ~= prepared.next_fight_index or current.checkpoint_name ~= prepared.checkpoint_name) then
            return gamma_arena_result.err("GA_CHECKPOINT_RECOVERY_MISMATCH", "injected persisted intent drift")
        end
        self.intent_state.resume_pending = false
        return gamma_arena_result.ok(current)
    end
    function store:clear_resume_if_matches(_, expected)
        self.clear_matching_count = (self.clear_matching_count or 0) + 1
        self.cleared_expected = clone(expected)
        self.intent_state.resume_pending = false
        return self.clear_matching_result or gamma_arena_result.ok(true)
    end
    function store:clear_transient()
        self.clear_count = self.clear_count + 1
        self.intent_state.launch_pending = false
        self.intent_state.resume_pending = false
        return self.clear_result or gamma_arena_result.ok(true)
    end
    return store
end

local function fake_orchestrator_deps(store)
    local save_guard = { installed = false, armed = false, install_calls = 0, arm_attempts = 0, arm_calls = 0, maintain_calls = 0, disarm_calls = 0, breach_calls = 0, call_order = {} }
    function save_guard:install()
        self.install_calls = self.install_calls + 1
        self.call_order[#self.call_order + 1] = "install"
        if self.install_result then return self.install_result end
        if self.installed then return gamma_arena_result.ok(false) end
        self.installed = true
        return gamma_arena_result.ok(true)
    end
    function save_guard:is_armed() return self.armed end
    function save_guard:arm(context)
        if not self.installed then return gamma_arena_result.err("GA_SAVE_GUARD_NOT_INSTALLED", "Save guard must be installed before arming") end
        self.arm_attempts = self.arm_attempts + 1
        self.call_order[#self.call_order + 1] = "arm"
        if self.arm_result then return self.arm_result end
        if self.armed then return gamma_arena_result.ok(false) end
        self.armed = true
        self.arm_calls = self.arm_calls + 1
        self.context = clone(context)
        return gamma_arena_result.ok(true)
    end
    function save_guard:maintain()
        self.maintain_calls = self.maintain_calls + 1
        return gamma_arena_result.ok(self.armed)
    end
    function save_guard:disarm(context)
        if not self.armed then return gamma_arena_result.ok(false) end
        self.armed = false
        self.disarm_calls = self.disarm_calls + 1
        self.disarm_context = clone(context)
        return gamma_arena_result.ok(true)
    end
    function save_guard:breach(context)
        self.breach_calls = self.breach_calls + 1
        self.breach_context = clone(context)
        return gamma_arena_result.ok(true)
    end
    local diagnostics = { checkpoints = {} }
    function diagnostics:checkpoint(code, context)
        self.checkpoints[#self.checkpoints + 1] = { code = code, context = clone(context) }
        return gamma_arena_result.ok(true)
    end
    local actor_adapter = {
        begin_update = function() return gamma_arena_result.ok(true) end,
        normalize_for_arena = function() return gamma_arena_result.ok(true) end,
        verify_inventory_empty = function() return gamma_arena_result.ok(true) end,
        enforce_boundary = function() return gamma_arena_result.ok({ breach = false, zone = "bar_arena_sr" }) end,
        release_input = function() return gamma_arena_result.ok(true) end,
        cleanup = function() return gamma_arena_result.ok(true) end
    }
    local checkpoint_adapter = { current = "READY" }
    function checkpoint_adapter:create() self.current = "READY"; return gamma_arena_result.ok(true) end
    function checkpoint_adapter:update()
        if self.current == "REHIDING" then
            self.rehide_updates = (self.rehide_updates or 0) + 1
            if self.rehide_updates >= 2 then self.current = "READY" end
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    function checkpoint_adapter:state() return self.current end
    function checkpoint_adapter:on_game_load() return gamma_arena_result.ok(false) end
    function checkpoint_adapter:begin_resume_recovery(session, prepared)
        self.bound_session = clone(session)
        self.prepared_resume = clone(prepared)
        self.current = "REHIDING"
        self.rehide_updates = 0
        return gamma_arena_result.ok(true)
    end
    function checkpoint_adapter:take_resume()
        local value = store.resume_result and store.resume_result.value or {
            schema_version = 1,
            session_id = self.bound_session and self.bound_session.session_id,
            session_nonce = self.bound_session and self.bound_session.session_nonce,
            next_fight_index = self.bound_session and self.bound_session.fight_index,
            checkpoint_name = "_gamma_arena_checkpoint"
        }
        return gamma_arena_result.ok(clone(value))
    end
    function checkpoint_adapter:restore() self.current = "LOADING"; return gamma_arena_result.ok(true) end
    function checkpoint_adapter:cleanup() self.current = "NONE"; return gamma_arena_result.ok(true) end
    local deps = {
        store = store,
        config = {},
        current_level = function() return gamma_arena_result.ok("l05_bar") end,
        reconcile = function() return gamma_arena_result.ok({ events = {} }) end,
        preflight = function() return gamma_arena_result.ok(true) end,
        identity = function() return gamma_arena_result.ok({ session_id = "ga_test_session", session_nonce = "ga_test_nonce" }) end,
        ui = { show_fatal = function(errors, callback) return { errors = errors, callback = callback } end },
        notify = function() end,
        disconnect = function() end,
        teardown = function()
            checkpoint_adapter:cleanup()
            return checkpoint_adapter:update()
        end,
        actor = actor_adapter,
        save_guard = save_guard,
        diagnostics = diagnostics,
        _save_guard = save_guard,
        _diagnostics = diagnostics,
        checkpoint = checkpoint_adapter,
        layout = function() return gamma_arena_result.ok({ level = "l05_bar", actor_spawn_path = "actor_spawn", actor_look_path = "actor_look", actor_boundary_zone = "bar_arena_sr" }) end
    }
    return deps
end

local function launch_consumes_before_preflight_once()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    deps.preflight = function()
        gamma_arena_test_assert.equals(store.consume_launch_count, 1, "launch intent must be consumed before preflight")
        return gamma_arena_result.ok(true)
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(store.consume_launch_count, 1, "first and regular update must not activate twice")
    gamma_arena_test_assert.is_true(orchestrator:is_active(), "successful launch must activate")
end

local function activation_requires_game_load_boundary()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    local before_load = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(before_load.ok, "pre-load update must remain a no-op")
    gamma_arena_test_assert.equals(store.consume_launch_count, 0, "launch cannot activate before on_game_load")
    gamma_arena_test_assert.is_false(orchestrator:is_active(), "pre-load update cannot activate Arena")
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    gamma_arena_test_assert.equals(store.consume_launch_count, 1, "load generation may consume launch exactly once")
end

local function launch_defers_on_fake_start_then_activates_on_rostok()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local fake_start_deps = fake_orchestrator_deps(store)
    fake_start_deps.current_level = function() return gamma_arena_result.ok("fake_start") end
    local fake_start_vm = gamma_arena_orchestrator.new(fake_start_deps)
    fake_start_vm:on_game_load()

    local deferred = fake_start_vm:actor_on_first_update()
    gamma_arena_test_assert.is_true(deferred.ok, "fake_start defers safely")
    gamma_arena_test_assert.equals(deferred.value.route, "deferred", "fake_start exposes deferred route")
    gamma_arena_test_assert.equals(store.consume_launch_count, 0, "fake_start cannot consume launch")
    gamma_arena_test_assert.equals(store.mark_deferred_count, 1, "fake_start persists one cross-VM phase proof")
    gamma_arena_test_assert.is_false(fake_start_vm.activation_attempted, "fake_start cannot latch activation")
    gamma_arena_test_assert.is_true(fake_start_vm.awaiting_activation, "fake_start retains activation ownership")
    gamma_arena_test_assert.equals(store.validate_launch_activation_count, 1, "fake_start validates its direct new-game route before suppression")
    gamma_arena_test_assert.equals(store.validate_launch_ownership_count, 1, "fake_start validates complete launch ownership before suppression")
    gamma_arena_test_assert.is_true(fake_start_deps._save_guard.armed, "fake_start owns save suppression before GAMMA autosave fires")
    gamma_arena_test_assert.equals(fake_start_deps._save_guard.install_calls, 1, "deferred launch installs suppression only after launch ownership")
    gamma_arena_test_assert.equals(fake_start_deps._save_guard.arm_calls, 1, "deferred launch arms its VM exactly once")
    gamma_arena_test_assert.is_true(fake_start_deps._save_guard.maintain_calls >= 1, "deferred launch immediately maintains timer cancellation")

    local rostok_deps = fake_orchestrator_deps(store)
    rostok_deps.current_level = function() return gamma_arena_result.ok("l05_bar") end
    local rostok_vm = gamma_arena_orchestrator.new(rostok_deps)
    rostok_vm:load_state({})
    rostok_vm:on_game_load()
    gamma_arena_test_assert.is_true(rostok_vm:actor_on_first_update().ok, "serialized target-level VM activates")
    gamma_arena_test_assert.equals(store.validate_launch_activation_count, 2, "target VM validates persisted fake_start phase proof after the direct fake_start route")
    gamma_arena_test_assert.equals(store.validate_launch_ownership_count, 2, "each launch VM validates complete launch ownership before suppression")
    gamma_arena_test_assert.equals(store.consume_launch_count, 1, "target level consumes exactly once")
    gamma_arena_test_assert.is_true(rostok_vm:is_active(), "target level owns Arena session")
    gamma_arena_test_assert.is_true(rostok_deps._save_guard.armed, "target Arena VM keeps save suppression armed")
end

local function launch_transition_diagnostics_are_event_based()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local current = "fake_start"
    local events = {}
    deps.current_level = function() return gamma_arena_result.ok(current) end
    deps.log = { info = function(code, message, context)
        events[#events + 1] = { code = code, message = message, context = context }
        return gamma_arena_result.ok(true)
    end }
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:actor_on_update()
    local function count(code)
        local value = 0
        for _, event in ipairs(events) do if event.code == code then value = value + 1 end end
        return value
    end
    gamma_arena_test_assert.equals(count("GA_LAUNCH_DEFERRED"), 1, "fake_start diagnostic must be emitted once per level")
    current = "l05_bar"
    orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(count("GA_LAUNCH_HANDOFF_ACCEPTED"), 1, "target-level handoff must be observable once")
    gamma_arena_test_assert.equals(count("GA_ACTOR_POSITIONED"), 1, "successful normalization must expose the selected patrol paths")
    gamma_arena_test_assert.is_true(count("GA_RUNTIME_STAGE_CHANGED") >= 2, "meaningful runtime stages must be observable")
end

local function ordinary_no_intent_activation_latches_once()
    local store = fake_store({ launch_pending = false, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "ordinary game first update is inert")
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "ordinary game later update is inert")
    gamma_arena_test_assert.equals(store.inspect_count, 1, "ordinary game inspects intents once")
    gamma_arena_test_assert.is_true(orchestrator.activation_attempted, "ordinary game latches completed activation probe")
    gamma_arena_test_assert.is_false(orchestrator.awaiting_activation, "ordinary game clears activation wait")
    gamma_arena_test_assert.equals(deps._save_guard.install_calls, 0, "ordinary campaign VM never installs Arena save suppression")
    gamma_arena_test_assert.equals(deps._save_guard.arm_calls, 0, "ordinary campaign VM never arms Arena save suppression")
end

local function runtime_save_guard_installs_only_after_launch_ownership()
    local overrides = fake_orchestrator_deps(fake_store({ launch_pending = false, resume_pending = false }))
    gamma_arena_bootstrap.compose(overrides)
    gamma_arena_test_assert.equals(overrides._save_guard.install_calls, 0, "bootstrap cannot intercept the MCM new-game command")

    local launch_store = fake_store({ launch_pending = true, resume_pending = false })
    local launch_deps = fake_orchestrator_deps(launch_store)
    local orchestrator = gamma_arena_orchestrator.new(launch_deps)
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "accepted launch installs and arms suppression")
    gamma_arena_test_assert.equals(launch_store.validate_launch_ownership_count, 1, "complete launch ownership is validated once")
    gamma_arena_test_assert.equals(launch_deps._save_guard.install_calls, 1, "accepted launch installs suppression once")
    gamma_arena_test_assert.equals(launch_deps._save_guard.arm_calls, 1, "accepted launch arms suppression once")
    gamma_arena_test_assert.equals(table.concat(launch_deps._save_guard.call_order, ","), "install,arm", "save guard ordering is deterministic")
end

local function runtime_save_guard_failures_block_launch_mutation()
    local cases = {
        { field = "install_result", code = "GA_TEST_SAVE_GUARD_INSTALL_FAILED", arm_attempts = 0 },
        { field = "arm_result", code = "GA_TEST_SAVE_GUARD_ARM_FAILED", arm_attempts = 1 }
    }
    for _, case in ipairs(cases) do
        local store = fake_store({ launch_pending = true, resume_pending = false })
        local deps = fake_orchestrator_deps(store)
        deps._save_guard[case.field] = gamma_arena_result.err(case.code, "injected save-guard failure")
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:on_game_load()
        local result = orchestrator:actor_on_first_update()
        gamma_arena_test_assert.is_false(result.ok, case.field .. " blocks Arena activation")
        gamma_arena_test_assert.equals(result.error.code, case.code, case.field .. " preserves its structured error")
        gamma_arena_test_assert.equals(orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, case.field .. " enters fatal ERROR")
        gamma_arena_test_assert.equals(store.validate_launch_ownership_count, 1, case.field .. " occurs only after launch ownership validation")
        gamma_arena_test_assert.equals(store.mark_deferred_count, 0, case.field .. " cannot persist launch deferral")
        gamma_arena_test_assert.equals(store.consume_launch_count, 0, case.field .. " cannot consume launch")
        gamma_arena_test_assert.equals(deps._save_guard.arm_attempts, case.arm_attempts, case.field .. " preserves install-before-arm short circuiting")
        gamma_arena_test_assert.is_false(deps._save_guard.armed, case.field .. " leaves save suppression unarmed")
        gamma_arena_test_assert.is_false(orchestrator:is_active(), case.field .. " cannot create an Arena session")
    end
end

local function bootstrap_default_store_exposes_complete_launch_contract()
    local overrides = fake_orchestrator_deps(fake_store())
    overrides.store = nil
    local orchestrator = gamma_arena_bootstrap.compose(overrides)
    local store = orchestrator.deps.store
    gamma_arena_test_assert.is_true(type(store.mark_launch_deferred) == 'function', 'production store exposes launch deferral')
    gamma_arena_test_assert.is_true(type(store.validate_launch_activation) == 'function', 'production store exposes launch validation')
    gamma_arena_test_assert.is_true(type(store.validate_launch_ownership) == 'function', 'production store exposes non-mutating launch ownership validation')
end

local function missing_dependency_method_routes_fatal_once()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    store.validate_launch_activation = nil
    local deps = fake_orchestrator_deps(store)
    local fatal_count = 0
    deps.ui.show_fatal = function()
        fatal_count = fatal_count + 1
        return {}
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    local first = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(first.ok, 'missing dependency method must fail activation')
    gamma_arena_test_assert.equals(first.error.code, 'GA_DEPENDENCY_METHOD_UNAVAILABLE', 'dependency wiring uses dedicated code')
    gamma_arena_test_assert.equals(first.error.context.requested_code, 'GA_LAUNCH_REQUIRES_NEW_GAME', 'requested operation code is preserved')
    orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(store.inspect_count, 1, 'fatal activation never retries intent inspection')
    gamma_arena_test_assert.equals(fatal_count, 1, 'fatal UI is shown once')
end

local function first_activation_failure_routes_fatal()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    deps.actor.normalize_for_arena = function()
        return gamma_arena_result.err("GA_TEST_FIRST_ACTIVATION", "injected first activation failure")
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    local was_active = orchestrator:is_active()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "first activation failure remains observable")
    gamma_arena_test_assert.is_true(orchestrator:is_active(), "session became active before runtime failure")
    local routed = orchestrator:on_callback_result_error("actor_on_first_update", failed, was_active)
    gamma_arena_test_assert.is_false(routed.ok, "first activation failure remains a Result")
    gamma_arena_test_assert.equals(orchestrator:runtime_stage_snapshot(), "ERROR", "newly-active callback failure enters fatal")
end

local function activation_reconciles_before_intent_inspection_once()
    local events = {}
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local base_inspect = store.inspect_intents
    function store:inspect_intents(...)
        events[#events + 1] = "inspect"
        return base_inspect(self, ...)
    end
    local deps = fake_orchestrator_deps(store)
    local reconcile_count = 0
    deps.reconcile = function()
        reconcile_count = reconcile_count + 1
        events[#events + 1] = "reconcile"
        return gamma_arena_result.ok({ events = {} })
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "current-version first activation remains valid")
    gamma_arena_test_assert.equals(table.concat(events, ","), "reconcile,inspect", "reconciliation precedes intent inspection")
    orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(reconcile_count, 1, "one activation boundary reconciles exactly once")
    gamma_arena_test_assert.equals(store.inspect_count, 1, "one activation boundary inspects exactly once")
end

local function activation_version_changes_clear_resume_before_checkpoint_routing()
    local cases = {
        { label = "upgrade_visible", previous = "0.0.9", layout = "visible" },
        { label = "upgrade_hidden", previous = "0.0.9", layout = "hidden" },
        { label = "rollback_visible", previous = "9.0.0", layout = "visible" },
        { label = "rollback_hidden", previous = "9.0.0", layout = "hidden" }
    }
    for _, case in ipairs(cases) do
        local store = fake_store({ launch_pending = false, resume_pending = true })
        local deps = fake_orchestrator_deps(store)
        deps.reconcile = function()
            store.intent_state.resume_pending = false
            return gamma_arena_result.ok({ events = { { code = "GA_ADDON_VERSION_CHANGED", previous = case.previous, checkpoint_layout = case.layout } } })
        end
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:load_state({ gamma_arena_session = valid_session() })
        orchestrator:on_game_load()
        local result = orchestrator:actor_on_first_update()
        gamma_arena_test_assert.is_false(result.ok, case.label .. " loaded session fails closed after reconciliation clears resume")
        gamma_arena_test_assert.equals(result.error.code, "GA_RESUME_INTENT_REQUIRED", case.label .. " requires a current-version external route")
        gamma_arena_test_assert.equals(store.prepare_resume_count, 0, case.label .. " never enters checkpoint routing")
    end
end

local function activation_reconciliation_failures_are_fatal_before_inspection()
    local cases = {
        { code = "GA_SETTINGS_SCHEMA_NEWER", label = "future schema" },
        { code = "GA_SETTINGS_READ_FAILED", label = "migration read" },
        { code = "GA_SETTINGS_WRITE_FAILED", label = "migration write" }
    }
    for _, case in ipairs(cases) do
        local store = fake_store({ launch_pending = false, resume_pending = true })
        local deps = fake_orchestrator_deps(store)
        deps.reconcile = function() return gamma_arena_result.err(case.code, "injected " .. case.label) end
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:on_game_load()
        local result = orchestrator:actor_on_first_update()
        gamma_arena_test_assert.is_false(result.ok, case.label .. " remains observable")
        gamma_arena_test_assert.equals(result.error.code, case.code, case.label .. " preserves structured code")
        gamma_arena_test_assert.equals(store.inspect_count, 0, case.label .. " fails before intent inspection")
        gamma_arena_test_assert.equals(store.clear_count, 1, case.label .. " clears transient and bridge state at common fatal cleanup")
        gamma_arena_test_assert.equals(orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, case.label .. " enters ERROR")
    end
end

local function invalid_or_expired_launch_never_reaches_preflight()
    for _, code in ipairs({ "GA_LAUNCH_TOKEN_INVALID", "GA_LAUNCH_TOKEN_EXPIRED" }) do
        local store = fake_store({ launch_pending = true, resume_pending = false })
        store.launch_validation_result = gamma_arena_result.err(code, "rejected launch")
        local preflight_calls = 0
        local deps = fake_orchestrator_deps(store)
        deps.preflight = function() preflight_calls = preflight_calls + 1; return gamma_arena_result.ok(true) end
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:on_game_load()
        local result = orchestrator:actor_on_first_update()
        gamma_arena_test_assert.is_false(result.ok, "invalid/expired launch must fail")
        gamma_arena_test_assert.equals(result.error.code, code, "launch rejection code")
        gamma_arena_test_assert.equals(store.validate_launch_ownership_count, 1, "invalid one-shot is validated once")
        gamma_arena_test_assert.equals(store.consume_launch_count, 0, "invalid one-shot is rejected before consumption")
        gamma_arena_test_assert.equals(store.clear_count, 1, "fatal routing clears rejected launch ownership once")
        gamma_arena_test_assert.equals(deps._save_guard.install_calls, 0, "invalid launch cannot install save suppression")
        gamma_arena_test_assert.equals(preflight_calls, 0, "invalid launch cannot reach preflight")
        orchestrator:actor_on_update()
        gamma_arena_test_assert.equals(store.validate_launch_ownership_count, 1, "rejected launch cannot be reused")
    end

    local route_store = fake_store({ launch_pending = true, resume_pending = false })
    local route_deps = fake_orchestrator_deps(route_store)
    route_deps.current_level = function() return gamma_arena_result.ok("l01_escape") end
    local route_orchestrator = gamma_arena_orchestrator.new(route_deps)
    route_orchestrator:on_game_load()
    local route_result = route_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.equals(route_result.error.code, "GA_LAUNCH_REQUIRES_NEW_GAME", "invalid route proof preserves its code")
    gamma_arena_test_assert.equals(route_store.clear_count, 1, "invalid route proof clears launch and bridge state immediately")
    gamma_arena_test_assert.equals(route_store.validate_launch_ownership_count, 0, "invalid route cannot reach full ownership validation")
    gamma_arena_test_assert.equals(route_deps._save_guard.install_calls, 0, "invalid route cannot install save suppression")
    gamma_arena_test_assert.equals(route_store.consume_launch_count, 0, "invalid route cannot consume launch")
end

local function inactive_callbacks_are_inert()
    local store = fake_store()
    local teardown_calls = 0
    local deps = fake_orchestrator_deps(store)
    deps.teardown = function() teardown_calls = teardown_calls + 1; return gamma_arena_result.ok(true) end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:actor_on_before_death()
    orchestrator:npc_on_net_spawn({})
    orchestrator:npc_on_death_callback()
    orchestrator:actor_on_net_destroy()
    orchestrator:on_before_level_changing()
    local mdata = {}
    orchestrator:save_state(mdata)
    gamma_arena_test_assert.equals(teardown_calls, 0, "ordinary inactive callbacks must not mutate runtime")
    gamma_arena_test_assert.equals(mdata.gamma_arena_session, nil, "ordinary saves must have no Arena payload")
end

local function runtime_orchestrator_npc_net_spawn_is_active_only()
    local calls = 0
    local deps = fake_orchestrator_deps(fake_store())
    deps.entities = {
        on_npc_net_spawn = function(_, npc)
            calls = calls + 1
            return gamma_arena_result.ok(npc.marker == "owned")
        end
    }
    local orchestrator = gamma_arena_orchestrator.new(deps)
    local inactive = orchestrator:npc_on_net_spawn({ marker = "owned" })
    gamma_arena_test_assert.is_true(inactive.ok, "inactive spawn callback is benign")
    gamma_arena_test_assert.is_false(inactive.value, "inactive spawn callback is ignored")
    gamma_arena_test_assert.equals(calls, 0, "inactive spawn callback cannot reach the entity adapter")

    orchestrator.active = true
    orchestrator:set_runtime_stage("ACTIVATING")
    local active = orchestrator:npc_on_net_spawn({ marker = "owned" })
    gamma_arena_test_assert.is_true(active.ok and active.value, "active spawn callback delegates to the entity adapter")
    gamma_arena_test_assert.equals(calls, 1, "active spawn callback delegates exactly once")
end

local function runtime_npc_net_spawn_errors_defer_fatal_ui_to_update()
    local teardown_calls, fatal_shown = 0, 0
    local deps = fake_orchestrator_deps(fake_store())
    deps.entities = {
        on_npc_net_spawn = function()
            return gamma_arena_result.err("GA_TEST_NET_SPAWN", "injected net-spawn isolation failure")
        end
    }
    deps.teardown = function()
        teardown_calls = teardown_calls + 1
        return gamma_arena_result.ok(true)
    end
    deps.ui.show_fatal = function()
        fatal_shown = fatal_shown + 1
        return {}
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator.active = true
    orchestrator:set_runtime_stage("ACTIVATING")
    local callbacks = gamma_arena_bootstrap.make_callbacks(orchestrator)
    local failed = callbacks.npc_on_net_spawn({})
    gamma_arena_test_assert.is_false(failed.ok, "net-spawn isolation failure remains structured")
    gamma_arena_test_assert.equals(failed.error.code, "GA_TEST_NET_SPAWN", "net-spawn failure identity is preserved")
    gamma_arena_test_assert.equals(teardown_calls, 0, "net-spawn callback cannot release entities synchronously")
    gamma_arena_test_assert.equals(fatal_shown, 0, "net-spawn callback cannot open fatal UI synchronously")
    gamma_arena_test_assert.is_true(orchestrator:is_active(), "net-spawn callback defers its fatal transition")
    callbacks.actor_on_update()
    gamma_arena_test_assert.equals(teardown_calls, 1, "next actor update owns deferred teardown")
    gamma_arena_test_assert.equals(fatal_shown, 1, "next actor update opens fatal UI once")
    gamma_arena_test_assert.equals(orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "deferred net-spawn failure enters ERROR")
end

local function ordinary_loaded_save_rejects_stray_launch()
