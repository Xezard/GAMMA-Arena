    gamma_arena_test_assert.equals(fixture.calls.get, 0, "ordinary outfit is never read from Powered Exos")
    gamma_arena_test_assert.equals(fixture.calls.set, 0, "ordinary outfit is never written to Powered Exos")
    gamma_arena_test_assert.equals(ready.value.outfit_power, nil, "ordinary outfit summary does not report exo power")
end

local function runtime_bootstrap_missing_outfit_repair_type_is_ordinary()
    local original_system_ini = system_ini
    system_ini = function()
        return {
            line_exist = function() return false end,
            r_string_ex = function() return "outfit_exo" end
        }
    end
    local missing = effective_outfit_requires_power("ordinary_fixture_outfit")

    system_ini = function() return {} end
    local unavailable = effective_outfit_requires_power("ordinary_fixture_outfit")

    system_ini = function()
        return {
            line_exist = function() error("injected repair_type lookup failure") end,
            r_string_ex = function() return "outfit_exo" end
        }
    end
    local throwing = effective_outfit_requires_power("ordinary_fixture_outfit")
    system_ini = original_system_ini

    gamma_arena_test_assert.is_true(missing.ok, "missing outfit repair_type remains a valid ordinary classification")
    gamma_arena_test_assert.equals(missing.value, false, "missing outfit repair_type does not require Powered Exos")
    gamma_arena_test_assert.is_false(unavailable.ok, "unavailable repair_type APIs still fail closed")
    gamma_arena_test_assert.is_false(throwing.ok, "throwing repair_type APIs still fail closed")
end

local function runtime_actor_loadout_exo_charge_failures_rollback()
    local cases = {
        { label = "missing classifier", options = {} },
        { label = "throwing classifier", options = { outfit_requires_power = function() error("injected classifier failure") end } },
        { label = "missing exo object classifier", options = { outfit_requires_power = function() return true end } },
        { label = "unrecognized exo object", options = { outfit_requires_power = function() return true end, exo_is_object = function() return false end } },
        { label = "throwing exo object classifier", options = { outfit_requires_power = function() return true end, exo_is_object = function() error("injected exo object classifier failure") end } },
        { label = "missing exo read", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end } },
        { label = "throwing exo read", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = function() error("injected read failure") end } },
        { label = "missing exo init", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = function() return nil end } },
        { label = "throwing exo init", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = function() return nil end, exo_init_data = function() error("injected init failure") end } },
        { label = "missing exo write", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = function() return { power = 0 } end } },
        { label = "failed exo write", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = function() return { power = 0 } end, exo_set_data = function() return false end } },
        { label = "throwing exo write", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = function() return { power = 0 } end, exo_set_data = function() error("injected write failure") end } },
        { label = "failed exo readback", options = { outfit_requires_power = function() return true end, exo_is_object = function() return true end, exo_get_data = (function() local reads = 0; return function() reads = reads + 1; return { power = reads == 1 and 0 or 99 } end end)(), exo_set_data = function() return true end } }
    }
    for _, case in ipairs(cases) do
        local fixture = new_actor_loadout_test_fixture(case.options)
        local result = fixture.drive_to_ready()
        gamma_arena_test_assert.is_false(result.ok, case.label .. " fails the equipment transaction")
        gamma_arena_test_assert.is_true(fixture.calls.release > 0, case.label .. " enters existing rollback before READY")
        gamma_arena_test_assert.is_true(fixture.port.state() ~= "READY", case.label .. " never reaches READY")
    end
end

local function runtime_actor_loadout_rollback_blocks_disconnect_until_absent()
    local present, pending_release, releases, tags = {}, {}, {}, {}
    local port = gamma_arena_bootstrap.new_actor_loadout_port({
        actor_id = function(target) return target:id() end,
        ownership_token = function() return "session-blocking" end,
        ammo_box_size = function() return 20 end,
        create_item = (function()
            local calls = 0
            return function(section, target)
                calls = calls + 1
                if calls > 1 then return nil end
                local value = { runtime_id = 700, section_name = section, parent_id = target:id(), quantity = 1, id = function(self) return self.runtime_id end }
                present[700] = value
                return value
            end
        end)(),
        entity_id = function(item) return item:id() end,
        entity_parent_id = function(item) return item.parent_id end,
        entity_section = function(item) return item.section_name end,
        item_quantity = function() return 1 end,
        save_owner_tag = function(id, token) tags[id] = token; return true end,
        load_owner_tag = function(id) return tags[id] end,
        resolve_entity = function(id) return present[id] end,
        release_item = function(id) releases[#releases + 1] = id; pending_release[id] = true; return true end,
    })
    local actor_object = { id = function() return 77 end }
    gamma_arena_test_assert.is_false(port.apply(actor_object, entity_spec(1).actor().loadout).ok, "fixture leaves one actor item in deferred rollback")
    local actor = { cleanup = function() return port.cleanup() end }
    local entities = { cleanup = function() return gamma_arena_result.ok(true) end, update = function() return gamma_arena_result.ok(true) end, registry_snapshot = function() return { state = "CLEAN", npcs = {}, items = {} } end }
    local checkpoint = { cleanup = function() return gamma_arena_result.ok(true) end, update = function() return gamma_arena_result.ok(true) end, state = function() return "NONE" end }
    local store = { clear_resume_if_matches = function() return gamma_arena_result.ok(true) end }
    local now, disconnects = 100, 0
    local orchestrator = gamma_arena_bootstrap.compose({
        store = store,
        config = {},
        actor = actor,
        entities = entities,
        checkpoint = checkpoint,
        disconnect = function() disconnects = disconnects + 1; return true end,
        teardown_clock = function() return now end,
        teardown_timeout_ms = 1000,
        teardown_max_updates = 8
    })
    orchestrator.active = true
    orchestrator.session = valid_session()
    gamma_arena_test_assert.is_true(orchestrator:on_before_level_changing().ok, "lifecycle cleanup starts while actor rollback is deferred")
    gamma_arena_test_assert.is_false(orchestrator.teardown_done, "actor rollback pending value prevents teardown completion")
    local blocked = orchestrator:main_menu_action()
    gamma_arena_test_assert.is_false(blocked.ok, "disconnect remains blocked while an actor rollback id still exists")
    gamma_arena_test_assert.equals(disconnects, 0, "no disconnect occurs before actor item absence")
    gamma_arena_test_assert.equals(#releases, 1, "deferred actor item release is submitted exactly once")
    for id in pairs(pending_release) do present[id] = nil; pending_release[id] = nil end
    now = now + 1
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "later engine frame polls actor rollback absence")
    gamma_arena_test_assert.is_true(orchestrator.teardown_done, "teardown completes after actor item absence is proved")
    gamma_arena_test_assert.is_true(orchestrator:main_menu_action().ok, "disconnect becomes available after actor rollback completion")
    gamma_arena_test_assert.equals(disconnects, 1, "disconnect occurs exactly once after actor rollback")
end

local function runtime_actor_loadout_malformed_existence_blocks_teardown_disconnect()
    for _, case in ipairs({
        { label = "Result.ok(string)", result = function() return gamma_arena_result.ok("present") end },
        { label = "Result.ok(empty table)", result = function() return gamma_arena_result.ok({}) end }
    }) do
        local next_id, releases, tags = 800, {}, {}
        local function entity(section, parent_id, quantity)
            local value = { runtime_id = next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
            next_id = next_id + 1
            function value:id() return self.runtime_id end
            return value
        end
        local port = gamma_arena_bootstrap.new_actor_loadout_port({
            actor_id = function(target) return target:id() end,
            ownership_token = function() return "session-malformed" end,
            ammo_box_size = function() return 20 end,
            create_item = function(section, target, count) return entity(section, target:id(), count) end,
            entity_id = function(item) return item:id() end,
            entity_parent_id = function(item) return item.parent_id end,
            entity_section = function(item) return item.section_name end,
            item_quantity = function(item) return item.quantity end,
            save_owner_tag = function(id, token) tags[id] = token; return true end,
            load_owner_tag = function(id) return tags[id] end,
            resolve_entity = case.result,
            release_item = function(id) releases[#releases + 1] = id; return true end,
        })
        local actor_object = { id = function() return 77 end }
        gamma_arena_test_assert.is_true(port.apply(actor_object, entity_spec(1).actor().loadout).ok, case.label .. " fixture owns a complete actor loadout")
        local actor = { cleanup = function() return port.cleanup() end }
        local entities = { cleanup = function() return gamma_arena_result.ok(true) end, update = function() return gamma_arena_result.ok(true) end, registry_snapshot = function() return { state = "CLEAN", npcs = {}, items = {} } end }
        local checkpoint = { cleanup = function() return gamma_arena_result.ok(true) end, update = function() return gamma_arena_result.ok(true) end, state = function() return "NONE" end }
        local store = { clear_resume_if_matches = function() return gamma_arena_result.ok(true) end }
        local disconnects = 0
        local orchestrator = gamma_arena_bootstrap.compose({
            store = store,
            config = {},
            actor = actor,
            entities = entities,
            checkpoint = checkpoint,
            disconnect = function() disconnects = disconnects + 1; return true end,
            teardown_clock = function() return 100 end,
            teardown_timeout_ms = 1000,
            teardown_max_updates = 16
        })
        orchestrator.active = true
        orchestrator.session = valid_session()
        local teardown = orchestrator:on_before_level_changing()
        gamma_arena_test_assert.is_false(teardown.ok, case.label .. " cannot prove actor item absence during teardown")
        gamma_arena_test_assert.equals(teardown.error.code, "GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", case.label .. " has a deterministic error")
        gamma_arena_test_assert.is_false(orchestrator.teardown_done, case.label .. " keeps lifecycle teardown retryable")
        gamma_arena_test_assert.is_false(orchestrator:main_menu_action().ok, case.label .. " keeps disconnect gated without exact absence")
        gamma_arena_test_assert.equals(disconnects, 0, case.label .. " never permits disconnect")
        gamma_arena_test_assert.equals(#releases, 0, case.label .. " never releases without a readable current-object proof")
    end
end

local function runtime_bootstrap_actor_existence_lookup_fails_closed()
    local unavailable = gamma_arena_bootstrap.new_runtime_entity_exists_port(function() return nil end)(700)
    gamma_arena_test_assert.is_false(unavailable.ok, "missing ALife service cannot prove actor item absence")
    gamma_arena_test_assert.equals(unavailable.error.code, "GA_ACTOR_LOADOUT_EXISTENCE_FAILED", "missing ALife service has a deterministic error")
    local throwing = gamma_arena_bootstrap.new_runtime_entity_exists_port(function()
        return { object = function() error("injected production-shaped lookup failure") end }
    end)(700)
    gamma_arena_test_assert.is_false(throwing.ok, "throwing ALife object lookup cannot prove actor item absence")
    local absent = gamma_arena_bootstrap.new_runtime_entity_exists_port(function()
        return { object = function() return nil end }
    end)(700)
    gamma_arena_test_assert.is_true(absent.ok and absent.value == false, "successful authoritative nil lookup proves actor item absence")

    local entity_nil_service = gamma_arena_bootstrap.new_runtime_entity_exists_port(function() return nil end, "GA_ENTITY_EXISTENCE_FAILED")(800)
    gamma_arena_test_assert.is_false(entity_nil_service.ok, "nil ALife service cannot prove registered entity absence")
    gamma_arena_test_assert.equals(entity_nil_service.error.code, "GA_ENTITY_EXISTENCE_FAILED", "entity existence port uses its dedicated error code")
    local entity_missing_method = gamma_arena_bootstrap.new_runtime_entity_exists_port(function() return {} end, "GA_ENTITY_EXISTENCE_FAILED")(800)
    gamma_arena_test_assert.is_false(entity_missing_method.ok, "missing ALife object API cannot prove registered entity absence")
    local entity_throwing = gamma_arena_bootstrap.new_runtime_entity_exists_port(function()
        return { object = function() error("injected entity lookup failure") end }
    end, "GA_ENTITY_EXISTENCE_FAILED")(800)
    gamma_arena_test_assert.is_false(entity_throwing.ok, "throwing production entity lookup cannot prove registered entity absence")
    local entity_absent = gamma_arena_bootstrap.new_runtime_entity_exists_port(function()
        return { object = function() return nil end }
    end, "GA_ENTITY_EXISTENCE_FAILED")(800)
    gamma_arena_test_assert.is_true(entity_absent.ok and entity_absent.value == false, "only authoritative ALife nil proves registered entity absence")
end

local function actor_loadout_ownership_fixture(options)
    options = options or {}
    local env = { current = {}, tags = {}, releases = {}, tag_writes = 0, tag_reads = 0, next_id = options.next_id or 900, phase = "apply" }
    local first_id = env.next_id
    local actor = { id = function() return 77 end }
    local function entity(section, parent_id, quantity)
        local value = { runtime_id = env.next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
        if env.next_id == first_id and options.apply_parent_mismatch then value.parent_id = 999 end
        if env.next_id == first_id and options.apply_section_mismatch then value.section_name = "foreign_section" end
        if env.next_id == first_id and options.apply_quantity_invalid then value.quantity = 0 end
        env.next_id = env.next_id + 1
        function value:id() return self.runtime_id end
        env.current[value.runtime_id] = value
        return value
    end
    local port = gamma_arena_bootstrap.new_actor_loadout_port({
        actor_id = function(target) return target:id() end,
        ownership_token = function() return "ga-session:nonce" end,
        ammo_box_size = function() return 20 end,
        create_item = function(section, target, count) return entity(section, target:id(), count) end,
        entity_id = function(item) return item:id() end,
        entity_parent_id = function(item) return item.parent_id end,
        entity_section = function(item) return item.section_name end,
        item_quantity = function(item) return item.quantity end,
        resolve_entity = function(id)
            if options.resolve_error_id == id then error("injected current-object lookup failure") end
            return env.current[id]
        end,
        save_owner_tag = function(id, token)
            env.tag_writes = env.tag_writes + 1
            if env.phase == "apply" and (options.apply_tag_write_failure_once or options.apply_tag_write_failure_reuses_same_shape) and not env.tag_write_failed then
                env.tag_write_failed = true
                if options.apply_tag_write_failure_reuses_same_shape then
                    local original = env.current[id]
                    env.current[id] = {
                        runtime_id = id,
                        section_name = original.section_name,
                        parent_id = original.parent_id,
                        quantity = original.quantity,
                        id = function(self) return self.runtime_id end
                    }
                end
                return false
            end
            env.tags[id] = env.phase == "apply" and options.apply_tag_roundtrip_mismatch_once and not env.tag_mismatched and "wrong-token" or token
            if env.tags[id] == "wrong-token" then env.tag_mismatched = true end
            return true
        end,
        load_owner_tag = function(id)
            env.tag_reads = env.tag_reads + 1
            if env.phase == "apply" and options.apply_tag_read_failure_once and not env.tag_read_failed then env.tag_read_failed = true; error("injected apply owner-tag read failure") end
            if env.phase == "cleanup" and options.tag_read_error_id == id then error("injected cleanup owner-tag read failure") end
            return env.tags[id]
        end,
        release_item = function(id)
            env.releases[#env.releases + 1] = id
            return true
        end
    })
    env.port = port
    env.actor = actor
    env.applied = port.apply(actor, entity_spec(1).actor().loadout)
    env.phase = "cleanup"
    return env
end

local function actor_loadout_keep_only(env, id)
    for current_id in pairs(env.current) do if current_id ~= id then env.current[current_id] = nil end end
end

local function runtime_actor_loadout_consumed_absent_id_retires_without_release()
    local env = actor_loadout_ownership_fixture()
    gamma_arena_test_assert.is_true(env.applied.ok and #env.applied.value.created_ids > 0, "fixture owns a non-empty actor loadout")
    for id in pairs(env.current) do env.current[id] = nil end
    local cleanup = env.port.cleanup()
    gamma_arena_test_assert.is_true(cleanup.ok and cleanup.value == true, "consumed actor items retire from the owned registry as authoritative absence")
    gamma_arena_test_assert.equals(#env.releases, 0, "already absent actor item ids are never submitted for release")
end

local function runtime_actor_loadout_pre_release_reused_foreign_id_is_never_released()
    for _, case in ipairs({
        { label = "tag", mutate = function(env, id) env.tags[id] = "foreign-token" end },
        { label = "parent", mutate = function(env, id) env.current[id].parent_id = 999 end },
        { label = "section", mutate = function(env, id) env.current[id].section_name = "foreign_section" end }
    }) do
        local env = actor_loadout_ownership_fixture()
        local id = env.applied.value.created_ids[1]
        actor_loadout_keep_only(env, id)
        case.mutate(env, id)
        local cleanup = env.port.cleanup()
        gamma_arena_test_assert.is_false(cleanup.ok, case.label .. " mismatch fails closed before release")
        gamma_arena_test_assert.equals(cleanup.error.code, "GA_ACTOR_LOADOUT_OWNERSHIP_MISMATCH", case.label .. " mismatch uses the deterministic ownership code")
        gamma_arena_test_assert.equals(#env.releases, 0, case.label .. " mismatch never releases a foreign/reused id")
    end
end

local function runtime_actor_loadout_post_submit_reuse_is_never_released_twice()
    local env = actor_loadout_ownership_fixture()
    local first = env.port.cleanup()
    gamma_arena_test_assert.is_true(first.ok and first.value.pending == true, "exact owned matches enter deferred release polling")
    local submitted = #env.releases
    gamma_arena_test_assert.is_true(submitted > 0, "exact ownership proof submits a non-empty release set")
    local reused_id = env.applied.value.created_ids[1]
    for id in pairs(env.current) do env.current[id] = nil end
    env.current[reused_id] = { runtime_id = reused_id, section_name = "foreign_section", parent_id = 999, quantity = 1, id = function(self) return self.runtime_id end }
    env.tags[reused_id] = "foreign-token"
    local retired = env.port.cleanup()
    gamma_arena_test_assert.is_true(retired.ok and retired.value == true, "post-submit id reuse retires the old owned record safely")
    gamma_arena_test_assert.equals(#env.releases, submitted, "post-submit reuse never resubmits release against the new foreign object")

    local tag_loss = actor_loadout_ownership_fixture()
    gamma_arena_test_assert.is_true(tag_loss.port.cleanup().ok, "tag-loss fixture submits exact owned releases")
    local tag_loss_submitted = #tag_loss.releases
    local tag_loss_id = tag_loss.applied.value.created_ids[1]
    actor_loadout_keep_only(tag_loss, tag_loss_id)
    tag_loss.tags[tag_loss_id] = nil
    local blocked = tag_loss.port.cleanup()
    gamma_arena_test_assert.is_false(blocked.ok, "post-submit token loss stays tracked because identity reuse is not proven")
    gamma_arena_test_assert.equals(#tag_loss.releases, tag_loss_submitted, "post-submit token loss never resubmits release")
end

local function runtime_actor_loadout_malformed_ownership_proof_fails_closed()
    for _, case in ipairs({
        { label = "malformed parent", mutate = function(env, id) env.current[id].parent_id = {} end },
        { label = "malformed section", mutate = function(env, id) env.current[id].section_name = {} end },
        { label = "malformed id", mutate = function(env, id) env.current[id].runtime_id = "bad" end },
        { label = "unreadable tag", options = { tag_read_error_id = 900 } },
        { label = "unreadable resolver", options = { resolve_error_id = 900 } }
    }) do
        local env = actor_loadout_ownership_fixture(case.options)
        local id = env.applied.value.created_ids[1]
        actor_loadout_keep_only(env, id)
        if case.mutate then case.mutate(env, id) end
        local cleanup = env.port.cleanup()
        gamma_arena_test_assert.is_false(cleanup.ok, case.label .. " cannot authorize release")
        gamma_arena_test_assert.equals(#env.releases, 0, case.label .. " fails closed without releasing any unproven current object")
    end
end

local function runtime_actor_loadout_exact_owned_match_releases_once()
    local env = actor_loadout_ownership_fixture()
    gamma_arena_test_assert.is_true(env.applied.ok, "exact-owned fixture applies")
    gamma_arena_test_assert.equals(env.tag_writes, #env.applied.value.created_ids, "every created actor entity receives its own durable ownership token")
    local first = env.port.cleanup()
    gamma_arena_test_assert.is_true(first.ok and first.value.pending == true, "exact current ownership submits release and awaits absence")
    gamma_arena_test_assert.equals(#env.releases, #env.applied.value.created_ids, "every exact owned actor entity is released once")
    env.port.cleanup()
    gamma_arena_test_assert.equals(#env.releases, #env.applied.value.created_ids, "pending exact owned ids are polled without duplicate release")
    for id in pairs(env.current) do env.current[id] = nil end
    gamma_arena_test_assert.is_true(env.port.cleanup().ok, "later authoritative absence completes cleanup")
end

local function runtime_actor_loadout_apply_failures_never_drop_valid_created_ids()
    for _, case in ipairs({
        { label = "parent mismatch", options = { apply_parent_mismatch = true }, cleanable = false },
        { label = "section mismatch", options = { apply_section_mismatch = true }, cleanable = false },
        { label = "quantity invalid", options = { apply_quantity_invalid = true }, cleanable = true },
        { label = "tag write failure", options = { apply_tag_write_failure_once = true }, cleanable = false },
        { label = "tag read failure", options = { apply_tag_read_failure_once = true }, cleanable = true },
        { label = "tag roundtrip mismatch", options = { apply_tag_roundtrip_mismatch_once = true }, cleanable = false }
    }) do
        local env = actor_loadout_ownership_fixture(case.options)
        gamma_arena_test_assert.is_false(env.applied.ok, case.label .. " remains an observable transactional apply failure")
        local reapplied = env.port.apply(env.actor, entity_spec(1).actor().loadout)
        gamma_arena_test_assert.is_false(reapplied.ok, case.label .. " cannot start another apply while the valid created id remains tracked")
        gamma_arena_test_assert.equals(reapplied.error.code, "GA_ACTOR_LOADOUT_BUSY", case.label .. " proves the valid id was not dropped from rollback ownership")
        local cleanup = env.port.cleanup()
        if case.cleanable then
            gamma_arena_test_assert.is_true(cleanup.ok and cleanup.value.pending == true, case.label .. " is safely authorized/released and awaits exact absence")
            gamma_arena_test_assert.is_true(#env.releases > 0, case.label .. " cleanup releases the tracked exact current object")
            if case.options.apply_tag_read_failure_once then
                gamma_arena_test_assert.equals(env.tag_writes, 1, case.label .. " recovers only from the exact token persisted by the creation-time write")
            end
        else
            gamma_arena_test_assert.is_false(cleanup.ok, case.label .. " remains tracked and fails closed while current identity mismatches")
            gamma_arena_test_assert.equals(#env.releases, 0, case.label .. " never releases a mismatched current object")
        end
    end
end

local function runtime_actor_loadout_failed_tag_write_never_manufactures_ownership()
    local env = actor_loadout_ownership_fixture({ apply_tag_write_failure_reuses_same_shape = true })
    gamma_arena_test_assert.is_false(env.applied.ok, "creation-time tag write failure remains observable")
    gamma_arena_test_assert.equals(env.tag_writes, 1, "only the creation path may attempt the ownership-tag write")
    gamma_arena_test_assert.equals(#env.releases, 0, "rollback never releases a same-shape foreign replacement without its persisted token")
    local retried = env.port.cleanup()
    gamma_arena_test_assert.is_false(retried.ok, "missing persisted ownership token keeps the foreign replacement tracked and fails closed")
    gamma_arena_test_assert.equals(retried.error.code, "GA_ACTOR_LOADOUT_OWNERSHIP_MISMATCH", "foreign same-shape reuse exposes the deterministic ownership mismatch")
    gamma_arena_test_assert.equals(env.tag_writes, 1, "cleanup retry never writes or rewrites an ownership tag")
    gamma_arena_test_assert.equals(#env.releases, 0, "cleanup retry never releases the unowned replacement")
end

local function runtime_entity_ammo_box_size_failure_precedes_actor_mutation()
    for _, option in ipairs({
        { ammo_box_size = 0 },
        { ammo_box_size = 1.5 },
        { ammo_box_size_throw = true },
        { ammo_box_sizes = {} }
    }) do
        local env, deps = fake_entity_environment(option)
        local adapter = gamma_arena_entity_adapter.new(deps)
        local result = adapter:begin_apply(entity_spec(1), "session-invalid-box-size")
        gamma_arena_test_assert.is_false(result.ok, "missing, nonpositive, fractional, or throwing effective box_size fails closed")
        gamma_arena_test_assert.equals(env.actor_loadout_calls, 0, "effective ammo conversion is verified before actor mutation")
        gamma_arena_test_assert.equals(env.create_npc_count, 0, "effective ammo conversion is verified before opponent creation")
    end
end

local function runtime_bootstrap_hostility_port_is_feature_probed()
    local calls = {}
    local actor = {}
    local npc = {
        set_relation = function(_, relation, target)
            calls[#calls + 1] = "relation:" .. tostring(relation)
            gamma_arena_test_assert.is_true(target == actor, "hostility relation targets only the Arena actor")
            return true
        end,
        force_set_goodwill = function(_, goodwill, target)
            calls[#calls + 1] = "goodwill:" .. tostring(goodwill)
            gamma_arena_test_assert.is_true(target == actor, "forced goodwill targets only the Arena actor")
            return true
        end
    }
    local applied = gamma_arena_bootstrap.apply_actor_hostility(npc, actor, -5000, "enemy")
    gamma_arena_test_assert.is_true(applied.ok, "installed-GAMMA hostility methods are accepted")
    gamma_arena_test_assert.equals(calls[1], "relation:enemy", "enemy relation is applied first")
    gamma_arena_test_assert.equals(calls[2], "goodwill:-5000", "exact negative goodwill follows relation")
    gamma_arena_test_assert.equals(#calls, 2, "hostility does not seed omniscient memory or force a current target")
    local missing = gamma_arena_bootstrap.apply_actor_hostility({ set_relation = npc.set_relation }, actor, -5000, "enemy")
    gamma_arena_test_assert.is_false(missing.ok, "missing goodwill API fails closed")
    gamma_arena_test_assert.equals(missing.error.code, "GA_ENTITY_HOSTILE_API_MISSING", "missing hostility API code")
    local false_result = gamma_arena_bootstrap.apply_actor_hostility({ set_relation = npc.set_relation, force_set_goodwill = function() return false end }, actor, -5000, "enemy")
    gamma_arena_test_assert.is_false(false_result.ok, "explicit false goodwill result fails closed")
    local thrown = gamma_arena_bootstrap.apply_actor_hostility({ set_relation = function() error("injected relation failure") end, force_set_goodwill = npc.force_set_goodwill }, actor, -5000, "enemy")
    gamma_arena_test_assert.is_false(thrown.ok, "throwing hostility method fails closed")
end

local function runtime_entity_partial_failures_rollback_in_reverse()
    local phases = {
        { name = "npc", opponents = 1 },
        { name = "hold_offline", opponents = 1 }, { name = "tag", opponents = 1 }, { name = "tag_read", opponents = 1 },
        { name = "children", opponents = 1 }, { name = "item", opponents = 1 },
        { name = "request_online", opponents = 1 }, { name = "alive", opponents = 1 },
        { name = "activation_hold", opponents = 1 }, { name = "friend", opponents = 2 }, { name = "hostile", opponents = 2, fail_hostile_at = 2 }
    }
    for _, phase_case in ipairs(phases) do
        local phase = phase_case.name
        local env, deps = fake_entity_environment({ fail_phase = phase, fail_hostile_at = phase_case.fail_hostile_at })
        local adapter = gamma_arena_entity_adapter.new(deps)
        begin_entity_apply(adapter, env, entity_spec(phase_case.opponents), "session-fail-" .. phase)
        local _, snapshot = pump_entity(adapter, env, 300)
        gamma_arena_test_assert.equals(snapshot.state, "ERROR", "phase " .. phase .. " must finish rollback before surfacing ERROR")
        if phase == "npc" then
            gamma_arena_test_assert.equals(#env.release_requests, 0, "pre-creation phase " .. phase .. " has nothing to release")
        elseif phase == "tag" or phase == "tag_read" or phase == "children" then
            gamma_arena_test_assert.equals(#env.release_requests, 0, "unproven ownership in phase " .. phase .. " is protected, never guessed")
            gamma_arena_test_assert.is_true(env.objects[100] ~= nil, "unproven NPC remains protected after " .. phase)
        else
            gamma_arena_test_assert.is_true(#env.release_requests > 0, "phase " .. phase .. " must actually exercise reverse rollback")
        end
        if phase == "request_online" or phase == "activation_hold" or phase == "friend" or phase == "hostile" then
            for id in pairs(env.online_candidates) do
                gamma_arena_test_assert.equals(env.online[id], nil, "activation failure " .. phase .. " synchronously returns every visible NPC to offline hold")
            end
            if phase == "hostile" then
                gamma_arena_test_assert.equals(env.hostile_calls, 2, "late hostility failure occurs after one NPC was made hostile")
                local final_hold = nil
                for index, event in ipairs(env.events) do if string.find(event, "^hold_friendly:") then final_hold = index end end
                gamma_arena_test_assert.is_true(final_hold ~= nil, "late hostility failure reapplies the friendly hold before yielding")
            end
        end
        for index = 2, #env.release_requests do
            gamma_arena_test_assert.is_true(env.release_requests[index - 1] > env.release_requests[index], "rollback release requests must follow reverse creation order")
        end
    end
    local actor_env, actor_deps = fake_entity_environment({ fail_phase = "actor" })
    local actor_adapter = gamma_arena_entity_adapter.new(actor_deps)
    gamma_arena_test_assert.is_false(begin_entity_apply(actor_adapter, actor_env, entity_spec(1), "session-actor-fail").ok, "actor loadout failure remains observable")
    gamma_arena_test_assert.equals(actor_env.create_npc_count, 0, "actor loadout failure must happen before opponents")
end

local function runtime_entity_purges_only_snapshot_children_still_parented()
    local env, deps = fake_entity_environment({ default_children = true, move_child_after_snapshot = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
