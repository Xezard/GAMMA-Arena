    gamma_arena_test_assert.equals(integrity.boundary_calls, 1, "integrity retry owns the same rematch boundary")
    gamma_arena_test_assert.equals(integrity.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "integrity retry enters cleanup behind boundary")
end

