    absent_env.objects[absent.id] = nil
    absent_env:advance(250); absent_adapter:update()
    gamma_arena_test_assert.equals(absent_adapter:registry_snapshot().npcs[1].terminal_state, "DEFEATED_MISSING", "proved ALife absence is terminal immediately")
