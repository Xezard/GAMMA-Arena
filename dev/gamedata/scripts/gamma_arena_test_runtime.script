end

local function config_quarantine_propagates_to_fatal()
    local store = fake_store()
    store.inspect_error = gamma_arena_result.err("GA_CONFIG_QUARANTINED", "poisoned config")
    local fatal_errors
    local deps = fake_orchestrator_deps(store)
    deps.ui.show_fatal = function(errors) fatal_errors = errors; return {} end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    local result = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(result.ok, "quarantine must fail activation")
    gamma_arena_test_assert.equals(result.error.code, "GA_CONFIG_QUARANTINED", "quarantine code must propagate")
    gamma_arena_test_assert.equals(fatal_errors[1].error.code, "GA_CONFIG_QUARANTINED", "fatal UI receives quarantine")
end

local function save_payload_is_plain_deep_copy()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    local mdata = {}
    local saved = orchestrator:save_state(mdata)
    gamma_arena_test_assert.is_true(saved.ok and saved.value == false, "armed Arena save callback is observed without serialization")
    gamma_arena_test_assert.equals(mdata.gamma_arena_session, nil, "Arena session is never written into game-save metadata")
    gamma_arena_test_assert.equals(deps._save_guard.breach_calls, 1, "native save callback emits one guard breach")
    gamma_arena_test_assert.equals(orchestrator:session_snapshot().fight_index, 0, "breach observation does not mutate runtime")
end

local function load_rejects_unknown_session_keys_and_userdata()
    local unknown = valid_session()
    unknown.future_field = true
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(fake_store({ resume_pending = true, launch_pending = false })))
    local result = orchestrator:load_state({ gamma_arena_session = unknown })
    gamma_arena_test_assert.is_false(result.ok, "unknown ArenaSession fields must fail closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_SESSION_UNKNOWN_FIELD", "unknown key code")
    local bad = valid_session()
    bad.session_id = coroutine.create(function() end)
    result = orchestrator:load_state({ gamma_arena_session = bad })
    gamma_arena_test_assert.is_false(result.ok, "non-plain values must fail")
    local hostile = setmetatable({}, { __index = function() error("hostile save metadata") end })
    local call_ok, hostile_result = pcall(orchestrator.load_state, orchestrator, hostile)
    gamma_arena_test_assert.is_true(call_ok, "load_state must be total for hostile metadata")
    gamma_arena_test_assert.is_false(hostile_result.ok, "hostile metadata must return a Result error")
end

local function resume_is_validated_but_override_is_not_applied_early()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = "ga_test_session", session_nonce = "ga_test_nonce", next_fight_index = 3, checkpoint_name = "_gamma_arena_checkpoint" })
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    orchestrator:load_state({ gamma_arena_session = valid_session() })
    orchestrator:on_game_load()
    local result = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_true(result.ok and orchestrator:is_active(), "matching resume route activates clean baseline")
    gamma_arena_test_assert.equals(orchestrator:session_snapshot().fight_index, 0, "override waits for checkpoint re-hide")
    gamma_arena_test_assert.equals(orchestrator:pending_resume_snapshot().next_fight_index, 3, "validated resume route is cached")
end

local function manual_save_and_load_flags_are_blocked()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local notifications = 0
    local deps = fake_orchestrator_deps(store)
    deps.notify = function(id) gamma_arena_test_assert.equals(id, "st_gamma_arena_manual_save_disabled", "localized block id"); notifications = notifications + 1 end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    local save_flags_last = { ret = false }
    local load_flags_first = { ret = false }
    local load_flags_last = { ret = false }
    local unrelated = { marker = "must remain untouched" }
    orchestrator:on_before_save_input(11, 22, save_flags_last)
    orchestrator:on_before_load_input(load_flags_first, 11, 22)
    orchestrator:on_before_load_input(11, 22, unrelated, load_flags_last)
    gamma_arena_test_assert.is_true(save_flags_last.ret, "real flags-last manual Save signature must be blocked")
    gamma_arena_test_assert.is_true(load_flags_first.ret, "flags-first compatibility signature must be blocked")
    gamma_arena_test_assert.is_true(load_flags_last.ret, "flags-last manual Load signature must be blocked")
    gamma_arena_test_assert.equals(unrelated.ret, nil, "manual input scanning must not mutate unrelated tables")
    gamma_arena_test_assert.equals(unrelated.marker, "must remain untouched", "unrelated callback data must remain intact")
    gamma_arena_test_assert.equals(notifications, 3, "every blocked UI operation shows the localized message")
end

local function fatal_main_menu_retries_throw_then_becomes_idempotent()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local disconnects, callback_results = 0, {}
    local action
    local deps = fake_orchestrator_deps(store)
    deps.preflight = function() return gamma_arena_result.err("GA_PREFLIGHT_FAILED", "failed") end
    deps.ui.show_fatal = function(_, callback) action = callback; return {} end
    deps.disconnect = function()
        disconnects = disconnects + 1
        if disconnects == 1 then error("injected disconnect failure") end
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_true(type(action) == "function", "fatal UI must receive one main-menu action")
    callback_results[1] = action()
    callback_results[2] = action()
    callback_results[3] = action()
    gamma_arena_test_assert.is_false(callback_results[1].ok, "throwing disconnect must return an observable structured failure")
    gamma_arena_test_assert.is_true(callback_results[2].ok, "the same UI action must retry after disconnect failure")
    gamma_arena_test_assert.is_true(callback_results[3].ok, "successful disconnect makes later clicks benign")
    gamma_arena_test_assert.equals(disconnects, 2, "disconnect must retry once then become idempotent")
end

local function fatal_main_menu_retries_explicit_false()
    local attempts = 0
    local action
    local deps = fake_orchestrator_deps(fake_store({ launch_pending = true, resume_pending = false }))
    deps.preflight = function() return gamma_arena_result.err("GA_PREFLIGHT_FAILED", "failed") end
    deps.ui.show_fatal = function(_, callback) action = callback; return {} end
    deps.disconnect = function()
        attempts = attempts + 1
        if attempts == 1 then return false end
        return true
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_true(type(action) == "function", "fatal UI must receive one main-menu action")
    local first = action()
    local second = action()
    local third = action()
    gamma_arena_test_assert.is_false(first.ok, "explicit false disconnect must be an observable failure")
    gamma_arena_test_assert.is_true(second.ok and third.ok, "explicit false disconnect must remain retryable then idempotent")
    gamma_arena_test_assert.equals(attempts, 2, "explicit false must not latch main-menu completion")
end

local function fatal_main_menu_bypasses_terminal_cleanup_error()
    local action, disconnects, fatal_clears = nil, 0, 0
    local deps = fake_orchestrator_deps(fake_store({ launch_pending = true }))
    deps.preflight = function()
        return gamma_arena_result.err("GA_ENTITY_CLEANUP_FAILED", "injected terminal cleanup")
    end
    deps.teardown = function()
        return gamma_arena_result.err("GA_ENTITY_CLEANUP_FAILED", "injected terminal cleanup")
    end
    deps.entities = {
        registry_snapshot = function()
            return { state = "ERROR", npcs = { { id = 100 } }, items = {}, error = { code = "GA_ENTITY_CLEANUP_FAILED" } }
        end
    }
    deps.ui.show_fatal = function(errors, callback)
        gamma_arena_test_assert.equals(#errors, 1, "duplicate fatal aggregates are displayed once")
        action = callback
        return {}
    end
    deps.ui.clear_fatal = function()
        fatal_clears = fatal_clears + 1
        return gamma_arena_result.ok(true)
    end
    deps.disconnect = function() disconnects = disconnects + 1; return true end

    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_false(orchestrator:actor_on_first_update().ok, "fixture enters fatal state")
    gamma_arena_test_assert.is_true(type(action) == "function", "fatal UI receives emergency action")
    gamma_arena_test_assert.is_true(action().ok, "terminal cleanup cannot block fatal disconnect")
    gamma_arena_test_assert.is_true(action().ok, "accepted fatal disconnect is idempotent")
    gamma_arena_test_assert.equals(disconnects, 1, "fatal disconnect is submitted exactly once")
    gamma_arena_test_assert.equals(fatal_clears, 1, "accepted fatal disconnect clears fatal UI exactly once across repeated clicks")
end

local function ordinary_main_menu_still_rejects_terminal_cleanup_error()
    local disconnects = 0
    local deps = fake_orchestrator_deps(fake_store())
    deps.entities = {
        registry_snapshot = function() return { state = "ERROR", npcs = { { id = 100 } }, items = {} } end
    }
    deps.disconnect = function() disconnects = disconnects + 1; return true end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator.cleanup_required = true
    orchestrator.teardown_done = true
    local result = orchestrator:main_menu_action()
    gamma_arena_test_assert.is_false(result.ok, "ordinary exit keeps exact cleanup gate")
    gamma_arena_test_assert.equals(disconnects, 0, "ordinary exit never bypasses terminal cleanup")
end

