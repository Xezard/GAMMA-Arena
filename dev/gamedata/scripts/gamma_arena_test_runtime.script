    deps.teardown = function(reason, preserve) reasons[#reasons + 1] = reason .. ":" .. tostring(preserve); return gamma_arena_result.ok(true) end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:expect_checkpoint_reload()
    orchestrator:actor_on_net_destroy()
    orchestrator:actor_on_net_destroy()
    gamma_arena_test_assert.equals(reasons[1], "checkpoint_reload:true", "expected reload preserves session route")
    gamma_arena_test_assert.equals(#reasons, 1, "net-destroy teardown must be idempotent")
end

