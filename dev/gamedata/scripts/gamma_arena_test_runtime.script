local callback_names = {
    "on_game_load", "actor_on_first_update", "actor_on_update", "actor_on_before_death", "actor_on_death",
    "npc_on_death_callback", "save_state", "load_state", "on_before_save_input",
    "on_before_load_input", "actor_on_net_destroy", "on_before_level_changing"
}

local function callback_boundary_routes_exceptions_once()
    for _, callback_name in ipairs(callback_names) do
        local errors = 0
        local throwing = {
            is_active = function() return true end,
            on_callback_error = function(_, name, reason)
                gamma_arena_test_assert.equals(name, callback_name, "exception callback name")
                gamma_arena_test_assert.is_true(type(reason) == "string", "exception reason must be observable")
                errors = errors + 1
                return gamma_arena_result.err("GA_CALLBACK_FAILED", "routed exception")
            end,
            on_callback_result_error = function() error("exception path must not use false-Result routing") end
        }
        throwing[callback_name] = function() error("injected callback exception") end
        local callback = gamma_arena_bootstrap.make_callbacks(throwing)[callback_name]
        local call_ok, result = pcall(callback, 11, 22, { ret = false })
        gamma_arena_test_assert.is_true(call_ok, callback_name .. " boundary must contain exceptions")
        gamma_arena_test_assert.is_false(result.ok, callback_name .. " exception must return structured failure")
        gamma_arena_test_assert.equals(errors, 1, callback_name .. " exception must route exactly once")
    end
end

local function callback_boundary_routes_false_results_once()
    for _, callback_name in ipairs(callback_names) do
        local routes, callback_errors = 0, 0
        local expected = gamma_arena_result.err("GA_TEST_CALLBACK_RESULT", "injected Result failure", { callback = callback_name })
        local failing = {
            is_active = function() return true end,
            on_callback_error = function() callback_errors = callback_errors + 1 end,
            on_callback_result_error = function(_, name, result, was_active)
                gamma_arena_test_assert.equals(name, callback_name, "false-Result callback name")
                gamma_arena_test_assert.is_true(result == expected, "false-Result identity must be preserved")
                gamma_arena_test_assert.is_true(was_active, "critical callback must preserve prior active state")
                routes = routes + 1
                return result
            end
        }
        failing[callback_name] = function() return expected, "secondary-return" end
        local callback = gamma_arena_bootstrap.make_callbacks(failing)[callback_name]
        local call_ok, result, secondary = pcall(callback, 11, 22, { ret = false })
        gamma_arena_test_assert.is_true(call_ok, callback_name .. " false Result boundary must not throw")
        gamma_arena_test_assert.is_true(result == expected, callback_name .. " must preserve the original Result")
        gamma_arena_test_assert.equals(secondary, "secondary-return", callback_name .. " must preserve additional return values")
        gamma_arena_test_assert.equals(routes, 1, callback_name .. " false Result must route exactly once")
        gamma_arena_test_assert.equals(callback_errors, 0, callback_name .. " false Result must not use exception routing")
    end
end

local function inactive_callback_results_remain_benign()
    local calls, routes = 0, 0
    local inactive = {
        is_active = function() return false end,
        save_state = function() calls = calls + 1; return gamma_arena_result.err("GA_MUST_NOT_RUN", "inactive") end,
        on_callback_error = function() routes = routes + 1 end,
        on_callback_result_error = function() routes = routes + 1 end
    }
    local result = gamma_arena_bootstrap.make_callbacks(inactive).save_state({})
    gamma_arena_test_assert.equals(result, nil, "inactive effect callback must remain a nil no-op")
    gamma_arena_test_assert.equals(calls, 0, "inactive callback must not delegate")
    gamma_arena_test_assert.equals(routes, 0, "inactive no-op must not enter error routing")
end

local function active_save_failure_enters_fatal_once()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local fatal_count = 0
    deps.ui.show_fatal = function() fatal_count = fatal_count + 1; return {} end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator.session.future_field = true
    local result = gamma_arena_bootstrap.make_callbacks(orchestrator).save_state({})
    gamma_arena_test_assert.is_false(result.ok, "invalid active ArenaSession save must remain observable")
    gamma_arena_test_assert.equals(orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "invalid checkpoint payload must poison runtime state")
    gamma_arena_test_assert.is_false(orchestrator:is_active(), "invalid checkpoint payload cannot remain active")
    gamma_arena_test_assert.equals(fatal_count, 1, "active save failure must enter fatal routing exactly once")
end

local function fatal_ui_helper_propagates_callback_results()
    local attempts = 0
    local failure = gamma_arena_result.err("GA_DISCONNECT_FAILED", "retry")
    local function callback()
        attempts = attempts + 1
        if attempts == 1 then return failure end
        return gamma_arena_result.ok(true)
    end
    local first = gamma_arena_ui_start.invoke_fatal_main_menu(callback, nil, {})
    local second = gamma_arena_ui_start.invoke_fatal_main_menu(callback, nil, {})
    gamma_arena_test_assert.is_true(first == failure, "Task 4 fatal UI must return disconnect failure unchanged")
    gamma_arena_test_assert.is_true(second.ok, "Task 4 fatal UI must return retry success")
end

local function bootstrap_registration_rolls_back_every_position()
    for failure_position = 1, #callback_names do
        local active, rollback_order, compose_count, register_count = {}, {}, 0, 0
        local fail_at = failure_position
        local registrar = gamma_arena_bootstrap.new_registrar({
            compose = function()
                compose_count = compose_count + 1
                local instance = { is_active = function() return false end }
                for _, name in ipairs(callback_names) do instance[name] = function() return gamma_arena_result.ok(false) end end
                return instance
            end,
            register = function(name, callback)
                register_count = register_count + 1
                if register_count == fail_at then error("injected registration failure") end
                gamma_arena_test_assert.equals(active[name], nil, "callback must never be registered twice: " .. name)
                active[name] = callback
            end,
            unregister = function(name, callback)
                gamma_arena_test_assert.is_true(active[name] == callback, "rollback must use the exact registered callback reference")
                active[name] = nil
                rollback_order[#rollback_order + 1] = name
            end
        })
        local failed = registrar:register_all()
        gamma_arena_test_assert.is_false(failed.ok, "registration position " .. failure_position .. " must fail")
        gamma_arena_test_assert.equals(registrar:status(), "idle", "clean rollback must permit a later retry")
        for index = 1, failure_position - 1 do
            gamma_arena_test_assert.equals(rollback_order[index], callback_names[failure_position - index], "rollback must be reverse ordered")
        end
        register_count = 0
        fail_at = nil
        local retried = registrar:register_all()
        gamma_arena_test_assert.is_true(retried.ok, "clean rollback must allow a fresh registration attempt")
        gamma_arena_test_assert.equals(compose_count, 2, "retry composes exactly one new orchestrator after clean rollback")
        local active_count = 0
        for _ in pairs(active) do active_count = active_count + 1 end
        gamma_arena_test_assert.equals(active_count, #callback_names, "retry must leave exactly one copy of every callback")
    end
end

local function bootstrap_registration_poison_blocks_retry()
    local compose_count, register_count, unregister_count = 0, 0, 0
    local registrar = gamma_arena_bootstrap.new_registrar({
        compose = function()
            compose_count = compose_count + 1
            local instance = { is_active = function() return false end }
            for _, name in ipairs(callback_names) do instance[name] = function() return gamma_arena_result.ok(false) end end
            return instance
        end,
        register = function()
            register_count = register_count + 1
            if register_count == 4 then error("injected registration failure") end
        end,
        unregister = function()
            unregister_count = unregister_count + 1
            if unregister_count == 2 then return false end
        end
    })
    local first = registrar:register_all()
    local second = registrar:register_all()
    gamma_arena_test_assert.is_false(first.ok and second.ok, "rollback failure must remain failed closed")
    gamma_arena_test_assert.equals(registrar:status(), "poisoned", "rollback failure must poison bootstrap registration")
    gamma_arena_test_assert.equals(compose_count, 1, "poisoned registration cannot create a second orchestrator")
    gamma_arena_test_assert.equals(register_count, 4, "poisoned registration cannot retry callbacks")
    gamma_arena_test_assert.equals(unregister_count, 3, "rollback continues in reverse after one unregister failure")
end

local function bootstrap_requires_unregister_before_composition()
    local compose_count = 0
    local registrar = gamma_arena_bootstrap.new_registrar({
        compose = function() compose_count = compose_count + 1; return {} end,
        register = function() end
    })
    local result = registrar:register_all()
    gamma_arena_test_assert.is_false(result.ok, "missing UnregisterScriptCallback must fail closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_BOOTSTRAP_REGISTRATION_POISONED", "missing unregister code")
    gamma_arena_test_assert.equals(registrar:status(), "poisoned", "missing unregister must poison process registration")
    gamma_arena_test_assert.equals(compose_count, 0, "feature probe must run before orchestrator/router composition")
end

local function net_destroy_teardown_honors_checkpoint_latch()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local reasons = {}
    local deps = fake_orchestrator_deps(store)
    deps.teardown = function(reason, preserve) reasons[#reasons + 1] = reason .. ":" .. tostring(preserve); return gamma_arena_result.ok(true) end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:expect_checkpoint_reload()
    orchestrator:actor_on_net_destroy()
    orchestrator:actor_on_net_destroy()
    gamma_arena_test_assert.equals(reasons[1], "checkpoint_reload:true", "expected reload preserves session route")
    gamma_arena_test_assert.equals(#reasons, 1, "net-destroy teardown must be idempotent")
end

local function unexpected_net_destroy_clears_external_route()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:actor_on_net_destroy()
    gamma_arena_test_assert.equals(store.clear_matching_count, 1, "unexpected actor destruction clears only this Arena session's resume route")
end

local function runtime_fatal_recovery_waits_for_cleanup_before_disconnect()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({
        schema_version = 1,
        session_id = session.session_id,
        session_nonce = session.session_nonce,
        next_fight_index = session.fight_index,
        checkpoint_name = session.checkpoint_name
    })
    local deps = fake_orchestrator_deps(store)
    local checkpoint = deps.checkpoint
    function checkpoint:begin_resume_recovery()
        return gamma_arena_result.err("GA_CHECKPOINT_RECOVERY_MISSING", "injected missing checkpoint")
    end
    function checkpoint:cleanup()
        self.current = "CLEANING"
        self.cleanup_updates_remaining = 3
        return gamma_arena_result.ok(true)
    end
    function checkpoint:update()
        if self.current == "CLEANING" then
            self.cleanup_updates_remaining = self.cleanup_updates_remaining - 1
            if self.cleanup_updates_remaining <= 0 then self.current = "NONE" end
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    local disconnects, cleanup_session = 0, nil
    local orchestrator = nil
    deps.disconnect = function() disconnects = disconnects + 1; return true end
    deps.teardown = function()
        cleanup_session = orchestrator:session_snapshot()
        checkpoint:cleanup(cleanup_session)
        return checkpoint:update()
    end
    orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "fresh recovery failure enters fatal routing")
    gamma_arena_test_assert.is_true(cleanup_session ~= nil, "fatal teardown retains the loaded ArenaSession for matching cleanup")
    local pending = orchestrator:main_menu_action()
    gamma_arena_test_assert.is_false(pending.ok, "main menu waits while exact cleanup is pending")
    gamma_arena_test_assert.equals(pending.error.code, "GA_RUNTIME_CLEANUP_PENDING", "pending cleanup has a retryable result")
    gamma_arena_test_assert.equals(disconnects, 0, "disconnect cannot bypass exact cleanup")
    orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(orchestrator:main_menu_action().ok, "main menu succeeds after cleanup reaches NONE")
    gamma_arena_test_assert.equals(disconnects, 1, "disconnect executes exactly once after cleanup")
end

local function runtime_pre_session_fatal_waits_for_cleanup_before_disconnect()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local checkpoint = deps.checkpoint
    function checkpoint:cleanup()
        self.current = "CLEANING"
        self.cleanup_updates_remaining = 3
        return gamma_arena_result.ok(true)
    end
    function checkpoint:update()
        if self.current == "CLEANING" then
            self.cleanup_updates_remaining = self.cleanup_updates_remaining - 1
            if self.cleanup_updates_remaining <= 0 then self.current = "NONE" end
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    local disconnects = 0
    deps.preflight = function() return gamma_arena_result.err("GA_PREFLIGHT_FAILED", "injected pre-session failure") end
    deps.disconnect = function() disconnects = disconnects + 1; return true end
    deps.teardown = function()
        checkpoint:cleanup(nil)
        return checkpoint:update()
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "launch preflight failure enters fatal before session assignment")
    gamma_arena_test_assert.equals(orchestrator:session_snapshot(), nil, "preflight fatal has no ArenaSession")
    local pending = orchestrator:main_menu_action()
    gamma_arena_test_assert.is_false(pending.ok, "pre-session fatal still waits for exact checkpoint cleanup")
    gamma_arena_test_assert.equals(pending.error.code, "GA_RUNTIME_CLEANUP_PENDING", "pre-session cleanup exposes retryable pending result")
    gamma_arena_test_assert.equals(disconnects, 0, "pre-session fatal cannot disconnect while cleanup is pending")
    orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(orchestrator:main_menu_action().ok, "pre-session fatal disconnects after checkpoint reaches NONE")
    gamma_arena_test_assert.equals(disconnects, 1, "pre-session fatal disconnect executes once")
end

local function runtime_prepare_resume_legacy_mismatch_is_normalized()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.err("GA_RESUME_NONCE_MISMATCH", "injected legacy store mismatch")
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "legacy preparation mismatch enters fatal routing")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "orchestrator exposes one restore-failure contract at the recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_RESUME_NONCE_MISMATCH", "normalized restore failure preserves the legacy mismatch cause")
end

local function fake_vector(x, y, z)
    local value = { x = x, y = y, z = z }
    function value:sub(other)
        return fake_vector(self.x - other.x, self.y - other.y, self.z - other.z)
    end
    function value:getH()
        return self.x + self.z
    end
    return value
end

local function fake_actor_adapter_env()
    local env = {
        active = true,
        owned = true,
        iterating = false,
        released = {},
        input_acquires = 0,
        input_releases = 0,
        effect_calls = 0,
        body_health_reset_calls = 0,
        bhs = {
            maxhp = { head = 11, torso = 11, leftarm = 5, rightarm = 5, leftleg = 5, rightleg = 5 },
            health = { head = 2, torso = 3, leftarm = 1, rightarm = 2, leftleg = 1, rightleg = 2 },
            timedhp = { head = 1, torso = 1, leftarm = 1, rightarm = 1, leftleg = 1, rightleg = 1 }
        },
        boundary_inside = true,
        boundary_checks = 0,
        positions = {
            actor_spawn = fake_vector(1, 2, 3),
            actor_look = fake_vector(5, 2, 9)
        }
    }
    local actor = { items = {}, actor_id = 700, money_value = 2500 }
    function actor:id() return self.actor_id end
    function actor:money() return self.money_value end
    function actor:give_money(value) self.money_delta = value; self.money_value = self.money_value + value end
    function actor:iterate_inventory(callback, context)
        env.iterating = true
        local snapshot = {}
        for index = 1, #self.items do snapshot[index] = self.items[index] end
        for index = 1, #snapshot do callback(context, snapshot[index]) end
        env.iterating = false
    end
    function actor:set_health_ex(value) self.health_value = value end
    actor.power = 0.25
    actor.radiation = 0.5
    actor.bleeding = 0.75
    actor.psy_health = 0.5
    function actor:set_actor_position(value) self.position_value = value; env.boundary_inside = true end
    function actor:set_actor_direction(value) self.direction_value = value end
    function actor:set_invulnerable(value) self.invulnerable_value = value end
    function actor:position() return self.position_value or fake_vector(0, 0, 0) end
    env.actor = actor
    function env:add_item(id, options)
        options = options or {}
        local item = { item_id = id, options = options, parent_calls = 0, id_calls = 0 }
        function item:id()
            self.id_calls = self.id_calls + 1
            if self.options.item_id_throw then error("injected item id failure") end
            return self.item_id
        end
        function item:parent()
            self.parent_calls = self.parent_calls + 1
            if self.options.parent_throw then error("injected parent lookup failure") end
            if self.options.parent_missing then return nil end
            return self.options.parent or actor
        end
        actor.items[#actor.items + 1] = item
        return item
    end
    local function release(id)
        gamma_arena_test_assert.is_false(env.iterating, "inventory mutation must happen only after iteration")
        env.released[#env.released + 1] = id
        for index = #actor.items, 1, -1 do
            if actor.items[index].item_id == id then table.remove(actor.items, index) end
        end
        return gamma_arena_result.ok(true)
    end
    local deps = {
        actor = function() return actor end,
        is_session_active = function() return env.active end,
        is_actor_owned = function(candidate) return env.owned and candidate == actor end,
        release_item_id = release,
        patrol = function(path)
            local object = {}
            function object:point() return env.positions[path] end
            return object
        end,
        boundary_contains = function(candidate, zone_name)
            env.boundary_checks = env.boundary_checks + 1
            gamma_arena_test_assert.is_true(candidate == actor, "boundary checks only the owned actor")
            gamma_arena_test_assert.equals(zone_name, "bar_arena_sr", "boundary uses the configured restrictor")
            return gamma_arena_result.ok(env.boundary_inside)
        end,
        effects = { disable_effects_timer = function() env.effect_calls = env.effect_calls + 1 end },
        mod_body_health_reset = function(candidate)
            gamma_arena_test_assert.is_true(candidate == actor, "body-health reset only touches the owned Arena actor")
            env.body_health_reset_calls = env.body_health_reset_calls + 1
            for part, maximum in pairs(env.bhs.maxhp) do
                env.bhs.health[part] = maximum
                env.bhs.timedhp[part] = 0
            end
            return gamma_arena_result.ok(true)
        end,
        input = {
            acquire = function() env.input_acquires = env.input_acquires + 1; return gamma_arena_result.ok(true) end,
            release = function() env.input_releases = env.input_releases + 1; return gamma_arena_result.ok(true) end
        }
    }
    return env, gamma_arena_actor_adapter.new(deps)
end

local function runtime_actor_inventory_release_is_deferred_and_verified()
    local env, adapter = fake_actor_adapter_env()
    local first = env:add_item(12)
    local second = env:add_item(13)
    adapter:begin_update()
    local normalized = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(normalized.ok, "owned Arena actor normalization must start")
    gamma_arena_test_assert.equals(env.released[1], 12, "inventory IDs retain deterministic iteration order")
    gamma_arena_test_assert.equals(env.released[2], 13, "equipped/inventory items are released after collection")
    gamma_arena_test_assert.equals(first.parent_calls, 1, "real client item parent object is inspected")
    gamma_arena_test_assert.equals(second.parent_calls, 1, "every inventory item uses game_object:parent()")
    gamma_arena_test_assert.is_false(adapter:verify_inventory_empty().value, "inventory cannot be verified on the purge update")
    adapter:begin_update()
    gamma_arena_test_assert.is_true(adapter:verify_inventory_empty().value, "a later update confirms the inventory is empty")
    adapter:begin_update()
    gamma_arena_test_assert.is_true(adapter:verify_inventory_empty().value, "inventory verification is idempotent")
end

local function runtime_actor_normalization_uses_gamma_bleeding_sentinel()
    local env, adapter = fake_actor_adapter_env()
    adapter:begin_update()
    local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(result.ok, "normalization succeeds")
    gamma_arena_test_assert.equals(env.actor.health_value, 1, "health normalized")
    gamma_arena_test_assert.equals(env.actor.power, 1, "power normalized through the real actor property")
    gamma_arena_test_assert.equals(env.actor.radiation, 0, "radiation normalized through the real actor property")
    gamma_arena_test_assert.equals(env.actor.bleeding, 1, "GAMMA cured bleeding sentinel is written through the real actor property")
    gamma_arena_test_assert.equals(env.actor.psy_health, 1, "psy health normalized through the real actor property")
    gamma_arena_test_assert.equals(env.actor.money_delta, -2500, "Arena actor money is zeroed by delta")
    gamma_arena_test_assert.equals(env.effect_calls, 1, "optional animation timer feature is invoked when present")
    gamma_arena_test_assert.equals(env.actor.position_value.x, 1, "actor is teleported to the spawn anchor x")
    gamma_arena_test_assert.equals(env.actor.position_value.y, 2, "actor is teleported to the spawn anchor y")
    gamma_arena_test_assert.equals(env.actor.position_value.z, 3, "actor is teleported to the spawn anchor z")
    gamma_arena_test_assert.equals(env.actor.direction_value, -10, "actor direction uses the negative spawn-to-look heading")
end

local function runtime_actor_rematch_resets_gamma_body_health()
    local env, adapter = fake_actor_adapter_env()
    adapter:begin_update()
    local reset = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(reset.ok, "rematch normalization invokes optional GAMMA body health integration")
    gamma_arena_test_assert.equals(env.body_health_reset_calls, 1, "body health is reset once per rematch normalization")
    for part, maximum in pairs(env.bhs.maxhp) do
        gamma_arena_test_assert.equals(env.bhs.health[part], maximum, "rematch fully heals BHS part " .. part)
        gamma_arena_test_assert.equals(env.bhs.timedhp[part], 0, "rematch clears pending BHS treatment for " .. part)
    end
end

local function runtime_actor_input_ownership_is_idempotent()
    local env, adapter = fake_actor_adapter_env()
    adapter:begin_update()
    adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.equals(env.input_acquires, 1, "global input is acquired once by this adapter")
    adapter:release_input()
    adapter:release_input()
    gamma_arena_test_assert.equals(env.input_releases, 1, "only owned input is released once")
end

local function runtime_actor_victory_reset_waits_for_inventory_absence()
    local env, adapter = fake_actor_adapter_env()
    local cleanup_calls = 0
    adapter.deps.loadout = {
        cleanup = function() cleanup_calls = cleanup_calls + 1; return gamma_arena_result.ok(true) end
    }
    adapter:begin_update()
    local first = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(first.ok and type(first.value) == "table" and first.value.pending == true, "victory reset remains pending until a later update proves inventory absence")
    adapter:begin_update()
    local second = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(second.ok and second.value == true, "later update completes victory reset after absence proof")
    gamma_arena_test_assert.equals(cleanup_calls, 1, "owned loadout cleanup begins once per victory reset")
    gamma_arena_test_assert.equals(env.input_acquires, 1, "victory reset retains one input ownership lease")
end

local function runtime_actor_rejects_coincident_patrol_points()
    local env, adapter = fake_actor_adapter_env()
    env.positions.actor_look = fake_vector(1, 2, 3)
    adapter:begin_update()
    local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_false(result.ok, "coincident spawn/look anchors fail closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_PATROL_COINCIDENT", "coincident patrol error code")
    gamma_arena_test_assert.equals(env.input_releases, 1, "normalization failure releases owned input")
end

local function runtime_actor_rejects_campaign_actor()
    local env, adapter = fake_actor_adapter_env()
    env.active = false
    local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_false(result.ok, "inactive/campaign actor must never be normalized")
    gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_INACTIVE", "campaign guard code")
end

local function runtime_actor_boundary_repositions_only_after_breach()
    local env, adapter = fake_actor_adapter_env()
    local layout = { actor_spawn_path = "actor_spawn", actor_look_path = "actor_look", actor_boundary_zone = "bar_arena_sr" }
    local inside = adapter:enforce_boundary(layout)
    gamma_arena_test_assert.is_true(inside.ok and inside.value.breach == false, "inside actor remains untouched")
    gamma_arena_test_assert.equals(env.actor.position_value, nil, "inside actor is not repositioned")

    env.boundary_inside = false
    local outside = adapter:enforce_boundary(layout)
    gamma_arena_test_assert.is_true(outside.ok and outside.value.breach == true, "outside actor is recovered")
    gamma_arena_test_assert.equals(env.actor.position_value.x, 1, "boundary breach returns actor to ingress")
    gamma_arena_test_assert.equals(env.boundary_checks, 2, "boundary is checked once per explicit enforcement")
end

local function fake_checkpoint_env()
    local env = {
        now = 0,
        files = {},
        commands = {},
        order = {},
        rename_fail = false,
        delete_fail = false,
        rename_actions = {},
        delete_actions = {},
        rename_always_throw = false,
        rename_always_false = false,
        delete_always_throw = false,
        delete_always_false = false,
        expect_count = 0
    }
    local function next_action(actions)
        if #actions == 0 then return nil end
        local value = actions[1]
        table.remove(actions, 1)
        return value
    end
    local prefix = "C:\\ArenaSaves\\"
    local fs = {}
    local function require_allowed(path)
        if env.strict_paths and (not env.allowed_paths or env.allowed_paths[path] ~= true) then
            error("checkpoint fake observed path outside exact six: " .. tostring(path))
        end
    end
    function fs:resolve(name) return gamma_arena_result.ok(prefix .. name) end
    function fs:exists(path) require_allowed(path); return gamma_arena_result.ok(env.files[path] ~= nil) end
    function fs:size(path) require_allowed(path); return gamma_arena_result.ok(env.files[path]) end
    function fs:rename(source, target)
        require_allowed(source); require_allowed(target)
        env.order[#env.order + 1] = "rename:" .. source
        local action = env.rename_always_throw and "throw" or (env.rename_always_false and "false" or next_action(env.rename_actions))
        if action == "throw" then error("injected rename failure") end
        if action == "false" then return false end
        if action == "zero_target" then
            env.files[source] = nil
            env.files[target] = 0
            return gamma_arena_result.ok(true)
        end
        if not env.rename_fail and env.files[source] ~= nil then env.files[target] = env.files[source]; env.files[source] = nil end
        return gamma_arena_result.ok(true)
    end
    function fs:delete(path)
        require_allowed(path)
        env.order[#env.order + 1] = "delete:" .. path
        local action = env.delete_always_throw and "throw" or (env.delete_always_false and "false" or next_action(env.delete_actions))
        if action == "throw" then error("injected delete failure") end
        if action == "false" then return false end
        if not env.delete_fail then env.files[path] = nil end
        return gamma_arena_result.ok(true)
    end
    env.store = fake_store()
    function env:new_adapter(store)
        if store ~= nil then self.store = store end
        return gamma_arena_checkpoint_adapter.new({
            fs = fs,
            clock = function() return self.now end,
            console = function(command)
                if self.command_throw then error("injected console failure") end
                self.commands[#self.commands + 1] = command
                self.order[#self.order + 1] = "console:" .. command
                return gamma_arena_result.ok(true)
            end,
            store = self.store,
            config = {},
            expect_unload = function() self.expect_count = self.expect_count + 1; return gamma_arena_result.ok(true) end,
            settle_ms = 250,
            timeout_ms = 1000
        })
    end
    local adapter = env:new_adapter()
    env.adapter = adapter
    env.paths = adapter:paths().value
    env.allowed_paths = {}
    for _, group in pairs(env.paths) do
        for _, path in pairs(group) do env.allowed_paths[path] = true end
    end
    return env
end

local function start_checkpoint_save(env)
    gamma_arena_test_assert.is_true(env.adapter:create(valid_session()).ok, "checkpoint create starts")
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "initial exact cleanup completes")
    gamma_arena_test_assert.equals(env.adapter:state(), "SAVING", "cleanup transitions through SAVING")
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "fixed save command is submitted asynchronously")
    gamma_arena_test_assert.equals(env.commands[1], "save _gamma_arena_checkpoint", "only the fixed save command is submitted")
end

local function make_required_visible(env, scop_size, scoc_size)
    env.files[env.paths.visible.scop] = scop_size
    env.files[env.paths.visible.scoc] = scoc_size
end

local function advance_checkpoint_to_ready(env)
    start_checkpoint_save(env)
    make_required_visible(env, 100, 50)
    env.now = 10; env.adapter:update()
    env.now = 140; env.adapter:update()
    env.now = 300; env.adapter:update()
    env.now = 320; env.adapter:update()
    return env.adapter:state()
end

local function advance_checkpoint_to_hiding(env)
    start_checkpoint_save(env)
    make_required_visible(env, 100, 50)
    env.now = 10; env.adapter:update()
    env.now = 140; env.adapter:update()
    env.now = 300; env.adapter:update()
    gamma_arena_test_assert.equals(env.adapter:state(), "HIDING", "fixture reaches HIDING before mutation")
end

local function runtime_checkpoint_requires_stable_required_files()
    local env = fake_checkpoint_env()
    start_checkpoint_save(env)
    env.files[env.paths.visible.scop] = 100
    env.now = 300
    gamma_arena_test_assert.equals(env.adapter:update().value.state, "WAITING_STABLE", "scoc is mandatory")
    env.files[env.paths.visible.scoc] = 50
    env.now = 400; env.adapter:update()
    env.files[env.paths.visible.scop] = 101
    env.now = 700; env.adapter:update()
    gamma_arena_test_assert.equals(env.adapter:state(), "WAITING_STABLE", "size change resets stability")
    env.now = 850; env.adapter:update()
    env.now = 1000; env.adapter:update()
    env.adapter:update()
    gamma_arena_test_assert.equals(env.adapter:state(), "READY", "both nonzero required files become hidden only after distinct stable polls")
    gamma_arena_test_assert.equals(env.files[env.paths.hidden.scop], 101, "hidden scop retained")
    gamma_arena_test_assert.equals(env.files[env.paths.hidden.scoc], 50, "hidden scoc retained")
end

local function runtime_checkpoint_allows_absent_or_late_dds()
    local env = fake_checkpoint_env()
    gamma_arena_test_assert.equals(advance_checkpoint_to_ready(env), "READY", "missing screenshot cannot block checkpoint")
    env.files[env.paths.visible.dds] = 25
    env.now = env.now + 10
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "late screenshot is handled while ready")
    gamma_arena_test_assert.equals(env.files[env.paths.visible.dds], nil, "late visible screenshot is hidden")
    gamma_arena_test_assert.equals(env.files[env.paths.hidden.dds], 25, "late screenshot remains available")
end

local function runtime_checkpoint_wrap_clock_times_out()
    local env = fake_checkpoint_env()
    env.now = 4294967200
    start_checkpoint_save(env)
    env.now = 950
    local result = env.adapter:update()
    gamma_arena_test_assert.is_false(result.ok, "uint32 clock wrap still reaches timeout")
    gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_TIMEOUT", "wrap-safe timeout code")
end

local function runtime_checkpoint_load_wait_is_bounded_and_wrap_safe()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.now = 4294967200
    gamma_arena_test_assert.is_true(env.adapter:restore(valid_session(), 1).ok, "restore starts near uint32 wrap")
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "accepted load command waits for callback")
    gamma_arena_test_assert.equals(env.adapter:state(), "LOADING", "load command enters bounded LOADING")
    env.now = 400
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "LOADING remains pending before timeout")
    env.now = 1100
    local timed_out = env.adapter:update()
    gamma_arena_test_assert.is_false(timed_out.ok, "missing on_game_load cannot block forever")
    gamma_arena_test_assert.equals(timed_out.error.code, "GA_CHECKPOINT_LOAD_TIMEOUT", "LOADING uses a dedicated timeout code")
    gamma_arena_test_assert.equals(env.adapter:state(), "ERROR", "LOADING timeout terminates in ERROR")
end

local function runtime_checkpoint_transient_mutation_failures_retry_to_success()
    local hide = fake_checkpoint_env()
    advance_checkpoint_to_hiding(hide)
    hide.rename_actions = { "throw", "false" }
    gamma_arena_test_assert.is_true(hide.adapter:update().ok, "throwing hide rename remains pending")
    gamma_arena_test_assert.is_true(hide.adapter:update().ok, "false hide rename remains pending")
    gamma_arena_test_assert.is_true(hide.adapter:update().ok, "hide rename eventually succeeds")
    gamma_arena_test_assert.equals(hide.adapter:state(), "READY", "hide retry converges")

    local restore = fake_checkpoint_env()
    advance_checkpoint_to_ready(restore)
    restore.adapter:restore(valid_session(), 2)
    restore.rename_actions = { "throw" }
    gamma_arena_test_assert.is_true(restore.adapter:update().ok, "throwing unhide rename remains pending")
    gamma_arena_test_assert.is_true(restore.adapter:update().ok, "unhide rename retries to accepted load")
    gamma_arena_test_assert.equals(restore.adapter:state(), "LOADING", "unhide retry converges")
    restore.adapter:on_game_load()
    restore.adapter:begin_resume_recovery(valid_session(), restore.store.issued_resume)
    restore.rename_actions = { "false" }
    gamma_arena_test_assert.is_true(restore.adapter:update().ok, "false rehide rename remains pending")
    gamma_arena_test_assert.is_true(restore.adapter:update().ok, "rehide rename retries to READY")
    gamma_arena_test_assert.equals(restore.adapter:state(), "READY", "rehide retry converges")

    local cleanup = fake_checkpoint_env()
    cleanup.files[cleanup.paths.hidden.scop] = 100
    cleanup.delete_actions = { "throw", "false" }
    cleanup.adapter:cleanup(valid_session())
    gamma_arena_test_assert.is_true(cleanup.adapter:update().ok, "throwing cleanup delete remains pending")
    gamma_arena_test_assert.is_true(cleanup.adapter:update().ok, "false cleanup delete remains pending")
    gamma_arena_test_assert.is_true(cleanup.adapter:update().ok, "cleanup delete retries to success")
    gamma_arena_test_assert.equals(cleanup.adapter:state(), "NONE", "cleanup retry converges")
end

local function runtime_checkpoint_zero_required_target_waits_for_timeout()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    gamma_arena_test_assert.is_true(env.adapter:restore(valid_session(), 1).ok, "restore starts before corrupt rename fixture")
    env.rename_actions = { "zero_target" }
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "zero-byte required target remains pending after rename")
    gamma_arena_test_assert.equals(env.adapter:state(), "UNHIDING", "corrupt required target cannot advance to load")
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "source-absent zero-byte target remains pending on the next poll")
    gamma_arena_test_assert.equals(#env.commands, 1, "zero-byte required target never issues a load command")
    env.now = env.now + 1001
    local timed_out = env.adapter:update()
    gamma_arena_test_assert.is_false(timed_out.ok, "zero-byte required target terminates at the shared deadline")
    gamma_arena_test_assert.equals(timed_out.error.code, "GA_CHECKPOINT_RENAME_FAILED", "corrupt required target reports rename failure")
    gamma_arena_test_assert.is_true(timed_out.error.context and timed_out.error.context.cause ~= nil, "corrupt required target retains the last postcondition cause")
    gamma_arena_test_assert.equals(env.adapter:state(), "ERROR", "corrupt required target converges deterministically to ERROR")
end

local function runtime_checkpoint_late_dds_retries_throw_then_succeeds()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.files[env.paths.visible.dds] = 25
    env.rename_actions = { "throw" }
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "throwing late DDS rename remains pending in READY")
    gamma_arena_test_assert.equals(env.adapter:state(), "READY", "transient late DDS failure keeps checkpoint usable while bounded retry is active")
    gamma_arena_test_assert.equals(env.files[env.paths.visible.dds], 25, "failed late DDS rename retains its exact visible source")
    gamma_arena_test_assert.is_true(env.adapter:update().ok, "late DDS rename retries to success")
    gamma_arena_test_assert.equals(env.files[env.paths.visible.dds], nil, "successful late DDS retry removes the visible source")
    gamma_arena_test_assert.equals(env.files[env.paths.hidden.dds], 25, "successful late DDS retry publishes the exact hidden target")
    gamma_arena_test_assert.equals(env.adapter:state(), "READY", "successful optional retry remains READY")
end

local function runtime_checkpoint_late_dds_permanent_failures_are_bounded_and_wrap_safe()
    for _, case in ipairs({
        { label = "throw", configure = function(env) env.rename_always_throw = true end },
        { label = "false", configure = function(env) env.rename_always_false = true end }
    }) do
        local env = fake_checkpoint_env()
        advance_checkpoint_to_ready(env)
        env.now = 4294967200
        env.files[env.paths.visible.dds] = 25
        case.configure(env)
        gamma_arena_test_assert.is_true(env.adapter:update().ok, case.label .. " late DDS failure starts a bounded retry")
        env.now = 400
        gamma_arena_test_assert.is_true(env.adapter:update().ok, case.label .. " late DDS failure remains pending across uint32 wrap before timeout")
        env.now = 1100
        local timed_out = env.adapter:update()
        gamma_arena_test_assert.is_false(timed_out.ok, case.label .. " late DDS failure terminates at the wrap-safe deadline")
        gamma_arena_test_assert.equals(timed_out.error.code, "GA_CHECKPOINT_DDS_TIMEOUT", case.label .. " late DDS failure has an explicit terminal diagnostic")
        gamma_arena_test_assert.is_true(timed_out.error.context and timed_out.error.context.cause ~= nil, case.label .. " late DDS timeout retains the last mutation cause")
        gamma_arena_test_assert.equals(env.adapter:state(), "ERROR", case.label .. " late DDS timeout converges deterministically to ERROR")
    end
end

local function runtime_bootstrap_teardown_drains_transient_exact_cleanup_idempotently()
    for _, event_name in ipairs({ "actor_on_net_destroy", "on_before_level_changing" }) do
        local env = fake_checkpoint_env()
        env.strict_paths = true
        for _, group in pairs(env.paths) do
            for _, path in pairs(group) do env.files[path] = 1 end
        end
        env.delete_actions = { "throw", "false" }
        local actor_cleanup_count = 0
        local actor = {
            cleanup = function()
                actor_cleanup_count = actor_cleanup_count + 1
                return gamma_arena_result.ok(true)
            end
        }
        local frame = 0
        local entity_updates = {}
        local entities = { current = "ACTIVE", cleanup_calls = 0 }
        function entities:cleanup()
            self.cleanup_calls = self.cleanup_calls + 1
            if self.current ~= "CLEAN" then self.current = "CLEANING" end
            return gamma_arena_result.ok(true)
        end
        function entities:update()
            entity_updates[#entity_updates + 1] = frame
            if frame >= 3 then self.current = "CLEAN" end
            return gamma_arena_result.ok({ state = self.current })
        end
        function entities:registry_snapshot() return { state = self.current, npcs = {}, items = {} } end
        local disconnects = 0
        local orchestrator = gamma_arena_bootstrap.compose({
            store = env.store,
            config = {},
            actor = actor,
            entities = entities,
            checkpoint = env.adapter,
            disconnect = function() disconnects = disconnects + 1; return true end,
            teardown_clock = function() return env.now end,
            teardown_timeout_ms = 1000,
            teardown_max_updates = 8
        })
        orchestrator.active = true
        orchestrator.session = valid_session()
        orchestrator.runtime_stage = "READY"
        orchestrator.checkpoint_ready = true
        local first = orchestrator[event_name](orchestrator)
        gamma_arena_test_assert.is_true(first.ok, event_name .. " starts deferred entity cleanup without a same-callback spin")
        gamma_arena_test_assert.is_false(orchestrator.teardown_done, event_name .. " cannot claim teardown completion while safe release is pending")
        gamma_arena_test_assert.equals(#entity_updates, 1, event_name .. " performs at most one entity poll in its callback")
        local pending = orchestrator:main_menu_action()
        gamma_arena_test_assert.is_false(pending.ok, event_name .. " blocks disconnect while entity cleanup is pending")
        gamma_arena_test_assert.equals(pending.error.code, "GA_RUNTIME_CLEANUP_PENDING", event_name .. " exposes a retryable pending cleanup result")
        gamma_arena_test_assert.equals(#entity_updates, 1, event_name .. " repeated callbacks in the same engine tick cannot consume the update budget")
        gamma_arena_test_assert.equals(disconnects, 0, event_name .. " cannot disconnect before entity CLEAN")
        for expected_frame = 1, 4 do
            frame = expected_frame
            env.now = env.now + 1
            gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, event_name .. " cleanup advances on a later actor callback")
        end
        gamma_arena_test_assert.is_true(orchestrator.teardown_done, event_name .. " latches completion only after a later callback observes CLEAN")
        gamma_arena_test_assert.equals(entities.current, "CLEAN", event_name .. " entity cleanup reaches CLEAN across frames")
        gamma_arena_test_assert.equals(env.adapter:state(), "NONE", event_name .. " checkpoint cleanup follows entity CLEAN")
        for _, group in pairs(env.paths) do
            for _, path in pairs(group) do gamma_arena_test_assert.equals(env.files[path], nil, event_name .. " deletes only and all six exact paths") end
        end
        gamma_arena_test_assert.equals(actor_cleanup_count, 1, event_name .. " actor cleanup executes once")
        gamma_arena_test_assert.is_true(orchestrator:main_menu_action().ok, event_name .. " disconnect becomes available only after full cleanup")
        gamma_arena_test_assert.equals(disconnects, 1, event_name .. " disconnect executes exactly once after cleanup")
        gamma_arena_test_assert.is_true(orchestrator[event_name](orchestrator).ok, event_name .. " repeated inactive event is benign")
        gamma_arena_test_assert.is_true(orchestrator:teardown_once("repeat", false).ok, event_name .. " repeated teardown call is benign")
        gamma_arena_test_assert.equals(actor_cleanup_count, 1, event_name .. " repeated teardown/event is idempotent")
    end
end

local function runtime_bootstrap_teardown_permanent_failures_are_bounded()
    local cases = {
        {
            label = "throw wrap timeout",
            code = "GA_RUNTIME_TEARDOWN_TIMEOUT",
            configure = function(env) env.delete_always_throw = true end,
            options = function(env)
                local ticks, index = { 4294967200, 400, 1100 }, 0
                return {
                    clock = function()
                        index = index + 1
                        return ticks[index] or ticks[#ticks]
                    end,
                    timeout_ms = 1000,
                    max_updates = 8
                }
            end
        },
        {
            label = "false update cap",
            code = "GA_RUNTIME_TEARDOWN_EXHAUSTED",
            configure = function(env) env.delete_always_false = true end,
            options = function(env)
                return { clock = function() return env.now end, timeout_ms = 1000, max_updates = 3 }
            end
        }
    }
    for _, case in ipairs(cases) do
        local env = fake_checkpoint_env()
        env.strict_paths = true
        env.files[env.paths.hidden.scop] = 100
        case.configure(env)
        local result = gamma_arena_bootstrap.drain_checkpoint_cleanup(env.adapter, valid_session(), case.options(env))
        gamma_arena_test_assert.is_false(result.ok, case.label .. " teardown failure is bounded")
        gamma_arena_test_assert.equals(result.error.code, case.code, case.label .. " teardown has a deterministic terminal diagnostic")
        gamma_arena_test_assert.equals(env.adapter:state(), "CLEANING", case.label .. " failed cleanup remains explicitly retryable")
        gamma_arena_test_assert.equals(env.files[env.paths.hidden.scop], 100, case.label .. " failed exact deletion never claims success")
    end
end

local function runtime_bootstrap_teardown_resets_across_sessions()
    local actor_cleanups = 0
    local actor = { cleanup = function() actor_cleanups = actor_cleanups + 1; return gamma_arena_result.ok(true) end }
    local entities = { current = "ACTIVE", cleanup_calls = 0 }
    function entities:cleanup() self.cleanup_calls = self.cleanup_calls + 1; self.current = "CLEAN"; return gamma_arena_result.ok(true) end
    function entities:update() return gamma_arena_result.ok(true) end
    function entities:registry_snapshot() return { state = self.current, npcs = {}, items = {} } end
    local checkpoint = { current = "NONE", cleanup_calls = 0 }
    function checkpoint:cleanup() self.cleanup_calls = self.cleanup_calls + 1; self.current = "NONE"; return gamma_arena_result.ok(true) end
    function checkpoint:update() return gamma_arena_result.ok(true) end
    function checkpoint:state() return self.current end
    function checkpoint:on_game_load() return gamma_arena_result.ok(true) end
    local store = { clear_resume_if_matches = function() return gamma_arena_result.ok(true) end }
    local now = 100
    local orchestrator = gamma_arena_bootstrap.compose({
        store = store,
        config = {},
        actor = actor,
        entities = entities,
        checkpoint = checkpoint,
        teardown_clock = function() return now end,
        teardown_timeout_ms = 1000,
        teardown_max_updates = 8
    })
    orchestrator.active = true
    orchestrator.session = valid_session()
    gamma_arena_test_assert.is_true(orchestrator:on_before_level_changing().ok, "first session teardown completes")
    gamma_arena_test_assert.equals(entities.cleanup_calls, 1, "first session cleans entities")
    gamma_arena_test_assert.equals(checkpoint.cleanup_calls, 1, "first session cleans checkpoint files")
    gamma_arena_test_assert.equals(actor_cleanups, 1, "first session cleans actor")

    gamma_arena_test_assert.is_true(orchestrator:on_game_load().ok, "later loaded game starts a fresh teardown cycle")
    entities.current = "ACTIVE"
    orchestrator.active = true
    orchestrator.session = valid_session()
    now = now + 1
    gamma_arena_test_assert.is_true(orchestrator:on_before_level_changing().ok, "second session teardown completes")
    gamma_arena_test_assert.equals(entities.cleanup_calls, 2, "second session cannot reuse stale entity cleanup completion")
    gamma_arena_test_assert.equals(checkpoint.cleanup_calls, 2, "second session cannot reuse stale checkpoint cleanup completion")
    gamma_arena_test_assert.equals(actor_cleanups, 2, "second session cannot reuse stale actor cleanup completion")
end

local function runtime_completed_teardown_allows_next_loaded_launch_activation()
    local store = fake_store({ launch_pending = false, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local teardown_calls = 0
    local base_teardown = deps.teardown
    deps.teardown = function(...)
        teardown_calls = teardown_calls + 1
        return base_teardown(...)
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator.active = true
    orchestrator.session = valid_session()
    gamma_arena_test_assert.is_true(orchestrator:on_before_level_changing().ok, "first Arena session completes its level-change teardown")
    gamma_arena_test_assert.is_true(orchestrator.cleanup_required and orchestrator.teardown_done, "completed teardown remains latched until exact cleanup readiness is consumed")

    store.intent_state = { launch_pending = true, resume_pending = false }
    gamma_arena_test_assert.is_true(orchestrator:on_game_load().ok, "next loaded Arena creates a fresh cleanup/activation generation")
    local cleanup_poll = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_true(cleanup_poll.ok, "next loaded actor update re-proves exact teardown before activation")
    gamma_arena_test_assert.is_false(orchestrator.cleanup_required, "cleanup latch clears only after teardown and checkpoint NONE are proved")
    gamma_arena_test_assert.is_false(orchestrator:is_active(), "cleanup proof and new launch activation do not collapse into one callback")
    gamma_arena_test_assert.equals(store.consume_launch_count, 0, "launch intent remains untouched until cleanup proof completes")
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "following actor update activates the newly loaded launch")
    gamma_arena_test_assert.is_true(orchestrator:is_active(), "completed prior teardown cannot strand the next loaded Arena in CLEANING")
    gamma_arena_test_assert.equals(store.consume_launch_count, 1, "new launch intent is consumed exactly once after cleanup readiness")
    gamma_arena_test_assert.equals(teardown_calls, 2, "each load generation proves its own teardown completion")
end

local function runtime_bootstrap_teardown_rejects_unbounded_update_limits()
    for _, value in ipairs({ math.huge, 257, 0, -1 }) do
        local env = fake_checkpoint_env()
        env.files[env.paths.hidden.scop] = 100
        local result = gamma_arena_bootstrap.drain_checkpoint_cleanup(env.adapter, valid_session(), {
            clock = function() return env.now end,
            timeout_ms = 1000,
            max_updates = value
        })
        gamma_arena_test_assert.is_false(result.ok, "invalid teardown update bound rejects: " .. tostring(value))
        gamma_arena_test_assert.equals(result.error.code, "GA_RUNTIME_TEARDOWN_INVALID", "invalid teardown update bound code")
        gamma_arena_test_assert.equals(env.adapter:state(), "NONE", "invalid teardown bound rejects before cleanup mutation")
        gamma_arena_test_assert.equals(env.files[env.paths.hidden.scop], 100, "invalid teardown bound leaves exact files untouched")
    end
end

local function runtime_bootstrap_teardown_override_budgets_route_exactly()
    local function clean_entities()
        return {
            cleanup = function() return gamma_arena_result.ok(true) end,
            update = function() return gamma_arena_result.ok(true) end,
            registry_snapshot = function() return { state = "CLEAN", npcs = {}, items = {} } end
        }
    end
    local function store() return { clear_resume_if_matches = function() return gamma_arena_result.ok(true) end } end
    local checkpoint = { current = "NONE", updates = 0 }
    function checkpoint:cleanup() self.current = "CLEANING"; self.updates = 0; return gamma_arena_result.ok(true) end
    function checkpoint:update() self.updates = self.updates + 1; if self.updates >= 2 then self.current = "NONE" end; return gamma_arena_result.ok(true) end
    function checkpoint:state() return self.current end
    local checkpoint_bounded = gamma_arena_bootstrap.compose({
        store = store(), config = {}, actor = { cleanup = function() return gamma_arena_result.ok(true) end }, entities = clean_entities(), checkpoint = checkpoint,
        teardown_clock = function() return 100 end, teardown_max_updates = 1, actor_teardown_max_updates = 8
    })
    checkpoint_bounded.active = true; checkpoint_bounded.session = valid_session()
    local checkpoint_failed = checkpoint_bounded:on_before_level_changing()
    gamma_arena_test_assert.is_false(checkpoint_failed.ok, "shared checkpoint budget remains routed to checkpoint cleanup")
    gamma_arena_test_assert.equals(checkpoint_failed.error.code, "GA_RUNTIME_TEARDOWN_EXHAUSTED", "checkpoint override routing diagnostic")

    local immediate_checkpoint = { cleanup = function() return gamma_arena_result.ok(true) end, update = function() return gamma_arena_result.ok(true) end, state = function() return "NONE" end }
    local actor_pending = { cleanup = function() return gamma_arena_result.ok({ pending = true }) end }
    local now = 100
    local actor_bounded = gamma_arena_bootstrap.compose({
        store = store(), config = {}, actor = actor_pending, entities = clean_entities(), checkpoint = immediate_checkpoint,
        teardown_clock = function() return now end, teardown_max_updates = 8, actor_teardown_max_updates = 1
    })
    actor_bounded.active = true; actor_bounded.session = valid_session()
    gamma_arena_test_assert.is_true(actor_bounded:on_before_level_changing().ok, "actor cleanup consumes its first dedicated poll")
    now = now + 1
    local actor_failed = actor_bounded:actor_on_update()
    gamma_arena_test_assert.is_false(actor_failed.ok, "dedicated actor budget bounds actor cleanup independently")
    gamma_arena_test_assert.equals(actor_failed.error.code, "GA_ACTOR_TEARDOWN_EXHAUSTED", "actor override routing diagnostic")
end

local function runtime_failed_teardown_retries_then_latches_success()
    local attempts = 0
    local deps = fake_orchestrator_deps(fake_store())
    deps.teardown = function()
        attempts = attempts + 1
        if attempts == 1 then return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_FAILED", "injected first teardown failure") end
        return gamma_arena_result.ok(true)
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    gamma_arena_test_assert.is_false(orchestrator:teardown_once("first", false).ok, "failed teardown remains observable")
    gamma_arena_test_assert.is_true(orchestrator:teardown_once("retry", false).ok, "failed teardown remains retryable")
    local repeated = orchestrator:teardown_once("repeat", false)
    gamma_arena_test_assert.is_true(repeated.ok, "successful teardown makes later calls benign")
    gamma_arena_test_assert.is_false(repeated.value, "successful teardown latches idempotent completion")
    gamma_arena_test_assert.equals(attempts, 2, "teardown retries exactly until the first success")
end

local function runtime_checkpoint_permanent_mutation_throws_time_out()
    local function assert_timeout(env, update, label)
        gamma_arena_test_assert.is_true(update().ok, label .. " first throw remains pending")
        env.now = (env.now + 1001) % 4294967296
        local result = update()
        gamma_arena_test_assert.is_false(result.ok, label .. " permanent throw times out")
        gamma_arena_test_assert.equals(env.adapter:state(), "ERROR", label .. " timeout terminates in ERROR")
        gamma_arena_test_assert.is_true(result.error.context and result.error.context.cause ~= nil, label .. " timeout retains last mutation cause")
    end

    local hide = fake_checkpoint_env()
    advance_checkpoint_to_hiding(hide)
    hide.rename_always_throw = true
    assert_timeout(hide, function() return hide.adapter:update() end, "hide")

    local unhide = fake_checkpoint_env()
    advance_checkpoint_to_ready(unhide)
    unhide.adapter:restore(valid_session(), 1)
    unhide.rename_always_throw = true
    assert_timeout(unhide, function() return unhide.adapter:update() end, "unhide")

    local rehide = fake_checkpoint_env()
    advance_checkpoint_to_ready(rehide)
    rehide.adapter:restore(valid_session(), 1)
    rehide.adapter:update()
    rehide.adapter:on_game_load()
    rehide.adapter:begin_resume_recovery(valid_session(), rehide.store.issued_resume)
    rehide.rename_always_throw = true
    assert_timeout(rehide, function() return rehide.adapter:update() end, "rehide")

    local cleanup = fake_checkpoint_env()
    cleanup.files[cleanup.paths.hidden.scop] = 100
    cleanup.adapter:cleanup(valid_session())
    cleanup.delete_always_throw = true
    assert_timeout(cleanup, function() return cleanup.adapter:update() end, "cleanup")
end

local function runtime_checkpoint_verifies_rename_and_delete_postconditions()
    local rename_env = fake_checkpoint_env()
    rename_env.rename_fail = true
    start_checkpoint_save(rename_env)
    make_required_visible(rename_env, 100, 50)
    rename_env.now = 100; rename_env.adapter:update()
    rename_env.now = 260; rename_env.adapter:update()
    rename_env.now = 420; rename_env.adapter:update()
    gamma_arena_test_assert.is_true(rename_env.adapter:update().ok, "locked rename is retried before timeout")
    rename_env.now = 1421
    local rename_result = rename_env.adapter:update()
    gamma_arena_test_assert.is_false(rename_result.ok, "truthy rename return cannot override failed postcondition")
    gamma_arena_test_assert.equals(rename_result.error.code, "GA_CHECKPOINT_RENAME_FAILED", "rename postcondition code")

    local delete_env = fake_checkpoint_env()
    delete_env.files[delete_env.paths.hidden.scop] = 100
    delete_env.delete_fail = true
    delete_env.adapter:cleanup(valid_session())
    gamma_arena_test_assert.is_true(delete_env.adapter:update().ok, "locked delete is retried before timeout")
    delete_env.now = 1001
    local delete_result = delete_env.adapter:update()
    gamma_arena_test_assert.is_false(delete_result.ok, "truthy delete return cannot override failed postcondition")
    gamma_arena_test_assert.equals(delete_result.error.code, "GA_CHECKPOINT_DELETE_FAILED", "delete postcondition code")
end

local function runtime_checkpoint_recovers_mixed_crash_states()
    local env = fake_checkpoint_env()
    env.files[env.paths.visible.scop] = 100
    env.files[env.paths.hidden.scoc] = 50
    env.files[env.paths.visible.dds] = 25
    start_checkpoint_save(env)
    gamma_arena_test_assert.equals(env.files[env.paths.visible.scop], nil, "mixed visible required file cleared")
    gamma_arena_test_assert.equals(env.files[env.paths.hidden.scoc], nil, "mixed hidden required file cleared")
    gamma_arena_test_assert.equals(env.files[env.paths.visible.dds], nil, "mixed optional file cleared")
end

local function runtime_checkpoint_persists_intent_before_load()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.order = {}
    local restored = env.adapter:restore(valid_session(), 1)
    gamma_arena_test_assert.is_true(restored.ok, "restore starts")
    gamma_arena_test_assert.equals(env.store.issue_resume_count, 1, "ResumeIntent is saved before any unhide")
    gamma_arena_test_assert.equals(#env.order, 0, "no file/load effect happens before persisted intent success")
    env.adapter:update()
    local issue_position, load_position
    for index = 1, #env.order do
        if string.find(env.order[index], "load _gamma_arena_checkpoint", 1, true) then load_position = index end
    end
    issue_position = 0
    gamma_arena_test_assert.is_true(load_position ~= nil and issue_position < load_position, "intent persistence precedes the fixed load command")
    gamma_arena_test_assert.equals(env.expect_count, 1, "expected-unload latch is acquired before load")
end

local function runtime_checkpoint_consumes_intent_only_after_rehide()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.adapter:restore(valid_session(), 2)
    env.adapter:update()
    gamma_arena_test_assert.equals(env.store.consume_resume_count, nil, "intent is not consumed on load submission")
    env.adapter:on_game_load()
    gamma_arena_test_assert.equals(env.store.consume_resume_count, nil, "intent is not consumed before rehide update")
    env.adapter:begin_resume_recovery(valid_session(), env.store.issued_resume)
    env.adapter:update()
    gamma_arena_test_assert.equals(env.store.consume_resume_count, 1, "matching intent is consumed only after hidden postconditions")
    gamma_arena_test_assert.equals(env.adapter:state(), "READY", "restore converges back to ready")
    gamma_arena_test_assert.equals(env.adapter:take_resume().value.next_fight_index, 2, "consumed resume index is cached for orchestration")
end

local function runtime_checkpoint_rejects_mismatched_resume()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.adapter:restore(valid_session(), 3)
    env.adapter:update()
    env.adapter:on_game_load()
    env.adapter:begin_resume_recovery(valid_session(), env.store.issued_resume)
    env.store.consume_resume_result = gamma_arena_result.err("GA_RESUME_NONCE_MISMATCH", "injected mismatch")
    local result = env.adapter:update()
    gamma_arena_test_assert.is_false(result.ok, "mismatched loaded session/intent fails closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_RECOVERY_MISMATCH", "store mismatch is normalized to the bounded recovery taxonomy")
end

local function fresh_recovery_env(files, persisted_intent)
    local env = fake_checkpoint_env()
    env.files = clone(files or {})
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.issued_resume = clone(persisted_intent)
    env.adapter = env:new_adapter(store)
    env.store = store
    env.paths = env.adapter:paths().value
    env.strict_paths = true
    return env
end

local function runtime_checkpoint_fresh_process_recovers_all_exact_layouts()
    local source = fake_checkpoint_env()
    advance_checkpoint_to_ready(source)
    source.adapter:restore(valid_session(), 4)
    source.adapter:update()
    local persisted = clone(source.store.issued_resume)
    local base_files = clone(source.files)
    for _, layout in ipairs({ "VV", "HH", "VH", "HV" }) do
        local env = fresh_recovery_env(base_files, persisted)
        local function move(extension)
            env.files[env.paths.hidden[extension]] = env.files[env.paths.visible[extension]]
            env.files[env.paths.visible[extension]] = nil
        end
        if string.sub(layout, 1, 1) == "H" then move("scop") end
        if string.sub(layout, 2, 2) == "H" then move("scoc") end
        local prepared = env.store:prepare_resume({}, valid_session())
        local begun = env.adapter:begin_resume_recovery(valid_session(), prepared.value)
        gamma_arena_test_assert.is_true(begun.ok and begun.value == true, "fresh adapter begins exact recovery for " .. layout)
        gamma_arena_test_assert.equals(env.adapter:state(), "REHIDING", "fresh NONE enters REHIDING for " .. layout)
        gamma_arena_test_assert.is_true(env.adapter:update().ok, "exact required layout converges for " .. layout)
        gamma_arena_test_assert.equals(env.adapter:state(), "READY", "fresh recovery reaches READY for " .. layout)
        gamma_arena_test_assert.equals(env.store.consume_resume_count, 1, "persisted intent is consumed once for " .. layout)
        gamma_arena_test_assert.equals(env.adapter:take_resume().value.next_fight_index, 4, "continuation survives fresh process for " .. layout)
        gamma_arena_test_assert.equals(env.files[env.paths.visible.scop], nil, "visible scop absent after recovery " .. layout)
        gamma_arena_test_assert.equals(env.files[env.paths.visible.scoc], nil, "visible scoc absent after recovery " .. layout)
    end
end

local function runtime_checkpoint_fresh_recovery_rejects_missing_inconsistent_and_mismatch()
    local intent = {
        schema_version = 1,
        session_id = valid_session().session_id,
        session_nonce = valid_session().session_nonce,
        next_fight_index = 4,
        checkpoint_name = "_gamma_arena_checkpoint"
    }
    local cases = {
        {
            label = "missing",
            code = "GA_CHECKPOINT_RECOVERY_MISSING",
            arrange = function() end
        },
        {
            label = "both",
            code = "GA_CHECKPOINT_RECOVERY_INCONSISTENT",
            arrange = function(env)
                env.files[env.paths.visible.scop] = 100
                env.files[env.paths.hidden.scop] = 100
                env.files[env.paths.hidden.scoc] = 50
            end
        },
        {
            label = "zero",
            code = "GA_CHECKPOINT_RECOVERY_INCONSISTENT",
            arrange = function(env)
                env.files[env.paths.hidden.scop] = 0
                env.files[env.paths.hidden.scoc] = 50
            end
        }
    }
    for _, case in ipairs(cases) do
        local env = fresh_recovery_env({}, intent)
        case.arrange(env)
        local result = env.adapter:begin_resume_recovery(valid_session(), intent)
        gamma_arena_test_assert.is_false(result.ok, case.label .. " recovery fails closed")
        gamma_arena_test_assert.equals(result.error.code, case.code, case.label .. " recovery code")
        gamma_arena_test_assert.equals(env.store.consume_resume_count, nil, case.label .. " never consumes intent")
        gamma_arena_test_assert.is_true(env.adapter:cleanup(valid_session()).ok, case.label .. " starts exact cleanup")
        gamma_arena_test_assert.is_true(env.adapter:update().ok, case.label .. " exact cleanup completes")
        gamma_arena_test_assert.equals(env.adapter:state(), "NONE", case.label .. " recovery cannot block forever")
        gamma_arena_test_assert.equals(env.store.clear_matching_count, 1, case.label .. " cleanup clears matching intent")
    end

    local mismatch = fresh_recovery_env({}, intent)
    mismatch.files[mismatch.paths.hidden.scop] = 100
    mismatch.files[mismatch.paths.hidden.scoc] = 50
    local prepared = clone(intent)
    prepared.session_nonce = "different_nonce"
    local rejected = mismatch.adapter:begin_resume_recovery(valid_session(), prepared)
    gamma_arena_test_assert.is_false(rejected.ok, "identity mismatch fails closed")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_CHECKPOINT_RECOVERY_MISMATCH", "identity mismatch recovery code")
end

local function runtime_checkpoint_fresh_recovery_rejects_persisted_intent_drift()
    local source = fake_checkpoint_env()
    advance_checkpoint_to_ready(source)
    source.adapter:restore(valid_session(), 5)
    source.adapter:update()
    local env = fresh_recovery_env(source.files, source.store.issued_resume)
    local prepared = clone(env.store.issued_resume)
    gamma_arena_test_assert.is_true(env.adapter:begin_resume_recovery(valid_session(), prepared).ok, "fresh recovery accepts prepared snapshot")
    env.store.issued_resume.next_fight_index = 6
    local result = env.adapter:update()
    gamma_arena_test_assert.is_false(result.ok, "persisted intent drift fails before READY")
    gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_RECOVERY_MISMATCH", "persisted drift recovery code")
    gamma_arena_test_assert.is_false(env.adapter:state() == "READY", "READY is never exposed after consume mismatch")
end

local function runtime_checkpoint_cleanup_is_idempotent_in_every_state()
    for _, setup in ipairs({ "NONE", "SAVING", "WAITING_STABLE", "HIDING", "READY", "UNHIDING", "LOADING", "REHIDING", "CLEANING", "ERROR" }) do
        local env = fake_checkpoint_env()
        if setup == "SAVING" then env.adapter:create(valid_session()); env.adapter:update() end
        if setup == "WAITING_STABLE" then start_checkpoint_save(env) end
        if setup == "HIDING" then advance_checkpoint_to_hiding(env) end
        if setup == "READY" or setup == "UNHIDING" or setup == "LOADING" or setup == "REHIDING" then
            advance_checkpoint_to_ready(env)
            if setup == "UNHIDING" then env.adapter:restore(valid_session(), 1) end
            if setup == "LOADING" or setup == "REHIDING" then
                env.adapter:restore(valid_session(), 1)
                env.adapter:update()
            end
            if setup == "REHIDING" then
                env.adapter:on_game_load()
                env.adapter:begin_resume_recovery(valid_session(), env.store.issued_resume)
            end
        end
        if setup == "CLEANING" then env.adapter:cleanup(valid_session()) end
        if setup == "ERROR" then
            env.adapter:create(valid_session())
            env.adapter:update()
            env.command_throw = true
            env.adapter:update()
            gamma_arena_test_assert.equals(env.adapter:state(), "ERROR", "fixture reaches ERROR before cleanup")
        end
        gamma_arena_test_assert.equals(env.adapter:state(), setup, "cleanup fixture reaches " .. setup)
        env.adapter:cleanup(valid_session())
        local first = env.adapter:update()
        local second = env.adapter:cleanup(valid_session())
        local third = env.adapter:update()
        gamma_arena_test_assert.is_true(first.ok and second.ok and third.ok, "cleanup is total and repeatable from " .. setup)
        gamma_arena_test_assert.equals(env.adapter:state(), "NONE", "cleanup converges to NONE from " .. setup)
    end
end

local function runtime_checkpoint_two_sessions_leave_no_stale_paths()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.adapter:cleanup(valid_session()); env.adapter:update()
    gamma_arena_test_assert.equals(advance_checkpoint_to_ready(env), "READY", "a second session creates a fresh checkpoint")
    for _, path in pairs(env.paths.visible) do gamma_arena_test_assert.equals(env.files[path], nil, "no visible checkpoint remains") end
end

local function runtime_checkpoint_six_paths_are_fixed_and_safe()
    local env = fake_checkpoint_env()
    local count = 0
    for _, group in pairs(env.paths) do
        for _, path in pairs(group) do
            count = count + 1
            gamma_arena_test_assert.is_true(string.find(path, "_gamma_arena_checkpoint", 1, true) ~= nil, "path uses fixed checkpoint base")
            gamma_arena_test_assert.is_true(string.find(path, "..", 1, true) == nil, "path traversal is impossible")
        end
    end
    gamma_arena_test_assert.equals(count, 6, "checkpoint adapter resolves exactly six absolute paths")
end

local function runtime_checkpoint_rejects_unsafe_resolved_paths()
    local fs = {}
    function fs:resolve(name) return gamma_arena_result.ok("C:\\ArenaSaves\\..\\" .. name) end
    function fs:exists() return gamma_arena_result.ok(false) end
    function fs:size() return gamma_arena_result.ok(0) end
    function fs:rename() return gamma_arena_result.ok(true) end
    function fs:delete() return gamma_arena_result.ok(true) end
    local adapter = gamma_arena_checkpoint_adapter.new({ fs = fs, clock = function() return 0 end })
    local result = adapter:paths()
    gamma_arena_test_assert.is_false(result.ok, "resolved traversal path must fail before any file operation")
    gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_UNSAFE_PATH", "unsafe path code")
end

local function runtime_engine_checkpoint_port_canonicalizes_xray_alias()
    local engine_fs = {}
    function engine_fs:update_path(alias, name)
        gamma_arena_test_assert.equals(alias, "$game_saves$", "engine port resolves only through the game-saves alias")
        return "D:\\Anomaly\\bin\\..\\appdata\\savedgames\\" .. name
    end
    local fs = gamma_arena_checkpoint_adapter.engine_fs_port(engine_fs)
    local adapter = gamma_arena_checkpoint_adapter.new({ fs = fs, clock = function() return 0 end })
    local result = adapter:paths()
    gamma_arena_test_assert.is_true(result.ok, "trusted X-Ray alias path is canonicalized at the engine boundary")
    gamma_arena_test_assert.equals(result.value.visible.scop, "D:\\Anomaly\\appdata\\savedgames\\_gamma_arena_checkpoint.scop", "canonical path preserves the fixed checkpoint name")

    local function assert_engine_path_rejected(prefix, label)
        local rejected_fs = {}
        function rejected_fs:update_path(_, name) return prefix .. name end
        local rejected = gamma_arena_checkpoint_adapter.new({
            fs = gamma_arena_checkpoint_adapter.engine_fs_port(rejected_fs),
            clock = function() return 0 end
        }):paths()
        gamma_arena_test_assert.is_false(rejected.ok, label .. " must fail at the trusted engine boundary")
        gamma_arena_test_assert.equals(rejected.error.code, "GA_CHECKPOINT_PATH_RESOLVE_FAILED", label .. " path code")
    end
    assert_engine_path_rejected([[\\.\pipe\arena\]], "Win32 device namespace")
    assert_engine_path_rejected([[\\?\C:\ArenaSaves\]], "Win32 extended device namespace")
    assert_engine_path_rejected([[C:\..\]], "drive root escape")
    assert_engine_path_rejected([[\\server\share\..\]], "UNC share root escape")
end

local function runtime_engine_checkpoint_port_uses_xray_alias_for_existence()
    local engine_fs = { calls = 0 }
    function engine_fs:update_path(alias, name)
        gamma_arena_test_assert.equals(alias, "$game_saves$", "checkpoint path resolves through the save alias")
        return "D:\\Anomaly\\appdata\\savedgames\\" .. name
    end
    function engine_fs:exist(alias, name)
        self.calls = self.calls + 1
        gamma_arena_test_assert.equals(alias, "$game_saves$", "exist receives the X-Ray save alias")
        gamma_arena_test_assert.equals(name, "_gamma_arena_checkpoint.scop", "exist receives the relative checkpoint filename")
        return true
    end
    local fs = gamma_arena_checkpoint_adapter.engine_fs_port(engine_fs)
    local resolved = fs:resolve("_gamma_arena_checkpoint.scop")
    gamma_arena_test_assert.is_true(resolved.ok, "checkpoint existence fixture resolves safely")
    local exists = fs:exists(resolved.value)
    gamma_arena_test_assert.is_true(exists.ok and exists.value, "alias-plus-name existence detects a real save")
    gamma_arena_test_assert.equals(engine_fs.calls, 1, "engine existence is probed exactly once")
end

local function runtime_checkpoint_command_throw_fails_safely()
    local env = fake_checkpoint_env()
    env.command_throw = true
    env.adapter:create(valid_session())
    env.adapter:update()
    local result = env.adapter:update()
    gamma_arena_test_assert.is_false(result.ok, "throwing console command must remain inside Result boundary")
    gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_SAVE_COMMAND_FAILED", "save command throw code")
end

local function runtime_checkpoint_failed_intent_never_unhides()
    local env = fake_checkpoint_env()
    advance_checkpoint_to_ready(env)
    env.store.issue_resume_result = gamma_arena_result.err("GA_RESUME_WRITE_FAILED", "injected persistence failure")
    env.order = {}
    local result = env.adapter:restore(valid_session(), 1)
    gamma_arena_test_assert.is_false(result.ok, "failed ResumeIntent persistence aborts restore")
    gamma_arena_test_assert.equals(#env.order, 0, "failed intent persistence performs no rename/load effect")
    gamma_arena_test_assert.equals(env.adapter:state(), "READY", "checkpoint remains safely hidden after intent failure")
end

local function runtime_actor_rejects_foreign_inventory_children()
    local env, adapter = fake_actor_adapter_env()
    local foreign_parent = { object_id = 999 }
    function foreign_parent:id() return self.object_id end
    local item = env:add_item(44, { parent = foreign_parent })
    adapter:begin_update()
    local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_false(result.ok, "foreign inventory child must never be released")
    gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_INVENTORY_OWNER_INVALID", "foreign item guard code")
    gamma_arena_test_assert.equals(#env.released, 0, "foreign object remains untouched")
    gamma_arena_test_assert.equals(item.id_calls, 0, "foreign ownership is rejected before the item id is read")
end

local function runtime_actor_rejects_nil_inventory_parent()
    local env, adapter = fake_actor_adapter_env()
    local item = env:add_item(45, { parent_missing = true })
    adapter:begin_update()
    local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_false(result.ok, "nil inventory parent fails closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_INVENTORY_OWNER_INVALID", "nil parent guard code")
    gamma_arena_test_assert.equals(item.id_calls, 0, "nil parent is rejected before item id lookup")
    gamma_arena_test_assert.equals(#env.released, 0, "nil-parent item is never mutated")
end

local function runtime_actor_rejects_throwing_inventory_accessors()
    local cases = {
        { options = { parent_throw = true }, code = "GA_ACTOR_INVENTORY_OWNER_INVALID", label = "parent lookup" },
        { options = { parent = { id = function() error("injected parent id failure") end } }, code = "GA_ACTOR_INVENTORY_OWNER_INVALID", label = "parent id" },
        { options = { item_id_throw = true }, code = "GA_ACTOR_INVENTORY_ITEM_INVALID", label = "item id" }
    }
    for _, case in ipairs(cases) do
        local env, adapter = fake_actor_adapter_env()
        env:add_item(46, case.options)
        adapter:begin_update()
        local result = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
        gamma_arena_test_assert.is_false(result.ok, case.label .. " exception fails closed")
        gamma_arena_test_assert.equals(result.error.code, case.code, case.label .. " structured error")
        gamma_arena_test_assert.equals(#env.released, 0, case.label .. " failure occurs before mutation")
    end
end

local function runtime_actor_future_seams_are_injected_and_total()
    local env, adapter = fake_actor_adapter_env()
    local loadout_seen = nil
    adapter.deps.loadout = {
        apply = function(actor, loadout)
            gamma_arena_test_assert.is_true(actor == env.actor, "loadout seam receives only the owned Arena actor")
            loadout_seen = loadout
            return gamma_arena_result.ok(true)
        end
    }
    local loadout = { primary = "wpn_pm" }
    gamma_arena_test_assert.is_true(adapter:apply_loadout(loadout).ok, "Task 7 loadout seam is injectable")
    gamma_arena_test_assert.is_true(loadout_seen == loadout, "loadout seam preserves immutable spec identity")
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "loadout seam cleanup is total")
end

local function runtime_dedicated_start_reaches_preparing_without_checkpoint()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local actor = {
        begin_update = function() return gamma_arena_result.ok(true) end,
        normalize_for_arena = function() return gamma_arena_result.ok(true) end,
        verify_inventory_empty = function() return gamma_arena_result.ok(true) end,
        release_input = function() return gamma_arena_result.ok(true) end
    }
    local checkpoint = { create_count = 0, updates = 0 }
    function checkpoint:create() self.create_count = self.create_count + 1; return gamma_arena_result.ok(true) end
    function checkpoint:update() self.updates = self.updates + 1; return gamma_arena_result.ok(true) end
    function checkpoint:state() return "READY" end
    function checkpoint:on_game_load() return gamma_arena_result.ok(false) end
    function checkpoint:cleanup() return gamma_arena_result.ok(true) end
    local deps = fake_orchestrator_deps(store)
    deps.actor = actor
    deps.checkpoint = checkpoint
    deps.layout = function() return gamma_arena_result.ok({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" }) end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    gamma_arena_test_assert.is_true(orchestrator:on_game_load().ok, "dedicated launch accepts the game-load boundary")
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "dedicated launch normalizes the actor")
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "dedicated launch verifies empty inventory")
    gamma_arena_test_assert.equals(checkpoint.create_count, 0, "dedicated startup never creates a checkpoint")
    gamma_arena_test_assert.equals(checkpoint.updates, 0, "dedicated startup never polls a checkpoint")
    gamma_arena_test_assert.equals(orchestrator:runtime_stage_snapshot(), "PREPARING", "inventory readiness advances directly to FightSpec preparation")
end

local function runtime_checkpoint_resume_applies_index_after_ready()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({
        schema_version = 1,
        session_id = "ga_test_session",
        session_nonce = "ga_test_nonce",
        next_fight_index = 5,
        checkpoint_name = "_gamma_arena_checkpoint"
    })
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    orchestrator:load_state({ gamma_arena_session = valid_session() })
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    gamma_arena_test_assert.equals(orchestrator:session_snapshot().fight_index, 0, "loaded checkpoint baseline remains unchanged before rehide READY")
    orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(orchestrator:session_snapshot().fight_index, 5, "orchestrator caches the consumed continuation index only after READY")
    gamma_arena_test_assert.is_true(orchestrator:is_checkpoint_ready(), "restored checkpoint opens the generation gate")
end

local function entity_spec(opponent_count)
    local actor = {
        slot = 0,
        spawn_path = "actor_spawn",
        look_path = "actor_look",
        loadout = { weapon = "wpn_pm", ammo = "ammo_9x18_fmj", ammo_boxes = 2, outfit = "novice_outfit", knife = "wpn_knife", consumables = { "bandage" }, cost = 6 }
    }
    local opponents = {}
    for index = 1, (opponent_count or 2) do
        opponents[index] = {
            slot = index,
            spawn_path = "opponent_" .. tostring(index),
            tactical_route = "opponent_" .. tostring(index),
            spawn_slot_id = "fixture:" .. tostring(index),
            spawn = {
                position = { x = index * 2, y = 2, z = 3 },
                level_vertex_id = 10 + index,
                game_vertex_id = 22
            },
            role = index == 1 and "leader" or "primary",
            profile = index == 1 and "gamma_arena_bandit_novice" or "gamma_arena_bandit_trainee",
            community = "bandit",
            loadout = {
                weapon = index == 1 and "wpn_pm" or "wpn_mp5",
                ammo = index == 1 and "ammo_9x18_fmj" or "ammo_9x19_fmj",
                ammo_boxes = index == 1 and 3 or 2,
                outfit = index == 1 and "novice_outfit" or "stalker_outfit",
                knife = "wpn_knife",
                consumables = index == 1 and { "bandage", "medkit" } or { "bandage" },
                cost = 10
            }
        }
    end
    return {
        actor = function() return actor end,
        opponents = function() return opponents end,
        tactical_routes = function()
            return {
                "opponent_1", "opponent_2", "opponent_3",
                "opponent_4", "opponent_5", "opponent_6"
            }
        end,
        fight_id = function() return "ga-entity-test" end,
        stable_encode = function() return "stable:ga-entity-test" end
    }
end

local function fake_entity_environment(options)
    options = options or {}
    local env = {
        now = options.now or 100,
        next_id = 100,
        objects = {},
        online = {},
        online_candidates = {},
        online_pending = {},
        held_offline = {},
        children = {},
        tags = {},
        death_flags = {},
        death_flag_writes = 0,
        death_flag_reads = 0,
        pending_release = {},
        release_requests = {},
        direct_releases = {},
        events = {},
        create_item_calls = {},
        create_npc_count = 0,
        actor_loadout_calls = 0,
        tag_writes = 0,
        child_reads = 0,
        opponents_enabled = false,
        equip_attempts = {},
        hostile_calls = 0,
        actor_input_releases = 0,
        tactical_begin_calls = 0,
        tactical_update_calls = 0,
        tactical_death_slots = {},
        tactical_stop_calls = 0,
        tactical_warnings = {},
        terminal_transitions = {}
    }

    local function server_entity(id, section, parent_id, quantity)
        local entity = { runtime_id = id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
        function entity:id() return self.runtime_id end
        return entity
    end

    function env:add_entity(section, parent_id, quantity, forced_id)
        local id = forced_id or self.next_id
        if forced_id == nil then self.next_id = self.next_id + 1 end
        local entity = server_entity(id, section, parent_id, quantity)
        self.objects[id] = entity
        if parent_id ~= nil then
            self.children[parent_id] = self.children[parent_id] or {}
            self.children[parent_id][#self.children[parent_id] + 1] = id
        end
        return entity
    end

    function env:remove_entity(id)
        local entity = self.objects[id]
        if entity and options.cascade_parent_release and self.children[id] then
            local child_ids = {}
            for _, child_id in ipairs(self.children[id]) do child_ids[#child_ids + 1] = child_id end
            for _, child_id in ipairs(child_ids) do
                local child = self.objects[child_id]
                if child and child.parent_id == id then self:remove_entity(child_id) end
            end
        end
        if entity and entity.parent_id and self.children[entity.parent_id] then
            local kept = {}
            for _, child_id in ipairs(self.children[entity.parent_id]) do if child_id ~= id then kept[#kept + 1] = child_id end end
            self.children[entity.parent_id] = kept
        end
        self.objects[id] = nil
        self.online[id] = nil
    end

    function env:advance(delta)
        self.now = (self.now + (delta or 1)) % 4294967296
        for id, remaining in pairs(self.online_pending) do
            remaining = remaining - 1
            if remaining <= 0 and not options.online_never then
                self.online_pending[id] = nil
                self.online[id] = self.online_candidates[id]
            else
                self.online_pending[id] = remaining
            end
        end
        for id, remaining in pairs(self.pending_release) do
            remaining = remaining - 1
            local online_blocked = options.online_release_requires_offline and self.online[id] ~= nil
            if remaining <= 0 and not options.release_never_finishes and not online_blocked then
                self.pending_release[id] = nil
                self:remove_entity(id)
            else
                self.pending_release[id] = remaining
            end
        end
    end

    local alife_service = {}
    function alife_service:get_children(npc)
        env.child_reads = env.child_reads + 1
        if options.fail_phase == "children" then error("injected get_children failure") end
        local result = {}
        for _, id in ipairs(env.children[npc:id()] or {}) do result[#result + 1] = id end
        if options.move_child_after_snapshot and result[2] and env.objects[result[2]] then env.objects[result[2]].parent_id = 9999 end
        if options.children_iterator then
            local index = 0
            return function() index = index + 1; return result[index] end
        end
        return result
    end
    function alife_service:object(id) return env.objects[id] end

    local actor_port = {}
    function actor_port:apply_loadout(loadout)
        env.actor_loadout_calls = env.actor_loadout_calls + 1
        env.events[#env.events + 1] = "actor_loadout:" .. loadout.weapon
        if options.fail_phase == "actor" then return gamma_arena_result.err("GA_TEST_ACTOR_FAIL", "injected actor loadout failure") end
        return gamma_arena_result.ok(true)
    end
    function actor_port:release_input()
        env.actor_input_releases = env.actor_input_releases + 1
        env.events[#env.events + 1] = "release_input"
        return gamma_arena_result.ok(true)
    end

    local tactical = {}
    function tactical:begin(context)
        env.tactical_begin_calls = env.tactical_begin_calls + 1
        env.tactical_context = clone(context)
        env.events[#env.events + 1] = "tactical_begin"
        if options.fail_phase == "tactical_begin" then return gamma_arena_result.err("GA_TEST_TACTICAL_BEGIN", "injected tactical bind failure") end
        return gamma_arena_result.ok(true)
    end
    function tactical:update()
        env.tactical_update_calls = env.tactical_update_calls + 1
        env.events[#env.events + 1] = "tactical_update"
        if options.fail_phase == "tactical_update" then return gamma_arena_result.err("GA_TEST_TACTICAL_UPDATE", "injected tactical runtime failure") end
        return gamma_arena_result.ok(true)
    end
    function tactical:record_death(slot)
        env.tactical_death_slots[#env.tactical_death_slots + 1] = slot
        env.events[#env.events + 1] = "tactical_death:" .. tostring(slot)
        return gamma_arena_result.ok(true)
    end
    function tactical:stop()
        env.tactical_stop_calls = env.tactical_stop_calls + 1
        env.events[#env.events + 1] = "tactical_stop"
        if env.tactical_stop_calls <= (options.tactical_stop_failures or 0) then
            return gamma_arena_result.err("GA_TEST_TACTICAL_STOP", "injected tactical stop failure")
        end
        return gamma_arena_result.ok(true)
    end

    local deps = {
        actor = actor_port,
        tactical = tactical,
        log_warn = function(code)
            env.tactical_warnings[#env.tactical_warnings + 1] = code
            env.events[#env.events + 1] = "tactical_warn:" .. tostring(code)
        end,
        log_info = function(code, message, context)
            if code == "GA_OPPONENT_STATE_CHANGED" then env.terminal_transitions[#env.terminal_transitions + 1] = clone(context) end
        end,
        clock = function() return env.now end,
        opponent_gate = function() return env.opponents_enabled end,
        allow_numeric_death = options.allow_numeric_death == true,
        alife = function() return alife_service end,
        create_npc = function(section, position, level_vertex_id, game_vertex_id)
            env.create_npc_count = env.create_npc_count + 1
            env.events[#env.events + 1] = "npc:" .. section
            if options.fail_phase == "npc" then return nil end
            local npc = env:add_entity(section, nil, 1)
            env.children[npc:id()] = {}
            if options.default_children then
                env:add_entity("random_weapon", npc:id(), 1)
                env:add_entity("random_ammo", npc:id(), 8)
            end
            local object = {
                runtime_id = npc:id(),
                alive_value = options.fail_phase ~= "alive",
                critical_value = false,
                position_value = { x = position.x, y = position.y, z = position.z }
            }
            function object:id() return self.runtime_id end
            function object:alive() return self.alive_value end
            function object:position() return self.position_value end
            env.online_candidates[npc:id()] = object
            env.online[npc:id()] = object
            return npc
        end,
        hold_offline = function(entity)
            env.events[#env.events + 1] = "hold_offline:" .. tostring(entity:id())
            if options.fail_phase == "hold_offline" then return false end
            if options.hold_offline_fails_after_online_request and env.online_request_started then
                return gamma_arena_result.err("GA_TEST_OFFLINE_HOLD", "injected post-request offline-hold failure")
            end
            env.held_offline[entity:id()] = true
            env.online_pending[entity:id()] = nil
            env.online[entity:id()] = nil
            return true
        end,
        request_online = function(entity, id)
            env.events[#env.events + 1] = "request_online:" .. tostring(id)
            env.online_request_started = true
            env.held_offline[id] = nil
            env.online_pending[id] = options.online_delay or 1
            if options.fail_phase == "request_online" then return gamma_arena_result.err("GA_TEST_ONLINE_REQUEST_FAIL", "injected post-request failure") end
            return true
        end,
        create_item = function(section, parent, count, is_ammo)
            env.events[#env.events + 1] = "item:" .. section .. ":" .. tostring(count)
            env.create_item_calls[#env.create_item_calls + 1] = { section = section, count = count, is_ammo = is_ammo == true, parent_id = parent:id() }
            if options.fail_phase == "item" and #env.create_item_calls == (options.fail_item_at or 2) then return nil end
            if is_ammo and options.multi_return_late_invalid_id then
                return { env:add_entity(section, parent:id(), count), { id = function() return nil end } }
            end
            if is_ammo and options.multi_return_duplicate_id then
                local entity = env:add_entity(section, parent:id(), count)
                return { entity, entity }
            end
            if is_ammo and options.engine_split_ammo then
                local entities, remaining = {}, count
                local box_size = options.ammo_box_size or 20
                while remaining > 0 do
                    local quantity = math.min(box_size, remaining)
                    entities[#entities + 1] = env:add_entity(section, parent:id(), quantity)
                    remaining = remaining - quantity
                end
                return entities
            end
            if options.multi_return_ammo and string.find(section, "^ammo_") then
                local first = math.floor(count / 2)
                local second = count - first
                local second_section = options.multi_return_second_section or section
                return { env:add_entity(section, parent:id(), first), env:add_entity(second_section, parent:id(), second) }
            end
            return env:add_entity(section, parent:id(), count)
        end,
        save_tag = function(id, name, key, value)
            env.tag_writes = env.tag_writes + 1
            if options.fail_phase == "tag" and env.tag_writes == (options.fail_tag_at or 1) then error("injected tag failure") end
            env.tags[id] = value
            return true
        end,
        load_tag = function(id, name, key)
            if options.fail_phase == "tag_read" then error("injected tag read failure") end
            return env.tags[id]
        end,
        save_death_dropped = function(id, value)
            env.death_flag_writes = env.death_flag_writes + 1
            if options.fail_phase == "death_flag_write" then error("injected death flag write failure") end
            env.death_flags[id] = value
            return true
        end,
        load_death_dropped = function(id)
            env.death_flag_reads = env.death_flag_reads + 1
            if options.fail_phase == "death_flag_read" then error("injected death flag read failure") end
            if options.death_flag_roundtrip_false then return false end
            return env.death_flags[id]
        end,
        release = function(descriptor)
            env.release_requests[#env.release_requests + 1] = descriptor.id
            env.events[#env.events + 1] = "release:" .. tostring(descriptor.id)
            env.pending_release[descriptor.id] = options.release_delay or 1
            return true
        end,
        entity_exists = function(id)
            if options.entity_exists_result_nil then return gamma_arena_result.ok(nil) end
            return env.objects[id] ~= nil
        end,
        server_entity = function(id) return env.objects[id] end,
        entity_section = function(entity) return entity.section_name end,
        online_object = function(id)
            if options.fail_phase == "online" then return nil end
            return env.online[id]
        end,
        object_position = function(object) return object:position() end,
        is_critically_wounded = function(object) return object.critical_value == true end,
        actor_object = function() return { runtime_id = 1 } end,
        item_quantity = function(entity, is_ammo)
            if is_ammo and options.ammo_quantity_unavailable then return nil end
            return is_ammo and entity.quantity or 1
        end,
        ammo_box_size = function(section)
            if options.ammo_box_size_throw then error("injected ammo box-size failure") end
            if options.ammo_box_sizes then return options.ammo_box_sizes[section] end
            return options.ammo_box_size or 20
        end,
        profile_runtime = {
            effective_profile = function()
                if options.effective_profile_throw then error("injected effective profile failure") end
                return options.effective_profile or { class = "AI_STL_S", community = "bandit" }
            end
        },
        ensure_weapon_equipped = function(npc, weapon_id)
            local npc_id = npc:id()
            env.equip_attempts[npc_id] = (env.equip_attempts[npc_id] or 0) + 1
            env.events[#env.events + 1] = "equip:" .. tostring(npc_id) .. ":" .. tostring(weapon_id)
            if options.equip_throw then error("injected equip failure") end
            if options.equip_never then return false end
            return env.equip_attempts[npc_id] > (options.equip_delay or 0)
        end,
        set_pair_friends = function(first, second)
            env.events[#env.events + 1] = "friend:" .. tostring(first:id()) .. ":" .. tostring(second:id())
            if options.fail_phase == "friend" then return gamma_arena_result.err("GA_TEST_FRIEND_FAIL", "injected relation failure") end
            return gamma_arena_result.ok(true)
        end,
        set_actor_hold = function(npc, actor)
            env.events[#env.events + 1] = "hold_friendly:" .. tostring(npc:id())
            if options.fail_phase == "activation_hold" then return gamma_arena_result.err("GA_TEST_HOLD_FAIL", "injected activation hold failure") end
            return gamma_arena_result.ok(true)
        end,
        set_actor_hostile = function(npc, actor, goodwill)
            env.hostile_calls = env.hostile_calls + 1
            env.events[#env.events + 1] = "hostile:" .. tostring(npc:id()) .. ":" .. tostring(goodwill)
            if options.fail_phase == "hostile" and env.hostile_calls == (options.fail_hostile_at or 1) then return gamma_arena_result.err("GA_TEST_HOSTILE_FAIL", "injected hostility failure") end
            return gamma_arena_result.ok(true)
        end,
        release_timeout_ms = options.release_timeout_ms or 20,
        online_timeout_ms = options.online_timeout_ms or 20
    }
    return env, deps
end

local function pump_entity(adapter, env, limit)
    local result = gamma_arena_result.ok(true)
    for _ = 1, (limit or 200) do
        result = adapter:update()
        local snapshot = adapter:registry_snapshot()
        if snapshot.state == "ACTIVE" or snapshot.state == "CLEAN" or snapshot.state == "ERROR" then return result, snapshot end
        env:advance(1)
    end
    return result, adapter:registry_snapshot()
end

local function begin_entity_apply(adapter, env, spec, session_id)
    local result = adapter:begin_apply(spec, session_id)
    if result.ok then env.opponents_enabled = true end
    return result
end

local function runtime_entity_does_not_spawn_before_begin_apply()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    adapter:begin_apply(entity_spec(1), "session-countdown")
    for _ = 1, 3 do
        local waiting = adapter:update()
        gamma_arena_test_assert.is_true(waiting.ok, "closed opponent gate is a valid pending query")
        gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "COUNTDOWN", "repeated closed-gate updates remain COUNTDOWN")
    end
    gamma_arena_test_assert.equals(env.create_npc_count, 0, "begin_apply and countdown updates must never spawn opponents before the explicit gate")
end

local function runtime_entity_actor_loadout_precedes_spawn()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    local started = begin_entity_apply(adapter, env, entity_spec(1), "session-a")
    gamma_arena_test_assert.is_true(started.ok, "entity transaction must begin")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "complete transaction becomes active")
    gamma_arena_test_assert.equals(env.events[1], "actor_loadout:wpn_pm", "actor loadout must precede every opponent effect")
    gamma_arena_test_assert.equals(env.events[2], "resolve:opponent_1", "opponent creation begins only after actor loadout")
end

local function runtime_entity_npcs_are_offline_until_atomic_activation()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(2), "session-offline-hold")
    local snapshot
    for _ = 1, 100 do
        local result = adapter:update()
        gamma_arena_test_assert.is_true(result.ok, "offline-held spawn transaction advances")
        snapshot = adapter:registry_snapshot()
        if snapshot.state == "WAIT_ONLINE" then break end
        env:advance(1)
    end
    gamma_arena_test_assert.equals(snapshot.state, "WAIT_ONLINE", "all server NPCs and exact items are ready before activation")
    gamma_arena_test_assert.equals(#snapshot.npcs, 2, "both opponents exist in the server registry")
    for _, npc in ipairs(snapshot.npcs) do
        gamma_arena_test_assert.is_true(npc.held_offline and env.held_offline[npc.id] == true, "new NPC stays offline while later opponents/items are created")
        gamma_arena_test_assert.equals(env.online[npc.id], nil, "offline-held NPC cannot run AI before final activation")
    end
    local first_poll = adapter:update()
    snapshot = adapter:registry_snapshot()
    gamma_arena_test_assert.is_true(first_poll.ok and snapshot.state == "WAIT_ONLINE", "online activation request remains pending until a future engine update exposes the object")
    gamma_arena_test_assert.equals(env.online[snapshot.npcs[1].id], nil, "request_online never assumes same-callback object availability")
    for _ = 1, 20 do
        env:advance(1)
        local activated = adapter:update()
        gamma_arena_test_assert.is_true(activated.ok, "future online-object polling remains retryable")
        snapshot = adapter:registry_snapshot()
        if snapshot.state == "ACTIVE" then break end
        for _, event in ipairs(env.events) do
            gamma_arena_test_assert.is_true(not string.find(event, "^hostile:"), "no hostility is applied while any opponent remains pending")
        end
    end
    gamma_arena_test_assert.equals(snapshot.state, "ACTIVE", "all opponents become active only after future-frame discovery, friendly hold, and equipment verification")
    for _, npc in ipairs(snapshot.npcs) do gamma_arena_test_assert.is_false(npc.held_offline, "ACTIVE registry releases every offline hold") end
    local first_request, first_hold, first_equip, last_equip, first_hostile, request_counts = nil, nil, nil, nil, nil, {}
    for index, event in ipairs(env.events) do
        local requested_id = string.match(event, "^request_online:(%d+)$")
        if requested_id ~= nil then first_request = first_request or index; request_counts[requested_id] = (request_counts[requested_id] or 0) + 1 end
        if first_hold == nil and string.find(event, "^hold_friendly:") then first_hold = index end
        if string.find(event, "^equip:") then first_equip = first_equip or index; last_equip = index end
        if first_hostile == nil and string.find(event, "^hostile:") then first_hostile = index end
    end
    for _, count in pairs(request_counts) do gamma_arena_test_assert.equals(count, 1, "each NPC online transition is requested exactly once") end
    gamma_arena_test_assert.is_true(first_request ~= nil and first_hold ~= nil and first_equip ~= nil and first_hostile ~= nil
        and first_request < first_hold and first_hold < first_equip and last_equip < first_hostile,
        "each asynchronously online NPC is held friendly before fallible equip and no hostility starts until all weapons are ready")
end

local function runtime_entity_online_wait_is_bounded_and_wrap_safe()
    local delayed_env, delayed_deps = fake_entity_environment({ online_delay = 3, online_timeout_ms = 20 })
    local delayed = gamma_arena_entity_adapter.new(delayed_deps)
    begin_entity_apply(delayed, delayed_env, entity_spec(1), "session-online-delay")
    local observed_pending = false
    for _ = 1, 100 do
        local result = delayed:update()
        gamma_arena_test_assert.is_true(result.ok, "delayed online request remains a valid pending transaction")
        local state = delayed:registry_snapshot().state
        if delayed_env.online_pending[100] ~= nil then observed_pending = state == "WAIT_ONLINE" end
        if state == "ACTIVE" then break end
        delayed_env:advance(1)
    end
    gamma_arena_test_assert.is_true(observed_pending, "adapter polls across future engine updates instead of assuming synchronous online creation")
    gamma_arena_test_assert.equals(delayed:registry_snapshot().state, "ACTIVE", "delayed online object eventually reaches ACTIVE")

    local stuck_env, stuck_deps = fake_entity_environment({ now = 4294967294, online_never = true, online_timeout_ms = 3 })
    local stuck = gamma_arena_entity_adapter.new(stuck_deps)
    begin_entity_apply(stuck, stuck_env, entity_spec(1), "session-online-wrap")
    local result, snapshot = pump_entity(stuck, stuck_env, 100)
    gamma_arena_test_assert.is_false(result.ok, "never-online opponent fails after a bounded wrap-safe deadline")
    gamma_arena_test_assert.equals(snapshot.state, "ERROR", "never-online timeout rolls back transactionally")
    gamma_arena_test_assert.equals(snapshot.error.code, "GA_ENTITY_ONLINE_TIMEOUT", "online timeout preserves its deterministic transaction error")
    gamma_arena_test_assert.equals(stuck_env.online[100], nil, "timed-out opponent is quarantined offline")
    gamma_arena_test_assert.equals(stuck_env.online_pending[100], nil, "timed-out pending activation is cancelled by quarantine")
    gamma_arena_test_assert.equals(stuck_env.hostile_calls, 0, "never-online opponent is never made hostile")
end

local function runtime_entity_active_defers_input_release_to_task8()
    local env, deps = fake_entity_environment({ online_delay = 2 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-task8-seam")
    local result, snapshot = pump_entity(adapter, env, 100)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "entity adapter reaches its Task 7 terminal ACTIVE state")
    gamma_arena_test_assert.equals(env.actor_input_releases, 0, "DEFERRED_TO_TASK8: entity ACTIVE never mutates actor input ownership")
end

local function runtime_bootstrap_actor_loadout_port_is_bound_and_exact()
    local next_id, calls, released, tags = 500, {}, {}, {}
    local function entity(section, parent_id, quantity)
        local value = { runtime_id = next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
        next_id = next_id + 1
        function value:id() return self.runtime_id end
        return value
    end
    local port = gamma_arena_bootstrap.new_actor_loadout_port({
        clock = function() return 100 end,
        actor_id = function(actor) return actor:id() end,
        ownership_token = function() return "session-exact" end,
        reserve_magazines = 3,
        ammo_box_size = function(section)
            gamma_arena_test_assert.equals(section, "ammo_9x18_fmj", "actor adapter resolves the exact effective ammo section")
            return 20
        end,
        magazine_capacity = function() return 30 end,
        create_item = function(section, actor, count, is_ammo)
            calls[#calls + 1] = { section = section, count = count, is_ammo = is_ammo }
            if is_ammo then return { entity(section, actor:id(), 1), entity(section, actor:id(), count - 1) } end
            return entity(section, actor:id(), 1)
        end,
        entity_id = function(value) return value:id() end,
        entity_parent_id = function(value) return value.parent_id end,
        entity_section = function(value) return value.section_name end,
        item_quantity = function(value, is_ammo) return is_ammo and value.quantity or 1 end,
        save_owner_tag = function(id, token) tags[id] = token; return true end,
        load_owner_tag = function(id) return tags[id] end,
        resolve_entity = function() return nil end,
        release_item = function(id) released[#released + 1] = id; return true end
    })
    local actor = { id = function() return 77 end }
    local result = port.apply(actor, entity_spec(1).actor().loadout)
    gamma_arena_test_assert.is_true(result.ok, "production-shaped actor loadout port applies exact descriptors")
    gamma_arena_test_assert.equals(#calls, 5, "actor receives weapon, ammo, outfit and two consumables exactly once")
    gamma_arena_test_assert.equals(calls[2].section, "ammo_9x18_fmj", "actor ammo section is exact")
    gamma_arena_test_assert.equals(calls[2].count, 90, "actor reserve is raised to three full magazines when catalog boxes are insufficient")
    gamma_arena_test_assert.is_true(calls[2].is_ammo, "actor ammo uses the ammo property path")
    gamma_arena_test_assert.equals(#released, 0, "successful actor loadout has no rollback")

    local function partial_failure_port(release_failure_id)
        local partial_next_id, create_calls, rollback_ids = 600, 0, {}
        local present, pending_release, failed_once, tags = {}, {}, {}, {}
        local function partial_entity(section, parent_id, quantity)
            local value = { runtime_id = partial_next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
            present[partial_next_id] = value
            partial_next_id = partial_next_id + 1
            function value:id() return self.runtime_id end
            return value
        end
        local value = gamma_arena_bootstrap.new_actor_loadout_port({
            actor_id = function(target) return target:id() end,
            ownership_token = function() return "session-partial" end,
            ammo_box_size = function() return 20 end,
            create_item = function(section, target, count, is_ammo)
                create_calls = create_calls + 1
                if create_calls == 3 then return nil end
                if is_ammo then return { partial_entity(section, target:id(), 1), partial_entity(section, target:id(), count - 1) } end
                return partial_entity(section, target:id(), 1)
            end,
            entity_id = function(item) return item:id() end,
            entity_parent_id = function(item) return item.parent_id end,
            entity_section = function(item) return item.section_name end,
            item_quantity = function(item, is_ammo) return is_ammo and item.quantity or 1 end,
            save_owner_tag = function(id, token) tags[id] = token; return true end,
            load_owner_tag = function(id) return tags[id] end,
            resolve_entity = function(id) return present[id] end,
            release_item = function(id)
                rollback_ids[#rollback_ids + 1] = id
                if id == release_failure_id and failed_once[id] ~= true then failed_once[id] = true; return false end
                pending_release[id] = true
                return true
            end,
        })
        local function advance_release_frame()
            for id in pairs(pending_release) do present[id] = nil; pending_release[id] = nil end
        end
        return value, rollback_ids, advance_release_frame
    end
    local failing_port, rollback_ids, advance_release_frame = partial_failure_port(nil)
    local failure_env, failure_deps = fake_entity_environment()
    failure_deps.actor = { apply_loadout = function(_, loadout) return failing_port.apply(actor, loadout) end }
    local failed = gamma_arena_entity_adapter.new(failure_deps):begin_apply(entity_spec(1), "session-actor-port-failure")
    gamma_arena_test_assert.is_false(failed.ok, "partial production actor loadout failure is observable")
    gamma_arena_test_assert.equals(failure_env.create_npc_count, 0, "partial actor loadout rollback finishes before NPC creation")
    local expected_rollback = { 602, 601, 600 }
    gamma_arena_test_assert.equals(#rollback_ids, #expected_rollback, "every partially created actor item is released")
    for index, id in ipairs(expected_rollback) do gamma_arena_test_assert.equals(rollback_ids[index], id, "actor loadout rollback is exact reverse creation order") end
    local pending = failing_port.cleanup()
    gamma_arena_test_assert.is_true(pending.ok and pending.value.pending, "actor rollback remains pending while deferred items still exist")
    advance_release_frame()
    gamma_arena_test_assert.is_true(failing_port.cleanup().ok, "actor rollback completes only after a later frame proves every item absent")

    local rollback_failing_port, retry_ids, advance_retry_frame = partial_failure_port(601)
    local rollback_failed = rollback_failing_port.apply(actor, entity_spec(1).actor().loadout)
    gamma_arena_test_assert.is_false(rollback_failed.ok, "actor loadout rollback release failure remains observable")
    gamma_arena_test_assert.equals(rollback_failed.error.code, "GA_ACTOR_LOADOUT_ROLLBACK_FAILED", "actor loadout rollback failure code")
    local retried = rollback_failing_port.cleanup()
    gamma_arena_test_assert.is_true(retried.ok and retried.value.pending, "failed release submission is retried without claiming absence")
    gamma_arena_test_assert.equals(retry_ids[#retry_ids], 601, "only the previously failed actor release is resubmitted")
    advance_retry_frame()
    gamma_arena_test_assert.is_true(rollback_failing_port.cleanup().ok, "retried actor rollback completes after deferred absence")
end

local function runtime_actor_loadout_translates_ltx_slots_to_lua_slots()
    local cases = {
        { label = "knife", ltx_slot = 0, lua_slot = 1 },
        { label = "primary weapon", ltx_slot = 2, lua_slot = 3 },
        { label = "outfit", ltx_slot = 6, lua_slot = 7 }
    }
    for _, case in ipairs(cases) do
        local result = gamma_arena_bootstrap.engine_inventory_slot(case.ltx_slot)
        gamma_arena_test_assert.is_true(result.ok, case.label .. " LTX slot translates safely")
        gamma_arena_test_assert.equals(result.value, case.lua_slot, case.label .. " uses the one-based Lua inventory API slot")
    end
    local invalid = gamma_arena_bootstrap.engine_inventory_slot(-1)
    gamma_arena_test_assert.is_false(invalid.ok, "negative LTX slots fail closed")
    gamma_arena_test_assert.equals(invalid.error.code, "GA_ACTOR_LOADOUT_SLOT_INVALID", "invalid slot translation preserves the actor loadout code")
end

local function runtime_actor_loadout_progress_survives_clock_stalls()
    local now, next_id = 100, 1200
    local present, tags, slots, pending_slots = {}, {}, {}, {}
    local magazine, pending_magazine, active, pending_active = {}, {}, nil, nil
    local move_calls, magazine_calls, active_calls = 0, 0, 0
    local actor = { id = function() return 77 end }
    local loadout = entity_spec(1).actor().loadout
    local function entity(section, parent_id, quantity)
        local value = { runtime_id = next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
        next_id = next_id + 1
        function value:id() return self.runtime_id end
        present[value.runtime_id] = value
        return value
    end
    local port = gamma_arena_bootstrap.new_actor_loadout_port({
        clock = function() return now end,
        timeout_ms = 100,
        actor_id = function(target) return target:id() end,
        ownership_token = function() return "session-delayed-equipment" end,
        ammo_box_size = function() return 20 end,
        create_item = function(section, target, count) return entity(section, target:id(), count) end,
        entity_id = function(item) return item:id() end,
        entity_parent_id = function(item) return item.parent_id end,
        entity_section = function(item) return item.section_name end,
        item_quantity = function(item) return item.quantity end,
        save_owner_tag = function(id, token) tags[id] = token; return true end,
        load_owner_tag = function(id) return tags[id] end,
        online_item = function(_, id) return present[id] end,
        item_slot = function(section)
            if section == loadout.outfit then return 7 end
            if section == loadout.knife then return 1 end
            if section == loadout.weapon then return 3 end
        end,
        move_to_slot = function(_, item, slot)
            move_calls = move_calls + 1
            pending_slots[slot] = item
            return true
        end,
        item_in_slot = function(_, slot) return slots[slot] end,
        magazine_capacity = function() return 30 end,
        set_ammo_elapsed = function(weapon, count)
            magazine_calls = magazine_calls + 1
            pending_magazine[weapon:id()] = count
            return true
        end,
        get_ammo_in_magazine = function(weapon) return magazine[weapon:id()] or 0 end,
        make_item_active = function(_, item)
            active_calls = active_calls + 1
            pending_active = item
            return true
        end,
        active_item = function() return active end,
        outfit_requires_power = function() return false end,
        resolve_entity = function(id) return present[id] end,
        release_item = function(id) present[id] = nil; return true end
    })
    local applied = port.apply(actor, loadout)
    gamma_arena_test_assert.is_true(applied.ok, "delayed equipment fixture creates the exact actor loadout")
    local result
    for _ = 1, 20 do
        result = port.update(actor)
        gamma_arena_test_assert.is_true(result.ok, "uncommitted engine equipment remains pending rather than failing verification")
        if result.value.ready == true then break end
        now = now + 101
        for slot, item in pairs(pending_slots) do slots[slot] = item; pending_slots[slot] = nil end
        for id, count in pairs(pending_magazine) do magazine[id] = count; pending_magazine[id] = nil end
        if pending_active ~= nil then active = pending_active; pending_active = nil end
    end
    gamma_arena_test_assert.is_true(result.ok and result.value.ready == true, "equipment reaches READY only after later-frame slot, magazine and active-item proofs")
    gamma_arena_test_assert.equals(move_calls, 3, "outfit, knife and weapon moves are each submitted once")
    gamma_arena_test_assert.equals(magazine_calls, 1, "magazine fill is submitted once")
    gamma_arena_test_assert.equals(active_calls, 1, "active weapon selection is submitted once")
end

local function runtime_actor_loadout_no_progress_timeout_has_context()
    local now, next_id = 100, 1400
    local present, tags = {}, {}
    local actor = { id = function() return 77 end }
    local loadout = entity_spec(1).actor().loadout
    local function entity(section, parent_id, quantity)
        local value = { runtime_id = next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
        next_id = next_id + 1
        function value:id() return self.runtime_id end
        present[value.runtime_id] = value
        return value
    end
    local port = gamma_arena_bootstrap.new_actor_loadout_port({
        clock = function() return now end,
        timeout_ms = 100,
        actor_id = function(target) return target:id() end,
        ownership_token = function() return "session-stalled-equipment" end,
        ammo_box_size = function() return 20 end,
        create_item = function(section, target, count) return entity(section, target:id(), count) end,
        entity_id = function(item) return item:id() end,
        entity_parent_id = function(item) return item.parent_id end,
        entity_section = function(item) return item.section_name end,
        item_quantity = function(item) return item.quantity end,
        save_owner_tag = function(id, token) tags[id] = token; return true end,
        load_owner_tag = function(id) return tags[id] end,
        online_item = function() return nil end,
        resolve_entity = function(id) return present[id] end,
        release_item = function(id) present[id] = nil; return true end
    })
    gamma_arena_test_assert.is_true(port.apply(actor, loadout).ok, "stalled equipment fixture creates the exact actor loadout")
    local waiting = port.update(actor)
    gamma_arena_test_assert.is_true(waiting.ok and waiting.value.pending == true, "offline required equipment waits within the inactivity deadline")
    now = now + 101
    local timed_out = port.update(actor)
    gamma_arena_test_assert.is_false(timed_out.ok, "a phase with no observable progress remains bounded")
    gamma_arena_test_assert.equals(timed_out.error.code, "GA_ACTOR_LOADOUT_EQUIP_TIMEOUT", "stalled actor equipment preserves its public timeout code")
    gamma_arena_test_assert.equals(timed_out.error.context.phase, "SUBMIT_SLOT", "timeout context identifies the stalled phase")
    gamma_arena_test_assert.equals(timed_out.error.context.role, "outfit", "timeout context identifies the stalled equipment role")
    gamma_arena_test_assert.equals(timed_out.error.context.section, loadout.outfit, "timeout context identifies the stalled section")
    gamma_arena_test_assert.equals(timed_out.error.context.elapsed_since_progress_ms, 101, "timeout context reports inactivity rather than total transaction duration")
    gamma_arena_test_assert.equals(timed_out.error.context.total_elapsed_ms, 101, "timeout context retains total transaction duration for diagnostics")
    gamma_arena_test_assert.equals(timed_out.error.context.timeout_ms, 100, "timeout context reports the configured inactivity bound")
end

local function new_actor_loadout_test_fixture(options)
    options = options or {}
    local fixture = { calls = { is_exo = 0, get = 0, init = 0, set = 0, release = 0 }, stored = options.stored }
    local next_id, present, tags, slots, magazine = 1600, {}, {}, {}, {}
    local active = nil
    local actor = { id = function() return 77 end }
    local loadout = entity_spec(1).actor().loadout
    loadout = {
        weapon = loadout.weapon,
        ammo = loadout.ammo,
        ammo_boxes = loadout.ammo_boxes,
        outfit = options.outfit or loadout.outfit,
        knife = loadout.knife,
        consumables = loadout.consumables
    }
    local function entity(section, parent_id, quantity)
        local value = { runtime_id = next_id, section_name = section, parent_id = parent_id, quantity = quantity or 1 }
        next_id = next_id + 1
        function value:id() return self.runtime_id end
        present[value.runtime_id] = value
        return value
    end
    fixture.port = gamma_arena_bootstrap.new_actor_loadout_port({
        clock = function() return 100 end,
        actor_id = function(target) return target:id() end,
        ownership_token = function() return "session-exo-charge" end,
        ammo_box_size = function() return 20 end,
        create_item = function(section, target, count) return entity(section, target:id(), count) end,
        entity_id = function(item) return item:id() end,
        entity_parent_id = function(item) return item.parent_id end,
        entity_section = function(item) return item.section_name end,
        item_quantity = function(item) return item.quantity end,
        save_owner_tag = function(id, token) tags[id] = token; return true end,
        load_owner_tag = function(id) return tags[id] end,
        online_item = function(_, id) return present[id] end,
        item_slot = function(section)
            if section == loadout.outfit then return 7 end
            if section == loadout.knife then return 1 end
            if section == loadout.weapon then return 3 end
        end,
        move_to_slot = function(_, item, slot) slots[slot] = item; return true end,
        item_in_slot = function(_, slot) return slots[slot] end,
        magazine_capacity = function() return 30 end,
        set_ammo_elapsed = function(weapon, count) magazine[weapon:id()] = count; return true end,
        get_ammo_in_magazine = function(weapon) return magazine[weapon:id()] or 0 end,
        make_item_active = function(_, item) active = item; return true end,
        active_item = function() return active end,
        outfit_requires_power = options.outfit_requires_power,
        exo_is_object = options.exo_is_object,
        exo_get_data = options.exo_get_data,
        exo_init_data = options.exo_init_data,
        exo_set_data = options.exo_set_data,
        resolve_entity = function(id) return present[id] end,
        release_item = function(id) fixture.calls.release = fixture.calls.release + 1; present[id] = nil; return true end
    })
    fixture.actor = actor
    fixture.applied = fixture.port.apply(actor, loadout)
    function fixture.drive_to_ready()
        if not fixture.applied.ok then return fixture.applied end
        local result
        for _ = 1, 20 do
            result = fixture.port.update(actor)
            if not result.ok or result.value.ready == true then return result end
        end
        return result
    end
    return fixture
end

local function runtime_actor_loadout_charges_powered_exo_before_ready()
    local fixture
    fixture = new_actor_loadout_test_fixture({
        outfit = "exo_fixture_outfit",
        outfit_requires_power = function(section) return section == "exo_fixture_outfit" end,
        exo_is_object = function()
            fixture.calls.is_exo = fixture.calls.is_exo + 1
            return true
        end,
        exo_get_data = function()
            fixture.calls.get = fixture.calls.get + 1
            return fixture.stored or { power = 0, preserved = "yes" }
        end,
        exo_set_data = function(_, data)
            fixture.calls.set = fixture.calls.set + 1
            fixture.stored = data
            return true
        end
    })
    local ready = fixture.drive_to_ready()
    gamma_arena_test_assert.is_true(ready.ok, "powered exo loadout reaches READY")
    gamma_arena_test_assert.equals(fixture.calls.get, 2, "powered exo is read before and after write")
    gamma_arena_test_assert.equals(fixture.calls.set, 1, "powered exo is written once")
    gamma_arena_test_assert.equals(fixture.stored.preserved, "yes", "unrelated exo state is preserved")
    gamma_arena_test_assert.equals(fixture.stored.power, 100, "powered exo is set to exactly full charge")
    gamma_arena_test_assert.equals(ready.value.outfit_power, 100, "ready summary proves full charge")
end

local function runtime_actor_loadout_charges_proto_outfit_without_repair_type()
    local original_system_ini = system_ini
    system_ini = function()
        return {
            line_exist = function() return false end,
            r_string_ex = function() return nil end
        }
    end
    local fixture
    local ran, ready = pcall(function()
        fixture = new_actor_loadout_test_fixture({
            outfit = "stalker_proto_exo_outfit",
            outfit_requires_power = effective_outfit_requires_power,
            exo_is_object = function()
                fixture.calls.is_exo = fixture.calls.is_exo + 1
                return true
            end,
            exo_get_data = function()
                fixture.calls.get = fixture.calls.get + 1
                return fixture.stored
            end,
            exo_init_data = function()
                fixture.calls.init = fixture.calls.init + 1
                fixture.stored = { power = 0 }
                return fixture.stored
            end,
            exo_set_data = function(_, data)
                fixture.calls.set = fixture.calls.set + 1
                fixture.stored = data
                return true
            end
        })
        return fixture.drive_to_ready()
    end)
    system_ini = original_system_ini
    if not ran then error(ready) end
    gamma_arena_test_assert.is_true(ready.ok, "proto exo without repair_type reaches READY")
    gamma_arena_test_assert.equals(fixture.calls.is_exo, 1, "proto exo is confirmed through installed Powered Exos")
    gamma_arena_test_assert.equals(fixture.calls.get, 2, "proto exo charge is read back")
    gamma_arena_test_assert.equals(fixture.calls.init, 1, "fresh proto exo state is initialized synchronously")
    gamma_arena_test_assert.equals(fixture.stored.power, 100, "proto exo is fully charged")
    gamma_arena_test_assert.equals(ready.value.outfit_power, 100, "proto exo readiness proves full charge")
end

local function runtime_actor_loadout_ordinary_outfit_bypasses_exo_charge()
    local fixture
    fixture = new_actor_loadout_test_fixture({
        outfit_requires_power = function() return false end,
        exo_is_object = function() fixture.calls.is_exo = fixture.calls.is_exo + 1; return true end,
        exo_get_data = function() fixture.calls.get = fixture.calls.get + 1; return { power = 0 } end,
        exo_set_data = function() fixture.calls.set = fixture.calls.set + 1; return true end
