local function fatal_ui_helper_propagates_callback_results()
    local attempts = 0
    local failure = gamma_arena_result.err("GA_DISCONNECT_FAILED", "retry")
    local function callback()
        attempts = attempts + 1
        if attempts == 1 then return failure end
        return gamma_arena_result.ok(true)
    end
    local first = gamma_arena_ui_start.invoke_fatal_main_menu(callback, nil, {})
    local second = gamma_arena_ui_start.invoke_fatal_main_menu(callback, nil, {})
    gamma_arena_test_assert.is_true(first == failure, "Task 4 fatal UI must return disconnect failure unchanged")
    gamma_arena_test_assert.is_true(second.ok, "Task 4 fatal UI must return retry success")
end

local function bootstrap_registration_rolls_back_every_position()
    for failure_position = 1, #callback_names do
        local active, rollback_order, compose_count, register_count = {}, {}, 0, 0
        local fail_at = failure_position
        local registrar = gamma_arena_bootstrap.new_registrar({
            compose = function()
                compose_count = compose_count + 1
                local instance = { is_active = function() return false end }
                for _, name in ipairs(callback_names) do instance[name] = function() return gamma_arena_result.ok(false) end end
                return instance
            end,
            register = function(name, callback)
                register_count = register_count + 1
                if register_count == fail_at then error("injected registration failure") end
                gamma_arena_test_assert.equals(active[name], nil, "callback must never be registered twice: " .. name)
                active[name] = callback
            end,
            unregister = function(name, callback)
                gamma_arena_test_assert.is_true(active[name] == callback, "rollback must use the exact registered callback reference")
                active[name] = nil
                rollback_order[#rollback_order + 1] = name
            end
        })
        local failed = registrar:register_all()
        gamma_arena_test_assert.is_false(failed.ok, "registration position " .. failure_position .. " must fail")
        gamma_arena_test_assert.equals(registrar:status(), "idle", "clean rollback must permit a later retry")
        for index = 1, failure_position - 1 do
            gamma_arena_test_assert.equals(rollback_order[index], callback_names[failure_position - index], "rollback must be reverse ordered")
        end
        register_count = 0
        fail_at = nil
        local retried = registrar:register_all()
        gamma_arena_test_assert.is_true(retried.ok, "clean rollback must allow a fresh registration attempt")
        gamma_arena_test_assert.equals(compose_count, 2, "retry composes exactly one new orchestrator after clean rollback")
        local active_count = 0
        for _ in pairs(active) do active_count = active_count + 1 end
        gamma_arena_test_assert.equals(active_count, #callback_names, "retry must leave exactly one copy of every callback")
    end
end

local function bootstrap_registration_poison_blocks_retry()
    local compose_count, register_count, unregister_count = 0, 0, 0
    local registrar = gamma_arena_bootstrap.new_registrar({
        compose = function()
            compose_count = compose_count + 1
            local instance = { is_active = function() return false end }
            for _, name in ipairs(callback_names) do instance[name] = function() return gamma_arena_result.ok(false) end end
            return instance
        end,
        register = function()
            register_count = register_count + 1
            if register_count == 4 then error("injected registration failure") end
        end,
        unregister = function()
            unregister_count = unregister_count + 1
            if unregister_count == 2 then return false end
        end
    })
    local first = registrar:register_all()
    local second = registrar:register_all()
    gamma_arena_test_assert.is_false(first.ok and second.ok, "rollback failure must remain failed closed")
    gamma_arena_test_assert.equals(registrar:status(), "poisoned", "rollback failure must poison bootstrap registration")
    gamma_arena_test_assert.equals(compose_count, 1, "poisoned registration cannot create a second orchestrator")
    gamma_arena_test_assert.equals(register_count, 4, "poisoned registration cannot retry callbacks")
    gamma_arena_test_assert.equals(unregister_count, 3, "rollback continues in reverse after one unregister failure")
end

local function bootstrap_requires_unregister_before_composition()
    local compose_count = 0
    local registrar = gamma_arena_bootstrap.new_registrar({
        compose = function() compose_count = compose_count + 1; return {} end,
        register = function() end
    })
    local result = registrar:register_all()
    gamma_arena_test_assert.is_false(result.ok, "missing UnregisterScriptCallback must fail closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_BOOTSTRAP_REGISTRATION_POISONED", "missing unregister code")
    gamma_arena_test_assert.equals(registrar:status(), "poisoned", "missing unregister must poison process registration")
    gamma_arena_test_assert.equals(compose_count, 0, "feature probe must run before orchestrator/router composition")
end

local function net_destroy_teardown_honors_checkpoint_latch()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local reasons = {}
    local deps = fake_orchestrator_deps(store)
    deps.teardown = function(reason, preserve) reasons[#reasons + 1] = reason .. ":" .. tostring(preserve); return gamma_arena_result.ok(true) end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:expect_checkpoint_reload()
    orchestrator:actor_on_net_destroy()
    orchestrator:actor_on_net_destroy()
    gamma_arena_test_assert.equals(reasons[1], "checkpoint_reload:true", "expected reload preserves session route")
    gamma_arena_test_assert.equals(#reasons, 1, "net-destroy teardown must be idempotent")
end

local function unexpected_net_destroy_clears_external_route()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
