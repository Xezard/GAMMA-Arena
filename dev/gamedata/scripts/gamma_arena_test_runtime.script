local callback_names = {
    "on_game_load", "actor_on_first_update", "actor_on_update", "actor_on_before_death", "actor_on_death",
    "npc_on_net_spawn", "npc_on_death_callback", "save_state", "load_state", "on_before_save_input",
    "on_before_load_input", "actor_on_net_destroy", "on_before_level_changing"
}

local function callback_boundary_routes_exceptions_once()
    for _, callback_name in ipairs(callback_names) do
        local errors = 0
        local throwing = {
            is_active = function() return true end,
            on_callback_error = function(_, name, reason)
                gamma_arena_test_assert.equals(name, callback_name, "exception callback name")
                gamma_arena_test_assert.is_true(type(reason) == "string", "exception reason must be observable")
                errors = errors + 1
                return gamma_arena_result.err("GA_CALLBACK_FAILED", "routed exception")
            end,
            on_callback_result_error = function() error("exception path must not use false-Result routing") end
        }
        throwing[callback_name] = function() error("injected callback exception") end
        local callback = gamma_arena_bootstrap.make_callbacks(throwing)[callback_name]
        local call_ok, result = pcall(callback, 11, 22, { ret = false })
        gamma_arena_test_assert.is_true(call_ok, callback_name .. " boundary must contain exceptions")
        gamma_arena_test_assert.is_false(result.ok, callback_name .. " exception must return structured failure")
        gamma_arena_test_assert.equals(errors, 1, callback_name .. " exception must route exactly once")
    end
end

local function callback_boundary_routes_false_results_once()
    for _, callback_name in ipairs(callback_names) do
        local routes, callback_errors = 0, 0
        local expected = gamma_arena_result.err("GA_TEST_CALLBACK_RESULT", "injected Result failure", { callback = callback_name })
        local failing = {
            is_active = function() return true end,
            on_callback_error = function() callback_errors = callback_errors + 1 end,
            on_callback_result_error = function(_, name, result, was_active)
                gamma_arena_test_assert.equals(name, callback_name, "false-Result callback name")
                gamma_arena_test_assert.is_true(result == expected, "false-Result identity must be preserved")
                gamma_arena_test_assert.is_true(was_active, "critical callback must preserve prior active state")
                routes = routes + 1
                return result
            end
        }
        failing[callback_name] = function() return expected, "secondary-return" end
        local callback = gamma_arena_bootstrap.make_callbacks(failing)[callback_name]
        local call_ok, result, secondary = pcall(callback, 11, 22, { ret = false })
        gamma_arena_test_assert.is_true(call_ok, callback_name .. " false Result boundary must not throw")
        gamma_arena_test_assert.is_true(result == expected, callback_name .. " must preserve the original Result")
        gamma_arena_test_assert.equals(secondary, "secondary-return", callback_name .. " must preserve additional return values")
        gamma_arena_test_assert.equals(routes, 1, callback_name .. " false Result must route exactly once")
        gamma_arena_test_assert.equals(callback_errors, 0, callback_name .. " false Result must not use exception routing")
    end
end

local function inactive_callback_results_remain_benign()
    local calls, routes = 0, 0
    local inactive = {
        is_active = function() return false end,
        save_state = function() calls = calls + 1; return gamma_arena_result.ok(false) end,
        on_callback_error = function() routes = routes + 1 end,
        on_callback_result_error = function() routes = routes + 1 end
    }
    local result = gamma_arena_bootstrap.make_callbacks(inactive).save_state({})
    gamma_arena_test_assert.equals(result, nil, "inactive campaign save callback preserves its historical nil return")
    gamma_arena_test_assert.equals(calls, 1, "save callback reaches guard-aware campaign boundary")
    gamma_arena_test_assert.equals(routes, 0, "inactive no-op must not enter error routing")
end

local function active_save_failure_enters_fatal_once()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local fatal_count = 0
    deps.ui.show_fatal = function() fatal_count = fatal_count + 1; return {} end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    local result = gamma_arena_bootstrap.make_callbacks(orchestrator).save_state({})
    gamma_arena_test_assert.is_true(result.ok and result.value == false, "active Arena save is suppressed without serialization")
    gamma_arena_test_assert.is_true(orchestrator:is_active(), "save breach diagnostics do not terminate combat")
    gamma_arena_test_assert.equals(deps._save_guard.breach_calls, 1, "active save callback records one breach")
    gamma_arena_test_assert.equals(fatal_count, 0, "save breach observation is diagnostic rather than fatal")
end

local function fatal_ui_helper_propagates_callback_results()
    local attempts = 0
    local failure = gamma_arena_result.err("GA_DISCONNECT_FAILED", "retry")
    local function callback()
        attempts = attempts + 1
        if attempts == 1 then return failure end
        return gamma_arena_result.ok(true)
    end
    local first = gamma_arena_ui_start.invoke_fatal_main_menu(callback, nil, {})
    local second = gamma_arena_ui_start.invoke_fatal_main_menu(callback, nil, {})
    gamma_arena_test_assert.is_true(first == failure, "Task 4 fatal UI must return disconnect failure unchanged")
    gamma_arena_test_assert.is_true(second.ok, "Task 4 fatal UI must return retry success")
end

local function bootstrap_registration_rolls_back_every_position()
    for failure_position = 1, #callback_names do
        local active, rollback_order, compose_count, register_count = {}, {}, 0, 0
        local fail_at = failure_position
        local registrar = gamma_arena_bootstrap.new_registrar({
            compose = function()
                compose_count = compose_count + 1
                local instance = { is_active = function() return false end }
                for _, name in ipairs(callback_names) do instance[name] = function() return gamma_arena_result.ok(false) end end
                return instance
            end,
            register = function(name, callback)
                register_count = register_count + 1
                if register_count == fail_at then error("injected registration failure") end
                gamma_arena_test_assert.equals(active[name], nil, "callback must never be registered twice: " .. name)
                active[name] = callback
            end,
            unregister = function(name, callback)
                gamma_arena_test_assert.is_true(active[name] == callback, "rollback must use the exact registered callback reference")
                active[name] = nil
                rollback_order[#rollback_order + 1] = name
            end
        })
        local failed = registrar:register_all()
        gamma_arena_test_assert.is_false(failed.ok, "registration position " .. failure_position .. " must fail")
        gamma_arena_test_assert.equals(registrar:status(), "idle", "clean rollback must permit a later retry")
        for index = 1, failure_position - 1 do
            gamma_arena_test_assert.equals(rollback_order[index], callback_names[failure_position - index], "rollback must be reverse ordered")
        end
        register_count = 0
        fail_at = nil
        local retried = registrar:register_all()
        gamma_arena_test_assert.is_true(retried.ok, "clean rollback must allow a fresh registration attempt")
        gamma_arena_test_assert.equals(compose_count, 2, "retry composes exactly one new orchestrator after clean rollback")
        local active_count = 0
        for _ in pairs(active) do active_count = active_count + 1 end
        gamma_arena_test_assert.equals(active_count, #callback_names, "retry must leave exactly one copy of every callback")
    end
end

local function bootstrap_registration_poison_blocks_retry()
    local compose_count, register_count, unregister_count = 0, 0, 0
    local registrar = gamma_arena_bootstrap.new_registrar({
        compose = function()
            compose_count = compose_count + 1
            local instance = { is_active = function() return false end }
            for _, name in ipairs(callback_names) do instance[name] = function() return gamma_arena_result.ok(false) end end
            return instance
        end,
        register = function()
            register_count = register_count + 1
            if register_count == 4 then error("injected registration failure") end
        end,
        unregister = function()
            unregister_count = unregister_count + 1
            if unregister_count == 2 then return false end
        end
    })
    local first = registrar:register_all()
    local second = registrar:register_all()
    gamma_arena_test_assert.is_false(first.ok and second.ok, "rollback failure must remain failed closed")
    gamma_arena_test_assert.equals(registrar:status(), "poisoned", "rollback failure must poison bootstrap registration")
    gamma_arena_test_assert.equals(compose_count, 1, "poisoned registration cannot create a second orchestrator")
    gamma_arena_test_assert.equals(register_count, 4, "poisoned registration cannot retry callbacks")
    gamma_arena_test_assert.equals(unregister_count, 3, "rollback continues in reverse after one unregister failure")
end

local function bootstrap_requires_unregister_before_composition()
    local compose_count = 0
    local registrar = gamma_arena_bootstrap.new_registrar({
        compose = function() compose_count = compose_count + 1; return {} end,
        register = function() end
    })
    local result = registrar:register_all()
    gamma_arena_test_assert.is_false(result.ok, "missing UnregisterScriptCallback must fail closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_BOOTSTRAP_REGISTRATION_POISONED", "missing unregister code")
    gamma_arena_test_assert.equals(registrar:status(), "poisoned", "missing unregister must poison process registration")
    gamma_arena_test_assert.equals(compose_count, 0, "feature probe must run before orchestrator/router composition")
end

local function runtime_bootstrap_status_preserves_initialization_result()
    local module_before_registration = gamma_arena_bootstrap.runtime_status()
    gamma_arena_test_assert.is_false(module_before_registration.ok, "module readiness must report not ready before bootstrap creates a registrar")
    gamma_arena_test_assert.equals(module_before_registration.error.code, "GA_BOOTSTRAP_NOT_READY", "module readiness code before bootstrap creation")

    local unregistered = gamma_arena_bootstrap.new_registrar({
        compose = function() return {} end,
        register = function() end,
        unregister = function() end
    })
    local before_registration = unregistered:runtime_status()
    gamma_arena_test_assert.is_false(before_registration.ok, "new registrar must report not ready before registration")
    gamma_arena_test_assert.equals(before_registration.error.code, "GA_BOOTSTRAP_NOT_READY", "unregistered readiness code")
    gamma_arena_test_assert.equals(before_registration.error.context.registration_state, "idle", "unregistered readiness state")

    local failed_registrar = gamma_arena_bootstrap.new_registrar({
        compose = function() error("injected composition failure") end,
        register = function() end,
        unregister = function() end
    })
    local failed = failed_registrar:register_all()
    local failed_status = failed_registrar:runtime_status()
    gamma_arena_test_assert.is_false(failed.ok, "injected composition failure must fail registration")
    gamma_arena_test_assert.equals(failed.error.code, "GA_BOOTSTRAP_COMPOSE_FAILED", "composition failure code")
    gamma_arena_test_assert.is_true(failed.error.context ~= nil, "composition failure must retain context")
    gamma_arena_test_assert.is_true(failed_status == failed, "readiness must return the original failed registration Result")
    gamma_arena_test_assert.is_true(failed_status.error.context == failed.error.context, "readiness must preserve failed Result context identity")

    local malformed_registrar = gamma_arena_bootstrap.new_registrar({})
    malformed_registrar.register_all_impl = function() return { ok = false } end
    local malformed = malformed_registrar:register_all()
    gamma_arena_test_assert.is_true(type(malformed.error) == "table" and malformed.error.code == "GA_BOOTSTRAP_REGISTRATION_FAILED" and type(malformed.error.message) == "string", "malformed failed Result must normalize to a complete registration failure")
    gamma_arena_test_assert.is_true(malformed_registrar:runtime_status() == malformed, "readiness must preserve the normalized malformed failure Result")

    local compose_count, register_count, unregister_count = 0, 0, 0
    local registered = gamma_arena_bootstrap.new_registrar({
        compose = function()
            compose_count = compose_count + 1
            return {}
        end,
        make_callbacks = function()
            local callbacks = {}
            for _, name in ipairs(callback_names) do callbacks[name] = function() return gamma_arena_result.ok(true) end end
            return callbacks
        end,
        register = function() register_count = register_count + 1 end,
        unregister = function() unregister_count = unregister_count + 1 end
    })
    local registration = registered:register_all()
    gamma_arena_test_assert.is_true(registration.ok, "complete callback registration must succeed")
    local registration_state, instance, callbacks, registered_entries, last_result = registered.registration_state, registered.instance, registered.callbacks, registered.registered, registered.last_result
    local first_status = registered:runtime_status()
    local second_status = registered:runtime_status()
    gamma_arena_test_assert.is_true(first_status.ok and second_status.ok, "readiness succeeds only after registration state, instance, and callbacks are ready")
    gamma_arena_test_assert.equals(compose_count, 1, "readiness must not recompose")
    gamma_arena_test_assert.equals(register_count, #callback_names, "readiness must not register callbacks")
    gamma_arena_test_assert.equals(unregister_count, 0, "readiness must not unregister callbacks")
    gamma_arena_test_assert.equals(registered.registration_state, registration_state, "readiness must not change registration state")
    gamma_arena_test_assert.is_true(registered.instance == instance and registered.callbacks == callbacks and registered.registered == registered_entries and registered.last_result == last_result, "readiness must not change registrar fields")
end

local function runtime_bootstrap_restart_without_registered_runtime_is_inert()
    local result = gamma_arena_bootstrap.request_restart()
    gamma_arena_test_assert.is_true(result.ok and result.value == false, "restart without a registered runtime is inert")
end

local function runtime_ordinary_start_preflight_precedes_mutation()
    local request = {
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = "master",
        seed_mode = "random",
        session_seed = 123
    }
    local function begin_with(status)
        local calls = {}
        local owner = {}
        function owner:StartGame()
            calls[#calls + 1] = "StartGame"
            return true
        end
        local ports = {
            runtime_status = function()
                calls[#calls + 1] = "runtime preflight"
                return status()
            end,
            save_preferences = function()
                calls[#calls + 1] = "save preferences"
                return gamma_arena_result.ok(true)
            end,
            issue_launch = function()
                calls[#calls + 1] = "issue launch"
                return gamma_arena_result.ok(true)
            end,
            write_character_creation = function()
                calls[#calls + 1] = "write bridge"
                return gamma_arena_result.ok(true)
            end
        }
        return gamma_arena_ui_start.begin_start(owner, {}, request, ports), calls
    end
    local function assert_blocked(label, status, expected_code)
        local result, calls = begin_with(status)
        gamma_arena_test_assert.is_false(result.ok, label .. " must fail safely")
        gamma_arena_test_assert.equals(result.error.code, expected_code, label .. " code")
        gamma_arena_test_assert.equals(#calls, 1, label .. " must not save, launch, bridge, or hand off")
        gamma_arena_test_assert.equals(calls[1], "runtime preflight", label .. " only invokes runtime readiness")
    end

    local function assert_missing_runtime(label, bootstrap)
        local calls = {}
        local owner = {}
        function owner:StartGame()
            calls[#calls + 1] = "StartGame"
            return true
        end
        local ports = {
            save_preferences = function()
                calls[#calls + 1] = "save preferences"
                return gamma_arena_result.ok(true)
            end,
            issue_launch = function()
                calls[#calls + 1] = "issue launch"
                return gamma_arena_result.ok(true)
            end,
            write_character_creation = function()
                calls[#calls + 1] = "write bridge"
                return gamma_arena_result.ok(true)
            end
        }
        local saved_bootstrap = gamma_arena_bootstrap
        gamma_arena_bootstrap = bootstrap
        local began, result = pcall(function()
            return gamma_arena_ui_start.begin_start(owner, {}, request, ports)
        end)
        gamma_arena_bootstrap = saved_bootstrap
        gamma_arena_test_assert.is_true(began, label .. " must become a Result")
        gamma_arena_test_assert.is_false(result.ok, label .. " blocks start")
        gamma_arena_test_assert.equals(result.error.code, "GA_START_RUNTIME_UNAVAILABLE", label .. " code")
        gamma_arena_test_assert.equals(#calls, 0, label .. " has zero downstream side effects")
    end

    assert_missing_runtime("missing bootstrap namespace", nil)
    assert_missing_runtime("missing runtime_status", {})

    assert_blocked("thrown runtime_status", function() error("injected readiness throw") end, "GA_START_RUNTIME_STATUS_FAILED")
    assert_blocked("malformed runtime_status", function() return "not a Result" end, "GA_START_RUNTIME_STATUS_INVALID")

    local original_failure = gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "original bootstrap failure", { registration_state = "poisoned" })
    local failed, failed_calls = begin_with(function() return original_failure end)
    gamma_arena_test_assert.is_true(failed == original_failure, "failed runtime Result reaches the UI-facing start failure unchanged")
    gamma_arena_test_assert.equals(failed.error.context.registration_state, "poisoned", "failed runtime Result retains context")
    gamma_arena_test_assert.equals(#failed_calls, 1, "failed runtime Result has zero downstream side effects")

    local success, calls = begin_with(function() return gamma_arena_result.ok(true) end)
    gamma_arena_test_assert.is_true(success.ok, "ready runtime begins Arena start")
    gamma_arena_test_assert.equals(table.concat(calls, " -> "), "runtime preflight -> save preferences -> issue launch -> write bridge -> StartGame", "ordinary start performs runtime preflight before every launch mutation")
end

local function net_destroy_teardown_honors_checkpoint_latch()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local reasons = {}
    local deps = fake_orchestrator_deps(store)
    deps.teardown = function(reason, preserve) reasons[#reasons + 1] = reason .. ":" .. tostring(preserve); return gamma_arena_result.ok(true) end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:expect_checkpoint_reload()
    orchestrator:actor_on_net_destroy()
    orchestrator:actor_on_net_destroy()
    gamma_arena_test_assert.equals(reasons[1], "checkpoint_reload:true", "expected reload preserves session route")
    gamma_arena_test_assert.equals(#reasons, 1, "net-destroy teardown must be idempotent")
end

local function unexpected_net_destroy_clears_external_route()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    orchestrator:on_game_load()
    orchestrator:actor_on_first_update()
    orchestrator:actor_on_net_destroy()
    gamma_arena_test_assert.equals(store.clear_matching_count, 1, "unexpected actor destruction clears only this Arena session's resume route")
end

local function runtime_fatal_recovery_waits_for_cleanup_before_disconnect()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({
        schema_version = 1,
        session_id = session.session_id,
        session_nonce = session.session_nonce,
        next_fight_index = session.fight_index,
        checkpoint_name = session.checkpoint_name
    })
    local deps = fake_orchestrator_deps(store)
    local checkpoint = deps.checkpoint
    function checkpoint:begin_resume_recovery()
        return gamma_arena_result.err("GA_CHECKPOINT_RECOVERY_MISSING", "injected missing checkpoint")
    end
    function checkpoint:cleanup()
        self.current = "CLEANING"
        self.cleanup_updates_remaining = 3
        return gamma_arena_result.ok(true)
    end
    function checkpoint:update()
        if self.current == "CLEANING" then
            self.cleanup_updates_remaining = self.cleanup_updates_remaining - 1
            if self.cleanup_updates_remaining <= 0 then self.current = "NONE" end
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    local disconnects, cleanup_session = 0, nil
    local orchestrator = nil
    deps.disconnect = function() disconnects = disconnects + 1; return true end
    deps.teardown = function()
        cleanup_session = orchestrator:session_snapshot()
        checkpoint:cleanup(cleanup_session)
        return checkpoint:update()
    end
    orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "fresh recovery failure enters fatal routing")
    gamma_arena_test_assert.is_true(cleanup_session ~= nil, "fatal teardown retains the loaded ArenaSession for matching cleanup")
    local pending = orchestrator:main_menu_action()
    gamma_arena_test_assert.is_false(pending.ok, "main menu waits while exact cleanup is pending")
    gamma_arena_test_assert.equals(pending.error.code, "GA_RUNTIME_CLEANUP_PENDING", "pending cleanup has a retryable result")
    gamma_arena_test_assert.equals(disconnects, 0, "disconnect cannot bypass exact cleanup")
    orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(orchestrator:main_menu_action().ok, "main menu succeeds after cleanup reaches NONE")
    gamma_arena_test_assert.equals(disconnects, 1, "disconnect executes exactly once after cleanup")
end

local function runtime_pre_session_fatal_waits_for_cleanup_before_disconnect()
    local store = fake_store({ launch_pending = true, resume_pending = false })
    local deps = fake_orchestrator_deps(store)
    local checkpoint = deps.checkpoint
    function checkpoint:cleanup()
        self.current = "CLEANING"
        self.cleanup_updates_remaining = 3
        return gamma_arena_result.ok(true)
    end
    function checkpoint:update()
        if self.current == "CLEANING" then
            self.cleanup_updates_remaining = self.cleanup_updates_remaining - 1
            if self.cleanup_updates_remaining <= 0 then self.current = "NONE" end
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    local disconnects = 0
    deps.preflight = function() return gamma_arena_result.err("GA_PREFLIGHT_FAILED", "injected pre-session failure") end
    deps.disconnect = function() disconnects = disconnects + 1; return true end
    deps.teardown = function()
        checkpoint:cleanup(nil)
        return checkpoint:update()
    end
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:on_game_load()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "launch preflight failure enters fatal before session assignment")
    gamma_arena_test_assert.equals(orchestrator:session_snapshot(), nil, "preflight fatal has no ArenaSession")
    local pending = orchestrator:main_menu_action()
    gamma_arena_test_assert.is_false(pending.ok, "pre-session fatal still waits for exact checkpoint cleanup")
    gamma_arena_test_assert.equals(pending.error.code, "GA_RUNTIME_CLEANUP_PENDING", "pre-session cleanup exposes retryable pending result")
    gamma_arena_test_assert.equals(disconnects, 0, "pre-session fatal cannot disconnect while cleanup is pending")
    orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(orchestrator:main_menu_action().ok, "pre-session fatal disconnects after checkpoint reaches NONE")
    gamma_arena_test_assert.equals(disconnects, 1, "pre-session fatal disconnect executes once")
end

local function runtime_prepare_resume_legacy_mismatch_is_normalized()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.err("GA_RESUME_NONCE_MISMATCH", "injected legacy store mismatch")
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(store))
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    local failed = orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(failed.ok, "legacy preparation mismatch enters fatal routing")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "orchestrator exposes one restore-failure contract at the recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_RESUME_NONCE_MISMATCH", "normalized restore failure preserves the legacy mismatch cause")
end

local function fake_vector(x, y, z)
    local value = { x = x, y = y, z = z }
    function value:sub(other)
        return fake_vector(self.x - other.x, self.y - other.y, self.z - other.z)
    end
    function value:getH()
        return self.x + self.z
    end
    return value
end

local function fake_actor_adapter_env()
    local env = {
        active = true,
        owned = true,
        iterating = false,
        released = {},
        release_requests = {},
        release_queue = {},
        release_delay_ms = 0,
        never_finishes = false,
        never_finishes_ids = {},
        release_fail_ids = {},
        release_submission_count = 0,
        inventory_callback_sequence = nil,
        inventory_callback_count = 0,
        actor_id_sequence = nil,
        actor_id_reads = 0,
        equality_calls = 0,
        now = 0,
        input_acquires = 0,
        input_releases = 0,
        ordered_calls = {},
        interrupt_calls = 0,
        transient_reset_calls = 0,
        interrupt_failure = false,
        interrupt_throw = false,
        input_failure = false,
        transient_reset_failure = false,
        effect_calls = 0,
        body_health_reset_calls = 0,
        bhs = {
            maxhp = { head = 11, torso = 11, leftarm = 5, rightarm = 5, leftleg = 5, rightleg = 5 },
            health = { head = 2, torso = 3, leftarm = 1, rightarm = 2, leftleg = 1, rightleg = 2 },
            timedhp = { head = 1, torso = 1, leftarm = 1, rightarm = 1, leftleg = 1, rightleg = 1 }
        },
        boundary_inside = true,
        boundary_checks = 0,
        positions = {
            actor_spawn = fake_vector(1, 2, 3),
            actor_look = fake_vector(5, 2, 9)
        }
    }
    local actor = { items = {}, actor_id = 700, money_value = 2500 }
    function actor:id()
        env.actor_id_reads = env.actor_id_reads + 1
        if env.actor_id_sequence ~= nil then return env.actor_id_sequence[env.actor_id_reads] end
        return self.actor_id
    end
    function actor:money() return self.money_value end
    function actor:give_money(value) self.money_delta = value; self.money_value = self.money_value + value end
    function actor:iterate_inventory(callback, context)
        env.iterating = true
        if env.inventory_callback_sequence ~= nil then
            for index = 1, env.inventory_callback_count do callback(context, env.inventory_callback_sequence[index]) end
        else
            local snapshot = {}
            for index = 1, #self.items do snapshot[index] = self.items[index] end
            for index = 1, #snapshot do callback(context, snapshot[index]) end
        end
        env.iterating = false
    end
    function actor:set_health_ex(value) self.health_value = value end
    actor.power = 0.25
    actor.radiation = 0.5
    actor.bleeding = 0.75
    actor.psy_health = 0.5
    function actor:set_actor_position(value) self.position_value = value; env.boundary_inside = true end
    function actor:set_actor_direction(value) self.direction_value = value end
    function actor:set_invulnerable(value) self.invulnerable_value = value end
    function actor:position() return self.position_value or fake_vector(0, 0, 0) end
    env.actor = actor
    local function poison_game_object_equality()
        env.equality_calls = env.equality_calls + 1
        error("native game_object equality invoked")
    end
    setmetatable(actor, { __eq = poison_game_object_equality })
    function env:actor_alias()
        return setmetatable({
            actor_id = actor.actor_id,
            items = actor.items,
            money_value = actor.money_value
        }, {
            __index = actor,
            __eq = poison_game_object_equality
        })
    end
    function env:add_item(id, options)
        options = options or {}
        local item = { item_id = id, options = options, parent_calls = 0, id_calls = 0 }
        function item:id()
            self.id_calls = self.id_calls + 1
            if self.options.item_id_throw then error("injected item id failure") end
            return self.item_id
        end
        function item:parent()
            self.parent_calls = self.parent_calls + 1
            if self.options.parent_throw then error("injected parent lookup failure") end
            if self.options.parent_missing then return nil end
            return self.options.parent or actor
        end
        function item:section()
            if self.options.section_throw then error("injected item section failure") end
            return self.options.section or ("section_" .. tostring(self.item_id))
        end
        actor.items[#actor.items + 1] = item
        return item
    end
    function env:remove_item(id)
        for index = #actor.items, 1, -1 do
            if actor.items[index].item_id == id then table.remove(actor.items, index) end
        end
    end
    function env:advance(delta)
        self.now = (self.now + delta) % 4294967296
        for index = #self.release_queue, 1, -1 do
            local queued = self.release_queue[index]
            local elapsed = (self.now - queued.submitted_at) % 4294967296
            if not self.never_finishes and not self.never_finishes_ids[queued.id] and elapsed >= queued.delay_ms then
                self:remove_item(queued.id)
                table.remove(self.release_queue, index)
            end
        end
    end
    local function release(id)
        gamma_arena_test_assert.is_false(env.iterating, "inventory mutation must happen only after iteration")
        env.release_submission_count = env.release_submission_count + 1
        if env.release_fail_ids[id] then return gamma_arena_result.err("GA_ACTOR_INVENTORY_RELEASE_FAILED", "injected release failure") end
        env.released[#env.released + 1] = id
        env.release_requests[id] = (env.release_requests[id] or 0) + 1
        local delay = type(env.release_delay_ms) == "function" and env.release_delay_ms(id) or env.release_delay_ms
        env.release_queue[#env.release_queue + 1] = { id = id, submitted_at = env.now, delay_ms = delay }
        return gamma_arena_result.ok(true)
    end
    local deps = {
        actor = function() return actor end,
        is_session_active = function() return env.active end,
        is_actor_owned = function(candidate) return env.owned and candidate:id() == actor:id() end,
        release_item_id = release,
        clock = function() return env.now end,
        inventory_drain_timeout_ms = 10000,
        item_section = function(item) return item:section() end,
        patrol = function(path)
            local object = {}
            function object:point() return env.positions[path] end
            return object
        end,
        boundary_contains = function(candidate, zone_name)
            env.boundary_checks = env.boundary_checks + 1
            gamma_arena_test_assert.is_true(candidate == actor, "boundary checks only the owned actor")
            gamma_arena_test_assert.equals(zone_name, "bar_arena_sr", "boundary uses the configured restrictor")
            return gamma_arena_result.ok(env.boundary_inside)
        end,
        effects = { disable_effects_timer = function() env.effect_calls = env.effect_calls + 1 end },
        interrupt_item_use = function()
            env.interrupt_calls = env.interrupt_calls + 1
            env.ordered_calls[#env.ordered_calls + 1] = "interrupt"
            if env.interrupt_throw then error("injected item-use interrupt exception") end
            if env.interrupt_failure then return gamma_arena_result.err("GA_TEST_INTERRUPT", "injected item-use interrupt failure") end
            return gamma_arena_result.ok(true)
        end,
        reset_transient_state = function(candidate)
            env.transient_reset_calls = env.transient_reset_calls + 1
            env.ordered_calls[#env.ordered_calls + 1] = "transients"
            if env.transient_reset_failure then return gamma_arena_result.err("GA_TEST_TRANSIENT", "injected transient reset failure") end
            gamma_arena_test_assert.is_true(candidate == actor, "body-health reset only touches the owned Arena actor")
            env.body_health_reset_calls = env.body_health_reset_calls + 1
            for part, maximum in pairs(env.bhs.maxhp) do
                env.bhs.health[part] = maximum
                env.bhs.timedhp[part] = 0
            end
            return gamma_arena_result.ok(true)
        end,
        input = {
            acquire = function()
                env.input_acquires = env.input_acquires + 1
                env.ordered_calls[#env.ordered_calls + 1] = "input"
                if env.input_failure then return gamma_arena_result.err("GA_TEST_INPUT", "injected input acquisition failure") end
                return gamma_arena_result.ok(true)
            end,
            release = function() env.input_releases = env.input_releases + 1; return gamma_arena_result.ok(true) end
        }
    }
    return env, gamma_arena_actor_adapter.new(deps)
end

local function runtime_actor_rematch_boundary_aborts_before_input_lock()
    local env, adapter = fake_actor_adapter_env()
    local result = adapter:begin_rematch_boundary()
    gamma_arena_test_assert.is_true(result.ok, "rematch boundary succeeds")
    gamma_arena_test_assert.equals(env.ordered_calls[1], "interrupt", "LAM2 interruption precedes Arena input ownership")
    gamma_arena_test_assert.equals(env.ordered_calls[2], "input", "Arena input ownership is the final boundary mutation")
    gamma_arena_test_assert.equals(env.interrupt_calls, 1, "item presentation is interrupted once")
    gamma_arena_test_assert.equals(env.input_acquires, 1, "input is acquired once")
end

local function runtime_actor_rematch_boundary_failure_never_acquires_input()
    local env, adapter = fake_actor_adapter_env()
    env.interrupt_failure = true
    local result = adapter:begin_rematch_boundary()
    gamma_arena_test_assert.is_false(result.ok, "throwing/present item integration fails the boundary")
    gamma_arena_test_assert.equals(result.error.code, "GA_TEST_INTERRUPT", "boundary preserves the structured integration failure")
    gamma_arena_test_assert.equals(env.input_acquires, 0, "failed interruption cannot acquire the Arena input lease")

    local throwing_env, throwing = fake_actor_adapter_env()
    throwing_env.interrupt_throw = true
    local thrown = throwing:begin_rematch_boundary()
    gamma_arena_test_assert.is_false(thrown.ok, "throwing item integration fails safely")
    gamma_arena_test_assert.equals(thrown.error.code, "GA_ACTOR_ITEM_USE_INTERRUPT_FAILED", "throwing interruption is classified")
    gamma_arena_test_assert.equals(throwing_env.input_acquires, 0, "throwing interruption cannot acquire input")

    local input_env, input = fake_actor_adapter_env()
    input_env.input_failure = true
    local rejected = input:begin_rematch_boundary()
    gamma_arena_test_assert.is_false(rejected.ok, "failed required input acquisition rejects rematch boundary")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_TEST_INPUT", "input acquisition failure identity is preserved")
    gamma_arena_test_assert.equals(input_env.input_releases, 0, "failed acquisition owns no lease to release")
end

local function runtime_actor_preowned_input_survives_normalize_failure()
    local env, adapter = fake_actor_adapter_env()
    gamma_arena_test_assert.is_true(adapter:begin_rematch_boundary().ok, "fixture pre-acquires the rematch input lease")
    env.actor.money = function() error("injected money read failure") end
    local failed = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" }, true)
    gamma_arena_test_assert.is_false(failed.ok, "normalization failure remains observable")
    gamma_arena_test_assert.equals(env.input_acquires, 1, "normalization reuses the pre-owned rematch lease")
    gamma_arena_test_assert.equals(env.input_releases, 0, "normalization cannot release a lease owned before this invocation")
    gamma_arena_test_assert.is_true(adapter.input_owned, "pre-owned rematch input remains held for fatal teardown")
end

local function runtime_actor_rematch_transients_clear_once_before_loadout_cleanup()
    local env, adapter = fake_actor_adapter_env()
    local cleanup_calls = 0
    adapter.deps.loadout = {
        cleanup = function()
            cleanup_calls = cleanup_calls + 1
            env.ordered_calls[#env.ordered_calls + 1] = "loadout"
            return gamma_arena_result.ok({ pending = true })
        end
    }
    adapter:begin_update()
    local first = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    local second = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(first.ok and first.value.pending, "first rematch reset waits for loadout cleanup")
    gamma_arena_test_assert.is_true(second.ok and second.value.pending, "repeated rematch reset remains pending")
    gamma_arena_test_assert.equals(env.ordered_calls[1], "transients", "round transients clear before loadout cleanup")
    gamma_arena_test_assert.equals(env.ordered_calls[2], "loadout", "loadout cleanup follows the one-shot transient clear")
    gamma_arena_test_assert.equals(env.transient_reset_calls, 1, "pending loadout updates never repeat transient cleanup")
    gamma_arena_test_assert.equals(cleanup_calls, 2, "loadout cleanup remains retryable while pending")
end

local function runtime_actor_transient_failure_prevents_loadout_cleanup()
    local env, adapter = fake_actor_adapter_env()
    local cleanup_calls = 0
    env.transient_reset_failure = true
    adapter.deps.loadout = { cleanup = function() cleanup_calls = cleanup_calls + 1; return gamma_arena_result.ok(true) end }
    adapter:begin_update()
    local result = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_false(result.ok, "transient reset failure stops rematch")
    gamma_arena_test_assert.equals(result.error.code, "GA_TEST_TRANSIENT", "transient failure identity is preserved")
    gamma_arena_test_assert.equals(cleanup_calls, 0, "loadout cleanup cannot run after failed transient reset")
end

local function fake_actor_conditions(options)
    options = options or {}
    local conditions = {
        wound_count = options.wounds or 2,
        booster_count = options.boosters or 2,
        alcohol = options.alcohol or 0.5
    }
    function conditions:ClearWounds()
        if not options.retain_wounds then self.wound_count = 0 end
    end
    function conditions:ClearAllBoosters()
        if not options.retain_boosters then self.booster_count = 0 end
    end
    function conditions:GetAlcohol() return self.alcohol end
    function conditions:ChangeAlcohol(delta)
        if not options.retain_alcohol then self.alcohol = self.alcohol + delta end
    end
    function conditions:WoundForEach(callback)
        for index = 1, self.wound_count do callback({ index = index }) end
    end
    function conditions:BoosterForEach(callback)
        for index = 1, self.booster_count do callback(index, 1, 1) end
    end
    local cast = { conditions = function() return conditions end }
    local actor = { cast_Actor = function() return cast end }
    return actor, conditions
end

local function runtime_bootstrap_engine_transients_clear_and_verify()
    local actor, conditions = fake_actor_conditions()
    local result = gamma_arena_bootstrap.test_clear_engine_actor_transients(actor)
    gamma_arena_test_assert.is_true(result.ok, "engine transient reset succeeds with complete condition APIs")
    gamma_arena_test_assert.equals(conditions.wound_count, 0, "engine wounds are authoritatively cleared")
    gamma_arena_test_assert.equals(conditions.booster_count, 0, "engine boosters are authoritatively cleared")
    gamma_arena_test_assert.equals(conditions.alcohol, 0, "engine alcohol is authoritatively zeroed")
end

local function runtime_bootstrap_engine_transient_readback_fails_closed()
    for _, options in ipairs({
        { retain_wounds = true },
        { retain_boosters = true },
        { retain_alcohol = true }
    }) do
        local actor = fake_actor_conditions(options)
        local result = gamma_arena_bootstrap.test_clear_engine_actor_transients(actor)
        gamma_arena_test_assert.is_false(result.ok, "surviving engine transient fails closed")
        gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_TRANSIENT_VERIFY_FAILED", "engine readback failure code is stable")
    end
    local actor = fake_actor_conditions()
    actor.cast_Actor = nil
    local missing = gamma_arena_bootstrap.test_clear_engine_actor_transients(actor)
    gamma_arena_test_assert.is_false(missing.ok, "missing required condition API fails closed")
    gamma_arena_test_assert.equals(missing.error.code, "GA_ACTOR_CONDITIONS_API_MISSING", "missing condition API code is stable")
end

local function runtime_bootstrap_gamma_transient_integrations_are_exact()
    local parts = { "head", "torso", "rightarm", "leftarm", "rightleg", "leftleg" }
    local bhs = { health = {}, maxhp = {}, timedhp = {}, head_tbl = { previous = 1, stage = 2, volume = 0.75 } }
    for _, part in ipairs(parts) do bhs.health[part] = 1; bhs.maxhp[part] = part == "head" and 11 or 5; bhs.timedhp[part] = 2 end
    function bhs.save_state(out)
        out.head_tbl = { previous = bhs.head_tbl.previous, stage = bhs.head_tbl.stage, volume = bhs.head_tbl.volume }
    end
    function bhs.load_state(value) bhs.head_tbl = value.head_tbl end
    local persisted, removed_event, command = {}, nil, nil
    local utils = {
        save_var = function(_, key, value) persisted[key] = value end,
        load_var = function(_, key) return persisted[key] end
    }
    local reset = gamma_arena_bootstrap.test_reset_gamma_body_health({}, {
        bhs = bhs,
        utils = utils,
        remove_time_event = function(kind, name) removed_event = { kind = kind, name = name } end,
        execute = function(value) command = value end
    })
    gamma_arena_test_assert.is_true(reset.ok, "complete BHS integration resets successfully")
    for _, part in ipairs(parts) do
        gamma_arena_test_assert.equals(bhs.health[part], bhs.maxhp[part], "BHS part is fully restored: " .. part)
        gamma_arena_test_assert.equals(bhs.timedhp[part], 0, "BHS timed treatment is cleared: " .. part)
    end
    gamma_arena_test_assert.equals(bhs.head_tbl.previous, bhs.maxhp.head, "BHS concussion baseline becomes healthy")
    gamma_arena_test_assert.equals(bhs.head_tbl.stage, 0, "BHS concussion stage is cleared")
    gamma_arena_test_assert.equals(bhs.head_tbl.volume, 0.75, "BHS configured effect volume is preserved")
    gamma_arena_test_assert.equals(removed_event.kind, 0, "BHS delayed stage event namespace is exact")
    gamma_arena_test_assert.equals(removed_event.name, "set_stage_two", "BHS delayed stage event is cancelled")
    gamma_arena_test_assert.equals(command, "snd_volume_eff 0.75", "BHS effect volume is restored")

    local psy_calls = {}
    local psy = {
        set_psy_health = function(value) psy_calls[#psy_calls + 1] = value end,
        remove_all_psy_ppe_effects = function() psy_calls[#psy_calls + 1] = "clear" end
    }
    gamma_arena_test_assert.is_true(gamma_arena_bootstrap.test_reset_gamma_psy(psy).ok, "GAMMA psy integration resets successfully")
    gamma_arena_test_assert.equals(psy_calls[1], 1, "GAMMA psy health is restored first")
    gamma_arena_test_assert.equals(psy_calls[2], "clear", "GAMMA psy PPE is removed second")

    local pp, cam = {}, {}
    local effectors = gamma_arena_bootstrap.test_clear_round_effectors({
        remove_pp_effector = function(id) pp[#pp + 1] = id end,
        remove_cam_effector = function(id) cam[#cam + 1] = id end
    })
    gamma_arena_test_assert.is_true(effectors.ok, "bounded Arena effector cleanup succeeds")
    gamma_arena_test_assert.equals(#pp, 21, "only the bounded PP allowlist is removed")
    gamma_arena_test_assert.equals(pp[1], 2011, "condition PP range starts exactly")
    gamma_arena_test_assert.equals(pp[8], 99133, "BHS PP allowlist is exact")
    gamma_arena_test_assert.equals(pp[9], 655808, "BHS blur allowlist starts exactly")
    gamma_arena_test_assert.equals(pp[21], 655820, "BHS blur allowlist ends exactly")
    gamma_arena_test_assert.equals(#cam, 8, "only the bounded camera allowlist is removed")
    gamma_arena_test_assert.equals(cam[1], 1001, "bleed camera effector is removed")
    gamma_arena_test_assert.equals(cam[8], 99271, "BHS camera allowlist is exact")
end

local function runtime_actor_inventory_release_is_deferred_and_verified()
    local env, adapter = fake_actor_adapter_env()
    local first = env:add_item(12)
    local second = env:add_item(13)
    adapter:begin_update()
    local normalized = adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(normalized.ok, "owned Arena actor normalization must start")
    gamma_arena_test_assert.equals(env.released[1], 12, "inventory IDs retain deterministic iteration order")
    gamma_arena_test_assert.equals(env.released[2], 13, "equipped/inventory items are released after collection")
    gamma_arena_test_assert.equals(first.parent_calls, 1, "real client item parent object is inspected")
    gamma_arena_test_assert.equals(second.parent_calls, 1, "every inventory item uses game_object:parent()")
    gamma_arena_test_assert.is_false(adapter:verify_inventory_empty().value, "inventory cannot be verified on the purge update")
    env:advance(0)
    adapter:begin_update()
    gamma_arena_test_assert.is_true(adapter:verify_inventory_empty().value, "a later update confirms the inventory is empty")
    adapter:begin_update()
    gamma_arena_test_assert.is_true(adapter:verify_inventory_empty().value, "inventory verification is idempotent")
end

local function runtime_actor_inventory_drain_waits_for_looted_items()
    local env, adapter = fake_actor_adapter_env()
    env.release_delay_ms = 4000
    env:add_item(12, { section = "wpn_ak74" })
    env:add_item(13, { section = "ammo_5.45x39_fmj" })
    local cleanup_calls = 0
    adapter.deps.loadout = { cleanup = function() cleanup_calls = cleanup_calls + 1; return gamma_arena_result.ok(true) end }

    adapter:begin_update()
    local first = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
    gamma_arena_test_assert.is_true(first.ok and first.value.pending, "initial inventory drain stays pending")
    for poll = 1, 3 do
        env:advance(1000)
        adapter:begin_update()
        local pending = adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" })
        gamma_arena_test_assert.is_true(pending.ok and pending.value.pending and pending.value.stage == "inventory_absence", "looted inventory remains a successful pending result for poll " .. poll)
    end
    gamma_arena_test_assert.equals(env.release_requests[12], 1, "initial weapon release is submitted once")
    gamma_arena_test_assert.equals(env.release_requests[13], 1, "initial ammo release is submitted once")
    gamma_arena_test_assert.equals(cleanup_calls, 1, "victory cleanup runs once while drain is pending")
    gamma_arena_test_assert.equals(env.input_acquires, 1, "victory drain retains one input lease")
    env:advance(1000)
    adapter:begin_update()
    gamma_arena_test_assert.is_true(adapter:reset_for_rematch({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" }).value, "authoritative asynchronous removal completes the drain")
end

