local function runtime_task8_clean_registry_requires_exact_empty_arrays()
    local cases = {
        { registry = { state = "CLEAN", npcs = { { id = 10 } }, items = {} }, label = "retained NPC" },
        { registry = { state = "CLEAN", npcs = {}, items = { { id = 11 } } }, label = "retained item" },
        { registry = { state = "CLEAN", items = {} }, label = "missing NPC array" },
        { registry = { state = "CLEAN", npcs = {} }, label = "missing item array" }
    }
    for _, case in ipairs(cases) do
        local env = task8_environment()
        env.registry = clone(case.registry)
        env.deps.checkpoint.current = "NONE"
        env.orchestrator.cleanup_required = true
        env.orchestrator.teardown_done = true
        local rejected = env.orchestrator:cleanup_ready_for_disconnect()
        gamma_arena_test_assert.is_false(rejected.ok, case.label .. " cannot prove exact cleanup")
        gamma_arena_test_assert.equals(rejected.error.code, "GA_RUNTIME_CLEANUP_FAILED", case.label .. " fails closed deterministically")
        gamma_arena_test_assert.is_true(env.orchestrator.cleanup_required, case.label .. " cannot open disconnect gate")
    end
end

local function runtime_task8_duplicate_result_clicks_are_idempotent()
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    local first = env.victory_dialogs[1].on_next()
    local duplicate = env.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_true(first.ok and first.value == true, "first result action owns the transition")
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "duplicate result action is ignored")
    gamma_arena_test_assert.equals(env.boundary_calls, 1, "duplicate result action cannot reacquire the rematch boundary")
end

local function runtime_task8_one_hundred_fights_leave_empty_registries()
    local env = task8_environment(); task8_pump_to_active(env)
    local seen, seen_entity_ids = {}, {}
    for fight = 1, 100 do
        local fight_id = env.orchestrator.fight_spec:fight_id()
        gamma_arena_test_assert.is_false(seen[fight_id], "fight_id must be unique across the simulated loop")
        seen[fight_id] = true
        gamma_arena_test_assert.is_true(#env.registry.npcs > 0, "every simulated fight owns registered NPC ids")
        gamma_arena_test_assert.is_true(#env.registry.items > 0, "every simulated fight owns registered item ids")
        for _, collection in ipairs({ env.registry.npcs, env.registry.items }) do
            for _, record in ipairs(collection) do
                gamma_arena_test_assert.is_false(seen_entity_ids[record.id], "next fight cannot reuse an old NPC/item id")
                seen_entity_ids[record.id] = true
            end
        end
        env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
        if fight < 100 then
            env.victory_dialogs[#env.victory_dialogs].on_next()
            env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
            gamma_arena_test_assert.equals(#env.registry.npcs, 0, "registry NPC ids are empty between fights")
            gamma_arena_test_assert.equals(#env.registry.items, 0, "registry item ids are empty between fights")
            env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
            env.orchestrator:actor_on_update()
            env.now = env.now + 3000
            env.orchestrator:actor_on_update()
        end
    end
    gamma_arena_test_assert.equals(env.generated, 100, "100 victories generate 100 deterministic FightSpecs")
    gamma_arena_test_assert.equals(#env.battle_identity_models, 100, "every active fight refreshes one battle identity")
    for index, model in ipairs(env.battle_identity_models) do
        gamma_arena_test_assert.equals(model.fight_index, index - 1, "battle identity tracks each zero-based fight index")
    end
    gamma_arena_test_assert.equals(env.checkpoint_create, 0, "successive victories never create campaign or replacement checkpoint saves")
    gamma_arena_test_assert.equals(env.reset_actor, 99, "actor reset remains responsive across every next-fight transition")
end

local function natural_death_environment(options)
    options = options or {}
    local env = { arm = 0, confirm = 0, tactical_stop = 0, neutralize = 0, actor_mutations = 0, battle_identity_clears = 0, audio_calls = {} }
    local store = fake_store()
    function store:arm_defeat(_, context)
        env.arm = env.arm + 1
        env.armed_context = clone(context)
        if options.arm_failure then return gamma_arena_result.err("GA_TEST_ARM", "injected defeat arm failure") end
        return gamma_arena_result.ok({ token = "gad1:1000:natural" })
    end
    function store:confirm_defeat(_, token)
        env.confirm = env.confirm + 1
        env.confirmed_token = token
        if options.confirm_failure then return gamma_arena_result.err("GA_TEST_CONFIRM", "injected defeat confirm failure") end
        return gamma_arena_result.ok(true)
    end
    local deps = fake_orchestrator_deps(store)
    deps.battle_ui = {
        clear_identity = function()
            env.battle_identity_clears = env.battle_identity_clears + 1
            if options.battle_ui_clear_error then
                return gamma_arena_result.err("GA_TEST_BATTLE_UI_CLEAR", "injected death boundary clear failure")
            end
            return gamma_arena_result.ok(true)
        end
    }
    deps.audio = {
        defeat = function(_, context)
            env.audio_calls[#env.audio_calls + 1] = { method = "defeat", context = clone(context or {}) }
            if options.audio_error then return gamma_arena_result.err("GA_TEST_AUDIO", "injected defeat audio failure") end
            return gamma_arena_result.ok(true)
        end,
        stop_all = function(_, context)
            env.audio_calls[#env.audio_calls + 1] = { method = "stop_all", context = clone(context or {}) }
            return gamma_arena_result.ok(true)
        end
    }
    deps.actor.hold_after_logical_death = function()
        env.actor_mutations = env.actor_mutations + 1
        return gamma_arena_result.ok(true)
    end
    deps.entities = {
        stop_tactical = function()
            env.tactical_stop = env.tactical_stop + 1
            return gamma_arena_result.ok(true)
        end,
        neutralize_owned_opponents = function()
            env.neutralize = env.neutralize + 1
            return gamma_arena_result.ok(true)
        end
    }
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator.active = true
    orchestrator.runtime_stage = "ACTIVE"
    orchestrator.session = {
        schema_version = 1,
        session_id = "ga_natural_session",
        session_nonce = "ga_natural_nonce",
        mode_id = "skirmish",
        difficulty_id = "master",
        fight_index = 7
    }
    env.orchestrator = orchestrator
    return env
end

local function runtime_natural_death_arms_confirms_and_neutralizes_once()
    local env = natural_death_environment()
    local flags = { ret_value = true }
    local before = env.orchestrator:actor_on_before_death(77, flags)
    local duplicate_before = env.orchestrator:actor_on_before_death(77, { ret_value = true })
    local post_lethal_victory = env.orchestrator:queue_victory()
    gamma_arena_test_assert.is_true(before.ok, "Arena death arms")
    gamma_arena_test_assert.is_true(duplicate_before.ok and duplicate_before.value == false, "duplicate lethal callback is inert")
    gamma_arena_test_assert.equals(flags.ret_value, true, "Arena never cancels lethal damage")
    gamma_arena_test_assert.equals(env.actor_mutations, 0, "Arena never heals or holds the dying actor")
    gamma_arena_test_assert.equals(env.arm, 1, "one defeat intent is armed")
    gamma_arena_test_assert.equals(env.tactical_stop, 1, "before-death stops tactical control once")
    gamma_arena_test_assert.equals(env.battle_identity_clears, 1, "before-death clears battle identity once")
    gamma_arena_test_assert.equals(env.armed_context.difficulty_id, "master", "defeat handoff preserves difficulty")
    gamma_arena_test_assert.is_true(post_lethal_victory.ok and post_lethal_victory.value == false, "lethal arm wins any later same-frame victory callback")
    gamma_arena_test_assert.equals(env.orchestrator.pending_victory, false, "post-lethal victory cannot reopen in-level result flow")

    local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
    local dead = callbacks.actor_on_death()
    local duplicate_dead = callbacks.actor_on_death()
    gamma_arena_test_assert.is_true(dead.ok, "real death confirms")
    gamma_arena_test_assert.equals(duplicate_dead, nil, "inactive duplicate actor_on_death callback is guarded")
    gamma_arena_test_assert.equals(env.confirm, 1, "one defeat intent is confirmed")
    gamma_arena_test_assert.equals(env.confirmed_token, "gad1:1000:natural", "confirmation reuses the armed token")
    gamma_arena_test_assert.equals(env.neutralize, 1, "owned opponents are neutralized")
    gamma_arena_test_assert.is_false(env.orchestrator:is_active(), "dead actor clears in-level Arena activity")
    gamma_arena_test_assert.equals(env.orchestrator.pending_victory, false, "death clears a queued victory")
end

local function runtime_natural_death_failures_never_cancel_engine_death()
    local arm = natural_death_environment({ arm_failure = true })
    local arm_flags = { ret_value = true }
    local arm_failed = gamma_arena_bootstrap.make_callbacks(arm.orchestrator).actor_on_before_death(77, arm_flags)
    gamma_arena_test_assert.is_false(arm_failed.ok, "defeat arm failure remains observable")
    gamma_arena_test_assert.equals(arm_flags.ret_value, true, "arm failure never cancels engine death")
    gamma_arena_test_assert.equals(arm.actor_mutations, 0, "arm failure never heals the dying actor")
    local arm_dead = gamma_arena_bootstrap.make_callbacks(arm.orchestrator).actor_on_death()
    gamma_arena_test_assert.is_false(arm_dead.ok, "missing armed token remains observable after real death")
    gamma_arena_test_assert.equals(arm.neutralize, 1, "arm failure cannot prevent dead-actor opponent neutralization")
    gamma_arena_test_assert.is_false(arm.orchestrator:is_active(), "arm failure still clears dead in-level state")

    local confirm = natural_death_environment({ confirm_failure = true })
    local confirm_flags = { ret_value = true }
    gamma_arena_bootstrap.make_callbacks(confirm.orchestrator).actor_on_before_death(77, confirm_flags)
    local confirmed = gamma_arena_bootstrap.make_callbacks(confirm.orchestrator).actor_on_death()
    gamma_arena_test_assert.is_false(confirmed.ok, "post-mortem confirm failure remains observable")
    gamma_arena_test_assert.equals(confirm_flags.ret_value, true, "confirm failure cannot retroactively cancel death")
    gamma_arena_test_assert.equals(confirm.neutralize, 1, "opponents are neutralized even when defeat confirmation fails")
    gamma_arena_test_assert.is_false(confirm.orchestrator:is_active(), "post-mortem failure still clears in-level Arena state")
end

local function runtime_natural_death_outside_active_arena_is_inert()
    for _, stage in ipairs({ "INACTIVE", "COUNTDOWN" }) do
        local env = natural_death_environment()
        env.orchestrator.runtime_stage = stage
        if stage == "INACTIVE" then env.orchestrator.active = false end
        local flags = { ret_value = true }
        local before = env.orchestrator:actor_on_before_death(77, flags)
        local dead = env.orchestrator:actor_on_death()
        gamma_arena_test_assert.is_true(before.ok and before.value == false, stage .. " before-death is inert")
        gamma_arena_test_assert.is_true(dead.ok and dead.value == false, stage .. " actor death is inert")
        gamma_arena_test_assert.equals(flags.ret_value, true, stage .. " never mutates stock death flags")
        gamma_arena_test_assert.equals(env.arm + env.confirm + env.neutralize, 0, stage .. " writes no Arena defeat state")
    end
end

local function runtime_audio_defeat_failure_never_cancels_death()
    local env = natural_death_environment({ audio_error = true })
    local flags = { ret_value = true }
    local result = env.orchestrator:actor_on_before_death(77, flags)
    gamma_arena_test_assert.is_true(result.ok, "defeat audio failure cannot reject natural death arming")
    gamma_arena_test_assert.equals(#env.audio_calls, 1, "natural death emits one defeat audio event")
    gamma_arena_test_assert.equals(env.audio_calls[1].method, "defeat", "natural death uses the defeat event")
    gamma_arena_test_assert.equals(env.arm, 1, "defeat intent remains armed after audio failure")
    gamma_arena_test_assert.equals(env.tactical_stop, 1, "tactical stop remains ordered after audio failure")
    gamma_arena_test_assert.equals(flags.ret_value, true, "audio failure never cancels lethal damage")
end

local function defeat_menu_test_owner()
    local menu = { hide_dialog = 0, hidden = 0, show_dialog = 0, shown = 0 }
    function menu:HideDialog() self.hide_dialog = self.hide_dialog + 1 end
    function menu:ShowDialog(value) if value then self.show_dialog = self.show_dialog + 1 end end
    function menu:Show(value)
        if value then self.shown = self.shown + 1 else self.hidden = self.hidden + 1 end
    end
    return menu
end

local function runtime_defeat_menu_rejects_invalid_or_expired_handoff()
    for _, handoff in ipairs({ gamma_arena_result.ok(false), gamma_arena_result.err("GA_DEFEAT_TOKEN_EXPIRED", "expired") }) do
        local menu = defeat_menu_test_owner()
        local shown = 0
        local result = gamma_arena_main_menu.show_confirmed_defeat(menu, {
            config = {},
            peek_defeat = function() return handoff end,
            show_result = function() shown = shown + 1; return gamma_arena_result.ok(true) end
        })
        gamma_arena_test_assert.equals(result.ok, handoff.ok, "invalid or expired handoff remains observable")
        gamma_arena_test_assert.equals(shown, 0, "invalid or expired handoff never opens Arena UI")
        gamma_arena_test_assert.equals(menu.hide_dialog + menu.hidden, 0, "invalid or expired handoff leaves the stock menu visible")
    end
end

local function runtime_defeat_menu_fresh_failures_are_bounded()
    for _, stage in ipairs({ "preflight", "seed", "promotion", "bridge", "handoff" }) do
        local menu = defeat_menu_test_owner()
        local model
        local clears = 0
        local fatal_calls = 0
        local recovered = false
        local preflight_calls = 0
        local seed_calls = 0
        local promotion_calls = 0
        local bridge_calls = 0
        local handoff_calls = 0
        local ports = {
            config = {},
            peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:" .. stage }) end,
            show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
            clear_result = function() return gamma_arena_result.ok(true) end,
            clear_transient = function() clears = clears + 1; return gamma_arena_result.ok(true) end,
            runtime_preflight = function()
                preflight_calls = preflight_calls + 1
                if stage == "preflight" then return gamma_arena_result.err("GA_TEST_PREFLIGHT", "preflight") end
                return gamma_arena_result.ok(true)
            end,
            random_session_seed = function()
                seed_calls = seed_calls + 1
                if stage == "seed" then return gamma_arena_result.err("GA_TEST_SEED", "seed") end
                return gamma_arena_result.ok(987654321)
            end,
            issue_launch_from_defeat = function()
                promotion_calls = promotion_calls + 1
                if stage == "promotion" then return gamma_arena_result.err("GA_TEST_PROMOTION", "promotion") end
                return gamma_arena_result.ok(true)
            end,
            write_character_creation = function()
                bridge_calls = bridge_calls + 1
                if stage == "bridge" then return gamma_arena_result.err("GA_TEST_BRIDGE", "bridge") end
                return gamma_arena_result.ok(true)
            end,
            handoff_start_game = function()
                handoff_calls = handoff_calls + 1
                if stage == "handoff" then return gamma_arena_result.err("GA_TEST_HANDOFF", "handoff") end
                return gamma_arena_result.ok(true)
            end,
            show_fatal = function(owner, errors, callback, context)
                fatal_calls = fatal_calls + 1
                gamma_arena_test_assert.equals(owner, menu, stage .. " fatal retains menu owner")
                gamma_arena_test_assert.equals(#errors, 1, stage .. " fatal reports one bounded failure")
                local dialog = { HideDialog = function() end, Show = function() end }
                local recovery = callback(context, dialog)
                recovered = recovery.ok
                return dialog
            end
        }
        gamma_arena_test_assert.is_true(gamma_arena_main_menu.show_confirmed_defeat(menu, ports).ok, stage .. " fixture displays")
        local failed = model.on_next()
        gamma_arena_test_assert.is_false(failed.ok, stage .. " failure stays structured")
        gamma_arena_test_assert.equals(preflight_calls, 1, stage .. " runs runtime preflight exactly once")
        gamma_arena_test_assert.equals(seed_calls, stage == "preflight" and 0 or 1, stage .. " failure has the expected seed calls")
        gamma_arena_test_assert.equals(promotion_calls, (stage == "preflight" or stage == "seed") and 0 or 1, stage .. " failure has the expected promotion calls")
        gamma_arena_test_assert.equals(bridge_calls, (stage == "preflight" or stage == "seed" or stage == "promotion") and 0 or 1, stage .. " failure has the expected bridge calls")
        gamma_arena_test_assert.equals(handoff_calls, stage == "handoff" and 1 or 0, stage .. " failure has the expected handoff calls")
        gamma_arena_test_assert.equals(clears, stage == "preflight" and 0 or 1, stage .. " failure clears transient state only after mutation")
        gamma_arena_test_assert.equals(fatal_calls, 1, stage .. " failure opens one fatal recovery dialog")
        gamma_arena_test_assert.is_true(recovered, stage .. " fatal offers a working main-menu-only recovery")
        gamma_arena_test_assert.equals(menu.show_dialog, 1, stage .. " recovery restores owner dialog")
        gamma_arena_test_assert.equals(menu.shown, 1, stage .. " recovery restores owner visibility")
    end
end

local function runtime_defeat_menu_preflight_failure_identity_is_preserved()
    local injected_context = { phase = "compose", generation = 17 }
    local default_context = { phase = "compose", generation = 18 }
    local injected_failure = gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "injected bootstrap compose failure", injected_context)
    local default_failure = gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "default bootstrap compose failure", default_context)
    local scenarios = {
        { name = "injected", failure = injected_failure, context = injected_context, runtime_preflight = function() return injected_failure end },
        { name = "default", failure = default_failure, context = default_context, use_default = true },
        { name = "thrown", code = "GA_DEFEAT_PORT_FAILED", port = "runtime_preflight", runtime_preflight = function() error("injected thrown runtime preflight") end },
        { name = "malformed", code = "GA_DEFEAT_PORT_FAILED", port = "runtime_preflight", result_type = "boolean", runtime_preflight = function() return true end }
    }
    local original_preflight = gamma_arena_ui_start.preflight_runtime
    for _, scenario in ipairs(scenarios) do
        local menu = defeat_menu_test_owner()
        local model
        local preflight_calls = 0
        local seed_calls = 0
        local promotion_calls = 0
        local bridge_calls = 0
        local handoff_calls = 0
        local clears = 0
        local fatal_failure
        local recovered = false
        if scenario.use_default then
            gamma_arena_ui_start.preflight_runtime = function()
                preflight_calls = preflight_calls + 1
                return scenario.failure
            end
        end
        local ports = {
            config = {},
            peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:" .. scenario.name }) end,
            show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
            clear_result = function() return gamma_arena_result.ok(true) end,
            clear_transient = function() clears = clears + 1; return gamma_arena_result.ok(true) end,
            random_session_seed = function() seed_calls = seed_calls + 1; return gamma_arena_result.ok(987654321) end,
            issue_launch_from_defeat = function() promotion_calls = promotion_calls + 1; return gamma_arena_result.ok(true) end,
            write_character_creation = function() bridge_calls = bridge_calls + 1; return gamma_arena_result.ok(true) end,
            handoff_start_game = function() handoff_calls = handoff_calls + 1; return gamma_arena_result.ok(true) end,
            show_fatal = function(owner, errors, callback, context)
                gamma_arena_test_assert.equals(owner, menu, scenario.name .. " preflight fatal retains menu owner")
                gamma_arena_test_assert.equals(#errors, 1, scenario.name .. " preflight fatal reports only the readiness failure")
                fatal_failure = errors[1]
                local dialog = { HideDialog = function() end, Show = function() end }
                recovered = callback(context, dialog).ok
                return dialog
            end
        }
        if not scenario.use_default then
            ports.runtime_preflight = function()
                preflight_calls = preflight_calls + 1
                return scenario.runtime_preflight()
            end
        end
        gamma_arena_test_assert.is_true(gamma_arena_main_menu.show_confirmed_defeat(menu, ports).ok, scenario.name .. " preflight identity fixture displays")
        local failed = model.on_next()
        gamma_arena_ui_start.preflight_runtime = original_preflight
        gamma_arena_test_assert.is_false(failed.ok, scenario.name .. " preflight failure remains structured")
        gamma_arena_test_assert.equals(preflight_calls, 1, scenario.name .. " preflight runs exactly once")
        gamma_arena_test_assert.equals(seed_calls, 0, scenario.name .. " preflight failure generates no seed")
        gamma_arena_test_assert.equals(promotion_calls, 0, scenario.name .. " preflight failure makes no promotion")
        gamma_arena_test_assert.equals(bridge_calls, 0, scenario.name .. " preflight failure makes no bridge")
        gamma_arena_test_assert.equals(handoff_calls, 0, scenario.name .. " preflight failure makes no handoff")
        gamma_arena_test_assert.equals(clears, 0, scenario.name .. " preflight failure does not clear transient state")
        gamma_arena_test_assert.equals(fatal_failure, failed, scenario.name .. " fatal feedback retains the returned failure")
        gamma_arena_test_assert.is_true(recovered, scenario.name .. " fatal recovery restores the main menu")
        gamma_arena_test_assert.equals(menu.show_dialog, 1, scenario.name .. " fatal recovery restores owner dialog")
        gamma_arena_test_assert.equals(menu.shown, 1, scenario.name .. " fatal recovery restores owner visibility")
        if scenario.failure then
            gamma_arena_test_assert.equals(failed, scenario.failure, scenario.name .. " returns the original bootstrap Result")
            gamma_arena_test_assert.equals(failed.error.code, "GA_BOOTSTRAP_COMPOSE_FAILED", scenario.name .. " retains bootstrap failure code")
            gamma_arena_test_assert.equals(failed.error.context, scenario.context, scenario.name .. " retains bootstrap failure context")
            gamma_arena_test_assert.equals(fatal_failure.error.context, scenario.context, scenario.name .. " fatal feedback retains bootstrap failure context")
        else
            gamma_arena_test_assert.equals(failed.error.code, scenario.code, scenario.name .. " normalizes the failed port code")
            gamma_arena_test_assert.equals(failed.error.context.port, scenario.port, scenario.name .. " normalizes the failed port name")
            if scenario.result_type then
                gamma_arena_test_assert.equals(failed.error.context.result_type, scenario.result_type, scenario.name .. " records the malformed result type")
            else
                gamma_arena_test_assert.is_true(type(failed.error.context.reason) == "string", scenario.name .. " records the thrown port reason")
            end
        end
    end
end

local function runtime_defeat_menu_default_fatal_path_skips_start_settings()
    local menu = defeat_menu_test_owner()
    local model
    local load_settings_calls = 0
    local preference_mutations = 0
    local seed_generations = 0
    local transient_clears = 0
    local promotion_calls = 0
    local bridge_calls = 0
    local handoff_calls = 0
    local fatal_shows = 0
    local fatal_dialog_shows = 0
    local captured_ports
    local recovery_callback
    local recovery_context
    local fatal_dialog = {}
    function fatal_dialog:ShowFatal(errors, callback, context)
        fatal_shows = fatal_shows + 1
        gamma_arena_test_assert.equals(errors[1].error.code, "GA_BOOTSTRAP_COMPOSE_FAILED", "default fatal path retains the preflight failure")
        recovery_callback = callback
        recovery_context = context
    end
    function fatal_dialog:ShowDialog(value) if value then fatal_dialog_shows = fatal_dialog_shows + 1 end end
    function fatal_dialog:HideDialog() end
    function fatal_dialog:Show() end

    local original_create = gamma_arena_ui_start.create
    gamma_arena_ui_start.create = function(owner, ports)
        gamma_arena_test_assert.equals(owner, menu, "default fatal construction retains the stock menu owner")
        captured_ports = ports
        gamma_arena_ui_start.initialize_settings({
            LoadSettings = function()
                load_settings_calls = load_settings_calls + 1
                preference_mutations = preference_mutations + 1
                seed_generations = seed_generations + 1
            end
        }, ports)
        return fatal_dialog
    end

    local displayed = gamma_arena_main_menu.show_confirmed_defeat(menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:default_fatal" }) end,
        show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
        clear_result = function() return gamma_arena_result.ok(true) end,
        clear_transient = function() transient_clears = transient_clears + 1; return gamma_arena_result.ok(true) end,
        runtime_preflight = function() return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "default fatal preflight") end,
        random_session_seed = function() seed_generations = seed_generations + 1; return gamma_arena_result.ok(987654321) end,
        issue_launch_from_defeat = function() promotion_calls = promotion_calls + 1; return gamma_arena_result.ok(true) end,
        write_character_creation = function() bridge_calls = bridge_calls + 1; return gamma_arena_result.ok(true) end,
        handoff_start_game = function() handoff_calls = handoff_calls + 1; return gamma_arena_result.ok(true) end
    })
    local failed = model.on_next()
    local recovered = recovery_callback(recovery_context, fatal_dialog)
    gamma_arena_ui_start.create = original_create
    gamma_arena_ui_start.clear_fatal()

    gamma_arena_test_assert.is_true(displayed.ok, "default fatal path fixture displays")
    gamma_arena_test_assert.is_false(failed.ok, "default fatal path preserves the preflight failure")
    gamma_arena_test_assert.is_true(type(captured_ports) == "table" and captured_ports.fatal_only == true, "default fatal path requests fatal-only construction")
    gamma_arena_test_assert.equals(load_settings_calls, 0, "fatal-only construction never calls LoadSettings")
    gamma_arena_test_assert.equals(preference_mutations, 0, "fatal-only construction never migrates or reconciles preferences")
    gamma_arena_test_assert.equals(seed_generations, 0, "fatal-only construction and failed preflight generate no seed")
    gamma_arena_test_assert.equals(transient_clears, 0, "fatal-only preflight recovery does not clear transient launch state")
    gamma_arena_test_assert.equals(promotion_calls + bridge_calls + handoff_calls, 0, "fatal-only preflight recovery performs no launch, bridge, or handoff mutation")
    gamma_arena_test_assert.equals(fatal_shows, 1, "default fatal path creates one usable fatal screen")
    gamma_arena_test_assert.equals(fatal_dialog_shows, 1, "default fatal path shows its fatal dialog")
    gamma_arena_test_assert.is_true(recovered.ok, "default fatal path recovery succeeds")
    gamma_arena_test_assert.equals(menu.show_dialog, 1, "default fatal path restores the original menu dialog")
    gamma_arena_test_assert.equals(menu.shown, 1, "default fatal path restores original menu visibility")

    local ordinary_load_settings = 0
    gamma_arena_ui_start.initialize_settings({ LoadSettings = function() ordinary_load_settings = ordinary_load_settings + 1 end }, {})
    gamma_arena_test_assert.equals(ordinary_load_settings, 1, "ordinary UI construction still loads settings exactly once")
end

local function runtime_defeat_menu_exit_retries_consumption_safely()
    local menu = defeat_menu_test_owner()
    local model
    local consumes = 0
    local clears = 0
    local result = gamma_arena_main_menu.show_confirmed_defeat(menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:retry" }) end,
        show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
        consume_defeat = function()
            consumes = consumes + 1
            if consumes == 1 then return gamma_arena_result.err("GA_TEST_CONSUME", "retry") end
            return gamma_arena_result.ok(true)
        end,
        clear_result = function() clears = clears + 1; return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_true(result.ok, "retry fixture displays")
    gamma_arena_test_assert.is_false(model.on_main_menu().ok, "failed defeat consumption remains retryable")
    gamma_arena_test_assert.equals(clears, 0, "failed consumption keeps result UI visible")
    gamma_arena_test_assert.is_true(model.on_main_menu().ok, "defeat consumption retry succeeds")
    gamma_arena_test_assert.equals(consumes, 2, "defeat consumption is retried exactly once")
    gamma_arena_test_assert.equals(clears, 1, "successful retry clears result UI once")
end

