local function runtime_bootstrap_actor_ownership_is_id_only_and_fail_closed()
    local equality_calls = 0
    local function poison_game_object_equality()
        equality_calls = equality_calls + 1
        error("bootstrap native game_object equality invoked")
    end
    local function proxy(mode, value)
        local object = {}
        if mode == "method" then
            function object:id() return value end
        elseif mode == "throw" then
            function object:id() error("injected bootstrap actor id failure") end
        elseif mode == "field" then
            object.id = value
        end
        return setmetatable(object, { __eq = poison_game_object_equality })
    end

    local actor = proxy("method", 700)
    local alias = proxy("method", 700)
    gamma_arena_test_assert.is_true(gamma_arena_bootstrap.actor_ownership_matches(alias, actor, true, "l05_bar"), "equal finite numeric ids prove Arena actor ownership")
    gamma_arena_test_assert.is_false(gamma_arena_bootstrap.actor_ownership_matches(alias, actor, false, "l05_bar"), "inactive Arena session fails actor ownership closed")
    gamma_arena_test_assert.is_false(gamma_arena_bootstrap.actor_ownership_matches(alias, actor, true, "jupiter"), "wrong level fails actor ownership closed")
    gamma_arena_test_assert.is_false(gamma_arena_bootstrap.actor_ownership_matches(proxy("method", 701), actor, true, "l05_bar"), "mismatched actor id fails ownership closed")

    local invalid_objects = {
        { label = "missing object", value = nil },
        { label = "missing id method", value = proxy("missing") },
        { label = "numeric id field", value = proxy("field", 700) },
        { label = "throwing id method", value = proxy("throw") },
        { label = "nil id", value = proxy("method", nil) },
        { label = "infinite id", value = proxy("method", math.huge) },
        { label = "negative infinite id", value = proxy("method", -math.huge) },
        { label = "NaN id", value = proxy("method", math.huge - math.huge) },
        { label = "negative id", value = proxy("method", -1) },
        { label = "fractional id", value = proxy("method", 1.5) }
    }
    for _, case in ipairs(invalid_objects) do
        gamma_arena_test_assert.is_false(gamma_arena_bootstrap.actor_ownership_matches(case.value, actor, true, "l05_bar"), case.label .. " candidate fails ownership closed")
        gamma_arena_test_assert.is_false(gamma_arena_bootstrap.actor_ownership_matches(alias, case.value, true, "l05_bar"), case.label .. " current actor fails ownership closed")
    end
    gamma_arena_test_assert.equals(equality_calls, 0, "bootstrap actor ownership never evaluates native equality")
end

local function runtime_actor_inventory_drain_rejects_direct_nil_and_invalid_snapshot_values()
    local actor_id_cases = { { value = nil }, { value = -1 }, { value = 1.5 } }
    for _, case in ipairs(actor_id_cases) do
        local env, adapter = fake_actor_adapter_env()
        env.actor.actor_id = case.value
        adapter:begin_update()
        local result = adapter:purge_inventory(env.actor)
        gamma_arena_test_assert.is_false(result.ok, "invalid public actor id fails closed")
        gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_ID_INVALID", "invalid actor id error code")
        gamma_arena_test_assert.equals(env.release_submission_count, 0, "invalid actor id submits no releases")
    end

    local nil_env, nil_adapter = fake_actor_adapter_env()
    nil_env.inventory_callback_sequence = { [1] = nil }
    nil_env.inventory_callback_count = 1
    nil_adapter:begin_update()
    local nil_result = nil_adapter:purge_inventory(nil_env.actor)
    gamma_arena_test_assert.is_false(nil_result.ok, "explicit nil inventory callback item fails closed")
    gamma_arena_test_assert.equals(nil_result.error.code, "GA_ACTOR_INVENTORY_ITEM_INVALID", "nil callback item code")
    gamma_arena_test_assert.equals(nil_env.release_submission_count, 0, "nil callback item submits no releases")

    local invalid_item_ids = { { value = nil }, { value = -1 }, { value = 1.5 } }
    for _, case in ipairs(invalid_item_ids) do
        local env, adapter = fake_actor_adapter_env()
        env:add_item(case.value)
        adapter:begin_update()
        local result = adapter:purge_inventory(env.actor)
        gamma_arena_test_assert.is_false(result.ok, "invalid item id fails closed")
        gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_INVENTORY_ITEM_INVALID", "invalid item id code")
        gamma_arena_test_assert.equals(env.release_submission_count, 0, "invalid item id submits no releases")
    end

    local invalid_parent_ids = { { value = nil }, { value = -1 }, { value = 1.5 } }
    for _, case in ipairs(invalid_parent_ids) do
        local env, adapter = fake_actor_adapter_env()
        env:add_item(46, { parent = { id = function() return case.value end } })
        adapter:begin_update()
        local result = adapter:purge_inventory(env.actor)
        gamma_arena_test_assert.is_false(result.ok, "invalid parent id fails closed")
        gamma_arena_test_assert.equals(result.error.code, "GA_ACTOR_INVENTORY_OWNER_INVALID", "invalid parent id code")
        gamma_arena_test_assert.equals(env.release_submission_count, 0, "invalid parent id submits no releases")
    end
end

