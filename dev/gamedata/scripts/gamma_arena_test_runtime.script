local function runtime_defeat_menu_post_consume_restore_failure_is_recoverable()
    local menu = defeat_menu_test_owner()
    local original_show_dialog = menu.ShowDialog
    local restore_attempts = 0
    function menu:ShowDialog(value)
        restore_attempts = restore_attempts + 1
        if restore_attempts == 1 then error("injected owner restore failure") end
        return original_show_dialog(self, value)
    end
    local model
    local fatal_calls = 0
    local recovered = false
    local result = gamma_arena_main_menu.show_confirmed_defeat(menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:restore" }) end,
        show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
        consume_defeat = function() return gamma_arena_result.ok(true) end,
        clear_result = function() return gamma_arena_result.ok(true) end,
        show_fatal = function(_, errors, callback, context)
            fatal_calls = fatal_calls + 1
            gamma_arena_test_assert.equals(errors[1].error.code, "GA_MAIN_MENU_RESTORE_FAILED", "post-consume fatal reports restore failure")
            recovered = callback(context, { HideDialog = function() end, Show = function() end }).ok
            return true
        end
    })
    gamma_arena_test_assert.is_true(result.ok, "restore failure fixture displays")
    gamma_arena_test_assert.is_false(model.on_main_menu().ok, "post-consume restore failure remains structured")
    gamma_arena_test_assert.equals(fatal_calls, 1, "post-consume restore failure opens one recovery dialog")
    gamma_arena_test_assert.is_true(recovered, "post-consume restore failure recovery retries owner restoration")
    gamma_arena_test_assert.equals(menu.show_dialog, 1, "restore retry restores the owner dialog")
    gamma_arena_test_assert.equals(menu.shown, 1, "restore retry restores owner visibility")
end

local function runtime_defeat_recovery_dialog_waits_for_owner_restore()
    local menu = defeat_menu_test_owner()
    function menu:ShowDialog() error("injected persistent owner restore failure") end
    local model
    local recovery_result
    local recovery_dialog = { hides = 0, hidden = 0 }
    function recovery_dialog:HideDialog() self.hides = self.hides + 1 end
    function recovery_dialog:Show(value) if not value then self.hidden = self.hidden + 1 end end
    local displayed = gamma_arena_main_menu.show_confirmed_defeat(menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:visible_recovery" }) end,
        show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
        clear_result = function() return gamma_arena_result.ok(true) end,
        clear_transient = function() return gamma_arena_result.ok(true) end,
        random_session_seed = function() return gamma_arena_result.err("GA_TEST_SEED", "seed") end,
        show_fatal = function(_, _, callback, context)
            recovery_result = callback(context, recovery_dialog)
            return recovery_dialog
        end
    })
    gamma_arena_test_assert.is_true(displayed.ok, "persistent recovery fixture displays")
    gamma_arena_test_assert.is_false(model.on_next().ok, "fresh failure remains structured")
    gamma_arena_test_assert.is_false(recovery_result.ok, "failed owner restoration remains retryable")
    gamma_arena_test_assert.equals(recovery_dialog.hides + recovery_dialog.hidden, 0, "failed owner restoration keeps the recovery dialog visible")
end

local function runtime_defeat_partial_clear_never_reconsumes_token()
    local menu = defeat_menu_test_owner()
    local model
    local window
    local consumes = 0
    local result_panel = { visible = true }
    function result_panel:Show(value) self.visible = value end
    local countdown = {}
    function countdown:Show() end
    local displayed = gamma_arena_main_menu.show_confirmed_defeat(menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:partial_clear" }) end,
        show_result = function(value) model = value; return gamma_arena_result.ok(true) end,
        consume_defeat = function() consumes = consumes + 1; return gamma_arena_result.ok(true) end,
        clear_result = function() return gamma_arena_ui_result.dismiss_result_window(window) end
    })
    gamma_arena_test_assert.is_true(displayed.ok, "partial clear fixture displays")
    local dismiss_attempts = 0
    window = {
        action_locked = false,
        kind = "defeat",
        on_next = model.on_next,
        on_main_menu = model.on_main_menu,
        result_panel = result_panel,
        countdown = countdown,
        restored = 0
    }
    function window:HideDialog() end
    function window:ShowDialog(value) if value then self.restored = self.restored + 1 end end
    function window:Show(value)
        dismiss_attempts = dismiss_attempts + 1
        if dismiss_attempts == 1 and not value then error("injected result Show(false) failure") end
    end
    window.ClearOwnedWidgets = gamma_arena_ui_result.UIResult.ClearOwnedWidgets
    gamma_arena_test_assert.is_false(gamma_arena_ui_result.UIResult.OnMainMenu(window).ok, "first partial dismissal remains structured")
    gamma_arena_test_assert.equals(window.kind, "defeat", "failed dismissal retains the result model")
    gamma_arena_test_assert.equals(type(window.on_main_menu), "function", "failed dismissal retains the retry callback")
    gamma_arena_test_assert.is_false(window.action_locked, "failed dismissal leaves the real result action retryable")
    gamma_arena_test_assert.equals(window.restored, 1, "failed dismissal restores the visible result window")
    gamma_arena_test_assert.is_true(gamma_arena_ui_result.UIResult.OnMainMenu(window).ok, "second real Main menu event completes dismissal")
    gamma_arena_test_assert.equals(consumes, 1, "partial result clearing can never replay the consumed defeat token")
    gamma_arena_test_assert.equals(menu.show_dialog, 2, "partial clear retry performs dismissal/restore only")
    gamma_arena_test_assert.equals(menu.shown, 2, "partial clear retry keeps owner visible")
    gamma_arena_test_assert.equals(window.kind, nil, "successful retry clears the result model")
    gamma_arena_test_assert.is_false(result_panel.visible, "successful retry clears the visible result panel")
end

local function runtime_defeat_partial_owned_widget_clear_never_reconsumes_token()
    local menu = defeat_menu_test_owner()
    local consumes = 0
    local constructor_calls = 0
    local countdown_false_calls = 0
    local fail_owned_clear = true
    local countdown = { visible = false }
    function countdown:Show(value)
        self.visible = value
        if value == false then
            countdown_false_calls = countdown_false_calls + 1
            if fail_owned_clear and countdown_false_calls > 1 then
                fail_owned_clear = false
                error("injected real ClearOwnedWidgets failure")
            end
        end
    end
    local result_panel = { visible = false }
    function result_panel:Show(value) self.visible = value end
    local title = { text = nil }
    function title:SetText(value) self.text = value end
    local next_button = { text = nil }
    function next_button:SetText(value) self.text = value end
    local window = {
        action_locked = false,
        kind = nil,
        on_next = nil,
        on_main_menu = nil,
        result_panel = result_panel,
        countdown = countdown,
        title = title,
        next_button = next_button,
        dialog_visible = false,
        visible = false
    }
    function window:HideDialog() self.dialog_visible = false end
    function window:ShowDialog(value) self.dialog_visible = value end
    function window:Show(value) self.visible = value end
    window.ShowResult = gamma_arena_ui_result.UIResult.ShowResult
    window.ClearOwnedWidgets = gamma_arena_ui_result.UIResult.ClearOwnedWidgets
    window.OnMainMenu = gamma_arena_ui_result.UIResult.OnMainMenu

    gamma_arena_ui_result.clear_result()
    local original_constructor = gamma_arena_ui_result.UIResult
    gamma_arena_ui_result.UIResult = function()
        constructor_calls = constructor_calls + 1
        return window
    end
    local displayed
    local first
    local retained_kind
    local retained_callback
    local visible_after_failure
    local retryable_after_failure
    local second
    local ran, reason = pcall(function()
        displayed = gamma_arena_main_menu.show_confirmed_defeat(menu, {
            config = {},
            peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:partial_widgets" }) end,
            show_result = function(value) return gamma_arena_ui_result.show_result(value) end,
            consume_defeat = function() consumes = consumes + 1; return gamma_arena_result.ok(true) end,
            clear_result = function() return gamma_arena_ui_result.clear_result() end
        })
        first = gamma_arena_ui_result.invoke_active_main_menu()
        retained_kind = window.kind
        retained_callback = type(window.on_main_menu)
        visible_after_failure = window.dialog_visible and window.visible and result_panel.visible
        retryable_after_failure = window.action_locked == false
        second = gamma_arena_ui_result.invoke_active_main_menu()
    end)
    gamma_arena_ui_result.UIResult = original_constructor
    if not ran then error(reason) end

    gamma_arena_test_assert.is_true(displayed.ok, "public active-window clear fixture displays")
    gamma_arena_test_assert.is_false(first.ok, "real partial ClearOwnedWidgets failure remains structured")
    gamma_arena_test_assert.equals(constructor_calls, 1, "ClearOwnedWidgets failure retains the module active window")
    gamma_arena_test_assert.equals(retained_kind, "defeat", "ClearOwnedWidgets failure retains the active result kind")
    gamma_arena_test_assert.equals(retained_callback, "function", "ClearOwnedWidgets failure retains the active retry callback")
    gamma_arena_test_assert.is_true(visible_after_failure, "ClearOwnedWidgets failure restores a visible nonblank result")
    gamma_arena_test_assert.is_true(retryable_after_failure, "ClearOwnedWidgets failure leaves the active action unlocked for retry")
    gamma_arena_test_assert.equals(window.kind, nil, "successful second event clears the active result model")
    gamma_arena_test_assert.is_true(second.ok, "second active OnMainMenu event completes recovery")
    gamma_arena_test_assert.equals(consumes, 1, "partial owned-widget clearing never reconsumes defeat")
    gamma_arena_test_assert.equals(menu.show_dialog, 2, "partial owned-widget clear always restores owner")
end

local function runtime_defeat_partial_hide_restores_or_retains_recovery()
    local restored_menu = defeat_menu_test_owner()
    function restored_menu:Show(value)
        if not value then error("injected partial hide failure") end
        self.shown = self.shown + 1
    end
    local restored = gamma_arena_main_menu.show_confirmed_defeat(restored_menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:partial_hide_restore" }) end
    })
    gamma_arena_test_assert.is_false(restored.ok, "partial hide failure remains structured")
    gamma_arena_test_assert.equals(restored_menu.show_dialog, 1, "partial hide immediately restores owner dialog")
    gamma_arena_test_assert.equals(restored_menu.shown, 1, "partial hide immediately restores owner visibility")

    local recovery_menu = defeat_menu_test_owner()
    function recovery_menu:ShowDialog() error("injected partial-hide restore failure") end
    function recovery_menu:Show(value)
        if not value then error("injected partial hide failure") end
        self.shown = self.shown + 1
    end
    local fatal_calls = 0
    local recovery_visible = false
    local retained = gamma_arena_main_menu.show_confirmed_defeat(recovery_menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:partial_hide_recovery" }) end,
        show_fatal = function(_, errors)
            fatal_calls = fatal_calls + 1
            gamma_arena_test_assert.equals(errors[1].error.code, "GA_DEFEAT_MENU_HIDE_FAILED", "partial hide recovery reports original failure")
            recovery_visible = true
            return true
        end
    })
    gamma_arena_test_assert.is_false(retained.ok, "partial hide plus restore failure remains structured")
    gamma_arena_test_assert.equals(fatal_calls, 1, "partial hide plus restore failure opens one recovery surface")
    gamma_arena_test_assert.is_true(recovery_visible, "partial hide plus restore failure retains a visible recovery surface")

    local fallback_menu = defeat_menu_test_owner()
    local restore_attempts = 0
    function fallback_menu:ShowDialog(value)
        restore_attempts = restore_attempts + 1
        if restore_attempts == 1 then error("injected first partial-hide restore failure") end
        if value then self.show_dialog = self.show_dialog + 1 end
    end
    function fallback_menu:Show(value)
        if not value then error("injected partial hide failure") end
        self.shown = self.shown + 1
    end
    local fallback = gamma_arena_main_menu.show_confirmed_defeat(fallback_menu, {
        config = {},
        peek_defeat = function() return gamma_arena_result.ok({ mode_id = "skirmish", difficulty_id = "master", token = "gad1:1000:partial_hide_fatal_throw" }) end,
        show_fatal = function() error("injected fatal recovery construction failure") end
    })
    gamma_arena_test_assert.is_false(fallback.ok, "fatal construction failure preserves the original hide failure")
    gamma_arena_test_assert.equals(restore_attempts, 2, "fatal construction failure retries owner restoration")
    gamma_arena_test_assert.equals(fallback_menu.show_dialog, 1, "fatal construction fallback restores owner dialog")
    gamma_arena_test_assert.equals(fallback_menu.shown, 1, "fatal construction fallback restores owner visibility")
end

local function runtime_defeat_result_keyboard_and_lock_are_behavioral()
    local pressed = ui_events.WINDOW_KEY_PRESSED
    gamma_arena_test_assert.equals(gamma_arena_ui_result.resolve_result_keyboard_action("defeat", DIK_keys.DIK_RETURN, pressed, false), "next", "defeat Enter maps to New fight")
    gamma_arena_test_assert.equals(gamma_arena_ui_result.resolve_result_keyboard_action("defeat", DIK_keys.DIK_SPACE, pressed, false), "next", "defeat Space maps to New fight")
    gamma_arena_test_assert.equals(gamma_arena_ui_result.resolve_result_keyboard_action("defeat", DIK_keys.DIK_ESCAPE, pressed, false), "main_menu", "defeat Escape maps to Main menu")
    gamma_arena_test_assert.equals(gamma_arena_ui_result.resolve_result_keyboard_action("countdown", DIK_keys.DIK_RETURN, pressed, false), nil, "countdown Enter never starts a fight")
    gamma_arena_test_assert.equals(gamma_arena_ui_result.resolve_result_keyboard_action("defeat", DIK_keys.DIK_RETURN, pressed, true), nil, "engine-handled input is not dispatched twice")

    local calls = 0
    local window = {
        action_locked = false,
        kind = "defeat",
        on_next = function() calls = calls + 1; return gamma_arena_result.ok(true) end
    }
    gamma_arena_test_assert.is_true(gamma_arena_ui_result.UIResult.OnNext(window).ok, "first defeat primary action is accepted")
    gamma_arena_test_assert.is_true(gamma_arena_ui_result.UIResult.OnNext(window).ok, "duplicate defeat primary event is safely ignored")
    gamma_arena_test_assert.equals(calls, 1, "repeated defeat primary events dispatch exactly once")
end

local function runtime_result_primary_button_uses_native_text_control()
    local title = { text = nil }
    function title:SetText(value) self.text = value end
    local caption = { text = nil }
    function caption:SetText(value) self.text = value end
    local next_button = {}
    function next_button:TextControl() return caption end
    local countdown = { visible = true }
    function countdown:Show(value) self.visible = value end
    local result_panel = { visible = false }
    function result_panel:Show(value) self.visible = value end
    local window = {
        kind = nil,
        on_next = nil,
        on_main_menu = nil,
        action_locked = true,
        title = title,
        next_button = next_button,
        countdown = countdown,
        result_panel = result_panel
    }
    local shown = gamma_arena_ui_result.UIResult.ShowResult(window, {
        kind = "defeat",
        title_key = "st_gamma_arena_result_defeat",
        next_title_key = "st_gamma_arena_result_new_fight",
        on_next = function() return gamma_arena_result.ok(true) end,
        on_main_menu = function() return gamma_arena_result.ok(true) end
    })
    gamma_arena_test_assert.is_true(shown.ok, "real CUI3tButton caption API displays the defeat result")
    gamma_arena_test_assert.equals(type(caption.text), "string", "primary caption is written through TextControl")
    gamma_arena_test_assert.is_true(result_panel.visible, "result panel becomes visible after caption setup")
end

local function runtime_start_launch_recovers_only_confirmed_defeat_conflict()
    local request = {
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = "master",
        seed_mode = "random",
        session_seed = 123
    }
    local issue_calls = 0
    local peek_calls = 0
    local clear_calls = 0
    local recovered = gamma_arena_ui_start.issue_launch_with_defeat_recovery({}, request, {
        issue_launch = function()
            issue_calls = issue_calls + 1
            if issue_calls == 1 then return gamma_arena_result.err("GA_INTENT_CONFLICT", "Launch and defeat intents cannot coexist") end
            return gamma_arena_result.ok({ token = "ga1:1000:recovered" })
        end,
        peek_defeat = function()
            peek_calls = peek_calls + 1
            return gamma_arena_result.ok({ token = "gad1:1000:stale" })
        end,
        clear_defeat = function()
            clear_calls = clear_calls + 1
            return gamma_arena_result.ok(true)
        end
    })
    gamma_arena_test_assert.is_true(recovered.ok, "explicit Arena start recovers a confirmed defeat conflict")
    gamma_arena_test_assert.equals(issue_calls, 2, "confirmed defeat recovery retries launch exactly once")
    gamma_arena_test_assert.equals(peek_calls, 1, "intent conflict is classified through the defeat store")
    gamma_arena_test_assert.equals(clear_calls, 1, "only the confirmed defeat is cleared")

    local resume_issue_calls = 0
    local resume_clear_calls = 0
    local resume_conflict = gamma_arena_ui_start.issue_launch_with_defeat_recovery({}, request, {
        issue_launch = function()
            resume_issue_calls = resume_issue_calls + 1
            return gamma_arena_result.err("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist")
        end,
        peek_defeat = function() return gamma_arena_result.ok(false) end,
        clear_defeat = function()
            resume_clear_calls = resume_clear_calls + 1
            return gamma_arena_result.ok(true)
        end
    })
    gamma_arena_test_assert.is_false(resume_conflict.ok, "non-defeat intent conflicts remain fail-closed")
    gamma_arena_test_assert.equals(resume_issue_calls, 1, "non-defeat conflict is never retried")
    gamma_arena_test_assert.equals(resume_clear_calls, 0, "resume state is never erased by defeat recovery")
end

local function death_neutralization_fixture(actor)
    local env = { stops = 0, cleared = {}, held = {}, tags = {}, online = {} }
    local tactical = {}
    function tactical:stop() env.stops = env.stops + 1; return gamma_arena_result.ok(true) end
    local deps = {
        tactical = tactical,
        load_tag = function(id) return env.tags[id] end,
        online_object = function(id) return env.online[id] end,
        actor_object = function() return actor end,
        clear_enemy = function(npc) env.cleared[#env.cleared + 1] = npc.runtime_id; return gamma_arena_result.ok(true) end,
        set_actor_hold = function(npc) env.held[#env.held + 1] = npc.runtime_id; return gamma_arena_result.ok(true) end
    }
    local adapter = gamma_arena_entity_adapter.new(deps)
    adapter.session_id = "ga_owned_session"
    adapter.tactical_started = true
    adapter.registry.npcs = {
        { id = 1, released = false },
        { id = 2, released = false },
        { id = 3, released = true },
        { id = 4, released = false }
    }
    env.tags = { [1] = "ga_owned_session", [2] = "ga_owned_session", [3] = "ga_owned_session", [4] = "ambient_session" }
    local function object(id, alive)
        return { runtime_id = id, alive = function() return alive end }
    end
    env.online = { [1] = object(1, true), [2] = object(2, false), [3] = object(3, true), [4] = object(4, true) }
    env.adapter = adapter
    return env
end

local function runtime_entity_death_neutralization_is_owned_living_and_idempotent()
    local env = death_neutralization_fixture({ runtime_id = 99 })
    local first = env.adapter:neutralize_owned_opponents()
    local second = env.adapter:neutralize_owned_opponents()
    gamma_arena_test_assert.is_true(first.ok and second.ok, "owned opponent neutralization is a total idempotent operation")
    gamma_arena_test_assert.equals(table.concat(env.cleared, ","), "1", "only the registered living owned NPC clears its enemy")
    gamma_arena_test_assert.equals(table.concat(env.held, ","), "1", "only the registered living owned NPC receives actor hold")
    gamma_arena_test_assert.equals(env.stops, 1, "tactical stop is idempotent")
    gamma_arena_test_assert.is_true(env.adapter.registry.npcs[1].death_neutralized, "attempted owned living NPC is latched")
    gamma_arena_test_assert.equals(env.adapter.registry.npcs[4].death_neutralized, nil, "foreign-tag ambient NPC record remains untouched")
end

local function runtime_entity_death_neutralization_without_actor_still_clears_enemy()
    local env = death_neutralization_fixture(nil)
    local result = env.adapter:neutralize_owned_opponents()
    gamma_arena_test_assert.is_true(result.ok, "missing dead actor object is benign")
    gamma_arena_test_assert.equals(table.concat(env.cleared, ","), "1", "enemy target clears without an actor object")
    gamma_arena_test_assert.equals(#env.held, 0, "relation calls are skipped without an actor object")
end

local function runtime_entity_death_neutralization_aggregates_every_failure()
    local env = death_neutralization_fixture({ runtime_id = 99 })
    env.adapter.registry.npcs = {
        { id = 1, released = false }, { id = 2, released = false }, { id = 3, released = false },
        { id = 4, released = false }, { id = 5, released = false }
    }
    env.tags = { [1] = "ga_owned_session", [2] = "ga_owned_session", [3] = "ga_owned_session", [4] = "ga_owned_session", [5] = "ga_owned_session" }
    env.adapter.deps.load_tag = function(id)
        if id == 2 then return gamma_arena_result.err("GA_TEST_TAG", "tag failure") end
        return env.tags[id]
    end
    local function living(id) return { runtime_id = id, alive = function() return true end } end
    env.adapter.deps.online_object = function(id)
        if id == 3 then return gamma_arena_result.err("GA_TEST_ONLINE", "online failure") end
        if id == 4 then return { runtime_id = id, alive = function() error("alive failure") end } end
        return living(id)
    end
    env.adapter.deps.tactical.stop = function() return gamma_arena_result.err("GA_TEST_STOP", "stop failure") end
    env.adapter.deps.clear_enemy = function(npc)
        env.cleared[#env.cleared + 1] = npc.runtime_id
        if npc.runtime_id == 1 then return gamma_arena_result.err("GA_TEST_CLEAR", "clear failure") end
        return gamma_arena_result.ok(true)
    end
    env.adapter.deps.set_actor_hold = function(npc)
        env.held[#env.held + 1] = npc.runtime_id
        if npc.runtime_id == 1 then return gamma_arena_result.err("GA_TEST_HOLD", "hold failure") end
        return gamma_arena_result.ok(true)
    end
    local result = env.adapter:neutralize_owned_opponents()
    gamma_arena_test_assert.is_false(result.ok, "neutralization reports aggregate failure only after all records")
    gamma_arena_test_assert.equals(result.error.code, "GA_ENTITY_DEATH_NEUTRALIZE_FAILED", "aggregate failure code is stable")
    gamma_arena_test_assert.equals(#result.error.context.errors, 6, "stop, tag, online, alive, clear, and hold failures are all retained")
    gamma_arena_test_assert.equals(table.concat(env.cleared, ","), "1,5", "later owned living records are attempted after earlier failures")
    gamma_arena_test_assert.equals(table.concat(env.held, ","), "1,5", "relation attempts continue independently of clear failures")
end

local function runtime_task9_countdown_escape_model_routes_main_menu_cleanup()
    local env = task8_environment(); task8_pump_to_countdown(env)
    local model = env.countdown_models[1]
    gamma_arena_test_assert.is_true(type(model) == "table" and model.value == 3, "countdown seam receives a structured model")
    gamma_arena_test_assert.is_true(type(model.on_main_menu) == "function", "countdown model exposes the common Arena main-menu action")
    local requested = model.on_main_menu()
    gamma_arena_test_assert.is_true(requested.ok, "countdown Escape action enters ordinary Arena main-menu cleanup")
    gamma_arena_test_assert.equals(env.clear_intent, 1, "countdown Escape clears only the matching Arena intent")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "CLEANING", "countdown Escape never silently closes the shared window")
    gamma_arena_test_assert.is_false(env.orchestrator:is_active(), "countdown Escape deactivates Arena before disconnect")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.disconnected, 1, "countdown Escape disconnects only after common cleanup proof")

    local failed = task8_environment({ clear_countdown_error = true }); task8_pump_to_countdown(failed)
    local routed = failed.countdown_models[1].on_main_menu()
    gamma_arena_test_assert.is_false(routed.ok, "countdown Escape cleanup failure remains observable")
    gamma_arena_test_assert.equals(failed.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "countdown Escape cleanup errors route through the common fatal boundary")
    gamma_arena_test_assert.equals(failed.fatal_shown, 1, "countdown Escape cleanup error opens fatal UI once")
end

local function runtime_task9_resume_failures_normalize_to_restore_failed()
    local function resume_environment()
        local session = valid_session()
        local store = fake_store({ launch_pending = false, resume_pending = true })
        store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
        local deps = fake_orchestrator_deps(store)
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:load_state({ gamma_arena_session = session })
        orchestrator:on_game_load()
        return orchestrator, deps, store
    end
    local function assert_restore_failure(result, cause_code, label)
        gamma_arena_test_assert.is_false(result.ok, label .. " enters fatal routing")
        gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_RESTORE_FAILED", label .. " exposes one top-level recovery contract")
        gamma_arena_test_assert.equals(result.error.context.cause.code, cause_code, label .. " preserves its exact cause code")
    end

    local missing, missing_deps = resume_environment()
    missing.loaded_session = nil
    assert_restore_failure(missing:actor_on_first_update(), "GA_RESUME_SESSION_MISSING", "missing embedded session")

    local preparation, preparation_deps, preparation_store = resume_environment()
    preparation_store.resume_result = gamma_arena_result.err("GA_RESUME_NONCE_MISMATCH", "injected preparation mismatch")
    assert_restore_failure(preparation:actor_on_first_update(), "GA_RESUME_NONCE_MISMATCH", "prepared intent mismatch")

    local malformed, malformed_deps, malformed_store = resume_environment()
    malformed_store.resume_result = gamma_arena_result.ok("not-an-intent")
    assert_restore_failure(malformed:actor_on_first_update(), "GA_RESUME_INVALID", "malformed prepared intent")

    local binding, binding_deps = resume_environment()
    binding_deps.checkpoint.begin_resume_recovery = function() return gamma_arena_result.err("GA_CHECKPOINT_RECOVERY_MISSING", "injected checkpoint binding failure") end
    assert_restore_failure(binding:actor_on_first_update(), "GA_CHECKPOINT_RECOVERY_MISSING", "checkpoint binding failure")

    local refused, refused_deps = resume_environment()
    refused_deps.checkpoint.begin_resume_recovery = function() return gamma_arena_result.ok(false) end
    assert_restore_failure(refused:actor_on_first_update(), "GA_CHECKPOINT_RECOVERY_FAILED", "checkpoint binding refusal")

    local missing_resume, missing_resume_deps = resume_environment()
    missing_resume_deps.checkpoint.take_resume = function() return gamma_arena_result.err("GA_CHECKPOINT_RESUME_MISSING", "injected missing resume") end
    gamma_arena_test_assert.is_true(missing_resume:actor_on_first_update().ok, "missing resume fixture enters re-hide")
    missing_resume:actor_on_update()
    assert_restore_failure(missing_resume:actor_on_update(), "GA_CHECKPOINT_RESUME_MISSING", "missing completed resume")

    local mismatched, mismatched_deps = resume_environment()
    mismatched_deps.checkpoint.take_resume = function() return gamma_arena_result.ok({ next_fight_index = 99 }) end
    gamma_arena_test_assert.is_true(mismatched:actor_on_first_update().ok, "mismatch fixture enters re-hide")
    mismatched:actor_on_update()
    assert_restore_failure(mismatched:actor_on_update(), "GA_CHECKPOINT_RECOVERY_MISMATCH", "completed resume mismatch")
end

local function runtime_task9_resume_pending_invalid_loaded_session_normalizes()
    local invalid_payload = { schema_version = 99 }
    local resume_store = fake_store({ launch_pending = false, resume_pending = true })
    local resume_orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(resume_store))
    local decoded = resume_orchestrator:load_state({ gamma_arena_session = invalid_payload })
    gamma_arena_test_assert.is_false(decoded.ok, "malformed loaded ArenaSession is captured before activation")
    gamma_arena_test_assert.equals(decoded.error.code, "GA_SESSION_SCHEMA_INVALID", "malformed fixture has the exact validation cause")
    resume_orchestrator:on_game_load()
    local resume_failed = resume_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(resume_failed.ok, "pending ResumeIntent rejects malformed loaded ArenaSession")
    gamma_arena_test_assert.equals(resume_failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "pending resume exposes the stable checkpoint recovery boundary")
    gamma_arena_test_assert.equals(resume_failed.error.context.cause.code, "GA_SESSION_SCHEMA_INVALID", "pending resume preserves the loaded-session validation cause")

    local launch_store = fake_store({ launch_pending = true, resume_pending = false })
    local launch_orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(launch_store))
    launch_orchestrator:load_state({ gamma_arena_session = invalid_payload })
    launch_orchestrator:on_game_load()
    local launch_failed = launch_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(launch_failed.ok, "ordinary launch still rejects malformed loaded metadata")
    gamma_arena_test_assert.equals(launch_failed.error.code, "GA_SESSION_SCHEMA_INVALID", "non-resume activation retains its original validation code")
end

local function runtime_task9_restoring_state_read_failure_normalizes()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "RESTORING fault fixture activates a pending resume")
    orchestrator.runtime_stage = "RESTORING"
    deps.checkpoint.current = "LOADING"
    deps.checkpoint.state = function() error("injected RESTORING state read failure") end
    local failed = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "RESTORING state-read exception remains observable")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "RESTORING state-read exception uses the stable recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_CHECKPOINT_STATE_FAILED", "RESTORING state-read exception preserves its exact cause")
end

local function runtime_task9_resume_completion_transition_failure_normalizes()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "transition fault fixture enters resume re-hide")
    local original_advance = orchestrator.advance
    orchestrator.advance = function(self, event)
        if self.runtime_stage == "RESUME_REHIDING" and event == gamma_arena_state_machine.events.CHECKPOINT_SUCCEEDED then
            return gamma_arena_result.err("GA_TEST_RESUME_TRANSITION", "injected resume completion transition failure")
        end
        return original_advance(self, event)
    end
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "first re-hide poll remains pending")
    local failed = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "resume completion transition failure remains observable")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "resume completion transition uses the stable recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_TEST_RESUME_TRANSITION", "resume completion transition preserves its exact cause")
end

