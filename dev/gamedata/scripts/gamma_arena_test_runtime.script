    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "WOUNDED_PENDING", "critical wound first enters grace")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "wound grace cannot end the fight early")
