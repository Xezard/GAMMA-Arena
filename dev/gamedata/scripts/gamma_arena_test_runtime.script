    gamma_arena_test_assert.is_true(mdata.gamma_arena_session ~= orchestrator:session_snapshot(), "save payload must not alias orchestrator state")
    mdata.gamma_arena_session.fight_index = 99
    gamma_arena_test_assert.equals(orchestrator:session_snapshot().fight_index, 0, "saved payload mutation must not affect runtime")
    gamma_arena_test_assert.equals(mdata.gamma_arena_session.fight_spec, nil, "FightSpec must never be serialized")
end

local function load_rejects_unknown_session_keys_and_userdata()
    local unknown = valid_session()
    unknown.future_field = true
    local orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(fake_store({ resume_pending = true, launch_pending = false })))
    local result = orchestrator:load_state({ gamma_arena_session = unknown })
    gamma_arena_test_assert.is_false(result.ok, "unknown ArenaSession fields must fail closed")
    gamma_arena_test_assert.equals(result.error.code, "GA_SESSION_UNKNOWN_FIELD", "unknown key code")
    local bad = valid_session()
    bad.session_id = coroutine.create(function() end)
    result = orchestrator:load_state({ gamma_arena_session = bad })
    gamma_arena_test_assert.is_false(result.ok, "non-plain values must fail")
    local hostile = setmetatable({}, { __index = function() error("hostile save metadata") end })
    local call_ok, hostile_result = pcall(orchestrator.load_state, orchestrator, hostile)
    gamma_arena_test_assert.is_true(call_ok, "load_state must be total for hostile metadata")
    gamma_arena_test_assert.is_false(hostile_result.ok, "hostile metadata must return a Result error")
end

