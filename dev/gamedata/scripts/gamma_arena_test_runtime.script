    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "wound grace cannot end the fight early")
    env:advance(1500); gamma_arena_test_assert.is_true(adapter:update().ok, "stable critical wound becomes terminal")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "DEFEATED_WOUNDED", "stable critical wound is authoritative defeat")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 0, "terminal wounded opponent no longer blocks victory")
    gamma_arena_test_assert.equals(#env.tactical_death_slots, 1, "terminal transition notifies tactical ownership once")
