    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "missing opponent can never satisfy the victory count")
end

local function equal_plain_values(first, second)
    if type(first) ~= type(second) then return false end
    if type(first) ~= "table" then return first == second end
    for key, value in pairs(first) do
        if not equal_plain_values(value, second[key]) then return false end
    end
    for key in pairs(second) do
        if first[key] == nil then return false end
    end
    return true
end

local function runtime_entity_early_self_death_is_integrity()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-self-death-integrity"); pump_entity(adapter, env)
    local victim_id = adapter:registry_snapshot().npcs[1].id
    env.online[victim_id].position_value = { x = 5, y = 6, z = 15 }
    local victim = { id = function() return victim_id end }
    local accepted = adapter:on_npc_death(victim, victim)
    gamma_arena_test_assert.is_true(accepted.ok and accepted.value, "registered self-death remains authoritative death evidence")
    local fault = adapter:integrity_status()
    gamma_arena_test_assert.is_true(fault.ok and type(fault.value) == "table", "early self-death also marks the round corrupted")
    gamma_arena_test_assert.equals(fault.value.cause, "early_self_death", "self-death cause is stable")
    gamma_arena_test_assert.equals(env.warning_records[#env.warning_records - 1].code, "GA_EARLY_SELF_DEATH_DIAGNOSTIC", "self-death diagnostic is emitted before integrity evidence")
    gamma_arena_test_assert.equals(env.warning_records[#env.warning_records].code, "GA_FIGHT_INTEGRITY_FAILED", "integrity warning follows its self-death diagnostic")
    local diagnostic = env.warnings_by_code.GA_EARLY_SELF_DEATH_DIAGNOSTIC.context
    gamma_arena_test_assert.equals(diagnostic.session_id, "session-self-death-integrity", "diagnostic preserves session identity")
    gamma_arena_test_assert.equals(diagnostic.fight_key, "stable:ga-entity-test", "diagnostic preserves exact FightSpec key")
    gamma_arena_test_assert.equals(diagnostic.opponent_id, victim_id, "diagnostic preserves opponent identity")
    gamma_arena_test_assert.equals(diagnostic.killer_id, victim_id, "diagnostic preserves killer identity")
    gamma_arena_test_assert.equals(diagnostic.slot, 1, "diagnostic preserves participant slot")
    gamma_arena_test_assert.equals(diagnostic.elapsed_ms, 0, "diagnostic preserves elapsed self-death time")
    gamma_arena_test_assert.equals(diagnostic.window_ms, 20000, "diagnostic preserves the early self-death window")
    gamma_arena_test_assert.equals(diagnostic.profile.section, "gamma_arena_bandit_novice", "diagnostic preserves profile section")
    gamma_arena_test_assert.equals(diagnostic.profile.community, "bandit", "diagnostic preserves community")
    gamma_arena_test_assert.equals(diagnostic.profile.tactical_route, "opponent_1", "diagnostic preserves tactical route")
    gamma_arena_test_assert.equals(diagnostic.profile.role, "leader", "diagnostic preserves role")
    gamma_arena_test_assert.equals(diagnostic.loadout.weapon, "wpn_pm", "diagnostic preserves weapon")
    gamma_arena_test_assert.equals(diagnostic.loadout.ammo, "ammo_9x18_fmj", "diagnostic preserves base ammo")
    gamma_arena_test_assert.equals(diagnostic.loadout.ammo_boxes, 3, "diagnostic preserves base ammo boxes")
    gamma_arena_test_assert.equals(diagnostic.loadout.outfit, "novice_outfit", "diagnostic preserves outfit")
    gamma_arena_test_assert.equals(diagnostic.loadout.knife, "wpn_knife", "diagnostic preserves knife")
    gamma_arena_test_assert.equals(diagnostic.spawn_position.x, 2, "diagnostic preserves spawn x")
    gamma_arena_test_assert.equals(diagnostic.spawn_position.y, 2, "diagnostic preserves spawn y")
    gamma_arena_test_assert.equals(diagnostic.spawn_position.z, 3, "diagnostic preserves spawn z")
    gamma_arena_test_assert.equals(diagnostic.queries.server_object.status, "ok", "diagnostic records server query status")
    gamma_arena_test_assert.equals(diagnostic.queries.online_object.status, "ok", "diagnostic records online query status")
    gamma_arena_test_assert.equals(diagnostic.queries.owner_tag.status, "ok", "diagnostic records owner-tag query status")
    gamma_arena_test_assert.equals(diagnostic.queries.position.status, "ok", "diagnostic records position query status")
    gamma_arena_test_assert.equals(diagnostic.queries.alive.status, "ok", "diagnostic records alive query status")
    gamma_arena_test_assert.equals(diagnostic.queries.critically_wounded.status, "ok", "diagnostic records wound query status")
    gamma_arena_test_assert.is_true(diagnostic.server_available, "diagnostic records available server entity")
    gamma_arena_test_assert.is_true(diagnostic.online_available, "diagnostic records available online object")
    gamma_arena_test_assert.equals(diagnostic.observed_position.x, 5, "diagnostic preserves observed x")
    gamma_arena_test_assert.equals(diagnostic.observed_position.y, 6, "diagnostic preserves observed y")
    gamma_arena_test_assert.equals(diagnostic.observed_position.z, 15, "diagnostic preserves observed z")
    gamma_arena_test_assert.equals(diagnostic.delta_x, 3, "diagnostic calculates signed x displacement")
    gamma_arena_test_assert.equals(diagnostic.delta_y, 4, "diagnostic calculates signed y displacement")
    gamma_arena_test_assert.equals(diagnostic.delta_z, 12, "diagnostic calculates signed z displacement")
    gamma_arena_test_assert.equals(diagnostic.displacement, 13, "diagnostic calculates stable Euclidean displacement")
    gamma_arena_test_assert.is_true(equal_plain_values(fault.value.context.diagnostic, diagnostic), "integrity context receives the emitted diagnostic by value")
    gamma_arena_test_assert.is_false(adapter:on_npc_death(victim, victim).value, "duplicate callback remains ignored")
    gamma_arena_test_assert.equals(#env.warning_records, 2, "duplicate callback emits no second diagnostic")
end

local function runtime_entity_early_self_death_diagnostic_failures_do_not_suppress_integrity()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-self-death-diagnostic-failures"); pump_entity(adapter, env)
    local victim_id = adapter:registry_snapshot().npcs[1].id
    local owner_reads = 0
    deps.server_entity = function() error("injected diagnostic server failure") end
    deps.online_object = function() return gamma_arena_result.err("GA_TEST_DIAGNOSTIC_ONLINE", "injected diagnostic online failure", { source = "online" }) end
    deps.load_tag = function()
        owner_reads = owner_reads + 1
        if owner_reads == 1 then return "session-self-death-diagnostic-failures" end
        error("injected diagnostic owner failure")
    end
    deps.object_position = function() error("injected diagnostic position failure") end
    deps.is_alive = function() error("injected diagnostic alive failure") end
    deps.is_critically_wounded = function() error("injected diagnostic wound failure") end
    local logger_calls = 0
    deps.log_warn = function(code)
        logger_calls = logger_calls + 1
        if code == "GA_EARLY_SELF_DEATH_DIAGNOSTIC" then error("injected diagnostic logger failure") end
        env.warning_records[#env.warning_records + 1] = { code = code }
    end
    local victim = { id = function() return victim_id end }
    local accepted = adapter:on_npc_death(victim, victim)
    gamma_arena_test_assert.is_true(accepted.ok and accepted.value, "diagnostic dependency failures do not suppress accepted death")
    local fault = adapter:integrity_status()
    gamma_arena_test_assert.equals(fault.value.cause, "early_self_death", "diagnostic dependency failures preserve integrity cause")
    local diagnostic = fault.value.context.diagnostic
    gamma_arena_test_assert.equals(diagnostic.queries.server_object.status, "error", "throwing server diagnostic query is recorded")
    gamma_arena_test_assert.equals(diagnostic.queries.online_object.status, "error", "throwing online diagnostic query is recorded")
    gamma_arena_test_assert.equals(diagnostic.queries.owner_tag.status, "error", "throwing diagnostic owner reread is recorded")
    gamma_arena_test_assert.is_true(string.find(diagnostic.queries.server_object.reason, "injected diagnostic server failure", 1, true) ~= nil, "throwing server diagnostic reason is copied")
    gamma_arena_test_assert.equals(diagnostic.queries.online_object.error.code, "GA_TEST_DIAGNOSTIC_ONLINE", "failed online diagnostic error code is copied")
    gamma_arena_test_assert.equals(diagnostic.queries.online_object.error.context.source, "online", "failed online diagnostic error context is copied")
    gamma_arena_test_assert.equals(diagnostic.queries.owner_tag.error.code, "GA_ENTITY_TAG_READ_FAILED", "throwing owner diagnostic wrapper code is copied")
    gamma_arena_test_assert.is_true(string.find(diagnostic.queries.owner_tag.error.context.reason, "injected diagnostic owner failure", 1, true) ~= nil, "throwing owner diagnostic wrapper reason is copied")
    gamma_arena_test_assert.equals(diagnostic.queries.position.status, "unavailable", "position is explicitly unavailable without an online object")
    gamma_arena_test_assert.equals(diagnostic.queries.alive.status, "unavailable", "alive is explicitly unavailable without an online object")
    gamma_arena_test_assert.equals(diagnostic.queries.critically_wounded.status, "unavailable", "wound state is explicitly unavailable without an online object")
    gamma_arena_test_assert.equals(diagnostic.queries.position.reason, "online_object_unavailable", "failed online lookup does not falsely claim absent online object")
    gamma_arena_test_assert.equals(logger_calls, 2, "throwing diagnostic logger does not suppress integrity logger")

    local nil_env, nil_deps = fake_entity_environment()
    local nil_adapter = gamma_arena_entity_adapter.new(nil_deps)
    begin_entity_apply(nil_adapter, nil_env, entity_spec(1), "session-self-death-diagnostic-nil"); pump_entity(nil_adapter, nil_env)
    local nil_victim_id = nil_adapter:registry_snapshot().npcs[1].id
    nil_deps.server_entity = function() return nil end
    nil_deps.online_object = function() return nil end
    local nil_victim = { id = function() return nil_victim_id end }
    gamma_arena_test_assert.is_true(nil_adapter:on_npc_death(nil_victim, nil_victim).value, "nil availability still accepts authoritative death")
    local nil_diagnostic = nil_adapter:integrity_status().value.context.diagnostic
    gamma_arena_test_assert.is_false(nil_diagnostic.server_available, "nil server lookup records unavailable server")
    gamma_arena_test_assert.is_false(nil_diagnostic.online_available, "nil online lookup records unavailable object")
    gamma_arena_test_assert.equals(nil_diagnostic.queries.server_object.status, "ok", "nil server lookup remains a successful query")
    gamma_arena_test_assert.equals(nil_diagnostic.queries.online_object.status, "ok", "nil online lookup remains a successful query")
    gamma_arena_test_assert.equals(nil_diagnostic.queries.position.reason, "online_object_absent", "nil online lookup explains unavailable position")

    for _, case in ipairs({
        { name = "position", dependency = "object_position", query = "position", expect = "reason", inject = function() error("injected diagnostic position failure") end },
        { name = "alive", dependency = "is_alive", query = "alive", expect = "error", code = "GA_TEST_DIAGNOSTIC_ALIVE", inject = function() return gamma_arena_result.err("GA_TEST_DIAGNOSTIC_ALIVE", "injected diagnostic alive failure", { source = "alive" }) end },
        { name = "wound", dependency = "is_critically_wounded", query = "critically_wounded", expect = "error", code = "GA_ENTITY_WOUND_CHECK_FAILED", inject = function() error("injected diagnostic wound failure") end }
    }) do
        local query_env, query_deps = fake_entity_environment()
        local query_adapter = gamma_arena_entity_adapter.new(query_deps)
        begin_entity_apply(query_adapter, query_env, entity_spec(1), "session-self-death-diagnostic-" .. case.name); pump_entity(query_adapter, query_env)
        local query_id = query_adapter:registry_snapshot().npcs[1].id
        query_deps[case.dependency] = case.inject
        local query_victim = { id = function() return query_id end }
        gamma_arena_test_assert.is_true(query_adapter:on_npc_death(query_victim, query_victim).value, "throwing " .. case.name .. " diagnostic dependency still accepts death")
        local query_diagnostic = query_adapter:integrity_status().value.context.diagnostic
        gamma_arena_test_assert.equals(query_diagnostic.queries[case.query].status, "error", "throwing " .. case.name .. " diagnostic dependency is recorded")
        if case.expect == "reason" then
            gamma_arena_test_assert.is_true(string.find(query_diagnostic.queries[case.query].reason, "injected diagnostic " .. case.name .. " failure", 1, true) ~= nil, "throwing " .. case.name .. " diagnostic reason is copied")
        else
            gamma_arena_test_assert.equals(query_diagnostic.queries[case.query].error.code, case.code, "failed " .. case.name .. " diagnostic error code is copied")
            if case.name == "alive" then
                gamma_arena_test_assert.equals(query_diagnostic.queries[case.query].error.context.source, "alive", "failed alive diagnostic error context is copied")
            else
                gamma_arena_test_assert.is_true(string.find(query_diagnostic.queries[case.query].error.context.reason, "injected diagnostic wound failure", 1, true) ~= nil, "throwing wound diagnostic wrapper reason is copied")
            end
        end
        gamma_arena_test_assert.equals(query_adapter:integrity_status().value.cause, "early_self_death", "throwing " .. case.name .. " diagnostic dependency preserves integrity")
    end

    local builder_env, builder_deps = fake_entity_environment()
    local builder_adapter = gamma_arena_entity_adapter.new(builder_deps)
    begin_entity_apply(builder_adapter, builder_env, entity_spec(1), "session-self-death-diagnostic-builder"); pump_entity(builder_adapter, builder_env)
    local builder_id = builder_adapter:registry_snapshot().npcs[1].id
    builder_deps.early_self_death_diagnostic_builder = function() error("injected diagnostic builder failure") end
    local builder_victim = { id = function() return builder_id end }
    gamma_arena_test_assert.is_true(builder_adapter:on_npc_death(builder_victim, builder_victim).value, "throwing diagnostic builder still accepts death")
    local builder_fault = builder_adapter:integrity_status().value
    local builder_diagnostic = builder_env.warnings_by_code.GA_EARLY_SELF_DEATH_DIAGNOSTIC.context
    gamma_arena_test_assert.equals(builder_diagnostic.status, "error", "throwing diagnostic builder emits a plain fallback snapshot")
    gamma_arena_test_assert.is_true(string.find(builder_diagnostic.reason, "injected diagnostic builder failure", 1, true) ~= nil, "throwing diagnostic builder fallback preserves reason")
    gamma_arena_test_assert.equals(builder_env.warning_records[#builder_env.warning_records - 1].code, "GA_EARLY_SELF_DEATH_DIAGNOSTIC", "builder failure diagnostic still precedes integrity evidence")
    gamma_arena_test_assert.equals(builder_env.warning_records[#builder_env.warning_records].code, "GA_FIGHT_INTEGRITY_FAILED", "builder failure still emits following integrity evidence")
    gamma_arena_test_assert.equals(#builder_env.warning_records, 2, "builder failure emits exactly one diagnostic and one integrity event")
    gamma_arena_test_assert.is_true(equal_plain_values(builder_fault.context.diagnostic, builder_diagnostic), "builder failure attaches the emitted fallback snapshot by value")

    for _, case in ipairs({
        { name = "nil", build = function() return nil end, reason = "Diagnostic builder must return a plain table" },
        { name = "cyclic", build = function() local value = {}; value.self = value; return value end, reason = "cyclic registry value" },
        { name = "function_leaf", build = function() return { leaf = function() end } end, reason = "non-plain registry value: function" }
    }) do
        local invalid_env, invalid_deps = fake_entity_environment()
        local invalid_adapter = gamma_arena_entity_adapter.new(invalid_deps)
        begin_entity_apply(invalid_adapter, invalid_env, entity_spec(1), "session-self-death-diagnostic-invalid-" .. case.name); pump_entity(invalid_adapter, invalid_env)
        local invalid_id = invalid_adapter:registry_snapshot().npcs[1].id
        invalid_deps.early_self_death_diagnostic_builder = case.build
        local invalid_victim = { id = function() return invalid_id end }
        gamma_arena_test_assert.is_true(invalid_adapter:on_npc_death(invalid_victim, invalid_victim).value, "invalid successful diagnostic builder return still accepts death: " .. case.name)
        local invalid_fault = invalid_adapter:integrity_status()
        gamma_arena_test_assert.equals(invalid_fault.value.cause, "early_self_death", "invalid successful diagnostic builder return preserves integrity cause: " .. case.name)
        local invalid_diagnostic = invalid_env.warnings_by_code.GA_EARLY_SELF_DEATH_DIAGNOSTIC.context
        gamma_arena_test_assert.equals(invalid_diagnostic.status, "error", "invalid successful diagnostic builder return emits plain fallback: " .. case.name)
        gamma_arena_test_assert.is_true(string.find(invalid_diagnostic.reason, case.reason, 1, true) ~= nil, "invalid successful diagnostic builder fallback preserves reason: " .. case.name)
        gamma_arena_test_assert.equals(invalid_env.warning_records[#invalid_env.warning_records - 1].code, "GA_EARLY_SELF_DEATH_DIAGNOSTIC", "invalid successful builder fallback precedes integrity evidence: " .. case.name)
        gamma_arena_test_assert.equals(invalid_env.warning_records[#invalid_env.warning_records].code, "GA_FIGHT_INTEGRITY_FAILED", "invalid successful builder fallback emits following integrity evidence: " .. case.name)
        gamma_arena_test_assert.equals(#invalid_env.warning_records, 2, "invalid successful builder fallback emits exactly one diagnostic and integrity event: " .. case.name)
        gamma_arena_test_assert.is_true(equal_plain_values(invalid_fault.value.context.diagnostic, invalid_diagnostic), "invalid successful builder fallback attaches emitted snapshot by value: " .. case.name)
    end

    local extreme_env, extreme_deps = fake_entity_environment()
    local extreme_adapter = gamma_arena_entity_adapter.new(extreme_deps)
    begin_entity_apply(extreme_adapter, extreme_env, entity_spec(1), "session-self-death-diagnostic-extreme"); pump_entity(extreme_adapter, extreme_env)
    local extreme_id = extreme_adapter:registry_snapshot().npcs[1].id
    extreme_adapter.npc_by_id[extreme_id].spawn_position = { x = -1e308, y = -1e308, z = -1e308 }
    extreme_env.online[extreme_id].position_value = { x = 1e308, y = 1e308, z = 1e308 }
    local extreme_victim = { id = function() return extreme_id end }
    gamma_arena_test_assert.is_true(extreme_adapter:on_npc_death(extreme_victim, extreme_victim).value, "extreme finite coordinates still accept death")
    local extreme_diagnostic = extreme_adapter:integrity_status().value.context.diagnostic
    gamma_arena_test_assert.equals(extreme_diagnostic.delta_x, nil, "overflowing x delta is omitted")
    gamma_arena_test_assert.equals(extreme_diagnostic.delta_y, nil, "overflowing y delta is omitted")
    gamma_arena_test_assert.equals(extreme_diagnostic.delta_z, nil, "overflowing z delta is omitted")
    gamma_arena_test_assert.equals(extreme_diagnostic.displacement, nil, "overflowing displacement is omitted")

    local existing_env, existing_deps = fake_entity_environment()
    local existing_adapter = gamma_arena_entity_adapter.new(existing_deps)
    begin_entity_apply(existing_adapter, existing_env, entity_spec(1), "session-self-death-diagnostic-existing"); pump_entity(existing_adapter, existing_env)
    local existing_id = existing_adapter:registry_snapshot().npcs[1].id
    local existing_record = existing_adapter.npc_by_id[existing_id]
    gamma_arena_test_assert.is_true(existing_adapter:declare_integrity_fault(existing_record, "vertical_escape", { evidence = "preexisting" }).value, "fixture latches a pre-existing integrity fault")
    local existing_victim = { id = function() return existing_id end }
    gamma_arena_test_assert.is_true(existing_adapter:on_npc_death(existing_victim, existing_victim).value, "pre-existing integrity state does not suppress authoritative death")
    gamma_arena_test_assert.equals(#existing_env.warning_records, 1, "pre-existing integrity state suppresses an orphan self-death diagnostic")
    gamma_arena_test_assert.equals(existing_env.warning_records[1].code, "GA_FIGHT_INTEGRITY_FAILED", "only the already-attached integrity event remains")
    gamma_arena_test_assert.equals(existing_adapter:integrity_status().value.cause, "vertical_escape", "pre-existing integrity cause remains authoritative")

    local function ignored_callback_fixture(session_id)
        local ignored_env, ignored_deps = fake_entity_environment()
        local ignored_adapter = gamma_arena_entity_adapter.new(ignored_deps)
        begin_entity_apply(ignored_adapter, ignored_env, entity_spec(1), session_id); pump_entity(ignored_adapter, ignored_env)
        local ignored_id = ignored_adapter:registry_snapshot().npcs[1].id
        return ignored_env, ignored_adapter, ignored_id, { id = function() return ignored_id end }
    end
    local nonself_env, nonself_adapter, nonself_id, nonself = ignored_callback_fixture("session-self-death-diagnostic-nonself")
    gamma_arena_test_assert.is_true(nonself_adapter:on_npc_death(nonself, { id = function() return nonself_id + 1 end }).value, "non-self death remains authoritative")
    gamma_arena_test_assert.equals(#nonself_env.warning_records, 0, "non-self callback emits no diagnostic warning")
    local late_env, late_adapter, _, late = ignored_callback_fixture("session-self-death-diagnostic-late")
    late_env:advance(20001)
    gamma_arena_test_assert.is_true(late_adapter:on_npc_death(late, late).value, "late self-death remains accepted")
    gamma_arena_test_assert.equals(#late_env.warning_records, 0, "late self-death emits no diagnostic warning")
    local unregistered_env, unregistered_adapter = ignored_callback_fixture("session-self-death-diagnostic-unregistered")
    gamma_arena_test_assert.is_false(unregistered_adapter:on_npc_death(999999, 999999).value, "unregistered self-death emits no diagnostic")
    gamma_arena_test_assert.equals(#unregistered_env.warning_records, 0, "unregistered callback emits no diagnostic warning")
    local mismatch_env, mismatch_adapter, mismatch_id, mismatch = ignored_callback_fixture("session-self-death-diagnostic-mismatch")
    mismatch_env.tags[mismatch_id] = "foreign-session"
    gamma_arena_test_assert.is_false(mismatch_adapter:on_npc_death(mismatch, mismatch).value, "mismatched-owner self-death emits no diagnostic")
    gamma_arena_test_assert.equals(#mismatch_env.warning_records, 0, "mismatched-owner callback emits no diagnostic warning")
    local inactive_env, inactive_adapter, _, inactive = ignored_callback_fixture("session-self-death-diagnostic-inactive")
    inactive_adapter:cleanup(); pump_entity(inactive_adapter, inactive_env)
    gamma_arena_test_assert.is_false(inactive_adapter:on_npc_death(inactive, inactive).value, "inactive self-death emits no diagnostic")
    gamma_arena_test_assert.equals(#inactive_env.warning_records, 0, "inactive callback emits no diagnostic warning")
end

local function runtime_entity_terminal_grace_is_wrap_safe_and_logs_transitions_only()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-terminal-wrap"); pump_entity(adapter, env)
    local victim = adapter:registry_snapshot().npcs[1]
    env.now = 4294967000
    env.online[victim.id].critical_value = true
    adapter:update()
    gamma_arena_test_assert.equals(#env.terminal_transitions, 1, "pending transition logs once")
    gamma_arena_test_assert.equals(env.terminal_transitions[1].fight_key, nil, "routine transition omits the complete FightSpec")
    gamma_arena_test_assert.equals(env.terminal_transitions[1].session_id, "session-terminal-wrap", "compact transition retains session identity")
    gamma_arena_test_assert.equals(env.terminal_transitions[1].slot, 1, "compact transition retains participant slot")
    env.now = (env.now + 1500) % 4294967296
    adapter:update()
    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "DEFEATED_WOUNDED", "wound grace survives uint32 wrap")
    gamma_arena_test_assert.equals(#env.terminal_transitions, 2, "terminal transition logs once")
    env:advance(250); adapter:update()
    gamma_arena_test_assert.equals(#env.terminal_transitions, 2, "duplicate terminal evidence emits no diagnostic")
end

local function runtime_entity_numeric_death_requires_test_injection()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-number-death"); pump_entity(adapter, env)
    local id = adapter:registry_snapshot().npcs[1].id
    gamma_arena_test_assert.is_true(adapter:on_npc_death(id).value, "Task 8 orchestrator-normalized numeric victim id is accepted")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 0, "registered normalized victim id can complete victory")
end

local function runtime_entity_release_is_async_and_never_direct()
    local env, deps = fake_entity_environment({ release_delay = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-async"); pump_entity(adapter, env)
    adapter:cleanup(); adapter:update()
    gamma_arena_test_assert.is_true(adapter:registry_snapshot().state == "CLEANING", "safe release waits until the entity is truly absent")
    pump_entity(adapter, env)
    gamma_arena_test_assert.equals(#env.direct_releases, 0, "standalone stalkers never use direct alife release")
end

local function runtime_entity_release_timeout_is_wrap_safe()
    local env, deps = fake_entity_environment({ now = 4294967293, release_never_finishes = true, release_timeout_ms = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-wrap"); pump_entity(adapter, env)
    adapter:cleanup(); local result, snapshot = pump_entity(adapter, env, 50)
    gamma_arena_test_assert.is_false(result.ok, "never-finished release times out")
    gamma_arena_test_assert.equals(snapshot.error.code, "GA_ENTITY_CLEANUP_FAILED", "wrap-safe timeout is aggregated into cleanup failure")
end

local function runtime_entity_max_cardinality_cleanup_fits_default_budget()
    local env, deps = fake_entity_environment({ multi_return_ammo = true, release_delay = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(6), "session-max-cleanup")
    local applied, active = pump_entity(adapter, env, 500)
    gamma_arena_test_assert.is_true(applied.ok and active.state == "ACTIVE", "six-opponent maximum-cardinality fixture becomes active")
    gamma_arena_test_assert.equals(#active.npcs + #active.items, 42, "maximum fixture tracks six NPCs and thirty-six assigned item entities including split ammo")
    local context, result = {}, nil
    for _ = 1, 256 do
        result = gamma_arena_bootstrap.step_entity_cleanup(adapter, context, {
            clock = function() return env.now end,
            timeout_ms = 10000,
            max_updates = 256
        })
        gamma_arena_test_assert.is_true(result.ok, "maximum-cardinality deferred cleanup remains within the hard cap")
        if result.value.pending ~= true then break end
        env:advance(1)
    end
    gamma_arena_test_assert.is_true(result.ok and result.value.pending == false, "maximum-cardinality deferred cleanup completes within the default entity budget")
    gamma_arena_test_assert.is_true(context.updates > 64 and context.updates <= 256, "coverage proves the legacy shared 64-update default was insufficient but the entity cap is bounded")
end

local function runtime_entity_relations_friend_first_then_actor_hostile()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(2), "session-relations"); local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "relations complete before ACTIVE")
    local first_friend, first_hidden_clear, first_hostile = nil, nil, nil
    for index, event in ipairs(env.events) do
        if first_friend == nil and string.find(event, "^friend:") then first_friend = index end
        if first_hidden_clear == nil and string.find(event, "^hidden_charge:") then first_hidden_clear = index end
        if first_hostile == nil and string.find(event, "^hostile:") then first_hostile = index end
        if string.find(event, "^hostile:") then gamma_arena_test_assert.is_true(string.find(event, ":-5000$") ~= nil, "actor goodwill is exactly -5000") end
    end
    gamma_arena_test_assert.is_true(first_friend ~= nil and first_hostile ~= nil and first_friend < first_hostile, "all NPC friendship is established before actor hostility")
    gamma_arena_test_assert.is_true(first_hidden_clear ~= nil and first_hidden_clear < first_hostile, "stock hidden healing charges are cleared before hostility activates combat")
    gamma_arena_test_assert.equals(env.hidden_charge_clears, 2, "every registered opponent clears its hidden healing charge once before ACTIVE")
end

local function runtime_entity_tactical_begin_precedes_hostility()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(2), "session-tactical-order")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "tactical bind completes before ACTIVE")
    local first_friend, tactical_begin, first_hostile = nil, nil, nil
    for index, event in ipairs(env.events) do
        if first_friend == nil and string.find(event, "^friend:") then first_friend = index end
        if tactical_begin == nil and event == "tactical_begin" then tactical_begin = index end
        if first_hostile == nil and string.find(event, "^hostile:") then first_hostile = index end
    end
    gamma_arena_test_assert.is_true(first_friend < tactical_begin and tactical_begin < first_hostile, "friendship then tactical bind then hostility is exact")
    gamma_arena_test_assert.equals(env.tactical_context.fight_key, "stable:ga-entity-test", "tactical fight key is the validated stable encoding")
    gamma_arena_test_assert.equals(env.tactical_context.opponents[1].slot, 1, "tactical context retains stable participant slot")
    gamma_arena_test_assert.equals(env.tactical_context.opponents[1].spawn_path, "opponent_1", "tactical context retains validated spawn route")
    gamma_arena_test_assert.equals(#env.tactical_context.routes, 6, "tactical context exposes every validated Arena search route")
    gamma_arena_test_assert.equals(env.tactical_context.routes[6], "opponent_6", "unused Arena routes remain available for broad search")
end

local function runtime_entity_tactical_bind_failure_rolls_back()
    local env, deps = fake_entity_environment({ fail_phase = "tactical_begin" })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-tactical-bind-fail")
    local result, snapshot = pump_entity(adapter, env, 300)
    gamma_arena_test_assert.is_false(result.ok, "tactical bind failure remains observable after rollback")
    gamma_arena_test_assert.equals(snapshot.state, "ERROR", "tactical bind failure reaches transactional ERROR")
    gamma_arena_test_assert.equals(env.hostile_calls, 0, "failed tactical bind never exposes hostility")
    gamma_arena_test_assert.is_true(#env.release_requests > 0, "failed tactical bind releases Arena-owned entities")
end

local function runtime_entity_tactical_active_failure_is_fail_soft_once()
    local env, deps = fake_entity_environment({ fail_phase = "tactical_update" })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-tactical-runtime-fail")
    local active, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(active.ok and snapshot.state == "ACTIVE", "fixture reaches ACTIVE before tactical runtime failure")
    local first = adapter:update()
    local second = adapter:update()
    gamma_arena_test_assert.is_true(first.ok and second.ok, "tactical runtime failure keeps combat playable")
    gamma_arena_test_assert.equals(first.value.state, "ACTIVE", "fail-soft result remains ACTIVE")
    gamma_arena_test_assert.is_true(first.value.tactical_disabled, "fail-soft result reports tactical disable")
    gamma_arena_test_assert.equals(env.tactical_update_calls, 1, "disabled tactical runtime is never retried")
    gamma_arena_test_assert.equals(#env.tactical_warnings, 1, "tactical runtime failure logs exactly once")
    gamma_arena_test_assert.equals(env.tactical_warnings[1], "GA_DIRECTOR_RUNTIME_DISABLED", "fail-soft warning code is stable")
end

local function runtime_entity_tactical_death_and_stop_are_ordered()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-tactical-death")
    pump_entity(adapter, env)
    local victim_id = adapter:registry_snapshot().npcs[1].id
    gamma_arena_test_assert.is_true(adapter:on_npc_death({ id = function() return victim_id end }).value, "registered death is accepted")
    gamma_arena_test_assert.equals(env.tactical_death_slots[1], 1, "tactical death notification uses stable participant slot")
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "tactical cleanup begins")
    local stop_index, release_index = nil, nil
    for index, event in ipairs(env.events) do
        if event == "tactical_stop" then stop_index = stop_index or index end
        if string.find(event, "^release:") then release_index = release_index or index end
    end
    gamma_arena_test_assert.equals(env.tactical_stop_calls, 1, "tactical stop runs exactly once")
    gamma_arena_test_assert.is_true(stop_index ~= nil and release_index == nil, "tactical stop completes before cleanup may submit a release")
    adapter:update()
    for index, event in ipairs(env.events) do if release_index == nil and string.find(event, "^release:") then release_index = index end end
    gamma_arena_test_assert.is_true(release_index == nil or stop_index < release_index, "tactical stop precedes the first release")
end

local function runtime_entity_tactical_stop_failure_is_retried_before_release()
    local env, deps = fake_entity_environment({ tactical_stop_failures = 1 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-tactical-stop-retry")
    pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "cleanup owns a transient tactical stop failure")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "STOPPING", "failed stop enters a retryable teardown state")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "entity release cannot start before tactical stop succeeds")
    gamma_arena_test_assert.is_true(adapter:update().ok, "next update retries tactical stop")
    gamma_arena_test_assert.equals(env.tactical_stop_calls, 2, "transient tactical stop is retried")
    gamma_arena_test_assert.is_true(#env.release_requests > 0, "release begins only after the retry succeeds")
end

local function runtime_entity_activation_does_not_wait_for_precombat_active_item()
    local env, deps = fake_entity_environment({ equip_never = true, online_timeout_ms = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-ai-equip")
    local result, snapshot = pump_entity(adapter, env, 100)
    gamma_arena_test_assert.is_true(result.ok, "validated inventory reaches combat without a pre-combat active item")
    gamma_arena_test_assert.equals(snapshot.state, "ACTIVE", "AI weapon selection begins only after atomic hostility activation")
    gamma_arena_test_assert.equals(env.equip_attempts[100], nil, "adapter does not force actor-style item activation on an NPC")
    local hostile = false
    for _, event in ipairs(env.events) do
        if string.find(event, "^hostile:100:") then hostile = true end
    end
    gamma_arena_test_assert.is_true(hostile, "validated NPC becomes hostile so engine combat AI can select its weapon")
end

local function runtime_entity_callbacks_fail_closed()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-callback"); pump_entity(adapter, env)
    local victim = { id = function() error("injected victim id failure") end }
    local called, result = pcall(function() return adapter:on_npc_death(victim) end)
    gamma_arena_test_assert.is_true(called and result.ok, "death callback protects the engine and fails closed")
    gamma_arena_test_assert.is_false(result.value, "throwing victim accessor is ignored")
end

local function runtime_validator_rejects_effective_nonhuman_profile()
    local snapshot_result = gamma_arena_catalog.load(gamma_arena_test_generator.fixture_factory())
    gamma_arena_test_assert.is_true(snapshot_result.ok, "validator fixture catalog loads")
    local resolved_layout = gamma_arena_test_generator.fixture_resolved_layout(snapshot_result.value)
    local generated = gamma_arena_generator.generate({ session_seed = 7, mode_id = "skirmish", difficulty_id = "rookie", layout_id = "rostok_arena_v1" }, 0, snapshot_result.value, resolved_layout)
    gamma_arena_test_assert.is_true(generated.ok, "validator fixture fight generates")
    local rejected = gamma_arena_validator.validate_runtime(generated.value, snapshot_result.value, resolved_layout, {
        effective_profile = function() return { class = "SM_BLOODSUCKER", community = "monster" } end
    })
    gamma_arena_test_assert.is_false(rejected.ok, "effective mutant class cannot pass runtime validation")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_ENEMY_EFFECTIVE_CLASS_INVALID", "effective human class code")
end

local function runtime_entity_runtime_profile_check_precedes_actor_mutation()
    local env, deps = fake_entity_environment({ effective_profile = { class = "SM_BLOODSUCKER", community = "monster" } })
    local adapter = gamma_arena_entity_adapter.new(deps)
    local result = adapter:begin_apply(entity_spec(1), "session-profile-reject")
    gamma_arena_test_assert.is_false(result.ok, "entity application requires fail-closed effective profile validation")
    gamma_arena_test_assert.equals(result.error.code, "GA_ENEMY_EFFECTIVE_CLASS_INVALID", "entity application preserves effective class code")
    gamma_arena_test_assert.equals(env.actor_loadout_calls, 0, "effective profile rejection precedes actor mutation")
    gamma_arena_test_assert.equals(env.create_npc_count, 0, "effective profile rejection precedes NPC creation")
end

local function runtime_entity_preserves_dynamic_opponent_community()
    local spec = entity_spec(1)
    local opponents = spec.opponents()
    opponents[1].profile = "gamma_arena_csky_experienced"
    opponents[1].community = "csky"
    local _, deps = fake_entity_environment({ effective_profile = { class = "AI_STL_S", community = "arena_enemy" } })
    local adapter = gamma_arena_entity_adapter.new(deps)
    local result = adapter:begin_apply(spec, "session-dynamic-community")
    gamma_arena_test_assert.is_true(result.ok, "source faction metadata remains valid while the effective profile is isolated")
end

local function runtime_orchestrator_living_count_fails_closed()
    local deps = fake_orchestrator_deps(fake_store())
    local orchestrator = gamma_arena_orchestrator.new(deps)
    local missing = orchestrator:living_opponent_count()
    gamma_arena_test_assert.is_false(missing.ok, "missing entity adapter cannot look like zero living opponents")
    gamma_arena_test_assert.equals(missing.error.code, "GA_ENTITY_COUNT_UNAVAILABLE", "missing count dependency code")
    deps.entities = {
        registry_snapshot = function() return { state = "ACTIVE" } end,
        living_opponent_count = function() error("injected count failure") end
    }
    local throwing = gamma_arena_orchestrator.new(deps):living_opponent_count()
    gamma_arena_test_assert.is_false(throwing.ok, "throwing count cannot look like victory")
    deps.entities = { registry_snapshot = function() return { state = "COUNTDOWN" } end, living_opponent_count = function() return 0 end }
    local inactive = gamma_arena_orchestrator.new(deps):living_opponent_count()
    gamma_arena_test_assert.is_false(inactive.ok, "zero count before entity ACTIVE cannot look like victory")
    gamma_arena_test_assert.equals(inactive.error.code, "GA_ENTITY_COUNT_STATE_INVALID", "pre-ACTIVE count state code")
    deps.entities = { registry_snapshot = function() return { state = "ACTIVE" } end, living_opponent_count = function() return 0 end }
    local exact = gamma_arena_orchestrator.new(deps):living_opponent_count()
    gamma_arena_test_assert.is_true(exact.ok and exact.value == 0, "only exact ACTIVE zero is a valid future victory signal")
end

local function task8_validated_spec(index, session_seed)
    local private = {
        session_seed = session_seed or 42,
        fight_index = index,
        fight_id = "ga-task8-" .. tostring(index),
        actor = { loadout = { weapon = "wpn_test", ammo = "ammo_test", ammo_boxes = 1, bonus_ammo = { section = "ammo_bonus_test", requested_category = "standard", resolved_category = "standard", boxes = 1 }, outfit = "outfit_test", knife = "knife_test", consumables = { "medkit_test" }, grenades = {}, cost = 4 } },
        opponents = { { slot = 1, profile = "gamma_arena_bandit_novice", spawn_path = "spawn_test", loadout = { weapon = "wpn_test", ammo = "ammo_test", ammo_boxes = 1, outfit = "outfit_test", consumables = { "medkit_test" }, grenades = {}, cost = 4 } } }
    }
    return {
        session_seed = function() return private.session_seed end,
        fight_index = function() return private.fight_index end,
        fight_id = function() return private.fight_id end,
        actor = function() return clone(private.actor) end,
        opponents = function() return clone(private.opponents) end,
        stable_encode = function() return "stable:" .. private.fight_id end
    }
end

local function task8_environment(options)
    options = options or {}
    local env = {
        now = 100,
        generated = 0,
        validated = 0,
        applied = 0,
        released_input = 0,
        acquired_input = 0,
        reset_actor = 0,
        cleanup_calls = 0,
        checkpoint_cleanup = 0,
        checkpoint_create = 0,
        clear_intent = 0,
        disconnected = 0,
        fatal_shown = 0,
        living = 0,
        next_id = 1000,
        registry = { state = "CLEAN", session_id = nil, npcs = {}, items = {}, error = nil },
        logs = {},
        events = {},
        countdown = {},
        countdown_models = {},
        victory_dialogs = {},
        defeat_dialogs = {},
        result_visible = false,
        restore_calls = 0,
        actor_loadout_owned = false,
        actor_loadout_cleanup = 0,
        inventory_pending = options.inventory_pending == true,
        inventory_verify_calls = 0,
        integrity_fault = nil,
        npc_medical_starts = 0,
        npc_medical_updates = 0,
        npc_medical_stops = 0,
        npc_medical_stop_reasons = {},
        battle_identity_models = {},
        battle_identity_clears = 0,
        audio_calls = {},
        boundary_calls = 0,
        ordered_calls = {},
        entity_stage_updates = 0
    }
    local actor = {
        begin_update = function() return gamma_arena_result.ok(true) end,
        normalize_for_arena = function() return gamma_arena_result.ok(true) end,
        verify_inventory_empty = function()
            env.inventory_verify_calls = env.inventory_verify_calls + 1
            return gamma_arena_result.ok(not env.inventory_pending)
        end,
        acquire_input = function() env.acquired_input = env.acquired_input + 1; return gamma_arena_result.ok(true) end,
        release_input = function() env.released_input = env.released_input + 1; return gamma_arena_result.ok(true) end,
        begin_rematch_boundary = function()
            env.boundary_calls = env.boundary_calls + 1
            env.ordered_calls[#env.ordered_calls + 1] = "boundary"
            if options.boundary_error then return gamma_arena_result.err("GA_ACTOR_INPUT_DISABLE_FAILED", "injected rematch boundary failure") end
            env.acquired_input = env.acquired_input + 1
            return gamma_arena_result.ok(true)
        end,
        cleanup_loadout_for_restore = function()
            env.actor_loadout_cleanup = env.actor_loadout_cleanup + 1
            env.events[#env.events + 1] = "actor_cleanup"
            env.actor_loadout_owned = false
            return gamma_arena_result.ok(true)
        end,
        reset_for_rematch = function()
            env.reset_actor = env.reset_actor + 1
            env.actor_loadout_owned = false
            return gamma_arena_result.ok(true)
        end,
        cleanup = function() return gamma_arena_result.ok(true) end
    }
    local entities = {}
    function entities:begin_apply(spec, session_id)
        if env.actor_loadout_owned then return gamma_arena_result.err("GA_ACTOR_LOADOUT_BUSY", "stale actor loadout ownership") end
        env.actor_loadout_owned = true
        env.events[#env.events + 1] = "apply"
        env.applied = env.applied + 1
        env.living = #spec.opponents()
        env.integrity_fault = nil
        local initial_state = (options.entity_ready_delay or 0) > 0 and "WAIT_ONLINE" or "READY"
        env.registry = {
            state = initial_state,
            session_id = session_id,
            npcs = {},
            items = {},
            error = nil,
            actor_loadout = { ready = true, weapon = "wpn_test", knife = "knife_test", outfit = "outfit_test", magazine_rounds = 30, reserve_rounds = 30 }
        }
        for index = 1, env.living do
            env.next_id = env.next_id + 1
            env.registry.npcs[index] = { id = env.next_id, dead = false, released = false }
        end
        env.next_id = env.next_id + 1
        env.registry.items[1] = { id = env.next_id, released = false }
        return gamma_arena_result.ok({ state = initial_state })
    end
    function entities:update()
        if env.registry.state == "WAIT_ONLINE" then
            env.entity_stage_updates = env.entity_stage_updates + 1
            if env.entity_stage_updates >= (options.entity_ready_delay or 0) then env.registry.state = "READY" end
        end
        if env.registry.state == "READY" and env.orchestrator:is_opponent_activation_allowed() then
            if options.activation_error then return gamma_arena_result.err("GA_TEST_ACTIVATION", "injected activation failure") end
            env.registry.state = "ACTIVE"
        end
        if env.registry.state == "CLEANING" then env.registry = { state = "CLEAN", session_id = nil, npcs = {}, items = {}, error = nil } end
        return gamma_arena_result.ok({ state = env.registry.state })
    end
    function entities:on_npc_death(victim_or_id)
        if options.death_error then return gamma_arena_result.err("GA_TEST_DEATH", "injected death processing failure") end
        if env.registry.state ~= "ACTIVE" then return gamma_arena_result.ok(false) end
        local id = victim_or_id
        if type(victim_or_id) == "table" and type(victim_or_id.id) == "function" then id = victim_or_id:id() end
        for _, record in ipairs(env.registry.npcs) do
            if record.id == id and not record.dead then record.dead = true; env.living = env.living - 1; return gamma_arena_result.ok(true) end
        end
        return gamma_arena_result.ok(false)
    end
    function entities:living_opponent_count() return env.living end
    function entities:integrity_status() return gamma_arena_result.ok(env.integrity_fault or false) end
    function entities:cleanup()
        env.events[#env.events + 1] = "cleanup"
        env.cleanup_calls = env.cleanup_calls + 1
        env.registry.state = "CLEANING"
        return gamma_arena_result.ok(true)
    end
    function entities:registry_snapshot() return clone(env.registry) end
    local npc_medical = {}
    function npc_medical:start(fight)
        self.active = true
        env.npc_medical_starts = env.npc_medical_starts + 1
        env.npc_medical_fight_id = fight.fight_id
        return gamma_arena_result.ok(true)
    end
    function npc_medical:update()
        env.npc_medical_updates = env.npc_medical_updates + 1
        return gamma_arena_result.ok(true)
    end
    function npc_medical:stop(reason)
        if not self.active then return gamma_arena_result.ok(false) end
        self.active = false
        env.npc_medical_stops = env.npc_medical_stops + 1
        env.npc_medical_stop_reasons[#env.npc_medical_stop_reasons + 1] = reason
        return gamma_arena_result.ok(true)
    end
    local audio = {}
    local function audio_call(method_name, context)
        env.audio_calls[#env.audio_calls + 1] = { method = method_name, context = clone(context or {}) }
        env.events[#env.events + 1] = "audio:" .. method_name
        if options.audio_error == true or options.audio_error == method_name then
            return gamma_arena_result.err("GA_TEST_AUDIO", "injected audio failure", { method = method_name })
        end
        return gamma_arena_result.ok(true)
    end
    function audio:begin_fight(context) return audio_call("begin_fight", context) end
    function audio:update(context) return audio_call("update", context) end
    function audio:opponent_defeated(context) return audio_call("opponent_defeated", context) end
    function audio:victory(context) return audio_call("victory", context) end
    function audio:defeat(context) return audio_call("defeat", context) end
    function audio:stop_all(context) return audio_call("stop_all", context) end
    local store
    local checkpoint = { current = "READY" }
    function checkpoint:create() env.checkpoint_create = env.checkpoint_create + 1; return gamma_arena_result.ok(true) end
    function checkpoint:update()
        if self.current == "UNHIDING" then
            env.events[#env.events + 1] = "load"
            env.orchestrator:expect_checkpoint_reload()
            self.current = "LOADING"
        elseif self.current == "REHIDING" then
            self.current = "READY"
            self.completed_resume = clone(self.prepared_resume)
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    function checkpoint:state() return self.current end
    function checkpoint:cleanup() env.checkpoint_cleanup = env.checkpoint_cleanup + 1; self.current = "NONE"; return gamma_arena_result.ok(true) end
    function checkpoint:on_game_load()
        if self.current ~= "LOADING" then return gamma_arena_result.ok(false) end
        self.current = "REHIDING"
        return gamma_arena_result.ok(true)
    end
    function checkpoint:begin_resume_recovery(_, prepared)
        if self.current ~= "REHIDING" then return gamma_arena_result.err("GA_TEST_REHIDE", "checkpoint is not re-hiding") end
        self.prepared_resume = clone(prepared)
        return gamma_arena_result.ok(true)
    end
    function checkpoint:take_resume() return gamma_arena_result.ok(clone(self.completed_resume)) end
    function checkpoint:restore(_, next_fight_index)
        env.events[#env.events + 1] = "intent"
        env.restore_calls = env.restore_calls + 1
        env.restore_next_fight_index = next_fight_index
        if options.restore_error then return gamma_arena_result.err("GA_TEST_RESTORE", "injected restore failure") end
        local session = env.orchestrator:session_snapshot()
        local intent = { schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = next_fight_index, checkpoint_name = session.checkpoint_name }
        local issued = store:issue_resume({}, intent)
        if not issued.ok then return issued end
        self.current = "UNHIDING"
        return gamma_arena_result.ok(true)
    end
    local result_ui = {}
    function result_ui:show_countdown(model)
        env.countdown_models[#env.countdown_models + 1] = model
        env.countdown[#env.countdown + 1] = tostring(model.value)
        return gamma_arena_result.ok(true)
    end
    function result_ui:clear_countdown()
        if options.clear_countdown_error then return gamma_arena_result.err("GA_TEST_COUNTDOWN_CLEAR", "injected countdown clear failure") end
        env.countdown[#env.countdown + 1] = "clear"
        return gamma_arena_result.ok(true)
    end
    function result_ui:show_victory(model)
        env.victory_dialogs[#env.victory_dialogs + 1] = model
        env.result_visible = true
        return gamma_arena_result.ok(true)
    end
    function result_ui:show_result(model)
        if model.kind == "victory" then
            env.victory_dialogs[#env.victory_dialogs + 1] = model
        elseif model.kind == "defeat" then
            env.defeat_dialogs[#env.defeat_dialogs + 1] = model
        end
        env.result_visible = true
        return gamma_arena_result.ok(true)
    end
    function result_ui:clear_result()
        if options.clear_result_error then return gamma_arena_result.err("GA_TEST_RESULT_CLEAR", "injected result clear failure") end
        env.ordered_calls[#env.ordered_calls + 1] = "clear_result"
        env.events[#env.events + 1] = "clear_ui"
        env.result_visible = false
        return gamma_arena_result.ok(true)
    end
    local battle_ui = {}
    function battle_ui:show_identity(model)
        env.battle_identity_models[#env.battle_identity_models + 1] = clone(model)
        if options.battle_ui_show_error then
            return gamma_arena_result.err("GA_TEST_BATTLE_UI_SHOW", "injected battle identity show failure")
        end
        return gamma_arena_result.ok(true)
    end
    function battle_ui:clear_identity()
        env.battle_identity_clears = env.battle_identity_clears + 1
        if options.battle_ui_clear_error then
            return gamma_arena_result.err("GA_TEST_BATTLE_UI_CLEAR", "injected battle identity clear failure")
        end
        return gamma_arena_result.ok(true)
    end
    store = fake_store()
    function store:clear_resume_if_matches()
        env.clear_intent = env.clear_intent + 1
        if options.clear_intent_error then return gamma_arena_result.err("GA_TEST_INTENT_CLEAR", "injected intent clear failure") end
        self.intent_state.launch_pending = false
        self.intent_state.resume_pending = false
        return gamma_arena_result.ok(true)
    end
    local deps = {
        store = store,
        config = {},
        reconcile = function() return gamma_arena_result.ok({ events = {} }) end,
        preflight = function() return gamma_arena_result.ok(true) end,
        identity = function() return gamma_arena_result.ok({ session_id = "ga_task8_session", session_nonce = "ga_task8_nonce" }) end,
        ui = { show_fatal = function(errors, callback) env.fatal_shown = env.fatal_shown + 1; return { errors = errors, callback = callback } end },
        notify = function() end,
        disconnect = function()
            env.disconnected = env.disconnected + 1
            if env.disconnected <= (options.disconnect_failures or 0) then return false end
            return true
        end,
        teardown = function(_, preserve)
            if preserve == true then return gamma_arena_result.ok(true) end
            env.teardown_calls = (env.teardown_calls or 0) + 1
            if options.teardown_pending_then_error and env.teardown_calls == 1 then return gamma_arena_result.ok({ pending = true }) end
            if options.teardown_error or (options.teardown_pending_then_error and env.teardown_calls >= 2) then
                return gamma_arena_result.err("GA_TEST_TEARDOWN", "injected teardown failure")
            end
            entities:cleanup(); entities:update(); checkpoint:cleanup()
            return gamma_arena_result.ok(true)
        end,
        actor = actor,
        entities = entities,
        npc_medical = npc_medical,
        audio = audio,
        checkpoint = checkpoint,
        layout = function() return gamma_arena_result.ok({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" }) end,
        mode_policy = gamma_arena_mode_skirmish,
        catalogs = function()
            env.events[#env.events + 1] = "catalogs"
            return gamma_arena_result.ok({
                revision = 1,
                weapons = { wpn_test = { section="wpn_test", kind="w_rifle", slot=2, ammo="ammo_test" } }
            })
        end,
        generator = function(_, index)
            env.events[#env.events + 1] = "generate"
            env.generated = env.generated + 1
            if options.generator_error then return gamma_arena_result.err("GA_TEST_GENERATOR", "injected generator failure") end
            return gamma_arena_result.ok({ fight_index = index })
        end,
        validator = function(spec)
            env.events[#env.events + 1] = "validate"
            env.validated = env.validated + 1
            if options.validator_error then return gamma_arena_result.err("GA_TEST_VALIDATOR", "injected validator failure") end
            return gamma_arena_result.ok(task8_validated_spec(spec.fight_index, options.fight_spec_seed))
        end,
        weapon_diagnostics = function(context)
            env.events[#env.events + 1] = "weapon_diagnostic"
            return gamma_arena_result.ok({
                session_id = context.session_id,
                fight_index = context.fight_index,
                fight_id = context.fight_id,
                phase = context.phase,
                actor_id = 77,
                item_id = "unavailable",
                weapon_section = context.weapon_section,
                weapon_kind = "w_rifle",
                weapon_slot = "2",
                ammo_section = context.ammo_section,
                ammo_class = "ammo_test",
                parent_section = "unavailable",
                world_visual = "dynamics\\weapons\\wpn_test\\wpn_test_world.ogf",
                hud_section = "wpn_test_hud",
                hud_item_visual = "dynamics\\weapons\\wpn_test\\wpn_test_hud.ogf",
                hud_anm_show = "test_draw",
                hud_anm_idle = "test_idle",
                hud_anm_idle_empty = "test_idle_empty",
                hud_anm_hide = "test_holster"
            })
        end,
        clock = function() return env.now end,
        result_ui = result_ui,
        battle_ui = battle_ui,
        log = { info = function(code, message, context)
            env.events[#env.events + 1] = "log"
            env.logs[#env.logs + 1] = { code = code, message = message, context = context }
            return gamma_arena_result.ok(true)
        end }
    }
    env.deps = deps
    env.orchestrator = gamma_arena_orchestrator.new(deps)
    env.orchestrator.active = true
    env.orchestrator.session = valid_session()
    env.orchestrator.session.session_id = "ga_task8_session"
    env.orchestrator.runtime_stage = "PREPARING"
    env.orchestrator.machine_state = gamma_arena_state_machine.states.PREPARING
    return env
end

local function task8_pump_to_countdown(env)
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "PREPARING creates one immutable validated spec")
    for _ = 1, 8 do
        if env.orchestrator:runtime_stage_snapshot() == "COUNTDOWN" then break end
        gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "fully staged READY opens countdown")
    end
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "COUNTDOWN", "preparation reaches COUNTDOWN")
end

local function task8_pump_to_active(env)
    task8_pump_to_countdown(env)
    env.now = env.now + 3000
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "countdown deadline activates entities in the same update")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "ACTIVE", "fight becomes ACTIVE")
end

local function runtime_battle_identity_lifecycle_is_active_only()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    gamma_arena_test_assert.equals(#env.battle_identity_models, 0, "battle identity stays hidden during countdown")
    env.now = env.now + 3000
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "battle identity fixture activates in one update")
    gamma_arena_test_assert.equals(#env.battle_identity_models, 1, "active fight shows one battle identity")
    gamma_arena_test_assert.equals(env.battle_identity_models[1].session_seed, 42, "validated seed is forwarded")
    gamma_arena_test_assert.equals(env.battle_identity_models[1].fight_index, 0, "zero-based fight index is forwarded")
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end })
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "victory clears battle identity without blocking result")
    gamma_arena_test_assert.equals(env.battle_identity_clears, 1, "victory clears battle identity once")
    gamma_arena_test_assert.equals(#env.victory_dialogs, 1, "victory dialog remains available")
end

local function runtime_battle_identity_failures_are_classified()
    local function has_log_code(env, code)
        for _, record in ipairs(env.logs) do
            if record.code == code then return true end
        end
        return false
    end
    local show = task8_environment({ battle_ui_show_error = true })
    task8_pump_to_active(show)
    gamma_arena_test_assert.equals(show.orchestrator:runtime_stage_snapshot(), "ACTIVE", "battle HUD show failure cannot stop combat")
    gamma_arena_test_assert.is_true(has_log_code(show, "GA_BATTLE_UI_SHOW_FAILED"), "battle HUD show failure is classified")

    local clear = task8_environment({ battle_ui_clear_error = true })
    task8_pump_to_active(clear)
    clear.orchestrator:npc_on_death_callback({ id = function() return clear.registry.npcs[1].id end })
    gamma_arena_test_assert.is_true(clear.orchestrator:actor_on_update().ok, "battle HUD clear failure cannot stop victory")
    gamma_arena_test_assert.equals(clear.orchestrator:runtime_stage_snapshot(), "RESULT", "battle HUD clear failure retains result state")
    gamma_arena_test_assert.is_true(has_log_code(clear, "GA_BATTLE_UI_CLEAR_FAILED"), "battle HUD clear failure is classified")
end

local function runtime_battle_identity_mismatch_fails_before_active()
    local env = task8_environment({ fight_spec_seed = 43 })
    task8_pump_to_countdown(env)
    env.now = env.now + 3000
    local failed = env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "FightSpec and session seed mismatch fails closed")
    gamma_arena_test_assert.equals(failed.error.code, "GA_BATTLE_IDENTITY_MISMATCH", "battle identity mismatch code is stable")
    gamma_arena_test_assert.is_true(env.orchestrator:runtime_stage_snapshot() ~= "ACTIVE", "identity mismatch cannot enter active combat")
    gamma_arena_test_assert.equals(#env.battle_identity_models, 0, "identity mismatch never mutates HUD")
end

local function runtime_task8_checkpoint_readiness_gates_generation()
    local env = task8_environment()
    env.orchestrator.runtime_stage = "CHECKPOINTING"
    env.orchestrator.checkpoint_ready = false
    env.orchestrator.machine_state = gamma_arena_state_machine.states.CHECKPOINTING
    env.deps.checkpoint.current = "CREATING"
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.generated, 0, "FightSpec generation is forbidden before checkpoint READY")
    env.deps.checkpoint.current = "READY"
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.generated, 0, "the callback proving READY does not also generate")
    env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.generated, 1, "READY opens exactly one generation")
end

local function runtime_wait_inventory_blocks_fight_generation_and_loadout()
    local env = task8_environment({ inventory_pending = true })
    env.orchestrator.runtime_stage = "WAIT_INVENTORY"
    env.orchestrator.machine_state = gamma_arena_state_machine.states.PREPARING
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "first inventory wait poll succeeds")
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "second inventory wait poll succeeds")
    gamma_arena_test_assert.equals(env.inventory_verify_calls, 2, "inventory absence is polled on every waiting update")
    gamma_arena_test_assert.equals(env.generated, 0, "pending inventory drain blocks new FightSpec generation")
    gamma_arena_test_assert.equals(env.applied, 0, "pending inventory drain blocks actor loadout application")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "WAIT_INVENTORY", "pending drain retains inventory wait stage")
end

local function runtime_npc_medical_lifecycle_is_active_only()
    local env = task8_environment()
    task8_pump_to_active(env)
    gamma_arena_test_assert.equals(env.npc_medical_starts, 1, "NPC medical controller starts exactly when entities commit ACTIVE")
    gamma_arena_test_assert.equals(env.npc_medical_fight_id, "ga-task8-0", "NPC medical controller binds the immutable fight id")
    gamma_arena_test_assert.is_true(env.npc_medical_updates >= 1, "NPC medical controller updates after entity reconciliation in ACTIVE")
    local updates = env.npc_medical_updates
    env.living = 0
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(env.npc_medical_updates > updates, "last ACTIVE reconciliation still updates medicine before victory detection")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.npc_medical_stops, 1, "victory stops NPC medicine before the result state")
    gamma_arena_test_assert.equals(env.npc_medical_stop_reasons[1], "victory", "victory stop reason is explicit")
end

local function runtime_task8_generation_and_validation_fail_without_world_mutation()
    for _, key in ipairs({ "generator_error", "validator_error" }) do
        local options = {}; options[key] = true
        local env = task8_environment(options)
        local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
        callbacks.actor_on_update(); callbacks.actor_on_update()
        gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, key .. " enters ERROR")
        gamma_arena_test_assert.equals(env.applied, 0, key .. " cannot mutate actor/entity world state")
    end
end

local function runtime_task8_logs_one_immutable_spec_before_apply()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    gamma_arena_test_assert.equals(table.concat(env.events, ","), "catalogs,generate,validate,log,weapon_diagnostic,log,apply,log", "stable FightSpec and selected-weapon diagnostics precede apply and READY countdown proof")
    gamma_arena_test_assert.equals(#env.logs, 2, "each prepared fight emits one FightSpec and one selected-weapon diagnostic")
    gamma_arena_test_assert.equals(env.logs[1].code, "GA_FIGHT_SPEC", "FightSpec diagnostic code is stable")
end

local function runtime_actor_weapon_selected_diagnostic_precedes_entity_mutation()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    gamma_arena_test_assert.equals(env.logs[2].code, "GA_ACTOR_WEAPON_SELECTED", "selected actor weapon diagnostic code is stable")
    gamma_arena_test_assert.equals(env.logs[2].context.session_id, "ga_task8_session", "selected diagnostic binds the session")
    gamma_arena_test_assert.equals(env.logs[2].context.fight_index, 0, "selected diagnostic binds the fight index")
    gamma_arena_test_assert.equals(env.logs[2].context.fight_id, "ga-task8-0", "selected diagnostic binds the FightSpec identity")
    gamma_arena_test_assert.equals(env.logs[2].context.weapon_section, "wpn_test", "selected diagnostic names the exact weapon")
    gamma_arena_test_assert.equals(env.logs[2].context.hud_section, "wpn_test_hud", "selected diagnostic carries effective HUD metadata")
    local selected_index, apply_index
    for index, event in ipairs(env.events) do
        if event == "weapon_diagnostic" then selected_index = index end
        if event == "apply" then apply_index = index end
    end
    gamma_arena_test_assert.is_true(selected_index < apply_index, "selected metadata is resolved before entity mutation")
end

local function runtime_task8_countdown_uses_global_time_not_frame_count()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    for _ = 1, 50 do env.orchestrator:actor_on_update() end
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "COUNTDOWN", "frame count cannot finish countdown")
    env.now = env.now + 1000; env.orchestrator:actor_on_update()
    env.now = env.now + 1000; env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(table.concat(env.countdown, ","), "3,2,1", "time_global drives the 3,2,1 HUD sequence")
    env.now = env.now + 1000; env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.countdown[#env.countdown], "clear", "countdown HUD is removed at its deadline")
end

local function runtime_countdown_waits_for_fully_staged_ready_state()
    local env = task8_environment({ entity_ready_delay = 2 })
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "preparation starts entity staging")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "EQUIPPING", "orchestrator waits while entities stage")
    gamma_arena_test_assert.equals(#env.countdown, 0, "WAIT_ONLINE cannot display countdown")
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "delayed online staging reaches READY")
    gamma_arena_test_assert.equals(env.registry.state, "READY", "entity transaction proves full readiness")
    gamma_arena_test_assert.equals(#env.countdown, 0, "the update proving READY does not start countdown early")
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "READY starts countdown")
    gamma_arena_test_assert.equals(env.countdown[1], "3", "visible countdown starts only from READY")
end

local function runtime_countdown_deadline_activates_and_releases_in_same_update()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    local releases = env.released_input
    env.now = env.now + 3000
    local activated = env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(activated.ok, "countdown deadline update succeeds")
    gamma_arena_test_assert.equals(env.registry.state, "ACTIVE", "deadline opens hostility gate")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "ACTIVE", "same callback observes entity ACTIVE")
    gamma_arena_test_assert.equals(env.released_input, releases + 1, "same callback releases Arena input exactly once")
end

local function runtime_activation_failure_never_releases_input()
    local env = task8_environment({ activation_error = true })
    task8_pump_to_countdown(env)
    local releases = env.released_input
    env.now = env.now + 3000
    local failed = env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "hostility activation failure remains observable")
    gamma_arena_test_assert.equals(env.released_input, releases, "failed activation never releases gameplay input")
    gamma_arena_test_assert.is_true(env.orchestrator:runtime_stage_snapshot() ~= "ACTIVE", "failed activation never publishes coarse ACTIVE")
end

local function runtime_task8_only_registered_deaths_queue_victory()
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return 999999 end })
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(#env.victory_dialogs, 0, "foreign NPC death cannot trigger victory")
    local registered = env.registry.npcs[1].id
    env.orchestrator:npc_on_death_callback({ id = function() return registered end })
    gamma_arena_test_assert.equals(#env.victory_dialogs, 0, "death callback queues and never opens result UI")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(#env.victory_dialogs, 1, "registered final death opens result UI on next update")
end

local function count_audio_calls(env, method_name)
    local count = 0
    for index = 1, #env.audio_calls do
        if env.audio_calls[index].method == method_name then count = count + 1 end
    end
    return count
end

local function runtime_audio_events_follow_owned_lifecycle()
    local env = task8_environment()
    task8_pump_to_active(env)
    gamma_arena_test_assert.equals(count_audio_calls(env, "begin_fight"), 1, "ACTIVE starts owned Arena audio exactly once")
    gamma_arena_test_assert.is_true(count_audio_calls(env, "update") >= 1, "ACTIVE updates owned Arena audio")

    env.orchestrator:npc_on_death_callback({ id = function() return 999999 end })
    gamma_arena_test_assert.equals(count_audio_calls(env, "opponent_defeated"), 0, "foreign death remains silent")
    local registered = env.registry.npcs[1].id
    gamma_arena_test_assert.is_true(env.orchestrator:npc_on_death_callback({ id = function() return registered end }).ok, "registered death remains accepted")
    gamma_arena_test_assert.equals(count_audio_calls(env, "opponent_defeated"), 1, "accepted owned death emits one crowd reaction")
    env.orchestrator:npc_on_death_callback({ id = function() return registered end })
    gamma_arena_test_assert.equals(count_audio_calls(env, "opponent_defeated"), 1, "duplicate death remains silent")

    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "victory update remains successful")
    gamma_arena_test_assert.equals(count_audio_calls(env, "victory"), 1, "victory announcement precedes result ownership")
    gamma_arena_test_assert.equals(#env.victory_dialogs, 1, "victory UI remains available")
    gamma_arena_test_assert.is_true(env.victory_dialogs[1].on_next().ok, "next-fight action remains successful")
    gamma_arena_test_assert.equals(count_audio_calls(env, "stop_all"), 1, "continuation stops every owned audio channel")
end

local function runtime_audio_manual_restart_stops_channels()
    local env = task8_environment()
    task8_pump_to_active(env)
    local restarted = env.orchestrator:restart_arena_action()
    gamma_arena_test_assert.is_true(restarted.ok and restarted.value == true, "manual restart remains accepted")
    gamma_arena_test_assert.equals(count_audio_calls(env, "stop_all"), 1, "manual restart stops every owned audio channel")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "manual restart keeps authoritative cleanup routing")
end

local function runtime_audio_cleanup_covers_exit_boundaries()
    local game_load = task8_environment(); task8_pump_to_active(game_load)
    gamma_arena_test_assert.is_true(game_load.orchestrator:on_game_load().ok, "game-load reset succeeds")
    gamma_arena_test_assert.equals(count_audio_calls(game_load, "stop_all"), 1, "game-load reset stops owned audio")

    local level_change = task8_environment(); task8_pump_to_active(level_change)
    gamma_arena_test_assert.is_true(level_change.orchestrator:on_before_level_changing().ok, "level-change cleanup succeeds")
    gamma_arena_test_assert.equals(count_audio_calls(level_change, "stop_all"), 1, "level change stops owned audio")

    local actor_destroy = task8_environment(); task8_pump_to_active(actor_destroy)
    gamma_arena_test_assert.is_true(actor_destroy.orchestrator:actor_on_net_destroy().ok, "actor destroy cleanup succeeds")
    gamma_arena_test_assert.equals(count_audio_calls(actor_destroy, "stop_all"), 1, "actor destroy stops owned audio")

    local fatal = task8_environment(); task8_pump_to_active(fatal)
    local fatal_result = fatal.orchestrator:enter_fatal(gamma_arena_result.err("GA_TEST_FATAL", "expected fatal fixture"), true)
    gamma_arena_test_assert.is_false(fatal_result.ok, "fatal routing preserves its original failure")
    gamma_arena_test_assert.equals(count_audio_calls(fatal, "stop_all"), 1, "fatal routing stops owned audio")

    local main_menu = task8_environment(); task8_pump_to_active(main_menu)
    main_menu.orchestrator:npc_on_death_callback({ id = function() return main_menu.registry.npcs[1].id end })
    main_menu.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(main_menu.victory_dialogs[1].on_main_menu().ok, "main-menu cleanup succeeds")
    gamma_arena_test_assert.equals(count_audio_calls(main_menu, "stop_all"), 1, "main-menu exit stops owned audio")
end

local function runtime_audio_failures_are_diagnostic_only()
    local env = task8_environment({ audio_error = true })
    task8_pump_to_active(env)
    local registered = env.registry.npcs[1].id
    gamma_arena_test_assert.is_true(env.orchestrator:npc_on_death_callback({ id = function() return registered end }).ok, "audio reaction failure cannot reject an owned death")
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "audio victory failure cannot reject result transition")
    gamma_arena_test_assert.equals(#env.victory_dialogs, 1, "audio failures cannot suppress result UI")
    gamma_arena_test_assert.is_true(env.victory_dialogs[1].on_next().ok, "audio cleanup failure cannot block continuation")
    gamma_arena_test_assert.is_true(env.orchestrator.machine_state ~= gamma_arena_state_machine.states.ERROR, "audio failure never enters fatal state")
    local diagnostics = 0
    for index = 1, #env.logs do
        if env.logs[index].code == "GA_AUDIO_EVENT_FAILED" then diagnostics = diagnostics + 1 end
    end
    gamma_arena_test_assert.is_true(diagnostics >= 5, "every failed audio event emits a bounded diagnostic")
end

local function runtime_active_poll_queues_victory_without_death_callback()
    local env = task8_environment(); task8_pump_to_active(env)
    env.registry.npcs[1].dead = true
    env.living = 0
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(#env.victory_dialogs, 0, "ACTIVE reconciliation queues and never opens result UI synchronously")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(#env.victory_dialogs, 1, "zero reconciled opponents opens victory without relying on the external death callback")
end

local function task8_pump_integrity_retry_to_active(env)
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "integrity fault queues bounded recovery")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "integrity recovery bypasses result UI")
    for _ = 1, 4 do gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "integrity cleanup and exact reapply remain frame-driven") end
    env.now = env.now + 3000
    for _ = 1, 3 do
        gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "integrity retry countdown remains structured")
        if env.orchestrator:runtime_stage_snapshot() == "ACTIVE" then break end
    end
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "ACTIVE", "integrity retry returns the same fight to ACTIVE")
end

local function runtime_orchestrator_integrity_retries_same_spec_twice()
    local env = task8_environment(); task8_pump_to_active(env)
    local spec_before = env.orchestrator.fight_spec
    local index_before = env.orchestrator.session.fight_index
    local generated_before = env.generated
    env.integrity_fault = { cause = "vertical_escape", opponent_id = env.registry.npcs[1].id }
    task8_pump_integrity_retry_to_active(env)
    gamma_arena_test_assert.is_true(env.orchestrator.fight_spec == spec_before, "first integrity retry retains the immutable FightSpec")
    env.integrity_fault = { cause = "opponent_missing", opponent_id = env.registry.npcs[1].id }
    task8_pump_integrity_retry_to_active(env)
    gamma_arena_test_assert.is_true(env.orchestrator.fight_spec == spec_before, "second integrity retry retains the immutable FightSpec")
    gamma_arena_test_assert.equals(env.orchestrator.session.fight_index, index_before, "integrity retries never advance fight index")
    gamma_arena_test_assert.equals(env.generated, generated_before, "integrity retries consume no new generation")
    gamma_arena_test_assert.equals(env.applied, 3, "initial fight plus two retries apply the same spec three times")
    gamma_arena_test_assert.equals(#env.victory_dialogs + #env.defeat_dialogs, 0, "integrity retries never display a result dialog")
end

local function runtime_orchestrator_integrity_retry_exhaustion_fails()
    local env = task8_environment(); task8_pump_to_active(env)
    for attempt = 1, 2 do
        env.integrity_fault = { cause = "vertical_escape", attempt = attempt }
        task8_pump_integrity_retry_to_active(env)
    end
    env.integrity_fault = { cause = "vertical_escape", attempt = 3 }
    local failed = env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "third integrity fault cannot loop forever")
    gamma_arena_test_assert.equals(failed.error.code, "GA_FIGHT_INTEGRITY_RETRY_EXHAUSTED", "retry exhaustion code is stable")
    gamma_arena_test_assert.equals(#env.victory_dialogs + #env.defeat_dialogs, 0, "retry exhaustion never manufactures a combat result")
end

local function runtime_result_modal_releases_global_input()
    local victory = task8_environment(); task8_pump_to_active(victory)
    local victory_acquired = victory.acquired_input
    victory.orchestrator:npc_on_death_callback({ id = function() return victory.registry.npcs[1].id end })
    victory.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(victory.acquired_input, victory_acquired, "victory result never globally disables mouse input")
    gamma_arena_test_assert.equals(#victory.victory_dialogs, 1, "victory modal is shown with engine input available")
end

local function runtime_task8_victory_next_cleans_heals_and_increments_once()
    local env = task8_environment(); task8_pump_to_active(env)
    local first_fight_id = env.orchestrator.fight_spec:fight_id()
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    env.victory_dialogs[1].on_next(); env.victory_dialogs[1].on_next()
    for _ = 1, 5 do env.orchestrator:actor_on_update() end
    gamma_arena_test_assert.equals(env.cleanup_calls, 1, "victory-next starts entity cleanup once")
    gamma_arena_test_assert.equals(env.reset_actor, 1, "victory-next resets and heals actor once")
    gamma_arena_test_assert.equals(env.orchestrator.session.fight_index, 1, "victory-next increments index exactly once")
    gamma_arena_test_assert.equals(env.generated, 2, "victory-next generates exactly one next FightSpec")
    gamma_arena_test_assert.is_true(env.orchestrator.fight_spec:fight_id() ~= first_fight_id, "next fight has a distinct fight_id")
end

local function runtime_victory_next_locks_before_result_ui_closes()
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    local accepted = env.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_true(accepted.ok and accepted.value == true, "victory next owns the transition")
    gamma_arena_test_assert.equals(table.concat(env.ordered_calls, ","), "boundary,clear_result", "input boundary precedes Result UI close")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "locked victory enters cleanup")
end

local function runtime_victory_next_boundary_failure_retains_result()
    local env = task8_environment({ boundary_error = true }); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    local failed = env.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_false(failed.ok, "rematch boundary failure is returned to Result UI")
    gamma_arena_test_assert.is_true(env.result_visible, "failed boundary retains Result UI")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "RESULT", "failed boundary starts no continuation")
    gamma_arena_test_assert.is_false(env.orchestrator.result_action_locked, "failed boundary rolls back duplicate-action latch")
    gamma_arena_test_assert.equals(env.cleanup_calls, 0, "failed boundary starts no cleanup")
    gamma_arena_test_assert.equals(env.fatal_shown, 0, "recoverable boundary failure does not replace Result UI with fatal UI")
end

local function runtime_manual_restart_reuses_next_fight_once()
    local env = task8_environment(); task8_pump_to_active(env)
    local seed = env.orchestrator.session.session_seed
    local difficulty = env.orchestrator.session.difficulty_id
    local first_fight_id = env.orchestrator.fight_spec:fight_id()
    local accepted = env.orchestrator:restart_arena_action()
    local duplicate = env.orchestrator:restart_arena_action()
    gamma_arena_test_assert.is_true(accepted.ok and accepted.value == true, "manual restart is accepted")
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "duplicate manual restart is inert")
    gamma_arena_test_assert.equals(env.battle_identity_clears, 1, "manual restart hides battle identity immediately and once")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "NEXT_CLEANUP", "manual restart enters existing cleanup")
    gamma_arena_test_assert.equals(env.generated, 1, "manual restart creates nothing before cleanup")
    for _ = 1, 5 do env.orchestrator:actor_on_update() end
    gamma_arena_test_assert.equals(env.cleanup_calls, 1, "manual restart cleans once")
    gamma_arena_test_assert.equals(env.reset_actor, 1, "manual restart resets actor once")
    gamma_arena_test_assert.equals(env.orchestrator.session.session_seed, seed, "manual restart preserves seed")
    gamma_arena_test_assert.equals(env.orchestrator.session.difficulty_id, difficulty, "manual restart preserves difficulty")
    gamma_arena_test_assert.equals(env.orchestrator.session.fight_index, 1, "manual restart advances once")
    gamma_arena_test_assert.equals(env.generated, 2, "manual restart generates one replacement FightSpec")
    gamma_arena_test_assert.is_true(env.orchestrator.fight_spec:fight_id() ~= first_fight_id, "manual restart generates a distinct fight")
    gamma_arena_test_assert.equals(#env.battle_identity_models, 1, "replacement identity stays hidden until replacement combat is active")
end

local function runtime_manual_restart_inactive_and_exhausted_are_inert()
    local inactive = task8_environment()
    local ignored = inactive.orchestrator:restart_arena_action()
    gamma_arena_test_assert.is_true(ignored.ok and ignored.value == false, "inactive Arena ignores manual restart")
    gamma_arena_test_assert.equals(inactive.cleanup_calls, 0, "inactive restart starts no cleanup")

    local exhausted = task8_environment(); task8_pump_to_active(exhausted)
    exhausted.orchestrator.session.fight_index = 4294967295
    local failed = exhausted.orchestrator:restart_arena_action()
    gamma_arena_test_assert.is_false(failed.ok, "exhausted manual restart is rejected")
    gamma_arena_test_assert.equals(failed.error.code, "GA_FIGHT_INDEX_EXHAUSTED", "manual restart exhaustion code is stable")
    gamma_arena_test_assert.equals(exhausted.orchestrator:runtime_stage_snapshot(), "ACTIVE", "exhausted restart leaves combat active")
    gamma_arena_test_assert.is_false(exhausted.orchestrator.result_action_locked, "exhausted restart does not acquire the action latch")
    gamma_arena_test_assert.equals(exhausted.cleanup_calls, 0, "exhausted restart precedes cleanup")
end

local function runtime_manual_and_integrity_transitions_share_boundary()
    local manual = task8_environment(); task8_pump_to_active(manual)
    gamma_arena_test_assert.is_true(manual.orchestrator:restart_arena_action().ok, "manual restart transition succeeds")
    gamma_arena_test_assert.equals(manual.boundary_calls, 1, "manual restart owns one rematch boundary")
    gamma_arena_test_assert.is_true(manual.orchestrator:restart_arena_action().ok, "duplicate manual restart stays inert")
    gamma_arena_test_assert.equals(manual.boundary_calls, 1, "duplicate manual restart cannot reacquire boundary")

    local integrity = task8_environment(); task8_pump_to_active(integrity)
