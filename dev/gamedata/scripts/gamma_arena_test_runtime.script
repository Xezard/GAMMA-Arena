local function runtime_entity_release_is_async_and_never_direct()
    local env, deps = fake_entity_environment({ release_delay = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-async"); pump_entity(adapter, env)
    adapter:cleanup(); adapter:update()
    gamma_arena_test_assert.is_true(adapter:registry_snapshot().state == "CLEANING", "safe release waits until the entity is truly absent")
    pump_entity(adapter, env)
    gamma_arena_test_assert.equals(#env.direct_releases, 0, "standalone stalkers never use direct alife release")
end

local function runtime_entity_release_timeout_is_wrap_safe()
    local env, deps = fake_entity_environment({ now = 4294967293, release_never_finishes = true, release_timeout_ms = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-wrap"); pump_entity(adapter, env)
    adapter:cleanup(); local result, snapshot = pump_entity(adapter, env, 50)
    gamma_arena_test_assert.is_false(result.ok, "never-finished release times out")
    gamma_arena_test_assert.equals(snapshot.error.code, "GA_ENTITY_CLEANUP_FAILED", "wrap-safe timeout is aggregated into cleanup failure")
end

local function runtime_entity_max_cardinality_cleanup_fits_default_budget()
    local env, deps = fake_entity_environment({ multi_return_ammo = true, release_delay = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(6), "session-max-cleanup")
    local applied, active = pump_entity(adapter, env, 500)
    gamma_arena_test_assert.is_true(applied.ok and active.state == "ACTIVE", "six-opponent maximum-cardinality fixture becomes active")
    gamma_arena_test_assert.equals(#active.npcs + #active.items, 42, "maximum fixture tracks six NPCs and thirty-six assigned item entities including split ammo")
    local context, result = {}, nil
    for _ = 1, 256 do
        result = gamma_arena_bootstrap.step_entity_cleanup(adapter, context, {
            clock = function() return env.now end,
            timeout_ms = 10000,
            max_updates = 256
        })
        gamma_arena_test_assert.is_true(result.ok, "maximum-cardinality deferred cleanup remains within the hard cap")
        if result.value.pending ~= true then break end
        env:advance(1)
    end
    gamma_arena_test_assert.is_true(result.ok and result.value.pending == false, "maximum-cardinality deferred cleanup completes within the default entity budget")
    gamma_arena_test_assert.is_true(context.updates > 64 and context.updates <= 256, "coverage proves the legacy shared 64-update default was insufficient but the entity cap is bounded")
end

local function runtime_entity_relations_friend_first_then_actor_hostile()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(2), "session-relations"); local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "relations complete before ACTIVE")
    local first_friend, first_hostile = nil, nil
    for index, event in ipairs(env.events) do
        if first_friend == nil and string.find(event, "^friend:") then first_friend = index end
        if first_hostile == nil and string.find(event, "^hostile:") then first_hostile = index end
        if string.find(event, "^hostile:") then gamma_arena_test_assert.is_true(string.find(event, ":-5000$") ~= nil, "actor goodwill is exactly -5000") end
    end
    gamma_arena_test_assert.is_true(first_friend ~= nil and first_hostile ~= nil and first_friend < first_hostile, "all NPC friendship is established before actor hostility")
end

local function runtime_entity_equipment_delays_active_and_times_out()
    local env, deps = fake_entity_environment({ equip_delay = 2 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-equip-delay")
    local observed_wait = false
    for _ = 1, 100 do
        local result = adapter:update(); gamma_arena_test_assert.is_true(result.ok, "delayed equip remains retryable")
        local snapshot = adapter:registry_snapshot()
        if env.equip_attempts[100] and env.equip_attempts[100] < 3 then
            observed_wait = snapshot.state == "WAIT_ONLINE"
            for _, event in ipairs(env.events) do gamma_arena_test_assert.is_true(not string.find(event, "^hostile:"), "actor hostility waits for equipment verification") end
        end
        if snapshot.state == "ACTIVE" then break end
        env:advance(1)
    end
    gamma_arena_test_assert.is_true(observed_wait, "ACTIVE is withheld while the validated weapon is not equipped")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "ACTIVE", "ACTIVE begins only after equip verification")

    local stuck_env, stuck_deps = fake_entity_environment({ equip_never = true, online_timeout_ms = 3 })
    local stuck = gamma_arena_entity_adapter.new(stuck_deps)
    begin_entity_apply(stuck, stuck_env, entity_spec(1), "session-equip-timeout")
    local result, snapshot = pump_entity(stuck, stuck_env, 100)
    gamma_arena_test_assert.is_false(result.ok, "never-equipped opponent fails boundedly")
    gamma_arena_test_assert.equals(snapshot.state, "ERROR", "equipment timeout rolls back before ACTIVE")
end

local function runtime_entity_callbacks_fail_closed()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-callback"); pump_entity(adapter, env)
    local victim = { id = function() error("injected victim id failure") end }
    local called, result = pcall(function() return adapter:on_npc_death(victim) end)
    gamma_arena_test_assert.is_true(called and result.ok, "death callback protects the engine and fails closed")
    gamma_arena_test_assert.is_false(result.value, "throwing victim accessor is ignored")
end

local function runtime_validator_rejects_effective_nonhuman_profile()
    local snapshot_result = gamma_arena_catalog.load(gamma_arena_test_generator.fixture_factory())
    gamma_arena_test_assert.is_true(snapshot_result.ok, "validator fixture catalog loads")
    local generated = gamma_arena_generator.generate({ session_seed = 7, mode_id = "skirmish", difficulty_id = "rookie", layout_id = "rostok_arena_v1" }, 0, snapshot_result.value)
    gamma_arena_test_assert.is_true(generated.ok, "validator fixture fight generates")
    local rejected = gamma_arena_validator.validate_runtime(generated.value, snapshot_result.value, {
        effective_profile = function() return { class = "SM_BLOODSUCKER", community = "monster" } end
    })
    gamma_arena_test_assert.is_false(rejected.ok, "effective mutant class cannot pass runtime validation")
    gamma_arena_test_assert.equals(rejected.error.code, "GA_ENEMY_EFFECTIVE_CLASS_INVALID", "effective human class code")
end

local function runtime_entity_runtime_profile_check_precedes_actor_mutation()
    local env, deps = fake_entity_environment({ effective_profile = { class = "SM_BLOODSUCKER", community = "monster" } })
    local adapter = gamma_arena_entity_adapter.new(deps)
    local result = adapter:begin_apply(entity_spec(1), "session-profile-reject")
    gamma_arena_test_assert.is_false(result.ok, "entity application requires fail-closed effective profile validation")
    gamma_arena_test_assert.equals(result.error.code, "GA_ENEMY_EFFECTIVE_CLASS_INVALID", "entity application preserves effective class code")
    gamma_arena_test_assert.equals(env.actor_loadout_calls, 0, "effective profile rejection precedes actor mutation")
    gamma_arena_test_assert.equals(env.create_npc_count, 0, "effective profile rejection precedes NPC creation")
end

local function runtime_orchestrator_living_count_fails_closed()
    local deps = fake_orchestrator_deps(fake_store())
    local orchestrator = gamma_arena_orchestrator.new(deps)
    local missing = orchestrator:living_opponent_count()
    gamma_arena_test_assert.is_false(missing.ok, "missing entity adapter cannot look like zero living opponents")
    gamma_arena_test_assert.equals(missing.error.code, "GA_ENTITY_COUNT_UNAVAILABLE", "missing count dependency code")
    deps.entities = {
        registry_snapshot = function() return { state = "ACTIVE" } end,
        living_opponent_count = function() error("injected count failure") end
    }
    local throwing = gamma_arena_orchestrator.new(deps):living_opponent_count()
    gamma_arena_test_assert.is_false(throwing.ok, "throwing count cannot look like victory")
    deps.entities = { registry_snapshot = function() return { state = "COUNTDOWN" } end, living_opponent_count = function() return 0 end }
    local inactive = gamma_arena_orchestrator.new(deps):living_opponent_count()
    gamma_arena_test_assert.is_false(inactive.ok, "zero count before entity ACTIVE cannot look like victory")
    gamma_arena_test_assert.equals(inactive.error.code, "GA_ENTITY_COUNT_STATE_INVALID", "pre-ACTIVE count state code")
    deps.entities = { registry_snapshot = function() return { state = "ACTIVE" } end, living_opponent_count = function() return 0 end }
    local exact = gamma_arena_orchestrator.new(deps):living_opponent_count()
    gamma_arena_test_assert.is_true(exact.ok and exact.value == 0, "only exact ACTIVE zero is a valid future victory signal")
end

local function task8_validated_spec(index)
    local private = {
        fight_index = index,
        fight_id = "ga-task8-" .. tostring(index),
        actor = { loadout = { weapon = "wpn_test", ammo = "ammo_test", ammo_boxes = 1, outfit = "outfit_test", consumables = { "medkit_test" }, cost = 4 } },
        opponents = { { slot = 1, profile = "gamma_arena_bandit_novice", spawn_path = "spawn_test", loadout = { weapon = "wpn_test", ammo = "ammo_test", ammo_boxes = 1, outfit = "outfit_test", consumables = { "medkit_test" }, cost = 4 } } }
    }
    return {
        fight_index = function() return private.fight_index end,
        fight_id = function() return private.fight_id end,
        actor = function() return clone(private.actor) end,
        opponents = function() return clone(private.opponents) end,
        stable_encode = function() return "stable:" .. private.fight_id end
    }
end

local function task8_environment(options)
    options = options or {}
    local env = {
        now = 100,
        generated = 0,
        validated = 0,
        applied = 0,
        released_input = 0,
        acquired_input = 0,
        reset_actor = 0,
        cleanup_calls = 0,
        checkpoint_cleanup = 0,
        checkpoint_create = 0,
        clear_intent = 0,
        disconnected = 0,
        fatal_shown = 0,
        living = 0,
        next_id = 1000,
        registry = { state = "CLEAN", session_id = nil, npcs = {}, items = {}, error = nil },
        logs = {},
        events = {},
        countdown = {},
        countdown_models = {},
        victory_dialogs = {},
        defeat_dialogs = {},
        death_holds = 0,
        restore_calls = 0,
        actor_loadout_owned = false,
        actor_loadout_cleanup = 0
    }
    local actor = {
        begin_update = function() return gamma_arena_result.ok(true) end,
        normalize_for_checkpoint = function() return gamma_arena_result.ok(true) end,
        verify_inventory_empty = function() return gamma_arena_result.ok(true) end,
        acquire_input = function() env.acquired_input = env.acquired_input + 1; return gamma_arena_result.ok(true) end,
        release_input = function() env.released_input = env.released_input + 1; return gamma_arena_result.ok(true) end,
        hold_after_logical_death = function()
            env.death_holds = env.death_holds + 1
            return gamma_arena_result.ok(true)
        end,
        cleanup_loadout_for_restore = function()
            env.actor_loadout_cleanup = env.actor_loadout_cleanup + 1
            env.events[#env.events + 1] = "actor_cleanup"
            env.actor_loadout_owned = false
            return gamma_arena_result.ok(true)
        end,
        release_logical_death_hold = function() env.death_hold_releases = (env.death_hold_releases or 0) + 1; return gamma_arena_result.ok(true) end,
        reset_after_victory = function()
            env.reset_actor = env.reset_actor + 1
            env.actor_loadout_owned = false
            return gamma_arena_result.ok(true)
        end,
        cleanup = function() return gamma_arena_result.ok(true) end
    }
    local entities = {}
    function entities:begin_apply(spec, session_id)
        if env.actor_loadout_owned then return gamma_arena_result.err("GA_ACTOR_LOADOUT_BUSY", "stale actor loadout ownership") end
        env.actor_loadout_owned = true
        env.events[#env.events + 1] = "apply"
        env.applied = env.applied + 1
        env.living = #spec.opponents()
        env.registry = { state = "COUNTDOWN", session_id = session_id, npcs = {}, items = {}, error = nil }
        for index = 1, env.living do
            env.next_id = env.next_id + 1
            env.registry.npcs[index] = { id = env.next_id, dead = false, released = false }
        end
        env.next_id = env.next_id + 1
        env.registry.items[1] = { id = env.next_id, released = false }
        return gamma_arena_result.ok({ state = "COUNTDOWN" })
    end
    function entities:update()
        if env.registry.state == "COUNTDOWN" and env.orchestrator:is_opponent_activation_allowed() then env.registry.state = "ACTIVE" end
        if env.registry.state == "CLEANING" then env.registry = { state = "CLEAN", session_id = nil, npcs = {}, items = {}, error = nil } end
        return gamma_arena_result.ok({ state = env.registry.state })
    end
    function entities:on_npc_death(id)
        if options.death_error then return gamma_arena_result.err("GA_TEST_DEATH", "injected death processing failure") end
        if env.registry.state ~= "ACTIVE" then return gamma_arena_result.ok(false) end
        for _, record in ipairs(env.registry.npcs) do
            if record.id == id and not record.dead then record.dead = true; env.living = env.living - 1; return gamma_arena_result.ok(true) end
        end
        return gamma_arena_result.ok(false)
    end
    function entities:living_opponent_count() return env.living end
    function entities:cleanup()
        env.events[#env.events + 1] = "cleanup"
        env.cleanup_calls = env.cleanup_calls + 1
        env.registry.state = "CLEANING"
        return gamma_arena_result.ok(true)
    end
    function entities:registry_snapshot() return clone(env.registry) end
    local store
    local checkpoint = { current = "READY" }
    function checkpoint:create() env.checkpoint_create = env.checkpoint_create + 1; return gamma_arena_result.ok(true) end
    function checkpoint:update()
        if self.current == "UNHIDING" then
            env.events[#env.events + 1] = "load"
            env.orchestrator:expect_checkpoint_reload()
            self.current = "LOADING"
        elseif self.current == "REHIDING" then
            self.current = "READY"
            self.completed_resume = clone(self.prepared_resume)
        end
        return gamma_arena_result.ok({ state = self.current })
    end
    function checkpoint:state() return self.current end
    function checkpoint:cleanup() env.checkpoint_cleanup = env.checkpoint_cleanup + 1; self.current = "NONE"; return gamma_arena_result.ok(true) end
    function checkpoint:on_game_load()
        if self.current ~= "LOADING" then return gamma_arena_result.ok(false) end
        self.current = "REHIDING"
        return gamma_arena_result.ok(true)
    end
    function checkpoint:begin_resume_recovery(_, prepared)
        if self.current ~= "REHIDING" then return gamma_arena_result.err("GA_TEST_REHIDE", "checkpoint is not re-hiding") end
        self.prepared_resume = clone(prepared)
        return gamma_arena_result.ok(true)
    end
    function checkpoint:take_resume() return gamma_arena_result.ok(clone(self.completed_resume)) end
    function checkpoint:restore(_, next_fight_index)
        env.events[#env.events + 1] = "intent"
        env.restore_calls = env.restore_calls + 1
        env.restore_next_fight_index = next_fight_index
        if options.restore_error then return gamma_arena_result.err("GA_TEST_RESTORE", "injected restore failure") end
        local session = env.orchestrator:session_snapshot()
        local intent = { schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = next_fight_index, checkpoint_name = session.checkpoint_name }
        local issued = store:issue_resume({}, intent)
        if not issued.ok then return issued end
        self.current = "UNHIDING"
        return gamma_arena_result.ok(true)
    end
    local result_ui = {}
    function result_ui:show_countdown(model)
        env.countdown_models[#env.countdown_models + 1] = model
        env.countdown[#env.countdown + 1] = tostring(model.value)
        return gamma_arena_result.ok(true)
    end
    function result_ui:clear_countdown()
        if options.clear_countdown_error then return gamma_arena_result.err("GA_TEST_COUNTDOWN_CLEAR", "injected countdown clear failure") end
        env.countdown[#env.countdown + 1] = "clear"
        return gamma_arena_result.ok(true)
    end
    function result_ui:show_victory(model)
        env.victory_dialogs[#env.victory_dialogs + 1] = model
        return gamma_arena_result.ok(true)
    end
    function result_ui:show_result(model)
        if model.kind == "victory" then
            env.victory_dialogs[#env.victory_dialogs + 1] = model
        elseif model.kind == "defeat" then
            env.defeat_dialogs[#env.defeat_dialogs + 1] = model
        end
        return gamma_arena_result.ok(true)
    end
    function result_ui:clear_result()
        if options.clear_result_error then return gamma_arena_result.err("GA_TEST_RESULT_CLEAR", "injected result clear failure") end
        env.events[#env.events + 1] = "clear_ui"
        return gamma_arena_result.ok(true)
    end
    store = fake_store()
    function store:clear_resume_if_matches()
        env.clear_intent = env.clear_intent + 1
        if options.clear_intent_error then return gamma_arena_result.err("GA_TEST_INTENT_CLEAR", "injected intent clear failure") end
        self.intent_state.launch_pending = false
        self.intent_state.resume_pending = false
        return gamma_arena_result.ok(true)
    end
    local deps = {
        store = store,
        config = {},
        reconcile = function() return gamma_arena_result.ok({ events = {} }) end,
        preflight = function() return gamma_arena_result.ok(true) end,
        identity = function() return gamma_arena_result.ok({ session_id = "ga_task8_session", session_nonce = "ga_task8_nonce" }) end,
        ui = { show_fatal = function(errors, callback) env.fatal_shown = env.fatal_shown + 1; return { errors = errors, callback = callback } end },
        notify = function() end,
        disconnect = function()
            env.disconnected = env.disconnected + 1
            if env.disconnected <= (options.disconnect_failures or 0) then return false end
            return true
        end,
        teardown = function(_, preserve)
            if preserve == true then return gamma_arena_result.ok(true) end
            env.teardown_calls = (env.teardown_calls or 0) + 1
            if options.teardown_pending_then_error and env.teardown_calls == 1 then return gamma_arena_result.ok({ pending = true }) end
            if options.teardown_error or (options.teardown_pending_then_error and env.teardown_calls >= 2) then
                return gamma_arena_result.err("GA_TEST_TEARDOWN", "injected teardown failure")
            end
            entities:cleanup(); entities:update(); checkpoint:cleanup()
            return gamma_arena_result.ok(true)
        end,
        actor = actor,
        entities = entities,
        checkpoint = checkpoint,
        layout = function() return gamma_arena_result.ok({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" }) end,
        mode_policy = gamma_arena_mode_skirmish,
        catalogs = function() env.events[#env.events + 1] = "catalogs"; return gamma_arena_result.ok({ revision = 1 }) end,
        generator = function(_, index)
            env.events[#env.events + 1] = "generate"
            env.generated = env.generated + 1
            if options.generator_error then return gamma_arena_result.err("GA_TEST_GENERATOR", "injected generator failure") end
            return gamma_arena_result.ok({ fight_index = index })
        end,
        validator = function(spec)
            env.events[#env.events + 1] = "validate"
            env.validated = env.validated + 1
            if options.validator_error then return gamma_arena_result.err("GA_TEST_VALIDATOR", "injected validator failure") end
            return gamma_arena_result.ok(task8_validated_spec(spec.fight_index))
        end,
        clock = function() return env.now end,
        result_ui = result_ui,
        log = { info = function(code, message)
            env.events[#env.events + 1] = "log"
            env.logs[#env.logs + 1] = { code = code, message = message }
            return gamma_arena_result.ok(true)
        end }
    }
    env.deps = deps
    env.orchestrator = gamma_arena_orchestrator.new(deps)
    env.orchestrator.active = true
    env.orchestrator.session = valid_session()
    env.orchestrator.session.session_id = "ga_task8_session"
    env.orchestrator.runtime_stage = "READY"
    env.orchestrator.checkpoint_ready = true
    env.orchestrator.machine_state = gamma_arena_state_machine.states.PREPARING
    return env
end

local function task8_pump_to_countdown(env)
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "READY update enters PREPARING")
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "PREPARING creates one immutable validated spec")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "COUNTDOWN", "preparation reaches COUNTDOWN")
end

local function task8_pump_to_active(env)
    task8_pump_to_countdown(env)
    env.now = env.now + 3000
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "countdown deadline opens opponent gate")
    gamma_arena_test_assert.is_true(env.orchestrator:actor_on_update().ok, "entity activation is observed on the next update")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "ACTIVE", "fight becomes ACTIVE")
end

local function runtime_task8_checkpoint_readiness_gates_generation()
    local env = task8_environment()
    env.orchestrator.runtime_stage = "CHECKPOINTING"
    env.orchestrator.checkpoint_ready = false
    env.orchestrator.machine_state = gamma_arena_state_machine.states.CHECKPOINTING
    env.deps.checkpoint.current = "CREATING"
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.generated, 0, "FightSpec generation is forbidden before checkpoint READY")
    env.deps.checkpoint.current = "READY"
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.generated, 0, "the callback proving READY does not also generate")
    env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.generated, 1, "READY opens exactly one generation")
end

local function runtime_task8_generation_and_validation_fail_without_world_mutation()
    for _, key in ipairs({ "generator_error", "validator_error" }) do
        local options = {}; options[key] = true
        local env = task8_environment(options)
        local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
        callbacks.actor_on_update(); callbacks.actor_on_update()
        gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, key .. " enters ERROR")
        gamma_arena_test_assert.equals(env.applied, 0, key .. " cannot mutate actor/entity world state")
    end
end

local function runtime_task8_logs_one_immutable_spec_before_apply()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    gamma_arena_test_assert.equals(table.concat(env.events, ","), "catalogs,generate,validate,log,apply", "stable FightSpec log precedes apply")
    gamma_arena_test_assert.equals(#env.logs, 1, "each prepared fight emits one FightSpec diagnostic")
    gamma_arena_test_assert.equals(env.logs[1].code, "GA_FIGHT_SPEC", "FightSpec diagnostic code is stable")
end

local function runtime_task8_countdown_uses_global_time_not_frame_count()
    local env = task8_environment()
    task8_pump_to_countdown(env)
    for _ = 1, 50 do env.orchestrator:actor_on_update() end
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "COUNTDOWN", "frame count cannot finish countdown")
    env.now = env.now + 1000; env.orchestrator:actor_on_update()
    env.now = env.now + 1000; env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(table.concat(env.countdown, ","), "3,2,1", "time_global drives the 3,2,1 HUD sequence")
    env.now = env.now + 1000; env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.countdown[#env.countdown], "clear", "countdown HUD is removed at its deadline")
end

local function runtime_task8_only_registered_deaths_queue_victory()
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return 999999 end })
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(#env.victory_dialogs, 0, "foreign NPC death cannot trigger victory")
    local registered = env.registry.npcs[1].id
    env.orchestrator:npc_on_death_callback({ id = function() return registered end })
    gamma_arena_test_assert.equals(#env.victory_dialogs, 0, "death callback queues and never opens result UI")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(#env.victory_dialogs, 1, "registered final death opens result UI on next update")
end

local function runtime_task8_victory_next_cleans_heals_and_increments_once()
    local env = task8_environment(); task8_pump_to_active(env)
    local first_fight_id = env.orchestrator.fight_spec:fight_id()
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    env.victory_dialogs[1].on_next(); env.victory_dialogs[1].on_next()
    for _ = 1, 5 do env.orchestrator:actor_on_update() end
    gamma_arena_test_assert.equals(env.cleanup_calls, 1, "victory-next starts entity cleanup once")
    gamma_arena_test_assert.equals(env.reset_actor, 1, "victory-next resets and heals actor once")
    gamma_arena_test_assert.equals(env.orchestrator.session.fight_index, 1, "victory-next increments index exactly once")
    gamma_arena_test_assert.equals(env.generated, 2, "victory-next generates exactly one next FightSpec")
    gamma_arena_test_assert.is_true(env.orchestrator.fight_spec:fight_id() ~= first_fight_id, "next fight has a distinct fight_id")
end

local function runtime_task8_main_menu_exit_cleans_registry_checkpoint_and_intent()
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    env.victory_dialogs[1].on_main_menu()
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.registry.state, "CLEAN", "main-menu exit drains entity registry")
    gamma_arena_test_assert.equals(env.deps.checkpoint.current, "NONE", "main-menu exit removes checkpoint")
    gamma_arena_test_assert.equals(env.clear_intent, 1, "main-menu exit clears matching transient intent")
    gamma_arena_test_assert.equals(env.disconnected, 1, "main-menu exit disconnects after cleanup proof")
end

local function runtime_task8_main_menu_disconnect_retries_after_failure()
    local env = task8_environment({ disconnect_failures = 1 }); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    env.victory_dialogs[1].on_main_menu()
    local failed = env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "first failed disconnect remains observable")
    gamma_arena_test_assert.is_true(env.orchestrator.pending_disconnect, "failed disconnect retains its retry latch")
    local retried = env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(retried.ok, "later update retries disconnect successfully")
    gamma_arena_test_assert.equals(env.disconnected, 2, "disconnect is retried exactly until success")
end

local function runtime_task8_death_errors_defer_fatal_ui_to_update()
    local env = task8_environment({ death_error = true }); task8_pump_to_active(env)
    local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
    local failed = callbacks.npc_on_death_callback({ id = function() return env.registry.npcs[1].id end })
    gamma_arena_test_assert.is_false(failed.ok, "death processing failure remains a structured Result")
    gamma_arena_test_assert.equals(env.fatal_shown, 0, "death callback never opens fatal UI synchronously")
    gamma_arena_test_assert.is_true(env.orchestrator:is_active(), "death callback defers fatal state transition")
    callbacks.actor_on_update()
    gamma_arena_test_assert.equals(env.fatal_shown, 1, "next actor update opens fatal UI once")
    gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "deferred death error enters ERROR")
end

local function runtime_registered_death_owner_tag_failures_route_through_real_callback_router()
    local cases = {
        {
            label = "throw",
            install = function(deps) deps.load_tag = function() error("injected registered victim tag read throw") end end,
            code = "GA_ENTITY_TAG_READ_FAILED"
        },
        {
            label = "Result failure",
            install = function(deps) deps.load_tag = function() return gamma_arena_result.err("GA_TEST_TAG_READ_RESULT", "injected registered victim tag Result failure") end end,
            code = "GA_TEST_TAG_READ_RESULT"
        }
    }
    for _, case in ipairs(cases) do
        local entity_env, entity_deps = fake_entity_environment()
        local adapter = gamma_arena_entity_adapter.new(entity_deps)
        begin_entity_apply(adapter, entity_env, entity_spec(1), "ga_task8_session")
        local applied, active = pump_entity(adapter, entity_env)
        gamma_arena_test_assert.is_true(applied.ok and active.state == "ACTIVE", case.label .. " real adapter reaches ACTIVE")
        local victim_id = active.npcs[1].id
        case.install(entity_deps)

        local env = task8_environment()
        task8_pump_to_active(env)
        env.orchestrator.deps.entities = adapter
        env.orchestrator.deps.teardown = function()
            adapter:cleanup()
            return gamma_arena_result.ok(true)
        end
        local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
        local failed = callbacks.npc_on_death_callback({ id = function() return victim_id end })
        gamma_arena_test_assert.is_false(failed.ok, case.label .. " owner-tag failure remains structured")
        gamma_arena_test_assert.equals(failed.error.code, case.code, case.label .. " preserves the exact owner-tag failure")
        gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, case.label .. " never manufactures a registered death")
        gamma_arena_test_assert.equals(env.fatal_shown, 0, case.label .. " never opens fatal UI inside the death callback")
        callbacks.actor_on_update()
        gamma_arena_test_assert.equals(env.fatal_shown, 1, case.label .. " routes fatal UI on the next actor update")
        gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, case.label .. " enters ERROR")
        gamma_arena_test_assert.is_true(adapter:registry_snapshot().state ~= "ACTIVE", case.label .. " begins common safe cleanup")
    end
end

local function runtime_registered_death_mismatching_owner_tag_is_benign()
    local env, deps = fake_entity_environment({ allow_numeric_death = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-owner-mismatch")
    local applied, active = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(applied.ok and active.state == "ACTIVE", "owner mismatch fixture reaches ACTIVE")
    local victim_id = active.npcs[1].id
    env.tags[victim_id] = "foreign-session"
    local ignored = adapter:on_npc_death(victim_id)
    gamma_arena_test_assert.is_true(ignored.ok and ignored.value == false, "successful mismatching owner tag is benign")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "mismatching tag does not decrement living count")
end

local function runtime_fight_index_max_minus_one_advances_once()
    local victory = task8_environment()
    victory.orchestrator.session.fight_index = 4294967294
    task8_pump_to_active(victory)
    victory.orchestrator:npc_on_death_callback({ id = function() return victory.registry.npcs[1].id end })
    victory.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(victory.victory_dialogs[1].on_next().ok, "max-1 victory continuation starts")
    local advanced = gamma_arena_result.ok(true)
    for _ = 1, 5 do advanced = victory.orchestrator:actor_on_update() end
    gamma_arena_test_assert.is_true(advanced.ok, "max-1 victory continuation reaches the next preparation")
    gamma_arena_test_assert.equals(victory.orchestrator.session.fight_index, 4294967295, "max-1 victory advances exactly to uint32 max")

    local defeat = task8_environment()
    defeat.orchestrator.session.fight_index = 4294967294
    task8_pump_to_active(defeat)
    defeat.orchestrator:actor_on_before_death(77, { ret_value = true })
    defeat.orchestrator:actor_on_update()
    local requested = defeat.orchestrator:defeat_next_action()
    gamma_arena_test_assert.is_true(requested.ok, "max-1 defeat continuation persists once")
    gamma_arena_test_assert.equals(defeat.restore_calls, 1, "max-1 defeat submits one checkpoint restore")
    gamma_arena_test_assert.equals(defeat.restore_next_fight_index, 4294967295, "max-1 defeat targets uint32 max")
    gamma_arena_test_assert.is_true(defeat.orchestrator:defeat_next_action().ok, "repeated defeat continuation is an idempotent Result")
    gamma_arena_test_assert.equals(defeat.restore_calls, 1, "repeated max-1 defeat never resubmits restore")
end

local function runtime_fight_index_exhaustion_precedes_mutation_and_routes_fatal()
    local victory = task8_environment()
    victory.orchestrator.session.fight_index = 4294967295
    task8_pump_to_active(victory)
    victory.orchestrator:npc_on_death_callback({ id = function() return victory.registry.npcs[1].id end })
    victory.orchestrator:actor_on_update()
    local victory_failed = victory.orchestrator:victory_next_action()
    gamma_arena_test_assert.is_false(victory_failed.ok, "uint32-max victory is rejected")
    gamma_arena_test_assert.equals(victory_failed.error.code, "GA_FIGHT_INDEX_EXHAUSTED", "victory exhaustion code is stable")
    gamma_arena_test_assert.equals(victory.orchestrator.session.fight_index, 4294967295, "victory exhaustion does not mutate session index")
    gamma_arena_test_assert.equals(victory.orchestrator.runtime_stage, "RESULT", "victory exhaustion does not leave RESULT")
    gamma_arena_test_assert.is_false(victory.orchestrator.result_action_locked, "victory exhaustion does not acquire the result-action latch")
    gamma_arena_test_assert.equals(victory.reset_actor, 0, "victory exhaustion precedes actor mutation")

    local defeat = task8_environment()
    defeat.orchestrator.session.fight_index = 4294967295
    task8_pump_to_active(defeat)
    defeat.orchestrator:actor_on_before_death(77, { ret_value = true })
    defeat.orchestrator:actor_on_update()
    local defeat_failed = defeat.orchestrator:defeat_next_action()
    gamma_arena_test_assert.is_false(defeat_failed.ok, "uint32-max defeat is rejected")
    gamma_arena_test_assert.equals(defeat_failed.error.code, "GA_FIGHT_INDEX_EXHAUSTED", "defeat exhaustion code is stable")
    gamma_arena_test_assert.equals(defeat.orchestrator.session.fight_index, 4294967295, "defeat exhaustion does not mutate session index")
    gamma_arena_test_assert.equals(defeat.restore_calls, 0, "defeat exhaustion precedes checkpoint mutation")
    gamma_arena_test_assert.is_false(defeat.orchestrator.result_action_locked, "defeat exhaustion does not acquire the result-action latch")

    local routed = task8_environment()
    routed.orchestrator.session.fight_index = 4294967295
    task8_pump_to_active(routed)
    routed.orchestrator:npc_on_death_callback({ id = function() return routed.registry.npcs[1].id end })
    routed.orchestrator:actor_on_update()
    local first = routed.victory_dialogs[1].on_next()
    local repeated = routed.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_false(first.ok, "UI exhaustion reaches common result-error routing")
    gamma_arena_test_assert.is_true(repeated.ok and repeated.value == false, "repeated exhausted UI action is idempotent")
    gamma_arena_test_assert.equals(routed.fatal_shown, 1, "exhaustion opens fatal UI exactly once")
    gamma_arena_test_assert.equals(routed.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "exhaustion enters ERROR")
end

local function runtime_task8_result_action_failures_route_to_fatal()
    local cases = {
        { options = { clear_result_error = true }, action = "on_next", label = "clear result" },
        { options = { clear_intent_error = true }, action = "on_main_menu", label = "clear intent" },
        { options = { teardown_error = true }, action = "on_main_menu", label = "initial teardown" }
    }
    for _, case in ipairs(cases) do
        local env = task8_environment(case.options); task8_pump_to_active(env)
        env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
        local failed = env.victory_dialogs[1][case.action]()
        gamma_arena_test_assert.is_false(failed.ok, case.label .. " failure remains observable")
        gamma_arena_test_assert.equals(env.fatal_shown, 1, case.label .. " failure routes to fatal UI once")
        gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, case.label .. " failure enters ERROR")
    end
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    env.orchestrator.victory_next_action = function() error("injected result action exception") end
    local failed = env.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_false(failed.ok, "result action exception becomes a structured failure")
    gamma_arena_test_assert.equals(env.fatal_shown, 1, "result action exception routes to fatal UI once")
end

local function runtime_task8_inactive_cleanup_failures_route_to_fatal()
    local env = task8_environment({ teardown_pending_then_error = true }); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    local requested = env.victory_dialogs[1].on_main_menu()
    gamma_arena_test_assert.is_true(requested.ok, "ordinary cross-frame cleanup pending remains a success Result")
    gamma_arena_test_assert.equals(env.fatal_shown, 0, "pending cleanup never opens fatal UI")
    local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
    local failed = callbacks.actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "later inactive cleanup failure remains observable")
    gamma_arena_test_assert.equals(env.fatal_shown, 1, "inactive Arena cleanup failure routes to fatal UI")
    gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "inactive cleanup failure enters ERROR")
end

local function runtime_task8_clean_registry_requires_exact_empty_arrays()
    local cases = {
        { registry = { state = "CLEAN", npcs = { { id = 10 } }, items = {} }, label = "retained NPC" },
        { registry = { state = "CLEAN", npcs = {}, items = { { id = 11 } } }, label = "retained item" },
        { registry = { state = "CLEAN", items = {} }, label = "missing NPC array" },
        { registry = { state = "CLEAN", npcs = {} }, label = "missing item array" }
    }
    for _, case in ipairs(cases) do
        local env = task8_environment()
        env.registry = clone(case.registry)
        env.deps.checkpoint.current = "NONE"
        env.orchestrator.cleanup_required = true
        env.orchestrator.teardown_done = true
        local rejected = env.orchestrator:cleanup_ready_for_disconnect()
        gamma_arena_test_assert.is_false(rejected.ok, case.label .. " cannot prove exact cleanup")
        gamma_arena_test_assert.equals(rejected.error.code, "GA_RUNTIME_CLEANUP_FAILED", case.label .. " fails closed deterministically")
        gamma_arena_test_assert.is_true(env.orchestrator.cleanup_required, case.label .. " cannot open disconnect gate")
    end
end

local function runtime_task8_duplicate_result_clicks_are_idempotent()
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    local first = env.victory_dialogs[1].on_next()
    local duplicate = env.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_true(first.ok and first.value == true, "first result action owns the transition")
    gamma_arena_test_assert.is_true(duplicate.ok and duplicate.value == false, "duplicate result action is ignored")
end

local function runtime_task8_one_hundred_fights_leave_empty_registries()
    local env = task8_environment(); task8_pump_to_active(env)
    local seen, seen_entity_ids = {}, {}
    for fight = 1, 100 do
        local fight_id = env.orchestrator.fight_spec:fight_id()
        gamma_arena_test_assert.is_false(seen[fight_id], "fight_id must be unique across the simulated loop")
        seen[fight_id] = true
        gamma_arena_test_assert.is_true(#env.registry.npcs > 0, "every simulated fight owns registered NPC ids")
        gamma_arena_test_assert.is_true(#env.registry.items > 0, "every simulated fight owns registered item ids")
        for _, collection in ipairs({ env.registry.npcs, env.registry.items }) do
            for _, record in ipairs(collection) do
                gamma_arena_test_assert.is_false(seen_entity_ids[record.id], "next fight cannot reuse an old NPC/item id")
                seen_entity_ids[record.id] = true
            end
        end
        env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
        if fight < 100 then
            env.victory_dialogs[#env.victory_dialogs].on_next()
            env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
            gamma_arena_test_assert.equals(#env.registry.npcs, 0, "registry NPC ids are empty between fights")
            gamma_arena_test_assert.equals(#env.registry.items, 0, "registry item ids are empty between fights")
            env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
            env.now = env.now + 3000
            env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
        end
    end
    gamma_arena_test_assert.equals(env.generated, 100, "100 victories generate 100 deterministic FightSpecs")
    gamma_arena_test_assert.equals(env.checkpoint_create, 0, "successive victories never create campaign or replacement checkpoint saves")
    gamma_arena_test_assert.equals(env.reset_actor, 99, "actor reset remains responsive across every next-fight transition")
end

local function runtime_task9_ordinary_death_is_inert()
    local env = task8_environment()
    env.orchestrator.active = false
    local flags = { ret_value = true }
    gamma_arena_bootstrap.make_callbacks(env.orchestrator).actor_on_before_death(77, flags)
    gamma_arena_test_assert.is_true(flags.ret_value, "ordinary campaign death remains owned by the stock binder")
    gamma_arena_test_assert.equals(env.death_holds, 0, "ordinary death never mutates the actor")
end

local function runtime_task9_active_death_latches_and_defers_defeat()
    local env = task8_environment(); task8_pump_to_active(env)
    local first = { ret_value = true }
    local duplicate = { ret_value = true }
    local callbacks = gamma_arena_bootstrap.make_callbacks(env.orchestrator)
    callbacks.actor_on_before_death(77, first)
    callbacks.actor_on_before_death(77, duplicate)
    gamma_arena_test_assert.is_false(first.ret_value, "first ACTIVE death is intercepted")
    gamma_arena_test_assert.is_true(duplicate.ret_value, "latched duplicate death is not intercepted twice")
    gamma_arena_test_assert.equals(env.death_holds, 1, "logical death hold is acquired exactly once")
    gamma_arena_test_assert.equals(#env.defeat_dialogs, 0, "death callback never opens UI synchronously")
    callbacks.actor_on_update()
    gamma_arena_test_assert.equals(#env.defeat_dialogs, 1, "defeat opens on the next update")
    gamma_arena_test_assert.equals(env.defeat_dialogs[1].kind, "defeat", "single result model identifies defeat")
    gamma_arena_test_assert.equals(env.defeat_dialogs[1].title_key, "st_gamma_arena_result_defeat", "defeat title key is exact")
end

local function runtime_task9_death_outside_active_is_not_a_defeat()
    local env = task8_environment(); task8_pump_to_countdown(env)
    local flags = { ret_value = true }
    env.orchestrator:actor_on_before_death(77, flags)
    gamma_arena_test_assert.is_true(flags.ret_value, "COUNTDOWN death callback remains inert")
    gamma_arena_test_assert.equals(env.death_holds, 0, "non-ACTIVE callback cannot acquire a death hold")
end

local function runtime_task9_single_result_contract_maps_both_kinds()
    local victory = task8_environment(); task8_pump_to_active(victory)
    victory.orchestrator:npc_on_death_callback({ id = function() return victory.registry.npcs[1].id end })
    victory.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(victory.victory_dialogs[1].kind, "victory", "single result model identifies victory")
    gamma_arena_test_assert.equals(victory.victory_dialogs[1].title_key, "st_gamma_arena_result_victory", "victory title key is exact")
    gamma_arena_test_assert.is_true(type(victory.victory_dialogs[1].on_next) == "function", "victory exposes the shared next action")
    gamma_arena_test_assert.is_true(type(victory.victory_dialogs[1].on_main_menu) == "function", "victory exposes the shared main-menu action")
end

local function runtime_task9_countdown_escape_model_routes_main_menu_cleanup()
    local env = task8_environment(); task8_pump_to_countdown(env)
    local model = env.countdown_models[1]
    gamma_arena_test_assert.is_true(type(model) == "table" and model.value == 3, "countdown seam receives a structured model")
    gamma_arena_test_assert.is_true(type(model.on_main_menu) == "function", "countdown model exposes the common Arena main-menu action")
    local requested = model.on_main_menu()
    gamma_arena_test_assert.is_true(requested.ok, "countdown Escape action enters ordinary Arena main-menu cleanup")
    gamma_arena_test_assert.equals(env.clear_intent, 1, "countdown Escape clears only the matching Arena intent")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "CLEANING", "countdown Escape never silently closes the shared window")
    gamma_arena_test_assert.is_false(env.orchestrator:is_active(), "countdown Escape deactivates Arena before disconnect")
    env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.disconnected, 1, "countdown Escape disconnects only after common cleanup proof")

    local failed = task8_environment({ clear_countdown_error = true }); task8_pump_to_countdown(failed)
    local routed = failed.countdown_models[1].on_main_menu()
    gamma_arena_test_assert.is_false(routed.ok, "countdown Escape cleanup failure remains observable")
    gamma_arena_test_assert.equals(failed.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "countdown Escape cleanup errors route through the common fatal boundary")
    gamma_arena_test_assert.equals(failed.fatal_shown, 1, "countdown Escape cleanup error opens fatal UI once")
end

local function runtime_task9_resume_failures_normalize_to_restore_failed()
    local function resume_environment()
        local session = valid_session()
        local store = fake_store({ launch_pending = false, resume_pending = true })
        store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
        local deps = fake_orchestrator_deps(store)
        local orchestrator = gamma_arena_orchestrator.new(deps)
        orchestrator:load_state({ gamma_arena_session = session })
        orchestrator:on_game_load()
        return orchestrator, deps, store
    end
    local function assert_restore_failure(result, cause_code, label)
        gamma_arena_test_assert.is_false(result.ok, label .. " enters fatal routing")
        gamma_arena_test_assert.equals(result.error.code, "GA_CHECKPOINT_RESTORE_FAILED", label .. " exposes one top-level recovery contract")
        gamma_arena_test_assert.equals(result.error.context.cause.code, cause_code, label .. " preserves its exact cause code")
    end

    local missing, missing_deps = resume_environment()
    missing.loaded_session = nil
    assert_restore_failure(missing:actor_on_first_update(), "GA_RESUME_SESSION_MISSING", "missing embedded session")

    local preparation, preparation_deps, preparation_store = resume_environment()
    preparation_store.resume_result = gamma_arena_result.err("GA_RESUME_NONCE_MISMATCH", "injected preparation mismatch")
    assert_restore_failure(preparation:actor_on_first_update(), "GA_RESUME_NONCE_MISMATCH", "prepared intent mismatch")

    local malformed, malformed_deps, malformed_store = resume_environment()
    malformed_store.resume_result = gamma_arena_result.ok("not-an-intent")
    assert_restore_failure(malformed:actor_on_first_update(), "GA_RESUME_INVALID", "malformed prepared intent")

    local binding, binding_deps = resume_environment()
    binding_deps.checkpoint.begin_resume_recovery = function() return gamma_arena_result.err("GA_CHECKPOINT_RECOVERY_MISSING", "injected checkpoint binding failure") end
    assert_restore_failure(binding:actor_on_first_update(), "GA_CHECKPOINT_RECOVERY_MISSING", "checkpoint binding failure")

    local refused, refused_deps = resume_environment()
    refused_deps.checkpoint.begin_resume_recovery = function() return gamma_arena_result.ok(false) end
    assert_restore_failure(refused:actor_on_first_update(), "GA_CHECKPOINT_RECOVERY_FAILED", "checkpoint binding refusal")

    local missing_resume, missing_resume_deps = resume_environment()
    missing_resume_deps.checkpoint.take_resume = function() return gamma_arena_result.err("GA_CHECKPOINT_RESUME_MISSING", "injected missing resume") end
    gamma_arena_test_assert.is_true(missing_resume:actor_on_first_update().ok, "missing resume fixture enters re-hide")
    missing_resume:actor_on_update()
    assert_restore_failure(missing_resume:actor_on_update(), "GA_CHECKPOINT_RESUME_MISSING", "missing completed resume")

    local mismatched, mismatched_deps = resume_environment()
    mismatched_deps.checkpoint.take_resume = function() return gamma_arena_result.ok({ next_fight_index = 99 }) end
    gamma_arena_test_assert.is_true(mismatched:actor_on_first_update().ok, "mismatch fixture enters re-hide")
    mismatched:actor_on_update()
    assert_restore_failure(mismatched:actor_on_update(), "GA_CHECKPOINT_RECOVERY_MISMATCH", "completed resume mismatch")
end

local function runtime_task9_resume_pending_invalid_loaded_session_normalizes()
    local invalid_payload = { schema_version = 99 }
    local resume_store = fake_store({ launch_pending = false, resume_pending = true })
    local resume_orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(resume_store))
    local decoded = resume_orchestrator:load_state({ gamma_arena_session = invalid_payload })
    gamma_arena_test_assert.is_false(decoded.ok, "malformed loaded ArenaSession is captured before activation")
    gamma_arena_test_assert.equals(decoded.error.code, "GA_SESSION_SCHEMA_INVALID", "malformed fixture has the exact validation cause")
    resume_orchestrator:on_game_load()
    local resume_failed = resume_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(resume_failed.ok, "pending ResumeIntent rejects malformed loaded ArenaSession")
    gamma_arena_test_assert.equals(resume_failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "pending resume exposes the stable checkpoint recovery boundary")
    gamma_arena_test_assert.equals(resume_failed.error.context.cause.code, "GA_SESSION_SCHEMA_INVALID", "pending resume preserves the loaded-session validation cause")

    local launch_store = fake_store({ launch_pending = true, resume_pending = false })
    local launch_orchestrator = gamma_arena_orchestrator.new(fake_orchestrator_deps(launch_store))
    launch_orchestrator:load_state({ gamma_arena_session = invalid_payload })
    launch_orchestrator:on_game_load()
    local launch_failed = launch_orchestrator:actor_on_first_update()
    gamma_arena_test_assert.is_false(launch_failed.ok, "ordinary launch still rejects malformed loaded metadata")
    gamma_arena_test_assert.equals(launch_failed.error.code, "GA_SESSION_SCHEMA_INVALID", "non-resume activation retains its original validation code")
end

local function runtime_task9_restoring_state_read_failure_normalizes()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "RESTORING fault fixture activates a pending resume")
    orchestrator.runtime_stage = "RESTORING"
    deps.checkpoint.current = "LOADING"
    deps.checkpoint.state = function() error("injected RESTORING state read failure") end
    local failed = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "RESTORING state-read exception remains observable")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "RESTORING state-read exception uses the stable recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_CHECKPOINT_STATE_FAILED", "RESTORING state-read exception preserves its exact cause")
end

local function runtime_task9_resume_completion_transition_failure_normalizes()
    local session = valid_session()
    local store = fake_store({ launch_pending = false, resume_pending = true })
    store.resume_result = gamma_arena_result.ok({ schema_version = 1, session_id = session.session_id, session_nonce = session.session_nonce, next_fight_index = 1, checkpoint_name = session.checkpoint_name })
    local deps = fake_orchestrator_deps(store)
    local orchestrator = gamma_arena_orchestrator.new(deps)
    orchestrator:load_state({ gamma_arena_session = session })
    orchestrator:on_game_load()
    gamma_arena_test_assert.is_true(orchestrator:actor_on_first_update().ok, "transition fault fixture enters resume re-hide")
    local original_advance = orchestrator.advance
    orchestrator.advance = function(self, event)
        if self.runtime_stage == "RESUME_REHIDING" and event == gamma_arena_state_machine.events.CHECKPOINT_SUCCEEDED then
            return gamma_arena_result.err("GA_TEST_RESUME_TRANSITION", "injected resume completion transition failure")
        end
        return original_advance(self, event)
    end
    gamma_arena_test_assert.is_true(orchestrator:actor_on_update().ok, "first re-hide poll remains pending")
    local failed = orchestrator:actor_on_update()
    gamma_arena_test_assert.is_false(failed.ok, "resume completion transition failure remains observable")
    gamma_arena_test_assert.equals(failed.error.code, "GA_CHECKPOINT_RESTORE_FAILED", "resume completion transition uses the stable recovery boundary")
    gamma_arena_test_assert.equals(failed.error.context.cause.code, "GA_TEST_RESUME_TRANSITION", "resume completion transition preserves its exact cause")
end

local function runtime_task9_defeat_next_persists_before_cleanup_and_never_replays_lost_spec()
    local env = task8_environment(); task8_pump_to_active(env)
    local generated_before = env.generated
    local flags = { ret_value = true }
    env.orchestrator:actor_on_before_death(77, flags); env.orchestrator:actor_on_update()
    env.defeat_dialogs[1].on_next(); env.defeat_dialogs[1].on_next()
    gamma_arena_test_assert.equals(env.restore_calls, 1, "repeated actions start one checkpoint load")
    gamma_arena_test_assert.equals(env.restore_next_fight_index, env.orchestrator.session.fight_index + 1, "intent carries the next fight index")
    env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
    gamma_arena_test_assert.is_true(env.events[#env.events - 4] == "intent", "ResumeIntent is persisted before recovery mutation")
    gamma_arena_test_assert.equals(table.concat(env.events, ",", #env.events - 3, #env.events), "clear_ui,cleanup,actor_cleanup,load", "UI, entity, and actor-loadout cleanup all precede checkpoint load")
    gamma_arena_test_assert.equals(env.actor_loadout_cleanup, 1, "lost actor loadout cleanup is proven exactly once before load")
    gamma_arena_test_assert.is_false(env.actor_loadout_owned, "no stale owned actor item id survives into checkpoint load")
    gamma_arena_test_assert.equals(env.generated, generated_before, "lost FightSpec is never regenerated before clean reload")
end

local function runtime_task9_defeat_reloads_consumes_intent_and_reaches_new_active()
    local env = task8_environment(); task8_pump_to_active(env)
    local owned = actor_loadout_ownership_fixture({ next_id = 1200 })
    gamma_arena_test_assert.is_true(owned.applied.ok and #owned.applied.value.created_ids > 0, "integrated defeat fixture owns a non-empty tagged actor loadout")
    for id in pairs(owned.current) do owned.current[id] = nil end
    env.deps.actor.cleanup_loadout_for_restore = function()
        env.actor_loadout_cleanup = env.actor_loadout_cleanup + 1
        env.events[#env.events + 1] = "actor_cleanup"
        local cleaned = owned.port.cleanup()
        if cleaned.ok and not (type(cleaned.value) == "table" and cleaned.value.pending == true) then env.actor_loadout_owned = false end
        return cleaned
    end
    local saved = env.orchestrator:session_snapshot()
    local flags = { ret_value = true }
    env.orchestrator:actor_on_before_death(77, flags); env.orchestrator:actor_on_update()
    env.defeat_dialogs[1].on_next()
    env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
    env.orchestrator:actor_on_net_destroy()
    env.orchestrator:load_state({ gamma_arena_session = saved })
    env.orchestrator:on_game_load()
    env.orchestrator:actor_on_first_update()
    for _ = 1, 4 do env.orchestrator:actor_on_update() end
    env.now = env.now + 3000
    env.orchestrator:actor_on_update(); env.orchestrator:actor_on_update()
    gamma_arena_test_assert.equals(env.orchestrator.session.fight_index, saved.fight_index + 1, "restored session uses ResumeIntent next index")
    gamma_arena_test_assert.equals(env.generated, 2, "clean reload generates exactly one new FightSpec")
    gamma_arena_test_assert.equals(env.orchestrator:runtime_stage_snapshot(), "ACTIVE", "defeat-next reaches a new ACTIVE fight")
    gamma_arena_test_assert.equals(env.death_hold_releases, 1, "restored actor releases only logical-death invulnerability")
    gamma_arena_test_assert.is_true(env.actor_loadout_owned, "new ACTIVE fight owns only its newly applied actor loadout")
    gamma_arena_test_assert.equals(#owned.releases, 0, "defeat recovery retires consumed absent actor ids without submitting a release")
end

local function runtime_task9_defeat_and_victory_share_main_menu_cleanup()
    local env = task8_environment(); task8_pump_to_active(env)
