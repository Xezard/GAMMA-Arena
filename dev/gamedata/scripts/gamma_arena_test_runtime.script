function run(run_case_fn)
    local all_passed = true
    if not run_case_fn('runtime_bootstrap_default_store_exposes_complete_launch_contract', lifecycle.bootstrap_default_store_exposes_complete_launch_contract) then all_passed = false end
    if not run_case_fn('runtime_missing_dependency_method_routes_fatal_once', lifecycle.missing_dependency_method_routes_fatal_once) then all_passed = false end
    for index = 1, #cases do
        local case = cases[index]
        if not run_case_fn(case.name, case.fn) then all_passed = false end
    end
    return all_passed
end
