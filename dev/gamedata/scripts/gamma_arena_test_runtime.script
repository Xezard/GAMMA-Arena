local function runtime_entity_multi_return_ammo_is_exact()
    local env, deps = fake_entity_environment({ multi_return_ammo = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-ammo")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "multi-return ammo transaction completes")
    local ammo_records, ammo_quantity = 0, 0
    for _, item in ipairs(snapshot.items) do
        if item.section == "ammo_9x18_fmj" then ammo_records = ammo_records + 1; ammo_quantity = ammo_quantity + item.quantity end
    end
    gamma_arena_test_assert.equals(ammo_records, 2, "every server entity returned for ammo is registered")
    gamma_arena_test_assert.equals(ammo_quantity, 60, "three ammo boxes at effective box_size 20 become exactly sixty rounds")
    local expected = {
        { section = "wpn_pm", count = 1, is_ammo = false },
        { section = "ammo_9x18_fmj", count = 60, is_ammo = true },
        { section = "novice_outfit", count = 1, is_ammo = false },
        { section = "bandage", count = 1, is_ammo = false },
        { section = "medkit", count = 1, is_ammo = false }
    }
    gamma_arena_test_assert.equals(#env.create_item_calls, #expected, "the validated loadout creates exactly its five descriptors")
    for index, descriptor in ipairs(expected) do
        local call = env.create_item_calls[index]
        gamma_arena_test_assert.equals(call.section, descriptor.section, "descriptor order and section stay exact")
        gamma_arena_test_assert.equals(call.count, descriptor.count, "descriptor quantity stays exact")
        gamma_arena_test_assert.equals(call.is_ammo, descriptor.is_ammo, "only ammo uses the engine ammo property path")
    end
end

local function runtime_actor_loadout_derives_unreadable_server_ammo_quantity()
    local next_id, ammo_entities, tags = 700, 0, {}
    local function entity(section, parent_id)
        local value = { runtime_id = next_id, section_name = section, parent_id = parent_id }
        next_id = next_id + 1
        function value:id() return self.runtime_id end
        return value
    end
    local port = gamma_arena_bootstrap.new_actor_loadout_port({
        clock = function() return 100 end,
        actor_id = function(actor) return actor:id() end,
        ownership_token = function() return "session-unreadable-ammo" end,
        ammo_box_size = function() return 20 end,
        create_item = function(section, actor, count, is_ammo)
            if is_ammo then
                ammo_entities = ammo_entities + 2
                return { entity(section, actor:id()), entity(section, actor:id()) }
            end
            return entity(section, actor:id())
        end,
        entity_id = function(value) return value:id() end,
        entity_parent_id = function(value) return value.parent_id end,
        entity_section = function(value) return value.section_name end,
        item_quantity = function(_, is_ammo) return is_ammo and nil or 1 end,
        save_owner_tag = function(id, token) tags[id] = token; return true end,
        load_owner_tag = function(id) return tags[id] end
    })
    local actor = { id = function() return 77 end }
    local result = port.apply(actor, entity_spec(1).actor().loadout)
    gamma_arena_test_assert.is_true(result.ok, "actor loadout derives exact ammo allocation when server quantity is unavailable")
    gamma_arena_test_assert.equals(ammo_entities, 2, "forty actor rounds are represented by two effective twenty-round boxes")
end

local function runtime_entity_derives_unreadable_server_ammo_quantity()
    local env, deps = fake_entity_environment({ engine_split_ammo = true, ammo_quantity_unavailable = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-unreadable-ammo")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "opponent loadout derives exact ammo allocation when server quantity is unavailable")
    local ammo_records, ammo_quantity = 0, 0
    for _, item in ipairs(snapshot.items) do
        if item.section == "ammo_9x18_fmj" then
            ammo_records = ammo_records + 1
            ammo_quantity = ammo_quantity + item.quantity
        end
    end
    gamma_arena_test_assert.equals(ammo_records, 3, "every unreadable server ammo entity is registered")
    gamma_arena_test_assert.equals(ammo_quantity, 60, "derived opponent ammo quantities still total the exact FightSpec rounds")
end

local function runtime_entity_death_dropped_is_persisted_and_round_tripped()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(2), "session-death-dropped")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "ACTIVE", "death-manager suppression flag allows activation only after round-trip")
    gamma_arena_test_assert.equals(env.death_flag_writes, 2, "death_dropped is persisted once for every newly registered NPC")
    gamma_arena_test_assert.equals(env.death_flag_reads, 2, "death_dropped is round-tripped once for every newly registered NPC")
    for _, npc in ipairs(snapshot.npcs) do
        gamma_arena_test_assert.is_true(npc.death_dropped and env.death_flags[npc.id] == true, "registry records the verified runtime death_dropped flag")
    end

    local failed_env, failed_deps = fake_entity_environment({ death_flag_roundtrip_false = true })
    local failed_adapter = gamma_arena_entity_adapter.new(failed_deps)
    begin_entity_apply(failed_adapter, failed_env, entity_spec(1), "session-death-dropped-fail")
    local failed, failed_snapshot = pump_entity(failed_adapter, failed_env)
    gamma_arena_test_assert.is_false(failed.ok, "death_dropped round-trip mismatch fails closed")
    gamma_arena_test_assert.equals(failed_snapshot.state, "ERROR", "unverified death-manager suppression rolls back transaction")
end

local function runtime_entity_multi_return_late_failure_is_fully_registered()
    local env, deps = fake_entity_environment({ multi_return_ammo = true, multi_return_second_section = "ammo_wrong" })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-multi-late")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_false(result.ok, "late multi-return inspection failure rolls back")
    gamma_arena_test_assert.equals(snapshot.state, "ERROR", "late multi-return failure is terminal after cleanup")
    gamma_arena_test_assert.equals(#snapshot.items, 3, "weapon and both returned ammo entities entered the provisional registry")
    local expected = { 103, 102, 101, 100 }
    gamma_arena_test_assert.equals(#env.release_requests, #expected, "every created entity is released after late multi-return failure")
    for index, id in ipairs(expected) do gamma_arena_test_assert.equals(env.release_requests[index], id, "late multi-return rollback stays reverse-ordered") end
end

local function runtime_entity_multi_return_invalid_or_duplicate_id_rolls_back_every_owned_creation()
    for _, case in ipairs({
        { label = "late invalid id", option = "multi_return_late_invalid_id" },
        { label = "duplicate id", option = "multi_return_duplicate_id" }
    }) do
        local options = {}; options[case.option] = true
        local env, deps = fake_entity_environment(options)
        local adapter = gamma_arena_entity_adapter.new(deps)
        begin_entity_apply(adapter, env, entity_spec(1), "session-multi-id-" .. case.option)
        local result, snapshot = pump_entity(adapter, env)
        gamma_arena_test_assert.is_false(result.ok, case.label .. " fails the entity transaction")
        gamma_arena_test_assert.equals(snapshot.state, "ERROR", case.label .. " completes rollback before surfacing ERROR")
        gamma_arena_test_assert.equals(env.tag_writes, 3, case.label .. " authorizes the first newly returned ammo id before inspecting the later value")
        gamma_arena_test_assert.equals(env.tags[102], "session-multi-id-" .. case.option, case.label .. " tags only the first newly created occurrence")
        local expected = { 102, 101, 100 }
        gamma_arena_test_assert.equals(#env.release_requests, #expected, case.label .. " releases every valid newly created id exactly once")
        for index, id in ipairs(expected) do
            gamma_arena_test_assert.equals(env.release_requests[index], id, case.label .. " rollback remains exact reverse creation order")
            gamma_arena_test_assert.equals(env.objects[id], nil, case.label .. " leaves no valid created entity behind")
        end
    end
end

local function runtime_entity_registry_is_plain_ids_only()
    local env, deps = fake_entity_environment({ multi_return_ammo = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-plain"); pump_entity(adapter, env)
    local snapshot = adapter:registry_snapshot()
    local function assert_plain(value)
        local kind = type(value)
        gamma_arena_test_assert.is_true(kind == "nil" or kind == "string" or kind == "number" or kind == "boolean" or kind == "table", "registry snapshot contains plain Lua values only")
        if kind == "table" then for key, item in pairs(value) do assert_plain(key); assert_plain(item) end end
    end
    assert_plain(snapshot)
    for _, npc in ipairs(snapshot.npcs) do gamma_arena_test_assert.is_true(type(npc.id) == "number", "registry persists NPC ids, never server userdata") end
end

local function runtime_entity_cleanup_requires_registry_and_tag()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-owned"); pump_entity(adapter, env)
    local foreign = env:add_entity("foreign", nil, 1, 9000); env.tags[foreign:id()] = "session-owned"
    adapter:cleanup(); local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "CLEAN", "registered and tagged entities clean successfully")
    gamma_arena_test_assert.is_true(env.objects[9000] ~= nil, "tag alone never authorizes release")
end

local function runtime_entity_forged_tag_is_ignored()
    return runtime_entity_cleanup_requires_registry_and_tag()
end

local function runtime_entity_tag_loss_fails_safe()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-tag-loss"); pump_entity(adapter, env)
    local snapshot = adapter:registry_snapshot(); local protected_id = snapshot.items[1].id; env.tags[protected_id] = nil
    adapter:cleanup(); local result, final_snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_false(result.ok, "lost ownership tag makes cleanup fail safely")
    gamma_arena_test_assert.equals(final_snapshot.state, "ERROR", "tag loss reaches a terminal safe error")
    gamma_arena_test_assert.is_true(env.objects[protected_id] ~= nil, "tag-lost registered entity is never released")
end

local function runtime_entity_parent_release_blocks_unproven_children()
    local env, deps = fake_entity_environment({ cascade_parent_release = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-parent-proof"); pump_entity(adapter, env)
    local npc_id = adapter:registry_snapshot().npcs[1].id
    local foreign = env:add_entity("foreign_loot", npc_id, 1, 9001)
    env.tags[foreign:id()] = "session-parent-proof"
    adapter:cleanup(); local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_false(result.ok, "foreign child blocks potentially cascading parent release")
    gamma_arena_test_assert.equals(snapshot.error.code, "GA_ENTITY_CLEANUP_FAILED", "blocked parent release is aggregated safely")
    gamma_arena_test_assert.is_true(env.objects[npc_id] ~= nil and env.objects[foreign:id()] ~= nil, "NPC and unproven child both remain protected")
    for _, id in ipairs(env.release_requests) do gamma_arena_test_assert.is_true(id ~= npc_id, "blocked NPC is never submitted to safe release") end
end

local function runtime_entity_cleanup_retires_vanished_owned_child()
    local env, deps = fake_entity_environment({ cascade_parent_release = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-owned-child-vanished"); pump_entity(adapter, env)
    local snapshot = adapter:registry_snapshot()
    local npc_id = snapshot.npcs[1].id
    local child_id = snapshot.items[1].id
    env.objects[child_id] = nil
    env.online[child_id] = nil
    adapter:cleanup(); local result, final_snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and final_snapshot.state == "CLEAN", "vanished registered tagged child cannot block actor-death cleanup")
    gamma_arena_test_assert.equals(env.objects[npc_id], nil, "parent NPC is released after proved owned child retirement")
    for _, id in ipairs(env.release_requests) do gamma_arena_test_assert.is_true(id ~= child_id, "already absent owned child is never submitted for release") end
end

local function runtime_entity_parent_release_blocks_unreadable_child_parent()
    local cases = {
        { label = "missing", mutate = function(env, child) env.objects[child:id()] = nil end, child_remains = false },
        { label = "nil", mutate = function(_, child) child.parent_id = nil end },
        { label = "non-number", mutate = function(_, child) child.parent_id = "unknown" end },
        { label = "throwing", mutate = function(_, child) child.parent_id = function() error("injected parent read failure") end end }
    }
    for _, case in ipairs(cases) do
        local env, deps = fake_entity_environment({ cascade_parent_release = true })
        local adapter = gamma_arena_entity_adapter.new(deps)
        begin_entity_apply(adapter, env, entity_spec(1), "session-parent-unreadable-" .. case.label); pump_entity(adapter, env)
        local npc_id = adapter:registry_snapshot().npcs[1].id
        local child = env:add_entity("foreign_loot", npc_id, 1, 9001)
        case.mutate(env, child)
        adapter:cleanup(); local result, snapshot = pump_entity(adapter, env)
        gamma_arena_test_assert.is_false(result.ok, case.label .. " child parent proof blocks cleanup")
        gamma_arena_test_assert.equals(snapshot.state, "ERROR", case.label .. " child parent proof fails closed")
        gamma_arena_test_assert.is_true(env.objects[npc_id] ~= nil, case.label .. " parent remains protected from cascading release")
        if case.child_remains ~= false then gamma_arena_test_assert.is_true(env.objects[9001] ~= nil, case.label .. " unreadable child remains protected") end
        for _, id in ipairs(env.release_requests) do gamma_arena_test_assert.is_true(id ~= npc_id, case.label .. " unreadable child parent never permits NPC release") end
    end

    local env, deps = fake_entity_environment({ cascade_parent_release = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-parent-explicit-foreign"); pump_entity(adapter, env)
    local npc_id = adapter:registry_snapshot().npcs[1].id
    local child = env:add_entity("foreign_loot", npc_id, 1, 9001)
    child.parent_id = 7777
    adapter:cleanup(); local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(result.ok and snapshot.state == "CLEAN", "valid explicit foreign parent proves the authoritative child moved away")
    gamma_arena_test_assert.equals(env.objects[npc_id], nil, "explicit foreign parent permits owned NPC release")
    gamma_arena_test_assert.is_true(env.objects[9001] ~= nil, "explicit foreign-parent child is not released or deleted indirectly")
    for _, id in ipairs(env.release_requests) do gamma_arena_test_assert.is_true(id ~= 9001, "explicit foreign-parent child is never submitted to safe release") end
end

local function runtime_entity_cleanup_is_idempotent()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-clean"); pump_entity(adapter, env)
    adapter:cleanup(); local cleaned, clean_snapshot = pump_entity(adapter, env); local release_count = #env.release_requests
    gamma_arena_test_assert.is_true(cleaned.ok and clean_snapshot.state == "CLEAN", "normal asynchronous cleanup proves absence and ends CLEAN")
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "repeated cleanup is benign")
    pump_entity(adapter, env)
    gamma_arena_test_assert.equals(#env.release_requests, release_count, "repeated cleanup never releases twice")
end

local function runtime_entity_wounded_cleanup_holds_offline_before_release()
    local env, deps = fake_entity_environment({ online_release_requires_offline = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-wounded-cleanup")
    pump_entity(adapter, env)
    local npc = adapter:registry_snapshot().npcs[1]
    env.online[npc.id].critical_value = true
    env:advance(250); adapter:update()
    env:advance(1500); adapter:update()
    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "DEFEATED_WOUNDED", "fixture proves stable wound")

    env.events = {}
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "wounded cleanup starts")
    local cleaned, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(cleaned.ok and snapshot.state == "CLEAN", "offline wound cleanup reaches exact CLEAN")
    local held_index, release_index = nil, nil
    for index, event in ipairs(env.events) do
        if event == "hold_offline:" .. tostring(npc.id) then held_index = index end
        if release_index == nil and string.find(event, "release:", 1, true) == 1 then release_index = index end
    end
    gamma_arena_test_assert.is_true(held_index ~= nil and held_index < release_index, "wounded NPC is offline before first release")
end

local function runtime_entity_living_defeat_cleanup_holds_offline()
    local env, deps = fake_entity_environment({ online_release_requires_offline = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(2), "session-living-cleanup")
    pump_entity(adapter, env)
    local npc_id = adapter:registry_snapshot().npcs[1].id
    gamma_arena_test_assert.is_true(adapter:neutralize_owned_opponents().ok, "living opponents are neutralized after actor death")
    env.events = {}
    adapter:cleanup()
    local cleaned, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(cleaned.ok and snapshot.state == "CLEAN", "neutralized living opponents clean after offline hold")
    local held_index, release_index = nil, nil
    for index, event in ipairs(env.events) do
        if event == "hold_offline:" .. tostring(npc_id) then held_index = index end
        if release_index == nil and string.find(event, "release:", 1, true) == 1 then release_index = index end
    end
    gamma_arena_test_assert.is_true(held_index ~= nil and held_index < release_index, "living actor-death-neutralized NPC is offline before first release")
end

local function runtime_entity_cleanup_quiesce_failure_is_terminal_without_release()
    local env, deps = fake_entity_environment({ online_release_requires_offline = true })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-quiesce-failure")
    pump_entity(adapter, env)
    local npc_id = adapter:registry_snapshot().npcs[1].id
    deps.hold_offline = function()
        return gamma_arena_result.err("GA_TEST_OFFLINE_HOLD", "injected cleanup offline-hold failure")
    end
    env.release_requests = {}
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "quiesce-failure cleanup starts")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_false(result.ok, "offline-hold failure is terminal")
    gamma_arena_test_assert.equals(snapshot.state, "ERROR", "offline-hold failure reaches ERROR")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "quiesce failure submits no cleanup release")
    local leaf = snapshot.error.context.errors[1]
    gamma_arena_test_assert.equals(leaf.code, "GA_ENTITY_CLEANUP_QUIESCE_FAILED", "quiesce failure is normalized")
    gamma_arena_test_assert.equals(leaf.context.entity_id, npc_id, "quiesce leaf keeps the NPC id")
    gamma_arena_test_assert.equals(leaf.context.cleanup_phase, "quiesce", "quiesce leaf keeps cleanup phase")
end

local function runtime_entity_post_request_online_failure_requiesces_before_release()
    local env, deps = fake_entity_environment({
        fail_phase = "request_online",
        hold_offline_fails_after_online_request = true
    })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-post-request-offline")
    local result, snapshot = pump_entity(adapter, env)
    gamma_arena_test_assert.is_false(result.ok, "post-request activation failure remains terminal")
    gamma_arena_test_assert.equals(snapshot.state, "ERROR", "post-request activation failure reaches ERROR")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "cleanup requires a fresh offline hold after a post-side-effect online request")
    local leaf = snapshot.error.context.errors[1]
    gamma_arena_test_assert.equals(leaf.code, "GA_ENTITY_CLEANUP_QUIESCE_FAILED", "fresh offline-hold failure is retained as the cleanup leaf")
end

local function runtime_entity_cleanup_error_accumulator_rejects_malformed_and_cyclic_errors()
    local cases = {
        { label = "non-table", make_error = function() return "not-an-error-table" end },
        { label = "cyclic", make_error = function()
            local error_value = { code = "GA_TEST_CYCLIC", message = "cyclic dependency error", context = {} }
            error_value.context.self = error_value.context
            return error_value
        end }
    }
    for _, case in ipairs(cases) do
        local env, deps = fake_entity_environment()
        local adapter = gamma_arena_entity_adapter.new(deps)
        begin_entity_apply(adapter, env, entity_spec(1), "session-cleanup-error-" .. case.label)
        pump_entity(adapter, env)
        deps.entity_exists = function()
            return { ok = false, error = case.make_error() }
        end
        gamma_arena_test_assert.is_true(adapter:cleanup().ok, case.label .. " cleanup starts")
        local result, snapshot = pump_entity(adapter, env)
        gamma_arena_test_assert.is_false(result.ok, case.label .. " dependency error remains terminal rather than throwing")
        gamma_arena_test_assert.equals(snapshot.state, "ERROR", case.label .. " cleanup reaches ERROR")
        gamma_arena_test_assert.equals(snapshot.error.code, "GA_ENTITY_CLEANUP_FAILED", case.label .. " preserves aggregate cleanup error")
        local leaf = snapshot.error.context.errors[1]
        gamma_arena_test_assert.equals(leaf.code, "GA_ENTITY_CLEANUP_FAILED", case.label .. " uses deterministic plain fallback leaf")
        gamma_arena_test_assert.equals(leaf.context.cleanup_phase, "existence", case.label .. " fallback leaf retains cleanup phase")
        gamma_arena_test_assert.equals(leaf.context.session_id, "session-cleanup-error-" .. case.label, case.label .. " fallback leaf retains session")
        gamma_arena_test_assert.equals(env.tactical_warnings[#env.tactical_warnings], "GA_ENTITY_CLEANUP_FAILED", case.label .. " fallback leaf is logged")
    end
end

local function runtime_entity_lifecycle_cleanup_takes_over_mid_rollback()
    local env, deps = fake_entity_environment({ fail_phase = "item", fail_item_at = 2, release_delay = 3 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-mid-rollback")
    local failed = adapter:update()
    gamma_arena_test_assert.is_true(failed.ok, "transaction failure starts deferred rollback without blocking the engine callback")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "ROLLING_BACK", "fixture begins lifecycle teardown while rollback release is pending")
    local context, result = {}, nil
    for _ = 1, 64 do
        result = gamma_arena_bootstrap.step_entity_cleanup(adapter, context, {
            clock = function() return env.now end,
            timeout_ms = 1000,
            max_updates = 64
        })
        gamma_arena_test_assert.is_true(result.ok, "lifecycle cleanup owns and advances the in-flight rollback")
        if result.value.pending ~= true then break end
        env:advance(1)
    end
    gamma_arena_test_assert.is_true(result.ok and result.value.pending == false, "mid-rollback lifecycle teardown reaches CLEAN instead of resurfacing the superseded transaction error")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "CLEAN", "entity cleanup no longer strands later teardown stages behind ERROR")
end

local function runtime_entity_lifecycle_cleanup_takes_over_stopping()
    local env, deps = fake_entity_environment({ tactical_stop_failures = 2 })
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-stopping-takeover")
    pump_entity(adapter, env)
    gamma_arena_test_assert.is_true(adapter:cleanup().ok, "cleanup takes ownership of the first tactical-stop failure")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "STOPPING", "fixture enters retryable STOPPING")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "initial STOPPING state submits no release")

    local context = {}
    local first = gamma_arena_bootstrap.step_entity_cleanup(adapter, context, {
        clock = function() return env.now end,
        timeout_ms = 1000,
        max_updates = 16
    })
    gamma_arena_test_assert.is_true(first.ok and first.value.pending == true, "lifecycle cleanup accepts STOPPING as cross-frame pending")
    gamma_arena_test_assert.equals(env.tactical_stop_calls, 2, "lifecycle cleanup retries tactical stop while STOPPING")
    gamma_arena_test_assert.equals(#env.release_requests, 0, "failed STOPPING retry still submits no release")

    env:advance(1)
    local second = gamma_arena_bootstrap.step_entity_cleanup(adapter, context, {
        clock = function() return env.now end,
        timeout_ms = 1000,
        max_updates = 16
    })
    gamma_arena_test_assert.is_true(second.ok and second.value.pending == true, "lifecycle cleanup remains cross-frame after STOPPING retry succeeds")
    gamma_arena_test_assert.equals(env.tactical_stop_calls, 3, "successful STOPPING retry is observed")
    gamma_arena_test_assert.is_true(#env.release_requests > 0, "release starts only after tactical stop succeeds")

    local settled = second
    for _ = 1, 16 do
        if settled.value.pending ~= true then break end
        env:advance(1)
        settled = gamma_arena_bootstrap.step_entity_cleanup(adapter, context, {
            clock = function() return env.now end,
            timeout_ms = 1000,
            max_updates = 16
        })
    end
    gamma_arena_test_assert.is_true(settled.ok and settled.value.pending == false, "STOPPING lifecycle takeover reaches exact CLEAN within its existing budget")
    gamma_arena_test_assert.equals(adapter:registry_snapshot().state, "CLEAN", "STOPPING lifecycle takeover ends CLEAN")
end

local function runtime_entity_existence_result_must_be_boolean()
