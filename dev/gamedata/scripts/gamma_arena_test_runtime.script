    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 0, "terminal wounded opponent no longer blocks victory")
    gamma_arena_test_assert.equals(#env.tactical_death_slots, 1, "terminal transition notifies tactical ownership once")
