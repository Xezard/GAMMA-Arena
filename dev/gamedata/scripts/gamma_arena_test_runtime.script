    local advanced = gamma_arena_result.ok(true)
    for _ = 1, 5 do advanced = victory.orchestrator:actor_on_update() end
    gamma_arena_test_assert.is_true(advanced.ok, "max-1 victory continuation reaches the next preparation")
    gamma_arena_test_assert.equals(victory.orchestrator.session.fight_index, 4294967295, "max-1 victory advances exactly to uint32 max")

end

local function runtime_fight_index_exhaustion_precedes_mutation_and_routes_fatal()
    local victory = task8_environment()
    victory.orchestrator.session.fight_index = 4294967295
    task8_pump_to_active(victory)
    victory.orchestrator:npc_on_death_callback({ id = function() return victory.registry.npcs[1].id end })
    victory.orchestrator:actor_on_update()
    local victory_failed = victory.orchestrator:victory_next_action()
    gamma_arena_test_assert.is_false(victory_failed.ok, "uint32-max victory is rejected")
    gamma_arena_test_assert.equals(victory_failed.error.code, "GA_FIGHT_INDEX_EXHAUSTED", "victory exhaustion code is stable")
    gamma_arena_test_assert.equals(victory.orchestrator.session.fight_index, 4294967295, "victory exhaustion does not mutate session index")
    gamma_arena_test_assert.equals(victory.orchestrator.runtime_stage, "RESULT", "victory exhaustion does not leave RESULT")
    gamma_arena_test_assert.is_false(victory.orchestrator.result_action_locked, "victory exhaustion does not acquire the result-action latch")
    gamma_arena_test_assert.equals(victory.reset_actor, 0, "victory exhaustion precedes actor mutation")

    local routed = task8_environment()
    routed.orchestrator.session.fight_index = 4294967295
    task8_pump_to_active(routed)
    routed.orchestrator:npc_on_death_callback({ id = function() return routed.registry.npcs[1].id end })
    routed.orchestrator:actor_on_update()
    local first = routed.victory_dialogs[1].on_next()
    local repeated = routed.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_false(first.ok, "UI exhaustion reaches common result-error routing")
    gamma_arena_test_assert.is_true(repeated.ok and repeated.value == false, "repeated exhausted UI action is idempotent")
    gamma_arena_test_assert.equals(routed.fatal_shown, 1, "exhaustion opens fatal UI exactly once")
    gamma_arena_test_assert.equals(routed.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, "exhaustion enters ERROR")
end

local function runtime_task8_result_action_failures_route_to_fatal()
    local cases = {
        { options = { clear_result_error = true }, action = "on_next", label = "clear result" },
        { options = { clear_intent_error = true }, action = "on_main_menu", label = "clear intent" },
        { options = { teardown_error = true }, action = "on_main_menu", label = "initial teardown" }
    }
    for _, case in ipairs(cases) do
        local env = task8_environment(case.options); task8_pump_to_active(env)
        env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
        local failed = env.victory_dialogs[1][case.action]()
        gamma_arena_test_assert.is_false(failed.ok, case.label .. " failure remains observable")
        gamma_arena_test_assert.equals(env.fatal_shown, 1, case.label .. " failure routes to fatal UI once")
        gamma_arena_test_assert.equals(env.orchestrator.machine_state, gamma_arena_state_machine.states.ERROR, case.label .. " failure enters ERROR")
    end
    local env = task8_environment(); task8_pump_to_active(env)
    env.orchestrator:npc_on_death_callback({ id = function() return env.registry.npcs[1].id end }); env.orchestrator:actor_on_update()
    env.orchestrator.victory_next_action = function() error("injected result action exception") end
    local failed = env.victory_dialogs[1].on_next()
    gamma_arena_test_assert.is_false(failed.ok, "result action exception becomes a structured failure")
    gamma_arena_test_assert.equals(env.fatal_shown, 1, "result action exception routes to fatal UI once")
end

