local function runtime_actor_inventory_drain_times_out_with_sorted_evidence()
    local env, adapter = fake_actor_adapter_env()
    env.never_finishes = true
    env:add_item(13, { section = "ammo_5.45x39_fmj" })
    env:add_item(12, { section_throw = true })
    adapter:begin_update()
    gamma_arena_test_assert.is_true(adapter:normalize_for_arena({ actor_spawn_path = "actor_spawn", actor_look_path = "actor_look" }).ok, "never-finishing purge starts")
    env:advance(9999)
    adapter:begin_update()
    gamma_arena_test_assert.is_false(adapter:verify_inventory_empty().value, "drain remains pending before exact inactivity deadline")
    env:remove_item(13)
    env:add_item(14, { section = "wpn_lr300" })
    adapter:begin_update()
    gamma_arena_test_assert.is_false(adapter:verify_inventory_empty().value, "same-count id replacement is progress")
    env:advance(9999)
    adapter:begin_update()
    gamma_arena_test_assert.is_false(adapter:verify_inventory_empty().value, "progress immediately before deadline resets inactivity")
    env:advance(1)
    adapter:begin_update()
    local timed_out = adapter:verify_inventory_empty()
    gamma_arena_test_assert.is_false(timed_out.ok, "drain times out at the exact inactivity boundary")
    gamma_arena_test_assert.equals(timed_out.error.code, "GA_ACTOR_INVENTORY_NOT_EMPTY", "drain timeout code")
    local context = timed_out.error.context
    gamma_arena_test_assert.equals(context.remaining_count, 2, "timeout reports remaining count")
    gamma_arena_test_assert.equals(context.remaining_ids[1], 12, "timeout sorts remaining ids")
    gamma_arena_test_assert.equals(context.remaining_ids[2], 14, "timeout replaces stale ids in evidence")
    gamma_arena_test_assert.equals(context.remaining_sections[1].id, 12, "timeout section evidence retains first sorted id")
    gamma_arena_test_assert.equals(context.remaining_sections[1].section, "<unavailable>", "section failures are diagnostic only")
    gamma_arena_test_assert.equals(context.remaining_sections[2].id, 14, "timeout section evidence retains second sorted id")
    gamma_arena_test_assert.equals(context.remaining_sections[2].section, "wpn_lr300", "timeout retains readable sections")
    gamma_arena_test_assert.equals(context.poll_count, 4, "timeout counts every verification poll")
    gamma_arena_test_assert.equals(context.elapsed_since_progress_ms, 10000, "timeout uses exact inactivity boundary")
    gamma_arena_test_assert.equals(context.total_elapsed_ms, 19999, "progress does not reset total elapsed")
    gamma_arena_test_assert.equals(context.timeout_ms, 10000, "timeout evidence retains configured timeout")
end

local function runtime_actor_inventory_drain_timeout_is_wrap_safe()
    local env, adapter = fake_actor_adapter_env()
