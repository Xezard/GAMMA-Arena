local function runtime_entity_vertical_escape_requires_grace()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-vertical-integrity"); pump_entity(adapter, env)
    local victim = adapter:registry_snapshot().npcs[1]
    local object = env.online[victim.id]
    object.position_value.y = 6
    env:advance(250); gamma_arena_test_assert.is_true(adapter:update().ok, "first vertical anomaly remains pending")
    gamma_arena_test_assert.is_false(adapter:integrity_status().value, "transient vertical anomaly cannot restart a fight")
    object.position_value.y = 2
    env:advance(250); gamma_arena_test_assert.is_true(adapter:update().ok, "returning to the floor clears pending escape evidence")
    gamma_arena_test_assert.is_false(adapter:integrity_status().value, "recovered vertical anomaly remains healthy")
    object.position_value.y = 6
    env:advance(250); adapter:update()
    env:advance(1250); adapter:update()
    env:advance(250); adapter:update()
    local fault = adapter:integrity_status()
    gamma_arena_test_assert.is_true(fault.ok and type(fault.value) == "table", "stable vertical escape becomes an integrity fault")
    gamma_arena_test_assert.equals(fault.value.cause, "vertical_escape", "vertical escape cause is stable")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "escaped living opponent is never manufactured into a defeat")
end

