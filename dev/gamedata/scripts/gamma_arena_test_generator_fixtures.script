    local threats = { 100, 120, 150, 180, 220, 270, 330, 600 }
    local rules = { sections = {
        meta = { schema_version = "1", revision = "1" },
        limits = { base_budget = "600", max_entries = "64", max_physical_items_per_participant = "256",
            max_selected_grenades = "2", max_quantity_per_grenade = "1", second_grenade_price_multiplier = "2" },
        ranks = { ids = table.concat(rank_ids, ",") }, factions = { ids = table.concat(faction_ids, ",") },
        price_overrides = { device_torch_dummy = "25", device_torch_nv_1 = "75", device_torch_nv_2 = "150", device_torch_nv_3 = "300" }
    } }
    local aliases, loadouts = {}, { sections = {
        fixture_primary = { ["wpn_ak74:0:0:100"] = "", ["wpn_wincheaster1300:0:0:100"] = "" },
        fixture_secondary = { ["wpn_pm:0:0:100"] = "", ["wpn_mp5:0:0:100"] = "" }
    } }
    for index, rank in ipairs(rank_ids) do
        rules.sections["rank_" .. rank] = { threat = tostring(threats[index]) }
        for _, faction in ipairs(faction_ids) do
            aliases["gamma_arena_" .. faction .. "_" .. rank] = { rank = tostring((index - 1) * 100) .. "," .. tostring(index * 100 - 1) }
            loadouts.sections[faction .. "_" .. rank] = { primary = "fixture_primary", secondary = "fixture_secondary" }
        end
    end
    factory.rank_source = {
        open = function() return rules end,
        section_exists = function(name) return aliases[name] ~= nil end,
        read_system_string = function(name, key)
            if name == "game_relations" and key == "rating" then
                return "novice,100,trainee,200,experienced,300,professional,400,veteran,500,expert,600,master,700,legend"
            end
            return aliases[name] and aliases[name][key] or nil
        end,
        open_loadouts = function() return loadouts end
    }

    local sections = {}
    local classes = { w_pistol = "WP_PM", w_smg = "WP_LR300", w_rifle = "WP_AK74", w_shotgun = "WP_BM16", w_sniper = "WP_SVD",
        w_ammo = "AMMO_S", w_melee = "WP_KNIFE", o_light = "E_STLK", o_medium = "E_STLK", o_sci = "E_STLK" }
    local function physical(name, kind, slot, cost)
        return { kind = kind, slot = tostring(slot), cost = tostring((tonumber(cost) or 1) * 1000),
            inv_weight = "0.25", inv_name = "st_" .. name, class = classes[kind] or "II_MEDKI",
            ["$spawn"] = "fixture\\" .. name, inv_grid_x = "0", inv_grid_y = "0", inv_grid_width = "1", inv_grid_height = "1" }
    end
    local groups = { { "weapon_", "weapon" }, { "ammo_", "ammo" }, { "outfit_", "outfit" },
        { "knife_", "knife" }, { "medical_", "medicine" }, { "grenade_", "grenade" }, { "device_", "device" } }
    for name, item in pairs(catalog.sections) do
        for _, group in ipairs(groups) do
            if string.sub(name, 1, #group[1]) == group[1] and type(item.section) == "string" and game_sections[item.section] then
                local category = group[2]
                local kind = category == "weapon" and item.kind or category == "ammo" and "w_ammo"
                    or category == "outfit" and (item.armor_class == "scientific" and "o_sci" or "o_" .. item.armor_class)
                    or category == "knife" and "w_melee" or nil
                local slot = category == "weapon" and item.slot or category == "outfit" and 6 or category == "device" and 9 or 0
                local values = physical(item.section, kind, slot, item.cost or item.actor_cost)
                if category == "weapon" then
                    values.ammo_class = item.ammo
                elseif category == "ammo" then
                    values.box_size = item.section == "ammo_12x70_buck" and "10" or "30"
                elseif category == "device" then
                    values.class = "TORCH_S"
                    values.nv_effect = item.nv_effect ~= "none" and item.nv_effect or nil
                elseif category == "grenade" then
                    values.class = "G_F1"
                end
                sections[item.section] = values
            end
        end
    end
    for name, supplied in pairs(effective_sections or {}) do
        local values = sections[name] or physical(name, supplied.kind, supplied.slot or 0, 3)
        for key, value in pairs(supplied) do values[key] = value end
        sections[name] = values
    end
    local models, hud_sections = {}, {}
    local grants = { sections = { shared = {} } }
    for name, values in pairs(sections) do
        grants.sections.shared[name] = "true,1," .. tostring(math.max(1, math.floor(tonumber(values.cost) / 100)))
        if string.sub(values.kind or "", 1, 2) == "w_" and values.kind ~= "w_ammo" then
            values.visual = values.visual or name .. "_world.ogf"
            values.hud = values.hud or name .. "_hud"
            hud_sections[values.hud] = { item_visual = name .. "_hud.ogf" }
            models[values.visual] = true
            models[name .. "_hud.ogf"] = true
        end
    end
    for name, values in pairs(hud_sections) do sections[name] = sections[name] or values end
    factory.item_source = {
        open_rules = function() return rules end,
        enumerate_system_sections = function() return keys(sections) end,
        read_system_string = function(name, key) return sections[name] and sections[name][key] or nil end,
        read_system_number = function(name, key) return sections[name] and tonumber(sections[name][key]) or nil end,
        section_spawnable = function(name) return sections[name] ~= nil and sections[name]["$spawn"] ~= nil end,
        section_exists = function(name) return sections[name] ~= nil end,
        file_exists = function(alias, path) return alias == "$game_meshes$" and models[path] == true end,
        open_loadouts = function() return grants end,
        enumerate_loadout_sections = function() return { "shared" } end,
        enumerate_loadout_keys = function(_, name) return keys(grants.sections[name] or {}) end,
        read_loadout_string = function(_, name, key) return grants.sections[name] and grants.sections[name][key] or nil end,
        read_base_carry_weight = function() return 50 end
    }
end
