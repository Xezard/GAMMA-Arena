local RANK_IDS = {
    "novice", "trainee", "experienced", "professional",
    "veteran", "expert", "master", "legend"
}
local THREATS = { 100, 120, 150, 180, 220, 270, 330, 400 }

local function clone(value)
    if type(value) ~= "table" then return value end
    local copied = {}
    for key, child in pairs(value) do copied[key] = clone(child) end
    return copied
end

local function item(section, category, price, weight_mg, extra)
    local value = {
        section = section, category = category, price = price, weight_mg = weight_mg,
        ammo_sections = {}, healing = false, helmet_allowed = true, carry_bonus_mg = 0
    }
    for key, child in pairs(extra or {}) do value[key] = child end
    return value
end

local function catalog()
    local values = {
        schema_version = 10, revision = 11, generator_version = 11,
        fingerprint = "ga-catalog-v10-customgen1", selection_mode = "staged",
        base_budget = 600, max_entries = 64, max_physical_items_per_participant = 256,
        max_selected_grenades = 2, max_quantity_per_grenade = 1,
        second_grenade_price_multiplier = 2, base_carry_weight = 50000,
        rank_ids = clone(RANK_IDS), ranks = {}, faction_ids = { "stalker" }, factions = {},
        layouts = { rostok_arena_v1 = { id = "rostok_arena_v1", version = 2, level = "l05_bar", virtual_capacity = 10 } },
        items = {}, ammo = {}, weapon_list = {}, primary_weapon_list = {}, secondary_weapon_list = {},
        outfit_list = {}, knife_list = {}, medical_items = {}, medical_item_list = {},
        npc_grenade_list = {}, actor_grenade_list = {}, consumables = {},
        difficulties = {
            stalker = {
                tier = 2, enemy_min = 2, enemy_max = 2, enemy_total_budget = 30,
                player_gear_budget = 10, player_medical_budget = 5, primary_share_percent = 50,
                player_weapon_weights = { w_pistol = 50, w_smg = 0, w_shotgun = 20, w_rifle = 30, w_sniper = 0 },
                player_armor_weights = { light = 100, medium = 0, scientific = 0, heavy = 0, powered_exo = 0 },
                medical_weights = { bleed = 20, health = 80, boost = 0, rare = 0 }
            }
        },
        difficulty_ids = { "stalker" }
    }
    local weapon_defs = {
        { section = "wpn_pm", ammo = "ammo_9x18", cost = 2, kind = "w_pistol", slot = 1, magazine_size = 8 },
        { section = "wpn_rifle", ammo = "ammo_545", cost = 4, kind = "w_rifle", slot = 2, magazine_size = 30 },
        { section = "wpn_shotgun", ammo = "ammo_12", cost = 5, kind = "w_shotgun", slot = 2, magazine_size = 8 }
    }
    for _, definition in ipairs(weapon_defs) do
        definition.ammo_box_min, definition.ammo_box_max = 1, 2
        definition.ammo_variants = { { section = definition.ammo, category = "standard", box_size = 20 } }
        values.weapon_list[#values.weapon_list + 1] = definition
        local target = definition.slot == 1 and values.secondary_weapon_list or values.primary_weapon_list
        target[#target + 1] = definition
        values.items[definition.section] = item(definition.section, "weapon", 30, 3000, {
            ltx_slot = definition.slot, ammo_sections = { definition.ammo }
        })
    end
    for _, section in ipairs({ "ammo_9x18", "ammo_545", "ammo_12" }) do
        values.ammo[section] = { section = section, cost = 1 }
        values.items[section] = item(section, "ammo", 5, 100, { box_size = 20 })
    end
    for _, definition in ipairs({
        { section = "outfit_light", cost = 1, armor_class = "light" },
        { section = "outfit_field", cost = 2, armor_class = "light" }
    }) do
        values.outfit_list[#values.outfit_list + 1] = definition
        values.items[definition.section] = item(definition.section, "outfit", 20, 5000, { carry_bonus_mg = 10000 })
    end
    values.items.helmet_open = item("helmet_open", "helmet", 10, 1000)
    for _, section in ipairs({ "wpn_knife", "wpn_knife2" }) do
        values.knife_list[#values.knife_list + 1] = { section = section }
        values.items[section] = item(section, "knife", 5, 500)
    end
    for _, definition in ipairs({
        { section = "bandage", category = "bleed", actor_cost = 1, npc_cost = 1, min_tier = 1, max_count = 2 },
        { section = "medkit", category = "health", actor_cost = 2, npc_cost = 2, min_tier = 1, max_count = 1 }
    }) do
        values.medical_items[definition.section] = definition
        values.medical_item_list[#values.medical_item_list + 1] = definition
        values.items[definition.section] = item(definition.section, "medicine", 10, 100, { healing = definition.section == "medkit" })
    end
    values.consumables.bandage = { section = "bandage", cost = 1 }
    values.consumables.medkit = { section = "medkit", cost = 2 }
    for _, section in ipairs({ "grenade_f1", "grenade_rgd5", "grenade_gd05" }) do
        local definition = { section = section }
        values.npc_grenade_list[#values.npc_grenade_list + 1] = definition
        values.actor_grenade_list[#values.actor_grenade_list + 1] = definition
        values.items[section] = item(section, "grenade", 10, 400)
    end
    for index, section in ipairs({
        "device_torch_dummy", "device_torch_nv_1",
        "device_torch_nv_2", "device_torch_nv_3"
    }) do
        values.items[section] = item(section, "device", 9 + index, 200 + index)
    end
    local faction = { id = "stalker", community = "stalker", ranks = {} }
    values.factions.stalker = faction
    values.profile_list, values.profiles_by_faction = {}, { stalker = {} }
    for index, rank_id in ipairs(RANK_IDS) do
        local minimum, maximum = (index - 1) * 100, index * 100 - 1
        local pool_index = ((index - 1) % 3) + 1
        local primary_weapons = pool_index == 2 and { "wpn_rifle" }
            or (pool_index == 3 and { "wpn_shotgun" } or {})
        local secondary_weapons = pool_index == 1 and { "wpn_pm" } or {}
        values.ranks[rank_id] = { id = rank_id, minimum = minimum, maximum = maximum, threat = THREATS[index] }
        local record = {
            id = rank_id, alias = "gamma_arena_stalker_" .. rank_id,
            profile_section = "sim_default_stalker_" .. tostring(index - 1),
            community = "stalker", runtime_community = "arena_enemy",
            minimum = minimum, maximum = maximum, threat = THREATS[index],
            loadout_section = "stalker_" .. rank_id,
            primary_weapons = primary_weapons, secondary_weapons = secondary_weapons
        }
        faction.ranks[rank_id] = record
        local profile = {
            section = record.alias, cost = 1, faction = "stalker", community = "stalker",
            runtime_community = "arena_enemy", rank = rank_id
        }
        values.profile_list[#values.profile_list + 1] = profile
        values.profiles_by_faction.stalker[#values.profiles_by_faction.stalker + 1] = profile
    end
    return values
end

local function layout(capacity)
    local routes = { "route_1", "route_2", "route_3", "route_4" }
    local value = {
        id = "rostok_arena_v1", version = 2, level = "l05_bar",
        actor_spawn_path = "actor_spawn", actor_look_path = "actor_look",
        tactical_routes = routes, capacity = capacity or 10, opponent_spawn_slots = {}
    }
    for index = 1, value.capacity do
        local route = routes[((index - 1) % #routes) + 1]
        value.opponent_spawn_slots[index] = {
            id = "slot_" .. tostring(index), base_route = route, native = index <= 4,
            position = { x = index * 3, y = 0, z = index % 2 == 0 and 2 or -2 },
            level_vertex_id = 100 + index, game_vertex_id = 200 + index
        }
    end
    return value
end

local function actor_items()
    return {
        { section = "outfit_field", quantity = 1, equipped_slot = "outfit" },
        { section = "helmet_open", quantity = 1, equipped_slot = "helmet" },
        { section = "wpn_knife", quantity = 1, equipped_slot = "knife" },
        { section = "wpn_pm", quantity = 1, equipped_slot = "weapon_1" },
        { section = "wpn_rifle", quantity = 1, equipped_slot = "weapon_2" },
        { section = "wpn_shotgun", quantity = 1 },
        { section = "ammo_9x18", quantity = 2 },
        { section = "ammo_545", quantity = 3 },
        { section = "ammo_12", quantity = 2 },
        { section = "medkit", quantity = 1 },
        { section = "grenade_f1", quantity = 1 },
        { section = "grenade_rgd5", quantity = 1 }
    }
end

local function session(rank_ids, seed, actor_device)
    local roster = {}
    for index, rank_id in ipairs(rank_ids) do roster[index] = { rank = rank_id } end
    return {
        schema_version = 2, mode_id = "skirmish", generation_recipe = "custom",
        session_seed = seed or 12345, catalog_fingerprint = "ga-catalog-v10-customgen1",
        custom_config = {
            schema_version = 1, faction = "stalker", roster = roster,
            actor_items = actor_items(), actor_device = actor_device,
            catalog_fingerprint = "ga-catalog-v10-customgen1"
        }
    }
end

local function golden_catalog()
    local values = catalog()
    values.fingerprint = "ga-catalog-v10-5d894c1f"
    values.items, values.ammo, values.weapon_list = {}, {}, {}
    values.primary_weapon_list, values.secondary_weapon_list = {}, {}
    for index, section in ipairs({
        "device_torch_dummy", "device_torch_nv_1",
        "device_torch_nv_2", "device_torch_nv_3"
    }) do
        values.items[section] = item(section, "device", 9 + index, 200 + index)
    end
    local weapons = {
        { section = "wpn_pm", ammo = "ammo_9x18_fmj", cost = 2, kind = "w_pistol", slot = 1, ammo_box_min = 1, ammo_box_max = 2 },
        { section = "wpn_ak74", ammo = "ammo_5.45x39_fmj", cost = 4, kind = "w_rifle", slot = 2, ammo_box_min = 1, ammo_box_max = 2 },
        { section = "wpn_wincheaster1300", ammo = "ammo_12x70_buck", cost = 5, kind = "w_shotgun", slot = 2, ammo_box_min = 1, ammo_box_max = 2 }
    }
    local weapon_items = {
        wpn_pm = { price = 30, weight = 1000 },
        wpn_ak74 = { price = 50, weight = 3000 },
        wpn_wincheaster1300 = { price = 45, weight = 3000 }
    }
    for _, definition in ipairs(weapons) do
        definition.ammo_variants = { { section = definition.ammo, category = "standard", box_size = 30 } }
        values.weapon_list[#values.weapon_list + 1] = definition
        local target = definition.slot == 1 and values.secondary_weapon_list or values.primary_weapon_list
        target[#target + 1] = definition
        local metadata = weapon_items[definition.section]
        values.items[definition.section] = item(definition.section, "weapon", metadata.price, metadata.weight, {
            ltx_slot = definition.slot, ammo_sections = { definition.ammo }
        })
    end
    for _, definition in ipairs({
        { section = "ammo_9x18_fmj", box_size = 30 },
        { section = "ammo_5.45x39_fmj", box_size = 30 },
        { section = "ammo_12x70_buck", box_size = 10 }
    }) do
        values.ammo[definition.section] = { section = definition.section, cost = 1 }
        values.items[definition.section] = item(definition.section, "ammo", 5, 100, { box_size = definition.box_size })
    end
    values.outfit_list = {
        { section = "novice_outfit", cost = 1, armor_class = "light" },
        { section = "stalker_outfit", cost = 2, armor_class = "light" }
    }
    values.items.novice_outfit = item("novice_outfit", "outfit", 20, 5000, { carry_bonus_mg = 5000 })
    values.items.stalker_outfit = item("stalker_outfit", "outfit", 40, 7000, { carry_bonus_mg = 10000 })
    values.items.helm_hardhat = item("helm_hardhat", "helmet", 20, 1000)
    values.knife_list = { { section = "wpn_knife" }, { section = "wpn_knife5" } }
    values.items.wpn_knife = item("wpn_knife", "knife", 5, 500)
    values.items.wpn_knife5 = item("wpn_knife5", "knife", 5, 500)
    values.medical_items, values.medical_item_list = {}, {}
    for _, definition in ipairs({
        { section = "bandage", category = "bleed", actor_cost = 1, npc_cost = 1, min_tier = 1, max_count = 2 },
        { section = "medkit", category = "health", actor_cost = 2, npc_cost = 2, min_tier = 1, max_count = 1 }
    }) do
        values.medical_items[definition.section] = definition
        values.medical_item_list[#values.medical_item_list + 1] = definition
        values.items[definition.section] = item(definition.section, "medicine",
            definition.section == "medkit" and 10 or 5, definition.section == "medkit" and 200 or 100,
            { healing = definition.section == "medkit" })
    end
    values.consumables = { bandage = { section = "bandage", cost = 1 }, medkit = { section = "medkit", cost = 2 } }
    values.npc_grenade_list, values.actor_grenade_list = {}, {}
    for _, definition in ipairs({
        { section = "grenade_f1", price = 40, weight = 400 },
        { section = "grenade_rgd5", price = 70, weight = 500 },
        { section = "grenade_gd-05", price = 30, weight = 300 }
    }) do
        local grenade = { section = definition.section }
        values.npc_grenade_list[#values.npc_grenade_list + 1] = grenade
        values.actor_grenade_list[#values.actor_grenade_list + 1] = grenade
        values.items[definition.section] = item(definition.section, "grenade", definition.price, definition.weight)
    end
    for index, rank_id in ipairs(RANK_IDS) do
        local profile = values.factions.stalker.ranks[rank_id]
        local pool_index = ((index - 1) % 3) + 1
        profile.primary_weapons = pool_index == 2 and { "wpn_ak74" }
            or (pool_index == 3 and { "wpn_wincheaster1300" } or {})
        profile.secondary_weapons = pool_index == 1 and { "wpn_pm" } or {}
    end
    return values
end

local function golden_layout()
    local routes = {
        "bar_arena_walk_3_1", "bar_arena_walk_3_2", "bar_arena_walk_6_1",
        "bar_arena_walk_6_3", "bar_arena_walk_6_6", "bar_arena_walk_1_1"
    }
    local value = {
        id = "rostok_arena_v1", version = 2, level = "l05_bar",
        actor_spawn_path = "t_way", actor_look_path = "t_look",
        tactical_routes = routes, capacity = 10, opponent_spawn_slots = {}
    }
    for index = 1, value.capacity do
        local route = routes[((index - 1) % #routes) + 1]
        value.opponent_spawn_slots[index] = {
            id = index <= 6 and "native:" .. route or "virtual:" .. tostring(index - 6),
            base_route = route, native = index <= 6,
            position = { x = index * 4, y = 0, z = index % 2 == 0 and 4 or -4 },
            level_vertex_id = 1000 + index, game_vertex_id = 77
        }
    end
    return value
end

local function golden_actor_items(case_id)
    if case_id == "one_grenade" then return {
        { section = "stalker_outfit", quantity = 1, equipped_slot = "outfit" },
        { section = "helm_hardhat", quantity = 1, equipped_slot = "helmet" },
        { section = "wpn_knife", quantity = 1, equipped_slot = "knife" },
        { section = "wpn_pm", quantity = 1, equipped_slot = "weapon_1" },
        { section = "ammo_9x18_fmj", quantity = 2 },
        { section = "medkit", quantity = 1 },
        { section = "grenade_f1", quantity = 1 }
    } end
    if case_id == "arsenal" then return {
        { section = "stalker_outfit", quantity = 1, equipped_slot = "outfit" },
        { section = "wpn_knife", quantity = 1, equipped_slot = "knife" },
        { section = "wpn_pm", quantity = 1, equipped_slot = "weapon_1" },
        { section = "wpn_ak74", quantity = 1, equipped_slot = "weapon_2" },
        { section = "wpn_wincheaster1300", quantity = 1 },
        { section = "ammo_9x18_fmj", quantity = 2 },
        { section = "ammo_5.45x39_fmj", quantity = 3 },
        { section = "ammo_12x70_buck", quantity = 2 },
        { section = "bandage", quantity = 1 },
        { section = "medkit", quantity = 1 }
    } end
    local grenades = case_id == "two_grenades_forward"
        and { "grenade_f1", "grenade_rgd5" } or { "grenade_rgd5", "grenade_f1" }
    return {
        { section = "novice_outfit", quantity = 1, equipped_slot = "outfit" },
        { section = "wpn_knife5", quantity = 1, equipped_slot = "knife" },
        { section = "wpn_ak74", quantity = 1, equipped_slot = "weapon_2" },
        { section = "ammo_5.45x39_fmj", quantity = 3 },
        { section = "medkit", quantity = 1 },
        { section = grenades[1], quantity = 1 },
        { section = grenades[2], quantity = 1 }
    }
end

local function golden_session(rank_ids, actor_case, seed, actor_device)
    local current = session(rank_ids, seed)
    current.catalog_fingerprint = "ga-catalog-v10-5d894c1f"
    current.custom_config.catalog_fingerprint = "ga-catalog-v10-5d894c1f"
    current.custom_config.actor_items = golden_actor_items(actor_case)
    current.custom_config.actor_device = actor_device
    return current
end

local function stable_draft(value)
    local parts = { value.arena.layout_id, value.actor.spawn_path }
    for _, entry in ipairs(value.actor.loadout.items) do
        parts[#parts + 1] = table.concat({ entry.section, entry.quantity, entry.equipped_slot or "" }, ":")
    end
    for _, opponent in ipairs(value.opponents) do
        parts[#parts + 1] = table.concat({ opponent.slot, opponent.faction, opponent.rank.id,
            opponent.rank.value, opponent.profile, opponent.spawn_slot_id, opponent.tactical_route }, ":")
        for _, entry in ipairs(opponent.loadout.items) do
            parts[#parts + 1] = table.concat({ entry.section, entry.quantity, entry.equipped_slot or "" }, ":")
        end
    end
    return table.concat(parts, "|")
end

local function key_set(value)
    local keys = {}
    for key in pairs(value) do keys[#keys + 1] = key end
    table.sort(keys)
    return table.concat(keys, ",")
end

local function find_item(items, section)
    for _, entry in ipairs(items) do if entry.section == section then return entry end end
end

local function item_signature(items, categories)
    local parts = {}
    for _, entry in ipairs(items) do
        if categories[entry.section] then
            parts[#parts + 1] = table.concat({ entry.section, entry.quantity, entry.equipped_slot or "" }, ":")
        end
    end
    return table.concat(parts, "|")
end

local function ordered_items_signature(items)
    local parts = {}
    for _, entry in ipairs(items) do
        parts[#parts + 1] = table.concat({ entry.section, entry.quantity, entry.equipped_slot or "" }, ":")
    end
    return table.concat(parts, "|")
end

local function contains(values, expected)
    for _, value in ipairs(values or {}) do if value == expected then return true end end
    return false
end

local function custom_generation_is_deterministic_and_exact()
    local snapshot, arena = catalog(), layout()
    local current = session({ "expert", "master", "legend" })
    local first = gamma_arena_custom_generator.build_draft(current, 7, snapshot, arena)
    local second = gamma_arena_custom_generator.build_draft(current, 7, snapshot, arena)
    gamma_arena_test_assert.is_true(first.ok and second.ok, "same custom inputs generate")
    gamma_arena_test_assert.equals(stable_draft(first.value), stable_draft(second.value), "same custom inputs produce identical drafts")
    for index, rank_id in ipairs({ "expert", "master", "legend" }) do
        local opponent = first.value.opponents[index]
        gamma_arena_test_assert.equals(opponent.faction, "stalker", "source faction is retained")
        gamma_arena_test_assert.equals(opponent.rank.id, rank_id, "exact named rank is retained")
        gamma_arena_test_assert.equals(opponent.profile, snapshot.factions.stalker.ranks[rank_id].alias, "exact profile alias")
        gamma_arena_test_assert.is_true(opponent.rank.value >= snapshot.ranks[rank_id].minimum and opponent.rank.value <= snapshot.ranks[rank_id].maximum, "numeric rank is in the exact band")
        gamma_arena_test_assert.equals(snapshot.factions.stalker.ranks[rank_id].runtime_community, "arena_enemy", "runtime community remains isolated")
        local rank_pool = snapshot.factions.stalker.ranks[rank_id]
        for _, entry in ipairs(opponent.loadout.items) do
            if snapshot.items[entry.section].category == "weapon" then
                gamma_arena_test_assert.is_true(
                    contains(rank_pool.primary_weapons, entry.section) or contains(rank_pool.secondary_weapons, entry.section),
                    "enemy weapon comes from exact faction-rank pool")
            end
        end
    end
    gamma_arena_test_assert.equals(#first.value.actor.loadout.items, #current.custom_config.actor_items, "actor item count is exact")
    current.custom_config.actor_items[1].section = "corrupted_after_generation"
    gamma_arena_test_assert.equals(first.value.actor.loadout.items[1].section, "outfit_field", "actor template is deep copied")
end

local function custom_generation_skips_enemy_equipment_outside_universal_catalog()
    local clean, snapshot, arena = catalog(), catalog(), layout()
    snapshot.outfit_list[#snapshot.outfit_list + 1] = {
        section = "merc_ace_outfit", cost = 1, armor_class = "scientific"
    }
    snapshot.knife_list[#snapshot.knife_list + 1] = { section = "wpn_knife_npc_only" }

    local current = session({ "novice" }, 54321)
    for fight_index = 0, 31 do
        local expected = gamma_arena_fight_builder.generate(current, fight_index, clean, arena)
        local generated = gamma_arena_fight_builder.generate(current, fight_index, snapshot, arena)
        gamma_arena_test_assert.is_true(expected.ok and generated.ok,
            "Custom ignores legacy enemy equipment outside the universal catalog")
        gamma_arena_test_assert.equals(gamma_arena_fight_spec.stable_encode(generated.value),
            gamma_arena_fight_spec.stable_encode(expected.value),
            "non-physical legacy equipment does not perturb deterministic selection")
        for _, opponent in ipairs(generated.value.opponents) do
            for _, entry in ipairs(opponent.items) do
                gamma_arena_test_assert.is_true(snapshot.items[entry.section] ~= nil,
                    "Custom enemy item is universally cataloged")
                gamma_arena_test_assert.is_true(entry.section ~= "merc_ace_outfit"
                    and entry.section ~= "wpn_knife_npc_only",
                    "non-spawnable legacy equipment is never emitted")
            end
        end
    end
end

local function custom_generation_fails_without_physical_enemy_equipment()
    for _, missing_category in ipairs({ "outfit", "knife" }) do
        local snapshot = catalog()
        if missing_category == "outfit" then
            snapshot.outfit_list = { { section = "merc_ace_outfit", cost = 1, armor_class = "scientific" } }
        else
            snapshot.knife_list = { { section = "wpn_knife_npc_only" } }
        end
        local generated = gamma_arena_custom_generator.build_draft(
            session({ "novice" }, 54321), 0, snapshot, layout())
        gamma_arena_test_assert.is_false(generated.ok,
            "Custom fails closed without physical enemy " .. missing_category)
        gamma_arena_test_assert.equals(generated.error.code, "GA_CUSTOM_EQUIPMENT_UNAVAILABLE",
            "missing physical enemy equipment has an exact error")
        gamma_arena_test_assert.equals(generated.value, nil,
            "missing physical enemy equipment emits no partial draft")
    end
end

local function custom_actor_device_is_optional_exact_and_prebudgeted()
    local snapshot, arena = catalog(), layout()
    local choices = {
        { section = nil },
        { section = "device_torch_dummy" },
        { section = "device_torch_nv_1" },
        { section = "device_torch_nv_2" },
        { section = "device_torch_nv_3" }
    }
    local baseline = session(RANK_IDS, 777)
    local baseline_totals = gamma_arena_custom_config.totals(baseline.custom_config, snapshot).value
    for _, choice in ipairs(choices) do
        local current = session(RANK_IDS, 777, choice.section)
        local totals = gamma_arena_custom_config.totals(current.custom_config, snapshot)
        gamma_arena_test_assert.is_true(totals.ok, "Custom device totals are already budgeted by config")
        local draft = gamma_arena_custom_generator.build_draft(current, 3, snapshot, arena)
        gamma_arena_test_assert.is_true(draft.ok, "Custom device draft generates")
        local devices = {}
        for _, entry in ipairs(draft.value.actor.loadout.items) do
            if snapshot.items[entry.section].category == "device" then devices[#devices + 1] = entry end
        end
        local expected_count = choice.section and 1 or 0
        gamma_arena_test_assert.equals(#devices, expected_count, "Custom emits zero or one exact selected device")
        gamma_arena_test_assert.equals(#draft.value.actor.loadout.items,
            #current.custom_config.actor_items + expected_count, "device is outside ordinary actor_items")
        if choice.section then
            gamma_arena_test_assert.equals(devices[1].section, choice.section, "Custom emits the exact selected device")
            gamma_arena_test_assert.equals(key_set(devices[1]), "equipped_slot,quantity,section", "Custom device uses the sole v9 item shape")
            gamma_arena_test_assert.equals(devices[1].quantity, 1, "Custom device quantity")
            gamma_arena_test_assert.equals(devices[1].equipped_slot, "device", "Custom device slot")
            gamma_arena_test_assert.equals(totals.value.points,
                baseline_totals.points + snapshot.items[choice.section].price, "Custom device AP was charged in config")
        end
        for _, opponent in ipairs(draft.value.opponents) do
            for _, entry in ipairs(opponent.loadout.items) do
                gamma_arena_test_assert.is_false(snapshot.items[entry.section].category == "device", "Custom opponents never receive devices")
            end
        end
        local original = gamma_arena_device_generator.generate
        gamma_arena_device_generator.generate = function() error("Custom builder reran device selection") end
        local completed, built = pcall(gamma_arena_fight_builder.generate, current, 3, snapshot, arena)
        gamma_arena_device_generator.generate = original
        gamma_arena_test_assert.is_true(completed and built.ok, "Custom selection survives build and validation without reroll")
    end
end

local function fight_index_rerolls_only_enemy_random_fields()
    local snapshot, arena = catalog(), layout()
    local current = session(RANK_IDS, 987654)
    local changed = { rank = false, equipment = false, medicine = false, grenade = false, spawn = false, route = false }
    local baseline = gamma_arena_custom_generator.build_draft(current, 0, snapshot, arena)
    gamma_arena_test_assert.is_true(baseline.ok, "baseline custom draft")
    local actor_signature = ordered_items_signature(baseline.value.actor.loadout.items)
    for fight_index = 1, 64 do
        local generated = gamma_arena_custom_generator.build_draft(current, fight_index, snapshot, arena)
        gamma_arena_test_assert.is_true(generated.ok, "reroll custom draft")
        gamma_arena_test_assert.equals(ordered_items_signature(generated.value.actor.loadout.items), actor_signature, "complete ordered actor template never rerolls")
        for index, opponent in ipairs(generated.value.opponents) do
            local prior = baseline.value.opponents[index]
            gamma_arena_test_assert.equals(opponent.faction, prior.faction, "faction never rerolls")
            gamma_arena_test_assert.equals(opponent.rank.id, prior.rank.id, "named rank never rerolls")
            if opponent.rank.value ~= prior.rank.value then changed.rank = true end
            local equipment_sections = {
                outfit_light = true, outfit_field = true, wpn_knife = true, wpn_knife2 = true,
                wpn_pm = true, wpn_rifle = true, wpn_shotgun = true,
                ammo_9x18 = true, ammo_545 = true, ammo_12 = true
            }
            if item_signature(opponent.loadout.items, equipment_sections) ~= item_signature(prior.loadout.items, equipment_sections) then changed.equipment = true end
            local bandage_now = find_item(opponent.loadout.items, "bandage") ~= nil
            local bandage_prior = find_item(prior.loadout.items, "bandage") ~= nil
            local medkit_now = find_item(opponent.loadout.items, "medkit") ~= nil
            local medkit_prior = find_item(prior.loadout.items, "medkit") ~= nil
            if bandage_now ~= bandage_prior or medkit_now ~= medkit_prior then changed.medicine = true end
            local grenade_now = find_item(opponent.loadout.items, "grenade_f1") or find_item(opponent.loadout.items, "grenade_rgd5") or find_item(opponent.loadout.items, "grenade_gd05")
            local grenade_prior = find_item(prior.loadout.items, "grenade_f1") or find_item(prior.loadout.items, "grenade_rgd5") or find_item(prior.loadout.items, "grenade_gd05")
            if (grenade_now and grenade_now.section or "") ~= (grenade_prior and grenade_prior.section or "") then changed.grenade = true end
            if opponent.spawn_slot_id ~= prior.spawn_slot_id then changed.spawn = true end
            if opponent.tactical_route ~= prior.tactical_route then changed.route = true end
        end
    end
    for field, observed in pairs(changed) do gamma_arena_test_assert.is_true(observed, "fight index rerolls enemy " .. field) end
end

local function builder_erases_recipe_provenance_and_accepts_carried_weapons()
    local snapshot, arena = catalog(), layout()
    local custom = gamma_arena_fight_builder.generate(session({ "legend" }, 321), 2, snapshot, arena)
    gamma_arena_test_assert.is_true(custom.ok, "custom builder emits strict v9")
    gamma_arena_test_assert.equals(key_set(custom.value), "actor,arena,identity,opponents,schema_version", "custom root keys are universal")
    gamma_arena_test_assert.equals(key_set(custom.value.actor), "items,look_path,spawn_path", "custom actor keys are universal")
    gamma_arena_test_assert.equals(key_set(custom.value.opponents[1]), "faction,items,profile,rank,role,slot,spawn,spawn_slot_id,tactical_route", "custom opponent keys are universal")
    gamma_arena_test_assert.is_true(find_item(custom.value.actor.items, "wpn_shotgun") ~= nil, "carried weapon survives canonicalization")
    for _, forbidden in ipairs({ "mode_id", "difficulty_id", "price", "budget", "custom_config", "generation_recipe" }) do
        gamma_arena_test_assert.equals(custom.value[forbidden], nil, "custom FightSpec erases " .. forbidden)
    end

    local random = gamma_arena_fight_builder.generate({
        session_seed = 321, mode_id = "skirmish", difficulty_id = "stalker",
        layout_id = "rostok_arena_v1", generation_recipe = "random"
    }, 2, snapshot, arena)
    gamma_arena_test_assert.is_true(random.ok, "random builder still emits v9")
    gamma_arena_test_assert.equals(key_set(random.value), key_set(custom.value), "random and custom root key sets match")
    gamma_arena_test_assert.equals(key_set(random.value.actor), key_set(custom.value.actor), "random and custom actor key sets match")
    gamma_arena_test_assert.equals(key_set(random.value.opponents[1]), key_set(custom.value.opponents[1]), "random and custom opponent key sets match")
end

local function custom_generation_fails_closed_for_capacity_and_corruption()
    local snapshot = catalog()
    local over_capacity = gamma_arena_custom_generator.build_draft(session({ "novice", "legend" }), 0, snapshot, layout(1))
    gamma_arena_test_assert.is_false(over_capacity.ok, "custom roster cannot exceed resolved capacity")

    local corrupted = session({ "novice" })
    corrupted.custom_config.actor_items[1].quantity = 257
    local invalid = gamma_arena_custom_generator.build_draft(corrupted, 0, snapshot, layout())
    gamma_arena_test_assert.is_false(invalid.ok, "corrupted actor template fails closed")

    local missing_pool = catalog()
    missing_pool.factions.stalker.ranks.novice.primary_weapons = {}
    missing_pool.factions.stalker.ranks.novice.secondary_weapons = {}
    invalid = gamma_arena_custom_generator.build_draft(session({ "novice" }), 0, missing_pool, layout())
    gamma_arena_test_assert.is_false(invalid.ok, "empty exact rank equipment pool fails closed")
end

local function assert_error_only(result, code, message)
    gamma_arena_test_assert.is_false(result.ok, message)
    gamma_arena_test_assert.equals(result.error.code, code, message .. " code")
    gamma_arena_test_assert.equals(result.value, nil, message .. " has no partial draft")
end

local function assert_pre_rng_error(action, code, message)
    local original_derive_seed = gamma_arena_rng.derive_seed
    local derive_calls = 0
    gamma_arena_rng.derive_seed = function(parts)
        derive_calls = derive_calls + 1
        return original_derive_seed(parts)
    end
    local completed, result = pcall(action)
    gamma_arena_rng.derive_seed = original_derive_seed
    gamma_arena_test_assert.is_true(completed, message .. " returns a Result")
    if not completed then return end
    assert_error_only(result, code, message)
    gamma_arena_test_assert.equals(derive_calls, 0, message .. " derive calls before failure")
end

local function custom_generation_preflights_every_pool_member()
    local unknown = catalog()
    local novice = unknown.factions.stalker.ranks.novice
    novice.secondary_weapons[#novice.secondary_weapons + 1] = "wpn_missing"
    assert_error_only(
        gamma_arena_custom_generator.build_draft(session({ "novice" }), 0, unknown, layout()),
        "GA_CUSTOM_WEAPON_POOL_INVALID", "mixed valid and unknown exact-pool member fails closed")

    local non_weapon = catalog()
    novice = non_weapon.factions.stalker.ranks.novice
    novice.secondary_weapons[#novice.secondary_weapons + 1] = "bandage"
    assert_error_only(
        gamma_arena_custom_generator.build_draft(session({ "novice" }), 0, non_weapon, layout()),
        "GA_CUSTOM_WEAPON_POOL_INVALID", "non-weapon exact-pool member fails closed")

    local malformed = catalog()
    malformed.items.wpn_corrupt = item("wpn_corrupt", "weapon", 30, 1000, {
        ltx_slot = 1, ammo_sections = { "ammo_9x18" }
    })
    malformed.weapon_list[#malformed.weapon_list + 1] = {
        section = "wpn_corrupt", ammo = "ammo_9x18", slot = 1,
        ammo_box_min = 1, ammo_box_max = 2
    }
    novice = malformed.factions.stalker.ranks.novice
    novice.secondary_weapons[#novice.secondary_weapons + 1] = "wpn_corrupt"
    assert_error_only(
        gamma_arena_custom_generator.build_draft(session({ "novice" }), 0, malformed, layout()),
        "GA_CUSTOM_WEAPON_POOL_INVALID", "malformed exact-pool member fails closed")

    local duplicate = catalog()
    novice = duplicate.factions.stalker.ranks.novice
    novice.secondary_weapons[#novice.secondary_weapons + 1] = novice.secondary_weapons[1]
    assert_pre_rng_error(function()
        return gamma_arena_custom_generator.build_draft(session({ "novice" }), 0, duplicate, layout())
    end, "GA_CUSTOM_WEAPON_POOL_INVALID", "duplicate exact-pool member fails before RNG")
end

local function custom_generation_preflights_every_layout_entry()
    local current = session({ "novice" }, 424242)
    local snapshot, arena = catalog(), layout()
    local baseline = gamma_arena_custom_generator.build_draft(current, 0, snapshot, arena)
    gamma_arena_test_assert.is_true(baseline.ok, "layout preflight baseline generates")

    local corrupt_slot = layout()
    local selected_id = baseline.value.opponents[1].spawn_slot_id
    local corrupt_slot_index
    for index, slot in ipairs(corrupt_slot.opponent_spawn_slots) do
        if slot.id ~= selected_id then corrupt_slot_index = index end
    end
    gamma_arena_test_assert.is_true(corrupt_slot_index ~= nil, "fixture exposes an unselected spawn slot")
    corrupt_slot.opponent_spawn_slots[corrupt_slot_index].position = nil
    assert_error_only(
        gamma_arena_custom_generator.build_draft(current, 0, snapshot, corrupt_slot),
        "GA_CUSTOM_LAYOUT_INVALID", "invalid unselected spawn slot fails closed")

    local corrupt_route = layout()
    local selected_route = baseline.value.opponents[1].tactical_route
    local selected_base_route
    for _, slot in ipairs(corrupt_route.opponent_spawn_slots) do
        if slot.id == selected_id then selected_base_route = slot.base_route end
    end
    local corrupt_route_index
    for index, route in ipairs(corrupt_route.tactical_routes) do
        if route ~= selected_route and route ~= selected_base_route then corrupt_route_index = index end
    end
    gamma_arena_test_assert.is_true(corrupt_route_index ~= nil, "fixture exposes an unselected tactical route")
    corrupt_route.tactical_routes[corrupt_route_index] = ""
    assert_error_only(
        gamma_arena_custom_generator.build_draft(current, 0, snapshot, corrupt_route),
        "GA_CUSTOM_LAYOUT_INVALID", "invalid unselected tactical route fails closed")

    local duplicate_route = layout()
    duplicate_route.tactical_routes[2] = duplicate_route.tactical_routes[1]
    assert_pre_rng_error(function()
        return gamma_arena_custom_generator.build_draft(current, 0, snapshot, duplicate_route)
    end, "GA_CUSTOM_LAYOUT_INVALID", "duplicate tactical route fails before RNG")

    local duplicate_slot = layout()
    duplicate_slot.opponent_spawn_slots[2].id = duplicate_slot.opponent_spawn_slots[1].id
    assert_pre_rng_error(function()
        return gamma_arena_custom_generator.build_draft(current, 0, snapshot, duplicate_slot)
    end, "GA_CUSTOM_LAYOUT_INVALID", "duplicate spawn-slot ID fails before RNG")
end

local function custom_generation_rejects_noncanonical_profile_alias()
    local snapshot = catalog()
    snapshot.factions.stalker.ranks.legend.alias = "gamma_arena_stalker_legend_alt"
    assert_error_only(
        gamma_arena_custom_generator.build_draft(session({ "legend" }), 0, snapshot, layout()),
        "GA_CUSTOM_RANK_UNKNOWN", "noncanonical fixed faction-rank alias fails closed")
end

local CUSTOM_GOLDEN_CASES = {
    { name = "one_novice", seed = 101, fight = 0, ranks = { "novice" }, actor_case = "one_grenade" },
    { name = "mixed_eight", seed = 202, fight = 7, ranks = RANK_IDS, actor_case = "arsenal", actor_device = "device_torch_dummy" },
    { name = "ten_legends_forward", seed = 303, fight = 31, ranks = { "legend", "legend", "legend", "legend", "legend", "legend", "legend", "legend", "legend", "legend" }, actor_case = "two_grenades_forward", actor_device = "device_torch_nv_3" },
    { name = "ten_legends_reverse", seed = 303, fight = 31, ranks = { "legend", "legend", "legend", "legend", "legend", "legend", "legend", "legend", "legend", "legend" }, actor_case = "two_grenades_reverse", actor_device = "device_torch_nv_3" }
}

local function custom_v9_golden_sessions_are_current()
    local snapshot, arena = golden_catalog(), golden_layout()
    local encodings = {}
    for _, request in ipairs(CUSTOM_GOLDEN_CASES) do
        local current = golden_session(request.ranks, request.actor_case, request.seed, request.actor_device)
        local first = gamma_arena_fight_builder.generate(current, request.fight, snapshot, arena)
        local second = gamma_arena_fight_builder.generate(current, request.fight, snapshot, arena)
        gamma_arena_test_assert.is_true(first.ok and second.ok, "custom v9 golden builder request generates twice")
        local first_encoding = gamma_arena_fight_spec.stable_encode(first.value)
        local second_encoding = gamma_arena_fight_spec.stable_encode(second.value)
        gamma_arena_test_assert.equals(first.value.schema_version, 9, "custom golden emits v9")
        gamma_arena_test_assert.equals(first.value.identity.generator_version, 11, "custom golden uses generator v11")
        gamma_arena_test_assert.is_true(string.sub(first.value.identity.fight_id, 1, 4) == "ga9-", "custom golden fight_id is current")
        gamma_arena_test_assert.equals(first_encoding, second_encoding, "custom v9 golden Lua bytes repeat exactly")
        gamma_arena_test_assert.equals(first.value.identity.fight_id, second.value.identity.fight_id, "custom v9 golden fight_id repeats exactly")
        local emitted = request.actor_device and find_item(first.value.actor.items, request.actor_device) or nil
        gamma_arena_test_assert.equals(emitted and emitted.section or nil, request.actor_device, "custom v9 golden device is exact")
        encodings[request.name] = first_encoding
    end
    gamma_arena_test_assert.equals(encodings.ten_legends_forward,
        encodings.ten_legends_reverse, "both grenade orders map to identical canonical v9 bytes")
end

local cases = {
    { name = "custom_generation_is_deterministic_and_exact", fn = custom_generation_is_deterministic_and_exact },
    { name = "custom_generation_skips_enemy_equipment_outside_universal_catalog", fn = custom_generation_skips_enemy_equipment_outside_universal_catalog },
    { name = "custom_generation_fails_without_physical_enemy_equipment", fn = custom_generation_fails_without_physical_enemy_equipment },
    { name = "custom_actor_device_is_optional_exact_and_prebudgeted", fn = custom_actor_device_is_optional_exact_and_prebudgeted },
    { name = "custom_fight_index_rerolls_only_enemy_random_fields", fn = fight_index_rerolls_only_enemy_random_fields },
    { name = "custom_builder_erases_recipe_provenance_and_accepts_carried_weapons", fn = builder_erases_recipe_provenance_and_accepts_carried_weapons },
    { name = "custom_generation_fails_closed_for_capacity_and_corruption", fn = custom_generation_fails_closed_for_capacity_and_corruption },
    { name = "custom_generation_preflights_every_pool_member", fn = custom_generation_preflights_every_pool_member },
    { name = "custom_generation_preflights_every_layout_entry", fn = custom_generation_preflights_every_layout_entry },
    { name = "custom_generation_rejects_noncanonical_profile_alias", fn = custom_generation_rejects_noncanonical_profile_alias },
    { name = "custom_v9_golden_sessions_are_current", fn = custom_v9_golden_sessions_are_current }
}

function run(run_case_fn)
    local all_passed = true
    for _, case in ipairs(cases) do if not run_case_fn(case.name, case.fn) then all_passed = false end end
    return all_passed
end
