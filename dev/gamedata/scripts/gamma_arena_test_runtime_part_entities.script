function runtime_entity_wounded_and_missing_pending_can_recover()
    local env, deps = fake_entity_environment()
    local adapter = gamma_arena_entity_adapter.new(deps)
    begin_entity_apply(adapter, env, entity_spec(1), "session-terminal-recovery"); pump_entity(adapter, env)
    local victim = adapter:registry_snapshot().npcs[1]
    local object = env.online[victim.id]
    object.critical_value = true
    env:advance(250); adapter:update()
    object.critical_value = false
    env:advance(250); adapter:update()
    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "ALIVE", "recovered wound returns to ALIVE")
    env.online[victim.id] = nil
    env:advance(250); adapter:update()
    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "MISSING_PENDING", "transient online loss enters grace")
    env.online[victim.id] = object
    env:advance(250); adapter:update()
    gamma_arena_test_assert.equals(adapter:registry_snapshot().npcs[1].terminal_state, "ALIVE", "reappearing NPC returns to ALIVE")
    gamma_arena_test_assert.equals(adapter:living_opponent_count(), 1, "recovered pending evidence remains combat-live")
end

