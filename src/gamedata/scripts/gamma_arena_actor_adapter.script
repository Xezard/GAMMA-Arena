local ActorAdapter = {}
ActorAdapter.__index = ActorAdapter

local function fail(code, message, context)
    return gamma_arena_result.err(code, message, context)
end

local function finite(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function valid_id(value)
    return finite(value) and value == math.floor(value) and value >= 0
end

local function valid_u32(value)
    return valid_id(value) and value <= 4294967295
end

local function elapsed_u32(now, then)
    return (now - then) % 4294967296
end

local function same_ids(left, right)
    if #left ~= #right then return false end
    for index = 1, #left do
        if left[index] ~= right[index] then return false end
    end
    return true
end

local function dependency_result(code, fn, ...)
    if type(fn) ~= "function" then return fail(code, "Required Arena actor dependency is unavailable") end
    local called, value = pcall(fn, ...)
    if not called then return fail(code, "Arena actor dependency failed safely", { reason = tostring(value) }) end
    if type(value) == "table" and type(value.ok) == "boolean" then return value end
    if value == false then return fail(code, "Arena actor dependency reported failure") end
    return gamma_arena_result.ok(value)
end

local function call_actor(actor, method_name, ...)
    local looked_up, method = pcall(function() return actor and actor[method_name] end)
    if not looked_up or type(method) ~= "function" then
        return fail("GA_ACTOR_API_MISSING", "Required actor method is unavailable", { method = method_name })
    end
    local called, value = pcall(method, actor, ...)
    if not called then
        return fail("GA_ACTOR_EFFECT_FAILED", "Actor effect failed safely", { method = method_name, reason = tostring(value) })
    end
    if value == false then
        return fail("GA_ACTOR_EFFECT_FAILED", "Actor effect reported failure", { method = method_name })
    end
    return gamma_arena_result.ok(value)
end

local function set_actor_condition(actor, field_name, value)
    if actor == nil then
        return fail("GA_ACTOR_API_MISSING", "Required actor condition property is unavailable", { property = field_name })
    end
    local assigned, reason = pcall(function() actor[field_name] = value end)
    if not assigned then
        return fail("GA_ACTOR_EFFECT_FAILED", "Actor condition write failed safely", { property = field_name, reason = tostring(reason) })
    end
    return gamma_arena_result.ok(true)
end

local function point_coordinates(point)
    local ok, x, y, z = pcall(function() return point.x, point.y, point.z end)
    if not ok or not finite(x) or not finite(y) or not finite(z) then return nil end
    return x, y, z
end

function ActorAdapter:__init(deps)
    self.deps = deps
    self.input_owned = false
    self.update_tick = 0
    self.purge_tick = nil
    self.inventory_drain = nil
    self.inventory_clean = false
    self.victory_reset_started = false
end

function ActorAdapter:begin_update()
    self.update_tick = self.update_tick + 1
    return gamma_arena_result.ok(self.update_tick)
end

function ActorAdapter:owned_actor()
    local active_ok, active = pcall(self.deps.is_session_active)
    if not active_ok or active ~= true then
        return fail("GA_ACTOR_INACTIVE", "Actor effects are permitted only in an active Arena session")
    end
    local actor_ok, actor = pcall(self.deps.actor)
    if not actor_ok or actor == nil then return fail("GA_ACTOR_MISSING", "Arena actor is unavailable") end
    local owned_ok, owned = pcall(self.deps.is_actor_owned, actor)
    if not owned_ok or owned ~= true then
        return fail("GA_ACTOR_NOT_OWNED", "Campaign or foreign actor cannot be modified by Gamma Arena")
    end
    return gamma_arena_result.ok(actor)
end

function ActorAdapter:acquire_input()
    if self.input_owned then return gamma_arena_result.ok(false) end
    local input = self.deps.input
    local acquired = dependency_result("GA_ACTOR_INPUT_DISABLE_FAILED", input and input.acquire)
    if not acquired.ok then return acquired end
    self.input_owned = true
    return gamma_arena_result.ok(true)
end

function ActorAdapter:release_input()
    if not self.input_owned then return gamma_arena_result.ok(false) end
    local input = self.deps.input
    local released = dependency_result("GA_ACTOR_INPUT_ENABLE_FAILED", input and input.release)
    if not released.ok then return released end
    self.input_owned = false
    return gamma_arena_result.ok(true)
end

function ActorAdapter:inventory_clock()
    local clock = dependency_result("GA_ACTOR_INVENTORY_CLOCK_INVALID", self.deps.clock)
    if not clock.ok or not valid_u32(clock.value) then
        return fail("GA_ACTOR_INVENTORY_CLOCK_INVALID", "Arena inventory drain clock must return a uint32 integer")
    end
    return gamma_arena_result.ok(clock.value)
end

function ActorAdapter:snapshot_inventory(actor)
    local actor_id_result = call_actor(actor, "id")
    if not actor_id_result.ok or not valid_id(actor_id_result.value) then
        return fail("GA_ACTOR_ID_INVALID", "Arena actor has no valid numeric id")
    end
    local actor_id = actor_id_result.value
    local records, seen, inspection_error = {}, {}, nil
    local function collect(_, item)
        if inspection_error ~= nil then return end
        if item == nil then
            inspection_error = fail("GA_ACTOR_INVENTORY_ITEM_INVALID", "Actor inventory yielded a nil item")
            return
        end
        local parent_result = call_actor(item, "parent")
        if not parent_result.ok or parent_result.value == nil then
            inspection_error = fail("GA_ACTOR_INVENTORY_OWNER_INVALID", "Actor inventory item has no readable parent object", {
                cause = parent_result.error
            })
            return
        end
        local parent = parent_result.value
        local parent_id_result = call_actor(parent, "id")
        if parent ~= actor or not parent_id_result.ok or not valid_id(parent_id_result.value) or parent_id_result.value ~= actor_id then
            inspection_error = fail("GA_ACTOR_INVENTORY_OWNER_INVALID", "Refusing to inspect or release an item not owned by the Arena actor", {
                parent_is_actor = parent == actor,
                parent_id = parent_id_result.ok and parent_id_result.value or nil,
                cause = parent_id_result.error
            })
            return
        end
        local id_result = call_actor(item, "id")
        if not id_result.ok or not valid_id(id_result.value) then
            inspection_error = fail("GA_ACTOR_INVENTORY_ITEM_INVALID", "Actor inventory item has no valid numeric id", {
                cause = id_result.error
            })
            return
        end
        if not seen[id_result.value] then
            seen[id_result.value] = true
            local section = "<unavailable>"
            if type(self.deps.item_section) == "function" then
                local section_ok, section_value = pcall(self.deps.item_section, item)
                if section_ok and type(section_value) == "string" then section = section_value end
            end
            records[#records + 1] = { id = id_result.value, section = section }
        end
    end
    local iterated = call_actor(actor, "iterate_inventory", collect, nil)
    if not iterated.ok then return iterated end
    if inspection_error ~= nil then return inspection_error end
    table.sort(records, function(left, right) return left.id < right.id end)
    return gamma_arena_result.ok(records)
end

function ActorAdapter:purge_inventory(actor)
    local snapshot = self:snapshot_inventory(actor)
    if not snapshot.ok then return snapshot end
    local clock = self:inventory_clock()
    if not clock.ok then return clock end
    local drain = {
        started_at = clock.value,
        last_progress_at = clock.value,
        submitted_ids = {},
        sections_by_id = {},
        remaining_ids = {},
        poll_count = 0,
        last_count = #snapshot.value
    }
    for index = 1, #snapshot.value do
        local record = snapshot.value[index]
        drain.remaining_ids[index] = record.id
        drain.sections_by_id[record.id] = record.section
    end
    self.inventory_drain = drain
    for index = 1, #snapshot.value do
        local record = snapshot.value[index]
        local released = dependency_result("GA_ACTOR_INVENTORY_RELEASE_FAILED", self.deps.release_item_id, record.id)
        if not released.ok then return released end
        drain.submitted_ids[record.id] = true
    end
    self.purge_tick = self.update_tick
    self.inventory_clean = false
    return gamma_arena_result.ok(#snapshot.value)
end

function ActorAdapter:verify_inventory_empty()
    if self.inventory_clean then return gamma_arena_result.ok(true) end
    if self.purge_tick == nil or self.inventory_drain == nil then return fail("GA_ACTOR_INVENTORY_NOT_PURGED", "Actor inventory has not been purged") end
    if self.update_tick <= self.purge_tick then return gamma_arena_result.ok(false) end
    local owned = self:owned_actor()
    if not owned.ok then return owned end
    local clock = self:inventory_clock()
    if not clock.ok then return clock end
    local snapshot = self:snapshot_inventory(owned.value)
    if not snapshot.ok then return snapshot end
    local drain = self.inventory_drain
    drain.poll_count = drain.poll_count + 1
    local remaining_ids = {}
    for index = 1, #snapshot.value do
        local record = snapshot.value[index]
        remaining_ids[index] = record.id
        drain.sections_by_id[record.id] = record.section
        if not drain.submitted_ids[record.id] then
            local released = dependency_result("GA_ACTOR_INVENTORY_RELEASE_FAILED", self.deps.release_item_id, record.id)
            if not released.ok then return released end
            drain.submitted_ids[record.id] = true
        end
    end
    if not same_ids(drain.remaining_ids, remaining_ids) then drain.last_progress_at = clock.value end
    drain.remaining_ids = remaining_ids
    drain.last_count = #remaining_ids
    if #remaining_ids == 0 then
        self.inventory_clean = true
        return gamma_arena_result.ok(true)
    end
    local elapsed_since_progress_ms = elapsed_u32(clock.value, drain.last_progress_at)
    if elapsed_since_progress_ms < self.deps.inventory_drain_timeout_ms then return gamma_arena_result.ok(false) end
    local remaining_sections = {}
    for index = 1, #remaining_ids do
        local id = remaining_ids[index]
        remaining_sections[index] = { id = id, section = drain.sections_by_id[id] or "<unavailable>" }
    end
    return fail("GA_ACTOR_INVENTORY_NOT_EMPTY", "Arena actor inventory did not drain after deferred release", {
        remaining_count = #remaining_ids,
        remaining_ids = remaining_ids,
        remaining_sections = remaining_sections,
        poll_count = drain.poll_count,
        elapsed_since_progress_ms = elapsed_since_progress_ms,
        total_elapsed_ms = elapsed_u32(clock.value, drain.started_at),
        timeout_ms = self.deps.inventory_drain_timeout_ms
    })
end

function ActorAdapter:normalize_status(actor)
    local health = call_actor(actor, "set_health_ex", 1)
    if not health.ok then
        health = call_actor(actor, "set_health", 1)
        if not health.ok then return health end
    end
    for _, entry in ipairs({
        { "power", 1 },
        { "radiation", 0 },
        { "bleeding", 1 },
        { "psy_health", 1 }
    }) do
        local applied = set_actor_condition(actor, entry[1], entry[2])
        if not applied.ok then return applied end
    end
    if type(self.deps.mod_body_health_reset) == "function" then
        local body_health = dependency_result("GA_ACTOR_BODY_HEALTH_RESET_FAILED", self.deps.mod_body_health_reset, actor)
        if not body_health.ok then return body_health end
    end
    if type(self.deps.mod_psy_reset) == "function" then
        local ok, reason = pcall(self.deps.mod_psy_reset, actor)
        if not ok then pcall(gamma_arena_log.warn, "GA_ACTOR_OPTIONAL_PSY_RESET_FAILED", "Optional GAMMA psy reset failed", { reason = tostring(reason) }) end
    end
    local effects = self.deps.effects
    if type(effects) == "table" and type(effects.disable_effects_timer) == "function" then
        local ok, reason = pcall(effects.disable_effects_timer, 100)
        if not ok then pcall(gamma_arena_log.warn, "GA_ACTOR_EFFECT_TIMER_FAILED", "Optional effect timer reset failed", { reason = tostring(reason) }) end
    end
    return gamma_arena_result.ok(true)
end

function ActorAdapter:position_actor(actor, layout)
    local layout_ok, spawn_path, look_path = pcall(function() return layout.actor_spawn_path, layout.actor_look_path end)
    if type(layout) ~= "table" or not layout_ok or type(spawn_path) ~= "string" or type(look_path) ~= "string" then
        return fail("GA_ACTOR_LAYOUT_INVALID", "Arena layout has no actor spawn/look paths")
    end
    local spawn_ok, spawn_patrol = pcall(self.deps.patrol, spawn_path)
    local look_ok, look_patrol = pcall(self.deps.patrol, look_path)
    if not spawn_ok or spawn_patrol == nil or not look_ok or look_patrol == nil then
        return fail("GA_ACTOR_PATROL_MISSING", "Arena actor patrol object is unavailable")
    end
    local spawn_result = call_actor(spawn_patrol, "point", 0)
    local look_result = call_actor(look_patrol, "point", 0)
    if not spawn_result.ok or not look_result.ok then return fail("GA_ACTOR_PATROL_INVALID", "Arena actor patrol point could not be resolved") end
    local sx, sy, sz = point_coordinates(spawn_result.value)
    local lx, ly, lz = point_coordinates(look_result.value)
    if sx == nil or lx == nil then return fail("GA_ACTOR_PATROL_INVALID", "Arena actor patrol point is not finite") end
    if sx == lx and sy == ly and sz == lz then
        return fail("GA_ACTOR_PATROL_COINCIDENT", "Arena actor spawn and look points must differ")
    end
    local direction_ok, direction = pcall(function() return look_result.value:sub(spawn_result.value) end)
    if not direction_ok or direction == nil then return fail("GA_ACTOR_PATROL_INVALID", "Arena actor look direction could not be calculated") end
    local heading_result = call_actor(direction, "getH")
    if not heading_result.ok or not finite(heading_result.value) then return fail("GA_ACTOR_PATROL_INVALID", "Arena actor look heading is invalid") end
    local positioned = call_actor(actor, "set_actor_position", spawn_result.value)
    if not positioned.ok then return positioned end
    local directed = call_actor(actor, "set_actor_direction", -heading_result.value)
    if not directed.ok then return directed end
    local observed = call_actor(actor, "position")
    if not observed.ok then return observed end
    local ox, oy, oz = point_coordinates(observed.value)
    if ox == nil then return fail("GA_ACTOR_POSITION_INVALID", "Arena actor position could not be verified after teleport") end
    return gamma_arena_result.ok({
        spawn_path = spawn_path,
        look_path = look_path,
        requested = { x = sx, y = sy, z = sz },
        observed = { x = ox, y = oy, z = oz }
    })
end

function ActorAdapter:zero_money(actor)
    local money = call_actor(actor, "money")
    if not money.ok or not finite(money.value) then return fail("GA_ACTOR_MONEY_INVALID", "Arena actor money value is invalid") end
    if money.value == 0 then return gamma_arena_result.ok(false) end
    return call_actor(actor, "give_money", -money.value)
end

function ActorAdapter:normalize_for_arena(layout)
    local owned = self:owned_actor()
    if not owned.ok then return owned end
    local acquired = self:acquire_input()
    if not acquired.ok then return acquired end
    local actor = owned.value
    local position_snapshot = nil
    local steps = {
        function() return self:purge_inventory(actor) end,
        function() return self:normalize_status(actor) end,
        function()
            local positioned = self:position_actor(actor, layout)
            if positioned.ok then position_snapshot = positioned.value end
            return positioned
        end,
        function() return self:zero_money(actor) end
    }
    for index = 1, #steps do
        local result = steps[index]()
        if not result.ok then
            local released = self:release_input()
            if not released.ok then
                return fail("GA_ACTOR_NORMALIZE_ROLLBACK_FAILED", "Actor normalization and input rollback both failed", { cause = result.error, rollback = released.error })
            end
            return result
        end
    end
    return gamma_arena_result.ok({ position = position_snapshot })
end

function ActorAdapter:apply_loadout(loadout)
    local owned = self:owned_actor()
    if not owned.ok then return owned end
    local port = self.deps.loadout
    return dependency_result("GA_ACTOR_LOADOUT_UNAVAILABLE", port and port.apply, owned.value, loadout)
end

function ActorAdapter:update_loadout()
    local owned = self:owned_actor()
    if not owned.ok then return owned end
    local port = self.deps.loadout
    return dependency_result("GA_ACTOR_LOADOUT_UPDATE_FAILED", port and port.update, owned.value)
end

function ActorAdapter:cleanup_loadout_for_restore()
    local loadout = self.deps.loadout
    if type(loadout) ~= "table" or type(loadout.cleanup) ~= "function" then
        return fail("GA_ACTOR_LOADOUT_CLEANUP_FAILED", "Arena actor loadout cleanup port is unavailable before checkpoint restore")
    end
    return dependency_result("GA_ACTOR_LOADOUT_CLEANUP_FAILED", loadout.cleanup)
end

function ActorAdapter:reset_for_rematch(layout)
    if self.victory_reset_started then
        local empty = self:verify_inventory_empty()
        if not empty.ok then return empty end
        if empty.value ~= true then return gamma_arena_result.ok({ pending = true, stage = "inventory_absence" }) end
        self.victory_reset_started = false
        return gamma_arena_result.ok(true)
    end
    local loadout = self.deps.loadout
    if type(loadout) == "table" and type(loadout.cleanup) == "function" then
        local cleaned = dependency_result("GA_ACTOR_LOADOUT_CLEANUP_FAILED", loadout.cleanup)
        if not cleaned.ok then return cleaned end
        if type(cleaned.value) == "table" and cleaned.value.pending == true then return cleaned end
    end
    local normalized = self:normalize_for_arena(layout)
    if not normalized.ok then return normalized end
    self.victory_reset_started = true
    return gamma_arena_result.ok({ pending = true, stage = "inventory_absence" })
end

function ActorAdapter:cleanup()
    local errors = {}
    local loadout_pending = false
    local loadout = self.deps.loadout
    if type(loadout) == "table" and type(loadout.cleanup) == "function" then
        local result = dependency_result("GA_ACTOR_LOADOUT_CLEANUP_FAILED", loadout.cleanup)
        if not result.ok then
            errors[#errors + 1] = result.error
        elseif type(result.value) == "table" and result.value.pending == true then
            loadout_pending = true
        end
    end
    local input = self:release_input()
    if not input.ok then errors[#errors + 1] = input.error end
    self.purge_tick = nil
    self.inventory_drain = nil
    self.inventory_clean = false
    self.victory_reset_started = false
    if #errors > 0 then return fail("GA_ACTOR_CLEANUP_FAILED", "Arena actor cleanup failed", { errors = errors }) end
    if loadout_pending then return gamma_arena_result.ok({ pending = true, stage = "actor_loadout" }) end
    return gamma_arena_result.ok(true)
end

function new(deps)
    if type(deps) ~= "table" then return nil end
    local value = setmetatable({}, ActorAdapter)
    value:__init(deps)
    return value
end
