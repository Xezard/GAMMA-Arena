function generate(session, fight_index, catalog, layout)
    local catalog_identity = gamma_arena_fight_spec.validate_catalog_identity(catalog)
    if not catalog_identity.ok then return catalog_identity end
    local draft
    if type(session) == "table" and session.generation_recipe == "custom" then
        draft = gamma_arena_custom_generator.build_draft(session, fight_index, catalog, layout)
    elseif type(session) == "table" and (session.generation_recipe == nil or session.generation_recipe == "random") then
        draft = gamma_arena_random_generator.build_draft(session, fight_index, catalog, layout)
    else
        return gamma_arena_result.err("GA_GENERATION_RECIPE_INVALID", "Arena session generation recipe is invalid", {})
    end
    if not draft.ok then return draft end
    local canonical = gamma_arena_fight_spec.canonicalize(draft.value, {
        session_seed = session.session_seed,
        fight_index = fight_index,
        generator_version = catalog.generator_version,
        catalog_schema_version = catalog.schema_version,
        catalog_revision = catalog.revision,
        catalog_fingerprint = catalog.fingerprint,
        layout_version = layout.version,
        layout_hash = gamma_arena_fight_spec.layout_hash(layout)
    }, catalog, layout)
    if not canonical.ok then return canonical end
    local strict = gamma_arena_fight_validator_v9.validate(canonical.value, catalog, layout)
    if not strict.ok then return strict end
    return canonical
end
