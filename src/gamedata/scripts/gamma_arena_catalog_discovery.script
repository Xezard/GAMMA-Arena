local WEAPON_COST = {
    w_pistol = 2,
    w_smg = 4,
    w_shotgun = 5,
    w_rifle = 5,
    w_sniper = 6
}

local OUTFIT_COST = {
    o_light = 1,
    o_medium = 3,
    o_sci = 4,
    o_heavy = 5
}

local OUTFIT_CLASS = {
    o_light = "light",
    o_medium = "medium",
    o_sci = "scientific",
    o_heavy = "heavy"
}

local function failure(code, message, context)
    return gamma_arena_result.err(code, message, context or {})
end

local function finite_u32(value, minimum)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
        and value == math.floor(value) and value >= (minimum or 0) and value < 4294967296
end

local function trimmed(value)
    if type(value) ~= "string" then return nil end
    local result = string.gsub(value, "^%s*(.-)%s*$", "%1")
    if result == "" then return nil end
    return result
end

local function split_csv(value)
    local values = {}
    for token in string.gmatch(value or "", "[^,]+") do
        local normalized = trimmed(token)
        if normalized ~= nil then values[#values + 1] = normalized end
    end
    return values
end

local function guarded(source, method_name, ...)
    local method = type(source) == "table" and source[method_name] or nil
    if type(method) ~= "function" then return false, nil end
    local called, value = pcall(method, ...)
    if not called then return false, value end
    return true, value
end

local function read_string_result(source, section, key)
    local ok, value = guarded(source, "read_string", section, key)
    if not ok then return false, nil end
    return true, trimmed(value)
end

local function read_string(source, section, key)
    local _, value = read_string_result(source, section, key)
    return value
end

local function read_u32(source, section, key, minimum)
    local ok, value = guarded(source, "read_u32", section, key)
    if not ok or not finite_u32(value, minimum) then return nil end
    return value
end

local function candidate_section(section)
    return string.sub(section, 1, 4) == "wpn_" or string.sub(section, -7) == "_outfit"
end

local function normalized_sections(source)
    local ok, values = guarded(source, "enumerate_sections")
    if not ok or type(values) ~= "table" then return nil end
    local normalized, seen = {}, {}
    for _, section in ipairs(values) do
        local name = trimmed(section)
        if name ~= nil and candidate_section(name) and not seen[name] then
            seen[name] = true
            normalized[#normalized + 1] = name
        end
    end
    table.sort(normalized)
    return normalized
end

local function rejected_ammo(section)
    return string.match(section, "_bad$") ~= nil or string.match(section, "_verybad$") ~= nil or string.match(section, "_self$") ~= nil
end

local function ammo_category(section, is_base)
    if is_base then return "standard" end
    if string.match(section, "_ap$") or string.match(section, "_dart$") then return "armor_piercing" end
    if string.match(section, "_hp$") or string.match(section, "_hydro$") or string.match(section, "_pbp$")
        or string.match(section, "_ep$") or string.match(section, "_ss190$") or string.match(section, "_pmm$")
        or string.match(section, "_zhekan$") or string.find(section, "_hp_", 1, true) ~= nil then return "special" end
    return nil
end

local function compatible_ammo_variants(source, raw_ammo)
    local variants, seen = {}, {}
    for _, ammo_section in ipairs(split_csv(raw_ammo)) do
        if not seen[ammo_section] then
            seen[ammo_section] = true
            if not rejected_ammo(ammo_section) and read_string(source, ammo_section, "kind") == "w_ammo" then
                local box_size = read_u32(source, ammo_section, "box_size", 1)
                if box_size ~= nil then
                    variants[#variants + 1] = { section = ammo_section, category = ammo_category(ammo_section, #variants == 0), box_size = box_size }
                end
            end
        end
    end
    return variants
end

local function compatible_weapon_variant(source, section)
    local parent_read, parent = read_string_result(source, section, "parent_section")
    if not parent_read then return false end
    if parent == nil or parent == section then return true end
    if WEAPON_COST[read_string(source, parent, "kind")] == nil then return false end
    local grandparent_read, grandparent = read_string_result(source, parent, "parent_section")
    if not grandparent_read then return false end
    if grandparent ~= nil and grandparent ~= parent then return false end
    local prefix = parent .. "_"
    if string.sub(section, 1, #prefix) ~= prefix then return false end
    local attachment = string.sub(section, #prefix + 1)
    if attachment == "" then return false end
    for _, allowed in ipairs(split_csv(read_string(source, parent, "scopes"))) do
        if allowed ~= "none" and attachment == allowed then return true end
    end
    return false
end

local function sort_records(records)
    table.sort(records, function(left, right) return left.section < right.section end)
end

local function fallback()
    return gamma_arena_result.ok({
        mode = "fallback",
        weapons = {},
        ammo = {},
        outfits = {},
        knives = {},
        fingerprint_parts = { "fallback" },
        skipped = 0
    })
end

function discover(source)
    if type(source) ~= "table" or type(source.enumerate_sections) ~= "function"
        or type(source.read_string) ~= "function" or type(source.read_u32) ~= "function" then
        return failure("GA_CATALOG_DISCOVERY_SOURCE_INVALID", "Dynamic catalog discovery source is invalid")
    end

    local sections = normalized_sections(source)
    if sections == nil then return fallback() end

    local weapons, ammo, outfits, knives = {}, {}, {}, {}
    local ammo_by_section = {}
    local skipped = 0

    for _, section in ipairs(sections) do
        local kind = read_string(source, section, "kind")
        local weapon_cost = WEAPON_COST[kind]
        if weapon_cost ~= nil then
            if not compatible_weapon_variant(source, section) then
                skipped = skipped + 1
            else
                local slot = read_u32(source, section, "slot", 0)
                local magazine = read_u32(source, section, "ammo_mag_size", 1)
                local ammo_variants, ammo_error = compatible_ammo_variants(source, read_string(source, section, "ammo_class"))
                if ammo_error ~= nil then return ammo_error end
                local ammo_section = ammo_variants[1] and ammo_variants[1].section or nil
                if (slot == 1 or slot == 2) and magazine ~= nil and ammo_section ~= nil then
                    weapons[#weapons + 1] = {
                        id = section,
                        section = section,
                        ammo = ammo_section,
                        ammo_variants = ammo_variants,
                        magazine_size = magazine,
                        cost = weapon_cost,
                        ammo_box_min = 1,
                        ammo_box_max = 2,
                        kind = kind,
                        slot = slot
                    }
                    for _, variant in ipairs(ammo_variants) do
                        if not ammo_by_section[variant.section] then
                            local record = { id = variant.section, section = variant.section, cost = 1 }
                            ammo_by_section[variant.section] = record
                            ammo[#ammo + 1] = record
                        end
                    end
                else
                    skipped = skipped + 1
                end
            end
        elseif OUTFIT_COST[kind] ~= nil then
            if read_u32(source, section, "slot", 0) == 6 then
                local armor_class = OUTFIT_CLASS[kind]
                if armor_class ~= nil and (read_string(source, section, "repair_type") == "outfit_exo"
                    or string.find(section, "proto", 1, true) ~= nil) then
                    armor_class = "powered_exo"
                end
                outfits[#outfits + 1] = {
                    id = section,
                    section = section,
                    cost = OUTFIT_COST[kind],
                    kind = kind,
                    armor_class = armor_class
                }
            else
                skipped = skipped + 1
            end
        elseif kind == "w_melee" and string.sub(section, 1, 9) == "wpn_knife" then
            if read_u32(source, section, "slot", 0) == 0 then
                knives[#knives + 1] = { id = section, section = section }
            else
                skipped = skipped + 1
            end
        elseif string.sub(section, 1, 4) == "wpn_" and type(kind) == "string"
            and kind ~= "w_ammo" and kind ~= "w_melee" then
            skipped = skipped + 1
        end
    end

    sort_records(weapons)
    sort_records(ammo)
    sort_records(outfits)
    sort_records(knives)

    local fingerprint_parts = { "dynamic_catalog_v7" }
    for _, item in ipairs(weapons) do
        fingerprint_parts[#fingerprint_parts + 1] = table.concat({ "weapon", item.section, item.ammo, item.kind, item.slot, item.magazine_size, item.cost }, ":")
        for _, variant in ipairs(item.ammo_variants) do
            fingerprint_parts[#fingerprint_parts + 1] = table.concat({ "ammo_variant", item.section, variant.section, variant.category or "unclassified", variant.box_size }, ":")
        end
    end
    for _, item in ipairs(ammo) do
        fingerprint_parts[#fingerprint_parts + 1] = table.concat({ "ammo", item.section, item.cost }, ":")
    end
    for _, item in ipairs(outfits) do
        fingerprint_parts[#fingerprint_parts + 1] = table.concat({ "outfit", item.section, item.kind, item.armor_class, item.cost }, ":")
    end
    for _, item in ipairs(knives) do
        fingerprint_parts[#fingerprint_parts + 1] = "knife:" .. item.section
    end
    return gamma_arena_result.ok({
        mode = "dynamic",
        weapons = weapons,
        ammo = ammo,
        outfits = outfits,
        knives = knives,
        fingerprint_parts = fingerprint_parts,
        skipped = skipped
    })
end
