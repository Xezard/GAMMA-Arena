function ok(value)
    return {
        ok = true,
        value = value
    }
end

function err(code, message, context)
    return {
        ok = false,
        error = {
            code = code,
            message = message,
            context = context or {}
        }
    }
end

function is_ok(result)
    return type(result) == "table" and result.ok == true
end
