local function split(text, sort_values)
    local values = {}
    for value in string.gmatch(text or "", "[^,%s]+") do values[#values + 1] = value end
    if sort_values ~= false then table.sort(values) end
    return values
end

local function runtime_factory()
    local base = system_ini()
    return {
        open = function(path) return ini_file(path) end,
        section_exists = function(section) return base:section_exist(section) end,
        enumerate_sections = function(ini)
            local sections = {}
            ini:section_for_each(function(section) sections[#sections + 1] = section end)
            return sections
        end,
        enumerate_keys = function(ini, section)
            local keys = {}
            local count = ini:line_count(section)
            for index = 0, count - 1 do
                local _, key = ini:r_line(section, index, "", "")
                keys[#keys + 1] = key
            end
            return keys
        end,
        enumerate_system_sections = function()
            local sections = {}
            base:section_for_each(function(section) sections[#sections + 1] = section end)
            return sections
        end,
        read_system_string = function(section, key) return base:r_string_ex(section, key) end,
        read_system_u32 = function(section, key) return base:r_u32(section, key) end,
        open_loadouts = function() return ini_file(npc_loadout_path) end,
        read_loadout_string = function(ini, section, key) return ini:r_string_ex(section, key) end,
        enumerate_loadout_keys = function(ini, section)
            local keys = {}
            local count = ini:line_count(section)
            for index = 0, count - 1 do
                local _, key = ini:r_line_ex(section, index)
                keys[#keys + 1] = key
            end
            return keys
        end
    }
end

local function read(factory, ini, section, key)
    if type(ini.sections) == "table" then
        local values = ini.sections[section]
        return values and values[key] or nil
    end
    local ok, value = pcall(function() return ini:r_string(section, key) end)
    return ok and value or nil
end

local function safe_open(factory, path)
    local succeeded, value = pcall(factory.open, path)
    if not succeeded or value == nil then return nil, gamma_arena_result.err("GA_CATALOG_OPEN_FAILED", "Arena catalog file could not be opened", { path = path, reason = succeeded and "nil" or tostring(value) }) end
    return value
end

local function safe_section_exists(factory, section)
    local succeeded, value = pcall(factory.section_exists, section)
    if not succeeded then return nil, gamma_arena_result.err("GA_CATALOG_SECTION_CHECK_FAILED", "Game section check failed", { section = section, reason = tostring(value) }) end
    return value == true
end

local function validate_effective_device(factory, item)
    if type(factory.read_system_string) ~= "function" or type(factory.read_system_u32) ~= "function" then
        return nil, gamma_arena_result.err("GA_DEVICE_EFFECTIVE_INVALID", "Effective actor device metadata readers are unavailable", { section = item.section })
    end
    local class_ok, effective_class = pcall(factory.read_system_string, item.section, "class")
    local slot_ok, effective_slot = pcall(factory.read_system_u32, item.section, "slot")
    local effect_ok, effective_effect = pcall(factory.read_system_string, item.section, "nv_effect")
    if not class_ok or effective_class ~= "TORCH_S" or not slot_ok or effective_slot ~= 9 or not effect_ok
        or effective_effect ~= item.nv_effect then
        return nil, gamma_arena_result.err("GA_DEVICE_EFFECTIVE_INVALID", "Effective actor device class, slot, or NV effect is incompatible", {
            section = item.section,
            effective_class = class_ok and effective_class or nil,
            effective_slot = slot_ok and effective_slot or nil,
            expected_effect = item.nv_effect,
            effective_effect = effect_ok and effective_effect or nil
        })
    end
    return true
end

local function enumerate_sections(factory, ini)
    if type(factory.enumerate_sections) == "function" then
        local succeeded, values = pcall(factory.enumerate_sections, ini)
        if not succeeded or type(values) ~= "table" then return nil, gamma_arena_result.err("GA_CATALOG_ENUMERATION_FAILED", "Catalog section enumeration failed", { reason = tostring(values) }) end
        return values
    end
    if type(ini.sections) == "table" then local values = {}; for section in pairs(ini.sections) do values[#values + 1] = section end; table.sort(values); return values end
    return nil, gamma_arena_result.err("GA_CATALOG_ENUMERATION_FAILED", "Catalog section enumeration is unavailable", {})
end

local function enumerate_keys(factory, ini, section)
    if type(factory.enumerate_keys) == "function" then
        local succeeded, values = pcall(factory.enumerate_keys, ini, section)
        if not succeeded or type(values) ~= "table" then return nil, gamma_arena_result.err("GA_CATALOG_ENUMERATION_FAILED", "Catalog key enumeration failed", { section = section, reason = tostring(values) }) end
        return values
    end
    if type(ini.sections) == "table" then local values = {}; for key in pairs(ini.sections[section] or {}) do values[#values + 1] = key end; table.sort(values); return values end
    return nil, gamma_arena_result.err("GA_CATALOG_ENUMERATION_FAILED", "Catalog key enumeration is unavailable", { section = section })
end

local function integer(value, name, context)
    local parsed = tonumber(value)
    if not gamma_arena_number.is_integer(parsed) then
        return nil, gamma_arena_result.err("GA_CATALOG_INVALID", name .. " must be a finite integer", context)
    end
    return parsed
end

local function finite_number(value, name, context)
    local parsed = tonumber(value)
    if type(parsed) ~= "number" or parsed ~= parsed or parsed == math.huge or parsed == -math.huge then
        return nil, gamma_arena_result.err("GA_CATALOG_INVALID", name .. " must be finite", context)
    end
    return parsed
end

local function positive_number_list(value, name, context)
    local values = split(value, false)
    if #values == 0 then return nil, gamma_arena_result.err("GA_CATALOG_INVALID", name .. " must not be empty", context) end
    for index, raw in ipairs(values) do
        local parsed, parse_error = finite_number(raw, name, context)
        if parsed == nil then return nil, parse_error end
        if parsed <= 0 then return nil, gamma_arena_result.err("GA_CATALOG_INVALID", name .. " values must be positive", context) end
        values[index] = parsed
    end
    return values
end

local function normalized_weight_row(factory, ini, section, keys, name)
    local values, total = {}, 0
    for normalized_key, source_key in pairs(keys) do
        local value, parse_error = integer(read(factory, ini, section, source_key), source_key, { section = section })
        if not value then return nil, parse_error end
        if value < 0 then return nil, gamma_arena_result.err("GA_DIFFICULTY_INVALID", name .. " weights must be non-negative integers", { section = section, key = source_key }) end
        values[normalized_key] = value
        total = total + value
    end
    if total <= 0 then return nil, gamma_arena_result.err("GA_DIFFICULTY_INVALID", name .. " weights must have a positive sum", { section = section }) end
    return values
end

local function exact_ids(group_name, raw_ids)
    local expected = catalog_manifest_v10[group_name]
    if type(raw_ids) ~= "string" or type(expected) ~= "table" then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Catalog group ids must match v10", { group = group_name }) end
    local ids, seen, expected_count = split(raw_ids), {}, 0
    for _, id in ipairs(ids) do if seen[id] then return nil, gamma_arena_result.err("GA_CATALOG_DUPLICATE_ID", "Catalog ids must be unique", { group = group_name, id = id }) end; seen[id] = true end
    for _ in pairs(expected) do expected_count = expected_count + 1 end
    if #ids ~= expected_count then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Catalog group id count differs from v10", { group = group_name, count = #ids, expected = expected_count }) end
    for _, id in ipairs(ids) do if not expected[id] then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Catalog group contains a non-v10 id", { group = group_name, id = id }) end end
    for id in pairs(expected) do if not seen[id] then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Catalog group is missing a v10 id", { group = group_name, id = id }) end end
    return ids
end

local function validate_semantic_entry(group_name, item)
    local expected = catalog_manifest_v10[group_name] and catalog_manifest_v10[group_name][item.id]
    if not expected or item.section ~= expected.section then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Catalog entry differs from v10", { group = group_name, id = item.id }) end
    if group_name == "medical_items" then
        if item.category ~= expected.category or item.actor_cost ~= expected.actor_cost or item.npc_cost ~= expected.npc_cost or item.min_tier ~= expected.min_tier or item.max_count ~= expected.max_count then
            return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Medical catalog entry differs from v10", { group = group_name, id = item.id })
        end
        return true
    end
    if group_name == "devices" then
        if item.kind ~= expected.kind or item.weight ~= expected.weight or item.nv_effect ~= expected.nv_effect then
            return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Device catalog entry differs from v10", { group = group_name, id = item.id })
        end
        return true
    end
    if item.cost ~= expected.cost then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Catalog entry differs from v10", { group = group_name, id = item.id }) end
    if group_name == "weapons" and item.ammo ~= expected.ammo then return nil, gamma_arena_result.err("GA_CATALOG_AMMO_INVALID", "Weapon ammo differs from v10", { id = item.id, ammo = item.ammo }) end
    if group_name == "weapons" and (item.ammo_box_min ~= expected.ammo_box_min or item.ammo_box_max ~= expected.ammo_box_max or item.kind ~= expected.kind or item.slot ~= expected.slot) then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Weapon entry differs from v10", { id = item.id }) end
    if group_name == "outfits" and item.armor_class ~= expected.armor_class then return nil, gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Outfit armor class differs from v10", { id = item.id }) end
    return true
end

local function validate_section_manifest(factory, ini, allowed, path)
    local sections, enumeration_error = enumerate_sections(factory, ini)
    if not sections then return nil, enumeration_error end
    local seen = {}
    for _, section in ipairs(sections) do
        if type(section) ~= "string" or seen[section] then return nil, gamma_arena_result.err("GA_CATALOG_DUPLICATE_SECTION", "Catalog section names must be unique strings", { path = path, section = section }) end
        seen[section] = true
        if not allowed[section] then return nil, gamma_arena_result.err("GA_CATALOG_UNKNOWN_SECTION", "Catalog contains an unknown section", { path = path, section = section }) end
    end
    return true
end

local function require_section(factory, ini, section, allowed)
    local exists
    if type(ini.sections) == "table" then exists = type(ini.sections[section]) == "table" else local succeeded, value = pcall(function() return ini:section_exist(section) end); exists = succeeded and value end
    if not exists then return nil, gamma_arena_result.err("GA_CATALOG_SECTION_MISSING", "Catalog section is missing", { section = section }) end
    local keys, enumeration_error = enumerate_keys(factory, ini, section)
    if not keys then return nil, enumeration_error end
    local seen = {}
    for _, key in ipairs(keys) do
        if type(key) ~= "string" or seen[key] then return nil, gamma_arena_result.err("GA_CATALOG_DUPLICATE_KEY", "Catalog keys must be unique strings", { section = section, key = key }) end
        seen[key] = true
        if not allowed[key] then return nil, gamma_arena_result.err("GA_CATALOG_UNKNOWN_KEY", "Catalog contains an unknown key", { section = section, key = key }) end
    end
    return true
end

local function add_loadout_combinations(snapshot)
    snapshot.combinations = {}
    for _, weapon in ipairs(snapshot.weapon_list) do
        local ammo = snapshot.ammo[weapon.ammo]
        for _, outfit in ipairs(snapshot.outfit_list) do
            for boxes = weapon.ammo_box_min, weapon.ammo_box_max do
                local consumables = { "bandage" }
                local cost = weapon.cost + ammo.cost * boxes + outfit.cost + snapshot.consumables.bandage.cost
                snapshot.combinations[#snapshot.combinations + 1] = { weapon = weapon.section, ammo = ammo.section, ammo_boxes = boxes, outfit = outfit.section, consumables = consumables, cost = cost }
            end
        end
    end
    table.sort(snapshot.combinations, function(a, b)
        if a.cost ~= b.cost then return a.cost < b.cost end
        if a.weapon ~= b.weapon then return a.weapon < b.weapon end
        if a.outfit ~= b.outfit then return a.outfit < b.outfit end
        return a.ammo_boxes < b.ammo_boxes
    end)
end

local function contains_section(values, section)
    for _, item in pairs(values or {}) do
        if type(item) == "table" and item.section == section then return true end
    end
    return false
end

local function append_discovered(target, list, item)
    local existing
    for _, candidate in pairs(target) do
        if type(candidate) == "table" and candidate.section == item.section then existing = candidate; break end
    end
    if type(existing) == "table" then
        if type(item.ammo_variants) == "table" and existing.ammo == item.ammo then existing.ammo_variants = item.ammo_variants end
        if gamma_arena_number.is_positive_integer(item.magazine_size) then existing.magazine_size = item.magazine_size end
        return
    end
    target[item.section] = item
    list[#list + 1] = item
end

local function sort_catalog_list(values)
    table.sort(values, function(left, right)
        if left.cost ~= nil and right.cost ~= nil and left.cost ~= right.cost then return left.cost < right.cost end
        return left.section < right.section
    end)
end

local function profile_with_section(values, section)
    for _, profile in ipairs(values) do if profile.section == section then return profile end end
    return nil
end

local function augment_profiles(factory, snapshot, fingerprint_parts)
    snapshot.faction_ids = {}
    snapshot.profiles_by_faction = {}
    for _, faction in ipairs(PROFILE_FACTIONS) do
        local faction_profiles = {}
        for rank_index, rank in ipairs(PROFILE_RANKS) do
            local section = "gamma_arena_" .. faction .. "_" .. rank.id
            local exists, section_error = safe_section_exists(factory, section)
            if exists == nil then return nil, section_error end
            if exists then
                local profile = profile_with_section(snapshot.profile_list, section)
                if profile == nil then
                    profile = { id = section, section = section, cost = rank.cost }
                    snapshot.profile_list[#snapshot.profile_list + 1] = profile
                end
                profile.faction = faction
                profile.community = faction
                profile.runtime_community = ARENA_RUNTIME_COMMUNITY
                profile.rank = rank.id
                profile.rank_index = rank_index - 1
                snapshot.profiles[section] = profile
                faction_profiles[#faction_profiles + 1] = profile
                fingerprint_parts[#fingerprint_parts + 1] = table.concat({ "profile", section, faction, rank.id, rank.cost }, ":")
            end
        end
        if #faction_profiles > 0 and faction_profiles[1].rank == "novice" then
            snapshot.faction_ids[#snapshot.faction_ids + 1] = faction
            snapshot.profiles_by_faction[faction] = faction_profiles
        end
    end
    table.sort(snapshot.faction_ids)
    table.sort(snapshot.profile_list, function(left, right)
        if left.cost ~= right.cost then return left.cost < right.cost end
        return left.section < right.section
    end)
    return true
end

local function normalized_pool_weapon(line)
    if type(line) ~= "string" then return nil end
    local section = string.match(line, "^%s*([^:%s]+)")
    if type(section) ~= "string" or section == "" then return nil end
    return section
end

local function read_loadout_string(factory, ini, section, key)
    if type(factory.read_loadout_string) == "function" then
        local succeeded, value = pcall(factory.read_loadout_string, ini, section, key)
        if succeeded then return value end
        return nil
    end
    return read(factory, ini, section, key)
end

local function enumerate_loadout_keys(factory, ini, section)
    if type(factory.enumerate_loadout_keys) == "function" then
        local succeeded, values = pcall(factory.enumerate_loadout_keys, ini, section)
        if succeeded and type(values) == "table" then return values end
        return nil
    end
    return enumerate_keys(factory, ini, section)
end

local function index_faction_weapon_pools(factory, snapshot)
    snapshot.weapon_pools_by_profile = {}
    if type(factory.open_loadouts) ~= "function" then return end
    local opened, loadouts = pcall(factory.open_loadouts)
    if not opened or loadouts == nil then return end
    local eligible = {}
    for _, weapon in ipairs(snapshot.weapon_list) do eligible[weapon.section] = weapon end
    for _, profile in ipairs(snapshot.profile_list) do
        if type(profile.faction) == "string" and type(profile.rank) == "string" then
            local loadout_section = profile.faction .. "_" .. profile.rank
            local pools = { primary = {}, secondary = {} }
            local seen = { primary = {}, secondary = {} }
            for _, slot_key in ipairs({ "primary", "primery", "secondary" }) do
                local role = slot_key == "secondary" and "secondary" or "primary"
                local pool_section = read_loadout_string(factory, loadouts, loadout_section, slot_key)
                if type(pool_section) == "string" and pool_section ~= "" then
                    local keys = enumerate_loadout_keys(factory, loadouts, pool_section)
                    if type(keys) == "table" then
                        for _, line in ipairs(keys) do
                            local section = normalized_pool_weapon(line)
                            if eligible[section] ~= nil and not seen[role][section] then
                                seen[role][section] = true
                                pools[role][#pools[role] + 1] = eligible[section]
                            end
                        end
                    end
                end
            end
            table.sort(pools.primary, function(left, right) return left.section < right.section end)
            table.sort(pools.secondary, function(left, right) return left.section < right.section end)
            snapshot.weapon_pools_by_profile[profile.section] = pools
        end
    end
end

local function index_global_weapon_roles(snapshot)
    snapshot.primary_weapon_list = {}
    snapshot.secondary_weapon_list = {}
    for _, weapon in ipairs(snapshot.weapon_list) do
        local target = weapon.kind == "w_pistol" and snapshot.secondary_weapon_list or snapshot.primary_weapon_list
        target[#target + 1] = weapon
    end
end

local function index_actor_weapon_list(snapshot)
    local quarantined = {}
    for section, blocked in pairs(ACTOR_WEAPON_QUARANTINE) do
        if blocked == true then quarantined[#quarantined + 1] = section end
    end
    table.sort(quarantined)
    snapshot.actor_weapon_list = {}
    for _, weapon in ipairs(snapshot.weapon_list) do
        if ACTOR_WEAPON_QUARANTINE[weapon.section] ~= true then
            snapshot.actor_weapon_list[#snapshot.actor_weapon_list + 1] = weapon
        end
    end
    if snapshot.selection_mode == "staged" then
        snapshot.revision = gamma_arena_rng.derive_seed({
            ACTOR_WEAPON_QUARANTINE_POLICY,
            snapshot.revision,
            table.concat(quarantined, "|")
        })
    end
end

local function valid_ammo_variant(variant)
    return type(variant) == "table" and type(variant.section) == "string" and variant.section ~= ""
        and gamma_arena_number.is_positive_integer(variant.box_size) and variant.box_size < 4294967296
        and (variant.category == "standard" or variant.category == "special" or variant.category == "armor_piercing" or variant.category == nil)
end

local function fallback_box_size(factory, section)
    if type(factory.read_system_u32) ~= "function" then return nil end
    local ok, value = pcall(factory.read_system_u32, section, "box_size")
    if not ok or not gamma_arena_number.is_positive_integer(value) or value >= 4294967296 then return nil end
    return value
end

local function validate_weapon_magazine_sizes(snapshot, factory)
    if type(factory.read_system_u32) ~= "function" then
        return gamma_arena_result.err("GA_CATALOG_MAGAZINE_INVALID", "Effective weapon magazine capacity reader is unavailable", {})
    end
    for _, weapon in ipairs(snapshot.weapon_list) do
        if weapon.magazine_size == nil then
            local ok, value = pcall(factory.read_system_u32, weapon.section, "ammo_mag_size")
            if ok then weapon.magazine_size = value end
        end
        if not gamma_arena_number.is_positive_integer(weapon.magazine_size) or weapon.magazine_size >= 4294967296 then
            return gamma_arena_result.err("GA_CATALOG_MAGAZINE_INVALID", "Weapon has no positive uint32 ammo_mag_size", { section = weapon.section })
        end
    end
    return gamma_arena_result.ok(true)
end

local function validate_ammo_variants(snapshot, factory)
    for _, weapon in ipairs(snapshot.weapon_list) do
        if type(weapon.ammo_variants) ~= "table" or #weapon.ammo_variants == 0 then
            local box_size = fallback_box_size(factory, weapon.ammo)
            if box_size == nil then return gamma_arena_result.err("GA_CATALOG_AMMO_VARIANT_INVALID", "Fallback ammo has no positive uint32 box_size", { section = weapon.ammo }) end
            weapon.ammo_variants = { { section = weapon.ammo, category = "standard", box_size = box_size } }
        end
        local count = 0
        for index in pairs(weapon.ammo_variants) do
            if not gamma_arena_number.is_positive_integer(index) then return gamma_arena_result.err("GA_CATALOG_AMMO_VARIANT_INVALID", "Weapon ammo_variants must be a dense array", { weapon = weapon.section }) end
            count = count + 1
        end
        if count == 0 or #weapon.ammo_variants ~= count then return gamma_arena_result.err("GA_CATALOG_AMMO_VARIANT_INVALID", "Weapon ammo_variants must be a dense array", { weapon = weapon.section }) end
        local seen = {}
        for index = 1, count do
            local variant = weapon.ammo_variants[index]
            if not valid_ammo_variant(variant) or seen[variant.section]
                or (string.match(variant.section, "_bad$") or string.match(variant.section, "_verybad$") or string.match(variant.section, "_self$"))
                or snapshot.ammo[variant.section] == nil
                or (index == 1 and (variant.section ~= weapon.ammo or variant.category ~= "standard"))
                or (index > 1 and variant.category == "standard") then
                return gamma_arena_result.err("GA_CATALOG_AMMO_VARIANT_INVALID", "Weapon ammo_variants are invalid", { weapon = weapon.section, section = type(variant) == "table" and variant.section or nil })
            end
            seen[variant.section] = true
        end
    end
    return gamma_arena_result.ok(true)
end

local function augment_from_effective_system(factory, snapshot)
    if type(factory.enumerate_system_sections) ~= "function" or type(factory.read_system_string) ~= "function"
        or type(factory.read_system_u32) ~= "function" then
        snapshot.selection_mode = "combinations"
        return gamma_arena_result.ok(snapshot)
    end
    local discovered = gamma_arena_catalog_discovery.discover({
        enumerate_sections = factory.enumerate_system_sections,
        read_string = factory.read_system_string,
        read_u32 = factory.read_system_u32
    })
    if not discovered.ok then return discovered end
    if discovered.value.mode ~= "dynamic" then
        snapshot.selection_mode = "combinations"
        return gamma_arena_result.ok(snapshot)
    end
    for _, item in ipairs(discovered.value.ammo) do
        if not contains_section(snapshot.ammo, item.section) then snapshot.ammo[item.section] = item end
    end
    for _, item in ipairs(discovered.value.weapons) do append_discovered(snapshot.weapons, snapshot.weapon_list, item) end
    for _, item in ipairs(discovered.value.outfits) do append_discovered(snapshot.outfits, snapshot.outfit_list, item) end
    for _, item in ipairs(discovered.value.knives) do append_discovered(snapshot.knives, snapshot.knife_list, item) end
    sort_catalog_list(snapshot.weapon_list)
    sort_catalog_list(snapshot.outfit_list)
    sort_catalog_list(snapshot.knife_list)
    local profile_ok, profile_error = augment_profiles(factory, snapshot, discovered.value.fingerprint_parts)
    if not profile_ok then return profile_error end
    index_faction_weapon_pools(factory, snapshot)
    snapshot.selection_mode = "staged"
    index_global_weapon_roles(snapshot)
    snapshot.generator_version = 10
    snapshot.revision = gamma_arena_rng.derive_seed({
        "dynamic_catalog_v10",
        snapshot.revision,
        table.concat(discovered.value.fingerprint_parts, "|")
    })
    snapshot.discovery = {
        mode = discovered.value.mode,
        skipped = discovered.value.skipped
    }
    return gamma_arena_result.ok(snapshot)
end

local function calculate_minimum_loadout_cost(snapshot, weapons)
    local minimum_outfit
    for _, outfit in ipairs(snapshot.outfit_list) do
        minimum_outfit = minimum_outfit and math.min(minimum_outfit, outfit.cost) or outfit.cost
    end
    local bandage = snapshot.consumables.bandage
    if minimum_outfit == nil or type(bandage) ~= "table" then return nil end
    local minimum
    for _, weapon in ipairs(weapons or snapshot.weapon_list) do
        local ammo = snapshot.ammo[weapon.ammo]
        if type(ammo) == "table" then
            local cost = weapon.cost + ammo.cost * weapon.ammo_box_min + minimum_outfit + bandage.cost
            minimum = minimum and math.min(minimum, cost) or cost
        end
    end
    return minimum
end

local function load_impl(ini_factory)
    local factory = ini_factory or runtime_factory()
    if type(factory) ~= "table" or type(factory.open) ~= "function" or type(factory.section_exists) ~= "function" then
        return gamma_arena_result.err("GA_CATALOG_FACTORY_INVALID", "Catalog loader requires open and section_exists", {})
    end
    local catalogs, open_error = safe_open(factory, catalog_path); if not catalogs then return open_error end
    local difficulties; difficulties, open_error = safe_open(factory, difficulty_path); if not difficulties then return open_error end
    local layouts; layouts, open_error = safe_open(factory, layout_path); if not layouts then return open_error end
    local snapshot = { schema_version = 9, revision = 10, generator_version = 10, profiles = {}, profile_list = {}, weapons = {}, weapon_list = {}, actor_weapon_list = {}, primary_weapon_list = {}, secondary_weapon_list = {}, weapon_pools_by_profile = {}, ammo = {}, outfits = {}, outfit_list = {}, knives = {}, knife_list = {}, grenades = {}, actor_grenade_list = {}, npc_grenade_list = {}, devices = {}, device_list = {}, consumables = {}, medical_items = {}, medical_item_list = {}, medical_skipped = {}, difficulties = {}, difficulty_ids = {}, layouts = {}, layout_ids = {} }
    local metadata, metadata_error = require_section(factory, catalogs, "meta", { schema_version = true, revision = true, generator_version = true })
    if not metadata then return metadata_error end
    for _, pair in ipairs({ { "schema_version", 9 }, { "revision", 10 }, { "generator_version", 10 } }) do
        local value, parse_error = integer(read(factory, catalogs, "meta", pair[1]), pair[1], { section = "meta" })
        if not value then return parse_error end
        if value ~= pair[2] then return gamma_arena_result.err("GA_CATALOG_VERSION_UNSUPPORTED", "Unsupported catalog version", { field = pair[1], value = value }) end
        snapshot[pair[1]] = value
    end
    local groups = { { name = "profiles", singular = "profile", target = snapshot.profiles, list = snapshot.profile_list, keys = { section = true, cost = true } }, { name = "weapons", singular = "weapon", target = snapshot.weapons, list = snapshot.weapon_list, keys = { section = true, ammo = true, cost = true, ammo_box_min = true, ammo_box_max = true, kind = true, slot = true } }, { name = "ammo", singular = "ammo", target = snapshot.ammo, keys = { section = true, cost = true } }, { name = "outfits", singular = "outfit", target = snapshot.outfits, list = snapshot.outfit_list, keys = { section = true, cost = true, armor_class = true } }, { name = "knives", singular = "knife", target = snapshot.knives, list = snapshot.knife_list, keys = { section = true }, costed = false }, { name = "grenades", singular = "grenade", target = snapshot.grenades, keys = { section = true }, section_keys = { ids = true, npc_ids = true }, costed = false }, { name = "devices", singular = "device", target = snapshot.devices, list = snapshot.device_list, keys = { section = true, kind = true, weight = true, nv_effect = true }, costed = false }, { name = "consumables", singular = "consumable", target = snapshot.consumables, keys = { section = true, cost = true } }, { name = "medical_items", singular = "medical", target = snapshot.medical_items, list = snapshot.medical_item_list, keys = { section = true, category = true, actor_cost = true, npc_cost = true, min_tier = true, max_count = true }, costed = false } }
    local actor_grenade_ids, npc_grenade_ids
    local catalog_manifest = { meta = true }
    for _, group in ipairs(groups) do
        local group_ok, group_error = require_section(factory, catalogs, group.name, group.section_keys or { ids = true })
        if not group_ok then return group_error end
        local raw_ids = read(factory, catalogs, group.name, "ids")
        if type(raw_ids) == "string" and raw_ids == "" then return gamma_arena_result.err("GA_CATALOG_EMPTY", "Catalog group is empty", { group = group.name }) end
        group.ids, group_error = exact_ids(group.name, raw_ids); if not group.ids then return group_error end
        if group.name == "grenades" then
            actor_grenade_ids = split(raw_ids, false)
            local raw_npc_ids = read(factory, catalogs, group.name, "npc_ids")
            npc_grenade_ids = split(raw_npc_ids, false)
            local allowed_npc_ids, seen_npc_ids = { f1=true, rgd5=true, gd05=true }, {}
            if type(raw_npc_ids) ~= "string" or #npc_grenade_ids ~= 3 then return gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Opponent grenade ids must match v9", { group = group.name }) end
            for _, id in ipairs(npc_grenade_ids) do
                if seen_npc_ids[id] then return gamma_arena_result.err("GA_CATALOG_DUPLICATE_ID", "Opponent grenade ids must be unique", { group = group.name, id = id }) end
                if not allowed_npc_ids[id] then return gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Opponent grenade pool contains a forbidden id", { group = group.name, id = id }) end
                seen_npc_ids[id] = true
            end
            for id in pairs(allowed_npc_ids) do if not seen_npc_ids[id] then return gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Opponent grenade pool is missing an approved id", { group = group.name, id = id }) end end
        end
        catalog_manifest[group.name] = true
        for _, entry_id in ipairs(group.ids) do catalog_manifest[group.singular .. "_" .. entry_id] = true end
    end
    local manifest_ok, manifest_error = validate_section_manifest(factory, catalogs, catalog_manifest, catalog_path); if not manifest_ok then return manifest_error end
    for _, group in ipairs(groups) do
        for _, entry_id in ipairs(group.ids) do
            if group.target[entry_id] then return gamma_arena_result.err("GA_CATALOG_DUPLICATE_ID", "Catalog ids must be unique", { group = group.name, id = entry_id }) end
            local section = group.singular .. "_" .. entry_id
            local section_ok, section_error = require_section(factory, catalogs, section, group.keys)
            if not section_ok then return section_error end
            local item = { id = entry_id, section = read(factory, catalogs, section, "section") }
            if type(item.section) ~= "string" or item.section == "" then return gamma_arena_result.err("GA_CATALOG_SECTION_UNKNOWN", "Referenced game section is empty", { group = group.name }) end
            local game_section_exists, section_check_error = safe_section_exists(factory, item.section); if game_section_exists == nil then return section_check_error end
            local optional_medical_missing = group.name == "medical_items" and item.section ~= "bandage" and item.section ~= "medkit" and not game_section_exists
            if not game_section_exists and not optional_medical_missing then return gamma_arena_result.err("GA_CATALOG_SECTION_UNKNOWN", "Referenced game section does not exist", { section = item.section, group = group.name }) end
            if group.name == "profiles" then
                if not human_profile_sections[item.section] then return gamma_arena_result.err("GA_CATALOG_PROFILE_NOT_HUMAN", "NPC profile is not in the human-only allowlist", { section = item.section }) end
                item.runtime_community = ARENA_RUNTIME_COMMUNITY
            end
            if group.costed ~= false then
                item.cost, section_error = integer(read(factory, catalogs, section, "cost"), "cost", { section = section })
                if not item.cost then return section_error end
                if item.cost <= 0 then return gamma_arena_result.err("GA_CATALOG_COST_INVALID", "Catalog cost must be positive", { section = section }) end
            end
            if group.name == "weapons" then
                item.ammo = read(factory, catalogs, section, "ammo")
                item.ammo_box_min, section_error = integer(read(factory, catalogs, section, "ammo_box_min"), "ammo_box_min", { section = section }); if not item.ammo_box_min then return section_error end
                item.ammo_box_max, section_error = integer(read(factory, catalogs, section, "ammo_box_max"), "ammo_box_max", { section = section }); if not item.ammo_box_max or item.ammo_box_min < 1 or item.ammo_box_max < item.ammo_box_min then return gamma_arena_result.err("GA_CATALOG_AMMO_RANGE_INVALID", "Weapon ammo box range is invalid", { section = section }) end
                item.kind = read(factory, catalogs, section, "kind")
                item.slot, section_error = integer(read(factory, catalogs, section, "slot"), "slot", { section = section }); if not item.slot then return section_error end
                if type(item.kind) ~= "string" or item.kind == "" or (item.slot ~= 1 and item.slot ~= 2) then return gamma_arena_result.err("GA_CATALOG_WEAPON_ROLE_INVALID", "Weapon kind and slot are invalid", { section = section }) end
            end
            if group.name == "outfits" then
                item.armor_class = read(factory, catalogs, section, "armor_class")
                if not OUTFIT_CLASSES[item.armor_class] then return gamma_arena_result.err("GA_CATALOG_ARMOR_CLASS_INVALID", "Outfit armor class is invalid", { section = section }) end
            end
            if group.name == "devices" then
                item.kind = read(factory, catalogs, section, "kind")
                item.weight, section_error = integer(read(factory, catalogs, section, "weight"), "weight", { section = section })
                local configured_effect = read(factory, catalogs, section, "nv_effect")
                if configured_effect == "none" then
                    item.nv_effect = nil
                else
                    item.nv_effect = configured_effect
                end
                if type(item.kind) ~= "string" or item.kind == "" or not item.weight or item.weight <= 0
                    or (configured_effect ~= "none" and (type(item.nv_effect) ~= "string" or item.nv_effect == "")) then
                    return gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Device kind, weight, or NV effect is invalid", { section = section })
                end
                local effective_ok, effective_error = validate_effective_device(factory, item)
                if not effective_ok then return effective_error end
            end
            if group.name == "medical_items" then
                item.category = read(factory, catalogs, section, "category")
                if not MEDICAL_CATEGORIES[item.category] then return gamma_arena_result.err("GA_MEDICAL_CATEGORY_INVALID", "Medical category is invalid", { section = section, category = item.category }) end
                for _, key in ipairs({ "actor_cost", "npc_cost", "min_tier", "max_count" }) do
                    item[key], section_error = integer(read(factory, catalogs, section, key), key, { section = section })
                    if item[key] == nil then return section_error end
                end
                if item.actor_cost <= 0 or item.npc_cost < 0 or item.min_tier < 1 or item.min_tier > 4 or item.max_count < 1 then return gamma_arena_result.err("GA_MEDICAL_ITEM_INVALID", "Medical costs, tier, or cap are invalid", { section = section }) end
            end
            local semantic_ok, semantic_error = validate_semantic_entry(group.name, item); if not semantic_ok then return semantic_error end
            if optional_medical_missing then
                snapshot.medical_skipped[#snapshot.medical_skipped + 1] = item.section
            else
                group.target[entry_id] = item
                if group.list then group.list[#group.list + 1] = item end
            end
        end
    end
    for _, id in ipairs(actor_grenade_ids or {}) do snapshot.actor_grenade_list[#snapshot.actor_grenade_list + 1] = snapshot.grenades[id] end
    for _, id in ipairs(npc_grenade_ids or {}) do snapshot.npc_grenade_list[#snapshot.npc_grenade_list + 1] = snapshot.grenades[id] end
    if #snapshot.actor_grenade_list ~= 3 or #snapshot.npc_grenade_list ~= 3 then return gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Grenade catalogs could not be indexed", {}) end
    local device_weight = 0
    for _, item in ipairs(snapshot.device_list) do device_weight = device_weight + item.weight end
    if #snapshot.device_list ~= 4 or device_weight ~= 100 then return gamma_arena_result.err("GA_CATALOG_MANIFEST_INVALID", "Actor device weights must contain four entries totaling 100", { count = #snapshot.device_list, weight = device_weight }) end
    for _, weapon in ipairs(snapshot.weapon_list) do
        if not snapshot.ammo[weapon.ammo] or snapshot.ammo[weapon.ammo].section ~= weapon.ammo or weapon_ammo_sections[weapon.section] ~= weapon.ammo then return gamma_arena_result.err("GA_CATALOG_AMMO_INVALID", "Weapon ammo is not the allowlisted matching section", { weapon = weapon.section, ammo = weapon.ammo }) end
    end
    local difficulty_ok, difficulty_error = require_section(factory, difficulties, "meta", { schema_version = true, revision = true }); if not difficulty_ok then return difficulty_error end
    for _, pair in ipairs({ { "schema_version", 4 }, { "revision", 5 } }) do local value, version_error = integer(read(factory, difficulties, "meta", pair[1]), pair[1], { section = "meta" }); if not value then return version_error end; if value ~= pair[2] then return gamma_arena_result.err("GA_CATALOG_VERSION_UNSUPPORTED", "Unsupported difficulty catalog version", { field = pair[1], value = value }) end end
    local difficulty_manifest = { meta = true, ga_difficulty_rookie = true, ga_difficulty_stalker = true, ga_difficulty_veteran = true, ga_difficulty_master = true }
    local difficulty_manifest_ok, difficulty_manifest_error = validate_section_manifest(factory, difficulties, difficulty_manifest, difficulty_path); if not difficulty_manifest_ok then return difficulty_manifest_error end
    for _, difficulty_id in ipairs({ "rookie", "stalker", "veteran", "master" }) do
        local section = "ga_difficulty_" .. difficulty_id
        local section_ok, section_error = require_section(factory, difficulties, section, { tier = true, enemy_min = true, enemy_max = true, enemy_total_budget = true, player_gear_budget = true, player_medical_budget = true, primary_share_percent = true, medical_weight_bleed = true, medical_weight_health = true, medical_weight_boost = true, medical_weight_rare = true, weapon_weight_pistol = true, weapon_weight_smg = true, weapon_weight_shotgun = true, weapon_weight_rifle = true, weapon_weight_sniper = true, armor_weight_light = true, armor_weight_medium = true, armor_weight_scientific = true, armor_weight_heavy = true, armor_weight_powered_exo = true }); if not section_ok then return section_error end
        local item = { id = difficulty_id }; for _, key in ipairs({ "tier", "enemy_min", "enemy_max", "enemy_total_budget", "player_gear_budget", "player_medical_budget", "primary_share_percent" }) do item[key], section_error = integer(read(factory, difficulties, section, key), key, { section = section }); if not item[key] then return section_error end; if item[key] <= 0 then return gamma_arena_result.err("GA_DIFFICULTY_INVALID", "Difficulty values must be positive integers", { section = section, key = key }) end end
        if item.enemy_max < item.enemy_min then return gamma_arena_result.err("GA_DIFFICULTY_INVALID", "Difficulty maximum is below minimum", { section = section }) end
        if item.primary_share_percent > 100 then return gamma_arena_result.err("GA_DIFFICULTY_INVALID", "Primary firearm share cannot exceed 100 percent", { section = section }) end
        item.player_weapon_weights, section_error = normalized_weight_row(factory, difficulties, section, PLAYER_WEAPON_WEIGHT_KEYS, "Player weapon")
        if not item.player_weapon_weights then return section_error end
        item.player_armor_weights, section_error = normalized_weight_row(factory, difficulties, section, PLAYER_ARMOR_WEIGHT_KEYS, "Player armor")
        if not item.player_armor_weights then return section_error end
        item.medical_weights, section_error = normalized_weight_row(factory, difficulties, section, MEDICAL_WEIGHT_KEYS, "Medical category")
        if not item.medical_weights then return section_error end
        local expected = difficulty_manifest_v5[difficulty_id]
        for _, key in ipairs({ "tier", "enemy_min", "enemy_max", "enemy_total_budget", "player_gear_budget", "player_medical_budget", "primary_share_percent" }) do if item[key] ~= expected[key] then return gamma_arena_result.err("GA_DIFFICULTY_MANIFEST_INVALID", "Difficulty entry differs from v5", { difficulty_id = difficulty_id, field = key }) end end
        for kind, weight in pairs(expected.player_weapon_weights) do if item.player_weapon_weights[kind] ~= weight then return gamma_arena_result.err("GA_DIFFICULTY_MANIFEST_INVALID", "Player weapon weights differ from v5", { difficulty_id = difficulty_id, kind = kind }) end end
        for armor_class, weight in pairs(expected.player_armor_weights) do if item.player_armor_weights[armor_class] ~= weight then return gamma_arena_result.err("GA_DIFFICULTY_MANIFEST_INVALID", "Player armor weights differ from v5", { difficulty_id = difficulty_id, armor_class = armor_class }) end end
        for category, weight in pairs(expected.medical_weights) do if item.medical_weights[category] ~= weight then return gamma_arena_result.err("GA_DIFFICULTY_MANIFEST_INVALID", "Medical category weights differ from v5", { difficulty_id = difficulty_id, category = category }) end end
        snapshot.difficulties[difficulty_id] = item; snapshot.difficulty_ids[#snapshot.difficulty_ids + 1] = difficulty_id
    end
    local foundation_bandage = snapshot.medical_items.bandage
    local foundation_medkit = snapshot.medical_items.medkit
    if type(foundation_bandage) ~= "table" or foundation_bandage.section ~= "bandage" or foundation_bandage.actor_cost ~= 1 or foundation_bandage.npc_cost ~= 1
        or type(foundation_medkit) ~= "table" or foundation_medkit.section ~= "medkit" or foundation_medkit.npc_cost ~= 2 then
        return gamma_arena_result.err("GA_MEDICAL_FOUNDATION_INVALID", "Medical catalog must provide the Arena bandage and NPC medkit foundation", {})
    end
    for _, difficulty_id in ipairs(snapshot.difficulty_ids) do
        local difficulty = snapshot.difficulties[difficulty_id]
        local healer_available = false
        for _, medical in ipairs(snapshot.medical_item_list) do
            if medical.min_tier <= difficulty.tier and (medical.category == "health" or medical.category == "rare")
                and foundation_bandage.actor_cost + medical.actor_cost <= difficulty.player_medical_budget then healer_available = true; break end
        end
        if not healer_available then return gamma_arena_result.err("GA_MEDICAL_BUDGET_INFEASIBLE", "Player medical budget cannot provide a mandatory healer", { difficulty_id = difficulty_id, budget = difficulty.player_medical_budget }) end
    end
    local layout_meta_ok, layout_meta_error = require_section(factory, layouts, "meta", { schema_version = true, revision = true }); if not layout_meta_ok then return layout_meta_error end
    for _, key in ipairs({ "schema_version", "revision" }) do local value, version_error = integer(read(factory, layouts, "meta", key), key, { section = "meta" }); if not value then return version_error end; if value ~= 2 then return gamma_arena_result.err("GA_CATALOG_VERSION_UNSUPPORTED", "Unsupported layout catalog version", { field = key, value = value }) end end
    local layout_manifest_ok, layout_manifest_error = validate_section_manifest(factory, layouts, { meta = true, ga_layout_rostok_arena_v1 = true }, layout_path); if not layout_manifest_ok then return layout_manifest_error end
    local layout_keys = { level = true, actor_spawn_path = true, actor_look_path = true, opponent_spawn_paths = true, virtual_capacity = true, virtual_radii = true, max_height_delta = true, min_opponent_separation = true, min_actor_separation = true, max_base_distance = true }
    local layout_ok, layout_error = require_section(factory, layouts, "ga_layout_rostok_arena_v1", layout_keys); if not layout_ok then return layout_error end
    local layout = { id = "rostok_arena_v1", version = 2, level = read(factory, layouts, "ga_layout_rostok_arena_v1", "level"), actor_spawn_path = read(factory, layouts, "ga_layout_rostok_arena_v1", "actor_spawn_path"), actor_look_path = read(factory, layouts, "ga_layout_rostok_arena_v1", "actor_look_path"), opponent_spawn_paths = split(read(factory, layouts, "ga_layout_rostok_arena_v1", "opponent_spawn_paths"), false) }
    layout.virtual_capacity, layout_error = integer(read(factory, layouts, "ga_layout_rostok_arena_v1", "virtual_capacity"), "virtual_capacity", { section = "ga_layout_rostok_arena_v1" }); if not layout.virtual_capacity then return layout_error end
    layout.virtual_radii, layout_error = positive_number_list(read(factory, layouts, "ga_layout_rostok_arena_v1", "virtual_radii"), "virtual_radii", { section = "ga_layout_rostok_arena_v1" }); if not layout.virtual_radii then return layout_error end
    for _, key in ipairs({ "max_height_delta", "min_opponent_separation", "min_actor_separation", "max_base_distance" }) do layout[key], layout_error = finite_number(read(factory, layouts, "ga_layout_rostok_arena_v1", key), key, { section = "ga_layout_rostok_arena_v1" }); if not layout[key] or layout[key] <= 0 then return layout_error or gamma_arena_result.err("GA_LAYOUT_INVALID", "Layout distances must be positive", { key = key }) end end
    if type(layout.level) ~= "string" or layout.level == "" or type(layout.actor_spawn_path) ~= "string" or layout.actor_spawn_path == "" or type(layout.actor_look_path) ~= "string" or layout.actor_look_path == "" or layout.actor_spawn_path == layout.actor_look_path or #layout.opponent_spawn_paths ~= 6 then return gamma_arena_result.err("GA_LAYOUT_INVALID", "Layout paths and level are invalid", {}) end
    local unique_paths = {}
    for _, path in ipairs(layout.opponent_spawn_paths) do if path == "" or path == layout.actor_spawn_path or path == layout.actor_look_path or unique_paths[path] then return gamma_arena_result.err("GA_LAYOUT_INVALID", "All actor and opponent paths must be non-empty and unique", { path = path }) end; unique_paths[path] = true end
    if layout.level ~= layout_manifest_v2.level or layout.actor_spawn_path ~= layout_manifest_v2.actor_spawn_path or layout.actor_look_path ~= layout_manifest_v2.actor_look_path or layout.virtual_capacity ~= layout_manifest_v2.virtual_capacity or #layout.virtual_radii ~= #layout_manifest_v2.virtual_radii then return gamma_arena_result.err("GA_LAYOUT_MANIFEST_INVALID", "Layout routing differs from v2", {}) end
    for index, expected_path in ipairs(layout_manifest_v2.opponent_spawn_paths) do if layout.opponent_spawn_paths[index] ~= expected_path then return gamma_arena_result.err("GA_LAYOUT_MANIFEST_INVALID", "Ordered opponent paths differ from v2", { index = index }) end end
    for index, expected_radius in ipairs(layout_manifest_v2.virtual_radii) do if layout.virtual_radii[index] ~= expected_radius then return gamma_arena_result.err("GA_LAYOUT_MANIFEST_INVALID", "Virtual layout radii differ from v2", { index = index }) end end
    for _, key in ipairs({ "max_height_delta", "min_opponent_separation", "min_actor_separation", "max_base_distance" }) do if layout[key] ~= layout_manifest_v2[key] then return gamma_arena_result.err("GA_LAYOUT_MANIFEST_INVALID", "Virtual layout constraint differs from v2", { key = key }) end end
    snapshot.layouts[layout.id] = layout; snapshot.layout_ids[1] = layout.id
    local magazine_sizes_ok = validate_weapon_magazine_sizes(snapshot, factory)
    if not magazine_sizes_ok.ok then return magazine_sizes_ok end
    local fallback_variants_ok = validate_ammo_variants(snapshot, factory)
    if not fallback_variants_ok.ok then return fallback_variants_ok end
    local augmented = augment_from_effective_system(factory, snapshot)
    if not augmented.ok then return augmented end
    snapshot = augmented.value
    magazine_sizes_ok = validate_weapon_magazine_sizes(snapshot, factory)
    if not magazine_sizes_ok.ok then return magazine_sizes_ok end
    local ammo_variants_ok = validate_ammo_variants(snapshot, factory)
    if not ammo_variants_ok.ok then return ammo_variants_ok end
    index_actor_weapon_list(snapshot)
    if #snapshot.actor_weapon_list == 0 then
        return gamma_arena_result.err("GA_CATALOG_EMPTY", "Catalog has no actor-eligible weapon after exact quarantine", {})
    end
    index_global_weapon_roles(snapshot)
    if snapshot.selection_mode == "combinations" then add_loadout_combinations(snapshot) end
    local minimum_profile_cost = snapshot.profile_list[1].cost
    for _, profile in ipairs(snapshot.profile_list) do minimum_profile_cost = math.min(minimum_profile_cost, profile.cost) end
    local minimum_loadout_cost = snapshot.selection_mode == "combinations" and snapshot.combinations[1].cost or calculate_minimum_loadout_cost(snapshot, snapshot.weapon_list)
    local actor_minimum_loadout_cost = calculate_minimum_loadout_cost(snapshot, snapshot.actor_weapon_list)
    if not gamma_arena_number.is_positive_integer(minimum_loadout_cost) then
        return gamma_arena_result.err("GA_CATALOG_EMPTY", "Catalog has no viable loadout", {})
    end
    snapshot.minimum_loadout_cost = minimum_loadout_cost
    for _, difficulty_id in ipairs(snapshot.difficulty_ids) do
        local difficulty = snapshot.difficulties[difficulty_id]
        local required_enemy_budget = difficulty.enemy_max * (minimum_profile_cost + minimum_loadout_cost)
        if difficulty.enemy_total_budget < required_enemy_budget then
            return gamma_arena_result.err("GA_DIFFICULTY_BUDGET_INFEASIBLE", "Difficulty budget cannot construct its maximum opponent count", { difficulty_id = difficulty_id, required = required_enemy_budget, budget = difficulty.enemy_total_budget })
        end
        local equipment_budget = difficulty.player_gear_budget + foundation_bandage.actor_cost
        if not gamma_arena_number.is_positive_integer(actor_minimum_loadout_cost) or equipment_budget < actor_minimum_loadout_cost then
            return gamma_arena_result.err("GA_PLAYER_BUDGET_INFEASIBLE", "Player gear budget cannot construct a valid actor-eligible loadout", { difficulty_id = difficulty_id, required = actor_minimum_loadout_cost, budget = difficulty.player_gear_budget })
        end
    end
    local rank_source = type(factory.rank_source) == "table" and factory.rank_source or factory
    local ranks = gamma_arena_rank_catalog.load(rank_source, snapshot)
    if not ranks.ok then return ranks end
    local item_source = type(factory.item_source) == "table" and factory.item_source or nil
    return gamma_arena_item_catalog.load(item_source, snapshot, ranks.value)
end

function load(ini_factory)
    local succeeded, result = pcall(load_impl, ini_factory)
    if succeeded and type(result) == "table" and type(result.ok) == "boolean" then return result end
    if succeeded then return gamma_arena_result.err("GA_CATALOG_INVALID", "Catalog loader returned an invalid Result", { result_type = type(result) }) end
    return gamma_arena_result.err("GA_CATALOG_INVALID", "Catalog loading failed safely", { reason = tostring(result) })
end
