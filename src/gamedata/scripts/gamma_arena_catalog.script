local catalog_path = "gamma_arena\\gamma_arena_catalogs.ltx"
local difficulty_path = "gamma_arena\\gamma_arena_difficulties.ltx"
local layout_path = "gamma_arena\\gamma_arena_layouts.ltx"
local human_profile_sections = { gamma_arena_bandit_novice = true, gamma_arena_bandit_trainee = true, gamma_arena_bandit_experienced = true, gamma_arena_bandit_veteran = true }

local function split(text)
    local values = {}
    for value in string.gmatch(text or "", "[^,%s]+") do values[#values + 1] = value end
    table.sort(values)
    return values
end

local function runtime_factory()
    local base = system_ini()
    return {
        open = function(path) return ini_file(path) end,
        section_exists = function(section) return base:section_exist(section) end
    }
end

local function read(factory, ini, section, key)
    if type(ini.sections) == "table" then
        local values = ini.sections[section]
        return values and values[key] or nil
    end
    local ok, value = pcall(function() return ini:r_string(section, key) end)
    return ok and value or nil
end

local function exists(ini, section)
    if type(ini.sections) == "table" then return type(ini.sections[section]) == "table" end
    local ok, value = pcall(function() return ini:section_exist(section) end)
    return ok and value
end

local function integer(value, name, context)
    local parsed = tonumber(value)
    if not parsed or parsed ~= math.floor(parsed) then
        return nil, gamma_arena_result.err("GA_CATALOG_INVALID", name .. " must be an integer", context)
    end
    return parsed
end

local function section_keys_are_known(ini, section, allowed)
    if type(ini.sections) ~= "table" then return true end
    for key in pairs(ini.sections[section]) do
        if not allowed[key] then return false, key end
    end
    return true
end

local function require_section(factory, ini, section, allowed)
    if not exists(ini, section) then return nil, gamma_arena_result.err("GA_CATALOG_SECTION_MISSING", "Catalog section is missing", { section = section }) end
    local known, key = section_keys_are_known(ini, section, allowed)
    if not known then return nil, gamma_arena_result.err("GA_CATALOG_UNKNOWN_KEY", "Catalog contains an unknown key", { section = section, key = key }) end
    return true
end

local function add_loadout_combinations(snapshot)
    snapshot.combinations = {}
    for _, weapon in ipairs(snapshot.weapon_list) do
        local ammo = snapshot.ammo[weapon.ammo]
        for _, outfit in ipairs(snapshot.outfit_list) do
            for boxes = weapon.ammo_box_min, weapon.ammo_box_max do
                local consumables = { "bandage" }
                local cost = weapon.cost + ammo.cost * boxes + outfit.cost + snapshot.consumables.bandage.cost
                snapshot.combinations[#snapshot.combinations + 1] = { weapon = weapon.section, ammo = ammo.section, ammo_boxes = boxes, outfit = outfit.section, consumables = consumables, cost = cost }
            end
        end
    end
    table.sort(snapshot.combinations, function(a, b)
        if a.cost ~= b.cost then return a.cost < b.cost end
        if a.weapon ~= b.weapon then return a.weapon < b.weapon end
        if a.outfit ~= b.outfit then return a.outfit < b.outfit end
        return a.ammo_boxes < b.ammo_boxes
    end)
end

function load(ini_factory)
    local factory = ini_factory or runtime_factory()
    if type(factory) ~= "table" or type(factory.open) ~= "function" or type(factory.section_exists) ~= "function" then
        return gamma_arena_result.err("GA_CATALOG_FACTORY_INVALID", "Catalog loader requires open and section_exists", {})
    end
    local catalogs, difficulties, layouts = factory.open(catalog_path), factory.open(difficulty_path), factory.open(layout_path)
    if not catalogs or not difficulties or not layouts then return gamma_arena_result.err("GA_CATALOG_OPEN_FAILED", "Arena catalog file could not be opened", {}) end
    local snapshot = { schema_version = 1, revision = 1, generator_version = 1, profiles = {}, profile_list = {}, weapons = {}, weapon_list = {}, ammo = {}, outfits = {}, outfit_list = {}, consumables = {}, difficulties = {}, difficulty_ids = {}, layouts = {}, layout_ids = {} }
    local metadata, metadata_error = require_section(factory, catalogs, "meta", { schema_version = true, revision = true, generator_version = true })
    if not metadata then return metadata_error end
    for _, pair in ipairs({ { "schema_version", 1 }, { "revision", 1 }, { "generator_version", 1 } }) do
        local value, parse_error = integer(read(factory, catalogs, "meta", pair[1]), pair[1], { section = "meta" })
        if not value then return parse_error end
        if pair[1] == "schema_version" and value ~= pair[2] then return gamma_arena_result.err("GA_CATALOG_VERSION_UNSUPPORTED", "Unsupported catalog schema version", { schema_version = value }) end
        snapshot[pair[1]] = value
    end
    local groups = { { name = "profiles", singular = "profile", target = snapshot.profiles, list = snapshot.profile_list, keys = { section = true, cost = true } }, { name = "weapons", singular = "weapon", target = snapshot.weapons, list = snapshot.weapon_list, keys = { section = true, ammo = true, cost = true, ammo_box_min = true, ammo_box_max = true } }, { name = "ammo", singular = "ammo", target = snapshot.ammo, keys = { section = true, cost = true } }, { name = "outfits", singular = "outfit", target = snapshot.outfits, list = snapshot.outfit_list, keys = { section = true, cost = true } }, { name = "consumables", singular = "consumable", target = snapshot.consumables, keys = { section = true, cost = true } } }
    for _, group in ipairs(groups) do
        local group_ok, group_error = require_section(factory, catalogs, group.name, { ids = true })
        if not group_ok then return group_error end
        local ids = split(read(factory, catalogs, group.name, "ids"))
        if #ids == 0 then return gamma_arena_result.err("GA_CATALOG_EMPTY", "Catalog group is empty", { group = group.name }) end
        for _, entry_id in ipairs(ids) do
            if group.target[entry_id] then return gamma_arena_result.err("GA_CATALOG_DUPLICATE_ID", "Catalog ids must be unique", { group = group.name, id = entry_id }) end
            local section = group.singular .. "_" .. entry_id
            local section_ok, section_error = require_section(factory, catalogs, section, group.keys)
            if not section_ok then return section_error end
            local item = { id = entry_id, section = read(factory, catalogs, section, "section") }
            if type(item.section) ~= "string" or item.section == "" or not factory.section_exists(item.section) then return gamma_arena_result.err("GA_CATALOG_SECTION_UNKNOWN", "Referenced game section does not exist", { section = item.section, group = group.name }) end
            if group.name == "profiles" and not human_profile_sections[item.section] then return gamma_arena_result.err("GA_CATALOG_PROFILE_NOT_HUMAN", "NPC profile is not in the human-only allowlist", { section = item.section }) end
            item.cost, section_error = integer(read(factory, catalogs, section, "cost"), "cost", { section = section })
            if not item.cost or item.cost <= 0 then return gamma_arena_result.err("GA_CATALOG_COST_INVALID", "Catalog cost must be positive", { section = section }) end
            if group.name == "weapons" then
                item.ammo = read(factory, catalogs, section, "ammo")
                item.ammo_box_min, section_error = integer(read(factory, catalogs, section, "ammo_box_min"), "ammo_box_min", { section = section }); if not item.ammo_box_min then return section_error end
                item.ammo_box_max, section_error = integer(read(factory, catalogs, section, "ammo_box_max"), "ammo_box_max", { section = section }); if not item.ammo_box_max or item.ammo_box_min < 1 or item.ammo_box_max < item.ammo_box_min then return gamma_arena_result.err("GA_CATALOG_AMMO_RANGE_INVALID", "Weapon ammo box range is invalid", { section = section }) end
            end
            group.target[entry_id] = item
            if group.list then group.list[#group.list + 1] = item end
        end
    end
    for _, weapon in ipairs(snapshot.weapon_list) do
        if not snapshot.ammo[weapon.ammo] or snapshot.ammo[weapon.ammo].section ~= weapon.ammo then return gamma_arena_result.err("GA_CATALOG_AMMO_INVALID", "Weapon ammo is not a cataloged matching section", { weapon = weapon.section, ammo = weapon.ammo }) end
    end
    local difficulty_ok, difficulty_error = require_section(factory, difficulties, "meta", { schema_version = true, revision = true }); if not difficulty_ok then return difficulty_error end
    for _, difficulty_id in ipairs({ "rookie", "stalker", "veteran", "master" }) do
        local section = "ga_difficulty_" .. difficulty_id
        local section_ok, section_error = require_section(factory, difficulties, section, { enemy_min = true, enemy_max = true, enemy_total_budget = true, player_loadout_budget = true }); if not section_ok then return section_error end
        local item = { id = difficulty_id }; for _, key in ipairs({ "enemy_min", "enemy_max", "enemy_total_budget", "player_loadout_budget" }) do item[key], section_error = integer(read(factory, difficulties, section, key), key, { section = section }); if not item[key] or item[key] <= 0 then return gamma_arena_result.err("GA_DIFFICULTY_INVALID", "Difficulty values must be positive integers", { section = section, key = key }) end end
        if item.enemy_max < item.enemy_min then return gamma_arena_result.err("GA_DIFFICULTY_INVALID", "Difficulty maximum is below minimum", { section = section }) end
        snapshot.difficulties[difficulty_id] = item; snapshot.difficulty_ids[#snapshot.difficulty_ids + 1] = difficulty_id
    end
    local layout_ok, layout_error = require_section(factory, layouts, "ga_layout_rostok_arena_v1", { level = true, actor_spawn_path = true, actor_look_path = true, opponent_spawn_paths = true }); if not layout_ok then return layout_error end
    local layout = { id = "rostok_arena_v1", version = 1, level = read(factory, layouts, "ga_layout_rostok_arena_v1", "level"), actor_spawn_path = read(factory, layouts, "ga_layout_rostok_arena_v1", "actor_spawn_path"), actor_look_path = read(factory, layouts, "ga_layout_rostok_arena_v1", "actor_look_path"), opponent_spawn_paths = split(read(factory, layouts, "ga_layout_rostok_arena_v1", "opponent_spawn_paths")) }
    if layout.level ~= "l05_bar" or #layout.opponent_spawn_paths ~= 6 then return gamma_arena_result.err("GA_LAYOUT_INVALID", "Layout must contain six Rostok opponent paths", {}) end
    snapshot.layouts[layout.id] = layout; snapshot.layout_ids[1] = layout.id
    add_loadout_combinations(snapshot)
    local minimum_profile_cost = snapshot.profile_list[1].cost
    for _, profile in ipairs(snapshot.profile_list) do minimum_profile_cost = math.min(minimum_profile_cost, profile.cost) end
    local minimum_loadout_cost = snapshot.combinations[1].cost
    for _, difficulty_id in ipairs(snapshot.difficulty_ids) do
        local difficulty = snapshot.difficulties[difficulty_id]
        local required_enemy_budget = difficulty.enemy_max * (minimum_profile_cost + minimum_loadout_cost)
        if difficulty.enemy_total_budget < required_enemy_budget then
            return gamma_arena_result.err("GA_DIFFICULTY_BUDGET_INFEASIBLE", "Difficulty budget cannot construct its maximum opponent count", { difficulty_id = difficulty_id, required = required_enemy_budget, budget = difficulty.enemy_total_budget })
        end
        if difficulty.player_loadout_budget < minimum_loadout_cost then
            return gamma_arena_result.err("GA_PLAYER_BUDGET_INFEASIBLE", "Player budget cannot construct a valid loadout", { difficulty_id = difficulty_id, required = minimum_loadout_cost, budget = difficulty.player_loadout_budget })
        end
    end
    return gamma_arena_result.ok(snapshot)
end
