    ammo = { ammo_9x18_fmj={section="ammo_9x18_fmj",cost=1}, ammo_9x19_fmj={section="ammo_9x19_fmj",cost=1}, ["ammo_5.45x39_fmj"]={section="ammo_5.45x39_fmj",cost=2}, ammo_12x70_buck={section="ammo_12x70_buck",cost=2} },
    outfits = { novice={section="novice_outfit",cost=1,armor_class="light"}, stalker={section="stalker_outfit",cost=3,armor_class="medium"}, banditmerc={section="banditmerc_outfit",cost=4,armor_class="scientific"} },
    knives = { knife={section="wpn_knife"}, knife2={section="wpn_knife2"}, knife3={section="wpn_knife3"}, knife4={section="wpn_knife4"}, knife5={section="wpn_knife5"}, knife6={section="wpn_knife6"}, knife7={section="wpn_knife7"}, knife8={section="wpn_knife8"}, knife9={section="wpn_knife9"} },
    consumables = { bandage={section="bandage",cost=1}, medkit={section="medkit",cost=2} }
}
