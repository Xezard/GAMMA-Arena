local OUTFIT_CLASSES = { light=true, medium=true, scientific=true, heavy=true, powered_exo=true }
local PLAYER_WEAPON_WEIGHT_KEYS = { w_pistol="weapon_weight_pistol", w_smg="weapon_weight_smg", w_shotgun="weapon_weight_shotgun", w_rifle="weapon_weight_rifle", w_sniper="weapon_weight_sniper" }
local PLAYER_ARMOR_WEIGHT_KEYS = { light="armor_weight_light", medium="armor_weight_medium", scientific="armor_weight_scientific", heavy="armor_weight_heavy", powered_exo="armor_weight_powered_exo" }
local layout_manifest_v2 = {
    level = "l05_bar",
    actor_spawn_path = "t_way",
    actor_look_path = "t_look",
    opponent_spawn_paths = { "bar_arena_walk_3_1", "bar_arena_walk_3_2", "bar_arena_walk_6_1", "bar_arena_walk_6_3", "bar_arena_walk_6_6", "bar_arena_walk_1_1" },
    virtual_capacity = 10,
    virtual_radii = { 1.5, 2.5 },
    max_height_delta = 1.0,
