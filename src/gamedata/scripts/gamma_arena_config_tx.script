local quarantine_by_config = setmetatable({}, { __mode = "k" })

local function fail(code, message, context)
    return gamma_arena_result.err(code, message, context)
end

local function adapter_boolean_returns(target)
    local ok, declared = pcall(function() return target.gamma_arena_boolean_returns end)
    return ok and declared == true
end

local function call_adapter(target, method_name, ...)
    local ok_method, method = pcall(function() return target[method_name] end)
    if not ok_method or type(method) ~= "function" then
        return false, { kind = "missing_method", detail = method_name }
    end
    local ok, value = pcall(method, target, ...)
    if not ok then
        return false, { kind = "throw", detail = tostring(value) }
    end
    if value == false and adapter_boolean_returns(target) then
        return false, { kind = "false_return", detail = method_name }
    end
    return true, value
end

local function key_set(keys)
    local result = {}
    for _, key in ipairs(keys or {}) do
        result[key] = true
    end
    return result
end

local function unique_keys(operations)
    local keys = {}
    local seen = {}
    for _, operation in ipairs(operations or {}) do
        if type(operation) ~= "table" or type(operation.key) ~= "string" or (operation.action ~= "write" and operation.action ~= "remove") then
            return fail("GA_CONFIG_TRANSACTION_INVALID", "Config transaction contains an invalid operation")
        end
        if operation.action == "write" and operation.value == nil then
            return fail("GA_CONFIG_TRANSACTION_INVALID", "Config transaction cannot write nil", { key = operation.key })
        end
        if seen[operation.key] then
            return fail("GA_CONFIG_TRANSACTION_INVALID", "Config transaction touches a key more than once", { key = operation.key })
        end
        seen[operation.key] = true
        keys[#keys + 1] = operation.key
    end
    return gamma_arena_result.ok(keys)
end

local function snapshot_impl(config, section, keys)
    if config == nil or type(section) ~= "string" then
        return fail("GA_CONFIG_INVALID", "Config snapshot target is invalid")
    end
    local ok_methods, line_exist, r_string_ex = pcall(function()
        return config.line_exist, config.r_string_ex
    end)
    if not ok_methods or type(line_exist) ~= "function" or type(r_string_ex) ~= "function" then
        return fail("GA_CONFIG_INVALID", "Config does not expose line_exist and r_string_ex")
    end

    local entries = {}
    for _, key in ipairs(keys) do
        local ok_presence, present = pcall(line_exist, config, section, key)
        if not ok_presence or type(present) ~= "boolean" then
            return fail("GA_CONFIG_SNAPSHOT_FAILED", "Config key presence could not be read", {
                phase = "primary_read", section = section, key = key,
                detail = ok_presence and "line_exist returned a non-boolean value" or tostring(present)
            })
        end
        if present then
            local ok_value, value = pcall(r_string_ex, config, section, key)
            if not ok_value or value == nil or (value == false and adapter_boolean_returns(config)) then
                return fail("GA_CONFIG_SNAPSHOT_FAILED", "Config key value could not be read", {
                    phase = "primary_read", section = section, key = key,
                    detail = ok_value and "r_string_ex returned an explicit failure" or tostring(value)
                })
            end
            entries[key] = { present = true, value = tostring(value) }
        else
            entries[key] = { present = false }
        end
    end
    return gamma_arena_result.ok({ section = section, keys = keys, entries = entries })
end

function snapshot(config, section, keys)
    local ok, result = pcall(snapshot_impl, config, section, keys)
    if not ok then
        return fail("GA_CONFIG_SNAPSHOT_FAILED", "Config snapshot raised an error", { phase = "primary_read", detail = tostring(result) })
    end
    return result
end

local function order_operations(operations, options)
    local commit_write_keys = key_set(options and options.commit_write_keys)
    local commit_remove_keys = key_set(options and options.commit_remove_keys)
    local first, middle, last = {}, {}, {}
    for _, operation in ipairs(operations) do
        if operation.action == "remove" and commit_remove_keys[operation.key] then
            first[#first + 1] = operation
        elseif operation.action == "write" and commit_write_keys[operation.key] then
            last[#last + 1] = operation
        else
            middle[#middle + 1] = operation
        end
    end
    local ordered = {}
    for _, group in ipairs({ first, middle, last }) do
        for _, operation in ipairs(group) do
            ordered[#ordered + 1] = operation
        end
    end
    return ordered
end

local function desired_after_failure(snapshot_value, fail_closed_keys)
    local desired = {}
    for _, key in ipairs(snapshot_value.keys) do
        desired[key] = fail_closed_keys[key] and { present = false } or snapshot_value.entries[key]
    end
    return desired
end

local function update_shadow(shadow, keys, state)
    if type(shadow) ~= "table" then return end
    for _, key in ipairs(keys) do
        local entry = state[key]
        shadow[key] = entry.present and { present = true, value = tostring(entry.value) } or { present = false }
    end
end

local function invalidate_shadow(shadow, keys, fail_closed_keys)
    if type(shadow) ~= "table" then return end
    for _, key in ipairs(keys) do
        shadow[key] = fail_closed_keys[key] and { present = false } or nil
    end
end

local function build_recovery_order(snapshot_value, desired, options)
    local fail_closed_keys = key_set(options.fail_closed_keys)
    local marker_keys = key_set(options.commit_write_keys)
    for key in pairs(key_set(options.commit_remove_keys)) do marker_keys[key] = true end
    local first, middle, last, seen = {}, {}, {}, {}

    for _, key in ipairs(options.commit_remove_keys or {}) do
        if desired[key] and fail_closed_keys[key] and not seen[key] then
            first[#first + 1] = key
            seen[key] = true
        end
    end
    for _, key in ipairs(options.commit_write_keys or {}) do
        if desired[key] and fail_closed_keys[key] and not seen[key] then
            first[#first + 1] = key
            seen[key] = true
        end
    end
    for _, key in ipairs(snapshot_value.keys) do
        if not seen[key] then
            if marker_keys[key] then last[#last + 1] = key else middle[#middle + 1] = key end
            seen[key] = true
        end
    end
    local ordered = {}
    for _, group in ipairs({ first, middle, last }) do
        for _, key in ipairs(group) do ordered[#ordered + 1] = key end
    end
    return ordered
end

local function recovery_port(config)
    local ok, raw_ini, cache = pcall(function()
        return config.ini, config.cache
    end)
    if not ok or raw_ini == nil or type(cache) ~= "table" then
        return fail("GA_CONFIG_RECOVERY_FAILED", "Raw ini_file_ex recovery port is unavailable", { phase = "recovery_read" })
    end
    local ok_methods, w_string, remove_line = pcall(function()
        return raw_ini.w_string, raw_ini.remove_line
    end)
    if not ok_methods or type(w_string) ~= "function" or type(remove_line) ~= "function" then
        return fail("GA_CONFIG_RECOVERY_FAILED", "Raw ini_file_ex recovery methods are unavailable", { phase = "recovery_read" })
    end
    return gamma_arena_result.ok({ ini = raw_ini, cache = cache })
end

local function synchronize_cache(cache, section, keys)
    local ok, detail = pcall(function()
        for _, key in ipairs(keys) do
            cache[section .. "&" .. key] = nil
        end
    end)
    if not ok then
        return fail("GA_CONFIG_RECOVERY_FAILED", "ini_file_ex cache synchronization failed", { phase = "recovery_cache", detail = tostring(detail) })
    end
    return gamma_arena_result.ok(true)
end

local function attempt_recovery(config, record)
    local port = recovery_port(config)
    if not port.ok then return port end

    for _, key in ipairs(record.order) do
        local entry = record.desired[key]
        local ok, detail
        if entry.present then
            ok, detail = call_adapter(port.value.ini, "w_string", record.section, key, entry.value)
        else
            ok, detail = call_adapter(port.value.ini, "remove_line", record.section, key)
        end
        if not ok then
            invalidate_shadow(record.shadow, record.keys, record.fail_closed_set)
            return fail("GA_CONFIG_RECOVERY_FAILED", "Touched-key recovery mutation failed; config remains quarantined", {
                phase = "recovery_mutation", key = key, failure_kind = detail.kind, detail = detail.detail
            })
        end
    end

    local cache_result = synchronize_cache(port.value.cache, record.section, record.keys)
    if not cache_result.ok then
        invalidate_shadow(record.shadow, record.keys, record.fail_closed_set)
        return cache_result
    end

    local save_ok, save_detail = call_adapter(config, "save")
    if not save_ok then
        invalidate_shadow(record.shadow, record.keys, record.fail_closed_set)
        return fail("GA_CONFIG_RECOVERY_FAILED", "Recovered touched keys could not be persisted; config remains quarantined", {
            phase = "recovery_save", failure_kind = save_detail.kind, detail = save_detail.detail
        })
    end

    update_shadow(record.shadow, record.keys, record.desired)
    quarantine_by_config[config] = nil
    return gamma_arena_result.ok({ recovered = true, state = record.desired })
end

local function quarantine_record(config, snapshot_value, options, primary_failure)
    local fail_closed_set = key_set(options.fail_closed_keys)
    local desired = desired_after_failure(snapshot_value, fail_closed_set)
    local record = {
        section = snapshot_value.section,
        keys = snapshot_value.keys,
        desired = desired,
        order = build_recovery_order(snapshot_value, desired, options),
        fail_closed_set = fail_closed_set,
        shadow = options.shadow,
        primary_failure = primary_failure
    }
    quarantine_by_config[config] = record
    return record
end

local function recover_impl(config)
    local record = quarantine_by_config[config]
    if record == nil then return gamma_arena_result.ok({ recovered = false }) end
    return attempt_recovery(config, record)
end

function recover(config)
    local ok, result = pcall(recover_impl, config)
    if not ok then
        return fail("GA_CONFIG_RECOVERY_FAILED", "Explicit config recovery raised an error", { phase = "recovery_internal", detail = tostring(result) })
    end
    return result
end

function is_quarantined(config)
    return config ~= nil and quarantine_by_config[config] ~= nil
end

local function primary_failure_result(config, snapshot_value, options, phase, failed_at, detail)
    local primary_failure = {
        phase = phase,
        failed_at = failed_at,
        failure_kind = detail.kind,
        detail = detail.detail
    }
    local record = quarantine_record(config, snapshot_value, options, primary_failure)
    local recovery = attempt_recovery(config, record)
    return fail(options.error_code or "GA_CONFIG_TRANSACTION_FAILED", "Config transaction failed; touched-key recovery was attempted", {
        section = snapshot_value.section,
        primary = primary_failure,
        recovery_ok = recovery.ok,
        recovery_error = recovery.ok and nil or recovery.error,
        quarantined = quarantine_by_config[config] ~= nil,
        persisted_state_may_be_unknown = phase == "primary_save"
    })
end

local function run_impl(config, section, operations, options)
    options = options or {}
    if config ~= nil and quarantine_by_config[config] ~= nil then
        return fail("GA_CONFIG_QUARANTINED", "Arena config transactions are blocked until touched-key recovery succeeds", {
            previous = quarantine_by_config[config].primary_failure
        })
    end
    local keys_result = unique_keys(operations)
    if not keys_result.ok then return keys_result end
    local keys = keys_result.value
    local snapshot_result = snapshot(config, section, keys)
    if not snapshot_result.ok then return snapshot_result end

    local ok_methods, w_value, remove_line, save = pcall(function()
        return config.w_value, config.remove_line, config.save
    end)
    if not ok_methods or type(w_value) ~= "function" or type(remove_line) ~= "function" or type(save) ~= "function" then
        return fail("GA_CONFIG_INVALID", "Config does not expose mutation APIs")
    end

    local ordered = order_operations(operations, options)
    for _, operation in ipairs(ordered) do
        local ok, detail
        if operation.action == "write" then
            ok, detail = call_adapter(config, "w_value", section, operation.key, operation.value)
        else
            ok, detail = call_adapter(config, "remove_line", section, operation.key)
        end
        if not ok then
            return primary_failure_result(config, snapshot_result.value, options, "primary_mutation", operation.key, detail)
        end
    end

    local ok_cache, cache = pcall(function() return config.cache end)
    if not ok_cache or type(cache) ~= "table" then
        return primary_failure_result(config, snapshot_result.value, options, "primary_cache", "<cache>", {
            kind = "missing_cache", detail = "ini_file_ex cache is unavailable"
        })
    end
    local cache_result = synchronize_cache(cache, section, keys)
    if not cache_result.ok then
        return primary_failure_result(config, snapshot_result.value, options, "primary_cache", "<cache>", {
            kind = "cache_sync", detail = cache_result.error.message
        })
    end

    local save_ok, save_detail = call_adapter(config, "save")
    if not save_ok then
        return primary_failure_result(config, snapshot_result.value, options, "primary_save", "<save>", save_detail)
    end

    local final_state = {}
    for _, key in ipairs(keys) do final_state[key] = snapshot_result.value.entries[key] end
    for _, operation in ipairs(ordered) do
        final_state[operation.key] = operation.action == "write"
            and { present = true, value = tostring(operation.value) }
            or { present = false }
    end
    update_shadow(options.shadow, keys, final_state)
    return gamma_arena_result.ok({ snapshot = snapshot_result.value, state = final_state })
end

function run(config, section, operations, options)
    local ok, result = pcall(run_impl, config, section, operations, options)
    if not ok then
        return fail("GA_CONFIG_TRANSACTION_FAILED", "Config transaction raised an error before completion", { detail = tostring(result) })
    end
    return result
end
