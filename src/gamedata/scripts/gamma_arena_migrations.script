local SETTINGS_SECTION = "gamma_arena"
local CURRENT_SETTINGS_SCHEMA = 1
local CURRENT_ADDON_VERSION = "0.3.0"
local DEFAULT_DIFFICULTY_ID = "rookie"
local DEFAULT_SEED_MODE = "random"
local CUSTOM_LAUNCH_KEYS = gamma_arena_custom_codec.keys("launch_custom_")

local TRANSIENT_INTENT_KEYS = {
    "launch_pending",
    "launch_token",
    "launch_schema_version",
    "launch_mode_id",
    "launch_difficulty_id",
    "launch_generation_recipe",
    "launch_seed_mode",
    "launch_session_seed",
    "launch_generator_version",
    "launch_catalog_revision",
    "launch_catalog_fingerprint",
    "launch_stage",
    "launch_deferred_level",
    "launch_target_level",
    "resume_pending",
    "resume_session_id",
    "resume_session_nonce",
    "resume_next_fight_index",
    "resume_checkpoint_name",
    "resume_schema_version"
}
for _, key in ipairs(CUSTOM_LAUNCH_KEYS) do TRANSIENT_INTENT_KEYS[#TRANSIENT_INTENT_KEYS + 1] = key end

-- A confirmed defeat is a menu-facing handoff, unlike launch/resume routes.
-- Keep it outside upgrade cleanup so the actor-to-menu VM transition retains it.
local DEFEAT_INTENT_KEYS = {
    "defeat_pending",
    "defeat_token",
    "defeat_schema_version",
    "defeat_stage",
    "defeat_session_id",
    "defeat_session_nonce",
    "defeat_mode_id",
    "defeat_generation_recipe",
    "defeat_difficulty_id",
    "defeat_issued_at"
}

local SNAPSHOT_KEYS = {
    "settings_schema_version",
    "addon_version",
    "last_difficulty_id",
    "last_seed_mode",
    "launch_pending",
    "launch_token",
    "launch_schema_version",
    "launch_mode_id",
    "launch_difficulty_id",
    "launch_generation_recipe",
    "launch_seed_mode",
    "launch_session_seed",
    "launch_generator_version",
    "launch_catalog_revision",
    "launch_catalog_fingerprint",
    "launch_stage",
    "launch_deferred_level",
    "launch_target_level",
    "resume_pending",
    "resume_session_id",
    "resume_session_nonce",
    "resume_next_fight_index",
    "resume_checkpoint_name",
    "resume_schema_version"
}
for _, key in ipairs(CUSTOM_LAUNCH_KEYS) do SNAPSHOT_KEYS[#SNAPSHOT_KEYS + 1] = key end
for _, key in ipairs(DEFEAT_INTENT_KEYS) do SNAPSHOT_KEYS[#SNAPSHOT_KEYS + 1] = key end

local valid_difficulties = {
    rookie = true,
    stalker = true,
    veteran = true,
    master = true
}

local valid_seed_modes = {
    random = true,
    manual = true
}

local function fail(code, message, context)
    return gamma_arena_result.err(code, message, context)
end

local function adapter_boolean_returns(config)
    local ok, declared = pcall(function() return config.gamma_arena_boolean_returns end)
    return ok and declared == true
end

local function raw_read(config, key)
    if config == nil then
        return fail("GA_SETTINGS_CONFIG_INVALID", "Settings config is unavailable")
    end
    if gamma_arena_config_tx.is_quarantined(config) then
        return fail("GA_CONFIG_QUARANTINED", "Arena settings reads are blocked until touched-key recovery succeeds", { key = key })
    end
    local ok_method, method = pcall(function() return config.r_string_ex end)
    if not ok_method or type(method) ~= "function" then
        return fail("GA_SETTINGS_CONFIG_INVALID", "Settings config does not expose r_string_ex", { key = key })
    end
    local ok, value = pcall(method, config, SETTINGS_SECTION, key)
    if not ok or (value == false and adapter_boolean_returns(config)) then
        return fail("GA_SETTINGS_READ_FAILED", "Settings value could not be read", { key = key })
    end
    if value == nil or value == "" then
        return gamma_arena_result.ok(nil)
    end
    return gamma_arena_result.ok(tostring(value))
end

local function read_snapshot(config)
    local snapshot = {}
    for _, key in ipairs(SNAPSHOT_KEYS) do
        local read = raw_read(config, key)
        if not read.ok then
            return read
        end
        snapshot[key] = read.value
    end
    return gamma_arena_result.ok(snapshot)
end

local function parse_schema(raw)
    if raw == nil then
        return gamma_arena_result.ok(0)
    end
    if not string.match(raw, "^%d+$") then
        return fail("GA_SETTINGS_SCHEMA_INVALID", "Settings schema version is malformed", { value = raw })
    end
    local value = tonumber(raw)
    if value == nil or value ~= math.floor(value) then
        return fail("GA_SETTINGS_SCHEMA_INVALID", "Settings schema version is malformed", { value = raw })
    end
    if value > CURRENT_SETTINGS_SCHEMA then
        return fail("GA_SETTINGS_SCHEMA_NEWER", "Settings were created by a newer Gamma Arena version", { schema_version = value, supported = CURRENT_SETTINGS_SCHEMA })
    end
    return gamma_arena_result.ok(value)
end

local function validate_preferences(snapshot)
    if not valid_difficulties[snapshot.last_difficulty_id] then
        return fail("GA_SETTINGS_DIFFICULTY_INVALID", "Stored difficulty is unknown", { value = snapshot.last_difficulty_id })
    end
    if not valid_seed_modes[snapshot.last_seed_mode] then
        return fail("GA_SETTINGS_SEED_MODE_INVALID", "Stored seed mode is unknown", { value = snapshot.last_seed_mode })
    end
    return gamma_arena_result.ok({
        settings_schema_version = CURRENT_SETTINGS_SCHEMA,
        last_difficulty_id = snapshot.last_difficulty_id,
        last_seed_mode = snapshot.last_seed_mode
    })
end

local function write_v1(config, difficulty_id, seed_mode)
    local operations = {}
    for _, key in ipairs(TRANSIENT_INTENT_KEYS) do
        operations[#operations + 1] = { action = "remove", key = key }
    end
    operations[#operations + 1] = { action = "write", key = "last_difficulty_id", value = difficulty_id }
    operations[#operations + 1] = { action = "write", key = "last_seed_mode", value = seed_mode }
    operations[#operations + 1] = { action = "write", key = "addon_version", value = CURRENT_ADDON_VERSION }
    operations[#operations + 1] = { action = "write", key = "settings_schema_version", value = CURRENT_SETTINGS_SCHEMA }
    return gamma_arena_config_tx.run(config, SETTINGS_SECTION, operations, {
        commit_remove_keys = TRANSIENT_INTENT_KEYS,
        fail_closed_keys = TRANSIENT_INTENT_KEYS,
        commit_write_keys = { "addon_version", "settings_schema_version" },
        error_code = "GA_SETTINGS_WRITE_FAILED"
    })
end

local function clear_upgrade_intents(config)
    local operations = {}
    for _, key in ipairs(TRANSIENT_INTENT_KEYS) do
        operations[#operations + 1] = { action = "remove", key = key }
    end
    operations[#operations + 1] = { action = "write", key = "addon_version", value = CURRENT_ADDON_VERSION }
    return gamma_arena_config_tx.run(config, SETTINGS_SECTION, operations, {
        commit_remove_keys = TRANSIENT_INTENT_KEYS,
        fail_closed_keys = TRANSIENT_INTENT_KEYS,
        commit_write_keys = { "addon_version" },
        error_code = "GA_SETTINGS_UPGRADE_WRITE_FAILED"
    })
end

local function migrate_v0_to_v1(config, snapshot)
    local events = {}
    local difficulty_id = snapshot.last_difficulty_id
    if not valid_difficulties[difficulty_id] then
        difficulty_id = DEFAULT_DIFFICULTY_ID
        events[#events + 1] = {
            code = "GA_SETTINGS_DIFFICULTY_DEFAULTED",
            previous = snapshot.last_difficulty_id,
            value = difficulty_id
        }
    end
    local seed_mode = snapshot.last_seed_mode
    if not valid_seed_modes[seed_mode] then
        seed_mode = DEFAULT_SEED_MODE
        events[#events + 1] = {
            code = "GA_SETTINGS_SEED_MODE_DEFAULTED",
            previous = snapshot.last_seed_mode,
            value = seed_mode
        }
    end
    events[#events + 1] = {
        code = snapshot.settings_schema_version == nil and "GA_SETTINGS_INITIALIZED" or "GA_SETTINGS_MIGRATED",
        from_schema = 0,
        to_schema = 1
    }

    local written = write_v1(config, difficulty_id, seed_mode)
    if not written.ok then
        return written
    end
    return gamma_arena_result.ok({
        settings_schema_version = 1,
        addon_version = CURRENT_ADDON_VERSION,
        last_difficulty_id = difficulty_id,
        last_seed_mode = seed_mode,
        events = events
    })
end

local function reconcile_addon_version(config, snapshot)
    local preferences = validate_preferences(snapshot)
    if not preferences.ok then
        return preferences
    end
    if snapshot.addon_version == CURRENT_ADDON_VERSION then
        preferences.value.events = {}
        return preferences
    end

    local written = clear_upgrade_intents(config)
    if not written.ok then
        return written
    end
    preferences.value.events = {
        {
            code = snapshot.addon_version == nil and "GA_ADDON_VERSION_UNKNOWN" or "GA_ADDON_VERSION_CHANGED",
            previous = snapshot.addon_version,
            value = CURRENT_ADDON_VERSION,
            active_fight_compatible = false
        }
    }
    return preferences
end

-- Durable settings are migrated forward one schema at a time. Transient launch
-- and resume intent is deliberately discarded on add-on version transitions.
local function migrate_forward(config, snapshot, schema_version)
    local migrated = nil
    while schema_version < CURRENT_SETTINGS_SCHEMA do
        if schema_version == 0 then
            migrated = migrate_v0_to_v1(config, snapshot)
        else
            return fail("GA_SETTINGS_MIGRATION_PATH_MISSING", "Settings migration path is unavailable", {
                schema_version = schema_version,
                supported = CURRENT_SETTINGS_SCHEMA
            })
        end
        if not migrated.ok then
            return migrated
        end
        schema_version = migrated.value.settings_schema_version
    end
    return migrated
end

function read_settings(config)
    local snapshot_result = read_snapshot(config)
    if not snapshot_result.ok then
        return snapshot_result
    end
    local schema_result = parse_schema(snapshot_result.value.settings_schema_version)
    if not schema_result.ok then
        return schema_result
    end
    if schema_result.value ~= CURRENT_SETTINGS_SCHEMA then
        return fail("GA_SETTINGS_MIGRATION_REQUIRED", "Settings must be migrated before use", { schema_version = schema_result.value })
    end
    local preferences = validate_preferences(snapshot_result.value)
    if not preferences.ok then
        return preferences
    end
    preferences.value.events = {}
    return preferences
end
local function finish_migration(config, result)
    if not result.ok then return result end
    local reconciled = gamma_arena_session_store.reconcile_character_creation(config)
    if not reconciled.ok then return reconciled end
    return result
end

function migrate(config)
    local restored = gamma_arena_session_store.reconcile_character_creation(config)
    if not restored.ok then return restored end
    local snapshot_result = read_snapshot(config)
    if not snapshot_result.ok then
        return snapshot_result
    end
    local snapshot = snapshot_result.value
    local schema_result = parse_schema(snapshot.settings_schema_version)
    if not schema_result.ok then
        return schema_result
    end
    local migrated = migrate_forward(config, snapshot, schema_result.value)
    if migrated ~= nil then
        return finish_migration(config, migrated)
    end
    return finish_migration(config, reconcile_addon_version(config, snapshot))
end
