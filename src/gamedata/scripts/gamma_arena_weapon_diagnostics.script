local UNAVAILABLE = "unavailable"

local function scalar(value)
    local value_type = type(value)
    if value_type == "string" and value ~= "" then return value end
    if value_type == "number" and value == value and value ~= math.huge and value ~= -math.huge then return value end
    if value_type == "boolean" then return value end
    return UNAVAILABLE
end

local function protected_read(deps, section, key)
    if type(deps) ~= "table" or type(deps.read_string) ~= "function"
        or type(section) ~= "string" or section == "" then return UNAVAILABLE end
    local called, value = pcall(deps.read_string, section, key)
    if not called then return UNAVAILABLE end
    return scalar(value)
end

local function protected_id(deps, object, explicit)
    if explicit ~= nil then return scalar(explicit) end
    if object == nil or type(deps) ~= "table" or type(deps.object_id) ~= "function" then return UNAVAILABLE end
    local called, value = pcall(deps.object_id, object)
    if not called then return UNAVAILABLE end
    return scalar(value)
end

function snapshot(deps, context)
    deps = type(deps) == "table" and deps or {}
    context = type(context) == "table" and context or {}
    local weapon_section = scalar(context.weapon_section)
    local fields = {
        session_id = scalar(context.session_id),
        fight_index = scalar(context.fight_index),
        fight_id = scalar(context.fight_id),
        phase = scalar(context.phase),
        actor_id = protected_id(deps, context.actor, context.actor_id),
        item_id = protected_id(deps, context.item, context.item_id),
        weapon_section = weapon_section,
        weapon_kind = protected_read(deps, weapon_section, "kind"),
        weapon_slot = protected_read(deps, weapon_section, "slot"),
        ammo_section = scalar(context.ammo_section),
        ammo_class = protected_read(deps, weapon_section, "ammo_class"),
        parent_section = protected_read(deps, weapon_section, "parent_section"),
        world_visual = protected_read(deps, weapon_section, "visual"),
        hud_section = protected_read(deps, weapon_section, "hud")
    }
    fields.hud_item_visual = protected_read(deps, fields.hud_section, "item_visual")
    fields.hud_anm_show = protected_read(deps, fields.hud_section, "anm_show")
    fields.hud_anm_idle = protected_read(deps, fields.hud_section, "anm_idle")
    fields.hud_anm_idle_empty = protected_read(deps, fields.hud_section, "anm_idle_empty")
    fields.hud_anm_hide = protected_read(deps, fields.hud_section, "anm_hide")
    return gamma_arena_result.ok(fields)
end
