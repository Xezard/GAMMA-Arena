function validate(spec, catalog, layout)
    return gamma_arena_fight_validator_v8.validate(spec, catalog, layout)
end

function validate_runtime(spec, catalog, layout, runtime)
    return gamma_arena_fight_validator_v8.validate(spec, catalog, layout, runtime)
end

function validate_effective_profile(profile, slot, runtime, expected_community)
    if type(profile) ~= "string" or profile == "" or type(slot) ~= "number"
        or type(runtime) ~= "table" or type(runtime.effective_profile) ~= "function"
        or type(expected_community) ~= "string" or expected_community == "" then
        return gamma_arena_result.err("GA_FIGHTSPEC_PROFILE_RUNTIME_INVALID", "Runtime profile validation inputs are invalid", { slot = slot })
    end
    local called, value = pcall(runtime.effective_profile, profile, slot)
    if not called then
        return gamma_arena_result.err("GA_FIGHTSPEC_PROFILE_RUNTIME_INVALID", "Runtime profile validation failed safely", { slot = slot, reason = tostring(value) })
    end
    if type(value) == "table" and type(value.ok) == "boolean" then
        if not value.ok then return value end
        value = value.value
    end
    if type(value) ~= "table" or value.class ~= "AI_STL_S" or value.community ~= expected_community then
        return gamma_arena_result.err("GA_FIGHTSPEC_PROFILE_RUNTIME_INVALID", "Runtime profile class or community is invalid", { slot = slot })
    end
    return gamma_arena_result.ok(true)
end
