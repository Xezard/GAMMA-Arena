local function failure(code, message, context)
    return gamma_arena_result.err(code, message, context or {})
end

local function positive_integer(value)
    return gamma_arena_number.is_positive_integer(value)
end

local function non_negative_integer(value)
    return gamma_arena_number.is_integer(value) and value >= 0
end

local function finite_number(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function array_length(value)
    if type(value) ~= "table" then return nil end
    local count, maximum = 0, 0
    for key in pairs(value) do
        if not positive_integer(key) then return nil end
        count = count + 1
        maximum = math.max(maximum, key)
    end
    if maximum ~= count then return nil end
    return count
end

local function item_exists(values, section)
    if type(values) ~= "table" then return nil end
    for _, value in pairs(values) do if type(value) == "table" and value.section == section then return value end end
end

local function loadout_combination_exists(loadout, combinations, legacy_bandage_cost, private_ammo_boxes)
    if type(combinations) ~= "table" then return false end
    local ammo_boxes = private_ammo_boxes or loadout.ammo_boxes
    for _, combination in ipairs(combinations) do
        if type(combination) == "table" and combination.weapon == loadout.weapon and combination.ammo == loadout.ammo
            and combination.ammo_boxes == ammo_boxes and combination.outfit == loadout.outfit
            and combination.cost - legacy_bandage_cost == loadout.gear_cost then return true end
    end
    return false
end

local function valid_armor_class(value)
    return value == "light" or value == "medium" or value == "scientific" or value == "heavy" or value == "powered_exo"
end

local function rejected_ammo(section)
    return string.match(section, "_bad$") ~= nil or string.match(section, "_verybad$") ~= nil or string.match(section, "_self$") ~= nil
end

local function validate_bonus_ammo(loadout, weapon, actor)
    if not actor then
        if loadout.bonus_ammo ~= nil then return failure("GA_LOADOUT_BONUS_SCOPE_INVALID", "Opponent loadouts cannot contain bonus ammo", {}) end
        return gamma_arena_result.ok(true)
    end
    local bonus = loadout.bonus_ammo
    if type(bonus) ~= "table" or bonus.boxes ~= 1 or type(bonus.section) ~= "string"
        or (bonus.requested_category ~= "standard" and bonus.requested_category ~= "special" and bonus.requested_category ~= "armor_piercing")
        or (bonus.resolved_category ~= "standard" and bonus.resolved_category ~= "special" and bonus.resolved_category ~= "armor_piercing")
        or rejected_ammo(type(bonus) == "table" and bonus.section or "") then
        return failure("GA_LOADOUT_BONUS_AMMO_INVALID", "Actor bonus ammo is invalid", {})
    end
    local declared, requested_exists
    for _, variant in ipairs(weapon.ammo_variants or {}) do
        if variant.category == bonus.requested_category then requested_exists = true end
        if variant.section == bonus.section then declared = variant end
    end
    if type(declared) ~= "table" or declared.category ~= bonus.resolved_category
        or not gamma_arena_number.is_positive_integer(declared.box_size) or declared.box_size >= 4294967296 then return failure("GA_LOADOUT_BONUS_AMMO_INVALID", "Actor bonus ammo is incompatible with the selected weapon", {}) end
    if requested_exists and bonus.resolved_category ~= bonus.requested_category then return failure("GA_LOADOUT_BONUS_AMMO_INVALID", "Available requested bonus category must resolve exactly", {}) end
    if not requested_exists and (bonus.resolved_category ~= "standard" or bonus.section ~= weapon.ammo) then return failure("GA_LOADOUT_BONUS_AMMO_INVALID", "Unavailable bonus category must fall back to base ammo", {}) end
    return gamma_arena_result.ok(true)
end

local function grenade_stream(identity, tag)
    return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ identity.mode_id, identity.difficulty_id, identity.session_seed, identity.fight_index, 6, identity.layout_version, tag }))
end

local function validate_grenades(loadout, catalogs, actor, context)
    local count = array_length(loadout.grenades)
    local maximum = actor and 2 or 1
    if count == nil or count > maximum or type(context) ~= "table" or type(context.spec) ~= "table" then
        return failure("GA_LOADOUT_GRENADE_INVALID", "Loadout grenades must be a dense bounded array", {})
    end
    local pool = actor and catalogs.actor_grenade_list or catalogs.npc_grenade_list
    for _, section in ipairs(loadout.grenades) do
        if type(section) ~= "string" or not item_exists(pool, section) then
            return failure("GA_LOADOUT_GRENADE_INVALID", "Loadout contains a grenade outside its participant pool", { section = section })
        end
    end
    local identity = context.spec
    local expected
    if actor then
        expected = gamma_arena_grenade_generator.generate_actor(catalogs, {
            count = grenade_stream(identity, "actor_grenade_count"),
            sections = {
                grenade_stream(identity, "actor_grenade_section:1"),
                grenade_stream(identity, "actor_grenade_section:2")
            }
        })
    else
        if not positive_integer(context.slot) then return failure("GA_LOADOUT_GRENADE_INVALID", "Opponent grenade validation requires a logical slot", {}) end
        expected = gamma_arena_grenade_generator.generate_enemy(catalogs, {
            presence = grenade_stream(identity, "enemy_grenade_presence:" .. context.slot),
            section = grenade_stream(identity, "enemy_grenade_section:" .. context.slot)
        })
    end
    if not expected.ok or #expected.value.sections ~= count then
        return failure("GA_LOADOUT_GRENADE_INVALID", "Loadout grenade presence differs from deterministic generation", { actual = count })
    end
    for index = 1, count do
        if loadout.grenades[index] ~= expected.value.sections[index] then
            return failure("GA_LOADOUT_GRENADE_INVALID", "Loadout grenade section differs from deterministic generation", { index = index, expected = expected.value.sections[index], actual = loadout.grenades[index] })
        end
    end
    return gamma_arena_result.ok(true)
end

local function same_device(left, right)
    return type(left) == "table" and type(right) == "table"
        and left.catalog_id == right.catalog_id
        and left.section == right.section
        and left.kind == right.kind
        and left.weight == right.weight
        and left.nv_effect == right.nv_effect
end

local function validate_device(loadout, catalogs, actor, context)
    if not actor then
        if loadout.device ~= nil then return failure("GA_LOADOUT_DEVICE_INVALID", "Opponent loadouts cannot contain actor devices", {}) end
        return gamma_arena_result.ok(true)
    end
    local device = loadout.device
    if type(device) ~= "table" or type(device.catalog_id) ~= "string" or device.catalog_id == ""
        or type(device.section) ~= "string" or device.section == ""
        or type(device.kind) ~= "string" or device.kind == ""
        or not positive_integer(device.weight) or (device.nv_effect ~= nil and (type(device.nv_effect) ~= "string" or device.nv_effect == "")) then
        return failure("GA_LOADOUT_DEVICE_INVALID", "Actor loadout device record is malformed", {})
    end
    local catalog_device = type(catalogs.devices) == "table" and catalogs.devices[device.catalog_id] or nil
    if type(catalog_device) ~= "table" or not same_device(device, {
        catalog_id = catalog_device.id,
        section = catalog_device.section,
        kind = catalog_device.kind,
        weight = catalog_device.weight,
        nv_effect = catalog_device.nv_effect
    }) then
        return failure("GA_LOADOUT_DEVICE_INVALID", "Actor loadout device differs from the exact catalog record", { catalog_id = device.catalog_id, section = device.section })
    end
    local identity = type(context) == "table" and context.spec or nil
    local expected = gamma_arena_device_generator.generate(catalogs, identity)
    if not expected.ok or not same_device(device, expected.value) then
        return failure("GA_LOADOUT_DEVICE_INVALID", "Actor loadout device differs from deterministic generation", { catalog_id = device.catalog_id, section = device.section })
    end
    return gamma_arena_result.ok(true)
end

local function validate_loadout(loadout, catalogs, difficulty, gear_budget, medical_budget, actor, actor_context)
    if type(loadout) ~= "table" or type(loadout.weapon) ~= "string" or loadout.weapon == "" or type(loadout.ammo) ~= "string" or loadout.ammo == "" or type(loadout.outfit) ~= "string" or loadout.outfit == "" or type(loadout.knife) ~= "string" or loadout.knife == "" or not positive_integer(loadout.ammo_boxes) or not positive_integer(loadout.gear_cost) or not non_negative_integer(loadout.medical_cost) or not positive_integer(loadout.cost) then
        return failure("GA_LOADOUT_TYPE_INVALID", "Loadout fields have invalid types", {})
    end
    local consumable_count = array_length(loadout.consumables)
    if consumable_count == nil then return failure("GA_LOADOUT_TYPE_INVALID", "Loadout consumables must be an array", {}) end
    if actor and consumable_count == 0 then return failure("GA_LOADOUT_COMBINATION_INVALID", "Actor loadout must contain medicine", {}) end
    local grenade_result = validate_grenades(loadout, catalogs, actor, actor_context)
    if not grenade_result.ok then return grenade_result end
    local device_result = validate_device(loadout, catalogs, actor, actor_context)
    if not device_result.ok then return device_result end
    local weapon = item_exists(catalogs.weapons, loadout.weapon)
    local ammo = item_exists(catalogs.ammo, loadout.ammo)
    local outfit = item_exists(catalogs.outfits, loadout.outfit)
    local knife = item_exists(catalogs.knives, loadout.knife)
    if not knife then return failure("GA_LOADOUT_KNIFE_INVALID", "Loadout knife is not cataloged", { section = loadout.knife }) end
    if actor and weapon and not item_exists(catalogs.actor_weapon_list, loadout.weapon) then
        return failure("GA_ACTOR_WEAPON_QUARANTINED", "Actor weapon is excluded by the exact-section quarantine", { section = loadout.weapon })
    end
    if not weapon or not ammo or not outfit or weapon.ammo ~= loadout.ammo then return failure("GA_LOADOUT_AMMO_INVALID", "Loadout weapon and ammo are incompatible", {}) end
    local bonus_result = validate_bonus_ammo(loadout, weapon, actor)
    if not bonus_result.ok then return bonus_result end
    if not valid_armor_class(outfit.armor_class) then return failure("GA_LOADOUT_OUTFIT_INVALID", "Loadout outfit has no valid armor class", { section = outfit.section }) end
    local gear_cost, private_ammo_boxes
    if actor then
        if type(actor_context) ~= "table" or type(actor_context.spec) ~= "table" or not positive_integer(actor_context.opponent_count)
            or not positive_integer(ammo.cost) or not positive_integer(weapon.cost) or not positive_integer(outfit.cost) then
            return failure("GA_PLAYER_AMMO_SCALE_INVALID", "Actor ammo scaling context or catalog costs are invalid", {})
        end
        local budgeted_numerator = loadout.gear_cost - weapon.cost - outfit.cost
        if budgeted_numerator < 0 or budgeted_numerator % ammo.cost ~= 0 then
            return failure("GA_LOADOUT_COST_INVALID", "Actor gear cost cannot recover a budgeted ammo count", {})
        end
        local budgeted_boxes = budgeted_numerator / ammo.cost
        if not positive_integer(budgeted_boxes) or budgeted_boxes < weapon.ammo_box_min or budgeted_boxes > weapon.ammo_box_max then
            return failure("GA_LOADOUT_COST_INVALID", "Actor budgeted ammo count is outside the catalog range", {})
        end
        gear_cost = weapon.cost + ammo.cost * budgeted_boxes + outfit.cost
        if gear_cost ~= loadout.gear_cost or gear_cost > gear_budget then return failure("GA_LOADOUT_COST_INVALID", "Actor gear cost exceeds its dedicated budget", { cost = gear_cost, budget = gear_budget }) end

        local standard_ammo = type(weapon.ammo_variants) == "table" and weapon.ammo_variants[1] or nil
        if type(standard_ammo) ~= "table" or standard_ammo.section ~= weapon.ammo or standard_ammo.category ~= "standard"
            or not positive_integer(weapon.magazine_size) or weapon.magazine_size >= 4294967296
            or not positive_integer(standard_ammo.box_size) or standard_ammo.box_size >= 4294967296 then
            return failure("GA_PLAYER_AMMO_SCALE_INVALID", "Actor weapon magazine or standard-ammo capacity is invalid", {})
        end
        local identity = actor_context.spec
        local scaled = gamma_arena_generator.scaled_ammo_boxes(function(index)
            return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ identity.mode_id, identity.difficulty_id, identity.session_seed, identity.fight_index, 6, identity.layout_version, "actor_scaled_ammo:" .. tostring(index) }))
        end, weapon.kind, actor_context.opponent_count)
        if not scaled.ok then return scaled end
        local minimum_boxes = math.ceil(3 * weapon.magazine_size / standard_ammo.box_size)
        local expected_boxes = math.max(budgeted_boxes, minimum_boxes) + scaled.value
        if not positive_integer(expected_boxes) or expected_boxes >= 4294967296 then return failure("GA_PLAYER_AMMO_SCALE_INVALID", "Expected actor ammo exceeds engine integer safety", { ammo_boxes = expected_boxes }) end
        if loadout.ammo_boxes ~= expected_boxes then return failure("GA_LOADOUT_AMMO_RANGE_INVALID", "Actor final ammo box count does not match deterministic generation", { expected = expected_boxes, actual = loadout.ammo_boxes }) end
        private_ammo_boxes = budgeted_boxes
    else
        if loadout.ammo_boxes < weapon.ammo_box_min or loadout.ammo_boxes > weapon.ammo_box_max then return failure("GA_LOADOUT_AMMO_RANGE_INVALID", "Ammo box count is invalid", {}) end
        gear_cost = weapon.cost + ammo.cost * loadout.ammo_boxes + outfit.cost
        if gear_cost ~= loadout.gear_cost or gear_cost > gear_budget then return failure("GA_LOADOUT_COST_INVALID", "Loadout gear cost exceeds its dedicated budget", { cost = gear_cost, budget = gear_budget }) end
    end
    local medical_cost, section_counts, category_counts, healing_capable = 0, {}, {}, false
    if actor and (consumable_count > 5 or loadout.consumables[1] ~= "bandage") then return failure("GA_LOADOUT_MEDICAL_INVALID", "Actor medicine must begin with bandage and contain at most five items", {}) end
    if not actor and consumable_count > 2 then return failure("GA_LOADOUT_MEDICAL_INVALID", "Opponent medicine cannot exceed medkit plus bandage", {}) end
    for _, section in ipairs(loadout.consumables) do
        local medical = item_exists(catalogs.medical_items, section)
        if type(medical) ~= "table" then return failure("GA_LOADOUT_MEDICAL_INVALID", "Loadout contains an unknown medical section", { section = section }) end
        section_counts[section] = (section_counts[section] or 0) + 1
        if actor then
            if medical.min_tier > difficulty.tier or section_counts[section] > medical.max_count or (section ~= "bandage" and section_counts[section] > 1) then return failure("GA_LOADOUT_MEDICAL_INVALID", "Actor medicine violates tier or section caps", { section = section }) end
            category_counts[medical.category] = (category_counts[medical.category] or 0) + 1
            if medical.category == "health" or medical.category == "rare" then healing_capable = true end
            medical_cost = medical_cost + medical.actor_cost
        else
            if (section ~= "bandage" and section ~= "medkit") or section_counts[section] > 1 or medical.npc_cost <= 0 then return failure("GA_LOADOUT_MEDICAL_INVALID", "Opponent medicine violates the NPC pool or caps", { section = section }) end
            medical_cost = medical_cost + medical.npc_cost
        end
    end
    if actor and (not healing_capable or (category_counts.health or 0) > 2 or (category_counts.boost or 0) > 1 or (category_counts.rare or 0) > 1) then return failure("GA_LOADOUT_MEDICAL_INVALID", "Actor medicine violates healing or category caps", {}) end
    if medical_cost ~= loadout.medical_cost or loadout.cost ~= gear_cost + medical_cost or (medical_budget ~= nil and medical_cost > medical_budget) then return failure("GA_MEDICAL_COST_INVALID", "Loadout medical cost or total is invalid", { medical_cost = medical_cost, medical_budget = medical_budget }) end
    local legacy_bandage = catalogs.consumables and catalogs.consumables.bandage
    if catalogs.selection_mode == "staged" then
        if not positive_integer(catalogs.minimum_loadout_cost) then return failure("GA_LOADOUT_COMBINATION_INVALID", "Dynamic catalog minimum loadout cost is invalid", {}) end
    elseif type(legacy_bandage) ~= "table" or not loadout_combination_exists(loadout, catalogs.combinations, legacy_bandage.cost, private_ammo_boxes) then
        return failure("GA_LOADOUT_COMBINATION_INVALID", "Loadout must match a catalog combination", {})
    end
    return gamma_arena_result.ok(weapon)
end

local function copy_position(position)
    if position == nil then return nil end
    local ok, x, y, z = pcall(function() return position.x, position.y, position.z end)
    if not ok or not finite_number(x) or not finite_number(y) or not finite_number(z) then return nil end
    return { x = x, y = y, z = z }
end

local function copy_device(device)
    if type(device) ~= "table" then return nil end
    return { catalog_id = device.catalog_id, section = device.section, kind = device.kind, weight = device.weight, nv_effect = device.nv_effect }
end

local function copy_loadout(loadout)
    local consumables = {}; for index, section in ipairs(loadout.consumables) do consumables[index] = section end
    local grenades = {}; for index, section in ipairs(loadout.grenades) do grenades[index] = section end
    local copy = { weapon = loadout.weapon, ammo = loadout.ammo, ammo_boxes = loadout.ammo_boxes, outfit = loadout.outfit, knife = loadout.knife, consumables = consumables, grenades = grenades, device = copy_device(loadout.device), gear_cost = loadout.gear_cost, medical_cost = loadout.medical_cost, cost = loadout.cost }
    if type(loadout.bonus_ammo) == "table" then copy.bonus_ammo = { section = loadout.bonus_ammo.section, requested_category = loadout.bonus_ammo.requested_category, resolved_category = loadout.bonus_ammo.resolved_category, boxes = loadout.bonus_ammo.boxes } end
    return copy
end

local function copy_participant(participant)
    local result = { slot = participant.slot, spawn_path = participant.spawn_path, look_path = participant.look_path, profile = participant.profile, community = participant.community, profile_cost = participant.profile_cost, loadout = copy_loadout(participant.loadout), total_cost = participant.total_cost, spawn_slot_id = participant.spawn_slot_id, tactical_route = participant.tactical_route, role = participant.role }
    if type(participant.spawn) == "table" then
        result.spawn = { position = copy_position(participant.spawn.position), level_vertex_id = participant.spawn.level_vertex_id, game_vertex_id = participant.spawn.game_vertex_id }
    end
    return result
end

local function normalized_community(value)
    if type(value) ~= "string" then return nil end
    return string.lower((string.gsub(value, "^%s*(.-)%s*$", "%1")))
end

function validate_effective_profile(section, slot, runtime, expected_community)
    if type(runtime) ~= "table" then return failure("GA_ENEMY_EFFECTIVE_PROFILE_API_MISSING", "Effective NPC profile validation is unavailable", { slot = slot, section = section }) end
    local resolver_ok, resolver = pcall(function() return runtime.effective_profile end)
    if not resolver_ok or type(resolver) ~= "function" then return failure("GA_ENEMY_EFFECTIVE_PROFILE_API_MISSING", "Effective NPC profile validation is unavailable", { slot = slot, section = section }) end
    local called, value = pcall(resolver, section)
    if not called then return failure("GA_ENEMY_EFFECTIVE_PROFILE_READ_FAILED", "Effective NPC profile could not be read safely", { slot = slot, section = section, reason = tostring(value) }) end
    if type(value) == "table" and type(value.ok) == "boolean" then if not value.ok then return value end; value = value.value end
    if type(value) ~= "table" then return failure("GA_ENEMY_EFFECTIVE_PROFILE_INVALID", "Effective NPC profile must contain class and community", { slot = slot, section = section }) end
    if value.class ~= "AI_STL_S" then return failure("GA_ENEMY_EFFECTIVE_CLASS_INVALID", "Effective Arena opponent class must be human AI_STL_S", { slot = slot, section = section, class = value.class }) end
    expected_community = normalized_community(expected_community) or "arena_enemy"
    if normalized_community(value.community) ~= expected_community then return failure("GA_ENEMY_EFFECTIVE_COMMUNITY_INVALID", "Effective Arena opponent community does not match FightSpec", { slot = slot, section = section, community = value.community, expected_community = expected_community }) end
    return gamma_arena_result.ok(true)
end

local function resolved_layout_index(value, expected)
    if type(value) ~= "table" or value.id ~= expected.id or value.level ~= expected.level or value.version ~= expected.version then return nil, failure("GA_RESOLVED_LAYOUT_INVALID", "Resolved layout identity is invalid", {}) end
    local slot_count = array_length(value.opponent_spawn_slots)
    local route_count = array_length(value.tactical_routes)
    if slot_count == nil or route_count == nil or slot_count < 1 or route_count < 1 then return nil, failure("GA_RESOLVED_LAYOUT_INVALID", "Resolved layout arrays are invalid", {}) end
    local slots, routes = {}, {}
    for _, route in ipairs(value.tactical_routes) do
        if type(route) ~= "string" or route == "" or routes[route] then return nil, failure("GA_RESOLVED_LAYOUT_INVALID", "Resolved tactical routes are invalid", { route = route }) end
        routes[route] = true
    end
    for _, slot in ipairs(value.opponent_spawn_slots) do
        local position = type(slot) == "table" and copy_position(slot.position) or nil
        if type(slot) ~= "table" or type(slot.id) ~= "string" or slot.id == "" or slots[slot.id] or type(slot.base_route) ~= "string" or not routes[slot.base_route] or position == nil or not gamma_arena_number.is_integer(slot.level_vertex_id) or slot.level_vertex_id < 0 or not gamma_arena_number.is_integer(slot.game_vertex_id) or slot.game_vertex_id < 0 then
            return nil, failure("GA_RESOLVED_LAYOUT_INVALID", "Resolved physical spawn slot is invalid", { id = type(slot) == "table" and slot.id or nil })
        end
        slots[slot.id] = { position = position, level_vertex_id = slot.level_vertex_id, game_vertex_id = slot.game_vertex_id }
    end
    return { slots = slots, routes = routes, capacity = slot_count }
end

local function same_position(left, right)
    return left ~= nil and right ~= nil and left.x == right.x and left.y == right.y and left.z == right.z
end

local function validate_impl(spec, catalogs, resolved_layout, runtime)
    if type(spec) ~= "table" or type(catalogs) ~= "table" or type(catalogs.layouts) ~= "table" or type(catalogs.difficulties) ~= "table" then return failure("GA_FIGHTSPEC_TYPE_INVALID", "FightSpec and normalized catalogs are required", {}) end
    if spec.mode_id ~= "skirmish" then return failure("GA_MODE_INVALID", "FightSpec mode must be skirmish", { mode_id = spec.mode_id }) end
    if type(spec.layout_id) ~= "string" or type(catalogs.layouts[spec.layout_id]) ~= "table" then return failure("GA_LAYOUT_UNKNOWN", "FightSpec layout is unknown", { layout_id = spec.layout_id }) end
    if type(spec.difficulty_id) ~= "string" or type(catalogs.difficulties[spec.difficulty_id]) ~= "table" then return failure("GA_DIFFICULTY_UNKNOWN", "FightSpec difficulty is unknown", { difficulty_id = spec.difficulty_id }) end
    local layout, difficulty = catalogs.layouts[spec.layout_id], catalogs.difficulties[spec.difficulty_id]
    local resolved, resolved_error = resolved_layout_index(resolved_layout, layout); if not resolved then return resolved_error end
    if not gamma_arena_number.is_integer(spec.schema_version) or not gamma_arena_number.is_integer(spec.generator_version) or not gamma_arena_number.is_integer(spec.catalog_revision) or spec.schema_version ~= 8 or spec.generator_version ~= catalogs.generator_version or spec.catalog_revision ~= catalogs.revision then return failure("GA_FIGHTSPEC_VERSION_INVALID", "FightSpec schema or catalog version is invalid", {}) end
    if not gamma_arena_number.is_integer(spec.layout_version) or spec.layout_version ~= resolved_layout.version then return failure("GA_LAYOUT_VERSION_INVALID", "FightSpec layout version is invalid", { layout_version = spec.layout_version }) end
    if spec.level ~= resolved_layout.level then return failure("GA_LEVEL_INVALID", "FightSpec level does not match layout", { level = spec.level }) end
    if type(spec.diagnostic) ~= "string" or spec.diagnostic == "" then return failure("GA_FIGHTSPEC_TYPE_INVALID", "FightSpec diagnostic must be a non-empty string", {}) end
    if not gamma_arena_number.is_integer(spec.session_seed) or spec.session_seed < 1 or spec.session_seed > 2147483646 or not gamma_arena_number.is_integer(spec.fight_index) or spec.fight_index < 0 then return failure("GA_FIGHTSPEC_TYPE_INVALID", "FightSpec seed and index are invalid", {}) end
    local expected_fight_id = "ga-" .. spec.session_seed .. "-" .. spec.fight_index .. "-g" .. catalogs.generator_version .. "-c" .. catalogs.revision .. "-l" .. resolved_layout.version
    if spec.fight_id ~= expected_fight_id then return failure("GA_FIGHT_ID_INVALID", "Fight id does not match FightSpec generation inputs", { expected = expected_fight_id, actual = spec.fight_id }) end
    if type(spec.actor) ~= "table" or type(spec.actor.loadout) ~= "table" then return failure("GA_FIGHTSPEC_TYPE_INVALID", "FightSpec actor and loadout must be tables", {}) end
    if spec.actor.spawn_path ~= resolved_layout.actor_spawn_path or spec.actor.look_path ~= resolved_layout.actor_look_path then return failure("GA_ACTOR_PATH_INVALID", "Actor paths do not match the selected layout", {}) end
    local opponent_count = array_length(spec.opponents)
    if opponent_count == nil then return failure("GA_FIGHTSPEC_TYPE_INVALID", "FightSpec opponents must be a dense array", {}) end
    if opponent_count < difficulty.enemy_min or opponent_count > math.min(difficulty.enemy_max, resolved.capacity) then return failure("GA_OPPONENT_COUNT_INVALID", "Opponent count is outside envelope", {}) end
    local actor_result = validate_loadout(spec.actor.loadout, catalogs, difficulty, difficulty.player_gear_budget, difficulty.player_medical_budget, true, { spec = spec, opponent_count = opponent_count }); if not actor_result.ok then return actor_result end
    local slot_base = math.floor(difficulty.enemy_total_budget / opponent_count)
    local slot_remainder = difficulty.enemy_total_budget % opponent_count
    local seen, spent, primary_count, sniper_count, enemy_medical_cost, enemy_medkits, enemy_bandages = {}, 0, 0, 0, 0, 0, 0
    for index = 1, opponent_count do
        local opponent = spec.opponents[index]
        if type(opponent) ~= "table" or not positive_integer(opponent.slot) or opponent.slot ~= index or type(opponent.spawn_slot_id) ~= "string" or opponent.spawn_slot_id == "" or type(opponent.tactical_route) ~= "string" or type(opponent.profile) ~= "string" or not positive_integer(opponent.profile_cost) or not positive_integer(opponent.total_cost) or type(opponent.loadout) ~= "table" or (opponent.role ~= "leader" and opponent.role ~= "primary" and opponent.role ~= "secondary") then
            if type(opponent) == "table" and (not positive_integer(opponent.slot) or opponent.slot ~= index) then return failure("GA_OPPONENT_SLOT_INVALID", "Opponent slot must equal array index", { index = index, slot = opponent.slot }) end
            return failure("GA_FIGHTSPEC_TYPE_INVALID", "Opponent fields have invalid types", { index = index })
        end
        local physical = resolved.slots[opponent.spawn_slot_id]
        local spawn_position = type(opponent.spawn) == "table" and copy_position(opponent.spawn.position) or nil
        if physical == nil or spawn_position == nil or not same_position(spawn_position, physical.position) or opponent.spawn.level_vertex_id ~= physical.level_vertex_id or opponent.spawn.game_vertex_id ~= physical.game_vertex_id then return failure("GA_SPAWN_SLOT_INVALID", "Opponent physical spawn does not match resolved layout", { slot = index, spawn_slot_id = opponent.spawn_slot_id }) end
        if seen[opponent.spawn_slot_id] then return failure("GA_SPAWN_SLOT_DUPLICATE", "Opponent physical spawn slots must be unique", { spawn_slot_id = opponent.spawn_slot_id }) end
        seen[opponent.spawn_slot_id] = true
        if not resolved.routes[opponent.tactical_route] or opponent.spawn_path ~= opponent.tactical_route then return failure("GA_TACTICAL_ROUTE_INVALID", "Opponent tactical route is unavailable", { route = opponent.tactical_route }) end
        local profile = item_exists(catalogs.profiles, opponent.profile)
        if not profile then return failure("GA_ENEMY_NOT_HUMAN", "Opponent profile is not an allowlisted human", { slot = index }) end
        local expected_community = normalized_community(profile.community) or "bandit"
        if catalogs.selection_mode == "staged" and normalized_community(opponent.community) ~= expected_community then return failure("GA_ENEMY_EFFECTIVE_COMMUNITY_INVALID", "FightSpec opponent community does not match catalog profile", { slot = index, section = opponent.profile, community = opponent.community, expected_community = expected_community }) end
        if runtime ~= nil then
            local expected_runtime_community = normalized_community(profile.runtime_community)
            if expected_runtime_community == nil then
                return failure("GA_ENEMY_EFFECTIVE_COMMUNITY_INVALID", "Catalog profile runtime community is unavailable", { slot = index, section = opponent.profile })
            end
            local effective = validate_effective_profile(opponent.profile, index, runtime, expected_runtime_community)
            if not effective.ok then return effective end
        end
        local slot_budget = slot_base + (index <= slot_remainder and 1 or 0)
        local gear_result = validate_loadout(opponent.loadout, catalogs, difficulty, slot_budget - profile.cost - 1, nil, false, { spec = spec, slot = index }); if not gear_result.ok then return gear_result end
        local weapon = gear_result.value
        local is_primary = weapon.kind ~= "w_pistol"
        if opponent.role == "secondary" and is_primary then return failure("GA_ENEMY_ROLE_INVALID", "Secondary role received a primary firearm", { slot = index }) end
        if opponent.role ~= "secondary" and not is_primary then return failure("GA_ENEMY_ROLE_INVALID", "Primary role received a sidearm", { slot = index }) end
        if opponent.role == "leader" and index ~= 1 then return failure("GA_ENEMY_ROLE_INVALID", "Leader must occupy the first deterministic slot", { slot = index }) end
        if is_primary then primary_count = primary_count + 1 end
        if weapon.kind == "w_sniper" then sniper_count = sniper_count + 1 end
        if opponent.profile_cost ~= profile.cost or opponent.total_cost ~= profile.cost + opponent.loadout.cost then return failure("GA_ENEMY_COST_INVALID", "Opponent cost is inconsistent", { slot = index }) end
        if opponent.profile_cost + opponent.loadout.gear_cost > slot_budget - 1 then return failure("GA_ENEMY_SLOT_BUDGET_INVALID", "Opponent profile and gear exceed the bandage-free slot budget", { slot = index, cost = opponent.profile_cost + opponent.loadout.gear_cost, budget = slot_budget - 1 }) end
        enemy_medical_cost = enemy_medical_cost + opponent.loadout.medical_cost
        for _, medical_section in ipairs(opponent.loadout.consumables) do
            if medical_section == "medkit" then enemy_medkits = enemy_medkits + 1 elseif medical_section == "bandage" then enemy_bandages = enemy_bandages + 1 end
        end
        spent = spent + opponent.total_cost
    end
    if primary_count * 100 < opponent_count * difficulty.primary_share_percent then return failure("GA_ENEMY_PRIMARY_SHARE_INVALID", "Opponent primary firearm share is below difficulty minimum", { primary = primary_count, opponents = opponent_count }) end
    if sniper_count > 1 then return failure("GA_ENEMY_SNIPER_LIMIT_INVALID", "Opponent cohort contains more than one sniper", { count = sniper_count }) end
    if enemy_medical_cost ~= opponent_count or enemy_medkits < 1 or enemy_medkits > math.ceil(opponent_count / 4) or enemy_bandages ~= opponent_count - 2 * enemy_medkits then return failure("GA_ENEMY_MEDICAL_MIX_INVALID", "Opponent medical mix does not match its pooled team budget", { medical_cost = enemy_medical_cost, medkits = enemy_medkits, bandages = enemy_bandages, opponents = opponent_count }) end
    if spent > difficulty.enemy_total_budget then return failure("GA_ENEMY_BUDGET_INVALID", "Enemy total cost exceeds difficulty budget", {}) end
    local private = { schema_version = spec.schema_version, generator_version = spec.generator_version, catalog_revision = spec.catalog_revision, layout_version = spec.layout_version, session_seed = spec.session_seed, fight_index = spec.fight_index, fight_id = spec.fight_id, mode_id = spec.mode_id, difficulty_id = spec.difficulty_id, layout_id = spec.layout_id, level = spec.level, actor = copy_participant(spec.actor), opponents = {}, tactical_routes = {}, diagnostic = spec.diagnostic }
    for index = 1, opponent_count do private.opponents[index] = copy_participant(spec.opponents[index]) end
    for index, route in ipairs(resolved_layout.tactical_routes) do private.tactical_routes[index] = route end
    return gamma_arena_result.ok({ session_seed = function() return private.session_seed end, fight_index = function() return private.fight_index end, fight_id = function() return private.fight_id end, actor = function() return copy_participant(private.actor) end, opponents = function() local copy = {}; for index, value in ipairs(private.opponents) do copy[index] = copy_participant(value) end; return copy end, tactical_routes = function() local copy = {}; for index, value in ipairs(private.tactical_routes) do copy[index] = value end; return copy end, stable_encode = function() return gamma_arena_generator.stable_encode(private) end })
end

function validate(spec, catalogs, resolved_layout)
    local succeeded, result = pcall(validate_impl, spec, catalogs, resolved_layout, nil)
    if succeeded then return result end
    return failure("GA_FIGHTSPEC_TYPE_INVALID", "FightSpec validation failed safely", { reason = tostring(result) })
end

function validate_runtime(spec, catalogs, resolved_layout, runtime)
    if type(runtime) ~= "table" then return failure("GA_ENEMY_EFFECTIVE_PROFILE_API_MISSING", "Runtime FightSpec validation requires an effective profile resolver", {}) end
    local succeeded, result = pcall(validate_impl, spec, catalogs, resolved_layout, runtime)
    if succeeded then return result end
    return failure("GA_FIGHTSPEC_TYPE_INVALID", "Runtime FightSpec validation failed safely", { reason = tostring(result) })
end
