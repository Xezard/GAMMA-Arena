local function item_exists(values, section)
    for _, value in pairs(values) do if value.section == section then return value end end
end

local function validate_loadout(loadout, catalogs, budget)
    if type(loadout) ~= "table" then return gamma_arena_result.err("GA_LOADOUT_INVALID", "Loadout is missing", {}) end
    local weapon = item_exists(catalogs.weapons, loadout.weapon); local ammo = item_exists(catalogs.ammo, loadout.ammo); local outfit = item_exists(catalogs.outfits, loadout.outfit)
    if not weapon or not ammo or not outfit or weapon.ammo ~= loadout.ammo then return gamma_arena_result.err("GA_LOADOUT_AMMO_INVALID", "Loadout weapon and ammo are incompatible", {}) end
    if type(loadout.ammo_boxes) ~= "number" or loadout.ammo_boxes < weapon.ammo_box_min or loadout.ammo_boxes > weapon.ammo_box_max then return gamma_arena_result.err("GA_LOADOUT_AMMO_RANGE_INVALID", "Ammo box count is invalid", {}) end
    local cost = weapon.cost + ammo.cost * loadout.ammo_boxes + outfit.cost
    for _, section in ipairs(loadout.consumables or {}) do local consumable = item_exists(catalogs.consumables, section); if not consumable then return gamma_arena_result.err("GA_LOADOUT_CONSUMABLE_INVALID", "Consumable is not cataloged", { section = section }) end; cost = cost + consumable.cost end
    if cost ~= loadout.cost or cost > budget then return gamma_arena_result.err("GA_LOADOUT_COST_INVALID", "Loadout cost exceeds budget", { cost = cost, budget = budget }) end
    return gamma_arena_result.ok(true)
end

local function copy_loadout(loadout)
    local consumables = {}; for index, section in ipairs(loadout.consumables) do consumables[index] = section end
    return { weapon = loadout.weapon, ammo = loadout.ammo, ammo_boxes = loadout.ammo_boxes, outfit = loadout.outfit, consumables = consumables, cost = loadout.cost }
end

local function copy_participant(participant)
    return { slot = participant.slot, spawn_path = participant.spawn_path, look_path = participant.look_path, profile = participant.profile, profile_cost = participant.profile_cost, loadout = copy_loadout(participant.loadout), total_cost = participant.total_cost }
end

function validate(spec, catalogs)
    if type(spec) ~= "table" or type(catalogs) ~= "table" then return gamma_arena_result.err("GA_FIGHTSPEC_INVALID", "FightSpec and catalogs are required", {}) end
    local layout, difficulty = catalogs.layouts[spec.layout_id], catalogs.difficulties[spec.difficulty_id]
    if spec.schema_version ~= 1 or spec.generator_version ~= catalogs.generator_version or spec.catalog_revision ~= catalogs.revision or not layout or not difficulty then return gamma_arena_result.err("GA_FIGHTSPEC_VERSION_INVALID", "FightSpec schema or catalog version is invalid", {}) end
    if type(spec.fight_id) ~= "string" or not string.match(spec.fight_id, "^ga%-%d+%-%d+%-g1%-c" .. catalogs.revision .. "%-l" .. layout.version .. "$") then return gamma_arena_result.err("GA_FIGHT_ID_INVALID", "Fight id is not stable v1 format", {}) end
    if not spec.actor or spec.actor.spawn_path ~= layout.actor_spawn_path or spec.actor.look_path ~= layout.actor_look_path then return gamma_arena_result.err("GA_ACTOR_PATH_INVALID", "Actor paths do not match the selected layout", {}) end
    local actor = validate_loadout(spec.actor.loadout, catalogs, difficulty.player_loadout_budget); if not actor.ok then return actor end
    if #spec.opponents < difficulty.enemy_min or #spec.opponents > math.min(difficulty.enemy_max, #layout.opponent_spawn_paths) then return gamma_arena_result.err("GA_OPPONENT_COUNT_INVALID", "Opponent count is outside envelope", {}) end
    local seen, spent = {}, 0
    local valid_paths = {}; for _, path in ipairs(layout.opponent_spawn_paths) do valid_paths[path] = true end
    for index, opponent in ipairs(spec.opponents) do
        local profile = item_exists(catalogs.profiles, opponent.profile)
        if not profile then return gamma_arena_result.err("GA_ENEMY_NOT_HUMAN", "Opponent profile is not an allowlisted human", { slot = index }) end
        if not valid_paths[opponent.spawn_path] then return gamma_arena_result.err("GA_SPAWN_PATH_INVALID", "Opponent spawn path is not in the selected layout", { path = opponent.spawn_path }) end
        if seen[opponent.spawn_path] then return gamma_arena_result.err("GA_SPAWN_PATH_DUPLICATE", "Opponent spawn paths must be unique", { path = opponent.spawn_path }) end
        seen[opponent.spawn_path] = true
        local gear = validate_loadout(opponent.loadout, catalogs, difficulty.enemy_total_budget - profile.cost); if not gear.ok then return gear end
        if opponent.profile_cost ~= profile.cost or opponent.total_cost ~= profile.cost + opponent.loadout.cost then return gamma_arena_result.err("GA_ENEMY_COST_INVALID", "Opponent cost is inconsistent", { slot = index }) end
        spent = spent + opponent.total_cost
    end
    if spent > difficulty.enemy_total_budget then return gamma_arena_result.err("GA_ENEMY_BUDGET_INVALID", "Enemy total cost exceeds difficulty budget", {}) end
    local private = { schema_version = spec.schema_version, generator_version = spec.generator_version, catalog_revision = spec.catalog_revision, layout_version = spec.layout_version, fight_id = spec.fight_id, mode_id = spec.mode_id, difficulty_id = spec.difficulty_id, layout_id = spec.layout_id, level = spec.level, actor = copy_participant(spec.actor), opponents = {}, diagnostic = spec.diagnostic }
    for index, opponent in ipairs(spec.opponents) do private.opponents[index] = copy_participant(opponent) end
    return gamma_arena_result.ok({ fight_id = function() return private.fight_id end, actor = function() return copy_participant(private.actor) end, opponents = function() local copy = {}; for index, value in ipairs(private.opponents) do copy[index] = copy_participant(value) end; return copy end, stable_encode = function() return gamma_arena_generator.stable_encode(private) end })
end
