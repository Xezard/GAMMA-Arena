local function method_present(object, method_name)
    local ok, method = pcall(function() return object and object[method_name] end)
    return ok and type(method) == "function"
end

local function alife_method_present(probes, method_name)
    if type(probes.alife) ~= "function" then return false end
    local ok, service = pcall(probes.alife)
    return ok and service ~= nil and method_present(service, method_name)
end

local function system_method_present(probes, method_name)
    if type(probes.system_ini) ~= "function" then return false end
    local ok, system = pcall(probes.system_ini)
    return ok and system ~= nil and method_present(system, method_name)
end

local function field_present(object, field_name)
    local ok, value = pcall(function() return object and object[field_name] end)
    return ok and value ~= nil
end
local function engine_callable_present(value)
    return value ~= nil
end


local required_capabilities = {
    { name = "RegisterScriptCallback", present = function(p) return type(p.RegisterScriptCallback) == "function" end },
    { name = "UnregisterScriptCallback", present = function(p) return type(p.UnregisterScriptCallback) == "function" end },
