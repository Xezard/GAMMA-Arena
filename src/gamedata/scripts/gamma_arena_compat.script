    { name = "system_ini", present = function(p) return type(p.system_ini) == "function" end },
    { name = "system_ini.r_u32", present = function(p) return system_method_present(p, "r_u32") end },
    { name = "alife", present = function(p) return type(p.alife) == "function" end },
    { name = "alife().get_children", present = function(p) return alife_method_present(p, "get_children") end },
