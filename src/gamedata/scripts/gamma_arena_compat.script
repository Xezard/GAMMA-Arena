    { name = "safe_release_manager.release", present = function(p) return type(p.safe_release_manager) == "table" and type(p.safe_release_manager.release) == "function" end }
}

local config_methods = { "r_value", "r_string_ex", "line_exist", "w_value", "remove_line", "save" }
local tactical_capabilities = {
    { name = "xr_logic.configure_schemes", present = function(p) return type(p.xr_logic) == "table" and type(p.xr_logic.configure_schemes) == "function" end },
    { name = "xr_logic.activate_by_section", present = function(p) return type(p.xr_logic) == "table" and type(p.xr_logic.activate_by_section) == "function" end },
    { name = "xr_logic.switch_to_section", present = function(p) return type(p.xr_logic) == "table" and type(p.xr_logic.switch_to_section) == "function" end },
    { name = "modules.stype_stalker", present = function(p) return type(p.modules) == "table" and field_present(p.modules, "stype_stalker") end },
    { name = "tactical_ini", present = function(p) return type(p.tactical_ini) == "function" end }
}

local function add_error(errors, code, message, context)
    errors[#errors + 1] = { code = code, message = message, context = context or {} }
end

local function finite_number(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function finite_integer(value)
    return finite_number(value) and value == math.floor(value)
end

local function safe_call(fn, ...)
    local values = { pcall(fn, ...) }
    if not values[1] then return false, values[2] end
    return true, values[2], values[3], values[4]
end

local function validate_tactical_director(probes, layout, level_is_valid, errors)
    if type(probes.tactical_ini) ~= "function" then return end
    local ini_ok, tactical_ini = safe_call(probes.tactical_ini)
    if not ini_ok or tactical_ini == nil then
        add_error(errors, "GA_PREFLIGHT_DIRECTOR_API_MISSING", "Tactical director config is unavailable", { capability = "tactical_ini" })
        return
    end

    local methods_valid = true
    for _, method_name in ipairs({ "section_exist", "line_exist", "r_u32", "r_string_ex" }) do
        if not method_present(tactical_ini, method_name) then
            methods_valid = false
            add_error(errors, "GA_PREFLIGHT_DIRECTOR_API_MISSING", "Tactical director config lacks a required method", {
                capability = "tactical_ini." .. method_name
            })
        end
    end
    if not methods_valid then return end

    local function section_exists(section)
        local ok, value = safe_call(tactical_ini.section_exist, tactical_ini, section)
        return ok and value == true
    end
    local function read_u32(key)
        local line_ok, line_exists = safe_call(tactical_ini.line_exist, tactical_ini, "director", key)
        if not line_ok or line_exists ~= true then return nil end
        local value_ok, value = safe_call(tactical_ini.r_u32, tactical_ini, "director", key)
        if not value_ok or not finite_integer(value) then return nil end
        return value
    end

    for _, section in ipairs({ "meta", "director" }) do
        if not section_exists(section) then
            add_error(errors, "GA_PREFLIGHT_DIRECTOR_SECTION_MISSING", "Tactical director section is unavailable", { section = section })
        end
    end
    if type(layout) == "table" then
        for _, path in ipairs(layout.opponent_spawn_paths or {}) do
            for _, prefix in ipairs({ "logic@ga_", "walker@ga_" }) do
                local section = prefix .. path
                if not section_exists(section) then
                    add_error(errors, "GA_PREFLIGHT_DIRECTOR_SECTION_MISSING", "Tactical route section is unavailable", { section = section })
                end
            end
        end
    end

    local values = {}
    local numeric_keys = {
        "observation_interval_ms",
        "report_delay_min_ms",
        "report_delay_max_ms",
        "assignment_dwell_ms",
        "visual_aging_ms",
        "evidence_expiry_ms",
        "hint_delay_ms",
        "hint_cooldown_ms"
    }
    for _, key in ipairs(numeric_keys) do
        values[key] = read_u32(key)
        if values[key] == nil or values[key] == 0 then
            add_error(errors, "GA_PREFLIGHT_DIRECTOR_CONFIG_INVALID", "Tactical director timing must be a positive integer", { key = key })
        end
    end
    if values.report_delay_min_ms and values.report_delay_max_ms and values.report_delay_max_ms < values.report_delay_min_ms then
        add_error(errors, "GA_PREFLIGHT_DIRECTOR_CONFIG_INVALID", "Tactical report delay bounds are inverted", { key = "report_delay_max_ms" })
    end
    if values.visual_aging_ms and values.evidence_expiry_ms and values.evidence_expiry_ms < values.visual_aging_ms then
        add_error(errors, "GA_PREFLIGHT_DIRECTOR_CONFIG_INVALID", "Tactical evidence expires before visual aging", { key = "evidence_expiry_ms" })
    end
    if values.evidence_expiry_ms and values.hint_delay_ms and values.hint_delay_ms < values.evidence_expiry_ms then
        add_error(errors, "GA_PREFLIGHT_DIRECTOR_CONFIG_INVALID", "Tactical hint would reveal the actor before evidence expires", { key = "hint_delay_ms" })
    end

    local look_line_ok, look_line_exists = safe_call(tactical_ini.line_exist, tactical_ini, "director", "look_path")
    local look_ok, look_path = safe_call(tactical_ini.r_string_ex, tactical_ini, "director", "look_path")
    if not look_line_ok or look_line_exists ~= true or not look_ok or type(look_path) ~= "string" or look_path == "" then
        add_error(errors, "GA_PREFLIGHT_DIRECTOR_CONFIG_INVALID", "Tactical director look path is invalid", { key = "look_path" })
        return
    end
    if level_is_valid and type(probes.level.patrol_path_exists) == "function" then
        local exists_ok, exists = safe_call(probes.level.patrol_path_exists, look_path)
        if not exists_ok or exists ~= true then
            add_error(errors, "GA_PREFLIGHT_DIRECTOR_LOOK_PATH_MISSING", "Tactical director look path is unavailable", { path = look_path })
        end
    end
end

local function resolve_path(probes, path, errors, resolved)
    local exists_ok, exists = safe_call(probes.level.patrol_path_exists, path)
    if not exists_ok or exists ~= true then
        add_error(errors, "GA_PREFLIGHT_PATROL_MISSING", "Required Arena patrol path is unavailable", { path = path })
        return
    end
    local patrol_ok, patrol_object = safe_call(probes.patrol, path)
    if not patrol_ok or patrol_object == nil then
        add_error(errors, "GA_PREFLIGHT_PATROL_INVALID", "Arena patrol path could not be opened", { path = path })
        return
    end
    local methods_ok, point_method, level_vertex_method, game_vertex_method = pcall(function()
        return patrol_object.point, patrol_object.level_vertex_id, patrol_object.game_vertex_id
    end)
    if not methods_ok or type(point_method) ~= "function" or type(level_vertex_method) ~= "function" or type(game_vertex_method) ~= "function" then
        add_error(errors, "GA_PREFLIGHT_PATROL_INVALID", "Arena patrol path lacks point or vertex accessors", { path = path })
        return
    end
    local point_ok, point = safe_call(point_method, patrol_object, 0)
    local lvid_ok, lvid = safe_call(level_vertex_method, patrol_object, 0)
    local gvid_ok, gvid = safe_call(game_vertex_method, patrol_object, 0)
    local coordinates_ok, x, y, z = pcall(function() return point.x, point.y, point.z end)
    local vector_methods_ok = point_ok and point ~= nil and method_present(point, "sub") and method_present(point, "getH")
    if not point_ok or point == nil or not coordinates_ok or not vector_methods_ok or not finite_number(x) or not finite_number(y) or not finite_number(z)
        or not lvid_ok or not finite_integer(lvid) or lvid < 0 or lvid >= 4294967295
        or not gvid_ok or not finite_integer(gvid) or gvid < 0 or gvid >= 4294967295 then
        add_error(errors, "GA_PREFLIGHT_PATROL_INVALID", "Arena patrol point or vertex ids are invalid", { path = path })
        return
    end
    local coordinate_key = string.format("%.17g|%.17g|%.17g", x, y, z)
    if resolved[coordinate_key] then
        add_error(errors, "GA_PREFLIGHT_PATROL_COINCIDENT", "Arena patrol anchors must resolve to distinct points", {
            path = path,
            other_path = resolved[coordinate_key]
        })
        return
    end
    resolved[coordinate_key] = path
end

local function append_unique(target, seen, section, kind, community)
    if type(section) == "string" and section ~= "" and not seen[section] then
        seen[section] = true
        target[#target + 1] = { section = section, kind = kind, community = community }
    end
end

local function ordered_sections(catalogs)
    local result, seen = {}, {}
    for _, profile in ipairs(catalogs.profile_list or {}) do append_unique(result, seen, profile.section, "profile", profile.community or "bandit") end
    for _, weapon in ipairs(catalogs.weapon_list or {}) do append_unique(result, seen, weapon.section, "weapon") end
    local ammo = {}
    for _, item in pairs(catalogs.ammo or {}) do ammo[#ammo + 1] = item.section end
    table.sort(ammo)
    for _, section in ipairs(ammo) do append_unique(result, seen, section, "ammo") end
    for _, outfit in ipairs(catalogs.outfit_list or {}) do append_unique(result, seen, outfit.section, "equipped") end
    for _, knife in ipairs(catalogs.knife_list or {}) do append_unique(result, seen, knife.section, "equipped") end
    local consumables = {}
    for _, item in pairs(catalogs.consumables or {}) do consumables[#consumables + 1] = item.section end
    table.sort(consumables)
    for _, section in ipairs(consumables) do append_unique(result, seen, section, "item") end
    return result
end

local function validate_ammo_box_size(system, section, accessors, errors)
    if type(accessors.line_exist) ~= "function" or type(accessors.r_u32) ~= "function" then
        add_error(errors, "GA_AMMO_BOX_SIZE_API_MISSING", "Effective ammo box_size lookup is unavailable", { section = section })
        return
    end
    local present_ok, present = safe_call(accessors.line_exist, system, section, "box_size")
    if not present_ok or present ~= true then
        add_error(errors, present_ok and "GA_AMMO_BOX_SIZE_MISSING" or "GA_AMMO_BOX_SIZE_READ_FAILED", "Effective ammo box_size is unavailable", { section = section })
        return
    end
    local read_ok, value = safe_call(accessors.r_u32, system, section, "box_size")
    if not read_ok then
        add_error(errors, "GA_AMMO_BOX_SIZE_READ_FAILED", "Effective ammo box_size could not be read", { section = section, reason = tostring(value) })
    elseif not finite_integer(value) or value < 1 or value >= 4294967296 then
        add_error(errors, "GA_AMMO_BOX_SIZE_INVALID", "Effective ammo box_size must be a positive bounded integer", { section = section, value = value })
    end
end

local function validate_item_u32(system, section, key, minimum, code, accessors, errors)
    if type(accessors.line_exist) ~= "function" or type(accessors.r_u32) ~= "function" then
        add_error(errors, code .. "_API_MISSING", "Effective item metadata lookup is unavailable", { section = section, key = key })
        return
    end
    local present_ok, present = safe_call(accessors.line_exist, system, section, key)
    if not present_ok or present ~= true then
        add_error(errors, present_ok and (code .. "_MISSING") or (code .. "_READ_FAILED"), "Effective item metadata is unavailable", { section = section, key = key })
        return
    end
    local read_ok, value = safe_call(accessors.r_u32, system, section, key)
    if not read_ok or not finite_integer(value) or value < minimum or value >= 4294967296 then
        add_error(errors, read_ok and (code .. "_INVALID") or (code .. "_READ_FAILED"), "Effective item metadata is invalid", { section = section, key = key, value = value })
    end
end

local function normalized_community(value)
    if type(value) ~= "string" then return nil end
    return string.lower((string.gsub(value, "^%s*(.-)%s*$", "%1")))
end

local profile_error_codes = {
    class = {
        api = "GA_NPC_CLASS_API_MISSING",
        missing = "GA_NPC_CLASS_MISSING",
        read = "GA_NPC_CLASS_READ_FAILED",
        invalid = "GA_NPC_CLASS_INVALID"
    },
    community = {
        api = "GA_NPC_COMMUNITY_API_MISSING",
        missing = "GA_NPC_COMMUNITY_MISSING",
        read = "GA_NPC_COMMUNITY_READ_FAILED",
        invalid = "GA_NPC_COMMUNITY_INVALID"
    }
}

local function validate_profile_value(system, section, key, expected, codes, normalize, accessors, errors)
    if type(accessors.line_exist) ~= "function" then
        add_error(errors, codes.api, "Effective NPC profile line lookup is unavailable", {
            section = section,
            key = key,
            capability = "system_ini.line_exist"
        })
        return
    end
    if type(accessors.r_string_ex) ~= "function" then
        add_error(errors, codes.api, "Effective NPC profile value reader is unavailable", {
            section = section,
            key = key,
            capability = "system_ini.r_string_ex"
        })
        return
    end
    local present_ok, present = safe_call(accessors.line_exist, system, section, key)
    if not present_ok then
        add_error(errors, codes.read, "Effective NPC profile line lookup failed", {
            section = section,
            key = key,
            stage = "line_exist",
            reason = tostring(present)
        })
        return
    end
    if present ~= true then
        add_error(errors, codes.missing, "Effective NPC profile value is missing", { section = section, key = key })
        return
    end
    local read_ok, value = safe_call(accessors.r_string_ex, system, section, key)
    if not read_ok then
        add_error(errors, codes.read, "Effective NPC profile value read failed", {
            section = section,
            key = key,
            stage = "r_string_ex",
            reason = tostring(value)
        })
        return
    end
    local effective = normalize and normalize(value) or value
    if effective == nil or effective == "" then
        add_error(errors, codes.missing, "Effective NPC profile value is missing", { section = section, key = key })
    elseif effective ~= expected then
        add_error(errors, codes.invalid, "Effective NPC profile value is incompatible", {
            section = section,
            key = key,
            value = value,
            expected = expected
        })
    end
end

local function validate_sections(system, catalogs, errors)
    local methods_ok, section_exist, r_string_ex, line_exist, r_u32 = pcall(function()
        return system.section_exist, system.r_string_ex, system.line_exist, system.r_u32
    end)
    if not methods_ok or type(section_exist) ~= "function" then
        add_error(errors, "GA_PREFLIGHT_SYSTEM_INI_INVALID", "Effective system_ini lacks a section accessor")
        return
    end
    local accessors = { r_string_ex = r_string_ex, line_exist = line_exist, r_u32 = r_u32 }
    for _, entry in ipairs(ordered_sections(catalogs)) do
        local exists_ok, exists = safe_call(section_exist, system, entry.section)
        if not exists_ok or exists ~= true then
            add_error(errors, "GA_PREFLIGHT_SECTION_MISSING", "Catalog section is missing from effective system.ini", {
                section = entry.section,
                kind = entry.kind
            })
        elseif entry.kind == "profile" then
            validate_profile_value(system, entry.section, "class", "AI_STL_S", profile_error_codes.class, nil, accessors, errors)
            validate_profile_value(system, entry.section, "community", entry.community or "bandit", profile_error_codes.community, normalized_community, accessors, errors)
        elseif entry.kind == "ammo" then
            validate_ammo_box_size(system, entry.section, accessors, errors)
        elseif entry.kind == "weapon" then
            validate_item_u32(system, entry.section, "slot", 0, "GA_ACTOR_LOADOUT_SLOT", accessors, errors)
            validate_item_u32(system, entry.section, "ammo_mag_size", 1, "GA_ACTOR_LOADOUT_MAGAZINE", accessors, errors)
        elseif entry.kind == "equipped" then
            validate_item_u32(system, entry.section, "slot", 0, "GA_ACTOR_LOADOUT_SLOT", accessors, errors)
        end
    end
end

local function preflight_impl(probes)
    if type(probes) ~= "table" then
        return gamma_arena_result.err("GA_PREFLIGHT_PROBES_INVALID", "Preflight probes must be a table")
    end
    local errors = {}
    for _, capability in ipairs(required_capabilities) do
        local ok, present = pcall(capability.present, probes)
        if not ok or not present then
            add_error(errors, "GA_PREFLIGHT_API_MISSING", "Required runtime capability is unavailable", { capability = capability.name })
        end
    end
    for _, capability in ipairs(tactical_capabilities) do
        local ok, present = pcall(capability.present, probes)
        if not ok or not present then
            add_error(errors, "GA_PREFLIGHT_DIRECTOR_API_MISSING", "Required tactical director capability is unavailable", { capability = capability.name })
        end
    end

    local config = type(probes.axr_main) == "table" and probes.axr_main.config or nil
    if config ~= nil then
        for _, method_name in ipairs(config_methods) do
            local ok, method = pcall(function() return config[method_name] end)
            if not ok or type(method) ~= "function" then
                add_error(errors, "GA_PREFLIGHT_API_MISSING", "Arena config adapter lacks a required method", {
                    capability = "axr_main.config." .. method_name
                })
            end
        end
    end

    if type(probes.alife) == "function" then
        local ok, server = safe_call(probes.alife)
        if not ok or server == nil then add_error(errors, "GA_PREFLIGHT_ALIFE_UNAVAILABLE", "ALife simulator is unavailable") end
    end

    local system = nil
    if type(probes.system_ini) == "function" then
        local ok, value = safe_call(probes.system_ini)
        if ok and value ~= nil then
            system = value
        else
            add_error(errors, "GA_PREFLIGHT_SYSTEM_INI_INVALID", "Effective system_ini is unavailable")
        end
    end

    local catalogs = probes.catalogs
    local layout = type(catalogs) == "table" and type(catalogs.layouts) == "table" and catalogs.layouts.rostok_arena_v1 or nil
    if type(layout) ~= "table" then
        add_error(errors, "GA_PREFLIGHT_CATALOG_INVALID", "Validated v1 catalogs and layout are unavailable")
    end

    local current_level = nil
    if type(probes.level) == "table" and type(probes.level.name) == "function" then
        local ok, value = safe_call(probes.level.name)
        if ok then current_level = value end
    end
    local level_is_valid = current_level == "l05_bar" and layout ~= nil and layout.level == "l05_bar"
    if not level_is_valid then
        add_error(errors, "GA_PREFLIGHT_LEVEL_INVALID", "Arena activation requires l05_bar", {
            expected = "l05_bar",
            actual = current_level
        })
    end

    if level_is_valid and type(probes.level.patrol_path_exists) == "function" and engine_callable_present(probes.patrol) then
        local paths = { layout.actor_spawn_path, layout.actor_look_path }
        for _, path in ipairs(layout.opponent_spawn_paths or {}) do paths[#paths + 1] = path end
        local resolved = {}
        for _, path in ipairs(paths) do resolve_path(probes, path, errors, resolved) end
    end

    validate_tactical_director(probes, layout, level_is_valid, errors)

    if system ~= nil and type(catalogs) == "table" then validate_sections(system, catalogs, errors) end
    if #errors > 0 then
        return gamma_arena_result.err("GA_PREFLIGHT_FAILED", "Arena runtime preflight failed", { errors = errors })
    end
    return gamma_arena_result.ok(true)
end

function preflight(probes)
    local succeeded, result = pcall(preflight_impl, probes)
    if succeeded and type(result) == "table" and type(result.ok) == "boolean" then return result end
    return gamma_arena_result.err("GA_PREFLIGHT_FAILED", "Arena runtime preflight failed safely", {
        errors = { { code = "GA_PREFLIGHT_INTERNAL", message = "Preflight probe raised an exception", context = { reason = tostring(result) } } }
    })
end
