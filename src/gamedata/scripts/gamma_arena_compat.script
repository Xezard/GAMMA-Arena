    { name = "alife_create_item", present = function(p) return type(p.alife_create_item) == "function" end },
    { name = "alife_release_id", present = function(p) return type(p.alife_release_id) == "function" end },
    { name = "time_global", present = function(p) return type(p.time_global) == "function" end },
    { name = "se_save_var", present = function(p) return type(p.se_save_var) == "function" end },
    { name = "se_load_var", present = function(p) return type(p.se_load_var) == "function" end },
    { name = "level.patrol_path_exists", present = function(p) return type(p.level) == "table" and type(p.level.patrol_path_exists) == "function" end },
    { name = "level.object_by_id", present = function(p) return type(p.level) == "table" and type(p.level.object_by_id) == "function" end },
    { name = "level.disable_input", present = function(p) return type(p.level) == "table" and type(p.level.disable_input) == "function" end },
    { name = "level.enable_input", present = function(p) return type(p.level) == "table" and type(p.level.enable_input) == "function" end },
    { name = "patrol", present = function(p) return engine_callable_present(p.patrol) end },
    { name = "db.actor", present = function(p) return type(p.db) == "table" and p.db.actor ~= nil end },
    { name = "db.actor.iterate_inventory", present = function(p) return type(p.db) == "table" and method_present(p.db.actor, "iterate_inventory") end },
    { name = "db.actor.id", present = function(p) return type(p.db) == "table" and method_present(p.db.actor, "id") end },
