    { name = "db.actor.give_money", present = function(p) return type(p.db) == "table" and method_present(p.db.actor, "give_money") end },
    { name = "db.actor.set_health_ex/set_health", present = function(p) return type(p.db) == "table" and (method_present(p.db.actor, "set_health_ex") or method_present(p.db.actor, "set_health")) end },
    { name = "db.actor.power", present = function(p) return type(p.db) == "table" and field_present(p.db.actor, "power") end },
    { name = "db.actor.radiation", present = function(p) return type(p.db) == "table" and field_present(p.db.actor, "radiation") end },
