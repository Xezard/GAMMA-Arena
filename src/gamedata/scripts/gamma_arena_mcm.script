local values = {
    commentator = true,
    crowd_reactions = true
}

local callback_registered = false

local function read_boolean(path, reader)
    local selected_reader = reader
    if type(selected_reader) ~= "function" then
        if type(ui_mcm) ~= "table" or type(ui_mcm.get) ~= "function" then
            return true
        end
        selected_reader = ui_mcm.get
    end
    local called, value = pcall(selected_reader, path)
    if not called or type(value) ~= "boolean" then
        return true
    end
    return value
end

function refresh(reader)
    values.commentator = read_boolean("gamma_arena/commentator", reader)
    values.crowd_reactions = read_boolean("gamma_arena/crowd_reactions", reader)
    return snapshot(false)
end

function snapshot(should_refresh)
    if should_refresh ~= false then
        refresh()
    end
    return {
        commentator = values.commentator,
        crowd_reactions = values.crowd_reactions
    }
end

function on_option_change()
    refresh()
end

function on_game_start()
    if not callback_registered and type(RegisterScriptCallback) == "function" then
        RegisterScriptCallback("on_option_change", on_option_change)
        callback_registered = true
    end
    refresh()
end

function on_mcm_load()
    return {
        id = "gamma_arena",
        sh = true,
        gr = {
            {
                id = "title",
                type = "slide",
                link = "ui_options_slider_player",
                text = "ui_mcm_gamma_arena_title",
                size = { 512, 50 },
                spacing = 20
            },
            { id = "commentator", type = "check", val = 1, def = true },
            { id = "crowd_reactions", type = "check", val = 1, def = true }
        }
    }
end
