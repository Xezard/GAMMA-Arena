local function is_target_path(xml_file_name)
    if type(xml_file_name) ~= "string" then return false end
    local normalized = string.lower(string.gsub(xml_file_name, "/", "\\"))
    return normalized == "ui\\ui_mm_main.xml"
        or normalized == "ui\\ui_mm_main_16.xml"
end

local function apply_impl(xml_file_name, xml_obj)
    if not is_target_path(xml_file_name) then
        return gamma_arena_result.ok(false)
    end
    if xml_obj == nil or type(xml_obj.query) ~= "function" or type(xml_obj.insertFromXMLString) ~= "function" then
        return gamma_arena_result.err("GA_DXML_API_UNAVAILABLE", "DXML object does not expose the required API")
    end
    if type(xml_obj.getElementPosition) ~= "function" then
        return gamma_arena_result.err("GA_DXML_POSITION_API_UNAVAILABLE", "DXML object does not expose element positioning")
    end

    local existing = xml_obj:query("menu_main btn[name=btn_gamma_arena]")
    if existing and #existing > 0 then
        return gamma_arena_result.ok(false)
    end
    local menu = xml_obj:query("menu_main")
    if not menu or #menu == 0 then
        return gamma_arena_result.err("GA_DXML_MENU_MISSING", "Effective main menu does not expose menu_main")
    end
    local new_game = xml_obj:query("menu_main > btn[name=btn_newgame]")
    if not new_game or #new_game == 0 then
        return gamma_arena_result.err("GA_DXML_NEW_GAME_MISSING", "Effective main menu does not expose btn_newgame")
    end
    if new_game[1].parent ~= menu[1] then
        return gamma_arena_result.err("GA_DXML_NEW_GAME_PARENT_MISMATCH", "New Game is not a direct child of menu_main")
    end
    local new_game_position = xml_obj:getElementPosition(new_game[1])
    if type(new_game_position) ~= "number" or new_game_position < 1 or new_game_position % 1 ~= 0 then
        return gamma_arena_result.err("GA_DXML_NEW_GAME_POSITION_INVALID", "New Game position is invalid")
    end
    xml_obj:insertFromXMLString(
        [[<btn name="btn_gamma_arena" caption="st_gamma_arena_main_menu" />]],
        menu[1], new_game_position + 1)
    return gamma_arena_result.ok(true)
end

local function log_failure(result)
    if not result or result.ok then
        return
    end
    local logger_ok, logger = pcall(function()
        return gamma_arena_log and gamma_arena_log.error
    end)
    if logger_ok and type(logger) == "function" then
        pcall(logger, result.error.code, result.error.message, result.error.context)
    end
end

function apply(xml_file_name, xml_obj)
    local ok, result = pcall(apply_impl, xml_file_name, xml_obj)
    if not ok then
        result = gamma_arena_result.err("GA_DXML_INSERT_FAILED", "Arena main-menu button could not be inserted", { detail = tostring(result) })
    end
    log_failure(result)
    return result
end

local function register_impl(registrar)
    if type(registrar) ~= "function" then
        return gamma_arena_result.err("GA_DXML_REGISTRAR_UNAVAILABLE", "Script callback registrar is unavailable")
    end
    registrar("on_xml_read", apply)
    registrar("main_menu_on_init", gamma_arena_main_menu.on_main_menu_init)
    return gamma_arena_result.ok(true)
end

function register(registrar)
    local ok, result = pcall(register_impl, registrar)
    if not ok then
        result = gamma_arena_result.err(
            "GA_DXML_REGISTER_FAILED",
            "Arena menu callbacks could not be registered",
            { detail = tostring(result) })
    end
    log_failure(result)
    return result
end

function on_xml_read()
    return register(RegisterScriptCallback)
end
