local CATEGORY_IDS = { "weapon", "ammo", "outfit", "helmet", "knife", "medicine", "grenade" }
local DEVICE_SECTIONS = {
    "device_torch_dummy", "device_torch_nv_1", "device_torch_nv_2", "device_torch_nv_3"
}
local EQUIPMENT_SLOT = { outfit = "outfit", helmet = "helmet", knife = "knife" }
local Model = {}
Model.__index = Model

local function failure(code, message, context)
    return gamma_arena_result.err(code, message, context or {})
end

local function finite_integer(value, minimum)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
        and value == math.floor(value) and value >= (minimum or 0) and value <= 9007199254740991
end

local function finite_positive(value)
    return finite_integer(value, 1)
end

local function deep_copy(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then return nil end
    seen[value] = true
    local copied = {}
    for key, child in pairs(value) do copied[deep_copy(key, seen)] = deep_copy(child, seen) end
    seen[value] = nil
    return copied
end

local function copy_config(value)
    local copied = {
        schema_version = 1,
        faction = value.faction,
        roster = {},
        actor_items = {},
        actor_device = value.actor_device,
        catalog_fingerprint = value.catalog_fingerprint
    }
    for index, row in ipairs(value.roster or {}) do copied.roster[index] = { rank = row.rank } end
    for index, entry in ipairs(value.actor_items or {}) do
        copied.actor_items[index] = {
            section = entry.section,
            quantity = entry.quantity,
            equipped_slot = entry.equipped_slot
        }
        if entry.equipped_slot == nil then copied.actor_items[index].equipped_slot = nil end
    end
    return copied
end

local function selected_index(config, section)
    for index, entry in ipairs(config.actor_items) do
        if entry.section == section then return index, entry end
    end
    return nil, nil
end

local function physical_count(config)
    local total = config.actor_device and 1 or 0
    for _, entry in ipairs(config.actor_items) do total = total + (tonumber(entry.quantity) or 0) end
    return total
end

local function category_count(config, catalog, category)
    local total = 0
    for _, entry in ipairs(config.actor_items) do
        local definition = catalog.items and catalog.items[entry.section]
        if definition and definition.category == category then total = total + 1 end
    end
    return total
end

local function expected_slot(definition)
    if definition.category == "weapon" then
        if definition.ltx_slot == 1 then return "weapon_1" end
        if definition.ltx_slot == 2 then return "weapon_2" end
        return nil
    end
    return EQUIPMENT_SLOT[definition.category]
end

local function reject(self, result)
    self.last_operation = deep_copy(result)
    return result
end

local function refresh_derived(self)
    self.current_budget = gamma_arena_custom_config.budget(self.draft.roster, self.catalog)
    self.current_totals = gamma_arena_custom_config.totals(self.draft, self.catalog)
end

local function accept_candidate(self, candidate, validated)
    self.draft = candidate
    self.current_validation = validated
    refresh_derived(self)
    local result = gamma_arena_result.ok({ validation = deep_copy(validated) })
    self.last_operation = deep_copy(result)
    return result
end

local function commit(self, candidate)
    local validated = gamma_arena_custom_config.validate(candidate, { catalog = self.catalog, layout = self.layout })
    local accepted = gamma_arena_custom_config.validate_draft(candidate, { catalog = self.catalog, layout = self.layout })
    if not accepted.ok then return reject(self, accepted) end
    return accept_candidate(self, candidate, validated)
end

local function commit_allowing_incomplete_budget(self, candidate, allow_overweight)
    local validated = gamma_arena_custom_config.validate(candidate, {
        catalog = self.catalog, layout = self.layout
    })
    local accepted = gamma_arena_custom_config.validate_draft(candidate, {
        catalog = self.catalog, layout = self.layout
    })
    local code = not accepted.ok and accepted.error and accepted.error.code or nil
    if not accepted.ok and code ~= "GA_CUSTOM_OVERSPEND"
        and not (allow_overweight and code == "GA_CUSTOM_OVERWEIGHT") then
        return reject(self, accepted)
    end
    return accept_candidate(self, candidate, validated)
end

local function item_definition(self, section)
    if type(section) ~= "string" or section == "" or #section > 256
        or type(self.catalog) ~= "table" or type(self.catalog.items) ~= "table"
        or type(self.catalog.items[section]) ~= "table" then
        return nil, failure("GA_CUSTOM_ITEM_UNKNOWN", "Custom item section is unknown", { section = section })
    end
    local definition = self.catalog.items[section]
    if not finite_positive(definition.price) then
        return nil, failure("GA_CUSTOM_ITEM_UNAVAILABLE", "Custom item has no positive Arena price", {
            section = section
        })
    end
    return definition, nil
end

local function add_one_candidate(self, section)
    local definition, item_error = item_definition(self, section)
    if item_error then return item_error end
    if definition.category == "device" then
        return failure("GA_CUSTOM_DEVICE_IN_ITEMS", "Custom devices require set_device", {
            section = section
        })
    end

    local candidate = copy_config(self.draft)
    local index, entry = selected_index(candidate, section)
    if index ~= nil then
        if not finite_positive(entry.quantity) or entry.quantity >= 9007199254740991 then
            return failure("GA_CUSTOM_QUANTITY_INVALID", "Custom item quantity exceeds the safe integer range", {
                section = section, quantity = entry.quantity
            })
        end
        candidate.actor_items[index].quantity = entry.quantity + 1
    else
        local slot = expected_slot(definition)
        local fixed = definition.category == "outfit" or definition.category == "helmet"
            or definition.category == "knife"
        local occupied = false
        if slot ~= nil then
            for _, selected in ipairs(candidate.actor_items) do
                if selected.equipped_slot == slot then occupied = true; break end
            end
        end
        candidate.actor_items[#candidate.actor_items + 1] = {
            section = section,
            quantity = 1,
            equipped_slot = fixed and slot
                or (definition.category == "weapon" and not occupied and slot or nil)
        }
    end

    local accepted = gamma_arena_custom_config.validate_draft(candidate, {
        catalog = self.catalog, layout = self.layout
    })
    if not accepted.ok then return accepted end
    return gamma_arena_result.ok(candidate)
end

function Model:preview_add_one(section)
    local built = add_one_candidate(self, section)
    if not built.ok then return built end
    local full = gamma_arena_custom_config.validate(built.value, {
        catalog = self.catalog, layout = self.layout
    })
    local _, entry = selected_index(built.value, section)
    return gamma_arena_result.ok({
        selected_quantity = entry and entry.quantity or 0,
        equipped_slot = entry and entry.equipped_slot or nil,
        validation = full
    })
end

function Model:add_one(section)
    local built = add_one_candidate(self, section)
    if not built.ok then return reject(self, built) end
    return commit(self, built.value)
end

function Model:remove_one(section)
    local index, entry = selected_index(self.draft, section)
    if index == nil then
        return reject(self, failure("GA_CUSTOM_ITEM_NOT_SELECTED",
            "Custom item is not selected", { section = section }))
    end
    local candidate = copy_config(self.draft)
    if entry.quantity == 1 then
        table.remove(candidate.actor_items, index)
    else
        candidate.actor_items[index].quantity = entry.quantity - 1
    end
    return commit_allowing_incomplete_budget(self, candidate, true)
end

function Model:equip_replacing(section)
    local index, entry = selected_index(self.draft, section)
    local definition = index and self.catalog.items and self.catalog.items[section] or nil
    local slot = definition and expected_slot(definition) or nil
    if index == nil or type(definition) ~= "table" or definition.category ~= "weapon"
        or slot == nil or entry.quantity ~= 1 then
        return reject(self, failure("GA_CUSTOM_SLOT_INVALID",
            "Selected Custom firearm cannot occupy a weapon slot", { section = section }))
    end

    local candidate = copy_config(self.draft)
    local replaced = nil
    for other_index, other in ipairs(candidate.actor_items) do
        if other_index ~= index and other.equipped_slot == slot then
            replaced = other.section
            other.equipped_slot = nil
        end
    end
    candidate.actor_items[index].equipped_slot = slot
    local committed = commit(self, candidate)
    if committed.ok then committed.value.replaced_section = replaced end
    return committed
end

function Model:set_faction(faction)
    if type(faction) ~= "string" or faction == "" or type(self.catalog.factions) ~= "table"
        or type(self.catalog.factions[faction]) ~= "table" then
        return reject(self, failure("GA_CUSTOM_FACTION_UNKNOWN", "Custom faction is unknown", { faction = faction }))
    end
    local ranks = self.catalog.factions[faction].ranks
    for index, row in ipairs(self.draft.roster) do
        if type(ranks) ~= "table" or type(ranks[row.rank]) ~= "table" then
            return reject(self, failure("GA_CUSTOM_RANK_UNKNOWN", "Custom rank is unavailable for the selected faction", {
                faction = faction, index = index, rank = row.rank
            }))
        end
    end
    local candidate = copy_config(self.draft)
    candidate.faction = faction
    return commit(self, candidate)
end

function Model:set_count(count)
    local capacity = type(self.layout) == "table" and self.layout.virtual_capacity or nil
    if not finite_integer(count, 1) or not finite_integer(capacity, 1) or count > capacity then
        return reject(self, failure("GA_CUSTOM_ROSTER_LIMIT", "Custom roster exceeds the active layout capacity", {
            count = count, capacity = capacity
        }))
    end
    local candidate = copy_config(self.draft)
    while #candidate.roster > count do table.remove(candidate.roster) end
    while #candidate.roster < count do candidate.roster[#candidate.roster + 1] = { rank = "novice" } end
    return commit_allowing_incomplete_budget(self, candidate, false)
end

function Model:set_rank(index, rank)
    if not finite_integer(index, 1) or index > #self.draft.roster then
        return reject(self, failure("GA_CUSTOM_ROSTER_LIMIT", "Custom roster row is not visible", { index = index }))
    end
    if type(rank) ~= "string" or rank == "" or type(self.catalog.ranks) ~= "table"
        or type(self.catalog.ranks[rank]) ~= "table" then
        return reject(self, failure("GA_CUSTOM_RANK_UNKNOWN", "Custom roster rank is unknown", { index = index, rank = rank }))
    end
    if self.draft.faction ~= nil then
        local faction = type(self.catalog.factions) == "table" and self.catalog.factions[self.draft.faction] or nil
        if type(faction) ~= "table" or type(faction.ranks) ~= "table" or type(faction.ranks[rank]) ~= "table" then
            return reject(self, failure("GA_CUSTOM_RANK_UNKNOWN", "Custom rank is unavailable for the selected faction", {
                index = index, rank = rank, faction = self.draft.faction
            }))
        end
    end
    local candidate = copy_config(self.draft)
    candidate.roster[index].rank = rank
    return commit_allowing_incomplete_budget(self, candidate, false)
end

function Model:set_device(section)
    if section ~= nil then
        local definition = type(section) == "string" and self.catalog.items
            and self.catalog.items[section] or nil
        if type(definition) ~= "table" or definition.category ~= "device" then
            return reject(self, failure("GA_CUSTOM_DEVICE_UNKNOWN", "Custom actor device is unavailable", {
                section = section
            }))
        end
    end
    local candidate = copy_config(self.draft)
    candidate.actor_device = section
    return commit(self, candidate)
end

function Model:add_item(section, quantity, equipped_slot)
    local definition, item_error = item_definition(self, section)
    if item_error then return reject(self, item_error) end
    if definition.category == "device" then
        return reject(self, failure("GA_CUSTOM_DEVICE_IN_ITEMS", "Custom devices require set_device", {
            section = section
        }))
    end
    if selected_index(self.draft, section) ~= nil then
        return reject(self, failure("GA_CUSTOM_ITEM_DUPLICATE", "Custom item sections must be distinct", { section = section }))
    end
    quantity = quantity == nil and 1 or quantity
    if not finite_integer(quantity, 1) then
        return reject(self, failure("GA_CUSTOM_QUANTITY_INVALID", "Custom item quantity must be a positive integer", { section = section }))
    end
    if not finite_integer(self.catalog.max_entries, 1) or #self.draft.actor_items + 1 > self.catalog.max_entries then
        return reject(self, failure("GA_CUSTOM_ENTRY_LIMIT", "Custom actor inventory has too many distinct entries", {
            count = #self.draft.actor_items + 1, limit = self.catalog.max_entries
        }))
    end
    if not finite_integer(self.catalog.max_physical_items_per_participant, 1)
        or physical_count(self.draft) + quantity > self.catalog.max_physical_items_per_participant then
        return reject(self, failure("GA_CUSTOM_PHYSICAL_LIMIT", "Custom actor inventory exceeds the physical item cap", {
            count = physical_count(self.draft) + quantity, limit = self.catalog.max_physical_items_per_participant
        }))
    end
    local category = definition.category
    if category == "grenade" then
        if quantity ~= self.catalog.max_quantity_per_grenade
            or category_count(self.draft, self.catalog, "grenade") >= self.catalog.max_selected_grenades then
            return reject(self, failure("GA_CUSTOM_GRENADE_LIMIT", "Custom grenade selection is invalid", { section = section }))
        end
    elseif (category == "outfit" or category == "helmet" or category == "knife") and quantity ~= 1 then
        return reject(self, failure("GA_CUSTOM_EQUIPMENT_QUANTITY", "Equipped physical items require quantity one", {
            section = section, quantity = quantity
        }))
    elseif category == "outfit" and category_count(self.draft, self.catalog, category) >= 1 then
        return reject(self, failure("GA_CUSTOM_OUTFIT_REQUIRED", "Custom loadout supports exactly one outfit", { section = section }))
    elseif category == "helmet" and category_count(self.draft, self.catalog, category) >= 1 then
        return reject(self, failure("GA_CUSTOM_HELMET_LIMIT", "Custom loadout supports at most one helmet", { section = section }))
    elseif category == "knife" and category_count(self.draft, self.catalog, category) >= 1 then
        return reject(self, failure("GA_CUSTOM_KNIFE_REQUIRED", "Custom loadout supports exactly one knife", { section = section }))
    end
    if (category == "outfit" or category == "helmet" or category == "knife") and equipped_slot == nil then
        return reject(self, failure("GA_CUSTOM_SLOT_INVALID", "Custom equipment must be selected into its logical slot", {
            section = section, slot = equipped_slot
        }))
    end
    if equipped_slot ~= nil then
        local expected = expected_slot(definition)
        if expected == nil or equipped_slot ~= expected or quantity ~= 1 then
            return reject(self, failure("GA_CUSTOM_SLOT_INVALID", "Custom equipment must use its effective logical slot", {
                section = section, slot = equipped_slot
            }))
        end
        for _, entry in ipairs(self.draft.actor_items) do
            if entry.equipped_slot == equipped_slot then
                return reject(self, failure("GA_CUSTOM_SLOT_DUPLICATE", "Custom equipment slot is already occupied", { slot = equipped_slot }))
            end
        end
    end
    local candidate = copy_config(self.draft)
    candidate.actor_items[#candidate.actor_items + 1] = {
        section = section, quantity = quantity, equipped_slot = equipped_slot
    }
    if equipped_slot == nil then candidate.actor_items[#candidate.actor_items].equipped_slot = nil end
    return commit(self, candidate)
end

function Model:increment_item(section)
    local index, entry = selected_index(self.draft, section)
    if index == nil then
        return reject(self, failure("GA_CUSTOM_ITEM_NOT_SELECTED", "Custom item is not selected", { section = section }))
    end
    local quantity = entry.quantity + 1
    if not finite_integer(quantity, 1) or quantity <= entry.quantity then
        return reject(self, failure("GA_CUSTOM_QUANTITY_INVALID", "Custom item quantity exceeds the safe integer range", {
            section = section, quantity = quantity
        }))
    end
    local candidate = copy_config(self.draft)
    candidate.actor_items[index].quantity = quantity
    return commit(self, candidate)
end

function Model:decrement_item(section)
    local index, entry = selected_index(self.draft, section)
    if index == nil then
        return reject(self, failure("GA_CUSTOM_ITEM_NOT_SELECTED", "Custom item is not selected", { section = section }))
    end
    if entry.quantity == 1 then return self:remove_item(section) end
    local candidate = copy_config(self.draft)
    candidate.actor_items[index].quantity = entry.quantity - 1
    return commit(self, candidate)
end

function Model:remove_item(section)
    local index = selected_index(self.draft, section)
    if index == nil then
        return reject(self, failure("GA_CUSTOM_ITEM_NOT_SELECTED", "Custom item is not selected", { section = section }))
    end
    local candidate = copy_config(self.draft)
    table.remove(candidate.actor_items, index)
    return commit(self, candidate)
end

function Model:equip(section, slot)
    local index, entry = selected_index(self.draft, section)
    if index == nil then
        return reject(self, failure("GA_CUSTOM_ITEM_NOT_SELECTED", "Custom item is not selected", { section = section }))
    end
    local definition = self.catalog.items[section]
    local expected = expected_slot(definition)
    if expected == nil or slot ~= expected then
        return reject(self, failure("GA_CUSTOM_SLOT_INVALID", "Custom equipment must use its effective logical slot", {
            section = section, slot = slot
        }))
    end
    if entry.quantity ~= 1 then
        return reject(self, failure("GA_CUSTOM_EQUIPMENT_QUANTITY", "Equipped physical items require quantity one", {
            section = section, quantity = entry.quantity
        }))
    end
    for other_index, other in ipairs(self.draft.actor_items) do
        if other_index ~= index and other.equipped_slot == slot then
            return reject(self, failure("GA_CUSTOM_SLOT_DUPLICATE", "Custom equipment slot is already occupied", { slot = slot }))
        end
    end
    local candidate = copy_config(self.draft)
    candidate.actor_items[index].equipped_slot = slot
    return commit(self, candidate)
end

function Model:unequip(section)
    local index, entry = selected_index(self.draft, section)
    if index == nil then
        return reject(self, failure("GA_CUSTOM_ITEM_NOT_SELECTED", "Custom item is not selected", { section = section }))
    end
    if entry.equipped_slot == nil then
        return reject(self, failure("GA_CUSTOM_SLOT_INVALID", "Custom item is not equipped", { section = section }))
    end
    local candidate = copy_config(self.draft)
    candidate.actor_items[index].equipped_slot = nil
    return commit(self, candidate)
end

function Model:validation()
    self.current_validation = gamma_arena_custom_config.validate(self.draft, { catalog = self.catalog, layout = self.layout })
    return deep_copy(self.current_validation)
end

local function sorted_category_sections(catalog, category)
    local sections = {}
    local declared = type(catalog.categories) == "table" and catalog.categories[category] or nil
    if type(declared) == "table" then
        for _, section in ipairs(declared) do
            local definition = catalog.items[section]
            if type(definition) == "table" and definition.category == category
                and finite_positive(definition.price) then
                sections[#sections + 1] = section
            end
        end
    else
        for section, definition in pairs(catalog.items or {}) do
            if type(definition) == "table" and definition.category == category
                and finite_positive(definition.price) then sections[#sections + 1] = section end
        end
        table.sort(sections)
    end
    return sections
end

local function projected_device_options(self)
    local device_options = {
        {
            section = nil,
            category = "device",
            price = 0,
            weight_mg = 0,
            selected = self.draft.actor_device == nil,
            affordable = true,
            disabled = false,
            disabled_reason = nil
        }
    }
    for _, section in ipairs(DEVICE_SECTIONS) do
        local definition = self.catalog.items and self.catalog.items[section] or {}
        local candidate = copy_config(self.draft)
        candidate.actor_device = section
        local accepted = gamma_arena_custom_config.validate_draft(candidate, {
            catalog = self.catalog, layout = self.layout
        })
        device_options[#device_options + 1] = {
            section = section,
            category = "device",
            name_key = definition.name_key,
            price = definition.price,
            weight_mg = definition.weight_mg,
            selected = self.draft.actor_device == section,
            affordable = accepted.ok == true,
            disabled = accepted.ok ~= true,
            disabled_reason = accepted.ok and nil or (accepted.error and accepted.error.code or "GA_CUSTOM_INVALID")
        }
    end
    return device_options
end

local function derived_values(self)
    local totals = self.current_totals
    local budget = self.current_budget
    return budget and budget.ok and budget.value or 0,
        totals and totals.ok and totals.value or {
            points = 0, weight_mg = 0, weight_limit_mg = self.catalog.base_carry_weight or 0
        }
end

function Model:status_snapshot()
    local budget, totals = derived_values(self)
    local validated = deep_copy(self.current_validation)
    return {
        faction = self.draft.faction,
        roster = deep_copy(self.draft.roster),
        count = #self.draft.roster,
        capacity = self.layout and self.layout.virtual_capacity or 0,
        actor_device = self.draft.actor_device,
        device_options = projected_device_options(self),
        budget = budget,
        spent = totals.points,
        remaining = budget - totals.points,
        weight_mg = totals.weight_mg,
        weight_limit_mg = totals.weight_limit_mg,
        validation = validated,
        can_start = validated.ok == true,
        last_operation = deep_copy(self.last_operation)
    }
end

function Model:snapshot()
    local validated = deep_copy(self.current_validation)
    local budget, totals = derived_values(self)
    local selected, selected_map, selected_grenades = {}, {}, {}
    local grenade_index = 0
    for index, entry in ipairs(self.draft.actor_items) do
        local definition = self.catalog.items and self.catalog.items[entry.section] or {}
        local multiplier = 1
        if definition.category == "grenade" then
            grenade_index = grenade_index + 1
            if grenade_index == 2 then multiplier = self.catalog.second_grenade_price_multiplier end
        end
        local view = {
            index = index,
            section = entry.section,
            category = definition.category,
            quantity = entry.quantity,
            equipped_slot = entry.equipped_slot,
            name_key = definition.name_key,
            base_price = definition.price,
            multiplier = multiplier,
            effective_price = (definition.price or 0) * entry.quantity * multiplier,
            weight_mg = (definition.weight_mg or 0) * entry.quantity
        }
        selected[#selected + 1] = view
        selected_map[entry.section] = view
        if definition.category == "grenade" then selected_grenades[#selected_grenades + 1] = view end
    end

    local categories = {}
    for _, category in ipairs(CATEGORY_IDS) do
        categories[category] = {}
        for _, section in ipairs(sorted_category_sections(self.catalog, category)) do
            local definition = self.catalog.items[section]
            local is_selected = selected_map[section] ~= nil
            local multiplier = category == "grenade" and #selected_grenades == 1 and self.catalog.second_grenade_price_multiplier or 1
            local disabled = category == "grenade" and (is_selected or #selected_grenades >= self.catalog.max_selected_grenades) or false
            categories[category][#categories[category] + 1] = {
                section = section,
                category = category,
                name_key = definition.name_key,
                base_price = definition.price,
                weight_mg = definition.weight_mg,
                carry_bonus_mg = definition.carry_bonus_mg,
                selected = is_selected,
                selected_quantity = is_selected and selected_map[section].quantity or 0,
                disabled = disabled,
                preview_multiplier = multiplier,
                preview_effective_price = (definition.price or 0) * multiplier
            }
        end
    end
    local device_options = projected_device_options(self)
    return {
        config = copy_config(self.draft),
        faction = self.draft.faction,
        faction_ids = deep_copy(self.catalog.faction_ids or {}),
        rank_ids = deep_copy(self.catalog.rank_ids or {}),
        roster = deep_copy(self.draft.roster),
        count = #self.draft.roster,
        capacity = self.layout and self.layout.virtual_capacity or 0,
        category_ids = deep_copy(CATEGORY_IDS),
        categories = categories,
        actor_device = self.draft.actor_device,
        device_options = device_options,
        actor_items = selected,
        selected_grenades = selected_grenades,
        distinct_count = #self.draft.actor_items + (self.draft.actor_device and 1 or 0),
        max_entries = self.catalog.max_entries,
        physical_count = physical_count(self.draft),
        max_physical_items_per_participant = self.catalog.max_physical_items_per_participant,
        budget = budget,
        spent = totals.points,
        remaining = budget - totals.points,
        weight_mg = totals.weight_mg,
        weight_limit_mg = totals.weight_limit_mg,
        validation = validated,
        can_start = validated.ok == true,
        last_operation = deep_copy(self.last_operation)
    }
end

function new(catalog, layout)
    catalog = type(catalog) == "table" and catalog or {}
    layout = type(layout) == "table" and layout or {}
    gamma_arena_custom_config.prewarm_catalog_rank_pools(catalog)
    local self = setmetatable({
        catalog = catalog,
        layout = layout,
        draft = {
            schema_version = 1,
            faction = nil,
            roster = { { rank = "novice" } },
            actor_items = {},
            actor_device = nil,
            catalog_fingerprint = catalog.fingerprint
        },
        last_operation = nil
    }, Model)
    self.current_validation = gamma_arena_custom_config.validate(self.draft, { catalog = catalog, layout = layout })
    refresh_derived(self)
    return self
end
