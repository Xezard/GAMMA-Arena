local Adapter = {}
Adapter.__index = Adapter

local MAX_MAGAZINE_CAPACITY = 512
local MAX_CONTEXT_TEXT = 96

local function fail(code, message, context)
    return gamma_arena_result.err(code, message, context or {})
end

local function positive_integer(value)
    return type(value) == "number" and value == value and value ~= math.huge
        and value == math.floor(value) and value > 0
end

local function bounded_text(value)
    if value == nil then return "unavailable" end
    local called, text = pcall(function()
        if type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
            and value == math.floor(value) then
            return string.format("%.0f", value)
        end
        return tostring(value)
    end)
    if not called then return "unprintable" end
    if #text > MAX_CONTEXT_TEXT then return string.sub(text, 1, MAX_CONTEXT_TEXT) end
    return text
end

local function descriptor_context(descriptor, observed_state, magazine_section, reserve_ordinal, expected_capacity)
    descriptor = type(descriptor) == "table" and descriptor or {}
    local weapon_section = descriptor.weapon_section
    if weapon_section == nil and descriptor.category == "weapon" then weapon_section = descriptor.section end
    local resolved_magazine = magazine_section
    if resolved_magazine == nil and descriptor.bonus_kind == "mags_redux" then resolved_magazine = descriptor.section end
    local ordinal = reserve_ordinal or descriptor.reserve_ordinal
    if not positive_integer(ordinal) then ordinal = 0 end
    local capacity = expected_capacity or descriptor.magazine_capacity
    if not positive_integer(capacity) or capacity > MAX_MAGAZINE_CAPACITY then capacity = 0 end
    return {
        weapon_section = bounded_text(weapon_section),
        magazine_section = bounded_text(resolved_magazine),
        ammo_section = bounded_text(descriptor.selected_ammo),
        reserve_ordinal = ordinal,
        expected_capacity = capacity,
        observed_state = bounded_text(observed_state)
    }
end

local function result_call(code, fn, ...)
    if type(fn) ~= "function" then return fail(code, "Required Mags Redux dependency is unavailable") end
    local called, value = pcall(fn, ...)
    if not called then return fail(code, "Mags Redux dependency failed safely", { reason = bounded_text(value) }) end
    if type(value) == "table" and type(value.ok) == "boolean" then return value end
    return gamma_arena_result.ok(value)
end


local function contextualize(result, fallback_code, fallback_message, descriptor, observed_state,
    magazine_section, reserve_ordinal, expected_capacity)
    if result.ok then return result end
    local cause = type(result.error) == "table" and result.error or {}
    local code = type(cause.code) == "string" and cause.code ~= "" and cause.code or fallback_code
    local message = type(cause.message) == "string" and cause.message ~= "" and cause.message or fallback_message
    return fail(code, message, descriptor_context(descriptor, observed_state,
        magazine_section, reserve_ordinal, expected_capacity))
end

local function valid_api(api)
    if type(api) ~= "table" then return false end
    for _, key in ipairs({ "is_supported_weapon", "default_magazine", "read_magazine", "is_carried", "refresh_loadout", "fill_magazine" }) do
        if type(api[key]) ~= "function" then return false end
    end
    return true
end

local function dense_array_length(value)
    if type(value) ~= "table" then return nil, 0, 0 end
    local count, maximum = 0, 0
    for key in pairs(value) do
        if not positive_integer(key) then return nil, count, maximum end
        count = count + 1
        if key > maximum then maximum = key end
    end
    if maximum == count then return count, count, maximum end
    return nil, count, maximum
end

local function loaded_shape(data, magazine_section)
    if type(data) ~= "table" then return nil, "state:not_table" end
    if data.section ~= magazine_section then
        return nil, "section:" .. bounded_text(data.section)
    end
    if type(data.loaded) ~= "table" then return nil, "loaded:not_table" end
    local length, count, maximum = dense_array_length(data.loaded)
    if length == nil then
        return nil, "loaded_sparse:" .. bounded_text(count) .. ":" .. bounded_text(maximum)
    end
    return length, nil
end

function Adapter:resolve()
    if self.resolved then
        if self.resolve_failure ~= nil then return self.resolve_failure end
        return gamma_arena_result.ok(self.api)
    end
    self.resolved = true
    local resolved = result_call("GA_MAGS_REDUX_API_INVALID", self.ports.resolve_api)
    if not resolved.ok then self.resolve_failure = resolved; return resolved end
    if resolved.value == nil then return gamma_arena_result.ok(nil) end
    if not valid_api(resolved.value) then
        self.resolve_failure = fail("GA_MAGS_REDUX_API_INVALID", "Detected Mags Redux API is incomplete")
        return self.resolve_failure
    end
    self.api = resolved.value
    return gamma_arena_result.ok(self.api)
end

function Adapter:bonus_descriptors(descriptors)
    if dense_array_length(descriptors) == nil then
        return fail("GA_MAGS_REDUX_PLAN_INVALID", "Equipped item descriptors must be a dense array")
    end
    local resolved = self:resolve()
    if not resolved.ok then return resolved end
    local api = resolved.value
    if api == nil then return gamma_arena_result.ok({}) end

    local bonus = {}
    for _, descriptor in ipairs(descriptors) do
        if type(descriptor) == "table" and descriptor.category == "weapon"
            and descriptor.equipped_slot ~= nil and type(descriptor.section) == "string"
            and descriptor.section ~= "" and type(descriptor.selected_ammo) == "string"
            and descriptor.selected_ammo ~= "" then
            local supported = result_call("GA_MAGS_REDUX_PLAN_FAILED", api.is_supported_weapon, descriptor.section)
            if not supported.ok then
                return contextualize(supported, "GA_MAGS_REDUX_PLAN_FAILED", "Mags Redux weapon support lookup failed",
                    descriptor, "support_lookup_failed", nil, 0, MAX_MAGAZINE_CAPACITY)
            end
            if supported.value == true then
                local magazine = result_call("GA_MAGS_REDUX_PLAN_FAILED", api.default_magazine, descriptor.section)
                if not magazine.ok then
                    return contextualize(magazine, "GA_MAGS_REDUX_PLAN_FAILED", "Mags Redux default magazine lookup failed",
                        descriptor, "magazine_lookup_failed", nil, 0, MAX_MAGAZINE_CAPACITY)
                end
                if type(magazine.value) ~= "string" or magazine.value == "" then
                    return fail("GA_MAGS_REDUX_MAGAZINE_INVALID", "Supported weapon has no valid default magazine",
                        descriptor_context(descriptor, "magazine:" .. bounded_text(magazine.value),
                            magazine.value, 0, MAX_MAGAZINE_CAPACITY))
                end
                local capacity = result_call("GA_MAGS_REDUX_CAPACITY_INVALID", self.ports.magazine_capacity, magazine.value)
                if not capacity.ok then
                    return contextualize(capacity, "GA_MAGS_REDUX_CAPACITY_INVALID", "Default magazine capacity lookup failed",
                        descriptor, "capacity_lookup_failed", magazine.value, 0, MAX_MAGAZINE_CAPACITY)
                end
                if not positive_integer(capacity.value) or capacity.value > MAX_MAGAZINE_CAPACITY then
                    return fail("GA_MAGS_REDUX_CAPACITY_INVALID", "Default magazine capacity is invalid",
                        descriptor_context(descriptor, "capacity:" .. bounded_text(capacity.value),
                            magazine.value, 0, MAX_MAGAZINE_CAPACITY))
                end
                for ordinal = 1, 2 do
                    bonus[#bonus + 1] = {
                        section = magazine.value,
                        category = "magazine",
                        bonus_kind = "mags_redux",
                        weapon_section = descriptor.section,
                        selected_ammo = descriptor.selected_ammo,
                        magazine_capacity = capacity.value,
                        reserve_ordinal = ordinal
                    }
                end
            end
        end
    end
    return gamma_arena_result.ok(bonus)
end

function Adapter:initialize(id, descriptor)
    if not positive_integer(id) or type(descriptor) ~= "table" or descriptor.bonus_kind ~= "mags_redux"
        or type(descriptor.section) ~= "string" or descriptor.section == ""
        or type(descriptor.selected_ammo) ~= "string" or descriptor.selected_ammo == ""
        or not positive_integer(descriptor.reserve_ordinal)
        or not positive_integer(descriptor.magazine_capacity)
        or descriptor.magazine_capacity > MAX_MAGAZINE_CAPACITY then
        return fail("GA_MAGS_REDUX_INIT_INVALID", "Reserve magazine initialization input is invalid",
            descriptor_context(descriptor, "input_invalid", nil, nil, MAX_MAGAZINE_CAPACITY))
    end
    local resolved = self:resolve()
    if not resolved.ok then
        return contextualize(resolved, "GA_MAGS_REDUX_API_INVALID", "Mags Redux API resolution failed",
            descriptor, "api_resolution_failed")
    end
    local api = resolved.value
    if api == nil then
        return fail("GA_MAGS_REDUX_API_INVALID", "Mags Redux disappeared after reserve planning",
            descriptor_context(descriptor, "api_absent"))
    end

    local before = result_call("GA_MAGS_REDUX_STATE_INVALID", api.read_magazine, id)
    if not before.ok then
        return contextualize(before, "GA_MAGS_REDUX_STATE_INVALID", "Reserve magazine state lookup failed",
            descriptor, "state_read_failed")
    end
    if before.value ~= nil then
        local before_length, observed = loaded_shape(before.value, descriptor.section)
        if observed ~= nil or before_length ~= 0 then
            return fail("GA_MAGS_REDUX_STATE_INVALID", "New reserve magazine has unexpected vendor state",
                descriptor_context(descriptor, observed or ("loaded_count:" .. bounded_text(before_length))))
        end
    end

    local refreshed = result_call("GA_MAGS_REDUX_REFRESH_FAILED", api.refresh_loadout)
    if not refreshed.ok then
        return contextualize(refreshed, "GA_MAGS_REDUX_REFRESH_FAILED", "Mags Redux loadout refresh failed",
            descriptor, "refresh_failed")
    end
    if refreshed.value == false then
        return fail("GA_MAGS_REDUX_REFRESH_FAILED", "Mags Redux rejected loadout refresh",
            descriptor_context(descriptor, "refresh_rejected"))
    end

    local filled = result_call("GA_MAGS_REDUX_FILL_FAILED", api.fill_magazine, id, descriptor.section,
        descriptor.magazine_capacity, descriptor.selected_ammo)
    if not filled.ok then
        return contextualize(filled, "GA_MAGS_REDUX_FILL_FAILED", "Mags Redux reserve fill failed",
            descriptor, "fill_failed")
    end
    if filled.value == false then
        return fail("GA_MAGS_REDUX_FILL_FAILED", "Mags Redux rejected reserve magazine filling",
            descriptor_context(descriptor, "fill_rejected"))
    end

    local verified = result_call("GA_MAGS_REDUX_VERIFY_FAILED", api.read_magazine, id)
    if not verified.ok then
        return contextualize(verified, "GA_MAGS_REDUX_VERIFY_FAILED", "Reserve magazine verification lookup failed",
            descriptor, "verification_read_failed")
    end
    local data = verified.value
    local loaded_length, observed = loaded_shape(data, descriptor.section)
    if observed ~= nil or loaded_length ~= descriptor.magazine_capacity then
        return fail("GA_MAGS_REDUX_VERIFY_FAILED", "Reserve magazine state verification failed",
            descriptor_context(descriptor, observed or ("loaded_count:" .. bounded_text(loaded_length))))
    end
    for index = 1, descriptor.magazine_capacity do
        if data.loaded[index] ~= descriptor.selected_ammo then
            return fail("GA_MAGS_REDUX_VERIFY_FAILED", "Reserve magazine ammunition verification failed",
                descriptor_context(descriptor, "ammo_mismatch:" .. bounded_text(index)
                    .. ":" .. bounded_text(data.loaded[index])))
        end
    end
    local carried_ok, carried = pcall(api.is_carried, id)
    return gamma_arena_result.ok({ carried = carried_ok and carried == true })
end

function new(ports)
    if type(ports) ~= "table" or type(ports.resolve_api) ~= "function"
        or type(ports.magazine_capacity) ~= "function" then return nil end
    return setmetatable({ ports = ports, resolved = false, api = nil, resolve_failure = nil }, Adapter)
end
