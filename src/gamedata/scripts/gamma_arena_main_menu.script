local bound_menus = setmetatable({}, { __mode = "k" })

local function log_result(result)
    if result and not result.ok then
        gamma_arena_log.error(result.error.code, result.error.message, result.error.context)
    end
end

local function open_arena(menu)
    local ok, detail = pcall(function()
        if menu.gamma_arena_dialog == nil then
            menu.gamma_arena_dialog = gamma_arena_ui_start.create(menu)
        end
        menu.gamma_arena_dialog:ShowDialog(true)
        menu:HideDialog()
        menu:Show(false)
    end)
    if not ok then
        log_result(gamma_arena_result.err("GA_START_UI_OPEN_FAILED", "Arena start screen could not be opened", { detail = tostring(detail) }))
    end
end

local function on_arena_clicked(menu)
    open_arena(menu)
end

function bind(menu)
    if menu == nil then
        return gamma_arena_result.err("GA_MAIN_MENU_INVALID", "Main-menu callback did not provide an owner")
    end
    if type(menu.AddCallback) == "function" then
        if bound_menus[menu] then
            return gamma_arena_result.ok(false)
        end
        local ok, detail = pcall(function()
            menu:AddCallback("btn_gamma_arena", ui_events.BUTTON_CLICKED, on_arena_clicked, menu)
        end)
        if not ok then
            return gamma_arena_result.err("GA_MAIN_MENU_BIND_FAILED", "Arena menu callback could not be registered", { detail = tostring(detail) })
        end
        bound_menus[menu] = true
        return gamma_arena_result.ok(true)
    end
    return gamma_arena_result.err("GA_MAIN_MENU_CALLBACK_UNAVAILABLE", "Main menu does not expose AddCallback")
end

local function on_main_menu_init(menu)
    log_result(bind(menu))
end

function on_game_start()
    RegisterScriptCallback("main_menu_on_init", on_main_menu_init)
end
