local SECTION = "gamma_arena"
local CHARACTER_SECTION = "character_creation"
local CHECKPOINT_NAME = "_gamma_arena_checkpoint"
local LAUNCH_TOKEN_TTL = 600
local DEFEAT_TOKEN_TTL = 600
local UINT32_MAX = 4294967295
local CUSTOM_PREFIX = "launch_custom_"
local custom_launch_keys = gamma_arena_custom_codec.keys(CUSTOM_PREFIX)
local custom_launch_key_set = {}
for _, key in ipairs(custom_launch_keys) do custom_launch_key_set[key] = true end

local character_bridge = {
    { key = "new_game_difficulty", action = "write", value = 2 },
    { key = "new_game_economy", action = "write", value = 2 },
    { key = "new_game_economy_treasure", action = "write", value = 2 },
    { key = "new_game_character_name", action = "write", value = "Arena_Fighter" },
    { key = "new_game_faction", action = "write", value = "dolg" },
    { key = "new_game_map", action = "write", value = "makeshift_barracks" },
    { key = "new_game_money", action = "write", value = 0 },
    { key = "new_game_loadout", action = "remove" },
    { key = "new_game_story_mode", action = "remove" },
    { key = "new_game_icon", action = "remove" },
    { key = "new_game_hardcore_mode", action = "remove" },
    { key = "new_game_hardcore_mode_lives", action = "remove" },
    { key = "new_game_hardcore_mode_regenerate", action = "remove" },
    { key = "new_game_survival_mode", action = "remove" },
    { key = "new_game_azazel_mode", action = "remove" },
    { key = "new_game_warfare", action = "remove" },
    { key = "new_game_campfire_mode", action = "remove" },
    { key = "new_game_conditions_mode", action = "remove" },
    { key = "new_game_timer_mode", action = "remove" },
    { key = "new_game_opened_routes", action = "remove" },
    { key = "new_game_test", action = "remove" }
}

local character_keys = {}
local bridge_lease_keys = { "bridge_schema_version", "bridge_launch_token" }
for _, descriptor in ipairs(character_bridge) do
    character_keys[#character_keys + 1] = descriptor.key
    bridge_lease_keys[#bridge_lease_keys + 1] = "bridge_" .. descriptor.key .. "_present"
    bridge_lease_keys[#bridge_lease_keys + 1] = "bridge_" .. descriptor.key .. "_value"
end
bridge_lease_keys[#bridge_lease_keys + 1] = "bridge_pending"

local launch_keys = {
    "launch_pending",
    "launch_token",
    "launch_schema_version",
    "launch_mode_id",
    "launch_difficulty_id",
    "launch_generation_recipe",
    "launch_seed_mode",
    "launch_session_seed",
    "launch_generator_version",
    "launch_catalog_revision",
    "launch_catalog_fingerprint",
    "launch_stage",
    "launch_deferred_level",
    "launch_target_level"
}
for _, key in ipairs(custom_launch_keys) do launch_keys[#launch_keys + 1] = key end

local resume_keys = {
    "resume_pending",
    "resume_session_id",
    "resume_session_nonce",
    "resume_next_fight_index",
    "resume_checkpoint_name",
    "resume_schema_version"
}

local defeat_keys = {
    "defeat_pending",
    "defeat_token",
    "defeat_schema_version",
    "defeat_stage",
    "defeat_session_id",
    "defeat_session_nonce",
    "defeat_mode_id",
    "defeat_generation_recipe",
    "defeat_difficulty_id",
    "defeat_issued_at"
}

local valid_difficulties = {
    rookie = true,
    stalker = true,
    veteran = true,
    master = true
}

local valid_seed_modes = {
    random = true,
    manual = true
}

local arena_session_keys = {
    schema_version = true,
    session_id = true,
    session_nonce = true,
    mode_id = true,
    difficulty_id = true,
    generation_recipe = true,
    session_seed = true,
    fight_index = true,
    generator_version = true,
    catalog_revision = true,
    catalog_fingerprint = true,
    custom_config = true,
    layout_id = true,
    checkpoint_name = true,
    phase = true
}

local Store = {}
Store.__index = Store

local function fail(code, message, context)
    return gamma_arena_result.err(code, message, context)
end
local function validate_character_creation_lease(lease)
    if type(lease) ~= "table" then
        return fail("GA_CHARACTER_CREATION_LEASE_INVALID", "Character-creation bridge lease is unavailable")
    end
    if lease.bridge_schema_version ~= "1" or type(lease.bridge_launch_token) ~= "string" or lease.bridge_launch_token == "" then
        return fail("GA_CHARACTER_CREATION_LEASE_INVALID", "Character-creation bridge lease metadata is invalid")
    end

    local operations = {}
    for _, descriptor in ipairs(character_bridge) do
        local key = descriptor.key
        local present = lease["bridge_" .. key .. "_present"]
        local value = lease["bridge_" .. key .. "_value"]
        if present == "true" then
            if value == nil then return fail("GA_CHARACTER_CREATION_LEASE_INVALID", "Character-creation bridge lease value is missing", { key = key }) end
            operations[#operations + 1] = { action = "write", key = key, value = value }
        elseif present == "false" then
            if value ~= nil then return fail("GA_CHARACTER_CREATION_LEASE_INVALID", "Absent character-creation bridge key retained a value", { key = key }) end
            operations[#operations + 1] = { action = "remove", key = key }
        else
            return fail("GA_CHARACTER_CREATION_LEASE_INVALID", "Character-creation bridge lease presence is invalid", { key = key })
        end
    end
    return gamma_arena_result.ok({
        launch_token = lease.bridge_launch_token,
        restore_operations = operations
    })
end


local function adapter_boolean_returns(config)
    local ok, declared = pcall(function() return config.gamma_arena_boolean_returns end)
    return ok and declared == true
end

local function finite_integer(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge and value == math.floor(value)
end

local function nonempty_identifier(value, code, field)
    if type(value) ~= "string" or #value < 1 or #value > 128 or not string.match(value, "^[%w_.-]+$") then
        return fail(code, field .. " is invalid", { field = field })
    end
    return gamma_arena_result.ok(value)
end

local function operations_for_writes(entries)
    local operations = {}
    for _, entry in ipairs(entries) do
        operations[#operations + 1] = { action = "write", key = entry[1], value = entry[2] }
    end
    return operations
end

local function operations_for_removals(keys)
    local operations = {}
    for _, key in ipairs(keys) do
        operations[#operations + 1] = { action = "remove", key = key }
    end
    return operations
end

local function parse_manual_seed_impl(text)
    if type(text) ~= "string" or #text < 1 or #text > 10 or not string.match(text, "^%d+$") then
        return fail("GA_SESSION_SEED_INVALID", "Seed must be a decimal uint32")
    end
    local value = tonumber(text)
    if not finite_integer(value) or value < 0 or value > UINT32_MAX then
        return fail("GA_SESSION_SEED_INVALID", "Seed must be between 0 and 4294967295", { value = text })
    end
    return gamma_arena_result.ok(value)
end

local function catalog_from_context(context)
    if type(context) == "table" then
        if type(context.catalog) == "table" then return context.catalog end
        if type(context.items) == "table" then return context end
    end
    local lookup_ok, loader = pcall(function() return gamma_arena_catalog and gamma_arena_catalog.load end)
    if not lookup_ok or type(loader) ~= "function" then return nil end
    local called, loaded = pcall(loader)
    if not called or type(loaded) ~= "table" or loaded.ok ~= true or type(loaded.value) ~= "table" then return nil end
    return loaded.value
end

local function custom_context_from(context)
    if type(context) == "table" and type(context.catalog) == "table" and type(context.layout) == "table" then return context end
    local catalog = catalog_from_context(context)
    local layout = type(catalog) == "table" and type(catalog.layouts) == "table" and catalog.layouts.rostok_arena_v1 or nil
    if type(catalog) == "table" then return { catalog = catalog, layout = layout } end
    return nil
end

local function validate_catalog_provenance(request, context)
    if not finite_integer(request.generator_version) or request.generator_version < 1
        or not finite_integer(request.catalog_revision) or request.catalog_revision < 1
        or type(request.catalog_fingerprint) ~= "string" or request.catalog_fingerprint == "" then
        return fail("GA_START_CATALOG_INVALID", "ArenaStartRequest catalog provenance is invalid")
    end
    local catalog = catalog_from_context(context)
    if type(catalog) ~= "table" or not finite_integer(catalog.generator_version) or not finite_integer(catalog.revision)
        or type(catalog.fingerprint) ~= "string" or catalog.fingerprint == "" then
        return fail("GA_START_CATALOG_UNAVAILABLE", "ArenaStartRequest requires the active validated catalog")
    end
    if request.generator_version ~= catalog.generator_version or request.catalog_revision ~= catalog.revision
        or request.catalog_fingerprint ~= catalog.fingerprint then
        return fail("GA_START_CATALOG_STALE", "ArenaStartRequest catalog provenance is stale", {
            generator_version = request.generator_version, catalog_revision = request.catalog_revision,
            catalog_fingerprint = request.catalog_fingerprint
        })
    end
    return gamma_arena_result.ok(catalog)
end

local function validate_start_request_impl(request, context)
    if type(request) ~= "table" then
        return fail("GA_START_REQUEST_INVALID", "ArenaStartRequest must be a table")
    end
    if request.schema_version ~= 1 and request.schema_version ~= 2 then
        return fail("GA_START_REQUEST_SCHEMA_INVALID", "ArenaStartRequest schema must be v1 or v2", { value = request.schema_version })
    end
    if request.mode_id ~= "skirmish" then
        return fail("GA_START_REQUEST_MODE_INVALID", "Only skirmish mode is supported", { value = request.mode_id })
    end
    if request.schema_version == 1 and not valid_difficulties[request.difficulty_id] then
        return fail("GA_START_REQUEST_DIFFICULTY_INVALID", "Difficulty is unknown", { value = request.difficulty_id })
    end
    if not valid_seed_modes[request.seed_mode] then
        return fail("GA_START_REQUEST_SEED_MODE_INVALID", "Seed mode is unknown", { value = request.seed_mode })
    end
    if not finite_integer(request.session_seed) or request.session_seed < 0 or request.session_seed > UINT32_MAX then
        return fail("GA_SESSION_SEED_INVALID", "Session seed must be uint32", { value = request.session_seed })
    end
    if request.schema_version == 2 then
        local allowed = {
            schema_version = true, mode_id = true, difficulty_id = true, generation_recipe = true,
            seed_mode = true, session_seed = true, generator_version = true,
            catalog_revision = true, catalog_fingerprint = true, custom_config = true
        }
        for key in pairs(request) do
            if type(key) ~= "string" or not allowed[key] then
                return fail("GA_START_REQUEST_UNKNOWN_FIELD", "ArenaStartRequest contains an unknown field", { field = tostring(key) })
            end
        end
        local effective_context = custom_context_from(context)
        local provenance = validate_catalog_provenance(request, effective_context)
        if not provenance.ok then return provenance end
        if request.generation_recipe ~= "random" and request.generation_recipe ~= "custom" then
            return fail("GA_START_REQUEST_RECIPE_INVALID", "ArenaStartRequest generation recipe is invalid", { value = request.generation_recipe })
        end
        if request.generation_recipe == "random" then
            if not valid_difficulties[request.difficulty_id] or request.custom_config ~= nil then
                return fail("GA_START_REQUEST_RECIPE_INVALID", "Random ArenaStartRequest requires only a difficulty recipe")
            end
        else
            if request.difficulty_id ~= nil or request.custom_config == nil then
                return fail("GA_START_REQUEST_RECIPE_INVALID", "Custom ArenaStartRequest requires only a custom configuration")
            end
            local normalized = gamma_arena_custom_config.validate(request.custom_config, effective_context)
            if not normalized.ok then return normalized end
            return gamma_arena_result.ok({
                schema_version = 2, mode_id = "skirmish", generation_recipe = "custom",
                seed_mode = request.seed_mode, session_seed = request.session_seed,
                generator_version = request.generator_version, catalog_revision = request.catalog_revision,
                catalog_fingerprint = request.catalog_fingerprint, custom_config = normalized.value
            })
        end
        return gamma_arena_result.ok({
            schema_version = 2, mode_id = "skirmish", difficulty_id = request.difficulty_id,
            generation_recipe = "random", seed_mode = request.seed_mode, session_seed = request.session_seed,
            generator_version = request.generator_version, catalog_revision = request.catalog_revision,
            catalog_fingerprint = request.catalog_fingerprint
        })
    end
    return gamma_arena_result.ok({
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = request.difficulty_id,
        seed_mode = request.seed_mode,
        session_seed = request.session_seed
    })
end

local function persisted_keys_absent(values, keys)
    for _, key in ipairs(keys) do
        if values[key] ~= nil then
            return fail("GA_START_PAYLOAD_MIXED", "Persisted ArenaStartRequest mixes incompatible schema or recipe keys", { key = key })
        end
    end
    return gamma_arena_result.ok(true)
end

local function validate_persisted_launch_request(values, context)
    if type(values) ~= "table" then
        return fail("GA_START_REQUEST_INVALID", "Persisted launch payload must be a table")
    end
    local seed = parse_manual_seed_impl(values.launch_session_seed)
    if not seed.ok then return seed end
    if tostring(seed.value) ~= values.launch_session_seed then
        return fail("GA_SESSION_SEED_INVALID", "Persisted launch seed must use canonical decimal uint32 encoding", {
            value = values.launch_session_seed
        })
    end
    local schema_version = values.launch_schema_version == nil and 1 or tonumber(values.launch_schema_version)
    if schema_version ~= 1 and schema_version ~= 2 then
        return fail("GA_START_REQUEST_SCHEMA_INVALID", "Persisted ArenaStartRequest schema is invalid", { value = values.launch_schema_version })
    end
    local request = {
        schema_version = schema_version,
        mode_id = values.launch_mode_id,
        difficulty_id = values.launch_difficulty_id,
        seed_mode = values.launch_seed_mode,
        session_seed = seed.value
    }
    local effective_context = context
    if schema_version == 1 then
        local schema2_keys = {
            "launch_generation_recipe", "launch_generator_version",
            "launch_catalog_revision", "launch_catalog_fingerprint"
        }
        local clean = persisted_keys_absent(values, schema2_keys)
        if clean.ok then clean = persisted_keys_absent(values, custom_launch_keys) end
        if not clean.ok then return clean end
    end
    if schema_version == 2 then
        effective_context = custom_context_from(context)
        if values.launch_schema_version ~= "2" then
            return fail("GA_START_REQUEST_SCHEMA_INVALID", "Persisted ArenaStartRequest schema must use canonical encoding")
        end
        request.generation_recipe = values.launch_generation_recipe
        request.generator_version = values.launch_generator_version and tonumber(values.launch_generator_version) or nil
        request.catalog_revision = values.launch_catalog_revision and tonumber(values.launch_catalog_revision) or nil
        request.catalog_fingerprint = values.launch_catalog_fingerprint
        if request.generator_version == nil or tostring(request.generator_version) ~= values.launch_generator_version
            or request.catalog_revision == nil or tostring(request.catalog_revision) ~= values.launch_catalog_revision then
            return fail("GA_START_CATALOG_INVALID", "Persisted ArenaStartRequest catalog provenance is non-canonical")
        end
        if request.generation_recipe == "custom" then
            local decoded = gamma_arena_custom_codec.decode(function(key) return values[key] end, CUSTOM_PREFIX, effective_context)
            if not decoded.ok then
                if decoded.error and decoded.error.code == "GA_CUSTOM_CATALOG_STALE" then
                    return fail("GA_START_CATALOG_STALE", "Persisted custom ArenaStartRequest catalog is stale", { cause = decoded.error })
                end
                return decoded
            end
            request.custom_config = decoded.value
        elseif request.generation_recipe == "random" then
            local clean = persisted_keys_absent(values, custom_launch_keys)
            if not clean.ok then return clean end
        end
    end
    return validate_start_request_impl(request, effective_context)
end

local function start_context(options)
    return type(options) == "table" and (options.custom_context or options.catalog) or nil
end

local function launch_operations(value, token)
    local desired = {
        launch_token = token,
        launch_schema_version = value.schema_version == 2 and 2 or nil,
        launch_mode_id = value.mode_id,
        launch_difficulty_id = value.difficulty_id,
        launch_generation_recipe = value.schema_version == 2 and value.generation_recipe or nil,
        launch_seed_mode = value.seed_mode,
        launch_session_seed = value.session_seed,
        launch_generator_version = value.schema_version == 2 and value.generator_version or nil,
        launch_catalog_revision = value.schema_version == 2 and value.catalog_revision or nil,
        launch_catalog_fingerprint = value.schema_version == 2 and value.catalog_fingerprint or nil,
        launch_stage = "issued",
        launch_pending = true
    }
    local operations = {}
    for _, key in ipairs(launch_keys) do
        if not custom_launch_key_set[key] then
            if desired[key] == nil then operations[#operations + 1] = { action = "remove", key = key }
            else operations[#operations + 1] = { action = "write", key = key, value = desired[key] } end
        end
    end
    if value.schema_version == 2 and value.generation_recipe == "custom" then
        local encoded = gamma_arena_custom_codec.encode(value.custom_config, CUSTOM_PREFIX)
        if not encoded.ok then return encoded end
        for _, operation in ipairs(encoded.value) do operations[#operations + 1] = operation end
    else
        for _, key in ipairs(custom_launch_keys) do operations[#operations + 1] = { action = "remove", key = key } end
    end
    return gamma_arena_result.ok(operations)
end

local function combined_keys(...)
    local result = {}
    for index = 1, select("#", ...) do
        for _, key in ipairs(select(index, ...)) do result[#result + 1] = key end
    end
    return result
end

local function parse_launch_token_impl(token, now)
    if type(token) ~= "string" then
        return fail("GA_LAUNCH_TOKEN_INVALID", "Launch token is missing")
    end
    local epoch_text, nonce = string.match(token, "^ga1:(%d+):([%w_-]+)$")
    local issued_at = epoch_text and tonumber(epoch_text) or nil
    if not issued_at or not finite_integer(issued_at) or issued_at < 0 or #nonce > 64 then
        return fail("GA_LAUNCH_TOKEN_INVALID", "Launch token is malformed")
    end
    if not finite_integer(now) or now < issued_at then
        return fail("GA_LAUNCH_TOKEN_TIME_INVALID", "Launch token timestamp is in the future", { issued_at = issued_at, now = now })
    end
    if now - issued_at > LAUNCH_TOKEN_TTL then
        return fail("GA_LAUNCH_TOKEN_EXPIRED", "Launch token has expired", { issued_at = issued_at, now = now, ttl = LAUNCH_TOKEN_TTL })
    end
    return gamma_arena_result.ok({ issued_at = issued_at, nonce = nonce, token = token })
end

local function parse_defeat_token_impl(token, now)
    if type(token) ~= "string" then
        return fail("GA_DEFEAT_TOKEN_INVALID", "Defeat token is missing")
    end
    local epoch_text, nonce = string.match(token, "^gad1:(%d+):([%w_-]+)$")
    local issued_at = epoch_text and tonumber(epoch_text) or nil
    if not issued_at or not finite_integer(issued_at) or issued_at < 0 or #nonce > 64 then
        return fail("GA_DEFEAT_TOKEN_INVALID", "Defeat token is malformed")
    end
    if not finite_integer(now) or now < issued_at then
        return fail("GA_DEFEAT_TOKEN_TIME_INVALID", "Defeat token timestamp is in the future", { issued_at = issued_at, now = now })
    end
    if now - issued_at > DEFEAT_TOKEN_TTL then
        return fail("GA_DEFEAT_TOKEN_EXPIRED", "Defeat token has expired", { issued_at = issued_at, now = now, ttl = DEFEAT_TOKEN_TTL })
    end
    return gamma_arena_result.ok({ issued_at = issued_at, nonce = nonce, token = token })
end

local function validate_defeat_context(context)
    if type(context) ~= "table" or context.schema_version ~= 1 then
        return fail("GA_DEFEAT_SCHEMA_INVALID", "Defeat context schema must be v1")
    end
    local allowed = {
        schema_version = true,
        session_id = true,
        session_nonce = true,
        mode_id = true,
        generation_recipe = true,
        difficulty_id = true
    }
    for key in pairs(context) do
        if type(key) ~= "string" or not allowed[key] then
            return fail("GA_DEFEAT_UNKNOWN_FIELD", "Defeat context contains an unknown field", { field = tostring(key) })
        end
    end
    local session_id = nonempty_identifier(context.session_id, "GA_DEFEAT_SESSION_ID_INVALID", "session_id")
    if not session_id.ok then return session_id end
    local session_nonce = nonempty_identifier(context.session_nonce, "GA_DEFEAT_SESSION_NONCE_INVALID", "session_nonce")
    if not session_nonce.ok then return session_nonce end
    if context.mode_id ~= "skirmish" then
        return fail("GA_DEFEAT_MODE_INVALID", "Defeat context mode is incompatible", { value = context.mode_id })
    end
    if context.generation_recipe ~= "random" and context.generation_recipe ~= "custom" then
        return fail("GA_DEFEAT_RECIPE_INVALID", "Defeat context generation recipe is invalid", { value = context.generation_recipe })
    end
    if context.generation_recipe == "random" then
        if not valid_difficulties[context.difficulty_id] then
            return fail("GA_DEFEAT_DIFFICULTY_INVALID", "Random defeat context difficulty is unknown", { value = context.difficulty_id })
        end
    elseif context.difficulty_id ~= nil then
        return fail("GA_DEFEAT_RECIPE_INVALID", "Custom defeat context cannot retain a random difficulty")
    end
    return gamma_arena_result.ok({
        schema_version = 1,
        session_id = session_id.value,
        session_nonce = session_nonce.value,
        mode_id = "skirmish",
        generation_recipe = context.generation_recipe,
        difficulty_id = context.difficulty_id
    })
end

local function same_defeat_context(left, right)
    return type(left) == "table" and type(right) == "table"
        and left.schema_version == right.schema_version
        and left.session_id == right.session_id
        and left.session_nonce == right.session_nonce
        and left.mode_id == right.mode_id
        and left.generation_recipe == right.generation_recipe
        and left.difficulty_id == right.difficulty_id
end

local function validate_resume_intent(intent)
    if type(intent) ~= "table" or intent.schema_version ~= 1 then
        return fail("GA_RESUME_SCHEMA_INVALID", "ResumeIntent schema must be v1")
    end
    local session_id = nonempty_identifier(intent.session_id, "GA_RESUME_SESSION_ID_INVALID", "session_id")
    if not session_id.ok then return session_id end
    local session_nonce = nonempty_identifier(intent.session_nonce, "GA_RESUME_SESSION_NONCE_INVALID", "session_nonce")
    if not session_nonce.ok then return session_nonce end
    if not finite_integer(intent.next_fight_index) or intent.next_fight_index < 0 or intent.next_fight_index > UINT32_MAX then
        return fail("GA_RESUME_FIGHT_INDEX_INVALID", "Resume fight index must be uint32")
    end
    if intent.checkpoint_name ~= CHECKPOINT_NAME then
        return fail("GA_RESUME_CHECKPOINT_INVALID", "ResumeIntent must use the reserved Arena checkpoint", { value = intent.checkpoint_name })
    end
    return gamma_arena_result.ok({
        schema_version = 1,
        session_id = session_id.value,
        session_nonce = session_nonce.value,
        next_fight_index = intent.next_fight_index,
        checkpoint_name = CHECKPOINT_NAME
    })
end

local function same_resume_intent(left, right)
    return type(left) == "table" and type(right) == "table"
        and left.schema_version == right.schema_version
        and left.session_id == right.session_id
        and left.session_nonce == right.session_nonce
        and left.next_fight_index == right.next_fight_index
        and left.checkpoint_name == right.checkpoint_name
end

local function validate_expected_session(session, context)
    if type(session) ~= "table" then
        return fail("GA_SESSION_INVALID", "Expected ArenaSession must be a table")
    end
    for key in pairs(session) do
        if type(key) ~= "string" or not arena_session_keys[key] then
            return fail("GA_SESSION_UNKNOWN_FIELD", "ArenaSession contains an unknown field", { field = tostring(key) })
        end
    end
    if session.schema_version ~= 2 then
        return fail("GA_SESSION_SCHEMA_INVALID", "ArenaSession schema must be v2", { value = session.schema_version })
    end
    if session.checkpoint_name ~= CHECKPOINT_NAME then
        return fail("GA_RESUME_CHECKPOINT_MISMATCH", "ArenaSession checkpoint name is not the reserved checkpoint", { value = session.checkpoint_name })
    end
    if session.generator_version ~= 11 then
        return fail("GA_SESSION_GENERATOR_VERSION_INVALID", "ArenaSession generator version is incompatible", { value = session.generator_version })
    end
    if session.catalog_revision ~= 11 then
        return fail("GA_SESSION_CATALOG_REVISION_INVALID", "ArenaSession catalog revision is incompatible", { value = session.catalog_revision })
    end
    if type(session.catalog_fingerprint) ~= "string" or session.catalog_fingerprint == "" then
        return fail("GA_SESSION_CATALOG_FINGERPRINT_INVALID", "ArenaSession catalog fingerprint is invalid")
    end
    if session.layout_id ~= "rostok_arena_v1" then
        return fail("GA_SESSION_LAYOUT_INVALID", "ArenaSession layout is incompatible", { value = session.layout_id })
    end
    if session.mode_id ~= "skirmish" then
        return fail("GA_SESSION_MODE_INVALID", "ArenaSession mode is incompatible", { value = session.mode_id })
    end
    if session.generation_recipe ~= "random" and session.generation_recipe ~= "custom" then
        return fail("GA_SESSION_RECIPE_INVALID", "ArenaSession generation recipe is invalid", { value = session.generation_recipe })
    end
    if not finite_integer(session.session_seed) or session.session_seed < 0 or session.session_seed > UINT32_MAX then
        return fail("GA_SESSION_SEED_INVALID", "ArenaSession seed must be uint32")
    end
    if not finite_integer(session.fight_index) or session.fight_index < 0 or session.fight_index > UINT32_MAX then
        return fail("GA_SESSION_FIGHT_INDEX_INVALID", "ArenaSession fight index must be uint32")
    end
    local session_id = nonempty_identifier(session.session_id, "GA_SESSION_ID_INVALID", "session_id")
    if not session_id.ok then return session_id end
    local session_nonce = nonempty_identifier(session.session_nonce, "GA_SESSION_NONCE_INVALID", "session_nonce")
    if not session_nonce.ok then return session_nonce end
    if type(session.phase) ~= "string" or #session.phase < 1 then
        return fail("GA_SESSION_PHASE_INVALID", "ArenaSession phase is missing")
    end
    local effective_context = type(context) == "table" and custom_context_from(context) or nil
    local catalog = effective_context and effective_context.catalog
    if type(catalog) == "table" then
        if catalog.generator_version ~= session.generator_version or catalog.revision ~= session.catalog_revision
            or catalog.fingerprint ~= session.catalog_fingerprint then
            return fail("GA_START_CATALOG_STALE", "ArenaSession catalog identity is stale", {
                generator_version = session.generator_version,
                catalog_revision = session.catalog_revision,
                catalog_fingerprint = session.catalog_fingerprint
            })
        end
    end
    local custom_config = nil
    if session.generation_recipe == "random" then
        if not valid_difficulties[session.difficulty_id] or session.custom_config ~= nil then
            return fail("GA_SESSION_RECIPE_INVALID", "Random ArenaSession requires only a difficulty recipe")
        end
    else
        if session.difficulty_id ~= nil or session.custom_config == nil then
            return fail("GA_SESSION_RECIPE_INVALID", "Custom ArenaSession requires only a custom configuration")
        end
        if type(effective_context) ~= "table" then
            return fail("GA_START_CATALOG_UNAVAILABLE", "Custom ArenaSession requires the active catalog and layout")
        end
        local normalized = gamma_arena_custom_config.validate(session.custom_config, effective_context)
        if not normalized.ok then return normalized end
        custom_config = normalized.value
    end
    return gamma_arena_result.ok({
        schema_version = 2,
        session_id = session_id.value,
        session_nonce = session_nonce.value,
        mode_id = session.mode_id,
        difficulty_id = session.difficulty_id,
        generation_recipe = session.generation_recipe,
        session_seed = session.session_seed,
        fight_index = session.fight_index,
        generator_version = session.generator_version,
        catalog_revision = session.catalog_revision,
        catalog_fingerprint = session.catalog_fingerprint,
        custom_config = custom_config,
        layout_id = "rostok_arena_v1",
        checkpoint_name = CHECKPOINT_NAME,
        phase = session.phase
    })
end

local function normalize_prepare_session_result(result)
    local detail = type(result) == "table" and result.error or nil
    if detail and detail.code == "GA_RESUME_CHECKPOINT_MISMATCH" then
        return fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Loaded ArenaSession checkpoint does not match the recovery route", {
            cause_code = detail.code
        })
    end
    return result
end

local function new_store_impl()
    return setmetatable({
        shadow_by_config = setmetatable({}, { __mode = "k" }),
        volatile_launch_permits = {},
        nonce_counter = 0,
        random_counter = 0
    }, Store)
end

function Store:get_shadow(config)
    local shadow = self.shadow_by_config[config]
    if shadow == nil then
        shadow = {}
        self.shadow_by_config[config] = shadow
    end
    return shadow
end

function Store:raw_read(config, key)
    if config == nil then
        return fail("GA_CONFIG_INVALID", "Config is unavailable", { key = key })
    end
    if gamma_arena_config_tx.is_quarantined(config) then
        return fail("GA_CONFIG_QUARANTINED", "Arena config reads are blocked until touched-key recovery succeeds", { key = key })
    end
    local ok_methods, line_exist, r_string_ex = pcall(function()
        return config.line_exist, config.r_string_ex
    end)
    if not ok_methods or type(line_exist) ~= "function" or type(r_string_ex) ~= "function" then
        return fail("GA_CONFIG_INVALID", "Config does not expose raw presence/value reads", { key = key })
    end
    local ok_presence, present = pcall(line_exist, config, SECTION, key)
    if not ok_presence then
        return fail("GA_CONFIG_READ_FAILED", "Config key presence could not be read", { key = key })
    end
    if not present then
        return gamma_arena_result.ok(nil)
    end
    local ok_value, value = pcall(r_string_ex, config, SECTION, key)
    if not ok_value or (value == false and adapter_boolean_returns(config)) then
        return fail("GA_CONFIG_READ_FAILED", "Config value could not be read", { key = key })
    end
    if value == nil then value = "" end
    return gamma_arena_result.ok(tostring(value))
end

function Store:clear_launch_permits(config)
    for token, owner in pairs(self.volatile_launch_permits) do
        if owner == config then self.volatile_launch_permits[token] = nil end
    end
end

function Store:read_all(config, keys)
    local values = {}
    for _, key in ipairs(keys) do
        local read = self:raw_read(config, key)
        if not read.ok then return read end
        values[key] = read.value
    end
    return gamma_arena_result.ok(values)
end

function Store:transaction(config, section, operations, options)
    if config == nil then
        return fail("GA_CONFIG_INVALID", "Config is unavailable")
    end
    options = options or {}
    options.shadow = self:get_shadow(config)
    return gamma_arena_config_tx.run(config, section, operations, options)
end

function Store:clear_intent(config, keys, marker, error_code)
    return self:transaction(config, SECTION, operations_for_removals(keys), {
        commit_remove_keys = { marker },
        fail_closed_keys = keys,
        error_code = error_code or "GA_INTENT_CLEAR_FAILED"
    })
end

function Store:pending_value(raw, kind)
    if raw == nil or raw == "false" or raw == "0" then
        return gamma_arena_result.ok(false)
    end
    if raw == "true" or raw == "1" then
        return gamma_arena_result.ok(true)
    end
    return fail("GA_" .. kind .. "_PENDING_INVALID", kind .. " pending marker is malformed", { value = raw })
end

function Store:inspect_intents(config)
    local launch_raw = self:raw_read(config, "launch_pending")
    if not launch_raw.ok then return launch_raw end
    local resume_raw = self:raw_read(config, "resume_pending")
    if not resume_raw.ok then return resume_raw end
    local defeat_raw = self:raw_read(config, "defeat_pending")
    if not defeat_raw.ok then return defeat_raw end
    local launch_pending = self:pending_value(launch_raw.value, "LAUNCH")
    local resume_pending = self:pending_value(resume_raw.value, "RESUME")
    local defeat_pending = self:pending_value(defeat_raw.value, "DEFEAT")
    if not launch_pending.ok or not resume_pending.ok or not defeat_pending.ok then
        local cause = not launch_pending.ok and launch_pending or (not resume_pending.ok and resume_pending) or defeat_pending
        local cleared = self:clear_transient(config)
        return cleared.ok and cause or cleared
    end
    local count = (launch_pending.value and 1 or 0) + (resume_pending.value and 1 or 0) + (defeat_pending.value and 1 or 0)
    if count > 1 then
        local cleared = self:clear_transient(config)
        return cleared.ok and fail("GA_INTENT_CONFLICT", "Launch, resume, and defeat intents cannot coexist") or cleared
    end
    return gamma_arena_result.ok({
        launch_pending = launch_pending.value,
        resume_pending = resume_pending.value,
        defeat_pending = defeat_pending.value
    })
end

function Store:current_time(options)
    local clock = options and options.clock or (os and os.time)
    if type(clock) ~= "function" then
        return fail("GA_CLOCK_UNAVAILABLE", "A wall-clock provider is unavailable")
    end
    local ok, value = pcall(clock)
    if not ok or not finite_integer(value) or value < 0 then
        return fail("GA_CLOCK_INVALID", "Wall-clock provider returned an invalid epoch")
    end
    return gamma_arena_result.ok(value)
end

function Store:nonce_value(options, issued_at)
    local generator = options and options.nonce
    local value
    if generator ~= nil then
        if type(generator) ~= "function" then
            return fail("GA_LAUNCH_NONCE_INVALID", "Nonce provider must be a function")
        end
        local ok, generated = pcall(generator)
        if not ok then
            return fail("GA_LAUNCH_NONCE_INVALID", "Nonce provider failed")
        end
        value = generated
    else
        self.nonce_counter = self.nonce_counter + 1
        value = tostring(issued_at) .. "_" .. tostring(self.nonce_counter)
    end
    if type(value) ~= "string" or #value < 1 or #value > 64 or not string.match(value, "^[%w_-]+$") then
        return fail("GA_LAUNCH_NONCE_INVALID", "Launch nonce has an invalid format")
    end
    return gamma_arena_result.ok(value)
end

function Store:defeat_nonce_value(options, issued_at)
    local generator = options and options.nonce
    local value
    if generator ~= nil then
        if type(generator) ~= "function" then return fail("GA_DEFEAT_NONCE_INVALID", "Nonce provider must be a function") end
        local ok, generated = pcall(generator)
        if not ok then return fail("GA_DEFEAT_NONCE_INVALID", "Nonce provider failed") end
        value = generated
    else
        self.nonce_counter = self.nonce_counter + 1
        value = tostring(issued_at) .. "_defeat_" .. tostring(self.nonce_counter)
    end
    if type(value) ~= "string" or #value < 1 or #value > 64 or not string.match(value, "^[%w_-]+$") then
        return fail("GA_DEFEAT_NONCE_INVALID", "Defeat nonce has an invalid format")
    end
    return gamma_arena_result.ok(value)
end

function Store:clear_defeat(config)
    return self:clear_intent(config, defeat_keys, "defeat_pending", "GA_DEFEAT_CLEAR_FAILED")
end

function Store:clear_defeat_and_return(config, result)
    local cleared = self:clear_defeat(config)
    return cleared.ok and result or cleared
end

function Store:read_defeat(config, now, require_confirmed)
    local values_result = self:read_all(config, defeat_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.defeat_pending, "DEFEAT")
    if not pending.ok then return self:clear_defeat_and_return(config, pending) end
    if not pending.value then
        for _, key in ipairs(defeat_keys) do
            if key ~= "defeat_pending" and values[key] ~= nil then
                return self:clear_defeat_and_return(config, fail("GA_DEFEAT_PAYLOAD_ORPHANED", "Defeat payload exists without a pending marker"))
            end
        end
        return gamma_arena_result.ok(false)
    end
    local parsed = parse_defeat_token_impl(values.defeat_token, now)
    if not parsed.ok then return self:clear_defeat_and_return(config, parsed) end
    if values.defeat_schema_version ~= "1" or values.defeat_issued_at ~= tostring(parsed.value.issued_at) then
        return self:clear_defeat_and_return(config, fail("GA_DEFEAT_PAYLOAD_INVALID", "Defeat payload version or timestamp is invalid"))
    end
    local context = validate_defeat_context({
        schema_version = tonumber(values.defeat_schema_version),
        session_id = values.defeat_session_id,
        session_nonce = values.defeat_session_nonce,
        mode_id = values.defeat_mode_id,
        generation_recipe = values.defeat_generation_recipe,
        difficulty_id = values.defeat_difficulty_id
    })
    if not context.ok then return self:clear_defeat_and_return(config, context) end
    if values.defeat_stage ~= "armed" and values.defeat_stage ~= "confirmed" then
        return self:clear_defeat_and_return(config, fail("GA_DEFEAT_STAGE_INVALID", "Defeat stage is invalid", { stage = values.defeat_stage }))
    end
    if require_confirmed and values.defeat_stage ~= "confirmed" then
        return fail("GA_DEFEAT_NOT_CONFIRMED", "Defeat has not been confirmed")
    end
    return gamma_arena_result.ok({
        token = parsed.value.token,
        issued_at = parsed.value.issued_at,
        stage = values.defeat_stage,
        context = context.value
    })
end

function Store:ensure_defeat_has_no_other_intent(config)
    local launch_raw = self:raw_read(config, "launch_pending")
    if not launch_raw.ok then return launch_raw end
    local resume_raw = self:raw_read(config, "resume_pending")
    if not resume_raw.ok then return resume_raw end
    local launch_pending = self:pending_value(launch_raw.value, "LAUNCH")
    local resume_pending = self:pending_value(resume_raw.value, "RESUME")
    if not launch_pending.ok or not resume_pending.ok or launch_pending.value or resume_pending.value then
        local cause = not launch_pending.ok and launch_pending or (not resume_pending.ok and resume_pending)
            or fail("GA_INTENT_CONFLICT", "Defeat cannot coexist with launch or resume intents")
        local cleared = self:clear_transient(config)
        return cleared.ok and cause or cleared
    end
    return gamma_arena_result.ok(true)
end

function Store:ensure_no_launch_or_resume(config)
    local launch_raw = self:raw_read(config, "launch_pending")
    if not launch_raw.ok then return launch_raw end
    local resume_raw = self:raw_read(config, "resume_pending")
    if not resume_raw.ok then return resume_raw end
    local launch_pending = self:pending_value(launch_raw.value, "LAUNCH")
    if not launch_pending.ok then return launch_pending end
    local resume_pending = self:pending_value(resume_raw.value, "RESUME")
    if not resume_pending.ok then return resume_pending end
    if launch_pending.value or resume_pending.value then
        return fail("GA_INTENT_CONFLICT", "Defeat cannot coexist with launch or resume intents")
    end
    return gamma_arena_result.ok(true)
end

function Store:arm_defeat(config, context, options)
    local validated = validate_defeat_context(context)
    if not validated.ok then return validated end
    local now = self:current_time(options)
    if not now.ok then return now end
    local other = self:ensure_no_launch_or_resume(config)
    if not other.ok then return other end

    local existing = self:read_defeat(config, now.value, false)
    if not existing.ok then return existing end
    if existing.value then
        if same_defeat_context(existing.value.context, validated.value) then
            return gamma_arena_result.ok({ token = existing.value.token, context = existing.value.context })
        end
        return fail("GA_DEFEAT_ALREADY_PENDING", "A defeat intent is already pending")
    end
    local nonce = self:defeat_nonce_value(options, now.value)
    if not nonce.ok then return nonce end
    local token = "gad1:" .. tostring(now.value) .. ":" .. nonce.value

    local value = validated.value
    local operations = operations_for_writes({
        { "defeat_token", token },
        { "defeat_schema_version", value.schema_version },
        { "defeat_stage", "armed" },
        { "defeat_session_id", value.session_id },
        { "defeat_session_nonce", value.session_nonce },
        { "defeat_mode_id", value.mode_id },
        { "defeat_generation_recipe", value.generation_recipe },
        { "defeat_issued_at", now.value },
        { "defeat_pending", true }
    })
    if value.difficulty_id == nil then
        operations[#operations + 1] = { action = "remove", key = "defeat_difficulty_id" }
    else
        operations[#operations + 1] = { action = "write", key = "defeat_difficulty_id", value = value.difficulty_id }
    end
    local written = self:transaction(config, SECTION, operations, {
        commit_write_keys = { "defeat_pending" },
        fail_closed_keys = defeat_keys,
        error_code = "GA_DEFEAT_ARM_FAILED"
    })
    if not written.ok then return written end
    return gamma_arena_result.ok({ token = token, context = value })
end

function Store:confirm_defeat(config, token, options)
    local now = self:current_time(options)
    if not now.ok then return now end
    local intents = self:inspect_intents(config)
    if not intents.ok then return intents end
    local defeat = self:read_defeat(config, now.value, false)
    if not defeat.ok then return defeat end
    if not defeat.value then return fail("GA_DEFEAT_NOT_PENDING", "No defeat intent is pending") end
    local other = self:ensure_defeat_has_no_other_intent(config)
    if not other.ok then return other end
    if token ~= defeat.value.token then return fail("GA_DEFEAT_TOKEN_MISMATCH", "Defeat token does not match the pending intent") end
    if defeat.value.stage == "confirmed" then return gamma_arena_result.ok(defeat.value.context) end
    local confirmed = self:transaction(config, SECTION, operations_for_writes({ { "defeat_stage", "confirmed" } }), {
        commit_write_keys = { "defeat_stage" },
        fail_closed_keys = defeat_keys,
        error_code = "GA_DEFEAT_CONFIRM_FAILED"
    })
    return confirmed.ok and gamma_arena_result.ok(defeat.value.context) or confirmed
end

function Store:peek_defeat(config, options)
    local now = self:current_time(options)
    if not now.ok then return now end
    local intents = self:inspect_intents(config)
    if not intents.ok then
        if intents.error and intents.error.code == "GA_DEFEAT_PENDING_INVALID" then return gamma_arena_result.ok(false) end
        return intents
    end
    local defeat = self:read_defeat(config, now.value, false)
    if not defeat.ok then
        if defeat.error and string.match(defeat.error.code or "", "^GA_DEFEAT_") and defeat.error.code ~= "GA_DEFEAT_CLEAR_FAILED" then
            return gamma_arena_result.ok(false)
        end
        return defeat
    end
    if not defeat.value then return gamma_arena_result.ok(false) end
    local other = self:ensure_defeat_has_no_other_intent(config)
    if not other.ok then return other end
    if defeat.value.stage ~= "confirmed" then
        return self:clear_defeat_and_return(config, gamma_arena_result.ok(false))
    end
    local value = defeat.value.context
    value.token = defeat.value.token
    value.issued_at = defeat.value.issued_at
    return gamma_arena_result.ok(value)
end

function Store:consume_defeat(config, token)
    local intents = self:inspect_intents(config)
    if not intents.ok then return intents end
    local values_result = self:read_all(config, defeat_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local issued_at = values.defeat_issued_at and tonumber(values.defeat_issued_at) or nil
    local defeat = self:read_defeat(config, issued_at, true)
    if not defeat.ok then return defeat end
    if not defeat.value then return fail("GA_DEFEAT_NOT_PENDING", "No defeat intent is pending") end
    local other = self:ensure_defeat_has_no_other_intent(config)
    if not other.ok then return other end
    if token ~= defeat.value.token then return fail("GA_DEFEAT_TOKEN_MISMATCH", "Defeat token does not match the pending intent") end
    local cleared = self:clear_defeat(config)
    return cleared.ok and gamma_arena_result.ok(defeat.value.context) or cleared
end

function Store:issue_launch_from_defeat(config, token, request, options)
    local validated = validate_start_request_impl(request, start_context(options))
    if not validated.ok then return validated end
    if validated.value.seed_mode ~= "random" then return fail("GA_DEFEAT_REQUEST_INVALID", "Defeat retry must use a random Arena start seed") end
    local now = self:current_time(options)
    if not now.ok then return now end
    local intents = self:inspect_intents(config)
    if not intents.ok then return intents end
    local defeat = self:read_defeat(config, now.value, true)
    if not defeat.ok then return defeat end
    if not defeat.value then return fail("GA_DEFEAT_NOT_PENDING", "No defeat intent is pending") end
    local other = self:ensure_defeat_has_no_other_intent(config)
    if not other.ok then return other end
    if token ~= defeat.value.token then return fail("GA_DEFEAT_TOKEN_MISMATCH", "Defeat token does not match the pending intent") end
    if defeat.value.context.generation_recipe ~= "random" or validated.value.mode_id ~= defeat.value.context.mode_id
        or validated.value.difficulty_id ~= defeat.value.context.difficulty_id then
        return fail("GA_DEFEAT_REQUEST_MISMATCH", "Defeat retry request must match the defeated mode and difficulty")
    end
    local nonce = self:nonce_value(options, now.value)
    if not nonce.ok then return nonce end
    local launch_token = "ga1:" .. tostring(now.value) .. ":" .. nonce.value
    local operations = operations_for_removals(defeat_keys)
    local value = validated.value
    local launch_payload = launch_operations(value, launch_token)
    if not launch_payload.ok then return launch_payload end
    for _, operation in ipairs(launch_payload.value) do operations[#operations + 1] = operation end
    local promoted = self:transaction(config, SECTION, operations, {
        commit_remove_keys = { "defeat_pending" },
        commit_write_keys = { "launch_pending" },
        fail_closed_keys = combined_keys(defeat_keys, launch_keys),
        error_code = "GA_DEFEAT_PROMOTION_FAILED"
    })
    if not promoted.ok then return promoted end
    self.volatile_launch_permits[launch_token] = config
    return gamma_arena_result.ok({ token = launch_token, request = value })
end

function Store:random_session_seed(provider)
    local value
    if provider ~= nil then
        if type(provider) ~= "function" then
            return fail("GA_RANDOM_SEED_PROVIDER_INVALID", "Random seed provider must be a function")
        end
        local ok, generated = pcall(provider)
        if not ok then
            return fail("GA_RANDOM_SEED_PROVIDER_FAILED", "Random seed provider failed")
        end
        value = generated
    else
        local now = self:current_time()
        if not now.ok then return now end
        self.random_counter = self.random_counter + 1
        value = (now.value + self.random_counter * 2654435761) % 4294967296
    end
    if not finite_integer(value) or value < 0 or value > UINT32_MAX then
        return fail("GA_RANDOM_SEED_INVALID", "Random seed provider returned a non-uint32 value")
    end
    return gamma_arena_result.ok(value)
end

function Store:save_preferences(config, difficulty_id, seed_mode)
    if not valid_difficulties[difficulty_id] then
        return fail("GA_SETTINGS_DIFFICULTY_INVALID", "Difficulty preference is unknown", { value = difficulty_id })
    end
    if not valid_seed_modes[seed_mode] then
        return fail("GA_SETTINGS_SEED_MODE_INVALID", "Seed mode preference is unknown", { value = seed_mode })
    end
    return self:transaction(config, SECTION, operations_for_writes({
        { "last_difficulty_id", difficulty_id },
        { "last_seed_mode", seed_mode },
        { "settings_schema_version", 1 }
    }), {
        commit_write_keys = { "settings_schema_version" },
        error_code = "GA_SETTINGS_WRITE_FAILED"
    })
end

function Store:issue_launch(config, request, options)
    local context = start_context(options)
    local validated = validate_start_request_impl(request, context)
    if not validated.ok then return validated end
    local now = self:current_time(options)
    if not now.ok then return now end

    local resume_raw = self:raw_read(config, "resume_pending")
    if not resume_raw.ok then return resume_raw end
    local resume_pending = self:pending_value(resume_raw.value, "RESUME")
    if not resume_pending.ok then return resume_pending end
    if resume_pending.value then
        return fail("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist")
    end
    local defeat_raw = self:raw_read(config, "defeat_pending")
    if not defeat_raw.ok then return defeat_raw end
    local defeat_pending = self:pending_value(defeat_raw.value, "DEFEAT")
    if not defeat_pending.ok then return defeat_pending end
    if defeat_pending.value then
        return fail("GA_INTENT_CONFLICT", "Launch and defeat intents cannot coexist")
    end

    local existing_result = self:read_all(config, launch_keys)
    if not existing_result.ok then return existing_result end
    local existing = existing_result.value
    local pending = self:pending_value(existing.launch_pending, "LAUNCH")
    local stale_reason = nil
    if not pending.ok then
        stale_reason = pending.error.code
    elseif pending.value then
        local parsed = parse_launch_token_impl(existing.launch_token, now.value)
        local persisted_request = validate_persisted_launch_request(existing, context)
        if parsed.ok and persisted_request.ok and self.volatile_launch_permits[existing.launch_token] == config then
            return fail("GA_LAUNCH_ALREADY_PENDING", "A valid launch intent is already pending")
        end
        if not parsed.ok then
            stale_reason = parsed.error.code
        elseif self.volatile_launch_permits[existing.launch_token] ~= config then
            stale_reason = "GA_LAUNCH_TOKEN_ORPHANED"
        else
            stale_reason = persisted_request.error.code
        end
    else
        for _, key in ipairs(launch_keys) do
            if key ~= "launch_pending" and existing[key] ~= nil then
                stale_reason = "GA_LAUNCH_PAYLOAD_ORPHANED"
                break
            end
        end
    end

    if stale_reason ~= nil then
        self:clear_launch_permits(config)
        local restored = self:restore_character_creation(config)
        if not restored.ok then return restored end
        local cleared = self:clear_intent(config, launch_keys, "launch_pending", "GA_LAUNCH_STALE_CLEAR_FAILED")
        if not cleared.ok then return cleared end
        return fail("GA_LAUNCH_STALE_CLEARED", "A stale launch intent was cleared; issue a fresh launch", { reason = stale_reason })
    end

    local nonce = self:nonce_value(options, now.value)
    if not nonce.ok then return nonce end
    local token = "ga1:" .. tostring(now.value) .. ":" .. nonce.value
    local value = validated.value
    local payload = launch_operations(value, token)
    if not payload.ok then return payload end
    local written = self:transaction(config, SECTION, payload.value, {
        commit_write_keys = { "launch_pending" },
        fail_closed_keys = launch_keys,
        error_code = "GA_LAUNCH_WRITE_FAILED"
    })
    if not written.ok then return written end
    self.volatile_launch_permits[token] = config
    return gamma_arena_result.ok({ token = token, request = value })
end

function Store:reject_launch(config, token, result)
    if token ~= nil then self.volatile_launch_permits[token] = nil end
    local restored = self:restore_character_creation(config)
    if not restored.ok then return restored end
    local cleared = self:clear_intent(config, launch_keys, "launch_pending", "GA_LAUNCH_CLEAR_FAILED")
    return cleared.ok and result or cleared
end

function Store:validate_launch_handoff(config, token)
    if self.volatile_launch_permits[token] == config then
        return gamma_arena_result.ok({ route = "volatile" })
    end
    local lease_result = self:read_all(config, bridge_lease_keys)
    if not lease_result.ok then return lease_result end
    local lease = lease_result.value
    local pending = self:pending_value(lease.bridge_pending, "BRIDGE")
    if not pending.ok then return pending end
    if pending.value ~= true then
        return fail("GA_LAUNCH_HANDOFF_REQUIRED", "Cross-VM Arena launch requires a pending character-creation bridge lease")
    end
    local validated = validate_character_creation_lease(lease)
    if not validated.ok then return validated end
    if validated.value.launch_token ~= token then
        return fail("GA_LAUNCH_HANDOFF_INVALID", "Character-creation bridge lease does not match the Arena launch token")
    end
    return gamma_arena_result.ok({ route = "bridge" })
end

local function validate_launch_ownership_values(store, config, options, values)
    local pending = store:pending_value(values.launch_pending, "LAUNCH")
    if not pending.ok then return pending end
    if pending.value ~= true then return fail("GA_LAUNCH_NOT_PENDING", "No launch intent is pending") end

    local now = store:current_time(options)
    if not now.ok then return now end
    local parsed = parse_launch_token_impl(values.launch_token, now.value)
    if not parsed.ok then return parsed end
    local request = validate_persisted_launch_request(values, start_context(options))
    if not request.ok then return request end
    if values.launch_stage ~= "issued" and values.launch_stage ~= "deferred" then
        return fail("GA_LAUNCH_STAGE_INVALID", "Arena launch phase is invalid", { stage = values.launch_stage })
    end
    local handoff = store:validate_launch_handoff(config, values.launch_token)
    if not handoff.ok then return handoff end
    request.value.launch_handoff = {
        schema_version = 1,
        route = handoff.value.route,
        issued_at = parsed.value.issued_at
    }
    return request
end

function Store:validate_launch_ownership(config, options)
    local values_result = self:read_all(config, launch_keys)
    if not values_result.ok then return values_result end
    return validate_launch_ownership_values(self, config, options, values_result.value)
end

function Store:mark_launch_deferred(config, current_level, expected_level)
    if current_level ~= "fake_start" or type(expected_level) ~= "string" or expected_level == "" or expected_level == current_level then
        return fail("GA_LAUNCH_DEFER_FAILED", "Arena launch may be deferred only from fake_start to a distinct target level", {
            current_level = current_level,
            expected_level = expected_level
        })
    end
    local values_result = self:read_all(config, launch_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.launch_pending, "LAUNCH")
    if not pending.ok then return pending end
    if pending.value ~= true then return fail("GA_LAUNCH_NOT_PENDING", "No launch intent is pending") end
    if values.launch_stage == "deferred" then
        if values.launch_deferred_level == current_level and values.launch_target_level == expected_level then
            return gamma_arena_result.ok(false)
        end
        return fail("GA_LAUNCH_DEFER_FAILED", "Persisted Arena launch phase conflicts with the current route")
    end
    if values.launch_stage ~= "issued" then
        return fail("GA_LAUNCH_DEFER_FAILED", "Arena launch has no valid issued phase", { stage = values.launch_stage })
    end
    return self:transaction(config, SECTION, operations_for_writes({
        { "launch_deferred_level", current_level },
        { "launch_target_level", expected_level },
        { "launch_stage", "deferred" }
    }), {
        commit_write_keys = { "launch_stage" },
        fail_closed_keys = launch_keys,
        error_code = "GA_LAUNCH_DEFER_FAILED"
    })
end

function Store:validate_launch_activation(config, context)
    if type(context) ~= "table" or type(context.current_level) ~= "string" or type(context.expected_level) ~= "string" then
        return fail("GA_LAUNCH_REQUIRES_NEW_GAME", "Arena launch activation context is invalid")
    end
    local values_result = self:read_all(config, launch_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.launch_pending, "LAUNCH")
    if not pending.ok then return pending end
    if context.serialized ~= true then
        local issued = pending.value == true and values.launch_stage == "issued"
            and values.launch_deferred_level == nil and values.launch_target_level == nil
        if issued and context.current_level == context.expected_level then
            return gamma_arena_result.ok({ route = "direct" })
        end
        if context.current_level == "fake_start" and context.expected_level ~= "fake_start" then
            if issued then return gamma_arena_result.ok({ route = "fake_start" }) end
            if pending.value == true and values.launch_stage == "deferred"
                and values.launch_deferred_level == "fake_start"
                and values.launch_target_level == context.expected_level then
                return gamma_arena_result.ok({ route = "fake_start_deferred" })
            end
        end
        return fail("GA_LAUNCH_REQUIRES_NEW_GAME", "Non-serialized Arena launch is outside the exact target or fake_start route", {
            current_level = context.current_level,
            expected_level = context.expected_level,
            stage = values.launch_stage,
            deferred_level = values.launch_deferred_level,
            target_level = values.launch_target_level
        })
    end
    if pending.value ~= true or values.launch_stage ~= "deferred"
        or values.launch_deferred_level ~= "fake_start"
        or values.launch_target_level ~= context.expected_level
        or context.current_level ~= context.expected_level then
        return fail("GA_LAUNCH_REQUIRES_NEW_GAME", "Serialized Arena launch lacks an exact fake_start handoff proof", {
            current_level = context.current_level,
            expected_level = context.expected_level,
            stage = values.launch_stage,
            deferred_level = values.launch_deferred_level,
            target_level = values.launch_target_level
        })
    end
    return gamma_arena_result.ok({ route = "deferred" })
end

function Store:consume_launch(config, options)
    local values_result = self:read_all(config, launch_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.launch_pending, "LAUNCH")
    if not pending.ok then return self:reject_launch(config, values.launch_token, pending) end
    if not pending.value then
        return fail("GA_LAUNCH_NOT_PENDING", "No launch intent is pending")
    end
    local intents = self:inspect_intents(config)
    if not intents.ok then return intents end
    local resume_raw = self:raw_read(config, "resume_pending")
    if not resume_raw.ok then return self:reject_launch(config, values.launch_token, resume_raw) end
    local resume_pending = self:pending_value(resume_raw.value, "RESUME")
    if not resume_pending.ok then return self:reject_launch(config, values.launch_token, resume_pending) end
    if resume_pending.value then
        local restored = self:restore_character_creation(config)
        if not restored.ok then return restored end
        local operations = operations_for_removals(launch_keys)
        for _, operation in ipairs(operations_for_removals(resume_keys)) do operations[#operations + 1] = operation end
        local cleared = self:transaction(config, SECTION, operations, {
            commit_remove_keys = { "launch_pending", "resume_pending" },
            fail_closed_keys = combined_keys(launch_keys, resume_keys),
            error_code = "GA_INTENT_CONFLICT_CLEAR_FAILED"
        })
        if values.launch_token ~= nil then
            self.volatile_launch_permits[values.launch_token] = nil
        end
        return cleared.ok and fail("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist") or cleared
    end

    local request = validate_launch_ownership_values(self, config, options, values)
    if not request.ok then return self:reject_launch(config, values.launch_token, request) end

    local restored = self:restore_character_creation(config)
    if not restored.ok then return restored end
    local cleared = self:clear_intent(config, launch_keys, "launch_pending", "GA_LAUNCH_CONSUME_FAILED")
    self.volatile_launch_permits[values.launch_token] = nil
    if not cleared.ok then return cleared end
    return request
end

function Store:issue_resume(config, intent)
    local validated = validate_resume_intent(intent)
    if not validated.ok then return validated end
    local launch_raw = self:raw_read(config, "launch_pending")
    if not launch_raw.ok then return launch_raw end
    local launch_pending = self:pending_value(launch_raw.value, "LAUNCH")
    if not launch_pending.ok then return launch_pending end
    if launch_pending.value then return fail("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist") end
    local defeat_raw = self:raw_read(config, "defeat_pending")
    if not defeat_raw.ok then return defeat_raw end
    local defeat_pending = self:pending_value(defeat_raw.value, "DEFEAT")
    if not defeat_pending.ok then return defeat_pending end
    if defeat_pending.value then return fail("GA_INTENT_CONFLICT", "Resume and defeat intents cannot coexist") end
    local resume_raw = self:raw_read(config, "resume_pending")
    if not resume_raw.ok then return resume_raw end
    local resume_pending = self:pending_value(resume_raw.value, "RESUME")
    if not resume_pending.ok then return resume_pending end
    if resume_pending.value then return fail("GA_RESUME_ALREADY_PENDING", "A resume intent is already pending") end

    local value = validated.value
    return self:transaction(config, SECTION, operations_for_writes({
        { "resume_session_id", value.session_id },
        { "resume_session_nonce", value.session_nonce },
        { "resume_next_fight_index", value.next_fight_index },
        { "resume_checkpoint_name", value.checkpoint_name },
        { "resume_schema_version", value.schema_version },
        { "resume_pending", true }
    }), {
        commit_write_keys = { "resume_pending" },
        fail_closed_keys = resume_keys,
        error_code = "GA_RESUME_WRITE_FAILED"
    })
end

function Store:reject_resume(config, result)
    local cleared = self:clear_intent(config, resume_keys, "resume_pending", "GA_RESUME_CLEAR_FAILED")
    return cleared.ok and result or cleared
end

function Store:prepare_resume(config, expected)
    local values_result = self:read_all(config, resume_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.resume_pending, "RESUME")
    if not pending.ok then return self:reject_resume(config, pending) end
    if not pending.value then return fail("GA_RESUME_NOT_PENDING", "No resume intent is pending") end
    local intents = self:inspect_intents(config)
    if not intents.ok then return intents end

    local launch_raw = self:raw_read(config, "launch_pending")
    if not launch_raw.ok then return self:reject_resume(config, launch_raw) end
    local launch_pending = self:pending_value(launch_raw.value, "LAUNCH")
    if not launch_pending.ok then return self:reject_resume(config, launch_pending) end
    if launch_pending.value then
        local cleared = self:clear_transient(config)
        return cleared.ok and fail("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist") or cleared
    end

    local intent = validate_resume_intent({
        schema_version = values.resume_schema_version and tonumber(values.resume_schema_version) or nil,
        session_id = values.resume_session_id,
        session_nonce = values.resume_session_nonce,
        next_fight_index = values.resume_next_fight_index and tonumber(values.resume_next_fight_index) or nil,
        checkpoint_name = values.resume_checkpoint_name
    })
    if not intent.ok then return self:reject_resume(config, intent) end
    local session = normalize_prepare_session_result(validate_expected_session(expected))
    if not session.ok then return self:reject_resume(config, session) end
    if session.value.session_id ~= intent.value.session_id then
        return self:reject_resume(config, fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Resume session id does not match checkpoint state"))
    end
    if session.value.session_nonce ~= intent.value.session_nonce then
        return self:reject_resume(config, fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Resume session nonce does not match checkpoint state"))
    end
    if session.value.checkpoint_name ~= intent.value.checkpoint_name then
        return self:reject_resume(config, fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Resume checkpoint does not match ArenaSession"))
    end
    if intent.value.next_fight_index < session.value.fight_index then
        return self:reject_resume(config, fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Resume fight index is older than the clean checkpoint baseline", { intent = intent.value.next_fight_index, session = session.value.fight_index }))
    end
    return intent
end

function Store:consume_resume(config, expected, prepared)
    local values_result = self:read_all(config, resume_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.resume_pending, "RESUME")
    if not pending.ok then return self:reject_resume(config, pending) end
    if not pending.value then return fail("GA_RESUME_NOT_PENDING", "No resume intent is pending") end
    local intents = self:inspect_intents(config)
    if not intents.ok then return intents end

    local launch_raw = self:raw_read(config, "launch_pending")
    if not launch_raw.ok then return self:reject_resume(config, launch_raw) end
    local launch_pending = self:pending_value(launch_raw.value, "LAUNCH")
    if not launch_pending.ok then return self:reject_resume(config, launch_pending) end
    if launch_pending.value then
        local operations = operations_for_removals(launch_keys)
        for _, operation in ipairs(operations_for_removals(resume_keys)) do operations[#operations + 1] = operation end
        local cleared = self:transaction(config, SECTION, operations, {
            commit_remove_keys = { "launch_pending", "resume_pending" },
            fail_closed_keys = combined_keys(launch_keys, resume_keys),
            error_code = "GA_INTENT_CONFLICT_CLEAR_FAILED"
        })
        return cleared.ok and fail("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist") or cleared
    end

    local intent = validate_resume_intent({
        schema_version = values.resume_schema_version and tonumber(values.resume_schema_version) or nil,
        session_id = values.resume_session_id,
        session_nonce = values.resume_session_nonce,
        next_fight_index = values.resume_next_fight_index and tonumber(values.resume_next_fight_index) or nil,
        checkpoint_name = values.resume_checkpoint_name
    })
    if not intent.ok then return self:reject_resume(config, intent) end
    if prepared ~= nil then
        local snapshot = validate_resume_intent(prepared)
        if not snapshot.ok or not same_resume_intent(intent.value, snapshot.value) then
            return self:reject_resume(config, fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Persisted ResumeIntent no longer matches its prepared snapshot", {
                cause = snapshot.ok and nil or snapshot.error
            }))
        end
    end
    local session = validate_expected_session(expected)
    if not session.ok then return self:reject_resume(config, session) end
    if session.value.session_id ~= intent.value.session_id then
        return self:reject_resume(config, fail("GA_RESUME_SESSION_MISMATCH", "Resume session id does not match checkpoint state"))
    end
    if session.value.session_nonce ~= intent.value.session_nonce then
        return self:reject_resume(config, fail("GA_RESUME_NONCE_MISMATCH", "Resume session nonce does not match checkpoint state"))
    end
    if session.value.checkpoint_name ~= intent.value.checkpoint_name then
        return self:reject_resume(config, fail("GA_RESUME_CHECKPOINT_MISMATCH", "Resume checkpoint does not match ArenaSession"))
    end
    if intent.value.next_fight_index < session.value.fight_index then
        return self:reject_resume(config, fail("GA_RESUME_FIGHT_INDEX_MISMATCH", "Resume fight index is older than the clean checkpoint baseline", { intent = intent.value.next_fight_index, session = session.value.fight_index }))
    end

    local cleared = self:clear_intent(config, resume_keys, "resume_pending", "GA_RESUME_CONSUME_FAILED")
    if not cleared.ok then return cleared end
    return intent
end

function Store:clear_resume_if_matches(config, expected)
    local values_result = self:read_all(config, resume_keys)
    if not values_result.ok then return values_result end
    local values = values_result.value
    local pending = self:pending_value(values.resume_pending, "RESUME")
    if not pending.ok then return pending end
    if not pending.value then return gamma_arena_result.ok(false) end
    local session = validate_expected_session(expected)
    if not session.ok then return session end
    local intent = validate_resume_intent({
        schema_version = values.resume_schema_version and tonumber(values.resume_schema_version) or nil,
        session_id = values.resume_session_id,
        session_nonce = values.resume_session_nonce,
        next_fight_index = values.resume_next_fight_index and tonumber(values.resume_next_fight_index) or nil,
        checkpoint_name = values.resume_checkpoint_name
    })
    if not intent.ok then return intent end
    if intent.value.session_id ~= session.value.session_id
        or intent.value.session_nonce ~= session.value.session_nonce
        or intent.value.checkpoint_name ~= session.value.checkpoint_name then
        return gamma_arena_result.ok(false)
    end
    return self:clear_intent(config, resume_keys, "resume_pending", "GA_RESUME_CLEAR_FAILED")
end

function Store:clear_transient(config)
    local restored = self:restore_character_creation(config)
    if not restored.ok then return restored end
    local token = self:raw_read(config, "launch_token")
    if token.ok and token.value ~= nil then self.volatile_launch_permits[token.value] = nil end
    local operations = operations_for_removals(launch_keys)
    for _, operation in ipairs(operations_for_removals(resume_keys)) do operations[#operations + 1] = operation end
    for _, operation in ipairs(operations_for_removals(defeat_keys)) do operations[#operations + 1] = operation end
    return self:transaction(config, SECTION, operations, {
        commit_remove_keys = { "launch_pending", "resume_pending", "defeat_pending" },
        fail_closed_keys = combined_keys(launch_keys, resume_keys, defeat_keys),
        error_code = "GA_TRANSIENT_CLEAR_FAILED"
    })
end

function Store:reconcile_character_creation(config)
    local lease_result = self:read_all(config, bridge_lease_keys)
    if not lease_result.ok then return lease_result end
    local lease = lease_result.value
    local bridge_pending = self:pending_value(lease.bridge_pending, "BRIDGE")
    if not bridge_pending.ok then return bridge_pending end
    if not bridge_pending.value then return gamma_arena_result.ok(false) end
    local validated = validate_character_creation_lease(lease)
    if not validated.ok then return validated end

    local launch_result = self:read_all(config, { "launch_pending", "launch_token" })
    if not launch_result.ok then return launch_result end
    local launch = launch_result.value
    local launch_pending = self:pending_value(launch.launch_pending, "LAUNCH")
    if not launch_pending.ok then
        local restored = self:restore_character_creation(config)
        if not restored.ok then return restored end
        return launch_pending
    end
    if launch_pending.value == true and launch.launch_token == validated.value.launch_token then
        return gamma_arena_result.ok(false)
    end
    return self:restore_character_creation(config)
end

function Store:restore_character_creation(config)
    local lease_result = self:read_all(config, bridge_lease_keys)
    if not lease_result.ok then return lease_result end
    local lease = lease_result.value
    local pending = self:pending_value(lease.bridge_pending, "BRIDGE")
    if not pending.ok then return pending end
    if not pending.value then return gamma_arena_result.ok(false) end
    local validated = validate_character_creation_lease(lease)
    if not validated.ok then return validated end
    local restored = self:transaction(config, CHARACTER_SECTION, validated.value.restore_operations, { error_code = "GA_CHARACTER_CREATION_RESTORE_FAILED" })
    if not restored.ok then return restored end
    local cleared = self:transaction(config, SECTION, operations_for_removals(bridge_lease_keys), {
        commit_remove_keys = { "bridge_pending" },
        error_code = "GA_CHARACTER_CREATION_LEASE_CLEAR_FAILED"
    })
    if not cleared.ok then return cleared end
    return gamma_arena_result.ok(true)
end

function Store:write_character_creation(config)
    local recovered = self:restore_character_creation(config)
    if not recovered.ok then return recovered end
    local launch_pending_result = self:raw_read(config, "launch_pending")
    if not launch_pending_result.ok then return launch_pending_result end
    local launch_pending = self:pending_value(launch_pending_result.value, "LAUNCH")
    if not launch_pending.ok then return launch_pending end
    local launch_token = self:raw_read(config, "launch_token")
    if not launch_token.ok then return launch_token end
    if not launch_pending.value or type(launch_token.value) ~= "string" or launch_token.value == "" then
        return fail("GA_CHARACTER_CREATION_LAUNCH_REQUIRED", "Character-creation bridge requires a pending Arena launch")
    end

    local snapshot = gamma_arena_config_tx.snapshot(config, CHARACTER_SECTION, character_keys)
    if not snapshot.ok then return snapshot end
    local lease_operations = {
        { action = "write", key = "bridge_schema_version", value = 1 },
        { action = "write", key = "bridge_launch_token", value = launch_token.value }
    }
    for _, descriptor in ipairs(character_bridge) do
        local key = descriptor.key
        local entry = snapshot.value.entries[key]
        lease_operations[#lease_operations + 1] = { action = "write", key = "bridge_" .. key .. "_present", value = entry.present }
        lease_operations[#lease_operations + 1] = entry.present
            and { action = "write", key = "bridge_" .. key .. "_value", value = entry.value }
            or { action = "remove", key = "bridge_" .. key .. "_value" }
    end
    lease_operations[#lease_operations + 1] = { action = "write", key = "bridge_pending", value = true }
    local leased = self:transaction(config, SECTION, lease_operations, {
        commit_write_keys = { "bridge_pending" },
        fail_closed_keys = bridge_lease_keys,
        error_code = "GA_CHARACTER_CREATION_LEASE_WRITE_FAILED"
    })
    if not leased.ok then return leased end

    local operations = {}
    for _, descriptor in ipairs(character_bridge) do
        operations[#operations + 1] = descriptor.action == "write"
            and { action = "write", key = descriptor.key, value = descriptor.value }
            or { action = "remove", key = descriptor.key }
    end
    local written = self:transaction(config, CHARACTER_SECTION, operations, { error_code = "GA_CHARACTER_CREATION_WRITE_FAILED" })
    if written.ok then return written end
    local restored = self:restore_character_creation(config)
    if not restored.ok then
        return fail("GA_CHARACTER_CREATION_RESTORE_FAILED", "Character-creation bridge mutation failed and exact restoration could not complete", {
            mutation = written.error,
            restoration = restored.error
        })
    end
    return written
end

local default_store = new_store_impl()

function new_store() return new_store_impl() end
function parse_manual_seed(text) return parse_manual_seed_impl(text) end
function validate_start_request(request, context) return validate_start_request_impl(request, context) end
function validate_arena_session(session, context)
    local succeeded, result = pcall(validate_expected_session, session, context)
    if succeeded and type(result) == "table" and type(result.ok) == "boolean" then return result end
    return fail("GA_SESSION_INVALID", "ArenaSession validation failed safely", { reason = tostring(result) })
end
function parse_launch_token(token, now) return parse_launch_token_impl(token, now) end
function random_session_seed(provider) return default_store:random_session_seed(provider) end
function save_preferences(config, difficulty_id, seed_mode) return default_store:save_preferences(config, difficulty_id, seed_mode) end
function issue_launch(config, request, options) return default_store:issue_launch(config, request, options) end
function consume_launch(config, options) return default_store:consume_launch(config, options) end
function inspect_intents(config) return default_store:inspect_intents(config) end
function arm_defeat(config, context, options) return default_store:arm_defeat(config, context, options) end
function confirm_defeat(config, token, options) return default_store:confirm_defeat(config, token, options) end
function peek_defeat(config, options) return default_store:peek_defeat(config, options) end
function consume_defeat(config, token) return default_store:consume_defeat(config, token) end
function issue_launch_from_defeat(config, token, request, options) return default_store:issue_launch_from_defeat(config, token, request, options) end
function clear_defeat(config) return default_store:clear_defeat(config) end
function issue_resume(config, intent) return default_store:issue_resume(config, intent) end
function prepare_resume(config, expected) return default_store:prepare_resume(config, expected) end
function consume_resume(config, expected, prepared) return default_store:consume_resume(config, expected, prepared) end
function clear_resume_if_matches(config, expected) return default_store:clear_resume_if_matches(config, expected) end
function clear_transient(config) return default_store:clear_transient(config) end
function write_character_creation(config) return default_store:write_character_creation(config) end
function restore_character_creation(config) return default_store:restore_character_creation(config) end
function reconcile_character_creation(config) return default_store:reconcile_character_creation(config) end
