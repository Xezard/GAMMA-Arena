local Orchestrator = {}
Orchestrator.__index = Orchestrator
local UINT32_MOD = 4294967296
local UINT32_MAX = UINT32_MOD - 1
local COUNTDOWN_DURATION_MS = 3000
local MAX_DEFEAT_RECOVERY_UPDATES = 256

local function fail(code, message, context)
    return gamma_arena_result.err(code, message, context)
end

local function copy_plain(value, seen)
    local value_type = type(value)
    if value_type == "nil" or value_type == "string" or value_type == "boolean" or value_type == "number" then return value end
    if value_type ~= "table" then error("non-plain ArenaSession value: " .. value_type) end
    seen = seen or {}
    if seen[value] then error("cyclic ArenaSession value") end
    local copy = {}
    seen[value] = true
    for key, item in pairs(value) do
        if type(key) ~= "string" then error("non-string ArenaSession key") end
        copy[key] = copy_plain(item, seen)
    end
    seen[value] = nil
    return copy
end

local function safe_result_call(code, fn, ...)
    if type(fn) ~= "function" then return fail(code, "Required Arena dependency is unavailable") end
    local ok, result = pcall(fn, ...)
    if not ok then return fail(code, "Arena dependency failed safely", { reason = tostring(result) }) end
    if type(result) ~= "table" or type(result.ok) ~= "boolean" then
        return fail(code, "Arena dependency returned an invalid Result", { result_type = type(result) })
    end
    return result
end

local function call_method(code, object, method_name, ...)
    local ok, method = pcall(function() return object and object[method_name] end)
    if not ok or type(method) ~= "function" then return fail(code, "Arena dependency method is unavailable", { method = method_name }) end
    return safe_result_call(code, method, object, ...)
end

local function clock_elapsed(started, current)
    if current >= started then return current - started end
    return (UINT32_MOD - started) + current
end

local function cleanup_registry_empty(snapshot)
    return type(snapshot) == "table" and type(snapshot.npcs) == "table" and next(snapshot.npcs) == nil
        and type(snapshot.items) == "table" and next(snapshot.items) == nil
end

local function error_results(result)
    local values = {}
    if type(result) == "table" and result.error and result.error.code == "GA_PREFLIGHT_FAILED"
        and type(result.error.context) == "table" and type(result.error.context.errors) == "table" then
        for index = 1, #result.error.context.errors do
            local item = result.error.context.errors[index]
            values[#values + 1] = fail(item.code or "GA_PREFLIGHT_FAILED", item.message or "Preflight failed", item.context)
        end
    end
    if #values == 0 then values[1] = result end
    return values
end

local resume_preparation_mismatch_codes = {
    GA_RESUME_SESSION_MISMATCH = true,
    GA_RESUME_NONCE_MISMATCH = true,
    GA_RESUME_CHECKPOINT_MISMATCH = true,
    GA_RESUME_FIGHT_INDEX_MISMATCH = true
}

local checkpoint_restore_failure

local function normalize_resume_preparation(result)
    local detail = type(result) == "table" and result.error or nil
    local message = detail and resume_preparation_mismatch_codes[detail.code]
        and "ResumeIntent does not match the loaded ArenaSession"
        or "ResumeIntent validation failed before checkpoint recovery"
    return checkpoint_restore_failure(result, message)
end

local function find_flags(...)
    local args = { ... }
    for index = 1, #args do
        if type(args[index]) == "table" and type(rawget(args[index], "ret")) == "boolean" then
            local writable = pcall(function()
                local old = args[index].ret
                args[index].ret = old
            end)
            if writable then return args[index] end
        end
    end
    return nil
end

local function find_death_flags(...)
    local args = { ... }
    for index = 1, #args do
        local candidate = args[index]
        if type(candidate) == "table" and type(rawget(candidate, "ret_value")) == "boolean" then
            local writable = pcall(function()
                local old = candidate.ret_value
                candidate.ret_value = old
            end)
            if writable then return candidate end
        end
    end
    return nil
end

checkpoint_restore_failure = function(result, message)
    if type(result) == "table" and result.ok == false and result.error and result.error.code == "GA_CHECKPOINT_RESTORE_FAILED" then
        return result
    end
    return fail("GA_CHECKPOINT_RESTORE_FAILED", message or "Arena checkpoint recovery failed safely", {
        cause = type(result) == "table" and result.error or nil
    })
end

function Orchestrator:__init(deps)
    self.deps = deps
    self.active = false
    self.session = nil
    self.pending_resume = nil
    self.loaded_session = nil
    self.load_state_seen = false
    self.load_state_error = nil
    self.pending_load_state = nil
    self.pending_load_state_seen = false
    self.pending_load_state_error = nil
    self.awaiting_activation = false
    self.game_load_seen = false
    self.activation_attempted = false
    self.checkpoint_reload_expected = false
    self.runtime_stage = "INACTIVE"
    self.checkpoint_ready = false
    self.teardown_done = false
    self.teardown_cycle = 0
    self.fatal_shown = false
    self.fatal_dialog = nil
    self.main_menu_executed = false
    self.cleanup_required = false
    self.fight_spec = nil
    self.catalog_snapshot = nil
    self.countdown_started = nil
    self.countdown_value = nil
    self.active_started = nil
    self.pending_victory = false
    self.pending_result = nil
    self.death_latched = false
    self.result_kind = nil
    self.result_action_locked = false
    self.pending_next_fight_index = nil
    self.next_cleanup_started = false
    self.defeat_cleanup_started = false
    self.defeat_cleanup_updates = 0
    self.pending_disconnect = false
    self.pending_callback_error = nil
    self.machine_state = gamma_arena_state_machine.states.IDLE
end

function Orchestrator:is_active()
    return self.active == true
end

function Orchestrator:session_snapshot()
    if self.session == nil then return nil end
    local ok, copy = pcall(copy_plain, self.session)
    return ok and copy or nil
end

function Orchestrator:pending_resume_snapshot()
    if self.pending_resume == nil then return nil end
    local ok, copy = pcall(copy_plain, self.pending_resume)
    return ok and copy or nil
end

function Orchestrator:runtime_stage_snapshot()
    return self.runtime_stage
end

function Orchestrator:is_checkpoint_ready()
    return self:is_active() and self.checkpoint_ready == true and self.runtime_stage == "READY"
end

function Orchestrator:is_opponent_activation_allowed()
    return self:is_active() and self.runtime_stage == "SPAWNING"
end

function Orchestrator:clock_now()
    if type(self.deps.clock) ~= "function" then return fail("GA_RUNTIME_CLOCK_FAILED", "Arena clock dependency is unavailable") end
    local called, value = pcall(self.deps.clock)
    if not called then return fail("GA_RUNTIME_CLOCK_FAILED", "Arena clock failed safely", { reason = tostring(value) }) end
    if type(value) == "table" and type(value.ok) == "boolean" then
        if not value.ok then return value end
        value = value.value
    end
    if type(value) ~= "number" or value ~= math.floor(value) or value < 0 or value >= UINT32_MOD then
        return fail("GA_RUNTIME_CLOCK_FAILED", "Arena clock must return uint32 milliseconds")
    end
    return gamma_arena_result.ok(value)
end

function Orchestrator:emit_log(code, message, context)
    local log = self.deps.log
    local lookup_ok, writer = pcall(function() return log and log.info end)
    if not lookup_ok or type(writer) ~= "function" then return fail("GA_RUNTIME_LOG_FAILED", "Arena diagnostic log dependency is unavailable", { code = code }) end
    local called, value = pcall(writer, code, message, context)
    if not called then return fail("GA_RUNTIME_LOG_FAILED", "Arena diagnostic log failed safely", { code = code, reason = tostring(value) }) end
    if type(value) == "table" and type(value.ok) == "boolean" then return value end
    if value == false then return fail("GA_RUNTIME_LOG_FAILED", "Arena diagnostic log reported failure", { code = code }) end
    return gamma_arena_result.ok(true)
end

function Orchestrator:clear_runtime_ui()
    local ui = self.deps.result_ui
    if ui == nil then return gamma_arena_result.ok(false) end
    local errors = {}
    for _, method_name in ipairs({ "clear_countdown", "clear_result" }) do
        local method_ok, method = pcall(function() return ui[method_name] end)
        if method_ok and type(method) == "function" then
            local cleared = call_method("GA_RUNTIME_UI_CLEAR_FAILED", ui, method_name)
            if not cleared.ok then errors[#errors + 1] = cleared.error end
        end
    end
    self.countdown_value = nil
    if #errors > 0 then return fail("GA_RUNTIME_UI_CLEAR_FAILED", "Arena runtime UI could not be removed safely", { errors = errors }) end
    return gamma_arena_result.ok(true)
end

function Orchestrator:living_opponent_count()
    local entities = self.deps.entities
    local ok, snapshot_method, count_method = pcall(function() return entities and entities.registry_snapshot, entities and entities.living_opponent_count end)
    if not ok or type(snapshot_method) ~= "function" or type(count_method) ~= "function" then
        return gamma_arena_result.err("GA_ENTITY_COUNT_UNAVAILABLE", "Opponent registry/count dependencies are unavailable")
    end
    local snapshot_ok, snapshot = pcall(snapshot_method, entities)
    if not snapshot_ok or type(snapshot) ~= "table" or snapshot.state ~= "ACTIVE" then
        return gamma_arena_result.err("GA_ENTITY_COUNT_STATE_INVALID", "Opponent count is valid only for an ACTIVE entity transaction")
    end
    local called, value = pcall(count_method, entities)
    if not called or type(value) ~= "number" or value ~= math.floor(value) or value < 0 then
        return gamma_arena_result.err("GA_ENTITY_COUNT_UNAVAILABLE", "Opponent count failed or returned an invalid value")
    end
    return gamma_arena_result.ok(value)
end

function Orchestrator:advance(event)
    local transition = gamma_arena_state_machine.transition(self.machine_state, event)
    if transition.ok then self.machine_state = transition.value end
    return transition
end

function Orchestrator:teardown_once(reason, preserve_session)
    if self.teardown_done then return gamma_arena_result.ok(false) end
    if type(self.deps.teardown) ~= "function" then
        self.teardown_done = true
        return gamma_arena_result.ok(true)
    end
    local result = safe_result_call("GA_RUNTIME_TEARDOWN_FAILED", self.deps.teardown, reason, preserve_session == true, self.teardown_cycle)
    local pending = result.ok and type(result.value) == "table" and result.value.pending == true
    if result.ok and not pending then self.teardown_done = true end
    return result
end

function Orchestrator:main_menu_action()
    if self.main_menu_executed then return gamma_arena_result.ok(false) end
    local cleanup = self:cleanup_ready_for_disconnect()
    if not cleanup.ok then return cleanup end
    if type(self.deps.disconnect) ~= "function" then
        local unavailable = fail("GA_DISCONNECT_FAILED", "Main-menu disconnect dependency is unavailable")
        pcall(gamma_arena_log.error, unavailable.error.code, unavailable.error.message, unavailable.error.context)
        return unavailable
    end
    local called, value = pcall(self.deps.disconnect)
    local failure = nil
    if not called then
        failure = fail("GA_DISCONNECT_FAILED", "Main-menu disconnect raised an exception", { reason = tostring(value) })
    elseif value == false then
        failure = fail("GA_DISCONNECT_FAILED", "Main-menu disconnect reported failure")
    elseif type(value) == "table" and value.ok == false then
        failure = value
    end
    if failure ~= nil then
        local detail = failure.error or {}
        pcall(gamma_arena_log.error, detail.code or "GA_DISCONNECT_FAILED", detail.message or "Main-menu disconnect failed", detail.context)
        return failure
    end
    self.main_menu_executed = true
    return gamma_arena_result.ok(true)
end

function Orchestrator:cleanup_ready_for_disconnect()
    if not self.cleanup_required then return gamma_arena_result.ok(true) end
    if not self.teardown_done then
        local teardown = self:teardown_once("cleanup_poll", false)
        if not teardown.ok then return teardown end
        if not self.teardown_done then return fail("GA_RUNTIME_CLEANUP_PENDING", "Entity cleanup is still pending across engine frames") end
    end
    local entities = self.deps.entities
    if entities ~= nil then
        local entity_ok, entity_snapshot = pcall(function() return entities:registry_snapshot() end)
        if not entity_ok or type(entity_snapshot) ~= "table" or type(entity_snapshot.state) ~= "string" then
            return fail("GA_RUNTIME_CLEANUP_FAILED", "Entity cleanup state is unavailable")
        end
        if entity_snapshot.state ~= "CLEAN" then
            return fail("GA_RUNTIME_CLEANUP_PENDING", "Entity cleanup is still pending", { state = entity_snapshot.state })
        end
        if not cleanup_registry_empty(entity_snapshot) then
            return fail("GA_RUNTIME_CLEANUP_FAILED", "Clean entity registry must contain exact empty NPC and item arrays")
        end
    end
    local checkpoint = self.deps.checkpoint
    local state_ok, state = pcall(function() return checkpoint and checkpoint:state() end)
    if not state_ok or type(state) ~= "string" then
        return fail("GA_RUNTIME_CLEANUP_FAILED", "Checkpoint cleanup state is unavailable")
    end
    if state == "CLEANING" then
        local updated = call_method("GA_RUNTIME_CLEANUP_FAILED", checkpoint, "update")
        if not updated.ok then return updated end
        state_ok, state = pcall(function() return checkpoint:state() end)
        if not state_ok then return fail("GA_RUNTIME_CLEANUP_FAILED", "Checkpoint cleanup state could not be read safely") end
    end
    if state == "NONE" then
        self.cleanup_required = false
        return gamma_arena_result.ok(true)
    end
    if state == "ERROR" then
        return fail("GA_RUNTIME_CLEANUP_FAILED", "Checkpoint cleanup terminated in ERROR")
    end
    return fail("GA_RUNTIME_CLEANUP_PENDING", "Checkpoint cleanup is still pending", { state = state })
end

function Orchestrator:enter_fatal(result, intent_finalized)
    if type(result) ~= "table" or result.ok ~= false or type(result.error) ~= "table" then
        result = fail("GA_RUNTIME_INTERNAL", "Arena runtime entered fatal routing without a structured error")
    end
    local errors = error_results(result)
    local ui_cleanup = self:clear_runtime_ui()
    if not ui_cleanup.ok then errors[#errors + 1] = ui_cleanup end
    if not intent_finalized then
        local clear_method = self.session ~= nil and "clear_resume_if_matches" or "clear_transient"
        local cleared = call_method("GA_TRANSIENT_CLEAR_FAILED", self.deps.store, clear_method, self.deps.config, self.session)
        if not cleared.ok then errors[#errors + 1] = cleared end
    end
    local cleanup_session = self.session
    self.active = false
    self.pending_resume = nil
    self.checkpoint_reload_expected = false
    self.runtime_stage = "ERROR"
    self.checkpoint_ready = false
    self.machine_state = gamma_arena_state_machine.states.ERROR
    self.cleanup_required = true
    self.pending_victory = false
    self.pending_result = nil
    self.result_kind = nil
    self.pending_callback_error = nil
    self.result_action_locked = true
    self.pending_next_fight_index = nil
    self.pending_disconnect = false
    local teardown = self:teardown_once("fatal", false)
    if not teardown.ok then errors[#errors + 1] = teardown end
    self.session = nil
    for index = 1, #errors do
        local item = errors[index]
        if item and item.error then pcall(gamma_arena_log.error, item.error.code, item.error.message, item.error.context) end
    end
    if not self.fatal_shown then
        self.fatal_shown = true
        local ui = self.deps.ui
        local show = type(ui) == "table" and ui.show_fatal or nil
        local ok, dialog = pcall(show, errors, function() return self:main_menu_action() end)
        if ok then
            self.fatal_dialog = dialog
        else
            pcall(gamma_arena_log.error, "GA_FATAL_UI_FAILED", "Fatal Arena UI could not be shown", { reason = tostring(dialog) })
            self:main_menu_action()
        end
    end
    return result
end

function Orchestrator:on_callback_error(callback_name, reason)
    local failure = fail("GA_CALLBACK_FAILED", "Arena callback failed safely", {
        callback = callback_name,
        reason = tostring(reason)
    })
    if (callback_name == "npc_on_death_callback" or callback_name == "actor_on_before_death") and self:is_active() then
        if self.pending_callback_error == nil then self.pending_callback_error = failure end
        return failure
    end
    return self:enter_fatal(failure)
end

function Orchestrator:on_callback_result_error(callback_name, result, was_active)
    if self.fatal_shown or self.machine_state == gamma_arena_state_machine.states.ERROR then return result end
    if (callback_name == "npc_on_death_callback" or callback_name == "actor_on_before_death") and was_active == true then
        if self.pending_callback_error == nil then self.pending_callback_error = result end
        return result
    end
    local cleanup_callback = callback_name == "actor_on_net_destroy" or callback_name == "on_before_level_changing"
    local inactive_cleanup_update = was_active ~= true and (callback_name == "actor_on_update" or callback_name == "actor_on_first_update")
        and (self.cleanup_required or self.pending_disconnect or self.runtime_stage == "CLEANING")
    if was_active == true or self:is_active() or cleanup_callback or inactive_cleanup_update then return self:enter_fatal(result, cleanup_callback) end
    return result
end

function Orchestrator:on_game_load()
    local ui_cleanup = self:clear_runtime_ui()
    if not ui_cleanup.ok then return self:enter_fatal(ui_cleanup) end
    local checkpoint_load = call_method("GA_CHECKPOINT_REHIDE_FAILED", self.deps.checkpoint, "on_game_load")
    if not checkpoint_load.ok then return self:enter_fatal(checkpoint_restore_failure(checkpoint_load, "Checkpoint load boundary failed during Arena recovery")) end
    self.game_load_seen = true
    self.active = false
    self.session = nil
    self.pending_resume = nil
    self.checkpoint_reload_expected = false
    self.runtime_stage = "AWAITING_ACTIVATION"
    self.checkpoint_ready = false
    self.activation_attempted = false
    self.machine_state = gamma_arena_state_machine.states.IDLE
    if self.pending_load_state_seen then
        self.load_state_seen = true
        self.loaded_session = self.pending_load_state
        self.load_state_error = self.pending_load_state_error
    else
        self.load_state_seen = false
        self.loaded_session = nil
        self.load_state_error = nil
    end
    self.pending_load_state = nil
    self.pending_load_state_seen = false
    self.pending_load_state_error = nil
    self.awaiting_activation = true
    self.teardown_cycle = self.teardown_cycle + 1
    self.teardown_done = false
    self.fatal_shown = false
    self.main_menu_executed = false
    self.fight_spec = nil
    self.catalog_snapshot = nil
    self.countdown_started = nil
    self.active_started = nil
    self.pending_victory = false
    self.pending_result = nil
    self.death_latched = false
    self.result_kind = nil
    self.result_action_locked = false
    self.pending_next_fight_index = nil
    self.next_cleanup_started = false
    self.defeat_cleanup_started = false
    self.pending_disconnect = false
    self.pending_callback_error = nil
    return gamma_arena_result.ok(true)
end

function Orchestrator:load_state(mdata)
    local decoded_session = nil
    local succeeded, result = pcall(function()
        if type(mdata) ~= "table" then return fail("GA_SAVE_STATE_INVALID", "Loaded save metadata must be a table") end
        local payload = mdata.gamma_arena_session
        if payload == nil then return gamma_arena_result.ok(false) end
        local validated = gamma_arena_session_store.validate_arena_session(payload)
        if not validated.ok then return validated end
        local copied, value = pcall(copy_plain, validated.value)
        if not copied then return fail("GA_SESSION_INVALID", "ArenaSession payload is not plain Lua data", { reason = tostring(value) }) end
        decoded_session = value
        return gamma_arena_result.ok(true)
    end)
    if not succeeded then result = fail("GA_SAVE_STATE_INVALID", "Loaded save metadata could not be read safely", { reason = tostring(result) }) end
    self.pending_load_state_seen = true
    if result.ok then
        self.pending_load_state = decoded_session
        self.pending_load_state_error = nil
    else
        self.pending_load_state = nil
        self.pending_load_state_error = result
    end
    if self.awaiting_activation then
        self.load_state_seen = true
        self.loaded_session = self.pending_load_state
        self.load_state_error = self.pending_load_state_error
        self.pending_load_state = nil
        self.pending_load_state_seen = false
        self.pending_load_state_error = nil
    end
    return result
end

function Orchestrator:save_state(mdata)
    if not self:is_active() then return gamma_arena_result.ok(false) end
    if type(mdata) ~= "table" then return fail("GA_SAVE_STATE_INVALID", "Save metadata must be a table") end
    local validated = gamma_arena_session_store.validate_arena_session(self.session)
    if not validated.ok then return validated end
    local copied, value = pcall(copy_plain, validated.value)
    if not copied then return fail("GA_SESSION_SERIALIZE_FAILED", "ArenaSession could not be copied", { reason = tostring(value) }) end
    mdata.gamma_arena_session = value
    return gamma_arena_result.ok(true)
end

function Orchestrator:create_session(request)
    local identity = safe_result_call("GA_SESSION_IDENTITY_FAILED", self.deps.identity, request)
    if not identity.ok then return identity end
    local value = identity.value
    if type(value) ~= "table" then return fail("GA_SESSION_IDENTITY_FAILED", "Session identity must be a table") end
    return gamma_arena_session_store.validate_arena_session({
        schema_version = 1,
        session_id = value.session_id,
        session_nonce = value.session_nonce,
        mode_id = request.mode_id,
        difficulty_id = request.difficulty_id,
        session_seed = request.session_seed,
        fight_index = 0,
        generator_version = 1,
        catalog_revision = 1,
        layout_id = "rostok_arena_v1",
        checkpoint_name = "_gamma_arena_checkpoint",
        phase = gamma_arena_state_machine.states.CHECKPOINTING
    })
end

function Orchestrator:run_preflight()
    local compat = self.deps.compat
    local lookup_ok, preflight = pcall(function() return compat and compat.preflight end)
    if lookup_ok and type(preflight) == "function" then return safe_result_call("GA_PREFLIGHT_FAILED", preflight) end
    return safe_result_call("GA_PREFLIGHT_FAILED", self.deps.preflight)
end

function Orchestrator:activate_once()
    if self.active then return gamma_arena_result.ok(false) end
    if self.activation_attempted then return gamma_arena_result.ok(false) end
    if not self.awaiting_activation then return gamma_arena_result.ok(false) end

    local reconciled = safe_result_call("GA_SETTINGS_RECONCILIATION_FAILED", self.deps.reconcile, self.deps.config)
    if not reconciled.ok then return self:enter_fatal(reconciled) end
    local intents = call_method("GA_INTENT_INSPECTION_FAILED", self.deps.store, "inspect_intents", self.deps.config)
    if not intents.ok then return self:enter_fatal(intents) end
    local state = intents.value or {}
    if state.launch_pending and state.resume_pending then
        return self:enter_fatal(fail("GA_INTENT_CONFLICT", "Launch and resume intents cannot coexist"))
    end

    local has_embedded = self.loaded_session ~= nil or self.load_state_error ~= nil
    if not state.launch_pending and not state.resume_pending then
        if has_embedded then
            return self:enter_fatal(self.load_state_error or fail("GA_RESUME_INTENT_REQUIRED", "Arena checkpoint requires a matching ResumeIntent"))
        end
        self.activation_attempted = true
        self.awaiting_activation = false
        return gamma_arena_result.ok(false)
    end
    if self.load_state_error then
        local load_failure = state.resume_pending and checkpoint_restore_failure(self.load_state_error, "Loaded ArenaSession is invalid for the pending ResumeIntent") or self.load_state_error
        return self:enter_fatal(load_failure)
    end

    if state.launch_pending then
        if self.load_state_seen or self.loaded_session ~= nil then
            return self:enter_fatal(fail("GA_LAUNCH_REQUIRES_NEW_GAME", "Arena launch intent is valid only for a distinct new game"))
        end
        local layout = safe_result_call("GA_ACTOR_LAYOUT_INVALID", self.deps.layout)
        if not layout.ok then return self:enter_fatal(layout) end
        local expected = type(layout.value) == "table" and layout.value.level or nil
        if type(expected) ~= "string" or expected == "" then
            return self:enter_fatal(fail("GA_ACTOR_LAYOUT_INVALID", "Arena layout has no target level"))
        end
        local current = safe_result_call("GA_CURRENT_LEVEL_FAILED", self.deps.current_level)
        if not current.ok then return self:enter_fatal(current) end
        if current.value ~= expected then
            return gamma_arena_result.ok({ route = "deferred", current_level = current.value, expected_level = expected })
        end
    end

    self.activation_attempted = true
    self.awaiting_activation = false
    local started = self:advance(gamma_arena_state_machine.events.START)
    if not started.ok then return self:enter_fatal(started) end

    if state.launch_pending then
        local consumed = call_method("GA_LAUNCH_CONSUME_FAILED", self.deps.store, "consume_launch", self.deps.config, self.deps.launch_options)
        if not consumed.ok then return self:enter_fatal(consumed, true) end
        local preflight = self:run_preflight()
        if not preflight.ok then return self:enter_fatal(preflight, true) end
        local session = self:create_session(consumed.value)
        if not session.ok then return self:enter_fatal(session, true) end
        local advanced = self:advance(gamma_arena_state_machine.events.PREFLIGHT_SUCCEEDED)
        if not advanced.ok then return self:enter_fatal(advanced, true) end
        self.session = session.value
        self.active = true
        self.runtime_stage = "NORMALIZING"
        return gamma_arena_result.ok({ route = "launch", session = self:session_snapshot() })
    end

    if not self.load_state_seen or self.loaded_session == nil then
        return self:enter_fatal(checkpoint_restore_failure(fail("GA_RESUME_SESSION_MISSING", "ResumeIntent requires an embedded ArenaSession")))
    end
    local prepared = call_method("GA_RESUME_INVALID", self.deps.store, "prepare_resume", self.deps.config, self.loaded_session)
    if not prepared.ok then return self:enter_fatal(normalize_resume_preparation(prepared), true) end
    if type(prepared.value) ~= "table" then
        return self:enter_fatal(checkpoint_restore_failure(fail("GA_RESUME_INVALID", "Validated ResumeIntent payload is malformed")), true)
    end
    local preflight = self:run_preflight()
    if not preflight.ok then return self:enter_fatal(preflight) end
    local advanced = self:advance(gamma_arena_state_machine.events.PREFLIGHT_SUCCEEDED)
    if not advanced.ok then return self:enter_fatal(advanced) end
    self.session = self.loaded_session
    self.pending_resume = prepared.value
    local recovery = call_method("GA_CHECKPOINT_RECOVERY_FAILED", self.deps.checkpoint, "begin_resume_recovery", self.session, self.pending_resume)
    if not recovery.ok then return self:enter_fatal(checkpoint_restore_failure(recovery, "Checkpoint adapter could not bind the loaded recovery state")) end
    if recovery.value ~= true then
        return self:enter_fatal(checkpoint_restore_failure(fail("GA_CHECKPOINT_RECOVERY_FAILED", "Checkpoint adapter did not bind the loaded recovery state")))
    end
    self.active = true
    self.runtime_stage = "RESUME_REHIDING"
    return gamma_arena_result.ok({ route = "resume", session = self:session_snapshot(), pending_resume = self:pending_resume_snapshot() })
end

function Orchestrator:layout_snapshot()
    return safe_result_call("GA_ACTOR_LAYOUT_INVALID", self.deps.layout, self.session and self.session.layout_id)
end

function Orchestrator:prepare_fight()
    local catalogs = safe_result_call("GA_CATALOG_LOAD_FAILED", self.deps.catalogs)
    if not catalogs.ok then return catalogs end
    local generated = safe_result_call("GA_FIGHT_GENERATE_FAILED", self.deps.generator, self.session, self.session.fight_index, catalogs.value)
    if not generated.ok then return generated end
    local validated = safe_result_call("GA_FIGHT_VALIDATE_FAILED", self.deps.validator, generated.value, catalogs.value)
    if not validated.ok then return validated end
    local spec = validated.value
    local encoded_ok, encoded = pcall(function() return spec and spec.stable_encode and spec.stable_encode() end)
    local id_ok, fight_id = pcall(function() return spec and spec.fight_id and spec.fight_id() end)
    if not encoded_ok or type(encoded) ~= "string" or encoded == "" or not id_ok or type(fight_id) ~= "string" or fight_id == "" then
        return fail("GA_FIGHT_VALIDATE_FAILED", "Validated fight specification facade is incomplete")
    end
    local logged = self:emit_log("GA_FIGHT_SPEC", "session=" .. tostring(self.session.session_id)
        .. " fight=" .. tostring(self.session.fight_index) .. " seed=" .. tostring(self.session.session_seed)
        .. " spec=" .. encoded, { fight_id = fight_id })
    if not logged.ok then return logged end
    local applied = call_method("GA_ENTITY_APPLY_FAILED", self.deps.entities, "begin_apply", spec, self.session.session_id)
    if not applied.ok then return applied end
    local now = self:clock_now()
    if not now.ok then return now end
    local advanced = self:advance(gamma_arena_state_machine.events.PREPARATION_SUCCEEDED)
    if not advanced.ok then return advanced end
    self.catalog_snapshot = catalogs.value
    self.fight_spec = spec
    self.countdown_started = now.value
    self.countdown_value = nil
    self.pending_victory = false
    self.result_action_locked = false
    self.runtime_stage = "COUNTDOWN"
    return self:update_countdown()
end

function Orchestrator:update_countdown()
    local now = self:clock_now()
    if not now.ok then return now end
    local elapsed = clock_elapsed(self.countdown_started, now.value)
    if elapsed >= COUNTDOWN_DURATION_MS then
        local cleared = call_method("GA_COUNTDOWN_UI_FAILED", self.deps.result_ui, "clear_countdown")
        if not cleared.ok then return cleared end
        self.countdown_value = nil
        self.runtime_stage = "SPAWNING"
        return gamma_arena_result.ok({ stage = "SPAWNING" })
    end
    local value = 3 - math.floor(elapsed / 1000)
    if value ~= self.countdown_value then
        local shown = call_method("GA_COUNTDOWN_UI_FAILED", self.deps.result_ui, "show_countdown", {
            value = value,
            on_main_menu = function()
                return self:route_result_action("main_menu", function() return self:request_main_menu_exit() end)
            end
        })
        if not shown.ok then return shown end
        self.countdown_value = value
    end
    return gamma_arena_result.ok({ stage = "COUNTDOWN", value = value })
end

function Orchestrator:observe_entity_activation()
    local snapshot_ok, snapshot = pcall(function() return self.deps.entities:registry_snapshot() end)
    if not snapshot_ok or type(snapshot) ~= "table" then return fail("GA_ENTITY_REGISTRY_SNAPSHOT_FAILED", "Entity registry snapshot failed safely") end
    if snapshot.state ~= "ACTIVE" then return gamma_arena_result.ok({ stage = "SPAWNING", entity = snapshot.state }) end
    local released = call_method("GA_ACTOR_INPUT_ENABLE_FAILED", self.deps.actor, "release_input")
    if not released.ok then return released end
    local now = self:clock_now()
    if not now.ok then return now end
    local advanced = self:advance(gamma_arena_state_machine.events.COUNTDOWN_FINISHED)
    if not advanced.ok then return advanced end
    self.active_started = now.value
    self.runtime_stage = "ACTIVE"
    local logged = self:emit_log("GA_FIGHT_ACTIVE", "registry_npcs=" .. tostring(#(snapshot.npcs or {}))
        .. " registry_items=" .. tostring(#(snapshot.items or {})), {
            registry_npcs = #(snapshot.npcs or {}), registry_items = #(snapshot.items or {})
        })
    if not logged.ok then return logged end
    return gamma_arena_result.ok({ stage = "ACTIVE" })
end

function Orchestrator:show_victory()
    local acquired = call_method("GA_ACTOR_INPUT_DISABLE_FAILED", self.deps.actor, "acquire_input")
    if not acquired.ok then return acquired end
    local now = self:clock_now()
    if not now.ok then return now end
    local duration = clock_elapsed(self.active_started, now.value)
    local advanced = self:advance(gamma_arena_state_machine.events.VICTORY)
    if not advanced.ok then return advanced end
    self.pending_victory = false
    self.pending_result = nil
    self.result_kind = "victory"
    self.result_action_locked = false
    self.pending_next_fight_index = nil
    self.runtime_stage = "RESULT"
    local logged = self:emit_log("GA_FIGHT_VICTORY", "duration_ms=" .. tostring(duration), { duration_ms = duration })
    if not logged.ok then return logged end
    return call_method("GA_RESULT_UI_FAILED", self.deps.result_ui, "show_result", {
        kind = "victory",
        title_key = "st_gamma_arena_result_victory",
        fight_id = self.fight_spec and self.fight_spec.fight_id and self.fight_spec.fight_id() or nil,
        fight_index = self.session.fight_index,
        duration_ms = duration,
        on_next = function()
            return self:route_result_action("victory_next", function() return self:victory_next_action() end)
        end,
        on_main_menu = function()
            return self:route_result_action("main_menu", function() return self:request_main_menu_exit() end)
        end
    })
end

function Orchestrator:show_defeat()
    local advanced = self:advance(gamma_arena_state_machine.events.DEFEAT)
    if not advanced.ok then return advanced end
    self.pending_result = nil
    self.pending_victory = false
    self.result_kind = "defeat"
    self.result_action_locked = false
    self.pending_next_fight_index = nil
    self.runtime_stage = "RESULT"
    local logged = self:emit_log("GA_FIGHT_DEFEAT", "fight_index=" .. tostring(self.session and self.session.fight_index), {
        fight_index = self.session and self.session.fight_index or nil
    })
    if not logged.ok then return logged end
    return call_method("GA_RESULT_UI_FAILED", self.deps.result_ui, "show_result", {
        kind = "defeat",
        title_key = "st_gamma_arena_result_defeat",
        fight_id = self.fight_spec and self.fight_spec.fight_id and self.fight_spec.fight_id() or nil,
        fight_index = self.session and self.session.fight_index or nil,
        on_next = function()
            return self:route_result_action("defeat_next", function() return self:defeat_next_action() end)
        end,
        on_main_menu = function()
            return self:route_result_action("main_menu", function() return self:request_main_menu_exit() end)
        end
    })
end

function Orchestrator:route_result_action(action_name, action)
    local was_active = self:is_active()
    if type(action) ~= "function" then
        local missing = fail("GA_RESULT_ACTION_FAILED", "Arena result action dependency is unavailable", { action = action_name })
        return self:on_callback_result_error("result_action_" .. tostring(action_name), missing, was_active)
    end
    local called, result = pcall(action)
    if not called then return self:on_callback_error("result_action_" .. tostring(action_name), result) end
    if type(result) ~= "table" or type(result.ok) ~= "boolean" then
        result = fail("GA_RESULT_ACTION_FAILED", "Arena result action returned an invalid Result", {
            action = action_name,
            result_type = type(result)
        })
    end
    if not result.ok then return self:on_callback_result_error("result_action_" .. tostring(action_name), result, was_active) end
    return result
end

function Orchestrator:queue_victory()
    if not self:is_active() or self.runtime_stage ~= "ACTIVE" or self.pending_victory then return gamma_arena_result.ok(false) end
    self.pending_victory = true
    return gamma_arena_result.ok(true)
end

function Orchestrator:resolve_next_fight_index(result_kind)
    local current_index = self.session and self.session.fight_index or nil
    if type(current_index) ~= "number" or current_index ~= math.floor(current_index) or current_index < 0 or current_index > UINT32_MAX then
        return fail("GA_MODE_POLICY_FAILED", "Arena session has no valid persisted fight index")
    end
    if current_index == UINT32_MAX then
        return fail("GA_FIGHT_INDEX_EXHAUSTED", "Arena fight index exhausted the uint32 persistence range", { result_kind = result_kind })
    end
    local policy = self.deps.mode_policy
    local method_ok, next_method = pcall(function() return policy and policy.next_fight_index end)
    if not method_ok or type(next_method) ~= "function" then
        return fail("GA_MODE_POLICY_FAILED", "Arena mode next-fight policy is unavailable")
    end
    local called, next_index = pcall(next_method, current_index, result_kind)
    if not called or type(next_index) ~= "number" or next_index ~= math.floor(next_index)
        or next_index ~= current_index + 1 or next_index < 0 or next_index >= UINT32_MOD then
        return fail("GA_MODE_POLICY_FAILED", "Arena mode returned an invalid next fight index")
    end
    return gamma_arena_result.ok(next_index)
end

function Orchestrator:victory_next_action()
    if not self:is_active() or self.runtime_stage ~= "RESULT" or self.result_action_locked then return gamma_arena_result.ok(false) end
    local next_index = self:resolve_next_fight_index("victory")
    if not next_index.ok then return next_index end
    self.result_action_locked = true
    local cleared = call_method("GA_RESULT_UI_FAILED", self.deps.result_ui, "clear_result")
    if not cleared.ok then self.result_action_locked = false; return cleared end
    self.next_cleanup_started = false
    self.pending_next_fight_index = next_index.value
    self.runtime_stage = "NEXT_CLEANUP"
    return gamma_arena_result.ok(true)
end

function Orchestrator:defeat_next_action()
    if not self:is_active() or self.runtime_stage ~= "RESULT" or self.result_kind ~= "defeat" or self.result_action_locked then
        return gamma_arena_result.ok(false)
    end
    local next_index_result = self:resolve_next_fight_index("defeat")
    if not next_index_result.ok then return next_index_result end
    local next_index = next_index_result.value
    self.result_action_locked = true
    local restored = call_method("GA_CHECKPOINT_RESTORE_FAILED", self.deps.checkpoint, "restore", self.session, next_index)
    if not restored.ok then
        self.result_action_locked = false
        return checkpoint_restore_failure(restored, "ResumeIntent could not be persisted before Arena checkpoint recovery")
    end
    local cleared = call_method("GA_RESULT_UI_FAILED", self.deps.result_ui, "clear_result")
    if not cleared.ok then return cleared end
    local advanced = self:advance(gamma_arena_state_machine.events.NEXT_AFTER_DEFEAT)
    if not advanced.ok then return advanced end
    self.checkpoint_ready = false
    self.fight_spec = nil
    self.catalog_snapshot = nil
    self.pending_result = nil
    self.pending_victory = false
    self.defeat_cleanup_started = false
    self.defeat_cleanup_updates = 0
    self.runtime_stage = "DEFEAT_CLEANUP"
    return gamma_arena_result.ok({ stage = self.runtime_stage, next_fight_index = next_index })
end

function Orchestrator:request_main_menu_exit()
    if not self:is_active() or (self.runtime_stage ~= "RESULT" and self.runtime_stage ~= "COUNTDOWN") or self.result_action_locked then return gamma_arena_result.ok(false) end
    self.result_action_locked = true
    local cleared_ui = self:clear_runtime_ui()
    if not cleared_ui.ok then self.result_action_locked = false; return cleared_ui end
    local cleared = call_method("GA_TRANSIENT_CLEAR_FAILED", self.deps.store, "clear_resume_if_matches", self.deps.config, self.session)
    if not cleared.ok then self.result_action_locked = false; return cleared end
    self.cleanup_required = true
    self.pending_disconnect = true
    local teardown = self:teardown_once("main_menu", false)
    self.active = false
    self.runtime_stage = "CLEANING"
    self.checkpoint_ready = false
    self.pending_victory = false
    self.pending_result = nil
    self.result_kind = nil
    self.fight_spec = nil
    self.catalog_snapshot = nil
    self.session = nil
    self.pending_resume = nil
    return teardown
end

function Orchestrator:drive_next_fight()
    if self.runtime_stage == "NEXT_CLEANUP" then
        if not self.next_cleanup_started then
            local cleanup = call_method("GA_ENTITY_CLEANUP_FAILED", self.deps.entities, "cleanup")
            if not cleanup.ok then return cleanup end
            self.next_cleanup_started = true
        end
        local snapshot_ok, snapshot = pcall(function() return self.deps.entities:registry_snapshot() end)
        if not snapshot_ok or type(snapshot) ~= "table" then return fail("GA_ENTITY_REGISTRY_SNAPSHOT_FAILED", "Entity cleanup registry snapshot failed safely") end
        if snapshot.state == "ERROR" then return fail("GA_ENTITY_CLEANUP_FAILED", "Entity cleanup entered ERROR", { error = snapshot.error }) end
        if snapshot.state ~= "CLEAN" then return gamma_arena_result.ok({ stage = "NEXT_CLEANUP", entity = snapshot.state }) end
        if not cleanup_registry_empty(snapshot) then return fail("GA_ENTITY_CLEANUP_FAILED", "Clean entity registry retained or omitted prior fight id arrays") end
        self.runtime_stage = "NEXT_RESET"
        return gamma_arena_result.ok({ stage = "NEXT_RESET" })
    end
    local layout = self:layout_snapshot()
    if not layout.ok then return layout end
    local reset = call_method("GA_ACTOR_RESET_FAILED", self.deps.actor, "reset_after_victory", layout.value)
    if not reset.ok then return reset end
    if type(reset.value) == "table" and reset.value.pending == true then return gamma_arena_result.ok({ stage = "NEXT_RESET", pending = true }) end
    local next_index = self.pending_next_fight_index
    if type(next_index) ~= "number" or next_index ~= math.floor(next_index)
        or next_index ~= self.session.fight_index + 1 or next_index < 0 or next_index >= UINT32_MOD then
        return fail("GA_MODE_POLICY_FAILED", "Arena mode continuation was not retained exactly across cleanup")
    end
    self.session.fight_index = next_index
    local advanced = self:advance(gamma_arena_state_machine.events.NEXT_AFTER_VICTORY)
    if not advanced.ok then return advanced end
    self.fight_spec = nil
    self.catalog_snapshot = nil
    self.next_cleanup_started = false
    self.pending_next_fight_index = nil
    self.runtime_stage = "PREPARING"
    return gamma_arena_result.ok({ stage = "PREPARING", fight_index = next_index })
end

function Orchestrator:drive_defeat_recovery()
    self.defeat_cleanup_updates = self.defeat_cleanup_updates + 1
    if self.defeat_cleanup_updates > MAX_DEFEAT_RECOVERY_UPDATES then
        return checkpoint_restore_failure(nil, "Lost-fight cleanup exceeded its bounded update budget before checkpoint load")
    end
    if not self.defeat_cleanup_started then
        local cleanup = call_method("GA_ENTITY_CLEANUP_FAILED", self.deps.entities, "cleanup")
        if not cleanup.ok then return checkpoint_restore_failure(cleanup, "Lost-fight entity cleanup failed before checkpoint load") end
        self.defeat_cleanup_started = true
    end
    local snapshot_ok, snapshot = pcall(function() return self.deps.entities:registry_snapshot() end)
    if not snapshot_ok or type(snapshot) ~= "table" then
        return checkpoint_restore_failure(nil, "Lost-fight registry proof is unavailable before checkpoint load")
    end
    if snapshot.state == "ERROR" then
        return checkpoint_restore_failure({ ok = false, error = snapshot.error }, "Lost-fight entity cleanup entered ERROR")
    end
    if snapshot.state ~= "CLEAN" then return gamma_arena_result.ok({ stage = "DEFEAT_CLEANUP", entity = snapshot.state }) end
    if not cleanup_registry_empty(snapshot) then
        return checkpoint_restore_failure(nil, "Lost-fight registry is not exactly empty before checkpoint load")
    end
    local actor_cleanup = call_method("GA_ACTOR_LOADOUT_CLEANUP_FAILED", self.deps.actor, "cleanup_loadout_for_restore")
    if not actor_cleanup.ok then
        return checkpoint_restore_failure(actor_cleanup, "Lost-fight actor loadout cleanup failed before checkpoint load")
    end
    if type(actor_cleanup.value) == "table" and actor_cleanup.value.pending == true then
        return gamma_arena_result.ok({ stage = "DEFEAT_CLEANUP", actor_loadout = "PENDING" })
    end
    self.runtime_stage = "RESTORING"
    return gamma_arena_result.ok({ stage = self.runtime_stage })
end

function Orchestrator:drive_runtime()
    if self:is_active() and self.pending_callback_error ~= nil then
        local pending = self.pending_callback_error
        self.pending_callback_error = nil
        return self:enter_fatal(pending)
    end
    if not self:is_active() then
        if self.cleanup_required then
            local cleanup = self:cleanup_ready_for_disconnect()
            if not cleanup.ok then
                if cleanup.error and cleanup.error.code == "GA_RUNTIME_CLEANUP_PENDING" then
                    return gamma_arena_result.ok({ stage = "CLEANING", pending = true })
                end
                return cleanup
            end
            -- This callback proved entity/checkpoint/actor teardown complete.
            -- Activation of a newly loaded intent begins on the next update.
            if self.pending_disconnect then
                local disconnected = self:main_menu_action()
                if disconnected.ok and self.main_menu_executed then self.pending_disconnect = false end
                return disconnected
            end
            return gamma_arena_result.ok({ stage = "CLEANING", pending = false })
        end
        if self.pending_disconnect then
            local disconnected = self:main_menu_action()
            if disconnected.ok and self.main_menu_executed then self.pending_disconnect = false end
            return disconnected
        end
        local checkpoint = self.deps.checkpoint
        local state_ok, state = pcall(function() return checkpoint and checkpoint:state() end)
        if state_ok and state == "CLEANING" then return call_method("GA_CHECKPOINT_CLEANUP_FAILED", checkpoint, "update") end
        return gamma_arena_result.ok(false)
    end

    if self.runtime_stage == "NORMALIZING" then
        local layout = self:layout_snapshot()
        if not layout.ok then return layout end
        local normalized = call_method("GA_ACTOR_NORMALIZE_FAILED", self.deps.actor, "normalize_for_checkpoint", layout.value)
        if not normalized.ok then return normalized end
        self.runtime_stage = "WAIT_INVENTORY"
        return gamma_arena_result.ok({ stage = self.runtime_stage })
    end

    if self.runtime_stage == "WAIT_INVENTORY" then
        local empty = call_method("GA_ACTOR_INVENTORY_VERIFY_FAILED", self.deps.actor, "verify_inventory_empty")
        if not empty.ok then return empty end
        if empty.value ~= true then return gamma_arena_result.ok({ stage = self.runtime_stage }) end
        local created = call_method("GA_CHECKPOINT_CREATE_FAILED", self.deps.checkpoint, "create", self.session)
        if not created.ok then return created end
        self.runtime_stage = "CHECKPOINTING"
        return gamma_arena_result.ok({ stage = self.runtime_stage })
    end

    if self.runtime_stage == "CHECKPOINTING" or self.runtime_stage == "RESTORING" then
        local updated = call_method("GA_CHECKPOINT_UPDATE_FAILED", self.deps.checkpoint, "update")
        if not updated.ok and self.runtime_stage == "RESTORING" then return checkpoint_restore_failure(updated) end
        if not updated.ok then return updated end
        local state_ok, checkpoint_state = pcall(function() return self.deps.checkpoint:state() end)
        if not state_ok then
            local state_failure = fail("GA_CHECKPOINT_STATE_FAILED", "Checkpoint state could not be read safely")
            if self.runtime_stage == "RESTORING" then return checkpoint_restore_failure(state_failure) end
            return state_failure
        end
        if checkpoint_state == "READY" and self.runtime_stage == "CHECKPOINTING" then
            local advanced = self:advance(gamma_arena_state_machine.events.CHECKPOINT_SUCCEEDED)
            if not advanced.ok then return advanced end
            self.checkpoint_ready = true
            self.runtime_stage = "READY"
        end
        return gamma_arena_result.ok({ stage = self.runtime_stage, checkpoint = checkpoint_state })
    end

    if self.runtime_stage == "RESUME_REHIDING" then
        local updated = call_method("GA_CHECKPOINT_REHIDE_FAILED", self.deps.checkpoint, "update")
        if not updated.ok then return checkpoint_restore_failure(updated) end
        local state_ok, checkpoint_state = pcall(function() return self.deps.checkpoint:state() end)
        if not state_ok then return checkpoint_restore_failure(fail("GA_CHECKPOINT_STATE_FAILED", "Checkpoint state could not be read safely")) end
        if checkpoint_state == "READY" then
            local released = call_method("GA_ACTOR_DEATH_HOLD_RELEASE_FAILED", self.deps.actor, "release_logical_death_hold")
            if not released.ok then return checkpoint_restore_failure(released, "Loaded actor could not leave the logical-death hold safely") end
            local resume = call_method("GA_CHECKPOINT_RESUME_MISSING", self.deps.checkpoint, "take_resume")
            if not resume.ok then return checkpoint_restore_failure(resume, "Completed checkpoint resume is unavailable") end
            if type(resume.value) ~= "table" or resume.value.next_fight_index ~= self.pending_resume.next_fight_index then
                return checkpoint_restore_failure(fail("GA_CHECKPOINT_RECOVERY_MISMATCH", "Checkpoint continuation does not match the prepared ResumeIntent"))
            end
            self.session.fight_index = resume.value.next_fight_index
            self.pending_resume = nil
            local advanced = self:advance(gamma_arena_state_machine.events.CHECKPOINT_SUCCEEDED)
            if not advanced.ok then return checkpoint_restore_failure(advanced) end
            self.checkpoint_ready = true
            self.runtime_stage = "READY"
        end
        return gamma_arena_result.ok({ stage = self.runtime_stage, checkpoint = checkpoint_state })
    end

    if self.runtime_stage == "READY" then
        local updated = call_method("GA_CHECKPOINT_UPDATE_FAILED", self.deps.checkpoint, "update")
        if not updated.ok then return updated end
        self.runtime_stage = "PREPARING"
        return gamma_arena_result.ok({ stage = "PREPARING" })
    end
    if self.runtime_stage == "PREPARING" then return self:prepare_fight() end
    if self.runtime_stage == "COUNTDOWN" then return self:update_countdown() end
    if self.runtime_stage == "SPAWNING" then return self:observe_entity_activation() end
    if self.runtime_stage == "ACTIVE" and self.pending_result == "defeat" then return self:show_defeat() end
    if self.runtime_stage == "ACTIVE" and self.pending_victory then return self:show_victory() end
    if self.runtime_stage == "NEXT_CLEANUP" or self.runtime_stage == "NEXT_RESET" then return self:drive_next_fight() end
    if self.runtime_stage == "DEFEAT_CLEANUP" then return self:drive_defeat_recovery() end
    return gamma_arena_result.ok({ stage = self.runtime_stage })
end

function Orchestrator:update_runtime()
    if not self:is_active() and self.cleanup_required then return self:drive_runtime() end
    local began = call_method("GA_ACTOR_UPDATE_FAILED", self.deps.actor, "begin_update")
    if not began.ok then return began end
    local activated = self:activate_once()
    if not activated.ok then return activated end
    local runtime = self:drive_runtime()
    if not runtime.ok then return runtime end
    local entities = self.deps.entities
    if entities ~= nil then
        local updated = call_method("GA_ENTITY_UPDATE_FAILED", entities, "update")
        if not updated.ok then return updated end
    end
    return runtime
end

function Orchestrator:actor_on_first_update()
    return self:update_runtime()
end

function Orchestrator:actor_on_update()
    return self:update_runtime()
end

function Orchestrator:actor_on_before_death(...)
    if not self:is_active() or self.runtime_stage ~= "ACTIVE" or self.death_latched then return gamma_arena_result.ok(false) end
    local flags = find_death_flags(...)
    if flags == nil then return fail("GA_ACTOR_DEATH_FLAGS_MISSING", "Actor death callback did not provide writable ret_value flags") end
    self.death_latched = true
    flags.ret_value = false
    local held = call_method("GA_ACTOR_DEATH_HOLD_FAILED", self.deps.actor, "hold_after_logical_death")
    if not held.ok then return held end
    self.pending_victory = false
    self.pending_result = "defeat"
    return gamma_arena_result.ok(true)
end

function Orchestrator:npc_on_death_callback(victim, killer)
    if not self:is_active() then return gamma_arena_result.ok(false) end
    local entities = self.deps.entities
    if entities == nil or self.runtime_stage ~= "ACTIVE" then return gamma_arena_result.ok(false) end
    local id_ok, victim_id = pcall(function()
        local accessor = victim and victim.id
        if type(accessor) ~= "function" then return nil end
        return accessor(victim)
    end)
    if not id_ok or type(victim_id) ~= "number" or victim_id ~= math.floor(victim_id) or victim_id < 0 then return gamma_arena_result.ok(false) end
    local accepted = call_method("GA_ENTITY_DEATH_CALLBACK_FAILED", entities, "on_npc_death", victim_id)
    if not accepted.ok or accepted.value ~= true then return accepted end
    local living = self:living_opponent_count()
    if not living.ok then return living end
    if living.value == 0 then return self:queue_victory() end
    return gamma_arena_result.ok(true)
end

function Orchestrator:block_manual_input(...)
    if not self:is_active() then return gamma_arena_result.ok(false) end
    local flags = find_flags(...)
    if flags == nil then return fail("GA_MANUAL_INPUT_FLAGS_MISSING", "Manual save/load callback did not provide writable flags") end
    flags.ret = true
    if type(self.deps.notify) == "function" then
        local ok, reason = pcall(self.deps.notify, "st_gamma_arena_manual_save_disabled")
        if not ok then return fail("GA_MANUAL_INPUT_NOTICE_FAILED", "Manual save/load notice could not be shown", { reason = tostring(reason) }) end
    end
    return gamma_arena_result.ok(true)
end

function Orchestrator:on_before_save_input(...)
    return self:block_manual_input(...)
end

function Orchestrator:on_before_load_input(...)
    return self:block_manual_input(...)
end

function Orchestrator:expect_checkpoint_reload()
    if not self:is_active() then return fail("GA_CHECKPOINT_RELOAD_INACTIVE", "Checkpoint reload can be expected only during Arena") end
    self.checkpoint_reload_expected = true
    self.teardown_done = false
    return gamma_arena_result.ok(true)
end

function Orchestrator:request_checkpoint_restore(next_fight_index)
    if not self:is_checkpoint_ready() then return fail("GA_CHECKPOINT_NOT_READY", "Checkpoint restore requires a ready Arena checkpoint") end
    local restored = call_method("GA_CHECKPOINT_RESTORE_FAILED", self.deps.checkpoint, "restore", self.session, next_fight_index)
    if not restored.ok then return restored end
    self.checkpoint_ready = false
    self.runtime_stage = "RESTORING"
    return gamma_arena_result.ok(true)
end

function Orchestrator:actor_on_net_destroy()
    if not self:is_active() then return gamma_arena_result.ok(false) end
    local preserve = self.checkpoint_reload_expected == true
    self.checkpoint_reload_expected = false
    local ui_cleanup = self:clear_runtime_ui()
    if not preserve then self.cleanup_required = true end
    local result = self:teardown_once(preserve and "checkpoint_reload" or "actor_destroyed", preserve)
    if not ui_cleanup.ok then result = ui_cleanup end
    if not preserve then
        local cleared = call_method("GA_TRANSIENT_CLEAR_FAILED", self.deps.store, "clear_resume_if_matches", self.deps.config, self.session)
        if not cleared.ok then result = cleared end
    end
    self.active = false
    self.runtime_stage = preserve and "RESTORING" or "CLEANING"
    self.checkpoint_ready = false
    if not preserve then
        self.session = nil
        self.pending_resume = nil
    end
    return result
end

function Orchestrator:on_before_level_changing()
    if not self:is_active() then return gamma_arena_result.ok(false) end
    self.cleanup_required = true
    local ui_cleanup = self:clear_runtime_ui()
    local result = self:teardown_once("level_change", false)
    if not ui_cleanup.ok then result = ui_cleanup end
    local cleared = call_method("GA_TRANSIENT_CLEAR_FAILED", self.deps.store, "clear_resume_if_matches", self.deps.config, self.session)
    if not cleared.ok then result = cleared end
    self.active = false
    self.runtime_stage = "CLEANING"
    self.checkpoint_ready = false
    self.session = nil
    self.pending_resume = nil
    return result
end

function new(deps)
    if type(deps) ~= "table" then return nil end
    local value = setmetatable({}, Orchestrator)
    value:__init(deps)
    return value
end
