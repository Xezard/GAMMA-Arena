states = {
    IDLE = "IDLE",
    PREFLIGHT = "PREFLIGHT",
    CHECKPOINTING = "CHECKPOINTING",
    PREPARING = "PREPARING",
    COUNTDOWN = "COUNTDOWN",
    ACTIVE = "ACTIVE",
    RESULT = "RESULT",
    RECOVERING = "RECOVERING",
    EXITING = "EXITING",
    ERROR = "ERROR"
}

events = {
    START = "START",
    PREFLIGHT_SUCCEEDED = "PREFLIGHT_SUCCEEDED",
    PREFLIGHT_FAILED = "PREFLIGHT_FAILED",
    CHECKPOINT_SUCCEEDED = "CHECKPOINT_SUCCEEDED",
    CHECKPOINT_FAILED = "CHECKPOINT_FAILED",
    PREPARATION_SUCCEEDED = "PREPARATION_SUCCEEDED",
    PREPARATION_FAILED = "PREPARATION_FAILED",
    COUNTDOWN_FINISHED = "COUNTDOWN_FINISHED",
    VICTORY = "VICTORY",
    DEFEAT = "DEFEAT",
    NEXT_AFTER_VICTORY = "NEXT_AFTER_VICTORY",
    NEXT_AFTER_DEFEAT = "NEXT_AFTER_DEFEAT",
    CHECKPOINT_RESTORED = "CHECKPOINT_RESTORED",
    CHECKPOINT_RESTORE_FAILED = "CHECKPOINT_RESTORE_FAILED",
    EXIT = "EXIT",
    CLEANUP_SUCCEEDED = "CLEANUP_SUCCEEDED",
    CLEANUP_FAILED = "CLEANUP_FAILED"
}

local state_values = states
local event_values = events
local transitions = {
    [state_values.IDLE] = {
        [event_values.START] = state_values.PREFLIGHT
    },
    [state_values.PREFLIGHT] = {
        [event_values.PREFLIGHT_SUCCEEDED] = state_values.CHECKPOINTING,
        [event_values.PREFLIGHT_FAILED] = state_values.ERROR,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.CHECKPOINTING] = {
        [event_values.CHECKPOINT_SUCCEEDED] = state_values.PREPARING,
        [event_values.CHECKPOINT_FAILED] = state_values.ERROR,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.PREPARING] = {
        [event_values.PREPARATION_SUCCEEDED] = state_values.COUNTDOWN,
        [event_values.PREPARATION_FAILED] = state_values.ERROR,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.COUNTDOWN] = {
        [event_values.COUNTDOWN_FINISHED] = state_values.ACTIVE,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.ACTIVE] = {
        [event_values.VICTORY] = state_values.RESULT,
        [event_values.DEFEAT] = state_values.RESULT,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.RESULT] = {
        [event_values.NEXT_AFTER_VICTORY] = state_values.PREPARING,
        [event_values.NEXT_AFTER_DEFEAT] = state_values.RECOVERING,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.RECOVERING] = {
        [event_values.CHECKPOINT_RESTORED] = state_values.PREPARING,
        [event_values.CHECKPOINT_RESTORE_FAILED] = state_values.ERROR,
        [event_values.EXIT] = state_values.EXITING
    },
    [state_values.EXITING] = {
        [event_values.CLEANUP_SUCCEEDED] = state_values.IDLE,
        [event_values.CLEANUP_FAILED] = state_values.ERROR
    },
    [state_values.ERROR] = {
        [event_values.EXIT] = state_values.EXITING
    }
}

function transition(current, event)
    local next_state = transitions[current] and transitions[current][event]
    if next_state == nil then
        return gamma_arena_result.err("GA_STATE_TRANSITION_INVALID", "State transition is not allowed", {
            current = current,
            event = event
        })
    end
    return gamma_arena_result.ok(next_state)
end
