end

local function default_disconnect()
    return exec_console_cmd("disconnect")
end

local function neutral_teardown()
    return gamma_arena_result.ok(true)
end

local function teardown_clock_value(clock)
    if type(clock) ~= "function" then
        return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_CLOCK_FAILED", "Teardown clock is unavailable")
    end
    local called, value = pcall(clock)
    if not called then
        return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_CLOCK_FAILED", "Teardown clock raised an exception", { reason = tostring(value) })
    end
    if type(value) == "table" and type(value.ok) == "boolean" then
        if not value.ok then return value end
        value = value.value
    end
    if type(value) ~= "number" or value ~= math.floor(value) or value < 0 or value >= UINT32_MOD then
        return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_CLOCK_FAILED", "Teardown clock must return a uint32 millisecond value")
    end
    return gamma_arena_result.ok(value)
end

local function teardown_elapsed(started, current)
    if current >= started then return current - started end
    return (UINT32_MOD - started) + current
end

local function teardown_adapter_method(adapter, method_name, ...)
    local method_ok, method = pcall(function() return adapter and adapter[method_name] end)
    if not method_ok or type(method) ~= "function" then
        return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_FAILED", "Runtime teardown adapter method is unavailable", { method = method_name })
    end
    local called, result = pcall(method, adapter, ...)
    if not called then
        return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_FAILED", "Runtime teardown adapter method raised an exception", {
            method = method_name,
            reason = tostring(result)
        })
    end
    if type(result) ~= "table" or type(result.ok) ~= "boolean" then
        return gamma_arena_result.err("GA_RUNTIME_TEARDOWN_FAILED", "Runtime teardown adapter method returned an invalid Result", { method = method_name })
    end
    return result
end

function step_entity_cleanup(entity_adapter, context, options)
    context = context or {}
    options = options or {}
    local timeout_ms = options.timeout_ms or 10000
    local max_updates = options.max_updates or 64
    if type(timeout_ms) ~= "number" or timeout_ms ~= math.floor(timeout_ms) or timeout_ms < 0 or timeout_ms >= UINT32_MOD
        or type(max_updates) ~= "number" or max_updates ~= math.floor(max_updates) or max_updates < 1
        or max_updates > MAX_TEARDOWN_UPDATES then
        return gamma_arena_result.err("GA_ENTITY_TEARDOWN_INVALID", "Entity teardown bounds are invalid")
    end
    if context.started ~= true then
        local cleanup = teardown_adapter_method(entity_adapter, "cleanup")
        if not cleanup.ok then return cleanup end
        local started = teardown_clock_value(options.clock)
        if not started.ok then return started end
        context.started = true
        context.started_at = started.value
        context.updates = 0
    end
    local snapshot_ok, snapshot = pcall(function() return entity_adapter:registry_snapshot() end)
    if not snapshot_ok or type(snapshot) ~= "table" or type(snapshot.state) ~= "string" then
        return gamma_arena_result.err("GA_ENTITY_TEARDOWN_FAILED", "Entity cleanup state is unavailable")
    end
    if snapshot.state == "CLEAN" then return gamma_arena_result.ok({ state = "CLEAN", updates = context.updates, pending = false }) end
    if snapshot.state == "ERROR" then
        return gamma_arena_result.err("GA_ENTITY_TEARDOWN_FAILED", "Entity cleanup terminated in ERROR", { updates = context.updates })
    end
    if snapshot.state ~= "CLEANING" and snapshot.state ~= "ROLLING_BACK" and snapshot.state ~= "STOPPING" then
        return gamma_arena_result.err("GA_ENTITY_TEARDOWN_FAILED", "Entity cleanup entered an unexpected state", { state = snapshot.state, updates = context.updates })
    end
    if context.updates >= max_updates then
        return gamma_arena_result.err("GA_ENTITY_TEARDOWN_EXHAUSTED", "Entity cleanup exhausted its cross-frame update budget", { updates = context.updates, max_updates = max_updates })
    end
    local current = teardown_clock_value(options.clock)
    if not current.ok then return current end
    if teardown_elapsed(context.started_at, current.value) > timeout_ms then
        return gamma_arena_result.err("GA_ENTITY_TEARDOWN_TIMEOUT", "Entity cleanup exceeded its cross-frame wrap-safe deadline", { updates = context.updates, timeout_ms = timeout_ms })
    end
    if context.last_update_at == current.value then
        return gamma_arena_result.ok({ state = snapshot.state, updates = context.updates, pending = true })
    end
    -- safe_release_manager advances on later engine frames. Exactly one entity
    -- update is permitted per callback; the composition retains this context.
    local updated = teardown_adapter_method(entity_adapter, "update")
    if not updated.ok then return updated end
    context.updates = context.updates + 1
    context.last_update_at = current.value
    return gamma_arena_result.ok({ state = snapshot.state, updates = context.updates, pending = true })
end

function step_actor_cleanup(actor_adapter, context, options)
    context = context or {}
    options = options or {}
    local timeout_ms = options.timeout_ms or 10000
    local max_updates = options.max_updates or 64
    if type(timeout_ms) ~= "number" or timeout_ms ~= math.floor(timeout_ms) or timeout_ms < 0 or timeout_ms >= UINT32_MOD
        or type(max_updates) ~= "number" or max_updates ~= math.floor(max_updates) or max_updates < 1
        or max_updates > MAX_TEARDOWN_UPDATES then
        return gamma_arena_result.err("GA_ACTOR_TEARDOWN_INVALID", "Actor teardown bounds are invalid")
    end
    local current = teardown_clock_value(options.clock)
    if not current.ok then return current end
    if context.started ~= true then
        context.started = true
        context.started_at = current.value
        context.updates = 0
    end
    if teardown_elapsed(context.started_at, current.value) > timeout_ms then
        return gamma_arena_result.err("GA_ACTOR_TEARDOWN_TIMEOUT", "Actor loadout cleanup exceeded its cross-frame wrap-safe deadline", { updates = context.updates, timeout_ms = timeout_ms })
    end
    if context.updates >= max_updates then
        return gamma_arena_result.err("GA_ACTOR_TEARDOWN_EXHAUSTED", "Actor loadout cleanup exhausted its cross-frame update budget", { updates = context.updates, max_updates = max_updates })
    end
    if context.last_update_at == current.value then
        return gamma_arena_result.ok({ pending = true, stage = "actor", updates = context.updates })
    end
    local actor = teardown_adapter_method(actor_adapter, "cleanup")
    if not actor.ok then return actor end
    context.updates = context.updates + 1
    context.last_update_at = current.value
    if type(actor.value) == "table" and actor.value.pending == true then
        return gamma_arena_result.ok({ pending = true, stage = "actor", updates = context.updates })
    end
    return gamma_arena_result.ok({ pending = false, stage = "actor", updates = context.updates })
end

local function default_layout()
    local catalogs = gamma_arena_catalog.load()
    if not catalogs.ok then return catalogs end
    local layout = catalogs.value and catalogs.value.layouts and catalogs.value.layouts.rostok_arena_v1
    if type(layout) ~= "table" then return gamma_arena_result.err("GA_ACTOR_LAYOUT_INVALID", "Rostok Arena layout is unavailable") end
    return gamma_arena_result.ok(layout)
end

local function default_runtime_layout_adapter()
    return gamma_arena_layout_adapter.new({
        resolve_anchor = function(path)
            local called, path_object = pcall(function() return patrol(path) end)
            if not called or path_object == nil then
                return gamma_arena_result.err("GA_LAYOUT_BASE_ANCHOR_INVALID", "Required Arena patrol anchor is unavailable", {
                    path = path,
                    reason = called and nil or tostring(path_object)
                })
            end
            local resolved, position, level_vertex_id, game_vertex_id = pcall(function()
                return path_object:point(0), path_object:level_vertex_id(0), path_object:game_vertex_id(0)
            end)
            if not resolved then
                return gamma_arena_result.err("GA_LAYOUT_BASE_ANCHOR_INVALID", "Required Arena patrol anchor could not be read safely", {
                    path = path,
                    reason = tostring(position)
                })
            end
            return gamma_arena_result.ok({
                position = position,
                level_vertex_id = level_vertex_id,
                game_vertex_id = game_vertex_id
            })
        end,
        project_vertex = function(level_vertex_id, direction_x, direction_z, radius)
            local called, projected = pcall(function()
                local direction = vector()
                direction:set(direction_x, 0, direction_z)
                return level.vertex_in_direction(level_vertex_id, direction, radius)
            end)
            if not called then
                return gamma_arena_result.err("GA_LAYOUT_VERTEX_PROJECTION_FAILED", "Arena graph projection failed safely", {
                    level_vertex_id = level_vertex_id,
                    radius = radius,
                    reason = tostring(projected)
                })
            end
            return gamma_arena_result.ok(projected)
        end,
        vertex_position = function(level_vertex_id)
            local called, position = pcall(level.vertex_position, level_vertex_id)
            if not called then
                return gamma_arena_result.err("GA_LAYOUT_VERTEX_POSITION_FAILED", "Arena graph vertex position failed safely", {
                    level_vertex_id = level_vertex_id,
                    reason = tostring(position)
                })
            end
            return gamma_arena_result.ok(position)
        end,
        log_warn = function(code, message, context) gamma_arena_log.warn(code, message, context) end
    })
end

local function runtime_object_id(object)
    local ok, value = pcall(function() return object and object.id end)
    if ok and type(value) == "function" then
        local called, id = pcall(value, object)
        if called and type(id) == "number" and id == math.floor(id) and id >= 0 then return id end
    elseif ok and type(value) == "number" and value == math.floor(value) and value >= 0 then
        return value
    end
    return nil
end

local function runtime_game_object_id(object)
    local looked_up, method = pcall(function() return object and object.id end)
    if not looked_up or type(method) ~= "function" then return nil end
    local called, id = pcall(method, object)
    if not called or type(id) ~= "number" or id ~= id or id == math.huge or id == -math.huge
        or id ~= math.floor(id) or id < 0 then
        return nil
    end
    return id
end

function actor_ownership_matches(candidate, current_actor, session_active, current_level)
    if session_active ~= true or current_level ~= "l05_bar" then return false end
    local candidate_id = runtime_game_object_id(candidate)
    local actor_id = runtime_game_object_id(current_actor)
    return candidate_id ~= nil and actor_id ~= nil and candidate_id == actor_id
end

local function runtime_parent_id(object)
    local ok, value = pcall(function() return object and object.parent_id end)
    if ok and type(value) == "function" then
        local called, id = pcall(value, object)
        if called and type(id) == "number" and id == math.floor(id) and id >= 0 then return id end
    elseif ok and type(value) == "number" and value == math.floor(value) and value >= 0 then
        return value
    end
    return nil
end

local function runtime_section_name(object)
    local ok, value = pcall(function() return object and object.section_name end)
    if ok and type(value) == "function" then
        local called, section = pcall(value, object)
        if called and type(section) == "string" then return section end
    elseif ok and type(value) == "string" then
        return value
    end
    return nil
end

local function runtime_ammo_quantity(object, is_ammo)
    if not is_ammo then return 1 end
    for _, field in ipairs({ "a_elapsed", "ammo_elapsed", "count", "quantity" }) do
        local ok, value = pcall(function() return object and object[field] end)
        if ok and type(value) == "function" then
            local called, quantity = pcall(value, object)
            if called and type(quantity) == "number" then return quantity end
        elseif ok and type(value) == "number" then
            return value
        end
    end
    return nil
end

local function expected_created_quantity(descriptor, index, entity_count, ammo_box_size)
    if descriptor.ammo ~= true then return nil end
    local expected_entities = math.floor((descriptor.count + ammo_box_size - 1) / ammo_box_size)
    if entity_count ~= expected_entities then return nil end
    local remaining = descriptor.count - ((index - 1) * ammo_box_size)
    if remaining < 1 then return nil end
    return math.min(ammo_box_size, remaining)
end

function new_runtime_entity_exists_port(provider, error_code)
    local code = error_code or "GA_ACTOR_LOADOUT_EXISTENCE_FAILED"
    return function(id)
        if type(provider) ~= "function" then return gamma_arena_result.err(code, "ALife provider is unavailable", { id = id }) end
        local service_ok, service = pcall(provider)
        if not service_ok or service == nil then return gamma_arena_result.err(code, "ALife service lookup failed", { id = id }) end
        local method_ok, method = pcall(function() return service.object end)
        if not method_ok or type(method) ~= "function" then return gamma_arena_result.err(code, "ALife object lookup API is unavailable", { id = id }) end
        local called, value = pcall(method, service, id)
        if not called then return gamma_arena_result.err(code, "ALife object lookup failed safely", { id = id, reason = tostring(value) }) end
        return gamma_arena_result.ok(value ~= nil)
    end
end

local runtime_actor_item_exists = new_runtime_entity_exists_port(function() return type(alife) == "function" and alife() or nil end)
local runtime_arena_entity_exists = new_runtime_entity_exists_port(function() return type(alife) == "function" and alife() or nil end, "GA_ENTITY_EXISTENCE_FAILED")
local ACTOR_LOADOUT_OWNER_KEY = "gamma_arena_actor_owner"

local function actor_loadout_failure(code, message, context)
    return gamma_arena_result.err(code, message, context or {})
end

local function actor_loadout_call(code, fn, ...)
    if type(fn) ~= "function" then return actor_loadout_failure(code, "Actor loadout dependency is unavailable") end
    local called, value = pcall(fn, ...)
    if not called then return actor_loadout_failure(code, "Actor loadout dependency failed safely", { reason = tostring(value) }) end
    if type(value) == "table" and type(value.ok) == "boolean" then return value end
    if value == false then return actor_loadout_failure(code, "Actor loadout dependency reported failure") end
    return gamma_arena_result.ok(value)
end

function new_actor_loadout_port(ports)
    ports = ports or {}
    local owned_records = {}
    local token_sequence = 0
    local equipment = { state = "IDLE" }
    local cleanup
    local function normalize_entities(value)
        local single = actor_loadout_call("GA_ACTOR_LOADOUT_ENTITY_INVALID", ports.entity_id, value)
        if single.ok and type(single.value) == "number" then return { value } end
        if type(value) ~= "table" or #value < 1 then return nil end
        local entities = {}
        for index = 1, #value do entities[index] = value[index] end
        return entities
    end
    local function copy_records(records)
        local values = {}
        for index, record in ipairs(records) do
            values[index] = {
                id = record.id,
                parent_id = record.parent_id,
                section = record.section,
                token = record.token,
                role = record.role,
                authorized = record.authorized == true,
                release_submitted = record.release_submitted == true
            }
        end
        return values
    end
    local function rollback(created, cause)
        owned_records = copy_records(created)
        local cleaned = cleanup()
        if not cleaned.ok then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_ROLLBACK_FAILED", "Actor loadout failed and reuse-safe rollback also failed", {
                cause = cause.error,
                cleanup = cleaned.error
            })
        end
        return cause
    end
    local function save_and_verify_tag(record)
        local saved = actor_loadout_call("GA_ACTOR_LOADOUT_TAG_WRITE_FAILED", ports.save_owner_tag, record.id, record.token)
        if not saved.ok then return saved end
        local loaded = actor_loadout_call("GA_ACTOR_LOADOUT_TAG_READ_FAILED", ports.load_owner_tag, record.id)
        if not loaded.ok then return loaded end
        if loaded.value ~= record.token then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_TAG_VERIFY_FAILED", "Actor item ownership token did not round-trip", { id = record.id })
        end
        return gamma_arena_result.ok(true)
    end
    local function current_identity(record, current)
        local id = actor_loadout_call("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", ports.entity_id, current)
        if not id.ok then return id end
        if type(id.value) ~= "number" or id.value ~= math.floor(id.value) or id.value < 0 then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", "Current actor item id proof is malformed", { id = record.id })
        end
        if id.value ~= record.id then return gamma_arena_result.ok({ match = false, field = "id" }) end
        local parent = actor_loadout_call("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", ports.entity_parent_id, current)
        if not parent.ok then return parent end
        if type(parent.value) ~= "number" or parent.value ~= math.floor(parent.value) or parent.value < 0 then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", "Current actor item parent proof is malformed", { id = record.id })
        end
        if parent.value ~= record.parent_id then return gamma_arena_result.ok({ match = false, field = "parent" }) end
        local section = actor_loadout_call("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", ports.entity_section, current)
        if not section.ok then return section end
        if type(section.value) ~= "string" or section.value == "" then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", "Current actor item section proof is malformed", { id = record.id })
        end
        if section.value ~= record.section then return gamma_arena_result.ok({ match = false, field = "section" }) end
        return gamma_arena_result.ok({ match = true })
    end
    local function current_ownership(record, current)
        local identity = current_identity(record, current)
        if not identity.ok or identity.value.match ~= true then return identity end
        local tag = actor_loadout_call("GA_ACTOR_LOADOUT_TAG_READ_FAILED", ports.load_owner_tag, record.id)
        if not tag.ok then return tag end
        if tag.value ~= nil and type(tag.value) ~= "string" then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_OWNERSHIP_PROOF_INVALID", "Current actor item ownership token proof is malformed", { id = record.id })
        end
        if tag.value ~= record.token then return gamma_arena_result.ok({ match = false, field = "token" }) end
        return identity
    end
    local function apply(actor, loadout)
        if #owned_records > 0 then return actor_loadout_failure("GA_ACTOR_LOADOUT_BUSY", "Prior Arena actor items are still owned or pending cleanup") end
        local actor_id = actor_loadout_call("GA_ACTOR_LOADOUT_ACTOR_INVALID", ports.actor_id, actor)
        if not actor_id.ok or type(actor_id.value) ~= "number" then return actor_id.ok and actor_loadout_failure("GA_ACTOR_LOADOUT_ACTOR_INVALID", "Arena actor has no numeric id") or actor_id end
        local ownership = actor_loadout_call("GA_ACTOR_LOADOUT_OWNERSHIP_TOKEN_INVALID", ports.ownership_token, actor, actor_id.value)
        if not ownership.ok then return ownership end
        if type(ownership.value) ~= "string" or ownership.value == "" then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_OWNERSHIP_TOKEN_INVALID", "Arena actor loadout requires a non-empty session ownership token")
        end
        if type(loadout) ~= "table" or type(loadout.consumables) ~= "table" or type(loadout.knife) ~= "string" or loadout.knife == "" then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_INVALID", "Validated actor loadout is malformed")
        end
        local started = actor_loadout_call("GA_ACTOR_LOADOUT_CLOCK_FAILED", ports.clock)
        if not started.ok or type(started.value) ~= "number" or started.value ~= math.floor(started.value) or started.value < 0 or started.value >= UINT32_MOD then
            return started.ok and actor_loadout_failure("GA_ACTOR_LOADOUT_CLOCK_FAILED", "Actor loadout clock must return uint32 milliseconds") or started
        end
        local timeout_ms = ports.timeout_ms or 5000
        if type(timeout_ms) ~= "number" or timeout_ms ~= math.floor(timeout_ms) or timeout_ms < 0 or timeout_ms >= UINT32_MOD then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_EQUIP_TIMEOUT_INVALID", "Actor equipment timeout must be a bounded uint32 duration")
        end
        local box_size = actor_loadout_call("GA_ACTOR_LOADOUT_AMMO_BOX_SIZE_INVALID", ports.ammo_box_size, loadout.ammo)
        if not box_size.ok then return box_size end
        if type(box_size.value) ~= "number" or box_size.value ~= math.floor(box_size.value) or box_size.value < 1 or box_size.value >= UINT32_MOD
            or type(loadout.ammo_boxes) ~= "number" or loadout.ammo_boxes ~= math.floor(loadout.ammo_boxes) or loadout.ammo_boxes < 1 then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_AMMO_BOX_SIZE_INVALID", "Validated ammo boxes and effective box_size must be positive bounded integers", { section = loadout.ammo })
        end
        local ammo_rounds = loadout.ammo_boxes * box_size.value
        if ammo_rounds ~= math.floor(ammo_rounds) or ammo_rounds < 1 or ammo_rounds >= UINT32_MOD then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_AMMO_ROUNDS_INVALID", "Actor ammo boxes cannot be translated to a bounded exact round count", { section = loadout.ammo, ammo_boxes = loadout.ammo_boxes, box_size = box_size.value })
        end
        if type(loadout.bonus_ammo) ~= "table" or type(loadout.bonus_ammo.section) ~= "string" or loadout.bonus_ammo.section == ""
            or type(loadout.bonus_ammo.boxes) ~= "number" or loadout.bonus_ammo.boxes ~= math.floor(loadout.bonus_ammo.boxes)
            or loadout.bonus_ammo.boxes < 1 then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_AMMO_BOX_SIZE_INVALID", "Validated bonus ammo boxes must be positive bounded integers")
        end
        local bonus_box_size = actor_loadout_call("GA_ACTOR_LOADOUT_AMMO_BOX_SIZE_INVALID", ports.ammo_box_size, loadout.bonus_ammo.section)
        if not bonus_box_size.ok then return bonus_box_size end
        if type(bonus_box_size.value) ~= "number" or bonus_box_size.value ~= math.floor(bonus_box_size.value)
            or bonus_box_size.value < 1 or bonus_box_size.value >= UINT32_MOD then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_AMMO_BOX_SIZE_INVALID", "Validated bonus ammo and effective box_size must be positive bounded integers", { section = loadout.bonus_ammo.section, role = "bonus_ammo" })
        end
        local bonus_ammo_rounds = loadout.bonus_ammo.boxes * bonus_box_size.value
        if bonus_ammo_rounds ~= math.floor(bonus_ammo_rounds) or bonus_ammo_rounds < 1 or bonus_ammo_rounds >= UINT32_MOD then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_AMMO_ROUNDS_INVALID", "Actor bonus ammo boxes cannot be translated to a bounded exact round count", { section = loadout.bonus_ammo.section, ammo_boxes = loadout.bonus_ammo.boxes, box_size = bonus_box_size.value, role = "bonus_ammo" })
        end
        local descriptors = {
            { section = loadout.weapon, count = 1, ammo = false, role = "weapon" },
            { section = loadout.ammo, count = ammo_rounds, ammo = true, role = "ammo", box_size = box_size.value },
            { section = loadout.bonus_ammo.section, count = bonus_ammo_rounds, ammo = true, role = "bonus_ammo", box_size = bonus_box_size.value },
            { section = loadout.outfit, count = 1, ammo = false, role = "outfit" },
            { section = loadout.knife, count = 1, ammo = false, role = "knife" }
        }
        for _, section in ipairs(loadout.consumables) do descriptors[#descriptors + 1] = { section = section, count = 1, ammo = false, role = "consumable" } end
        local created, seen = {}, {}
        for _, descriptor in ipairs(descriptors) do
            if type(descriptor.section) ~= "string" or descriptor.section == "" or type(descriptor.count) ~= "number" or descriptor.count ~= math.floor(descriptor.count) or descriptor.count < 1 then
                return rollback(created, actor_loadout_failure("GA_ACTOR_LOADOUT_INVALID", "Validated actor descriptor is malformed"))
            end
            local result = actor_loadout_call("GA_ACTOR_LOADOUT_CREATE_FAILED", ports.create_item, descriptor.section, actor, descriptor.count, descriptor.ammo)
            if not result.ok then return rollback(created, result) end
            local entities = normalize_entities(result.value)
            if entities == nil then return rollback(created, actor_loadout_failure("GA_ACTOR_LOADOUT_CREATE_FAILED", "Actor item creation returned no server entities", { section = descriptor.section })) end
            local descriptor_entries, descriptor_failure = {}, nil
            for index, entity in ipairs(entities) do
                local id = actor_loadout_call("GA_ACTOR_LOADOUT_ENTITY_INVALID", ports.entity_id, entity)
                if not id.ok or type(id.value) ~= "number" or id.value ~= math.floor(id.value) or id.value < 0 or seen[id.value] then
                    descriptor_failure = descriptor_failure or (id.ok and actor_loadout_failure("GA_ACTOR_LOADOUT_ENTITY_INVALID", "Actor item id is invalid or duplicated", { section = descriptor.section, index = index }) or id)
                else
                    seen[id.value] = true
                    token_sequence = token_sequence + 1
                    local entry = { id = id.value, parent_id = actor_id.value, section = descriptor.section, role = descriptor.role, token = ownership.value .. ":" .. tostring(token_sequence) .. ":" .. tostring(id.value), authorized = false, release_submitted = false }
                    created[#created + 1] = entry
                    local tagged = save_and_verify_tag(entry)
                    if tagged.ok then entry.authorized = true else descriptor_failure = descriptor_failure or tagged end
                    local parent = actor_loadout_call("GA_ACTOR_LOADOUT_OWNER_INVALID", ports.entity_parent_id, entity)
                    local section = actor_loadout_call("GA_ACTOR_LOADOUT_SECTION_INVALID", ports.entity_section, entity)
                    local quantity = actor_loadout_call("GA_ACTOR_LOADOUT_QUANTITY_INVALID", ports.item_quantity, entity, descriptor.ammo)
                    local proof_failure = not parent.ok and parent or (not section.ok and section or (not quantity.ok and quantity or nil))
                    local quantity_value = quantity.value
                    if proof_failure == nil and quantity_value == nil then
                        quantity_value = expected_created_quantity(descriptor, index, #entities, descriptor.box_size)
                    end
                    if proof_failure == nil and parent.value ~= actor_id.value then proof_failure = actor_loadout_failure("GA_ACTOR_LOADOUT_OWNER_INVALID", "Created actor item has a foreign parent", { id = id.value }) end
                    if proof_failure == nil and section.value ~= descriptor.section then proof_failure = actor_loadout_failure("GA_ACTOR_LOADOUT_SECTION_INVALID", "Created actor item section differs from FightSpec", { id = id.value }) end
                    if proof_failure == nil and (type(quantity_value) ~= "number" or quantity_value ~= math.floor(quantity_value) or quantity_value < 1) then proof_failure = actor_loadout_failure("GA_ACTOR_LOADOUT_QUANTITY_INVALID", "Created actor item quantity is invalid", { id = id.value }) end
                    if proof_failure ~= nil then
                        descriptor_failure = descriptor_failure or proof_failure
                    else
                        descriptor_entries[#descriptor_entries + 1] = { record = entry, quantity = quantity_value }
                    end
                end
            end
            if descriptor_failure ~= nil then return rollback(created, descriptor_failure) end
            local total = 0
            for _, entry in ipairs(descriptor_entries) do total = total + entry.quantity end
            if total ~= descriptor.count then return rollback(created, actor_loadout_failure("GA_ACTOR_LOADOUT_QUANTITY_MISMATCH", "Created actor item quantity differs from FightSpec", { section = descriptor.section, expected = descriptor.count, actual = total })) end
        end
        owned_records = copy_records(created)
        equipment = {
            state = "WAIT_ACTOR_LOADOUT",
            phase = "SUBMIT_SLOT",
            role_index = 1,
            slots = {},
            actor = actor,
            actor_id = actor_id.value,
            started_at = started.value,
            last_progress_at = started.value,
            timeout_ms = timeout_ms,
            ammo_section = loadout.ammo,
            reserve_rounds = ammo_rounds,
            bonus_ammo_rounds = bonus_ammo_rounds,
            summary = nil
        }
        return gamma_arena_result.ok({ created_ids = (function() local ids = {}; for index, record in ipairs(owned_records) do ids[index] = record.id end; return ids end)() })
    end
    local equipment_roles = { "outfit", "knife", "weapon" }
    local function equipment_record(role)
        local found = nil
        for _, record in ipairs(owned_records) do
            if record.role == role then
                if found ~= nil then return nil end
                found = record
            end
        end
        return found
    end
    local function equipment_wait_context(elapsed_since_progress_ms, total_elapsed_ms)
        local pending_slot = equipment.pending_slot
        local role, section, slot
        if type(pending_slot) == "table" then
            role = pending_slot.role
            section = pending_slot.section
            slot = pending_slot.slot
        else
            if equipment.phase == "SUBMIT_SLOT" then
                role = equipment_roles[equipment.role_index]
            elseif equipment.phase == "CHARGE_OUTFIT" then
                role = "outfit"
            elseif equipment.phase == "SUBMIT_MAGAZINE" or equipment.phase == "WAIT_MAGAZINE_VERIFY"
                or equipment.phase == "SUBMIT_ACTIVE" or equipment.phase == "WAIT_ACTIVE_VERIFY" then
                role = "weapon"
            end
            local record = role ~= nil and equipment_record(role) or nil
            section = record and record.section or nil
            slot = role ~= nil and equipment.slots[role] or nil
        end
        return {
            phase = equipment.phase,
            role = role,
            section = section,
            slot = slot,
            elapsed_since_progress_ms = elapsed_since_progress_ms,
            total_elapsed_ms = total_elapsed_ms,
            timeout_ms = equipment.timeout_ms
        }
    end
    local function pending_equipment(progressed)
        local now = actor_loadout_call("GA_ACTOR_LOADOUT_CLOCK_FAILED", ports.clock)
        if not now.ok then return now end
        if type(now.value) ~= "number" or now.value ~= math.floor(now.value) or now.value < 0 or now.value >= UINT32_MOD then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_CLOCK_FAILED", "Actor loadout clock must return uint32 milliseconds")
        end
        local total_elapsed_ms = teardown_elapsed(equipment.started_at, now.value)
        if progressed == true then
            equipment.last_progress_at = now.value
        else
            local elapsed_since_progress_ms = teardown_elapsed(equipment.last_progress_at, now.value)
            if elapsed_since_progress_ms > equipment.timeout_ms then
                return actor_loadout_failure(
                    "GA_ACTOR_LOADOUT_EQUIP_TIMEOUT",
                    "Actor equipment made no progress before deadline",
                    equipment_wait_context(elapsed_since_progress_ms, total_elapsed_ms)
                )
            end
        end
        return gamma_arena_result.ok({ ready = false, pending = true, state = "WAIT_ACTOR_LOADOUT" })
    end
    local function pending_or_rollback(progressed)
        local pending = pending_equipment(progressed)
        if pending.ok then return pending end
        return rollback(owned_records, pending)
    end
    local function required_equipment(actor, role)
        local record = equipment_record(role)
        if record == nil then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_INVALID", "Required equipped item record is missing", { role = role })
        end
        local online = actor_loadout_call("GA_ACTOR_LOADOUT_ONLINE_LOOKUP_FAILED", ports.online_item, actor, record.id)
        if not online.ok then return online end
        if online.value == nil then return gamma_arena_result.ok({ pending = true, record = record }) end
        return gamma_arena_result.ok({ record = record, object = online.value })
    end
    local function effective_equipment_slot(record)
        local slot = actor_loadout_call("GA_ACTOR_LOADOUT_SLOT_INVALID", ports.item_slot, record.section)
        if not slot.ok then return slot end
        if type(slot.value) ~= "number" or slot.value ~= math.floor(slot.value) or slot.value < 0 or slot.value >= UINT32_MOD then
            return actor_loadout_failure("GA_ACTOR_LOADOUT_SLOT_INVALID", "Equipped actor item has an invalid effective slot", { section = record.section })
        end
        return slot
    end
    local function update(actor)
        if equipment.state == "READY" then return gamma_arena_result.ok(equipment.summary) end
        if equipment.state ~= "WAIT_ACTOR_LOADOUT" then return actor_loadout_failure("GA_ACTOR_LOADOUT_STATE_INVALID", "Actor loadout is not waiting for equipment", { state = equipment.state }) end
        local actor_id = actor_loadout_call("GA_ACTOR_LOADOUT_ACTOR_INVALID", ports.actor_id, actor)
        if not actor_id.ok or actor_id.value ~= equipment.actor_id then
            return actor_id.ok and actor_loadout_failure("GA_ACTOR_LOADOUT_ACTOR_INVALID", "Actor changed during equipment transaction") or actor_id
        end

        if equipment.phase == "SUBMIT_SLOT" then
            local role = equipment_roles[equipment.role_index]
            if role == nil then
                equipment.phase = "SUBMIT_MAGAZINE"
                return pending_or_rollback(true)
            end
            local item = required_equipment(actor, role)
            if not item.ok then return rollback(owned_records, item) end
            if item.value.pending == true then return pending_or_rollback() end
            local slot = effective_equipment_slot(item.value.record)
            if not slot.ok then return rollback(owned_records, slot) end
            local moved = actor_loadout_call("GA_ACTOR_LOADOUT_EQUIP_FAILED", ports.move_to_slot, actor, item.value.object, slot.value)
            if not moved.ok then return rollback(owned_records, moved) end
            equipment.pending_slot = { role = role, id = item.value.record.id, section = item.value.record.section, slot = slot.value }
            equipment.phase = "WAIT_SLOT_VERIFY"
            return pending_or_rollback(true)
        end

        if equipment.phase == "WAIT_SLOT_VERIFY" then
            local pending_slot = equipment.pending_slot
            if type(pending_slot) ~= "table" then
                return rollback(owned_records, actor_loadout_failure("GA_ACTOR_LOADOUT_STATE_INVALID", "Pending actor slot proof is missing"))
            end
            local current = actor_loadout_call("GA_ACTOR_LOADOUT_EQUIP_VERIFY_FAILED", ports.item_in_slot, actor, pending_slot.slot)
            if not current.ok then return rollback(owned_records, current) end
            if current.value == nil then return pending_or_rollback() end
            local current_id = actor_loadout_call("GA_ACTOR_LOADOUT_EQUIP_VERIFY_FAILED", ports.entity_id, current.value)
            if not current_id.ok then return rollback(owned_records, current_id) end
            if current_id.value ~= pending_slot.id then
                return rollback(owned_records, actor_loadout_failure("GA_ACTOR_LOADOUT_EQUIP_VERIFY_FAILED", "Actor slot contains a different item", { section = pending_slot.section, slot = pending_slot.slot, expected_id = pending_slot.id, actual_id = current_id.value }))
            end
            equipment.slots[pending_slot.role] = pending_slot.slot
            equipment.pending_slot = nil
            if pending_slot.role == "outfit" then
                equipment.phase = "CHARGE_OUTFIT"
                return pending_or_rollback(true)
            end
            equipment.role_index = equipment.role_index + 1
            equipment.phase = "SUBMIT_SLOT"
            return pending_or_rollback(true)
        end

        if equipment.phase == "CHARGE_OUTFIT" then
            local outfit = required_equipment(actor, "outfit")
            if not outfit.ok then return rollback(owned_records, outfit) end
            if outfit.value.pending == true then return pending_or_rollback() end
            local requires_power = actor_loadout_call(
                "GA_ACTOR_EXO_CLASSIFY_FAILED",
                ports.outfit_requires_power,
                outfit.value.record.section
            )
            if not requires_power.ok then return rollback(owned_records, requires_power) end
            if requires_power.value == true then
                local confirmed = actor_loadout_call("GA_ACTOR_EXO_CLASSIFY_FAILED", ports.exo_is_object, outfit.value.object)
                if not confirmed.ok or confirmed.value ~= true then
                    return rollback(owned_records, actor_loadout_failure("GA_ACTOR_EXO_CLASSIFY_FAILED", "Powered outfit object was not recognized by Powered Exos"))
                end
                local first = actor_loadout_call("GA_ACTOR_EXO_READ_FAILED", ports.exo_get_data, outfit.value.record.id)
                if first.ok and first.value == nil then
                    first = actor_loadout_call("GA_ACTOR_EXO_INIT_FAILED", ports.exo_init_data, outfit.value.record.id)
                    if not first.ok or type(first.value) ~= "table" then
                        return rollback(owned_records, actor_loadout_failure("GA_ACTOR_EXO_INIT_FAILED", "Fresh Powered Exos data could not be initialized"))
                    end
                elseif not first.ok or type(first.value) ~= "table" then
                    return rollback(owned_records, actor_loadout_failure("GA_ACTOR_EXO_READ_FAILED", "Powered Exos data is unavailable"))
                end
                first.value.power = 100
                local written = actor_loadout_call("GA_ACTOR_EXO_WRITE_FAILED", ports.exo_set_data, outfit.value.record.id, first.value)
                if not written.ok then return rollback(owned_records, written) end
                local verified = actor_loadout_call("GA_ACTOR_EXO_VERIFY_FAILED", ports.exo_get_data, outfit.value.record.id)
                if not verified.ok or type(verified.value) ~= "table" or verified.value.power ~= 100 then
                    return rollback(owned_records, actor_loadout_failure("GA_ACTOR_EXO_VERIFY_FAILED", "Powered exoskeleton did not retain full charge"))
                end
                equipment.outfit_power = 100
            end
            equipment.role_index = equipment.role_index + 1
            equipment.phase = "SUBMIT_SLOT"
            return pending_or_rollback(true)
        end

        local weapon = required_equipment(actor, "weapon")
        if not weapon.ok then return rollback(owned_records, weapon) end
        if weapon.value.pending == true then return pending_or_rollback() end

        if equipment.phase == "SUBMIT_MAGAZINE" then
            local capacity = actor_loadout_call("GA_ACTOR_LOADOUT_MAGAZINE_INVALID", ports.magazine_capacity, weapon.value.record.section)
            if not capacity.ok then return rollback(owned_records, capacity) end
            if type(capacity.value) ~= "number" or capacity.value ~= math.floor(capacity.value) or capacity.value < 1 or capacity.value >= UINT32_MOD then
                return rollback(owned_records, actor_loadout_failure("GA_ACTOR_LOADOUT_MAGAZINE_INVALID", "Weapon ammo_mag_size must be a positive bounded integer", { section = weapon.value.record.section }))
            end
            local loaded = actor_loadout_call("GA_ACTOR_LOADOUT_MAGAZINE_FAILED", ports.set_ammo_elapsed, weapon.value.object, capacity.value)
            if not loaded.ok then return rollback(owned_records, loaded) end
            equipment.magazine_rounds = capacity.value
            equipment.phase = "WAIT_MAGAZINE_VERIFY"
            return pending_or_rollback(true)
        end

        if equipment.phase == "WAIT_MAGAZINE_VERIFY" then
            local magazine = actor_loadout_call("GA_ACTOR_LOADOUT_MAGAZINE_VERIFY_FAILED", ports.get_ammo_in_magazine, weapon.value.object)
            if not magazine.ok then return rollback(owned_records, magazine) end
            if magazine.value ~= equipment.magazine_rounds then return pending_or_rollback() end
            equipment.phase = "SUBMIT_ACTIVE"
            return pending_or_rollback(true)
        end

        if equipment.phase == "SUBMIT_ACTIVE" then
            local diagnostic = actor_loadout_call(
                "GA_ACTOR_WEAPON_DIAGNOSTIC_FAILED",
                ports.weapon_diagnostic,
                "pre_activate",
                actor,
                weapon.value.object,
                weapon.value.record,
                equipment.ammo_section
            )
            if not diagnostic.ok or type(diagnostic.value) ~= "table" then
                local cause = diagnostic.ok
                    and actor_loadout_failure("GA_ACTOR_WEAPON_DIAGNOSTIC_FAILED", "Actor weapon diagnostic snapshot is malformed")
                    or diagnostic
                return rollback(owned_records, cause)
            end
            local checkpoint = actor_loadout_call(
                "GA_ACTOR_WEAPON_CHECKPOINT_FAILED",
                ports.checkpoint,
                "GA_ACTOR_WEAPON_PRE_ACTIVATE",
                diagnostic.value
            )
            if not checkpoint.ok or checkpoint.value ~= true then
                return rollback(owned_records, actor_loadout_failure(
                    "GA_ACTOR_WEAPON_CHECKPOINT_FAILED",
                    "Actor weapon pre-activation checkpoint could not be written completely",
                    { cause = checkpoint.error and checkpoint.error.code or "unavailable", weapon_section = weapon.value.record.section }
                ))
            end
            if type(ports.log_info) == "function" then
                pcall(
                    ports.log_info,
                    "GA_ACTOR_WEAPON_PRE_ACTIVATE",
                    "weapon=" .. tostring(weapon.value.record.section) .. " item_id=" .. tostring(weapon.value.record.id),
                    diagnostic.value
                )
            end
            local activated = actor_loadout_call("GA_ACTOR_LOADOUT_ACTIVE_FAILED", ports.make_item_active, actor, weapon.value.object)
            if not activated.ok then return rollback(owned_records, activated) end
            equipment.phase = "WAIT_ACTIVE_VERIFY"
            return pending_or_rollback(true)
        end

        if equipment.phase ~= "WAIT_ACTIVE_VERIFY" then
            return rollback(owned_records, actor_loadout_failure("GA_ACTOR_LOADOUT_STATE_INVALID", "Actor equipment entered an unknown phase", { phase = equipment.phase }))
        end
        local active = actor_loadout_call("GA_ACTOR_LOADOUT_ACTIVE_VERIFY_FAILED", ports.active_item, actor)
        if not active.ok then return rollback(owned_records, active) end
        if active.value == nil then return pending_or_rollback() end
        local active_id = actor_loadout_call("GA_ACTOR_LOADOUT_ACTIVE_VERIFY_FAILED", ports.entity_id, active.value)
        if not active_id.ok then return rollback(owned_records, active_id) end
        if active_id.value ~= weapon.value.record.id then return pending_or_rollback() end
        local outfit = equipment_record("outfit")
        local knife = equipment_record("knife")
        if outfit == nil or knife == nil then
            return rollback(owned_records, actor_loadout_failure("GA_ACTOR_LOADOUT_INVALID", "Required equipped item record is missing at readiness"))
        end
        equipment.summary = {
            ready = true,
            state = "READY",
            weapon = weapon.value.record.section,
            knife = knife.section,
            outfit = outfit.section,
            weapon_slot = equipment.slots.weapon,
            knife_slot = equipment.slots.knife,
            outfit_slot = equipment.slots.outfit,
            magazine_rounds = equipment.magazine_rounds,
            reserve_rounds = equipment.reserve_rounds,
            bonus_ammo_rounds = equipment.bonus_ammo_rounds,
            outfit_power = equipment.outfit_power
        }
        equipment.state = "READY"
        return gamma_arena_result.ok(equipment.summary)
    end
    cleanup = function()
        if #owned_records == 0 then equipment = { state = "CLEAN" }; return gamma_arena_result.ok(false) end
        local remaining = {}
        local errors = {}
        for index = #owned_records, 1, -1 do
            local record = owned_records[index]
            local resolved = actor_loadout_call("GA_ACTOR_LOADOUT_RESOLVE_FAILED", ports.resolve_entity, record.id)
            if not resolved.ok then
                errors[#errors + 1] = resolved.error
                table.insert(remaining, 1, record)
            elseif resolved.value == nil then
                -- The authoritative current-id lookup proves the owned entity is gone.
            else
                -- Cleanup may only consume durable ownership proof written during
                -- creation. It must never manufacture ownership for a current
                -- same-shape object after an earlier tag failure or ID reuse.
                local proof = current_ownership(record, resolved.value)
                if not proof.ok then
                    errors[#errors + 1] = proof.error
                    table.insert(remaining, 1, record)
                elseif proof.value.match ~= true then
                    if record.release_submitted ~= true or proof.value.field == "token" then
                        errors[#errors + 1] = actor_loadout_failure("GA_ACTOR_LOADOUT_OWNERSHIP_MISMATCH", "Current object no longer matches the Arena actor item ownership record", { id = record.id, field = proof.value.field }).error
                        table.insert(remaining, 1, record)
                    end
                    -- After an accepted release, a clear current-object identity
                    -- mismatch is safe ID reuse: retire the old record and never
                    -- submit release against the new object. Token-only loss stays
                    -- tracked because it cannot prove whether the original remains.
                elseif record.release_submitted == true then
                    table.insert(remaining, 1, record)
                else
                    record.authorized = true
                    local released = actor_loadout_call("GA_ACTOR_LOADOUT_RELEASE_FAILED", ports.release_item, record.id)
                    if not released.ok then
                        errors[#errors + 1] = released.error
                    else
                        record.release_submitted = true
                    end
                    table.insert(remaining, 1, record)
                end
            end
        end
        owned_records = remaining
        if #errors > 0 then return gamma_arena_result.err(errors[1].code, errors[1].message, errors[1].context) end
        if #owned_records > 0 then
            local pending = {}; for index, record in ipairs(owned_records) do pending[index] = record.id end
            return gamma_arena_result.ok({ pending = true, remaining_ids = pending })
        end
        equipment = { state = "CLEAN" }
        return gamma_arena_result.ok(true)
    end
    return {
        apply = apply,
        update = update,
        state = function() return equipment.state end,
        records_snapshot = function() return copy_records(owned_records) end,
        cleanup = cleanup
    }
end

local BHS_PARTS = { "head", "torso", "rightarm", "leftarm", "rightleg", "leftleg" }

local function reset_gamma_body_health(actor)
    local bhs = zzz_player_injuries
    if type(bhs) ~= "table" then return gamma_arena_result.ok(false) end
    if type(bhs.health) ~= "table" or type(bhs.maxhp) ~= "table" or type(bhs.timedhp) ~= "table"
        or type(utils_obj) ~= "table" or type(utils_obj.save_var) ~= "function" or type(utils_obj.load_var) ~= "function" then
        return gamma_arena_result.err("GA_ACTOR_BODY_HEALTH_RESET_FAILED", "Installed Body Health System API is incomplete")
    end
    for _, part in ipairs(BHS_PARTS) do
        local maximum = bhs.maxhp[part]
        if type(maximum) ~= "number" or maximum ~= maximum or maximum <= 0 or maximum == math.huge then
            return gamma_arena_result.err("GA_ACTOR_BODY_HEALTH_RESET_FAILED", "Body Health System maximum is invalid", { part = part })
        end
        local assigned, reason = pcall(function()
            bhs.health[part] = maximum
            bhs.timedhp[part] = 0
            utils_obj.save_var(actor, "health." .. part, maximum)
            utils_obj.save_var(actor, "timedhp." .. part, 0)
        end)
        if not assigned then
            return gamma_arena_result.err("GA_ACTOR_BODY_HEALTH_RESET_FAILED", "Body Health System reset failed safely", { part = part, reason = tostring(reason) })
        end
        local loaded_health_ok, loaded_health = pcall(utils_obj.load_var, actor, "health." .. part)
        local loaded_timed_ok, loaded_timed = pcall(utils_obj.load_var, actor, "timedhp." .. part)
        if not loaded_health_ok or loaded_health ~= maximum or not loaded_timed_ok or loaded_timed ~= 0 then
            return gamma_arena_result.err("GA_ACTOR_BODY_HEALTH_RESET_FAILED", "Body Health System reset did not round-trip", { part = part })
        end
    end
    return gamma_arena_result.ok(true)
end

local function runtime_weapon_diagnostic(context)
    return gamma_arena_weapon_diagnostics.snapshot({
        read_string = function(section, key)
            local ini = system_ini()
            return ini:r_string_ex(section, key)
        end,
        object_id = runtime_object_id
    }, context)
end

local function default_actor_adapter(active_instance, diagnostics, weapon_diagnostics)
    local effects = {}
    function effects.disable_effects_timer(duration)
        if actor_effects and type(actor_effects.disable_effects_timer) == "function" then
            return actor_effects.disable_effects_timer(duration)
        end
    end
    local input = {}
    function input.acquire()
        if level == nil or type(level.disable_input) ~= "function" then
            return gamma_arena_result.err("GA_ACTOR_INPUT_DISABLE_FAILED", "level.disable_input is unavailable")
        end
        level.disable_input()
        return gamma_arena_result.ok(true)
    end
    function input.release()
        if level == nil or type(level.enable_input) ~= "function" then
            return gamma_arena_result.err("GA_ACTOR_INPUT_ENABLE_FAILED", "level.enable_input is unavailable")
        end
        level.enable_input()
        return gamma_arena_result.ok(true)
    end
    local loadout = new_actor_loadout_port({
        clock = function() return time_global() end,
        timeout_ms = 5000,
        actor_id = runtime_object_id,
        ownership_token = function()
            local instance = active_instance()
            local session = instance and instance:session_snapshot() or nil
            if type(session) ~= "table" or type(session.session_id) ~= "string" or session.session_id == ""
                or type(session.session_nonce) ~= "string" or session.session_nonce == "" then
                return gamma_arena_result.err("GA_ACTOR_LOADOUT_OWNERSHIP_TOKEN_INVALID", "Active Arena session identity is unavailable for actor item ownership")
            end
            return session.session_id .. ":" .. session.session_nonce
        end,
        weapon_diagnostic = function(phase, actor, item, record, ammo_section)
            local instance = active_instance()
            local session = instance and instance:session_snapshot() or nil
            local fight_id = nil
            local id_called, id_value = pcall(function()
                return instance and instance.fight_spec and instance.fight_spec.fight_id and instance.fight_spec.fight_id()
            end)
            if id_called then fight_id = id_value end
            return weapon_diagnostics({
                session_id = session and session.session_id or nil,
                fight_index = session and session.fight_index or nil,
                fight_id = fight_id,
                phase = phase,
                weapon_section = record and record.section or nil,
                ammo_section = ammo_section,
                actor = actor,
                item = item
            })
        end,
        checkpoint = function(code, fields)
            if diagnostics == nil or type(diagnostics.checkpoint) ~= "function" then
                return gamma_arena_result.err("GA_ACTOR_WEAPON_CHECKPOINT_FAILED", "Actor weapon diagnostics journal is unavailable")
            end
            return diagnostics:checkpoint(code, fields)
        end,
        log_info = function(code, message, fields)
            gamma_arena_log.info(code, message, fields)
            return gamma_arena_result.ok(true)
        end,
        ammo_box_size = effective_ammo_box_size,
        create_item = function(section, actor, count, is_ammo)
            if is_ammo then return alife_create_item(section, actor, { ammo = count }) end
            return alife_create_item(section, actor)
        end,
        entity_id = runtime_object_id,
        entity_parent_id = runtime_parent_id,
        entity_section = runtime_section_name,
        item_quantity = runtime_ammo_quantity,
        online_item = function(_, id)
            if level == nil or type(level.object_by_id) ~= "function" then
                return gamma_arena_result.err("GA_ACTOR_LOADOUT_ONLINE_LOOKUP_FAILED", "level.object_by_id is unavailable", { id = id })
            end
            local called, value = pcall(level.object_by_id, id)
            if not called then return gamma_arena_result.err("GA_ACTOR_LOADOUT_ONLINE_LOOKUP_FAILED", "Actor item online lookup failed safely", { id = id, reason = tostring(value) }) end
            return gamma_arena_result.ok(value)
        end,
        item_slot = function(section) return effective_item_slot(section) end,
        magazine_capacity = function(section) return effective_magazine_size(section) end,
        move_to_slot = function(actor, item, slot) return actor:move_to_slot(item, slot) end,
        item_in_slot = function(actor, slot) return actor:item_in_slot(slot) end,
        set_ammo_elapsed = function(weapon, count) return weapon:set_ammo_elapsed(count) end,
        get_ammo_in_magazine = function(weapon) return weapon:get_ammo_in_magazine() end,
        make_item_active = function(actor, item) return actor:make_item_active(item) end,
        active_item = function(actor) return actor:active_item() end,
        outfit_requires_power = effective_outfit_requires_power,
        exo_is_object = function(object)
            local api = powered_exos_api("is_exo", "GA_ACTOR_EXO_CLASSIFY_FAILED")
            if not api.ok then return api end
            local called, value = pcall(api.value, object)
            if not called then return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Powered Exos object classification failed safely", { reason = tostring(value) }) end
            return gamma_arena_result.ok(value)
        end,
        exo_get_data = function(id)
            local api = powered_exos_api("get_data", "GA_ACTOR_EXO_READ_FAILED")
            if not api.ok then return api end
            local called, value = pcall(api.value, id)
            if not called then return gamma_arena_result.err("GA_ACTOR_EXO_READ_FAILED", "Powered Exos data read failed safely", { id = id, reason = tostring(value) }) end
            return gamma_arena_result.ok(value)
        end,
        exo_init_data = function(id)
            local api = powered_exos_api("init_data", "GA_ACTOR_EXO_INIT_FAILED")
            if not api.ok then return api end
            local called, value = pcall(api.value, id)
            if not called then return gamma_arena_result.err("GA_ACTOR_EXO_INIT_FAILED", "Powered Exos data initialization failed safely", { id = id, reason = tostring(value) }) end
            return gamma_arena_result.ok(value)
        end,
        exo_set_data = function(id, data)
            local api = powered_exos_api("set_data", "GA_ACTOR_EXO_WRITE_FAILED")
            if not api.ok then return api end
            local called, value = pcall(api.value, id, data)
            if not called then return gamma_arena_result.err("GA_ACTOR_EXO_WRITE_FAILED", "Powered Exos data write failed safely", { id = id, reason = tostring(value) }) end
            if value == false then return gamma_arena_result.err("GA_ACTOR_EXO_WRITE_FAILED", "Powered Exos rejected the data write", { id = id }) end
            return gamma_arena_result.ok(true)
        end,
        resolve_entity = function(id)
            local service = type(alife) == "function" and alife() or nil
            if service == nil or type(service.object) ~= "function" then
                return gamma_arena_result.err("GA_ACTOR_LOADOUT_RESOLVE_FAILED", "ALife current-object resolver is unavailable", { id = id })
            end
            local called, value = pcall(service.object, service, id)
            if not called then
                return gamma_arena_result.err("GA_ACTOR_LOADOUT_RESOLVE_FAILED", "ALife current-object resolver failed safely", { id = id, reason = tostring(value) })
            end
            return gamma_arena_result.ok(value)
        end,
        save_owner_tag = function(id, token) return se_save_var(id, nil, ACTOR_LOADOUT_OWNER_KEY, token) end,
        load_owner_tag = function(id) return se_load_var(id, nil, ACTOR_LOADOUT_OWNER_KEY) end,
        release_item = function(id)
            if safe_release_manager == nil or type(safe_release_manager.release) ~= "function" then return gamma_arena_result.err("GA_ACTOR_LOADOUT_RELEASE_FAILED", "safe_release_manager.release is unavailable") end
            safe_release_manager.release({ id = id })
            return gamma_arena_result.ok(true)
        end
    })
    return gamma_arena_actor_adapter.new({
        actor = function() return db and db.actor end,
        is_session_active = function() return active_instance() and active_instance():is_active() end,
        is_actor_owned = function(candidate)
            local instance = active_instance()
            if instance == nil or not level or type(level.name) ~= "function" then return false end
            return actor_ownership_matches(candidate, db and db.actor, instance:is_active(), level.name())
        end,
        release_item_id = function(id)
            if safe_release_manager == nil or type(safe_release_manager.release) ~= "function" then
                return gamma_arena_result.err("GA_ACTOR_INVENTORY_RELEASE_FAILED", "safe_release_manager.release is unavailable")
            end
            safe_release_manager.release({ id = id })
            return gamma_arena_result.ok(true)
        end,
        clock = function() return time_global() end,
        inventory_drain_timeout_ms = 10000,
        item_section = function(item) return item:section() end,
        patrol = function(path) return patrol(path) end,
        effects = effects,
        mod_body_health_reset = reset_gamma_body_health,
        mod_psy_reset = function()
            if arszi_psy and type(arszi_psy.set_psy_health) == "function" then arszi_psy.set_psy_health(1) end
        end,
        input = input,
        loadout = loadout
    })
end

local function entity_server_object(id)
    local service = alife()
    if service == nil or type(service.object) ~= "function" then return nil end
    return service:object(id)
end

local function entity_section_name(entity)
    local ok, value = pcall(function() return entity and entity.section_name end)
    if ok and type(value) == "function" then
        local called, section = pcall(value, entity)
        if called then return section end
    elseif ok and type(value) == "string" then
        return value
    end
    return nil
end

local function entity_ammo_quantity(entity, is_ammo)
    if not is_ammo then return 1 end
    for _, field in ipairs({ "a_elapsed", "ammo_elapsed", "count" }) do
        local ok, value = pcall(function() return entity and entity[field] end)
        if ok and type(value) == "function" then
            local called, quantity = pcall(value, entity)
            if called and type(quantity) == "number" then return quantity end
        elseif ok and type(value) == "number" then
            return value
        end
    end
    return nil
end

local function entity_online_lookup(id)
    local storage_ok, object = pcall(function() return db and db.storage and db.storage[id] and db.storage[id].object end)
    if not storage_ok then return gamma_arena_result.err("GA_ENTITY_ONLINE_LOOKUP_FAILED", "db.storage online lookup failed", { id = id }) end
    if object ~= nil then return gamma_arena_result.ok(object) end
    local lookup_ok, lookup = pcall(function() return level and level.object_by_id end)
    if not lookup_ok or type(lookup) ~= "function" then return gamma_arena_result.err("GA_ENTITY_ONLINE_LOOKUP_FAILED", "level.object_by_id is unavailable", { id = id }) end
    local called, value = pcall(lookup, id)
    if not called then return gamma_arena_result.err("GA_ENTITY_ONLINE_LOOKUP_FAILED", "level.object_by_id failed safely", { id = id }) end
    return gamma_arena_result.ok(value)
end

local function hold_entity_offline(entity)
    local id = runtime_object_id(entity)
    local service_ok, service = pcall(function() return type(alife) == "function" and alife() or nil end)
    local online_ok, online_method = pcall(function() return service and service.set_switch_online end)
    local offline_ok, offline_method = pcall(function() return service and service.set_switch_offline end)
    if id == nil or not service_ok or service == nil or not online_ok or type(online_method) ~= "function"
        or not offline_ok or type(offline_method) ~= "function" then
        return gamma_arena_result.err("GA_ENTITY_OFFLINE_HOLD_API_MISSING", "ALife NPC switch controls are unavailable", { id = id })
    end
    local held, hold_result = pcall(online_method, service, id, false)
    local retained, retain_result = pcall(offline_method, service, id, true)
    if not held or hold_result == false or not retained or retain_result == false then
        return gamma_arena_result.err("GA_ENTITY_OFFLINE_HOLD_FAILED", "NPC could not be held offline before inventory application")
    end
    local flag_ok, online = pcall(function() return entity.online end)
    if not flag_ok or type(online) ~= "boolean" then
        return gamma_arena_result.err("GA_ENTITY_OFFLINE_HOLD_API_MISSING", "NPC server online flag is unavailable", { id = id })
    end
    if online then
        local switch_ok, switch_method = pcall(function() return entity.switch_offline end)
        if not switch_ok or type(switch_method) ~= "function" then
            return gamma_arena_result.err("GA_ENTITY_OFFLINE_HOLD_API_MISSING", "Online NPC cannot be switched offline synchronously", { id = id })
        end
        local switched, switched_result = pcall(switch_method, entity)
        local verified, still_online = pcall(function() return entity.online end)
        if not switched or switched_result == false or not verified or still_online ~= false then
            return gamma_arena_result.err("GA_ENTITY_OFFLINE_HOLD_FAILED", "NPC remained online after the staging hold", { id = id })
        end
    end
    return gamma_arena_result.ok(true)
end

local function request_entity_online(entity, id)
    local service_ok, service = pcall(function() return type(alife) == "function" and alife() or nil end)
    local online_ok, online_method = pcall(function() return service and service.set_switch_online end)
    local offline_ok, offline_method = pcall(function() return service and service.set_switch_offline end)
    local switch_ok, switch_method = pcall(function() return entity and entity.switch_online end)
    if not service_ok or service == nil or not online_ok or type(online_method) ~= "function" or not offline_ok or type(offline_method) ~= "function"
        or not switch_ok or type(switch_method) ~= "function" then
        return gamma_arena_result.err("GA_ENTITY_ONLINE_REQUEST_API_MISSING", "NPC online request controls are unavailable", { id = id })
    end
    local enabled, enabled_result = pcall(online_method, service, id, true)
    local pinned, pinned_result = pcall(offline_method, service, id, false)
    local switched, switched_result = pcall(switch_method, entity)
    if not enabled or enabled_result == false or not pinned or pinned_result == false or not switched or switched_result == false then
        return gamma_arena_result.err("GA_ENTITY_ONLINE_REQUEST_FAILED", "NPC online request failed", { id = id })
    end
    return gamma_arena_result.ok(true)
end

local function entity_effective_profile(section)
    if type(system_ini) ~= "function" then return gamma_arena_result.err("GA_ENEMY_EFFECTIVE_PROFILE_API_MISSING", "system_ini is unavailable") end
    local opened, system = pcall(system_ini)
    if not opened or system == nil then return gamma_arena_result.err("GA_ENEMY_EFFECTIVE_PROFILE_READ_FAILED", "Effective system.ini is unavailable") end
    local line_ok, line_exist = pcall(function() return system.line_exist end)
    local read_ok, read = pcall(function() return system.r_string_ex end)
    if not line_ok or type(line_exist) ~= "function" or not read_ok or type(read) ~= "function" then
        return gamma_arena_result.err("GA_ENEMY_EFFECTIVE_PROFILE_API_MISSING", "Effective profile value APIs are unavailable", { section = section })
    end
    for _, key in ipairs({ "class", "community" }) do
        local called, present = pcall(line_exist, system, section, key)
        if not called or present ~= true then return gamma_arena_result.err("GA_ENEMY_EFFECTIVE_PROFILE_READ_FAILED", "Effective profile value is missing", { section = section, key = key }) end
    end
    local class_ok, class = pcall(read, system, section, "class")
    local community_ok, community = pcall(read, system, section, "community")
    if not class_ok or not community_ok then return gamma_arena_result.err("GA_ENEMY_EFFECTIVE_PROFILE_READ_FAILED", "Effective profile value could not be read", { section = section }) end
    return gamma_arena_result.ok({ class = class, community = community })
end

function effective_ammo_box_size(section)
    if type(section) ~= "string" or section == "" or type(system_ini) ~= "function" then
        return gamma_arena_result.err("GA_ENTITY_AMMO_BOX_SIZE_INVALID", "Effective ammo section/system_ini is unavailable", { section = section })
    end
    local opened, system = pcall(system_ini)
    if not opened or system == nil then
        return gamma_arena_result.err("GA_ENTITY_AMMO_BOX_SIZE_INVALID", "Effective system.ini is unavailable", { section = section })
    end
    local line_ok, line_exist = pcall(function() return system.line_exist end)
    local read_ok, read = pcall(function() return system.r_u32 end)
    if not line_ok or type(line_exist) ~= "function" or not read_ok or type(read) ~= "function" then
        return gamma_arena_result.err("GA_ENTITY_AMMO_BOX_SIZE_INVALID", "Effective box_size APIs are unavailable", { section = section })
    end
    local present_ok, present = pcall(line_exist, system, section, "box_size")
    if not present_ok or present ~= true then
        return gamma_arena_result.err("GA_ENTITY_AMMO_BOX_SIZE_INVALID", "Effective ammo box_size is missing", { section = section })
    end
    local value_ok, value = pcall(read, system, section, "box_size")
    if not value_ok or type(value) ~= "number" or value ~= math.floor(value) or value < 1 or value >= UINT32_MOD then
        return gamma_arena_result.err("GA_ENTITY_AMMO_BOX_SIZE_INVALID", "Effective ammo box_size is invalid", { section = section })
    end
    return gamma_arena_result.ok(value)
end

local function effective_item_u32(section, key, minimum, code)
    if type(section) ~= "string" or section == "" or type(system_ini) ~= "function" then
        return gamma_arena_result.err(code, "Effective item section/system_ini is unavailable", { section = section, key = key })
    end
    local opened, system = pcall(system_ini)
    if not opened or system == nil then return gamma_arena_result.err(code, "Effective system.ini is unavailable", { section = section, key = key }) end
    local line_ok, line_exist = pcall(function() return system.line_exist end)
    local read_ok, read = pcall(function() return system.r_u32 end)
    if not line_ok or type(line_exist) ~= "function" or not read_ok or type(read) ~= "function" then
        return gamma_arena_result.err(code, "Effective item metadata APIs are unavailable", { section = section, key = key })
    end
    local present_ok, present = pcall(line_exist, system, section, key)
    if not present_ok or present ~= true then return gamma_arena_result.err(code, "Effective item metadata is missing", { section = section, key = key }) end
    local value_ok, value = pcall(read, system, section, key)
    if not value_ok or type(value) ~= "number" or value ~= math.floor(value) or value < minimum or value >= UINT32_MOD then
        return gamma_arena_result.err(code, "Effective item metadata is invalid", { section = section, key = key, value = value })
    end
    return gamma_arena_result.ok(value)
end

function engine_inventory_slot(ltx_slot)
    if type(ltx_slot) ~= "number" or ltx_slot ~= math.floor(ltx_slot) or ltx_slot < 0 or ltx_slot >= UINT32_MOD - 1 then
        return gamma_arena_result.err("GA_ACTOR_LOADOUT_SLOT_INVALID", "LTX item slot cannot be translated to the Lua inventory API", { ltx_slot = ltx_slot })
    end
    return gamma_arena_result.ok(ltx_slot + 1)
end

function effective_item_slot(section)
    local configured = effective_item_u32(section, "slot", 0, "GA_ACTOR_LOADOUT_SLOT_INVALID")
    if not configured.ok then return configured end
    return engine_inventory_slot(configured.value)
end

function effective_magazine_size(section)
    return effective_item_u32(section, "ammo_mag_size", 1, "GA_ACTOR_LOADOUT_MAGAZINE_INVALID")
end

function effective_outfit_requires_power(section)
    if type(section) ~= "string" or section == "" then
        return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Effective outfit section is unavailable", { section = section })
    end
    if string.find(section, "proto", 1, true) ~= nil then return gamma_arena_result.ok(true) end
    if type(system_ini) ~= "function" then
        return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Effective system_ini is unavailable", { section = section })
    end
    local opened, system = pcall(system_ini)
    if not opened or system == nil then return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Effective system.ini is unavailable", { section = section }) end
    local line_ok, line_exist = pcall(function() return system.line_exist end)
    local read_ok, read = pcall(function() return system.r_string_ex end)
    if not line_ok or type(line_exist) ~= "function" or not read_ok or type(read) ~= "function" then
        return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Effective outfit repair_type APIs are unavailable", { section = section })
    end
    local present_ok, present = pcall(line_exist, system, section, "repair_type")
    if not present_ok or present ~= true then
        if present_ok and present == false then return gamma_arena_result.ok(false) end
        return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Effective outfit repair_type is unavailable", { section = section })
    end
    local value_ok, repair_type = pcall(read, system, section, "repair_type")
    if not value_ok or type(repair_type) ~= "string" then
        return gamma_arena_result.err("GA_ACTOR_EXO_CLASSIFY_FAILED", "Effective outfit repair_type is unreadable", { section = section })
    end
    return gamma_arena_result.ok(repair_type == "outfit_exo")
end

function powered_exos_api(method, code)
    local api_ok, api = pcall(function() return item_exo_device and item_exo_device[method] end)
    if not api_ok or type(api) ~= "function" then
        return gamma_arena_result.err(code, "Powered Exos API is unavailable", { method = method })
    end
    return gamma_arena_result.ok(api)
end

function apply_actor_hostility(npc, actor, goodwill, enemy_relation)
    if enemy_relation == nil then
        local relation_ok, relation = pcall(function() return game_object and game_object.enemy end)
        if relation_ok then enemy_relation = relation end
    end
    local relation_ok, relation_method = pcall(function() return npc and npc.set_relation end)
    local goodwill_ok, goodwill_method = pcall(function() return npc and npc.force_set_goodwill end)
    if enemy_relation == nil or not relation_ok or type(relation_method) ~= "function" or not goodwill_ok or type(goodwill_method) ~= "function" then
        return gamma_arena_result.err("GA_ENTITY_HOSTILE_API_MISSING", "NPC hostility relation APIs are unavailable")
    end
    local related, relation_result = pcall(relation_method, npc, enemy_relation, actor)
    if not related or relation_result == false then
        return gamma_arena_result.err("GA_ENTITY_HOSTILE_RELATION_FAILED", "NPC enemy relation failed", { reason = related and "explicit false" or tostring(relation_result) })
    end
    local forced, goodwill_result = pcall(goodwill_method, npc, goodwill, actor)
    if not forced or goodwill_result == false then
        return gamma_arena_result.err("GA_ENTITY_HOSTILE_GOODWILL_FAILED", "NPC forced goodwill failed", { reason = forced and "explicit false" or tostring(goodwill_result) })
    end
    return gamma_arena_result.ok(true)
end

local function apply_actor_activation_hold(npc, actor)
    local enemy_ok, enemy_method = pcall(function() return npc and npc.set_enemy end)
    local relation_ok, relation_method = pcall(function() return npc and npc.set_relation end)
    local goodwill_ok, goodwill_method = pcall(function() return npc and npc.force_set_goodwill end)
    local friend_ok, friend_relation = pcall(function() return game_object and game_object.friend end)
    if not enemy_ok or type(enemy_method) ~= "function" or not relation_ok or type(relation_method) ~= "function"
        or not goodwill_ok or type(goodwill_method) ~= "function" or not friend_ok or friend_relation == nil then
        return gamma_arena_result.err("GA_ENTITY_ACTIVATION_HOLD_API_MISSING", "NPC temporary combat-hold APIs are unavailable")
    end
    local cleared, clear_result = pcall(enemy_method, npc, nil)
    local related, relation_result = pcall(relation_method, npc, friend_relation, actor)
    local forced, goodwill_result = pcall(goodwill_method, npc, 5000, actor)
    if not cleared or clear_result == false or not related or relation_result == false or not forced or goodwill_result == false then
        return gamma_arena_result.err("GA_ENTITY_ACTIVATION_HOLD_FAILED", "NPC temporary combat hold failed")
    end
    return gamma_arena_result.ok(true)
end

local TacticalProxy = {}
TacticalProxy.__index = TacticalProxy

function TacticalProxy:ensure_adapter()
    if self.active ~= nil then return gamma_arena_result.ok(self.active) end
    local actor = db and db.actor
    if actor == nil then return gamma_arena_result.err("GA_TACTICAL_DEPS_INVALID", "Arena actor is unavailable for tactical composition") end
    local ini_ok, tactical_ini = pcall(function() return ini_file("gamma_arena\\gamma_arena_tactical.ltx") end)
    if not ini_ok or tactical_ini == nil then
        return gamma_arena_result.err("GA_TACTICAL_CONFIG_INVALID", "Tactical director LTX could not be opened")
    end
    local adapter, failure = gamma_arena_tactical_adapter.new({
        clock = function() return time_global() end,
        actor = actor,
        online_object = entity_online_lookup,
        resolve_route = function(path)
            local path_object = patrol(path)
            return path_object and path_object:point(0) or nil
        end,
        tactical_ini = tactical_ini,
        xr_logic = xr_logic,
        stype_stalker = modules and modules.stype_stalker,
        danger_object = danger_object,
        log_warn = function(code, message, context) gamma_arena_log.warn(code, message, context) end
    })
    if adapter == nil then return failure or gamma_arena_result.err("GA_TACTICAL_DEPS_INVALID", "Tactical director could not be composed") end
    self.active = adapter
    return gamma_arena_result.ok(adapter)
end

function TacticalProxy:begin(context)
    local ensured = self:ensure_adapter()
    if not ensured.ok then return ensured end
    return ensured.value:begin(context)
end

function TacticalProxy:update()
    if self.active == nil then return gamma_arena_result.err("GA_TACTICAL_NOT_ACTIVE", "Tactical director is not active") end
    return self.active:update()
end

function TacticalProxy:record_death(slot)
    if self.active == nil then return gamma_arena_result.err("GA_TACTICAL_NOT_ACTIVE", "Tactical director is not active") end
    return self.active:record_death(slot)
end

function TacticalProxy:stop()
    if self.active == nil then return gamma_arena_result.ok(true) end
    local adapter = self.active
    local stopped = adapter:stop()
    if stopped.ok then self.active = nil end
    return stopped
end

local function default_tactical_adapter()
    return setmetatable({ active = nil }, TacticalProxy)
end

local function clear_npc_hidden_charge(id, object)
    local named, name = pcall(function() return object and object:name() end)
    if not named or type(name) ~= "string" or name == "" then
        return gamma_arena_result.err("GA_NPC_MEDICAL_CHARGE_CLEAR_FAILED", "Arena opponent name is unavailable", { id = id })
    end
    local cleared, value = pcall(se_save_var, id, name, "healing_charge", nil)
    if not cleared or value == false then
        return gamma_arena_result.err("GA_NPC_MEDICAL_CHARGE_CLEAR_FAILED", "Stock hidden healing charge could not be cleared", { id = id, reason = cleared and nil or tostring(value) })
    end
    return gamma_arena_result.ok(true)
end

local function default_entity_adapter(actor_adapter, active_instance, diagnostics)
    local tactical = default_tactical_adapter()
    return gamma_arena_entity_adapter.new({
        actor = actor_adapter,
        tactical = tactical,
        log_warn = function(code, message, context) gamma_arena_log.warn(code, message, context) end,
        log_info = function(code, message, context) gamma_arena_log.info(code, message, context) end,
        clock = function() return time_global() end,
        opponent_gate = function()
            local instance = active_instance()
            return instance ~= nil and instance:is_opponent_activation_allowed()
        end,
        alife = function() return alife() end,
        create_npc = function(section, position, level_vertex_id, game_vertex_id)
            local runtime_position = vector()
            runtime_position:set(position.x, position.y, position.z)
            return alife_create(section, runtime_position, level_vertex_id, game_vertex_id)
        end,
        hold_offline = hold_entity_offline,
        request_online = request_entity_online,
        create_item = function(section, parent, count, is_ammo)
            if is_ammo then return alife_create_item(section, parent, { ammo = count }) end
            return alife_create_item(section, parent)
        end,
        save_tag = function(id, name, key, value) return se_save_var(id, name, key, value) end,
        load_tag = function(id, name, key) return se_load_var(id, name, key) end,
        save_death_dropped = function(id, value) return se_save_var(id, nil, "death_dropped", value) end,
        load_death_dropped = function(id) return se_load_var(id, nil, "death_dropped") end,
        clear_hidden_charge = clear_npc_hidden_charge,
        release = function(descriptor)
            if safe_release_manager == nil or type(safe_release_manager.release) ~= "function" then
                return gamma_arena_result.err("GA_ENTITY_SAFE_RELEASE_FAILED", "safe_release_manager.release is unavailable")
            end
            safe_release_manager.release({ id = descriptor.id })
            return gamma_arena_result.ok(true)
        end,
        server_entity = entity_server_object,
        entity_exists = runtime_arena_entity_exists,
        online_object = entity_online_lookup,
        object_position = function(object)
            local lookup_ok, method = pcall(function() return object and object.position end)
            if not lookup_ok or type(method) ~= "function" then
                return gamma_arena_result.err("GA_ENTITY_POSITION_FAILED", "game_object.position is unavailable")
            end
            local called, value = pcall(method, object)
            if not called or type(value) ~= "table" and type(value) ~= "userdata" then
                return gamma_arena_result.err("GA_ENTITY_POSITION_FAILED", "Opponent position query failed safely", {
                    reason = called and nil or tostring(value)
                })
            end
            local copied_ok, copied = pcall(function() return { x = value.x, y = value.y, z = value.z } end)
            if not copied_ok then
                return gamma_arena_result.err("GA_ENTITY_POSITION_FAILED", "Opponent position components are unreadable")
            end
            return gamma_arena_result.ok(copied)
        end,
        object_health = function(object)
            local read, value = pcall(function() return object and object.health end)
            if not read or type(value) ~= "number" then error("Opponent health is unavailable") end
            return value
        end,
        object_bleeding = function(object)
            local read, value = pcall(function() return object and object.bleeding end)
            if not read or type(value) ~= "number" then error("Opponent bleeding is unavailable") end
            return value
        end,
        last_hitter_name = function(object)
            local read, method = pcall(function() return object and object.who_hit_name end)
            if not read or type(method) ~= "function" then return nil end
            local called, value = pcall(method, object)
            return called and value or nil
        end,
        last_hitter_section = function(object)
            local read, method = pcall(function() return object and object.who_hit_section_name end)
            if not read or type(method) ~= "function" then return nil end
            local called, value = pcall(method, object)
            return called and value or nil
        end,
        is_critically_wounded = function(object)
            local lookup_ok, method = pcall(function() return object and object.critically_wounded end)
            if not lookup_ok or type(method) ~= "function" then
                return gamma_arena_result.err("GA_ENTITY_WOUND_CHECK_FAILED", "game_object.critically_wounded is unavailable")
            end
            local called, value = pcall(method, object)
            if not called or type(value) ~= "boolean" then
                return gamma_arena_result.err("GA_ENTITY_WOUND_CHECK_FAILED", "Critical-wound query failed safely", {
                    reason = called and nil or tostring(value)
                })
            end
            return gamma_arena_result.ok(value)
        end,
        entity_section = entity_section_name,
        item_quantity = entity_ammo_quantity,
        ammo_box_size = effective_ammo_box_size,
        profile_runtime = { effective_profile = entity_effective_profile },
        actor_object = function() return db and db.actor end,
        set_runtime_community = function(npc, community)
            local lookup_ok, method = pcall(function() return npc and npc.set_character_community end)
            if not lookup_ok or type(method) ~= "function" then
                return gamma_arena_result.err("GA_ENTITY_RUNTIME_COMMUNITY_SET_FAILED", "game_object.set_character_community is unavailable")
            end
            local called, value = pcall(method, npc, community, 0, 0)
            if not called or value == false then
                return gamma_arena_result.err("GA_ENTITY_RUNTIME_COMMUNITY_SET_FAILED", "Opponent runtime community assignment failed safely", {
                    reason = called and "explicit false" or tostring(value)
                })
            end
            return gamma_arena_result.ok(true)
        end,
        runtime_community = function(npc)
            local lookup_ok, method = pcall(function() return npc and npc.character_community end)
            if not lookup_ok or type(method) ~= "function" then
                return gamma_arena_result.err("GA_ENTITY_RUNTIME_COMMUNITY_READ_FAILED", "game_object.character_community is unavailable")
            end
            local called, value = pcall(method, npc)
            if not called or type(value) ~= "string" or value == "" then
                return gamma_arena_result.err("GA_ENTITY_RUNTIME_COMMUNITY_READ_FAILED", "Opponent runtime community readback failed safely", {
                    reason = called and nil or tostring(value)
                })
            end
            return gamma_arena_result.ok(value)
        end,
        clear_enemy = function(npc)
            local called, value = pcall(function() return npc:set_enemy(nil) end)
            if not called or value == false then
                return gamma_arena_result.err("GA_ENTITY_DEATH_CLEAR_ENEMY_FAILED", "NPC enemy target could not be cleared safely", {
                    reason = called and "explicit false" or tostring(value)
                })
            end
            return gamma_arena_result.ok(true)
        end,
        set_pair_friends = function(first, second)
            if game_object == nil or game_object.friend == nil then return gamma_arena_result.err("GA_ENTITY_FRIEND_RELATION_FAILED", "game_object.friend is unavailable") end
            local first_ok, first_result = pcall(function() return first:set_relation(game_object.friend, second) end)
            local second_ok, second_result = pcall(function() return second:set_relation(game_object.friend, first) end)
            if not first_ok or first_result == false or not second_ok or second_result == false then
                return gamma_arena_result.err("GA_ENTITY_FRIEND_RELATION_FAILED", "NPC pair friendship failed safely")
            end
            return gamma_arena_result.ok(true)
        end,
        set_actor_hold = apply_actor_activation_hold,
        set_actor_hostile = function(npc, actor, goodwill)
            if game_object == nil or game_object.enemy == nil then return gamma_arena_result.err("GA_ENTITY_HOSTILE_RELATION_FAILED", "game_object.enemy is unavailable") end
            return apply_actor_hostility(npc, actor, goodwill, game_object.enemy)
        end,
        checkpoint = function(code, context)
            if diagnostics == nil or type(diagnostics.checkpoint) ~= "function" then return gamma_arena_result.ok(false) end
            return diagnostics:checkpoint(code, context)
        end,
        release_timeout_ms = 10000,
        online_timeout_ms = 10000
    })
end

local function default_npc_medical_controller(entity_adapter)
    local function online_npc(id)
        local resolved = entity_online_lookup(id)
        if not resolved.ok then return resolved end
        if resolved.value == nil then return gamma_arena_result.err("GA_NPC_MEDICAL_STATUS_FAILED", "Arena opponent is not online", { id = id }) end
        return resolved
    end
    return gamma_arena_npc_medical.new({
        clock = function() return gamma_arena_result.ok(time_global()) end,
        registry_snapshot = function() return gamma_arena_result.ok(entity_adapter:registry_snapshot()) end,
        clear_hidden_charge = function(id)
            local resolved = online_npc(id)
            if not resolved.ok then return resolved end
            return clear_npc_hidden_charge(id, resolved.value)
        end,
        status = function(id)
            local resolved = online_npc(id)
            if not resolved.ok then return resolved end
            local npc = resolved.value
            local read, health, bleeding, alive_method, critical_method = pcall(function()
                return npc.health, npc.bleeding, npc.alive, npc.critically_wounded
            end)
            if not read or type(health) ~= "number" or type(bleeding) ~= "number"
                or type(alive_method) ~= "function" or type(critical_method) ~= "function" then
                return gamma_arena_result.err("GA_NPC_MEDICAL_STATUS_FAILED", "Arena opponent medical state is unavailable", { id = id })
            end
            local alive_ok, alive = pcall(alive_method, npc)
            local critical_ok, critical = pcall(critical_method, npc)
            if not alive_ok or type(alive) ~= "boolean" or not critical_ok or type(critical) ~= "boolean" then
                return gamma_arena_result.err("GA_NPC_MEDICAL_STATUS_FAILED", "Arena opponent combat capability could not be read", { id = id })
            end
            return gamma_arena_result.ok({ npc = npc, health = health, bleeding = bleeding, alive = alive, combat_capable = alive and not critical })
        end,
        consume_medical_item = function(fight_id, npc_id, section)
            return entity_adapter:consume_medical_item(fight_id, npc_id, section)
        end,
        change_health = function(npc, delta)
            local called, value = pcall(function() return npc:change_health(delta) end)
            if not called or value == false then
                return gamma_arena_result.err("GA_NPC_MEDICAL_EFFECT_FAILED", "Arena medkit health pulse failed", { reason = called and nil or tostring(value) })
            end
            return gamma_arena_result.ok(true)
        end,
        cap_bleeding = function(npc, maximum)
            local called, value = pcall(function()
                if npc.bleeding > maximum then npc.bleeding = maximum end
                return true
            end)
            if not called or value ~= true then
                return gamma_arena_result.err("GA_NPC_MEDICAL_EFFECT_FAILED", "Arena medicine bleeding cap failed", { reason = called and nil or tostring(value) })
            end
            return gamma_arena_result.ok(true)
        end,
        log = function(code, message, context)
            gamma_arena_log.info(code, message, context)
            return gamma_arena_result.ok(true)
        end
    })
end

local function default_diagnostics()
    local path = nil
    local resolved, value = pcall(function()
        local root = getFS():update_path("$logs$", "")
        if type(root) ~= "string" or root == "" then return nil end
        local suffix = root:sub(-1)
        if suffix ~= "\\" and suffix ~= "/" then root = root .. "\\" end
        return root .. "gamma_arena_diagnostics.log"
    end)
    if resolved then path = value end
    return gamma_arena_diagnostics.new({
        path = path,
        open = function(file_path, mode) return io.open(file_path, mode) end,
        clock = function() return time_global() end,
        level = function()
            if level == nil or type(level.present) ~= "function" or type(level.name) ~= "function" then
                return "unavailable"
            end
            local present_called, present = pcall(level.present)
            if not present_called or present ~= true then return "unavailable" end
            local called, current = pcall(level.name)
            return called and current or "unavailable"
        end,
        fallback_log = function(code, message, context) gamma_arena_log.warn(code, message, context) end
    })
end

local function default_save_guard(diagnostics)
    if runtime_save_guard ~= nil then return runtime_save_guard end
    runtime_save_guard = gamma_arena_save_guard.new({
        get_execute = function() return _G and _G.exec_console_cmd or exec_console_cmd end,
        set_execute = function(value)
            if type(_G) ~= "table" then return false end
            _G.exec_console_cmd = value
            return true
        end,
        remove_time_event = function(kind, name)
            if type(RemoveTimeEvent) ~= "function" then return false end
            RemoveTimeEvent(kind, name)
            return true
        end,
        clock = function() return time_global() end,
        checkpoint = function(code, context) return diagnostics:checkpoint(code, context) end
    })
    return runtime_save_guard
end

function compose(overrides)
    overrides = overrides or {}
    local instance = nil
    local function active_instance() return instance end
    local store = overrides.store or gamma_arena_session_store.new_store()
    local config = overrides.config or current_config()
    local diagnostics = overrides.diagnostics or default_diagnostics()
    local weapon_diagnostics = overrides.weapon_diagnostics or function(context)
        context = type(context) == "table" and context or {}
        if context.actor == nil then context.actor = db and db.actor or nil end
        return runtime_weapon_diagnostic(context)
    end
    local actor_adapter = overrides.actor or default_actor_adapter(active_instance, diagnostics, weapon_diagnostics)
    local entity_adapter = overrides.entities or default_entity_adapter(actor_adapter, active_instance, diagnostics)
    local npc_medical = overrides.npc_medical or default_npc_medical_controller(entity_adapter)
    local save_guard = overrides.save_guard or default_save_guard(diagnostics)
    local catalogs_port = overrides.catalogs or function() return gamma_arena_catalog.load() end
    local layout_adapter = overrides.layout_adapter or default_runtime_layout_adapter()
    local layout_port = overrides.layout or function(layout_id)
        local catalogs = catalogs_port()
        if not catalogs.ok then return catalogs end
        local layouts = catalogs.value and catalogs.value.layouts
        local layout = type(layouts) == "table" and layouts[layout_id or "rostok_arena_v1"] or nil
        if type(layout) ~= "table" then
            return gamma_arena_result.err("GA_ACTOR_LAYOUT_INVALID", "Requested Arena layout is unavailable", { layout_id = layout_id })
        end
        if layout_adapter == nil or type(layout_adapter.resolve) ~= "function" then
            return gamma_arena_result.err("GA_LAYOUT_API_MISSING", "Arena runtime layout adapter is unavailable")
        end
        return layout_adapter:resolve(layout)
    end
    local preflight_port = overrides.preflight or function()
        local catalogs = catalogs_port()
        if not catalogs.ok then return catalogs end
        local compatible = gamma_arena_compat.preflight(runtime_probes(catalogs.value))
        if not compatible.ok then return compatible end
        local resolved = layout_port("rostok_arena_v1")
        if not resolved.ok then return resolved end
        return gamma_arena_result.ok(true)
    end
    local teardown_clock = overrides.teardown_clock or function() return time_global() end
    local teardown_timeout_ms = overrides.teardown_timeout_ms or 10000
    local teardown_max_updates = overrides.teardown_max_updates or 64
    local entity_teardown_max_updates = overrides.entity_teardown_max_updates or overrides.teardown_max_updates or MAX_TEARDOWN_UPDATES
    local actor_teardown_max_updates = overrides.actor_teardown_max_updates or overrides.teardown_max_updates or 64
    local teardown = overrides.teardown
    if teardown == nil then
        local teardown_context = nil
        teardown = function(_, preserve, cycle)
            if preserve == true then return gamma_arena_result.ok(true) end
            if teardown_context == nil or teardown_context.cycle ~= cycle then
                teardown_context = { cycle = cycle, stage = "entities", entity = {}, actor = {}, session = instance and instance:session_snapshot() or nil }
            end
            if teardown_context.stage == "entities" then
                local entities = step_entity_cleanup(entity_adapter, teardown_context.entity, {
                    clock = teardown_clock,
                    timeout_ms = teardown_timeout_ms,
                    max_updates = entity_teardown_max_updates
                })
                if not entities.ok then return entities end
                if entities.value.pending == true then return gamma_arena_result.ok({ pending = true, stage = "entities" }) end
                teardown_context.stage = "actor"
            end
            if teardown_context.stage == "actor" then
                local actor = step_actor_cleanup(actor_adapter, teardown_context.actor, {
                    clock = teardown_clock,
                    timeout_ms = teardown_timeout_ms,
                    max_updates = actor_teardown_max_updates
                })
                if not actor.ok then return actor end
                if actor.value.pending == true then return gamma_arena_result.ok({ pending = true, stage = "actor" }) end
                teardown_context.stage = "done"
            end
            return gamma_arena_result.ok(true)
        end
    end
    local deps = {
        store = store,
        config = config,
        current_level = overrides.current_level or function()
            if level == nil or type(level.name) ~= "function" then
                return gamma_arena_result.err("GA_CURRENT_LEVEL_FAILED", "Current level API is unavailable")
            end
            local called, value = pcall(level.name)
            if not called or type(value) ~= "string" or value == "" then
                return gamma_arena_result.err("GA_CURRENT_LEVEL_FAILED", "Current level could not be read safely", {
                    reason = called and nil or tostring(value)
                })
            end
            return gamma_arena_result.ok(value)
        end,
        reconcile = overrides.reconcile or function(config) return gamma_arena_migrations.migrate(config) end,
        compat = overrides.compat or { preflight = preflight_port },
        preflight = preflight_port,
        identity = overrides.identity or default_identity,
        ui = overrides.ui or default_fatal_ui(),
        notify = overrides.notify or default_notify,
        disconnect = overrides.disconnect or default_disconnect,
        teardown = teardown or neutral_teardown,
        launch_options = overrides.launch_options,
        actor = actor_adapter,
        entities = entity_adapter,
        npc_medical = npc_medical,
        diagnostics = diagnostics,
        weapon_diagnostics = weapon_diagnostics,
        save_guard = save_guard,
        layout = layout_port,
        mode_policy = overrides.mode_policy or gamma_arena_mode_skirmish,
        catalogs = catalogs_port,
        generator = overrides.generator or function(session, fight_index, catalog_snapshot, resolved_layout)
            return gamma_arena_generator.generate(session, fight_index, catalog_snapshot, resolved_layout)
        end,
        validator = overrides.validator or function(spec, catalog_snapshot, resolved_layout)
            return gamma_arena_validator.validate(spec, catalog_snapshot, resolved_layout)
        end,
        clock = overrides.clock or function() return time_global() end,
        result_ui = overrides.result_ui or default_result_ui(),
        battle_ui = overrides.battle_ui or default_battle_ui(),
        log = overrides.log or gamma_arena_log
    }
    instance = gamma_arena_orchestrator.new(deps)
    return instance
end

local function callback_failure(instance, name, reason)
    local failure = gamma_arena_result.err("GA_CALLBACK_FAILED", "Arena callback failed safely", {
        callback = name,
        reason = tostring(reason)
    })
    local lookup_ok, handler = pcall(function() return instance and instance.on_callback_error end)
    if lookup_ok and type(handler) == "function" then
        local handled_ok, handled = pcall(handler, instance, name, tostring(reason))
        if handled_ok and type(handled) == "table" and type(handled.ok) == "boolean" then return handled end
        if not handled_ok then
            failure = gamma_arena_result.err("GA_CALLBACK_ROUTING_FAILED", "Arena callback exception routing failed safely", {
                callback = name,
                reason = tostring(handled)
            })
        end
    end
    pcall(gamma_arena_log.error, failure.error.code, failure.error.message, failure.error.context)
    return failure
end

local function active_state(instance, name)
    local lookup_ok, method = pcall(function() return instance and instance.is_active end)
    if not lookup_ok or type(method) ~= "function" then
        return false, callback_failure(instance, name, "is_active method is unavailable")
    end
    local call_ok, active = pcall(method, instance)
    if not call_ok then return false, callback_failure(instance, name, active) end
    return active == true, nil
end

local function call_instance(instance, name, ...)
    local method = instance[name]
    if type(method) ~= "function" then error("callback method is unavailable: " .. tostring(name)) end
    return method(instance, ...)
end

local function invoke_callback(instance, name, fn, ...)
    local was_active, active_error = active_state(instance, name)
    if active_error ~= nil then return active_error end
    local values = pack_values(pcall(fn, ...))
    if not values[1] then return callback_failure(instance, name, values[2]) end
    local result = values[2]
    if type(result) == "table" and result.ok == false then
        local lookup_ok, handler = pcall(function() return instance and instance.on_callback_result_error end)
        if not lookup_ok or type(handler) ~= "function" then
            return callback_failure(instance, name, "structured Result failure router is unavailable")
        end
        local routed_ok, routed_reason = pcall(handler, instance, name, result, was_active)
        if not routed_ok then return callback_failure(instance, name, routed_reason) end
    end
    return unpack_values(values, 2, values.n)
end

local function invoke_runtime_effect(instance, name, ...)
    local arguments = pack_values(...)
    return invoke_callback(instance, name, function()
        local active = instance:is_active()
        if not active then return end
        return call_instance(instance, name, unpack_values(arguments, 1, arguments.n))
    end)
end

function make_callbacks(instance)
    local callbacks = {}
    for _, callback_name in ipairs(callback_names) do
        local name = callback_name
        if guarded_callbacks[name] then
            callbacks[name] = function(...) return invoke_runtime_effect(instance, name, ...) end
        elseif name == "save_state" then
            callbacks[name] = function(...)
                local armed = false
                local lookup_ok, method = pcall(function() return instance and instance.save_guard_armed end)
                if lookup_ok and type(method) == "function" then
                    local called, value = pcall(method, instance)
                    armed = called and value == true
                end
                local values = pack_values(invoke_callback(instance, name, function(...) return call_instance(instance, name, ...) end, ...))
                if not armed then return end
                return unpack_values(values, 1, values.n)
            end
        else
            callbacks[name] = function(...) return invoke_callback(instance, name, function(...) return call_instance(instance, name, ...) end, ...) end
        end
    end
    return callbacks
end

local Registrar = {}
Registrar.__index = Registrar

function Registrar:status()
    return self.registration_state
end

local function operation_failed(called, value)
    return not called or value == false or (type(value) == "table" and value.ok == false)
end

function Registrar:register_all_impl()
    if self.registration_state == "registered" then return gamma_arena_result.ok(false) end
    if self.registration_state == "poisoned" then
        return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_POISONED", "Arena callback registration is poisoned after rollback failure")
    end
    if type(self.deps.register) ~= "function" or type(self.deps.unregister) ~= "function" then
        self.registration_state = "poisoned"
        return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_POISONED", "Register/unregister callback APIs are required before composition")
    end
    if type(self.deps.compose) ~= "function" then
        return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "Arena orchestrator composition dependency is unavailable")
    end

    local composed_ok, instance = pcall(self.deps.compose)
    if not composed_ok or instance == nil then
        return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "Arena orchestrator composition failed safely", { reason = tostring(instance) })
    end
    local callbacks_ok, callbacks = pcall(self.deps.make_callbacks or make_callbacks, instance)
    if not callbacks_ok or type(callbacks) ~= "table" then
        return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "Arena callback router composition failed safely", { reason = tostring(callbacks) })
    end

    self.instance = instance
    self.callbacks = callbacks
    self.registered = {}
    local registration_failure = nil
    for index, name in ipairs(callback_names) do
        local callback = callbacks[name]
        if type(callback) ~= "function" then
            registration_failure = { index = index, name = name, reason = "callback reference is unavailable" }
            break
        end
        local called, value = pcall(self.deps.register, name, callback)
        if operation_failed(called, value) then
            registration_failure = { index = index, name = name, reason = tostring(value) }
            break
        end
        self.registered[#self.registered + 1] = { name = name, callback = callback }
    end

    if registration_failure == nil then
        self.registration_state = "registered"
        return gamma_arena_result.ok(true)
    end

    local rollback_errors = {}
    for index = #self.registered, 1, -1 do
        local entry = self.registered[index]
        local called, value = pcall(self.deps.unregister, entry.name, entry.callback)
        if operation_failed(called, value) then
            rollback_errors[#rollback_errors + 1] = { name = entry.name, reason = tostring(value) }
        end
    end
    if #rollback_errors > 0 then
        self.registration_state = "poisoned"
        return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_POISONED", "Arena callback rollback failed; registration is poisoned", {
            registration = registration_failure,
            rollback = rollback_errors
        })
    end

    self.registration_state = "idle"
    self.instance = nil
    self.callbacks = nil
    self.registered = {}
    return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_FAILED", "Arena callback registration failed and was rolled back", registration_failure)
end

function Registrar:register_all()
    local result = self:register_all_impl()
    if type(result) ~= "table" or type(result.ok) ~= "boolean"
        or (result.ok == false and (type(result.error) ~= "table"
            or type(result.error.code) ~= "string"
            or type(result.error.message) ~= "string")) then
        result = gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_FAILED", "Arena callback registration returned an invalid Result")
    end
    self.last_result = result
    return result
end

function Registrar:runtime_status()
    if self.last_result ~= nil and self.last_result.ok == false then
        return self.last_result
    end
    if self.registration_state ~= "registered"
        or self.instance == nil
        or type(self.callbacks) ~= "table" then
        return gamma_arena_result.err(
            "GA_BOOTSTRAP_NOT_READY",
            "Arena runtime is not registered",
            { registration_state = self.registration_state })
    end
    return gamma_arena_result.ok(true)
end

function new_registrar(deps)
    if type(deps) ~= "table" then return nil end
    return setmetatable({ deps = deps, registration_state = "idle", instance = nil, callbacks = nil, registered = {}, last_result = nil }, Registrar)
end

function runtime_status()
    if runtime_registrar == nil then
        return gamma_arena_result.err("GA_BOOTSTRAP_NOT_READY", "Arena runtime is not registered")
    end
    return runtime_registrar:runtime_status()
end

function ensure_initialized()
    if runtime_registrar == nil then
        runtime_registrar = new_registrar({
            compose = compose,
            make_callbacks = make_callbacks,
            register = RegisterScriptCallback,
            unregister = UnregisterScriptCallback
        })
    end
    local result = runtime_registrar:register_all()
    if result.ok then
        runtime_orchestrator = runtime_registrar.instance
        runtime_callbacks = runtime_registrar.callbacks
    else
        pcall(gamma_arena_log.error, result.error.code, result.error.message, result.error.context)
    end
    return result
end

function request_restart()
    if runtime_orchestrator == nil then return gamma_arena_result.ok(false) end
    return invoke_callback(runtime_orchestrator, "manual_restart", function()
        return call_instance(runtime_orchestrator, "restart_arena_action")
    end)
end

function on_game_start()
    return ensure_initialized()
end
