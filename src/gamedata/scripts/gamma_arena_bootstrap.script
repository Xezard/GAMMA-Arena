local runtime_orchestrator = nil
local runtime_callbacks = nil
local runtime_registrar = nil
local identity_counter = 0
local unpack_values = unpack

local callback_names = {
    "on_game_load",
    "actor_on_first_update",
    "actor_on_update",
    "actor_on_before_death",
    "npc_on_death_callback",
    "save_state",
    "load_state",
    "on_before_save_input",
    "on_before_load_input",
    "actor_on_net_destroy",
    "on_before_level_changing"
}

local guarded_callbacks = {
    actor_on_before_death = true,
    npc_on_death_callback = true,
    save_state = true,
    on_before_save_input = true,
    on_before_load_input = true,
    actor_on_net_destroy = true,
    on_before_level_changing = true
}

local function pack_values(...)
    return { n = select("#", ...), ... }
end

local function module_store_port()
    return {
        inspect_intents = function(_, config) return gamma_arena_session_store.inspect_intents(config) end,
        consume_launch = function(_, config, options) return gamma_arena_session_store.consume_launch(config, options) end,
        prepare_resume = function(_, config, expected) return gamma_arena_session_store.prepare_resume(config, expected) end,
        clear_transient = function(_, config) return gamma_arena_session_store.clear_transient(config) end
    }
end

local function current_config()
    local ok, config = pcall(function() return axr_main and axr_main.config end)
    return ok and config or nil
end

local function runtime_probes(catalogs)
    return {
        RegisterScriptCallback = RegisterScriptCallback,
        UnregisterScriptCallback = UnregisterScriptCallback,
        ini_file = ini_file,
        system_ini = system_ini,
        alife = alife,
        alife_create = alife_create,
        alife_create_item = alife_create_item,
        alife_release_id = alife_release_id,
        getFS = getFS,
        se_save_var = se_save_var,
        level = level,
        patrol = patrol,
        db = db,
        axr_main = axr_main,
        safe_release_manager = safe_release_manager,
        catalogs = catalogs
    }
end

local function default_preflight()
    local catalogs = gamma_arena_catalog.load()
    if not catalogs.ok then return catalogs end
    return gamma_arena_compat.preflight(runtime_probes(catalogs.value))
end

local function default_identity()
    identity_counter = identity_counter + 1
    local epoch = 0
    if os and type(os.time) == "function" then
        local ok, value = pcall(os.time)
        if ok and type(value) == "number" and value == math.floor(value) and value >= 0 then epoch = value end
    end
    return gamma_arena_result.ok({
        session_id = "ga_session_" .. tostring(epoch) .. "_" .. tostring(identity_counter),
        session_nonce = "ga_nonce_" .. tostring(epoch) .. "_" .. tostring(identity_counter)
    })
end

local function default_notify(string_id)
    local text = string_id
    if game and type(game.translate_string) == "function" then
        local ok, translated = pcall(game.translate_string, string_id)
        if ok and type(translated) == "string" then text = translated end
    end
    if actor_menu and type(actor_menu.set_msg) == "function" then
        actor_menu.set_msg(1, text, 5)
        return
    end
    if db and db.actor and type(db.actor.give_game_news) == "function" then
        db.actor:give_game_news(text, "", "ui_inGame2_PD_storonnik_ravnovesiya", 0, 5000)
        return
    end
    gamma_arena_log.warn("GA_MANUAL_INPUT_NOTICE_UNAVAILABLE", text, {})
end

local function default_fatal_ui()
    return {
        show_fatal = function(errors, callback)
            return gamma_arena_ui_start.show_fatal(nil, errors, function() return callback() end, nil)
        end
    }
end

local function default_disconnect()
    return exec_console_cmd("disconnect")
end

local function neutral_teardown()
    return gamma_arena_result.ok(true)
end

function compose(overrides)
    overrides = overrides or {}
    local deps = {
        store = overrides.store or module_store_port(),
        config = overrides.config or current_config(),
        preflight = overrides.preflight or default_preflight,
        identity = overrides.identity or default_identity,
        ui = overrides.ui or default_fatal_ui(),
        notify = overrides.notify or default_notify,
        disconnect = overrides.disconnect or default_disconnect,
        teardown = overrides.teardown or neutral_teardown,
        launch_options = overrides.launch_options
    }
    return gamma_arena_orchestrator.new(deps)
end

local function callback_failure(instance, name, reason)
    local failure = gamma_arena_result.err("GA_CALLBACK_FAILED", "Arena callback failed safely", {
        callback = name,
        reason = tostring(reason)
    })
    local lookup_ok, handler = pcall(function() return instance and instance.on_callback_error end)
    if lookup_ok and type(handler) == "function" then
        local handled_ok, handled = pcall(handler, instance, name, tostring(reason))
        if handled_ok and type(handled) == "table" and type(handled.ok) == "boolean" then return handled end
        if not handled_ok then
            failure = gamma_arena_result.err("GA_CALLBACK_ROUTING_FAILED", "Arena callback exception routing failed safely", {
                callback = name,
                reason = tostring(handled)
            })
        end
    end
    pcall(gamma_arena_log.error, failure.error.code, failure.error.message, failure.error.context)
    return failure
end

local function active_state(instance, name)
    local lookup_ok, method = pcall(function() return instance and instance.is_active end)
    if not lookup_ok or type(method) ~= "function" then
        return false, callback_failure(instance, name, "is_active method is unavailable")
    end
    local call_ok, active = pcall(method, instance)
    if not call_ok then return false, callback_failure(instance, name, active) end
    return active == true, nil
end

local function call_instance(instance, name, ...)
    local method = instance[name]
    if type(method) ~= "function" then error("callback method is unavailable: " .. tostring(name)) end
    return method(instance, ...)
end

local function invoke_callback(instance, name, fn, ...)
    local was_active, active_error = active_state(instance, name)
    if active_error ~= nil then return active_error end
    local values = pack_values(pcall(fn, ...))
    if not values[1] then return callback_failure(instance, name, values[2]) end
    local result = values[2]
    if type(result) == "table" and result.ok == false then
        local lookup_ok, handler = pcall(function() return instance and instance.on_callback_result_error end)
        if not lookup_ok or type(handler) ~= "function" then
            return callback_failure(instance, name, "structured Result failure router is unavailable")
        end
        local routed_ok, routed_reason = pcall(handler, instance, name, result, was_active)
        if not routed_ok then return callback_failure(instance, name, routed_reason) end
    end
    return unpack_values(values, 2, values.n)
end

local function invoke_runtime_effect(instance, name, ...)
    local arguments = pack_values(...)
    return invoke_callback(instance, name, function()
        local active = instance:is_active()
        if not active then return end
        return call_instance(instance, name, unpack_values(arguments, 1, arguments.n))
    end)
end

function make_callbacks(instance)
    local callbacks = {}
    for _, callback_name in ipairs(callback_names) do
        local name = callback_name
        if guarded_callbacks[name] then
            callbacks[name] = function(...) return invoke_runtime_effect(instance, name, ...) end
        else
            callbacks[name] = function(...) return invoke_callback(instance, name, function(...) return call_instance(instance, name, ...) end, ...) end
        end
    end
    return callbacks
end

local Registrar = {}
Registrar.__index = Registrar

function Registrar:status()
    return self.registration_state
end

local function operation_failed(called, value)
    return not called or value == false or (type(value) == "table" and value.ok == false)
end

function Registrar:register_all()
    if self.registration_state == "registered" then return gamma_arena_result.ok(false) end
    if self.registration_state == "poisoned" then
        return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_POISONED", "Arena callback registration is poisoned after rollback failure")
    end
    if type(self.deps.register) ~= "function" or type(self.deps.unregister) ~= "function" then
        self.registration_state = "poisoned"
        return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_POISONED", "Register/unregister callback APIs are required before composition")
    end
    if type(self.deps.compose) ~= "function" then
        return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "Arena orchestrator composition dependency is unavailable")
    end

    local composed_ok, instance = pcall(self.deps.compose)
    if not composed_ok or instance == nil then
        return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "Arena orchestrator composition failed safely", { reason = tostring(instance) })
    end
    local callbacks_ok, callbacks = pcall(self.deps.make_callbacks or make_callbacks, instance)
    if not callbacks_ok or type(callbacks) ~= "table" then
        return gamma_arena_result.err("GA_BOOTSTRAP_COMPOSE_FAILED", "Arena callback router composition failed safely", { reason = tostring(callbacks) })
    end

    self.instance = instance
    self.callbacks = callbacks
    self.registered = {}
    local registration_failure = nil
    for index, name in ipairs(callback_names) do
        local callback = callbacks[name]
        if type(callback) ~= "function" then
            registration_failure = { index = index, name = name, reason = "callback reference is unavailable" }
            break
        end
        local called, value = pcall(self.deps.register, name, callback)
        if operation_failed(called, value) then
            registration_failure = { index = index, name = name, reason = tostring(value) }
            break
        end
        self.registered[#self.registered + 1] = { name = name, callback = callback }
    end

    if registration_failure == nil then
        self.registration_state = "registered"
        return gamma_arena_result.ok(true)
    end

    local rollback_errors = {}
    for index = #self.registered, 1, -1 do
        local entry = self.registered[index]
        local called, value = pcall(self.deps.unregister, entry.name, entry.callback)
        if operation_failed(called, value) then
            rollback_errors[#rollback_errors + 1] = { name = entry.name, reason = tostring(value) }
        end
    end
    if #rollback_errors > 0 then
        self.registration_state = "poisoned"
        return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_POISONED", "Arena callback rollback failed; registration is poisoned", {
            registration = registration_failure,
            rollback = rollback_errors
        })
    end

    self.registration_state = "idle"
    self.instance = nil
    self.callbacks = nil
    self.registered = {}
    return gamma_arena_result.err("GA_BOOTSTRAP_REGISTRATION_FAILED", "Arena callback registration failed and was rolled back", registration_failure)
end

function new_registrar(deps)
    if type(deps) ~= "table" then return nil end
    return setmetatable({ deps = deps, registration_state = "idle", instance = nil, callbacks = nil, registered = {} }, Registrar)
end

function on_game_start()
    if runtime_registrar == nil then
        runtime_registrar = new_registrar({
            compose = compose,
            make_callbacks = make_callbacks,
            register = RegisterScriptCallback,
            unregister = UnregisterScriptCallback
        })
    end
    local result = runtime_registrar:register_all()
    if result.ok then
        runtime_orchestrator = runtime_registrar.instance
        runtime_callbacks = runtime_registrar.callbacks
    else
        pcall(gamma_arena_log.error, result.error.code, result.error.message, result.error.context)
    end
    return result
end
