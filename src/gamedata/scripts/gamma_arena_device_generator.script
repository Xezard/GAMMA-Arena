local EXPECTED_COUNT = 4
local EXPECTED_WEIGHT = 100
local DEVICE_MANIFEST = {
    { id='headlamp', section='device_torch_dummy', kind='headlamp', selection_weight=50, nv_effect=nil },
    { id='nv_gen1', section='device_torch_nv_1', kind='gen1', selection_weight=25, nv_effect='nightvision_1' },
    { id='nv_gen2', section='device_torch_nv_2', kind='gen2', selection_weight=18, nv_effect='nightvision_2' },
    { id='nv_gen3', section='device_torch_nv_3', kind='gen3', selection_weight=7, nv_effect='nightvision_3' }
}

local function copy_device(item)
    return {
        catalog_id = item.id,
        section = item.section,
        kind = item.kind,
        selection_weight = item.selection_weight,
        nv_effect = item.nv_effect
    }
end

local function valid_catalog(catalogs)
    if type(catalogs) ~= "table" or type(catalogs.device_list) ~= "table" or #catalogs.device_list ~= EXPECTED_COUNT then return false end
    if catalogs.schema_version ~= 10 or catalogs.revision ~= 11 or catalogs.generator_version ~= 11 then return false end
    local total = 0
    for index, item in ipairs(catalogs.device_list) do
        local expected = DEVICE_MANIFEST[index]
        if type(item) ~= "table" or type(item.id) ~= "string" or item.id == ""
            or type(item.section) ~= "string" or item.section == ""
            or type(item.kind) ~= "string" or item.kind == ""
            or not gamma_arena_number.is_positive_integer(item.selection_weight)
            or item.weight ~= nil or item.id ~= expected.id or item.section ~= expected.section
            or item.kind ~= expected.kind or item.selection_weight ~= expected.selection_weight
            or item.nv_effect ~= expected.nv_effect then return false end
        total = total + item.selection_weight
    end
    return total == EXPECTED_WEIGHT
end

function select(catalogs, rng)
    if not valid_catalog(catalogs) or type(rng) ~= "table" or type(rng.next_int) ~= "function" then
        return gamma_arena_result.err("GA_DEVICE_ARGUMENT_INVALID", "Actor device selection requires an exact catalog and RNG", {})
    end
    local called, draw = pcall(function() return rng:next_int(1, 100) end)
    if not called or not gamma_arena_number.is_integer(draw) or draw < 1 or draw > 100 then
        return gamma_arena_result.err("GA_DEVICE_SELECTION_INVALID", "Actor device RNG returned an invalid draw", { reason = called and nil or tostring(draw) })
    end
    local cumulative = 0
    for _, item in ipairs(catalogs.device_list) do
        cumulative = cumulative + item.selection_weight
        if draw <= cumulative then return gamma_arena_result.ok(copy_device(item)) end
    end
    return gamma_arena_result.err("GA_DEVICE_SELECTION_INVALID", "Actor device weights exhausted their range", { draw = draw })
end

function generate(catalogs, identity)
    if type(identity) ~= "table" or identity.generator_version ~= 11
        or not gamma_arena_number.is_integer(identity.session_seed) or identity.session_seed < 0
        or not gamma_arena_number.is_integer(identity.fight_index) or identity.fight_index < 0
        or not gamma_arena_number.is_positive_integer(identity.layout_version) then
        return gamma_arena_result.err("GA_DEVICE_ARGUMENT_INVALID", "Actor device fight identity is invalid", {})
    end
    local seed = gamma_arena_rng.derive_seed({
        "random_actor_device_v11",
        identity.session_seed,
        identity.fight_index,
        identity.generator_version,
        identity.layout_version,
        "actor_device"
    })
    return select(catalogs, gamma_arena_rng.new(seed))
end
