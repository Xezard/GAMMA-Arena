local PRIMARY_BAND_PERCENT = 70
local CORE_RNG_EPOCH = 6
local MEDICAL_RNG_EPOCH = 1
local PLAYER_AMMO_CHANCE = {
    w_pistol = 40,
    w_smg = 25,
    w_shotgun = 25,
    w_rifle = 20,
    w_sniper = 10
}

function scaled_ammo_boxes(rng_factory, weapon_kind, opponent_count)
    local chance = PLAYER_AMMO_CHANCE[weapon_kind]
    if type(rng_factory) ~= "function" or chance == nil
        or not gamma_arena_number.is_positive_integer(opponent_count) or opponent_count >= 4294967295 then
        return gamma_arena_result.err("GA_PLAYER_AMMO_SCALE_INVALID", "Player ammo scaling inputs are invalid", {})
    end
    local boxes = 1
    for index = 1, opponent_count do
        local factory_ok, rng = pcall(rng_factory, index)
        if not factory_ok or type(rng) ~= "table" or type(rng.next_int) ~= "function" then
            return gamma_arena_result.err("GA_PLAYER_AMMO_SCALE_INVALID", "Player ammo scaling RNG is unavailable", { index = index })
        end
        local draw_ok, draw = pcall(function() return rng:next_int(1, 100) end)
        if not draw_ok or not gamma_arena_number.is_integer(draw) or draw < 1 or draw > 100 then
            return gamma_arena_result.err("GA_PLAYER_AMMO_SCALE_INVALID", "Player ammo scaling RNG returned an invalid draw", { index = index })
        end
        if draw <= chance then boxes = boxes + 1 end
    end
    return gamma_arena_result.ok(boxes)
end

local function stream(request, fight_index, catalogs, epoch_or_tag, explicit_tag)
    local epoch = explicit_tag ~= nil and epoch_or_tag or CORE_RNG_EPOCH
    local tag = explicit_tag or epoch_or_tag
    return gamma_arena_rng.new(gamma_arena_rng.derive_seed({ request.mode_id, request.difficulty_id, request.session_seed, fight_index, epoch, catalogs.layouts[request.layout_id].version, tag }))
end

local function medical_stream(request, fight_index, catalogs, tag)
    return stream(request, fight_index, catalogs, MEDICAL_RNG_EPOCH, tag)
end

local function actor_medical_streams(request, fight_index, catalogs)
    local streams = {
        required_category = medical_stream(request, fight_index, catalogs, "actor_medical_required_category"),
        required_section = medical_stream(request, fight_index, catalogs, "actor_medical_required_section"),
        optional_category = {}, optional_section = {}
    }
    for index = 1, 3 do
        streams.optional_category[index] = medical_stream(request, fight_index, catalogs, "actor_medical_optional_category:" .. index)
        streams.optional_section[index] = medical_stream(request, fight_index, catalogs, "actor_medical_optional_section:" .. index)
    end
    return streams
end

local function enemy_medical_streams(request, fight_index, catalogs, count)
    local streams = { mix = medical_stream(request, fight_index, catalogs, "enemy_medical_mix"), recipients = { medkit = {}, bandage = {} } }
    for _, section in ipairs({ "medkit", "bandage" }) do
        for index = 1, count do
            streams.recipients[section][index] = medical_stream(request, fight_index, catalogs, "enemy_medical_recipient:" .. section .. ":" .. index)
        end
    end
    return streams
end

local function separate_legacy_bandage(loadout_value, catalogs)
    local bandage = type(catalogs.consumables) == "table" and catalogs.consumables.bandage or nil
    if type(loadout_value) ~= "table" or type(bandage) ~= "table" or not gamma_arena_number.is_positive_integer(loadout_value.cost)
        or loadout_value.cost <= bandage.cost then return false end
    loadout_value.gear_cost = loadout_value.cost - bandage.cost
    loadout_value.medical_cost = 0
    loadout_value.cost = loadout_value.gear_cost
    loadout_value.consumables = {}
    return true
end

local function apply_medical(loadout_value, medical)
    loadout_value.consumables = {}
    for index, section in ipairs(medical.sections) do loadout_value.consumables[index] = section end
    loadout_value.medical_cost = medical.medical_cost
    loadout_value.cost = loadout_value.gear_cost + loadout_value.medical_cost
end

local function pick_affordable_band(rng, values, maximum)
    local affordable, band = {}, {}
    local threshold = math.ceil(maximum * PRIMARY_BAND_PERCENT / 100)
    local highest
    for _, value in ipairs(values or {}) do
        if type(value) == "table" and gamma_arena_number.is_positive_integer(value.cost) and value.cost <= maximum then
            affordable[#affordable + 1] = value
            highest = highest and math.max(highest, value.cost) or value.cost
            if value.cost >= threshold then band[#band + 1] = value end
        end
    end
    if #affordable == 0 then return nil end
    if #band == 0 then
        for _, value in ipairs(affordable) do if value.cost == highest then band[#band + 1] = value end end
    end
    return rng:pick(band)
end

local function weapon_is_primary(weapon)
    return type(weapon) == "table" and weapon.kind ~= "w_pistol"
end

local function filtered_role_pool(source, role, sniper_used)
    local values = {}
    for _, weapon in ipairs(source or {}) do
        local primary = weapon_is_primary(weapon)
        if ((role == "primary" and primary) or (role == "secondary" and not primary))
            and not (sniper_used and weapon.kind == "w_sniper") then
            values[#values + 1] = weapon
        end
    end
    return values
end

local function global_role_pool(catalogs, role, sniper_used)
    local source = role == "primary" and catalogs.primary_weapon_list or catalogs.secondary_weapon_list
    return filtered_role_pool(source, role, sniper_used)
end

local function role_weapon_pool(catalogs, profile, role, sniper_used)
    local profile_pools = type(catalogs.weapon_pools_by_profile) == "table" and catalogs.weapon_pools_by_profile[profile.section] or nil
    local source = type(profile_pools) == "table" and profile_pools[role] or nil
    local values = filtered_role_pool(source, role, sniper_used)
    if #values == 0 then return global_role_pool(catalogs, role, sniper_used) end
    return values
end

local function minimum_cost(values)
    local minimum
    for _, value in ipairs(values or {}) do
        if type(value) == "table" and gamma_arena_number.is_positive_integer(value.cost) then
            minimum = minimum and math.min(minimum, value.cost) or value.cost
        end
    end
    return minimum
end

local function minimum_loadout_cost(catalogs, weapons)
    local minimum_outfit = minimum_cost(catalogs.outfit_list)
    local bandage = catalogs.consumables and catalogs.consumables.bandage
    if minimum_outfit == nil or type(bandage) ~= "table" then return nil end
    local minimum
    for _, weapon in ipairs(weapons or {}) do
        local ammo = catalogs.ammo and catalogs.ammo[weapon.ammo]
        if type(ammo) == "table" then
            local cost = weapon.cost + ammo.cost * weapon.ammo_box_min + minimum_outfit + bandage.cost
            minimum = minimum and math.min(minimum, cost) or cost
        end
    end
    return minimum
end

local function combination_loadout(rng, catalogs, budget, code, weapons)
    local allowed = nil
    if type(weapons) == "table" then
        allowed = {}
        for _, weapon in ipairs(weapons) do allowed[weapon.section] = true end
    end
    local candidates = {}
    for _, choice in ipairs(catalogs.combinations or {}) do
        if allowed == nil or allowed[choice.weapon] then candidates[#candidates + 1] = choice end
    end
    local choice = pick_affordable_band(rng, candidates, budget)
    if not choice then return gamma_arena_result.err(code, "No valid loadout fits the requested budget", { budget = budget }) end
    return gamma_arena_result.ok({ weapon = choice.weapon, ammo = choice.ammo, ammo_boxes = choice.ammo_boxes, outfit = choice.outfit, consumables = { choice.consumables[1] }, cost = choice.cost })
end

local function staged_loadout(rng, catalogs, budget, code, weapons)
    local bandage = catalogs.consumables and catalogs.consumables.bandage
    if type(bandage) ~= "table" then return gamma_arena_result.err(code, "Dynamic catalog has no bandage", { budget = budget }) end
    local candidates = {}
    for _, weapon in ipairs(weapons or {}) do
        local ammo = catalogs.ammo and catalogs.ammo[weapon.ammo]
        if type(ammo) == "table" then
            for _, outfit in ipairs(catalogs.outfit_list or {}) do
                for boxes = weapon.ammo_box_min, weapon.ammo_box_max do
                    local cost = weapon.cost + ammo.cost * boxes + outfit.cost + bandage.cost
                    if cost <= budget then
                        candidates[#candidates + 1] = {
                            weapon = weapon.section,
                            ammo = ammo.section,
                            ammo_boxes = boxes,
                            outfit = outfit.section,
                            consumables = { bandage.section },
                            cost = cost
                        }
                    end
                end
            end
        end
    end
    local choice = pick_affordable_band(rng, candidates, budget)
    if not choice then return gamma_arena_result.err(code, "No valid dynamic loadout fits the requested budget", { budget = budget }) end
    return gamma_arena_result.ok({ weapon = choice.weapon, ammo = choice.ammo, ammo_boxes = choice.ammo_boxes, outfit = choice.outfit, consumables = { choice.consumables[1] }, cost = choice.cost })
end

local function loadout(rng, catalogs, budget, code, weapons)
    local source = weapons
    if type(source) ~= "table" or #source == 0 then source = catalogs.weapon_list end
    if catalogs.selection_mode == "staged" then return staged_loadout(rng, catalogs, budget, code, source) end
    return combination_loadout(rng, catalogs, budget, code, source)
end

local PLAYER_WEAPON_CLASSES = { "w_pistol", "w_smg", "w_shotgun", "w_rifle", "w_sniper" }
local PLAYER_ARMOR_CLASSES = { "light", "medium", "scientific", "heavy", "powered_exo" }

local function sorted_by_section(values)
    local sorted = {}
    for _, value in ipairs(values or {}) do sorted[#sorted + 1] = value end
    table.sort(sorted, function(left, right) return left.section < right.section end)
    return sorted
end

local function player_pair_has_completion(catalogs, budget, weapon_class, armor_class)
    local bandage = catalogs.consumables and catalogs.consumables.bandage
    if type(bandage) ~= "table" then return false end
    for _, weapon in ipairs(catalogs.actor_weapon_list or {}) do
        local ammo = catalogs.ammo and catalogs.ammo[weapon.ammo]
        if weapon.kind == weapon_class and type(ammo) == "table" then
            for boxes = weapon.ammo_box_min, weapon.ammo_box_max do
                for _, outfit in ipairs(catalogs.outfit_list or {}) do
                    if outfit.armor_class == armor_class and weapon.cost + ammo.cost * boxes + outfit.cost + bandage.cost <= budget then return true end
                end
            end
        end
    end
    return false
end

function select_player_class_pair(rng, difficulty, available_pairs)
    local eligible, total = {}, 0
    for _, pair in ipairs(available_pairs or {}) do
        local weapon_weight = difficulty.player_weapon_weights[pair.weapon_class] or 0
        local armor_weight = difficulty.player_armor_weights[pair.armor_class] or 0
        local weight = weapon_weight * armor_weight
        if pair.available == true and weight > 0 then
            total = total + weight
            eligible[#eligible + 1] = { weapon_class = pair.weapon_class, armor_class = pair.armor_class, weight = weight }
        end
    end
    if total == 0 then return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "No positive-weight player class pair fits the budget") end
    local draw = rng:next_int(1, total)
    local cumulative = 0
    for _, pair in ipairs(eligible) do
        cumulative = cumulative + pair.weight
        if draw <= cumulative then return gamma_arena_result.ok(pair) end
    end
    return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "Weighted player class selection exhausted its range")
end

function select_bonus_ammo(category_rng, section_rng, weapon)
    if type(weapon) ~= "table" or type(weapon.ammo) ~= "string" or type(weapon.ammo_variants) ~= "table"
        or type(category_rng) ~= "table" or type(section_rng) ~= "table" then return nil end
    local draw = category_rng:next_int(1, 100)
    local requested_category = draw <= 60 and "standard" or (draw <= 75 and "special" or "armor_piercing")
    local eligible = {}
    for _, variant in ipairs(weapon.ammo_variants) do
        if type(variant) == "table" and type(variant.section) == "string" and variant.category == requested_category then
            eligible[#eligible + 1] = variant
        end
    end
    if #eligible > 0 then
        local selected = section_rng:pick(eligible)
        return { section = selected.section, requested_category = requested_category, resolved_category = requested_category, boxes = 1 }
    end
    local base = weapon.ammo_variants[1]
    if type(base) ~= "table" or base.section ~= weapon.ammo or base.category ~= "standard" then return nil end
    return { section = base.section, requested_category = requested_category, resolved_category = "standard", boxes = 1 }
end

function player_loadout(request, fight_index, catalogs, difficulty)
    local bandage = catalogs.consumables and catalogs.consumables.bandage
    if type(bandage) ~= "table" then return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "Dynamic catalog has no bandage") end
    local equipment_budget = difficulty.player_gear_budget + bandage.cost
    local pairs = {}
    for _, weapon_class in ipairs(PLAYER_WEAPON_CLASSES) do
        for _, armor_class in ipairs(PLAYER_ARMOR_CLASSES) do
            pairs[#pairs + 1] = { weapon_class = weapon_class, armor_class = armor_class, available = player_pair_has_completion(catalogs, equipment_budget, weapon_class, armor_class) }
        end
    end
    local selected_pair = select_player_class_pair(stream(request, fight_index, catalogs, "actor_class_pair"), difficulty, pairs)
    if not selected_pair.ok then return selected_pair end
    local pair = selected_pair.value
    local weapons = {}
    for _, weapon in ipairs(sorted_by_section(catalogs.actor_weapon_list)) do
        local ammo = catalogs.ammo and catalogs.ammo[weapon.ammo]
        local available = false
        if weapon.kind == pair.weapon_class and type(ammo) == "table" then
            for boxes = weapon.ammo_box_min, weapon.ammo_box_max do
                for _, outfit in ipairs(catalogs.outfit_list or {}) do
                    if outfit.armor_class == pair.armor_class and weapon.cost + ammo.cost * boxes + outfit.cost + bandage.cost <= equipment_budget then available = true; break end
                end
                if available then break end
            end
        end
        if available then weapons[#weapons + 1] = weapon end
    end
    if #weapons == 0 then return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "No selected player weapon has an affordable completion") end
    local weapon = stream(request, fight_index, catalogs, "actor_weapon"):pick(weapons)
    local ammo = catalogs.ammo[weapon.ammo]
    local boxes = {}
    for count = weapon.ammo_box_min, weapon.ammo_box_max do
        for _, outfit in ipairs(catalogs.outfit_list or {}) do
            if outfit.armor_class == pair.armor_class and weapon.cost + ammo.cost * count + outfit.cost + bandage.cost <= equipment_budget then boxes[#boxes + 1] = count; break end
        end
    end
    if #boxes == 0 then return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "Selected player weapon has no affordable ammunition count") end
    local ammo_boxes = stream(request, fight_index, catalogs, "actor_ammo_boxes"):pick(boxes)
    local outfits = {}
    for _, outfit in ipairs(sorted_by_section(catalogs.outfit_list)) do
        if outfit.armor_class == pair.armor_class and weapon.cost + ammo.cost * ammo_boxes + outfit.cost + bandage.cost <= equipment_budget then outfits[#outfits + 1] = outfit end
    end
    if #outfits == 0 then return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "Selected player class pair has no affordable outfit") end
    local outfit = stream(request, fight_index, catalogs, "actor_outfit"):pick(outfits)
    local cost = weapon.cost + ammo.cost * ammo_boxes + outfit.cost + bandage.cost
    return gamma_arena_result.ok({ weapon = weapon.section, ammo = ammo.section, ammo_boxes = ammo_boxes, outfit = outfit.section, consumables = { bandage.section }, cost = cost })
end

local function random_knife(rng, knives)
    if type(knives) ~= "table" or #knives < 1 then return gamma_arena_result.err("GA_NO_VALID_KNIFE", "Knife catalog is empty") end
    local choice = rng:pick(knives)
    if type(choice) ~= "table" or type(choice.section) ~= "string" or choice.section == "" then return gamma_arena_result.err("GA_NO_VALID_KNIFE", "Knife catalog returned an invalid section") end
    return gamma_arena_result.ok(choice.section)
end

local function shuffled(rng, values)
    local result = {}
    for index, value in ipairs(values or {}) do result[index] = value end
    for index = #result, 2, -1 do
        local target = rng:next_int(1, index)
        result[index], result[target] = result[target], result[index]
    end
    return result
end

local function finite_position(position)
    if position == nil then return false end
    local ok, x, y, z = pcall(function() return position.x, position.y, position.z end)
    local function finite(value) return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge end
    return ok and finite(x) and finite(y) and finite(z)
end

local function valid_resolved_layout(layout, expected)
    if type(layout) ~= "table" or layout.id ~= expected.id or layout.level ~= expected.level or layout.version ~= expected.version
        or type(layout.opponent_spawn_slots) ~= "table" or type(layout.tactical_routes) ~= "table" then return false end
    for _, slot in ipairs(layout.opponent_spawn_slots) do
        if type(slot) ~= "table" or type(slot.id) ~= "string" or slot.id == "" or type(slot.base_route) ~= "string" or slot.base_route == ""
            or not finite_position(slot.position) or not gamma_arena_number.is_integer(slot.level_vertex_id) or slot.level_vertex_id < 0
            or not gamma_arena_number.is_integer(slot.game_vertex_id) or slot.game_vertex_id < 0 then return false end
    end
    return true
end

local function select_spawn_slots(rng, layout, count)
    local native, virtual = {}, {}
    for _, slot in ipairs(layout.opponent_spawn_slots) do
        local target = slot.native == true and native or virtual
        target[#target + 1] = slot
    end
    native = shuffled(rng, native)
    virtual = shuffled(rng, virtual)
    local result = {}
    if count > #native then
        for _, slot in ipairs(native) do result[#result + 1] = slot end
        for index = 1, count - #native do result[#result + 1] = virtual[index] end
    else
        for index = 1, count do result[index] = native[index] end
    end
    return result
end

local function distance_squared(left, right)
    local dx, dy, dz = left.x - right.x, left.y - right.y, left.z - right.z
    return dx * dx + dy * dy + dz * dz
end

local function assign_routes(slots, routes)
    local assigned, used = {}, {}
    for index, slot in ipairs(slots) do
        local route
        if not used[slot.base_route] then route = slot.base_route end
        if route == nil then
            for _, candidate in ipairs(routes) do if not used[candidate] then route = candidate; break end end
        end
        if route == nil then
            local farthest, farthest_distance
            for prior = 1, index - 1 do
                local candidate_distance = distance_squared(slot.position, slots[prior].position)
                if farthest == nil or candidate_distance > farthest_distance
                    or (candidate_distance == farthest_distance and assigned[prior] < assigned[farthest]) then
                    farthest, farthest_distance = prior, candidate_distance
                end
            end
            route = assigned[farthest]
        end
        assigned[index] = route
        used[route] = true
    end
    return assigned
end

local function choose_profile(rng, catalogs, profiles, slot_budget, role, sniper_used)
    local eligible = {}
    for _, profile in ipairs(profiles or {}) do
        local weapons = role_weapon_pool(catalogs, profile, role, sniper_used)
        local mandatory = minimum_loadout_cost(catalogs, weapons)
        if mandatory == nil or profile.cost + mandatory > slot_budget then
            weapons = global_role_pool(catalogs, role, sniper_used)
            mandatory = minimum_loadout_cost(catalogs, weapons)
        end
        if mandatory ~= nil and profile.cost + mandatory <= slot_budget then
            eligible[#eligible + 1] = { cost = profile.cost, profile = profile, weapons = weapons }
        end
    end
    if #eligible == 0 then return nil end
    local maximum = 0
    for _, candidate in ipairs(eligible) do maximum = math.max(maximum, candidate.cost) end
    return pick_affordable_band(rng, eligible, maximum)
end

function generate(start_request, fight_index, catalogs, resolved_layout)
    if type(start_request) ~= "table" or type(catalogs) ~= "table" then return gamma_arena_result.err("GA_GENERATE_ARGUMENT_INVALID", "Fight generation requires request and catalogs", {}) end
    local session = gamma_arena_mode_skirmish.validate_session(start_request); if not session.ok then return session end
    if not gamma_arena_number.is_integer(start_request.session_seed) or start_request.session_seed < 0 or start_request.session_seed > 4294967295 then return gamma_arena_result.err("GA_SESSION_SEED_INVALID", "Session seed must be a finite uint32 integer", { session_seed = start_request.session_seed }) end
    if not gamma_arena_number.is_integer(fight_index) or fight_index < 0 then return gamma_arena_result.err("GA_FIGHT_INDEX_INVALID", "Fight index must be a finite non-negative integer", { fight_index = fight_index }) end
    local normalized_seed = gamma_arena_rng.normalize_uint32(start_request.session_seed)
    local normalized_request = { session_seed = normalized_seed, mode_id = start_request.mode_id, difficulty_id = start_request.difficulty_id, layout_id = start_request.layout_id }
    local layout = catalogs.layouts[normalized_request.layout_id]; if not layout then return gamma_arena_result.err("GA_LAYOUT_UNKNOWN", "Unknown Arena layout", { layout_id = normalized_request.layout_id }) end
    if not valid_resolved_layout(resolved_layout, layout) then return gamma_arena_result.err("GA_RESOLVED_LAYOUT_INVALID", "Fight generation requires a validated resolved layout", {}) end
    local envelope = gamma_arena_mode_skirmish.difficulty_envelope(normalized_request.difficulty_id, catalogs); if not envelope.ok then return envelope end
    local difficulty = envelope.value
    local maximum = math.min(difficulty.enemy_max, #resolved_layout.opponent_spawn_slots)
    if maximum < difficulty.enemy_min then return gamma_arena_result.err("GA_SPAWN_CAPACITY_INVALID", "Layout cannot support difficulty minimum", { capacity = #resolved_layout.opponent_spawn_slots }) end
    local enemy_count = stream(normalized_request, fight_index, catalogs, "enemy_count"):next_int(difficulty.enemy_min, maximum)
    local spawn_slots = select_spawn_slots(stream(normalized_request, fight_index, catalogs, "spawn_slot"), resolved_layout, enemy_count)
    local assigned_routes = assign_routes(spawn_slots, resolved_layout.tactical_routes)
    local actor = player_loadout(normalized_request, fight_index, catalogs, difficulty); if not actor.ok then return actor end
    if not separate_legacy_bandage(actor.value, catalogs) or actor.value.gear_cost > difficulty.player_gear_budget then return gamma_arena_result.err("GA_NO_VALID_PLAYER_LOADOUT", "Player gear does not fit the dedicated gear budget", { budget = difficulty.player_gear_budget }) end
    local actor_medical = gamma_arena_medical_generator.generate_actor(catalogs, difficulty, actor_medical_streams(normalized_request, fight_index, catalogs)); if not actor_medical.ok then return actor_medical end
    apply_medical(actor.value, actor_medical.value)
    local actor_knife = random_knife(stream(normalized_request, fight_index, catalogs, "actor_knife"), catalogs.knife_list); if not actor_knife.ok then return actor_knife end
    actor.value.knife = actor_knife.value
    local actor_weapon
    for _, weapon in ipairs(catalogs.weapon_list or {}) do if weapon.section == actor.value.weapon then actor_weapon = weapon; break end end
    local standard_ammo = type(actor_weapon) == "table" and type(actor_weapon.ammo_variants) == "table" and actor_weapon.ammo_variants[1] or nil
    if type(standard_ammo) ~= "table" or standard_ammo.section ~= actor.value.ammo
        or not gamma_arena_number.is_positive_integer(actor_weapon.magazine_size)
        or not gamma_arena_number.is_positive_integer(standard_ammo.box_size) then
        return gamma_arena_result.err("GA_PLAYER_AMMO_SCALE_INVALID", "Selected player weapon has invalid magazine or standard-ammo capacity", {})
    end
    local minimum_boxes = math.ceil(3 * actor_weapon.magazine_size / standard_ammo.box_size)
    local scaled = scaled_ammo_boxes(function(index)
        return stream(normalized_request, fight_index, catalogs, "actor_scaled_ammo:" .. tostring(index))
    end, actor_weapon.kind, enemy_count)
    if not scaled.ok then return scaled end
    local final_ammo_boxes = math.max(actor.value.ammo_boxes, minimum_boxes) + scaled.value
    if not gamma_arena_number.is_positive_integer(final_ammo_boxes) or final_ammo_boxes >= 4294967296 then
        return gamma_arena_result.err("GA_PLAYER_AMMO_SCALE_INVALID", "Final player ammo box count exceeds engine integer safety", { ammo_boxes = final_ammo_boxes })
    end
    actor.value.ammo_boxes = final_ammo_boxes
    local bonus = select_bonus_ammo(stream(normalized_request, fight_index, catalogs, "actor_bonus_ammo_category"), stream(normalized_request, fight_index, catalogs, "actor_bonus_ammo_section"), actor_weapon)
    if bonus == nil then return gamma_arena_result.err("GA_NO_VALID_PLAYER_BONUS_AMMO", "Selected player weapon has no valid bonus ammo", {}) end
    actor.value.bonus_ammo = bonus
    local actor_grenades = gamma_arena_grenade_generator.generate_actor(catalogs, {
        count = stream(normalized_request, fight_index, catalogs, "actor_grenade_count"),
        sections = {
            stream(normalized_request, fight_index, catalogs, "actor_grenade_section:1"),
            stream(normalized_request, fight_index, catalogs, "actor_grenade_section:2")
        }
    })
    if not actor_grenades.ok then return actor_grenades end
    actor.value.grenades = actor_grenades.value.sections
    local spec = { schema_version = 7, generator_version = catalogs.generator_version, catalog_revision = catalogs.revision, layout_version = resolved_layout.version, session_seed = normalized_seed, fight_index = fight_index, fight_id = "ga-" .. normalized_seed .. "-" .. fight_index .. "-g" .. catalogs.generator_version .. "-c" .. catalogs.revision .. "-l" .. resolved_layout.version, mode_id = "skirmish", difficulty_id = difficulty.id, layout_id = layout.id, level = resolved_layout.level, actor = { spawn_path = resolved_layout.actor_spawn_path, look_path = resolved_layout.actor_look_path, loadout = actor.value }, opponents = {}, diagnostic = "FightSpecV7 skirmish " .. difficulty.id .. " #" .. fight_index }
    local profile_pool = catalogs.profile_list
    if catalogs.selection_mode == "staged" and type(catalogs.faction_ids) == "table" and #catalogs.faction_ids > 0 then
        local enemy_faction = stream(normalized_request, fight_index, catalogs, "enemy_faction"):pick(catalogs.faction_ids)
        profile_pool = catalogs.profiles_by_faction[enemy_faction] or profile_pool
    end
    local primary_count = math.ceil(enemy_count * difficulty.primary_share_percent / 100)
    local base, remainder = math.floor(difficulty.enemy_total_budget / enemy_count), difficulty.enemy_total_budget % enemy_count
    local sniper_used = false
    for index = 1, enemy_count do
        local slot_budget = base + (index <= remainder and 1 or 0)
        local role = index == 1 and "leader" or (index <= primary_count and "primary" or "secondary")
        local weapon_role = role == "secondary" and "secondary" or "primary"
        local selection = choose_profile(stream(normalized_request, fight_index, catalogs, "enemy_profile:" .. index), catalogs, profile_pool, slot_budget, weapon_role, sniper_used)
        if not selection then return gamma_arena_result.err(weapon_role == "primary" and "GA_NO_VALID_ENEMY_PRIMARY" or "GA_NO_VALID_ENEMY_PROFILE", "No human profile and mandatory role loadout fit enemy slot", { slot = index, budget = slot_budget, role = role }) end
        local profile, weapons = selection.profile, selection.weapons
        local gear = loadout(stream(normalized_request, fight_index, catalogs, "enemy_loadout:" .. index), catalogs, slot_budget - profile.cost, "GA_NO_VALID_ENEMY_LOADOUT", weapons); if not gear.ok then return gear end
        if not separate_legacy_bandage(gear.value, catalogs) or profile.cost + gear.value.gear_cost > slot_budget - 1 then return gamma_arena_result.err("GA_NO_VALID_ENEMY_LOADOUT", "Enemy profile and gear do not fit the bandage-free slot budget", { slot = index, budget = slot_budget - 1 }) end
        local selected_weapon
        for _, weapon in ipairs(catalogs.weapon_list) do if weapon.section == gear.value.weapon then selected_weapon = weapon; break end end
        if selected_weapon and selected_weapon.kind == "w_sniper" then sniper_used = true end
        local knife = random_knife(stream(normalized_request, fight_index, catalogs, "enemy_knife:" .. index), catalogs.knife_list); if not knife.ok then return knife end
        gear.value.knife = knife.value
        local enemy_grenades = gamma_arena_grenade_generator.generate_enemy(catalogs, {
            presence = stream(normalized_request, fight_index, catalogs, "enemy_grenade_presence:" .. index),
            section = stream(normalized_request, fight_index, catalogs, "enemy_grenade_section:" .. index)
        })
        if not enemy_grenades.ok then return enemy_grenades end
        gear.value.grenades = enemy_grenades.value.sections
        local physical = spawn_slots[index]
        spec.opponents[index] = {
            slot = index,
            spawn_slot_id = physical.id,
            spawn = { position = physical.position, level_vertex_id = physical.level_vertex_id, game_vertex_id = physical.game_vertex_id },
            spawn_path = assigned_routes[index],
            tactical_route = assigned_routes[index],
            role = role,
            profile = profile.section,
            community = profile.community,
            profile_cost = profile.cost,
            loadout = gear.value,
            total_cost = profile.cost + gear.value.cost
        }
    end
    local enemy_medical = gamma_arena_medical_generator.allocate_enemies(catalogs, spec.opponents, enemy_medical_streams(normalized_request, fight_index, catalogs, enemy_count)); if not enemy_medical.ok then return enemy_medical end
    for index, allocation in ipairs(enemy_medical.value.allocations) do
        local opponent = spec.opponents[index]
        apply_medical(opponent.loadout, allocation)
        opponent.total_cost = opponent.profile_cost + opponent.loadout.cost
    end
    return gamma_arena_result.ok(spec)
end

function stable_encode(spec)
    if type(spec) ~= "table" or type(spec.actor) ~= "table" or type(spec.actor.loadout) ~= "table" then return "invalid" end
    local function gear(value, actor)
        local encoded = value.weapon .. "," .. value.ammo .. "," .. value.ammo_boxes .. "," .. value.outfit .. "," .. value.knife .. ",medical:" .. table.concat(value.consumables, "+") .. ",grenades:" .. table.concat(value.grenades, "+") .. "," .. value.gear_cost .. "," .. value.medical_cost .. "," .. value.cost
        if actor and type(value.bonus_ammo) == "table" then
            local bonus = value.bonus_ammo
            encoded = encoded .. ",bonus:" .. bonus.section .. ":" .. bonus.requested_category .. ":" .. bonus.resolved_category .. ":" .. bonus.boxes
        end
        return encoded
    end
    local parts = { "schema_version=" .. spec.schema_version, "generator_version=" .. spec.generator_version, "catalog_revision=" .. spec.catalog_revision, "layout_version=" .. spec.layout_version, "session_seed=" .. spec.session_seed, "fight_index=" .. spec.fight_index, "fight_id=" .. spec.fight_id, "mode_id=" .. spec.mode_id, "difficulty_id=" .. spec.difficulty_id, "layout_id=" .. spec.layout_id, "level=" .. spec.level, "actor=" .. spec.actor.spawn_path .. "," .. spec.actor.look_path .. "," .. gear(spec.actor.loadout, true), "opponents=" }
    for index, opponent in ipairs(spec.opponents) do
        local profile = opponent.profile
        if type(opponent.community) == "string" and opponent.community ~= "" then profile = profile .. "," .. opponent.community end
        local position = opponent.spawn.position
        parts[#parts + 1] = index .. ":" .. opponent.slot .. "," .. opponent.spawn_slot_id .. "," .. string.format("%.17g,%.17g,%.17g", position.x, position.y, position.z) .. "," .. opponent.spawn.level_vertex_id .. "," .. opponent.spawn.game_vertex_id .. "," .. opponent.tactical_route .. "," .. opponent.role .. "," .. profile .. "," .. opponent.profile_cost .. "," .. gear(opponent.loadout) .. "," .. opponent.total_cost
    end
    parts[#parts + 1] = "diagnostic=" .. spec.diagnostic
    return table.concat(parts, "|")
end
