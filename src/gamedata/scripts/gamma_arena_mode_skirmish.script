function id()
    return "skirmish"
end

function difficulty_envelope(difficulty_id, catalogs)
    if type(catalogs) ~= "table" or type(catalogs.difficulties) ~= "table" then
        return gamma_arena_result.err("GA_CATALOG_INVALID", "Catalog snapshot has no difficulties", {})
    end
    local envelope = catalogs.difficulties[difficulty_id]
    if type(envelope) ~= "table" then
        return gamma_arena_result.err("GA_DIFFICULTY_UNKNOWN", "Unknown skirmish difficulty", { difficulty_id = difficulty_id })
    end
    return gamma_arena_result.ok(envelope)
end

function next_fight_index(current_index, result_kind)
    return (tonumber(current_index) or 0) + 1
end

function validate_session(session)
    if type(session) ~= "table" or session.mode_id ~= "skirmish" then
        return gamma_arena_result.err("GA_SESSION_MODE_INVALID", "Skirmish requires mode_id=skirmish", {})
    end
    if type(session.session_seed) ~= "number" then
        return gamma_arena_result.err("GA_SESSION_SEED_INVALID", "Skirmish requires a numeric session seed", {})
    end
    return gamma_arena_result.ok(true)
end
