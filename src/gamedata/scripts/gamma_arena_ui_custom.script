local CATEGORY_IDS = { "weapon", "ammo", "outfit", "helmet", "knife", "medicine", "grenade" }
local CATALOG_PAGE_SIZE = 80
local FILTER_IDS = { "all", "weapon", "ammo", "armor", "medicine", "other" }
local SORT_IDS = { "price_asc", "price_desc", "name_asc", "name_desc" }
local FILTER_LABEL_KEYS = {
    all = "st_gamma_arena_custom_filter_all",
    weapon = "st_gamma_arena_custom_filter_weapon",
    ammo = "st_gamma_arena_custom_filter_ammo",
    armor = "st_gamma_arena_custom_filter_armor",
    medicine = "st_gamma_arena_custom_filter_medicine",
    other = "st_gamma_arena_custom_filter_other"
}
local SORT_LABEL_KEYS = {
    price_asc = "st_gamma_arena_custom_sort_price_asc",
    price_desc = "st_gamma_arena_custom_sort_price_desc",
    name_asc = "st_gamma_arena_custom_sort_name_asc",
    name_desc = "st_gamma_arena_custom_sort_name_desc"
}
local DEVICE_LABEL_KEYS = {
    device_torch_dummy = "st_gamma_arena_custom_device_headlamp",
    device_torch_nv_1 = "st_gamma_arena_custom_device_nv_gen1",
    device_torch_nv_2 = "st_gamma_arena_custom_device_nv_gen2",
    device_torch_nv_3 = "st_gamma_arena_custom_device_nv_gen3"
}
local INCOMPLETE_STATUS_KEYS = {
    GA_CUSTOM_FACTION_UNKNOWN = "st_gamma_arena_custom_incomplete_faction",
    GA_CUSTOM_OUTFIT_REQUIRED = "st_gamma_arena_custom_incomplete_outfit",
    GA_CUSTOM_KNIFE_REQUIRED = "st_gamma_arena_custom_incomplete_knife",
    GA_CUSTOM_WEAPON_REQUIRED = "st_gamma_arena_custom_incomplete_weapon",
    GA_CUSTOM_AMMO_INCOMPATIBLE = "st_gamma_arena_custom_incomplete_ammo",
    GA_CUSTOM_HEALING_REQUIRED = "st_gamma_arena_custom_incomplete_healing"
}
local ACTION_STATUS_KEYS = {
    GA_CUSTOM_OVERSPEND = "st_gamma_arena_custom_error_budget",
    GA_CUSTOM_OVERWEIGHT = "st_gamma_arena_custom_error_weight",
    GA_CUSTOM_AMMO_INCOMPATIBLE = "st_gamma_arena_custom_error_compatibility",
    GA_CUSTOM_AMMO_ORPHAN = "st_gamma_arena_custom_error_compatibility",
    GA_CUSTOM_HELMET_INCOMPATIBLE = "st_gamma_arena_custom_error_compatibility",
    GA_CUSTOM_SLOT_INVALID = "st_gamma_arena_custom_error_compatibility",
    GA_CUSTOM_ENTRY_LIMIT = "st_gamma_arena_custom_error_limit",
    GA_CUSTOM_PHYSICAL_LIMIT = "st_gamma_arena_custom_error_limit",
    GA_CUSTOM_GRENADE_LIMIT = "st_gamma_arena_custom_error_limit",
    GA_CUSTOM_EQUIPMENT_QUANTITY = "st_gamma_arena_custom_error_limit",
    GA_CUSTOM_ROSTER_LIMIT = "st_gamma_arena_custom_error_limit"
}
local STATUS_COLORS = {
    incomplete = { 205, 170, 135 },
    error = { 220, 110, 90 },
    ready = { 170, 210, 160 }
}

local function translated(string_id)
    if game and type(game.translate_string) == "function" then
        local called, value = pcall(game.translate_string, string_id)
        if called and value then return value end
    end
    return string_id
end

local function valid_result(value)
    return type(value) == "table" and type(value.ok) == "boolean"
end

local function protected_result(code, message, callback)
    local called, result = pcall(callback)
    if not called then return gamma_arena_result.err(code, message, { reason = tostring(result) }) end
    if not valid_result(result) then return gamma_arena_result.err(code, message) end
    return result
end

function initialize_faction(model, picker)
    if type(model) ~= "table" or type(model.snapshot) ~= "function" or type(model.set_faction) ~= "function" then
        return gamma_arena_result.err("GA_CUSTOM_MODEL_INVALID", "Custom setup model is unavailable")
    end
    local called, snapshot = pcall(model.snapshot, model)
    if not called or type(snapshot) ~= "table" then
        return gamma_arena_result.err("GA_CUSTOM_MODEL_INVALID", "Custom setup snapshot is unavailable")
    end
    if type(snapshot.faction) == "string" and snapshot.faction ~= "" then
        return gamma_arena_result.ok(snapshot.faction)
    end
    local faction_ids = snapshot.faction_ids
    if type(faction_ids) ~= "table" or #faction_ids == 0 then
        return gamma_arena_result.err("GA_CUSTOM_FACTION_UNKNOWN", "Custom setup has no available factions")
    end
    picker = picker or function(count)
        if type(gamma_arena_rng) == "table" and type(gamma_arena_rng.new) == "function"
            and type(gamma_arena_rng.random_session_seed) == "function" then
            return gamma_arena_rng.new(gamma_arena_rng.random_session_seed()):next_int(1, count)
        end
        return 1
    end
    if type(picker) ~= "function" then
        return gamma_arena_result.err("GA_CUSTOM_FACTION_UNKNOWN", "Custom faction picker is unavailable")
    end
    local picked, index = pcall(picker, #faction_ids)
    index = picked and tonumber(index) or nil
    if type(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > #faction_ids then
        return gamma_arena_result.err("GA_CUSTOM_FACTION_UNKNOWN", "Custom faction picker returned an invalid index")
    end
    return model:set_faction(faction_ids[index])
end

function status_presentation(view)
    return gamma_arena_custom_setup_presenter.status_presentation(view)
end

function apply_faction_selection(model, faction_id)
    if type(model) ~= "table" or type(model.set_faction) ~= "function" or type(faction_id) ~= "string" then
        return gamma_arena_result.err("GA_CUSTOM_FACTION_UNKNOWN", "Custom enemy faction selection is unavailable", {
            faction = faction_id
        })
    end
    return protected_result("GA_CUSTOM_FACTION_UNKNOWN", "Custom enemy faction selection failed safely",
        function() return model:set_faction(faction_id) end)
end

function handle_escape(picker, on_back)
    local method_called, is_open = pcall(function() return picker and picker.is_open end)
    is_open = method_called and type(is_open) == "function" and is_open or nil
    if is_open then
        local called, opened = pcall(is_open, picker)
        if not called then
            return gamma_arena_result.err("GA_CUSTOM_FACTION_PICKER_FAILED", "Faction picker state is unavailable")
        end
        if opened then
            local close_called, close = pcall(function() return picker and picker.close end)
            close = close_called and type(close) == "function" and close or nil
            if not close then
                return gamma_arena_result.err("GA_CUSTOM_FACTION_PICKER_FAILED", "Faction picker cannot be closed")
            end
            return protected_result("GA_CUSTOM_FACTION_PICKER_FAILED", "Faction picker close failed safely",
                function() return close(picker) end)
        end
    end
    if type(on_back) ~= "function" then
        return gamma_arena_result.err("GA_CUSTOM_NAVIGATION_UNAVAILABLE", "Custom Setup back action is unavailable")
    end
    local called, result = pcall(on_back)
    if not called then
        return gamma_arena_result.err("GA_CUSTOM_NAVIGATION_UNAVAILABLE", "Custom Setup back action failed safely", {
            reason = tostring(result)
        })
    end
    return valid_result(result) and result or gamma_arena_result.ok(true)
end

function readiness_presentation(view)
    view = type(view) == "table" and view or {}
    local checks = {}
    for index, check in ipairs(view.readiness or {}) do
        local complete = check.complete == true
        checks[index] = {
            id = check.id,
            string_id = check.string_id,
            complete = complete,
            marker = complete and "[x] " or "[ ] ",
            state = complete and "complete" or "incomplete"
        }
    end
    return {
        caption_id = view.launch_enabled == true and "st_gamma_arena_custom_ready_to_start"
            or "st_gamma_arena_custom_required_to_start",
        state = view.launch_enabled == true and "ready" or "incomplete",
        checks = checks
    }
end

local function custom_trace(code, message, context)
    pcall(gamma_arena_log.info, code, message, context or {})
end

local function format_weight(weight_mg)
    return string.format("%.2f kg", (tonumber(weight_mg) or 0) / 1000)
end

function format_price_text(value)
    return tostring(value or 0) .. " AP"
end

function arena_price_text(value, translator)
    translator = translator or translated
    return translator("st_gamma_arena_custom_arena_price") .. ": " .. format_price_text(value)
end

local function callable(value, method)
    if value == nil then return nil end
    local called, callback = pcall(function() return value[method] end)
    return called and type(callback) == "function" and callback or nil
end

function update_item_hover(catalog_container, selected_container, item_info)
    local catalog_update = callable(catalog_container, "Update")
    local selected_update = callable(selected_container, "Update")
    local item_info_update = callable(item_info, "Update")
    if not catalog_update or not selected_update or not item_info_update then return false end
    local catalog_called, catalog_result = pcall(catalog_update, catalog_container, item_info)
    local selected_called, selected_result = pcall(selected_update, selected_container, item_info)
    local catalog_hovered = catalog_called and catalog_result == true
    local selected_hovered = selected_called and selected_result == true
    local hovered = catalog_hovered or selected_hovered
    if not hovered then pcall(item_info_update, item_info) end
    return hovered
end

function dispatch_transfer(model, direction, section)
    local method = direction == "inventory_to_loadout" and callable(model, "add_one")
        or (direction == "loadout_to_inventory" and callable(model, "remove_one") or nil)
    if not method then
        return gamma_arena_result.err("GA_CUSTOM_TRANSFER_INVALID",
            "Custom loadout transfer direction is unavailable", { direction = direction })
    end
    return protected_result("GA_CUSTOM_TRANSFER_FAILED", "Custom loadout transfer failed safely",
        function() return method(model, section) end)
end

function dispatch_drop(model, source_id, section, over_inventory, over_loadout)
    local direction = nil
    if source_id == "loadout" and over_inventory == true then
        direction = "loadout_to_inventory"
    elseif source_id == "inventory" and over_loadout == true then
        direction = "inventory_to_loadout"
    end
    if direction == nil then return gamma_arena_result.ok({ changed = false }) end
    local result = dispatch_transfer(model, direction, section)
    if result.ok then
        if type(result.value) ~= "table" then result.value = {} end
        result.value.changed = true
    end
    return result
end

function dispatch_equip(model, section)
    local method = callable(model, "equip_replacing")
    if not method then
        return gamma_arena_result.err("GA_CUSTOM_SLOT_INVALID",
            "Custom loadout equip action is unavailable", { section = section })
    end
    return protected_result("GA_CUSTOM_SLOT_INVALID", "Custom loadout equip action failed safely",
        function() return method(model, section) end)
end

local function device_option_text(option)
    local label = translated(option.label_key or option.section)
    if option.section == nil then return label end
    return label .. " | " .. tostring(option.price or 0) .. " AP | " .. format_weight(option.weight_mg)
end

local function normalize_device_options(options)
    local normalized = {}
    for index, option in ipairs(options or {}) do
        local projected = {
            section = option.section,
            label_key = option.section == nil and "st_gamma_arena_custom_device_none"
                or DEVICE_LABEL_KEYS[option.section],
            price = option.price,
            weight_mg = option.weight_mg,
            selected = option.selected == true,
            affordable = option.affordable == true,
            disabled = option.disabled == true,
            disabled_reason = option.disabled_reason
        }
        projected.display_text = device_option_text(projected)
        normalized[index] = projected
    end
    return normalized
end

function resolve_device_option(options, display_text)
    if type(display_text) ~= "string" then return nil end
    for _, option in ipairs(options or {}) do
        if option.display_text == display_text then return option end
    end
    return nil
end

function apply_device_selection(model, options, display_text)
    if type(model) ~= "table" or type(model.set_device) ~= "function" then
        return gamma_arena_result.err("GA_CUSTOM_MODEL_INVALID", "Custom setup model is unavailable")
    end
    local option = resolve_device_option(options, display_text)
    if option == nil then
        return gamma_arena_result.err("GA_CUSTOM_DEVICE_UNKNOWN", "Custom actor device is unavailable")
    end
    if option.disabled then
        return gamma_arena_result.err(option.disabled_reason or "GA_CUSTOM_INVALID",
            "Selected Custom device is unavailable")
    end
    return protected_result("GA_CUSTOM_DEVICE_UNKNOWN", "Custom actor device selection failed safely",
        function() return model:set_device(option.section) end)
end

local function projection_failure(code)
    return {
        launch_enabled = false,
        validation_code = code or "GA_CUSTOM_INVALID",
        infrastructure_error_code = code or "GA_CUSTOM_INVALID",
        operation_error_code = nil,
        summary_code = code or "GA_CUSTOM_INVALID",
        category = "weapon",
        category_ids = CATEGORY_IDS,
        actor_device = nil, device_options = {},
        catalog_cells = {}, catalog_page = 1, catalog_page_count = 1, catalog_item_count = 0,
        catalog_has_previous = false, catalog_has_next = false,
        selected_cells = {}, roster = {}, count = 0, capacity = 0,
        faction_ids = {}, rank_ids = {}, budget = 0, spent = 0, remaining = 0,
        weight_mg = 0, weight_limit_mg = 0
    }
end

function apply_catalog_result(view, catalog_result)
    if type(view) ~= 'table' then view = projection_failure('GA_CUSTOM_MODEL_INVALID') end
    if valid_result(catalog_result) and catalog_result.ok then return view end
    local detail = type(catalog_result) == 'table' and catalog_result.error or nil
    local code = type(detail) == 'table' and detail.code or 'GA_START_CATALOG_UNAVAILABLE'
    view.launch_enabled = false
    view.validation_code = code
    view.infrastructure_error_code = code
    view.summary_code = code
    return view
end

local function page_number(value, maximum)
    local parsed = tonumber(value)
    if type(parsed) ~= "number" or parsed ~= math.floor(parsed) then parsed = 1 end
    return math.max(1, math.min(parsed, maximum))
end

function project(model, category, page)
    if type(model) ~= "table" or type(model.snapshot) ~= "function" then
        return projection_failure("GA_CUSTOM_MODEL_INVALID")
    end
    local called, snapshot = pcall(model.snapshot, model)
    if not called or type(snapshot) ~= "table" then return projection_failure("GA_CUSTOM_MODEL_INVALID") end
    category = type(category) == "string" and snapshot.categories[category] and category or "weapon"
    local source = snapshot.categories[category] or {}
    local page_count = math.max(1, math.ceil(#source / CATALOG_PAGE_SIZE))
    local current_page = page_number(page, page_count)
    local first_index = (current_page - 1) * CATALOG_PAGE_SIZE + 1
    local last_index = math.min(#source, first_index + CATALOG_PAGE_SIZE - 1)
    local catalog_cells = {}
    for index = first_index, last_index do
        local cell = source[index]
        local multiplier = cell.preview_multiplier or 1
        catalog_cells[#catalog_cells + 1] = {
            section = cell.section,
            category = cell.category,
            name_key = cell.name_key,
            base_price = cell.base_price,
            weight_mg = cell.weight_mg,
            selected = cell.selected == true,
            selected_quantity = cell.selected_quantity or 0,
            disabled = cell.disabled == true,
            preview_multiplier = multiplier,
            effective_price = cell.preview_effective_price,
            price_text = multiplier == 2 and ("x2 " .. tostring(cell.preview_effective_price))
                or tostring(cell.preview_effective_price)
        }
    end
    local selected_cells = {}
    for index, cell in ipairs(snapshot.actor_items or {}) do
        selected_cells[index] = {
            section = cell.section,
            category = cell.category,
            name_key = cell.name_key,
            quantity = cell.quantity,
            equipped_slot = cell.equipped_slot,
            base_price = cell.base_price,
            weight_mg = cell.weight_mg,
            multiplier = cell.multiplier,
            effective_price = cell.effective_price,
            price_text = cell.multiplier == 2 and ("x2 " .. tostring(cell.effective_price))
                or tostring(cell.effective_price)
        }
    end
    local device_options = normalize_device_options(snapshot.device_options)
    local validation_code = snapshot.validation and snapshot.validation.error and snapshot.validation.error.code or nil
    local operation_error_code = snapshot.last_operation and snapshot.last_operation.error
        and snapshot.last_operation.error.code or nil
    return {
        launch_enabled = snapshot.can_start == true,
        validation_code = validation_code,
        operation_error_code = operation_error_code,
        summary_code = operation_error_code or validation_code,
        category = category,
        category_ids = snapshot.category_ids,
        actor_device = snapshot.actor_device,
        device_options = device_options,
        catalog_cells = catalog_cells,
        catalog_page = current_page,
        catalog_page_count = page_count,
        catalog_item_count = #source,
        catalog_has_previous = current_page > 1,
        catalog_has_next = current_page < page_count,
        selected_cells = selected_cells,
        roster = snapshot.roster,
        count = snapshot.count,
        capacity = snapshot.capacity,
        faction = snapshot.faction,
        faction_ids = snapshot.faction_ids,
        rank_ids = snapshot.rank_ids,
        budget = snapshot.budget,
        spent = snapshot.spent,
        remaining = snapshot.remaining,
        weight_mg = snapshot.weight_mg,
        weight_limit_mg = snapshot.weight_limit_mg,
        last_operation = snapshot.last_operation
    }
end

function submit(model, seed_text, ports)
    ports = ports or {}
    if type(model) ~= "table" or type(model.snapshot) ~= "function" then
        return gamma_arena_result.err("GA_CUSTOM_MODEL_INVALID", "Custom setup model is unavailable")
    end
    local called, snapshot = pcall(model.snapshot, model)
    if not called or type(snapshot) ~= "table" or type(snapshot.config) ~= "table" then
        return gamma_arena_result.err("GA_CUSTOM_MODEL_INVALID", "Custom setup snapshot is unavailable")
    end
    local validated = gamma_arena_custom_config.validate(snapshot.config, { catalog = model.catalog, layout = model.layout })
    if not validated.ok then return validated end

    seed_text = seed_text == nil and "" or tostring(seed_text)
    local seed_mode, seed_result
    if seed_text == "" then
        seed_mode = "random"
        if type(ports.random_session_seed) == "function" then
            seed_result = protected_result("GA_START_SEED_INVALID", "Custom random seed generation failed", ports.random_session_seed)
        else
            seed_result = gamma_arena_session_store.random_session_seed(ports.random_seed_provider)
        end
    else
        seed_mode = "manual"
        local parser = ports.parse_manual_seed or gamma_arena_session_store.parse_manual_seed
        seed_result = protected_result("GA_START_SEED_INVALID", "Custom seed validation failed", function() return parser(seed_text) end)
    end
    if not seed_result.ok then return seed_result end

    local request = {
        schema_version = 2,
        mode_id = "skirmish",
        generation_recipe = "custom",
        seed_mode = seed_mode,
        session_seed = seed_result.value,
        custom_config = validated.value
    }
    if type(ports.emit_start) ~= "function" then return gamma_arena_result.ok({ request = request }) end
    local emitted = protected_result("GA_CUSTOM_START_FAILED", "Custom Arena start request failed safely", function()
        return ports.emit_start(request)
    end)
    if not emitted.ok then return emitted end
    return gamma_arena_result.ok({ request = request, emission = emitted.value })
end

local function load_catalog(ports)
    if type(ports.catalog) == "table" then return gamma_arena_result.ok(ports.catalog) end
    local loader = ports.catalogs or gamma_arena_catalog.load
    if type(loader) ~= "function" then
        return gamma_arena_result.err("GA_START_CATALOG_UNAVAILABLE", "Active Arena catalog loader is unavailable")
    end
    return protected_result("GA_START_CATALOG_UNAVAILABLE", "Active Arena catalog loading failed safely", loader)
end

local function faction_text(id)
    return translated("st_gamma_arena_custom_faction_" .. tostring(id))
end

local function rank_text(id)
    return translated("st_gamma_arena_custom_rank_" .. tostring(id))
end

local function category_text(id)
    return translated("st_gamma_arena_custom_category_" .. tostring(id))
end

local function filter_text(id)
    return translated(FILTER_LABEL_KEYS[id] or tostring(id))
end

local function sort_text(id)
    return translated(SORT_LABEL_KEYS[id] or tostring(id))
end

local function set_combo(combo, ids, selected, formatter, placeholder)
    if selected == nil then combo:SetText(placeholder or "") return end
    for index, id in ipairs(ids or {}) do
        if id == selected then
            combo:enable_id(index)
            combo:SetText(formatter(id))
            return
        end
    end
end

local function combo_value(combo, ids, formatter)
    local text = combo:GetText()
    for _, id in ipairs(ids or {}) do if text == formatter(id) then return id end end
    return nil
end

class "UICustom" (CUIScriptWnd)

function UICustom:__init(owner, ports) super()
    self.owner = owner
    self.ports = ports or {}
    self.selected_category = "weapon"
    self.catalog_page = 1
    self.catalog_state = { filter = "all", search = "", sort = "price_asc", page = 1 }
    self.presenter = gamma_arena_custom_setup_presenter.new({
        translate = translated,
        page_size = CATALOG_PAGE_SIZE
    })
    custom_trace("GA_DEBUG_CUSTOM_CATALOG_BEGIN", "Custom Arena catalog loading began")
    self.catalog_result = load_catalog(self.ports)
    custom_trace("GA_DEBUG_CUSTOM_CATALOG_RESULT", "Custom Arena catalog loading returned", {
        ok = self.catalog_result.ok == true,
        code = type(self.catalog_result.error) == "table" and self.catalog_result.error.code or nil,
        item_count = self.catalog_result.ok and type(self.catalog_result.value.item_ids) == "table"
            and #self.catalog_result.value.item_ids or 0
    })
    if not self.catalog_result.ok and type(self.catalog_result.error) == 'table' then
        pcall(gamma_arena_log.error, self.catalog_result.error.code or 'GA_START_CATALOG_UNAVAILABLE',
            self.catalog_result.error.message or 'Active Arena catalog loading failed', self.catalog_result.error.context or {})
    end
    local catalog = self.catalog_result.ok and self.catalog_result.value or {}
    local layout = self.ports.layout or (type(catalog.layouts) == "table" and catalog.layouts.rostok_arena_v1 or nil) or {}
    self.model = self.ports.model or gamma_arena_custom_setup_model.new(catalog, layout)
    self.initial_faction_result = initialize_faction(self.model, self.ports.initial_faction_index)
    self:InitControls()
    self:InitCallbacks()
    self:Rebuild()
end

function UICustom:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self.xml = CScriptXmlInit()
    self.xml:ParseFile("gamma_arena_custom.xml")
    self.root = self.xml:InitStatic("gamma_arena_custom", self)
    self.title = self.xml:InitStatic("gamma_arena_custom:title", self.root)
    self.enemy_setup = self.xml:InitStatic("gamma_arena_custom:enemy_setup", self.root)
    self.opponents_panel = self.xml:InitStatic("gamma_arena_custom:enemy_setup:opponents_panel", self.enemy_setup)
    self.conditions_panel = self.xml:InitStatic("gamma_arena_custom:enemy_setup:conditions_panel", self.enemy_setup)
    self.opponents_caption = self.xml:InitStatic("gamma_arena_custom:enemy_setup:opponents_caption", self.enemy_setup)
    self.conditions_caption = self.xml:InitStatic("gamma_arena_custom:enemy_setup:conditions_caption", self.enemy_setup)
    self.faction_label = self.xml:InitStatic("gamma_arena_custom:enemy_setup:faction_label", self.enemy_setup)
    self.count_label = self.xml:InitStatic("gamma_arena_custom:enemy_setup:count_label", self.enemy_setup)
    self.seed_label = self.xml:InitStatic("gamma_arena_custom:enemy_setup:seed_label", self.enemy_setup)
    self.device_label = self.xml:InitStatic("gamma_arena_custom:enemy_setup:device_label", self.enemy_setup)
    self.seed_helper = self.xml:InitStatic("gamma_arena_custom:enemy_setup:seed_helper", self.enemy_setup)
    self.device_helper = self.xml:InitStatic("gamma_arena_custom:enemy_setup:device_helper", self.enemy_setup)
    self.roster_panel = self.xml:InitStatic("gamma_arena_custom:roster", self.root)
    self.roster_caption = self.xml:InitStatic("gamma_arena_custom:roster:roster_caption", self.roster_panel)
    self.catalog_controls = self.xml:InitStatic("gamma_arena_custom:catalog_controls", self.root)
    self.catalog_search_label = self.xml:InitStatic("gamma_arena_custom:catalog_controls:catalog_search_label", self.catalog_controls)
    self.inventory_panel = self.xml:InitStatic("gamma_arena_custom:inventory_panel", self.root)
    self.loadout_panel = self.xml:InitStatic("gamma_arena_custom:loadout_panel", self.root)
    self.inventory_caption = self.xml:InitStatic("gamma_arena_custom:inventory_caption", self.root)
    self.loadout_caption = self.xml:InitStatic("gamma_arena_custom:loadout_caption", self.root)
    self.footer_panel = self.xml:InitStatic("gamma_arena_custom:footer", self.root)
    self.faction_button = self.xml:Init3tButton("gamma_arena_custom:enemy_setup:faction_button", self.enemy_setup)
    self.faction_icon = self.xml:InitStatic("gamma_arena_custom:enemy_setup:faction_icon", self.enemy_setup)
    self.count_combo = self.xml:InitComboBox("gamma_arena_custom:enemy_setup:count", self.enemy_setup)
    self.device_combo = self.xml:InitComboBox("gamma_arena_custom:enemy_setup:device", self.enemy_setup)
    self.seed_edit = self.xml:InitEditBox("gamma_arena_custom:enemy_setup:seed", self.enemy_setup)
    self.catalog_search = self.xml:InitEditBox("gamma_arena_custom:catalog_controls:catalog_search", self.catalog_controls)
    self.catalog_filter = self.xml:InitComboBox("gamma_arena_custom:catalog_controls:catalog_filter", self.catalog_controls)
    self.catalog_sort = self.xml:InitComboBox("gamma_arena_custom:catalog_controls:catalog_sort", self.catalog_controls)
    self.catalog_previous = self.xml:Init3tButton("gamma_arena_custom:catalog_controls:catalog_previous", self.catalog_controls)
    self.catalog_page_text = self.xml:InitTextWnd("gamma_arena_custom:catalog_controls:catalog_page", self.catalog_controls)
    self.catalog_next = self.xml:Init3tButton("gamma_arena_custom:catalog_controls:catalog_next", self.catalog_controls)
    self.points_available = self.xml:InitTextWnd("gamma_arena_custom:points_available", self.root)
    self.points_used = self.xml:InitTextWnd("gamma_arena_custom:points_used", self.root)
    self.weight_text = self.xml:InitTextWnd("gamma_arena_custom:footer:weight", self.footer_panel)
    self.weight_limit_text = self.xml:InitTextWnd("gamma_arena_custom:footer:weight_limit", self.footer_panel)
    self.readiness_caption = self.xml:InitTextWnd("gamma_arena_custom:footer:readiness_caption", self.footer_panel)
    self.readiness_windows = {
        outfit = self.xml:InitTextWnd("gamma_arena_custom:footer:readiness_outfit", self.footer_panel),
        knife = self.xml:InitTextWnd("gamma_arena_custom:footer:readiness_knife", self.footer_panel),
        weapon = self.xml:InitTextWnd("gamma_arena_custom:footer:readiness_weapon", self.footer_panel),
        ammo = self.xml:InitTextWnd("gamma_arena_custom:footer:readiness_ammo", self.footer_panel),
        healing = self.xml:InitTextWnd("gamma_arena_custom:footer:readiness_healing", self.footer_panel)
    }
    self.validation_text = self.xml:InitTextWnd("gamma_arena_custom:validation", self.root)
    self.start_button = self.xml:Init3tButton("gamma_arena_custom:start", self.root)
    self.random_button = self.xml:Init3tButton("gamma_arena_custom:random", self.root)
    self.back_button = self.xml:Init3tButton("gamma_arena_custom:back", self.root)
    self:Register(self.faction_button, "faction")
    self:Register(self.count_combo, "count")
    self:Register(self.device_combo, "device")
    self:Register(self.seed_edit, "seed")
    self:Register(self.catalog_search, "catalog_search")
    self:Register(self.catalog_filter, "catalog_filter")
    self:Register(self.catalog_sort, "catalog_sort")
    self:Register(self.start_button, "start")
    self:Register(self.random_button, "random")
    self:Register(self.back_button, "back")
    self:Register(self.catalog_previous, "catalog_previous")
    self:Register(self.catalog_next, "catalog_next")

    local snapshot = self.model:snapshot()
    local initial_view = project(self.model, self.selected_category)
    for index, option in ipairs(initial_view.device_options or {}) do
        self.device_combo:AddItem(option.display_text, index)
    end
    for count = 1, snapshot.capacity do self.count_combo:AddItem(tostring(count), count) end
    for index, filter_id in ipairs(FILTER_IDS) do self.catalog_filter:AddItem(filter_text(filter_id), index) end
    for index, sort_id in ipairs(SORT_IDS) do self.catalog_sort:AddItem(sort_text(sort_id), index) end
    self.catalog_search:SetText("")
    self.catalog_filter:SetText(filter_text(self.catalog_state.filter))
    self.catalog_sort:SetText(sort_text(self.catalog_state.sort))
    self.roster_rows, self.rank_combos = {}, {}
    for index = 1, 10 do
        local row_path = "gamma_arena_custom:roster:roster_row_" .. tostring(index)
        self.roster_rows[index] = self.xml:InitStatic(row_path, self.roster_panel)
        self.rank_combos[index] = self.xml:InitComboBox(row_path .. ":rank_" .. tostring(index), self.roster_rows[index])
        self:Register(self.rank_combos[index], "rank_" .. tostring(index))
        for rank_index, rank_id in ipairs(snapshot.rank_ids or {}) do
            self.rank_combos[index]:AddItem(rank_text(rank_id), rank_index)
        end
    end

    self.inventory_container = utils_ui.UICellContainer("inventory", self, nil,
        "gamma_arena_custom:inventory_container", self.root)
    self.loadout_container = utils_ui.UICellContainer("loadout", self, nil,
        "gamma_arena_custom:loadout_container", self.root)
    for _, container in pairs({ self.inventory_container, self.loadout_container }) do
        container.showcase = true
        container.disable_drag = false
        container.disable_stack = true
        container.disable_info = false
        container:SetGridSpecs(41, 2)
    end
    self.item_info = utils_ui.UIInfoItem(self)
    self.faction_picker = gamma_arena_ui_faction_picker.new({
        owner = self,
        xml = self.xml,
        root = self.root,
        translate = translated,
        on_select = function(faction_id) return self:ApplyFaction(faction_id) end
    })
end

function UICustom:InitCallbacks()
    self:AddCallback("faction", ui_events.BUTTON_CLICKED, self.OpenFactionPicker, self)
    self:AddCallback("count", ui_events.LIST_ITEM_SELECT, self.OnCount, self)
    self:AddCallback("device", ui_events.LIST_ITEM_SELECT, self.OnDevice, self)
    self:AddCallback("catalog_search", ui_events.EDIT_TEXT_COMMIT, self.OnCatalogSearch, self)
    self:AddCallback("catalog_filter", ui_events.LIST_ITEM_SELECT, self.OnCatalogFilter, self)
    self:AddCallback("catalog_sort", ui_events.LIST_ITEM_SELECT, self.OnCatalogSort, self)
    self:AddCallback("start", ui_events.BUTTON_CLICKED, self.OnStart, self)
    self:AddCallback("random", ui_events.BUTTON_CLICKED, self.OnRandom, self)
    self:AddCallback("back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    self:AddCallback("catalog_previous", ui_events.BUTTON_CLICKED, self.OnCatalogPrevious, self)
    self:AddCallback("catalog_next", ui_events.BUTTON_CLICKED, self.OnCatalogNext, self)
    self.rank_callbacks = {}
    for index = 1, 10 do
        self.rank_callbacks[index] = function() self:OnRank(index) end
        self:AddCallback("rank_" .. tostring(index), ui_events.LIST_ITEM_SELECT, self.rank_callbacks[index], self)
    end
end

local function rebuild_container(container, cells, selected)
    local sections, by_section = {}, {}
    for index, view in ipairs(cells or {}) do
        sections[index] = view.section
        by_section[view.section] = view
    end
    container:Reset()
    container.ignore_scroll = true
    for _, section in ipairs(sections) do container:AddItem(nil, section) end
    container.ignore_scroll = false
    container:Scroll_Reinit()
    for _, cell in pairs(container.cell or {}) do
        if cell:IsShown() then
            local view = by_section[cell.section]
            if view then
                local price_text = view.price_text or view.effective_price or view.base_price or 0
                cell.flags.disabled = view.disabled == true
                cell.flags.selected = view.selected == true
                cell.flags.value = view.effective_price or view.base_price or 0
                cell.flags.value_str = arena_price_text(price_text)
                cell.flags.name_key = view.name_key
                cell.flags.weight_mg = view.weight_mg
                local equipped = view.equipped_slot == "weapon_1" and " W1"
                    or (view.equipped_slot == "weapon_2" and " W2"
                    or (view.equipped_slot and " E" or ""))
                local suffix = selected and (" x" .. tostring(view.quantity or 1) .. equipped) or ""
                cell:Add_CustomText(format_price_text(price_text) .. suffix)
                local colorize = callable(cell, "Colorize")
                if colorize then pcall(colorize, cell, view.disabled and "hide" or "def") end
                if cell.cell and type(cell.cell.Enable) == "function" then cell.cell:Enable(true) end
            end
        end
    end
end

function rebuild_panels(inventory_container, loadout_container, view)
    view = view or {}
    rebuild_container(inventory_container, view.catalog_cells, false)
    rebuild_container(loadout_container, view.selected_cells, true)
end

local function refresh_catalog_cells(model, cells)
    for _, cell in ipairs(cells or {}) do
        local called, preview = pcall(model.preview_add_one, model, cell.section)
        local detail = called and type(preview) == "table" and type(preview.error) == "table" and preview.error or nil
        cell.disabled = not called or type(preview) ~= "table" or preview.ok ~= true
        cell.disabled_reason = cell.disabled and (detail and detail.code or "GA_CUSTOM_ACTION_FAILED") or nil
        cell.disabled_context = cell.disabled and detail and detail.context or nil
    end
end

local function refresh_inventory_cells(container, cells)
    local by_section = {}
    for _, view in ipairs(cells or {}) do by_section[view.section] = view end
    for _, cell in pairs(container.cell or {}) do
        if cell:IsShown() then
            local view = by_section[cell.section]
            if view then
                cell.flags.disabled = view.disabled == true
                local colorize = callable(cell, "Colorize")
                if colorize then pcall(colorize, cell, view.disabled and "hide" or "def") end
            end
        end
    end
end

local function prepare_view(self, view)
    view = apply_catalog_result(view, self.catalog_result)
    view.device_options = normalize_device_options(view.device_options)
    if self.catalog_result.ok and not self.initial_faction_result.ok then
        view.infrastructure_error_code = self.initial_faction_result.error
            and self.initial_faction_result.error.code or "GA_CUSTOM_FACTION_UNKNOWN"
    end
    if self.submission_error and self.submission_error.error then
        view.submission_error = self.submission_error.error
        view.submission_error_code = self.submission_error.error.code
        view.summary_code = view.submission_error_code
    else
        view.submission_error = nil
        view.submission_error_code = nil
    end
    return view
end

local function render_status_controls(self, view)
    if view.faction then
        self.faction_button:TextControl():SetText(faction_text(view.faction))
    else
        self.faction_button:TextControl():SetText(translated("st_gamma_arena_custom_choose_faction"))
    end
    local faction_texture = gamma_arena_ui_faction_picker.texture_id(view.faction)
    if faction_texture then pcall(self.faction_icon.InitTexture, self.faction_icon, faction_texture) end
    self.faction_icon:Show(faction_texture ~= nil)
    set_combo(self.count_combo, {}, nil, tostring, tostring(view.count))
    self.count_combo:SetText(tostring(view.count))
    local device_text = view.device_options[1] and view.device_options[1].display_text
        or translated("st_gamma_arena_custom_device_none")
    for _, option in ipairs(view.device_options or {}) do
        if option.selected then device_text = option.display_text; break end
    end
    self.device_combo:SetText(device_text)
    for index = 1, 10 do
        local visible = index <= view.count
        self.roster_rows[index]:Show(visible)
        if visible then set_combo(self.rank_combos[index], view.rank_ids, view.roster[index].rank, rank_text) end
    end
    self.catalog_search:SetText(self.catalog_state.search)
    set_combo(self.catalog_filter, FILTER_IDS, self.catalog_state.filter, filter_text)
    set_combo(self.catalog_sort, SORT_IDS, self.catalog_state.sort, sort_text)
    self.points_available:SetText(translated("st_gamma_arena_custom_points_available") .. ": "
        .. tostring(view.remaining) .. " AP")
    self.points_used:SetText(translated("st_gamma_arena_custom_points_used") .. ": "
        .. tostring(view.spent) .. " AP")
    self.weight_text:SetText(translated("st_gamma_arena_custom_weight") .. ": " .. format_weight(view.weight_mg))
    self.weight_limit_text:SetText(translated("st_gamma_arena_custom_weight_limit") .. ": "
        .. format_weight(view.weight_limit_mg))
    local readiness = readiness_presentation(view)
    self.readiness_caption:SetText(translated(readiness.caption_id))
    self.readiness_caption:SetTextColor(readiness.state == "ready"
        and GetARGB(255, 170, 210, 160) or GetARGB(255, 220, 210, 185))
    for _, check in ipairs(readiness.checks) do
        local window = self.readiness_windows[check.id]
        if window then
            window:SetText(check.marker .. translated(check.string_id))
            window:SetTextColor(check.complete and GetARGB(255, 170, 210, 160)
                or GetARGB(255, 205, 170, 135))
        end
    end
    local status = status_presentation(view)
    local color = STATUS_COLORS[status.state] or STATUS_COLORS.error
    self.validation_text:SetText(status.state == "ready" and ""
        or gamma_arena_custom_setup_presenter.format_status(status, translated))
    self.validation_text:SetTextColor(GetARGB(255, color[1], color[2], color[3]))
    self.validation_text:Show(status.state ~= "ready")
    if status.state == "error" and status.code then
        if self.last_reported_status_code ~= status.code then
            pcall(gamma_arena_log.error, status.code, "Custom Setup interaction failed", {
                source = status.source
            })
            self.last_reported_status_code = status.code
        end
    else
        self.last_reported_status_code = nil
    end
    self.start_button:Enable(view.launch_enabled)
    self.catalog_page_text:SetText(tostring(view.catalog_page) .. " / " .. tostring(view.catalog_page_count))
    self.catalog_previous:Enable(view.catalog_has_previous)
    self.catalog_next:Enable(view.catalog_has_next)
end

function UICustom:Rebuild()
    custom_trace("GA_DEBUG_CUSTOM_REBUILD_BEGIN", "Custom Arena UI rebuild began", {
        filter = self.catalog_state.filter,
        search = self.catalog_state.search,
        sort = self.catalog_state.sort,
        page = self.catalog_state.page
    })
    local view = prepare_view(self, self.presenter:project(self.model, self.catalog_state))
    self.projection = view
    self.catalog_state.filter = view.filter or self.catalog_state.filter
    self.catalog_state.search = view.search or self.catalog_state.search
    self.catalog_state.sort = view.sort or self.catalog_state.sort
    self.catalog_state.page = view.catalog_page or 1
    render_status_controls(self, view)
    rebuild_panels(self.inventory_container, self.loadout_container, view)
    custom_trace("GA_DEBUG_CUSTOM_REBUILD_RESULT", "Custom Arena UI rebuild completed", {
        filter = self.catalog_state.filter,
        page = self.catalog_state.page,
        catalog_cells = #view.catalog_cells,
        selected_cells = #view.selected_cells
    })
end

function UICustom:RefreshStatus()
    local view = prepare_view(self, self.presenter:refresh_status(self.model, self.projection))
    refresh_catalog_cells(self.model, view.catalog_cells)
    self.projection = view
    render_status_controls(self, view)
    refresh_inventory_cells(self.inventory_container, view.catalog_cells)
end

function UICustom:OpenFactionPicker()
    self.submission_error = nil
    local view = self.projection or project(self.model, self.selected_category)
    local opened = self.faction_picker:open(view.faction_ids, view.faction)
    if not opened.ok then
        self.submission_error = opened
        self:Rebuild()
    end
    return opened
end

function UICustom:ApplyFaction(faction_id)
    self.submission_error = nil
    local applied = apply_faction_selection(self.model, faction_id)
    if not applied.ok then self.submission_error = applied end
    self:Rebuild()
    return applied
end

function UICustom:OnCount()
    self.submission_error = nil
    local count = tonumber(self.count_combo:GetText())
    self.model:set_count(count)
    self:RefreshStatus()
end

function UICustom:OnDevice()
    self.submission_error = nil
    local view = self.projection or project(self.model, self.selected_category)
    local applied = apply_device_selection(self.model, view.device_options, self.device_combo:GetText())
    if not applied.ok then self.submission_error = applied end
    self:Rebuild()
end

function UICustom:OnRank(index)
    self.submission_error = nil
    local view = self.projection or {}
    local rank = combo_value(self.rank_combos[index], view.rank_ids, rank_text)
    if rank then self.model:set_rank(index, rank) end
    self:RefreshStatus()
end

function UICustom:OnCategory(category)
    self.submission_error = nil
    self.selected_category = category
    self.catalog_page = 1
    self:Rebuild()
end

function UICustom:OnCatalogSearch()
    self.submission_error = nil
    self.catalog_state.search = tostring(self.catalog_search:GetText() or "")
    self.catalog_state.page = 1
    self:Rebuild()
end

function UICustom:OnCatalogFilter()
    self.submission_error = nil
    local selected = combo_value(self.catalog_filter, FILTER_IDS, filter_text)
    if selected then self.catalog_state.filter = selected end
    self.catalog_state.page = 1
    self:Rebuild()
end

function UICustom:OnCatalogSort()
    self.submission_error = nil
    local selected = combo_value(self.catalog_sort, SORT_IDS, sort_text)
    if selected then self.catalog_state.sort = selected end
    self.catalog_state.page = 1
    self:Rebuild()
end

function UICustom:OnCatalogPrevious()
    self.catalog_state.page = math.max(1, self.catalog_state.page - 1)
    self:Rebuild()
end

function UICustom:OnCatalogNext()
    self.catalog_state.page = self.catalog_state.page + 1
    self:Rebuild()
end

function UICustom:CellSection(container_id, index)
    local container = container_id == "inventory" and self.inventory_container
        or (container_id == "loadout" and self.loadout_container or nil)
    local cell = container and container.cell and container.cell[index] or nil
    return cell and cell.section or nil
end

function UICustom:ApplyAction(result)
    if valid_result(result) and result.ok then
        self.submission_error = nil
    elseif valid_result(result) then
        self.submission_error = result
    else
        self.submission_error = gamma_arena_result.err("GA_CUSTOM_ACTION_FAILED",
            "Custom loadout action returned an invalid result")
    end
    self:Rebuild()
    return result
end

function UICustom:On_CC_Mouse1(container_id, index)
    local section = self:CellSection(container_id, index)
    if not section then return end
    local direction = container_id == "loadout" and "loadout_to_inventory"
        or (container_id == "inventory" and "inventory_to_loadout" or nil)
    if not direction then return end
    return self:ApplyAction(dispatch_transfer(self.model, direction, section))
end

function UICustom:On_CC_Mouse2(container_id, index)
    if container_id ~= "loadout" then return end
    local section = self:CellSection(container_id, index)
    local definition = section and self.model.catalog and self.model.catalog.items
        and self.model.catalog.items[section] or nil
    if not definition or definition.category ~= "weapon" then return end
    return self:ApplyAction(dispatch_equip(self.model, section))
end

function UICustom:On_CC_DragDrop(source_id, index)
    local section = self:CellSection(source_id, index)
    if not section then return end
    local result = dispatch_drop(self.model, source_id, section,
        self.inventory_container:IsCursorOverWindow(),
        self.loadout_container:IsCursorOverWindow())
    if result.ok and result.value and result.value.changed == false then return result end
    return self:ApplyAction(result)
end

function UICustom:HideSelf()
    self:HideDialog()
    self:Show(false)
end

function UICustom:OnRandom()
    if self.owner then
        if type(self.owner.ShowDialog) == "function" then self.owner:ShowDialog(true) end
        if type(self.owner.Show) == "function" then self.owner:Show(true) end
    end
    self:HideSelf()
end

function UICustom:OnBack()
    if self.owner and type(self.owner.RestoreOwner) == "function" then self.owner:RestoreOwner()
    elseif self.owner then
        if type(self.owner.ShowDialog) == "function" then self.owner:ShowDialog(true) end
        if type(self.owner.Show) == "function" then self.owner:Show(true) end
    end
    self:HideSelf()
end

function UICustom:OnStart()
    local main_owner = self.owner and self.owner.owner or self.owner
    local started = submit(self.model, self.seed_edit:GetText(), {
        random_session_seed = self.ports.random_session_seed,
        random_seed_provider = self.ports.random_seed_provider,
        parse_manual_seed = self.ports.parse_manual_seed,
        emit_start = function(request)
            if not axr_main or not axr_main.config then
                return gamma_arena_result.err("GA_SETTINGS_CONFIG_UNAVAILABLE", "axr_main.config is unavailable")
            end
            local begin_start = self.ports.begin_start or gamma_arena_ui_start.begin_start
            return begin_start(main_owner, axr_main.config, request, self.ports)
        end
    })
    if started.ok then return started end
    self.submission_error = started
    self:Rebuild()
    local code = started.error and started.error.code or ""
    if string.sub(code, 1, 10) == "GA_CUSTOM_" or code == "GA_SESSION_SEED_INVALID" then return started end
    if self.owner and type(self.owner.ShowFatal) == "function" then
        self:OnRandom()
        self.owner:ShowFatal({ started })
    end
    return started
end

function UICustom:Update()
    CUIScriptWnd.Update(self)
    if not self.faction_picker:is_open() then
        update_item_hover(self.inventory_container, self.loadout_container, self.item_info)
    end
end

function UICustom:OnKeyboard(dik, keyboard_action)
    if self.faction_picker:is_open() then
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
            local escaped = handle_escape(self.faction_picker, function() return self:OnBack() end)
            if not escaped.ok then self.submission_error = escaped; self:Rebuild() end
            return true
        end
        return true
    end
    local result = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if result == false then
        self.inventory_container:OnKeyboard(dik, keyboard_action)
        self.loadout_container:OnKeyboard(dik, keyboard_action)
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
            local escaped = handle_escape(self.faction_picker, function() return self:OnBack() end)
            if not escaped.ok then self.submission_error = escaped; self:Rebuild() end
            return true
        end
    end
    return result
end

function create(owner, ports)
    return UICustom(owner, ports)
end
