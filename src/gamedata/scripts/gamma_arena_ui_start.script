local difficulty_ids = { "rookie", "stalker", "veteran", "master" }
local difficulty_string_ids = {
    rookie = "st_gamma_arena_difficulty_rookie",
    stalker = "st_gamma_arena_difficulty_stalker",
    veteran = "st_gamma_arena_difficulty_veteran",
    master = "st_gamma_arena_difficulty_master"
}
local fatal_dialog = nil

local function debug_trace(code, message, context)
    pcall(gamma_arena_log.info, code, message, context or {})
end

local function debug_result_context(result)
    return {
        ok = type(result) == "table" and result.ok == true,
        result_type = type(result),
        code = type(result) == "table" and type(result.error) == "table" and result.error.code or nil
    }
end

local function translated(string_id)
    if game and type(game.translate_string) == "function" then
        local ok, value = pcall(game.translate_string, string_id)
        if ok and value then
            return value
        end
    end
    return string_id
end

local function result_line(result)
    local code
    if type(result) == "table" and result.error then
        code = result.error.code
    elseif type(result) == "table" then
        code = result.code
    end
    code = tostring(code or "GA_UNKNOWN")
    local ok, line = pcall(string.format, translated("st_gamma_arena_fatal_error_line"), code)
    return ok and line or ("Gamma Arena [" .. code .. "]")
end

class "UIStart" (CUIScriptWnd)

function initialize_settings(dialog, ports)
    ports = ports or {}
    if ports.fatal_only == true then return false end
    dialog:LoadSettings()
    return true
end

function UIStart:__init(owner, ports) super()
    self.owner = owner
    self.ports = ports or {}
    self.seed_mode = "random"
    self.last_random_seed_text = nil
    self.fatal_main_menu_callback = nil
    self.fatal_main_menu_context = nil
    self:InitControls()
    self:InitCallbacks()
    initialize_settings(self, self.ports)
end

function UIStart:__finalize()
    if fatal_dialog == self then
        fatal_dialog = nil
    end
end

function UIStart:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("gamma_arena_start.xml")
    self.root = xml:InitStatic("gamma_arena_start", self)
    self.title = xml:InitStatic("gamma_arena_start:title", self.root)
    self.start_form = xml:InitStatic("gamma_arena_start:start_form", self.root)
    self.difficulty_label = xml:InitStatic("gamma_arena_start:start_form:difficulty_label", self.start_form)
    self.difficulty_combo = xml:InitComboBox("gamma_arena_start:start_form:difficulty", self.start_form)
    self.seed_label = xml:InitStatic("gamma_arena_start:start_form:seed_label", self.start_form)
    self.seed_edit = xml:InitEditBox("gamma_arena_start:start_form:seed", self.start_form)
    self.random_seed = xml:Init3tButton("gamma_arena_start:start_form:random_seed", self.start_form)
    self.validation = xml:InitTextWnd("gamma_arena_start:start_form:validation", self.start_form)
    self.start_button = xml:Init3tButton("gamma_arena_start:start_form:start", self.start_form)
    self.back_button = xml:Init3tButton("gamma_arena_start:start_form:back", self.start_form)
    self.fatal = xml:InitStatic("gamma_arena_start:fatal", self.root)
    self.fatal_title = xml:InitStatic("gamma_arena_start:fatal:fatal_title", self.fatal)
    self.fatal_text = xml:InitTextWnd("gamma_arena_start:fatal:fatal_text", self.fatal)
    self.fatal_main_menu = xml:Init3tButton("gamma_arena_start:fatal:fatal_main_menu", self.fatal)

    self:Register(self.difficulty_combo, "difficulty")
    self:Register(self.seed_edit, "seed")
    self:Register(self.random_seed, "random_seed")
    self:Register(self.start_button, "start")
    self:Register(self.back_button, "back")
    self:Register(self.fatal_main_menu, "fatal_main_menu")

    self.validation:Show(false)
    self.fatal:Show(false)
    for index, difficulty_id in ipairs(difficulty_ids) do
        self.difficulty_combo:AddItem(translated(difficulty_string_ids[difficulty_id]), index)
    end
end

function UIStart:InitCallbacks()
    self:AddCallback("random_seed", ui_events.BUTTON_CLICKED, self.OnRandomSeed, self)
    self:AddCallback("start", ui_events.BUTTON_CLICKED, self.OnStart, self)
    self:AddCallback("back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    self:AddCallback("fatal_main_menu", ui_events.BUTTON_CLICKED, self.OnFatalMainMenu, self)
    debug_trace("GA_DEBUG_START_BOUND", "Arena Start callback registration completed", {
        callback_type = type(self.OnStart),
        control_type = type(self.start_button)
    })
end

function UIStart:SetDifficulty(difficulty_id)
    local selected = 1
    for index, value in ipairs(difficulty_ids) do
        if value == difficulty_id then
            selected = index
            break
        end
    end
    self.difficulty_combo:enable_id(selected)
    self.difficulty_combo:SetText(translated(difficulty_string_ids[difficulty_ids[selected]]))
end

function UIStart:GetDifficulty()
    local current = self.difficulty_combo:GetText()
    for _, difficulty_id in ipairs(difficulty_ids) do
        if current == translated(difficulty_string_ids[difficulty_id]) then
            return difficulty_id
        end
    end
    return nil
end

function UIStart:LoadSettings()
    if not axr_main or not axr_main.config then
        self:ShowFatal({ gamma_arena_result.err("GA_SETTINGS_CONFIG_UNAVAILABLE", "axr_main.config is unavailable") })
        return
    end
    local migrated = gamma_arena_migrations.migrate(axr_main.config)
    if not migrated.ok then
        self:ShowFatal({ migrated })
        return
    end
    for _, event in ipairs(migrated.value.events or {}) do
        gamma_arena_log.info(event.code, "Settings migration event", event)
    end
    self:SetDifficulty(migrated.value.last_difficulty_id)
    if migrated.value.last_seed_mode == "random" then
        self:OnRandomSeed()
    else
        self.seed_mode = "manual"
        self.seed_edit:SetText("")
    end
end

function UIStart:ShowValidation(result)
    local code = result and result.error and result.error.code or "GA_START_REQUEST_INVALID"
    self.validation:SetText(translated("st_gamma_arena_seed_invalid") .. " [" .. tostring(code) .. "]")
    self.validation:Show(true)
end

function UIStart:OnRandomSeed()
    local provider = self.ports and self.ports.random_seed_provider or nil
    local generated = gamma_arena_session_store.random_session_seed(provider)
    if not generated.ok then
        self:ShowFatal({ generated })
        return
    end
    self.seed_mode = "random"
    self.last_random_seed_text = tostring(generated.value)
    self.seed_edit:SetText(self.last_random_seed_text)
    self.validation:Show(false)
end

local function handoff_failure(config, failure)
    local cleared = gamma_arena_session_store.clear_transient(config)
    if not cleared.ok then return cleared end
    return failure
end

function issue_launch_with_defeat_recovery(config, request, ports)
    ports = ports or {}
    local issue_launch = ports.issue_launch or gamma_arena_session_store.issue_launch
    local launch_options = ports.launch_options
    local function issue()
        return issue_launch(config, request, launch_options)
    end
    local function retry_stale(result)
        if not result.ok and result.error and result.error.code == "GA_LAUNCH_STALE_CLEARED" then
            return issue()
        end
        return result
    end

    local launch = retry_stale(issue())
    if launch.ok or not launch.error or launch.error.code ~= "GA_INTENT_CONFLICT" then return launch end

    local peek_defeat = ports.peek_defeat or gamma_arena_session_store.peek_defeat
    local defeat = peek_defeat(config)
    if not defeat.ok then return defeat end
    if not defeat.value then return launch end

    local clear_defeat = ports.clear_defeat or gamma_arena_session_store.clear_defeat
    local cleared = clear_defeat(config)
    if not cleared.ok then return cleared end
    return retry_stale(issue())
end

function handoff_start_game(owner, config)
    local lookup_ok, method = pcall(function() return owner and owner.StartGame end)
    if not lookup_ok or type(method) ~= "function" then
        return handoff_failure(config, gamma_arena_result.err("GA_START_GAME_UNAVAILABLE", "Main menu does not expose StartGame"))
    end
    local ok, detail = pcall(method, owner)
    if not ok then
        return handoff_failure(config, gamma_arena_result.err("GA_START_GAME_FAILED", "Engine new-game start failed", { detail = tostring(detail) }))
    end
    if detail == false then
        return handoff_failure(config, gamma_arena_result.err("GA_START_GAME_FAILED", "Engine new-game start reported failure"))
    end
    if type(detail) == "table" and detail.ok == false then return handoff_failure(config, detail) end
    return gamma_arena_result.ok(detail)
end

function preflight_runtime(ports)
    ports = ports or {}
    local runtime_status = ports.runtime_status
    if runtime_status == nil then
        debug_trace("GA_DEBUG_START_BOOTSTRAP_LOOKUP_BEGIN", "Arena runtime bootstrap lookup began")
        local namespace_ok, bootstrap = pcall(function() return gamma_arena_bootstrap end)
        debug_trace("GA_DEBUG_START_BOOTSTRAP_LOOKUP_RESULT", "Arena runtime bootstrap lookup returned", {
            ok = namespace_ok,
            bootstrap_type = type(bootstrap)
        })
        if not namespace_ok or type(bootstrap) ~= "table" then
            return gamma_arena_result.err("GA_START_RUNTIME_UNAVAILABLE", "Arena runtime bootstrap is unavailable")
        end
        debug_trace("GA_DEBUG_START_INITIALIZER_LOOKUP_BEGIN", "Arena runtime initializer lookup began")
        local initializer_ok, initializer = pcall(function() return bootstrap.ensure_initialized end)
        debug_trace("GA_DEBUG_START_INITIALIZER_LOOKUP_RESULT", "Arena runtime initializer lookup returned", {
            ok = initializer_ok,
            initializer_type = type(initializer)
        })
        if not initializer_ok or type(initializer) ~= "function" then
            return gamma_arena_result.err("GA_START_RUNTIME_UNAVAILABLE", "Arena runtime initializer is unavailable")
        end
        debug_trace("GA_DEBUG_START_INITIALIZER_CALL_BEGIN", "Arena runtime initializer call began")
        local initialized_ok, initialized = pcall(initializer)
        debug_trace("GA_DEBUG_START_INITIALIZER_CALL_RESULT", "Arena runtime initializer call returned", {
            call_ok = initialized_ok,
            result = debug_result_context(initialized)
        })
        if not initialized_ok then
            return gamma_arena_result.err("GA_START_RUNTIME_STATUS_FAILED", "Arena runtime initialization failed", { detail = tostring(initialized) })
        end
        if type(initialized) ~= "table" or type(initialized.ok) ~= "boolean" then
            return gamma_arena_result.err("GA_START_RUNTIME_STATUS_INVALID", "Arena runtime initialization returned an invalid Result")
        end
        if initialized.ok == false then return initialized end
        debug_trace("GA_DEBUG_START_STATUS_LOOKUP_BEGIN", "Arena runtime status lookup began")
        local method_ok, method = pcall(function() return bootstrap.runtime_status end)
        debug_trace("GA_DEBUG_START_STATUS_LOOKUP_RESULT", "Arena runtime status lookup returned", {
            ok = method_ok,
            method_type = type(method)
        })
        if not method_ok or type(method) ~= "function" then
            return gamma_arena_result.err("GA_START_RUNTIME_UNAVAILABLE", "Arena runtime readiness check is unavailable")
        end
        runtime_status = method
    end
    if type(runtime_status) ~= "function" then
        return gamma_arena_result.err("GA_START_RUNTIME_UNAVAILABLE", "Arena runtime readiness check is unavailable")
    end
    debug_trace("GA_DEBUG_START_STATUS_CALL_BEGIN", "Arena runtime readiness call began")
    local called, status = pcall(runtime_status)
    debug_trace("GA_DEBUG_START_STATUS_CALL_RESULT", "Arena runtime readiness call returned", {
        call_ok = called,
        result = debug_result_context(status)
    })
    if not called then
        return gamma_arena_result.err("GA_START_RUNTIME_STATUS_FAILED", "Arena runtime readiness check failed", { detail = tostring(status) })
    end
    if type(status) ~= "table" or type(status.ok) ~= "boolean" then
        return gamma_arena_result.err("GA_START_RUNTIME_STATUS_INVALID", "Arena runtime readiness check returned an invalid Result")
    end
    if status.ok == false then
        if type(status.error) ~= "table" or type(status.error.code) ~= "string" or type(status.error.message) ~= "string" then
            return gamma_arena_result.err("GA_START_RUNTIME_STATUS_INVALID", "Arena runtime readiness check returned an invalid Result")
        end
        return status
    end
    return status
end

function begin_start(owner, config, request, ports)
    ports = ports or {}
    debug_trace("GA_DEBUG_START_PREFLIGHT_BEGIN", "Arena Start runtime preflight began")
    local runtime = preflight_runtime(ports)
    debug_trace("GA_DEBUG_START_PREFLIGHT_RESULT", "Arena Start runtime preflight returned", debug_result_context(runtime))
    if not runtime.ok then return runtime end

    local save_preferences = ports.save_preferences or gamma_arena_session_store.save_preferences
    debug_trace("GA_DEBUG_START_PREFERENCES_BEGIN", "Arena Start preference persistence began")
    local preferences = save_preferences(config, request.difficulty_id, request.seed_mode)
    debug_trace("GA_DEBUG_START_PREFERENCES_RESULT", "Arena Start preference persistence returned", debug_result_context(preferences))
    if not preferences.ok then return preferences end

    debug_trace("GA_DEBUG_START_INTENT_BEGIN", "Arena Start launch intent began")
    local launch = issue_launch_with_defeat_recovery(config, request, ports)
    debug_trace("GA_DEBUG_START_INTENT_RESULT", "Arena Start launch intent returned", debug_result_context(launch))
    if not launch.ok then return launch end

    local write_character_creation = ports.write_character_creation or gamma_arena_session_store.write_character_creation
    debug_trace("GA_DEBUG_START_BRIDGE_BEGIN", "Arena Start character-creation bridge began")
    local bridge = write_character_creation(config)
    debug_trace("GA_DEBUG_START_BRIDGE_RESULT", "Arena Start character-creation bridge returned", debug_result_context(bridge))
    if not bridge.ok then
        local clear_transient = ports.clear_transient or gamma_arena_session_store.clear_transient
        clear_transient(config)
        return bridge
    end

    debug_trace("GA_DEBUG_START_HANDOFF_BEGIN", "Arena Start engine handoff began")
    local handoff = (ports.handoff_start_game or handoff_start_game)(owner, config)
    debug_trace("GA_DEBUG_START_HANDOFF_RESULT", "Arena Start engine handoff returned", debug_result_context(handoff))
    if not handoff.ok then return handoff end
    return handoff
end

function UIStart:OnStart()
    debug_trace("GA_DEBUG_START_CLICK", "Arena Start callback entered")
    local seed_text = self.seed_edit:GetText()
    local difficulty_id = self:GetDifficulty()
    debug_trace("GA_DEBUG_START_INPUT", "Arena Start input captured", {
        difficulty_id = difficulty_id,
        difficulty_text = self.difficulty_combo:GetText(),
        seed_mode = self.seed_mode,
        seed_text = seed_text
    })
    local seed_result = gamma_arena_session_store.parse_manual_seed(seed_text)
    if not seed_result.ok then
        debug_trace("GA_DEBUG_START_VALIDATION_FAILED", "Arena Start seed validation failed", debug_result_context(seed_result))
        self:ShowValidation(seed_result)
        return
    end
    local seed_mode = self.seed_mode
    if seed_mode == "random" and seed_text ~= self.last_random_seed_text then
        seed_mode = "manual"
    end
    local request = gamma_arena_session_store.validate_start_request({
        schema_version = 1,
        mode_id = "skirmish",
        difficulty_id = difficulty_id,
        seed_mode = seed_mode,
        session_seed = seed_result.value
    })
    if not request.ok then
        debug_trace("GA_DEBUG_START_VALIDATION_FAILED", "Arena Start request validation failed", debug_result_context(request))
        self:ShowValidation(request)
        return
    end
    debug_trace("GA_DEBUG_START_VALIDATED", "Arena Start request validation passed", {
        difficulty_id = request.value.difficulty_id,
        seed_mode = request.value.seed_mode,
        session_seed = request.value.session_seed
    })
    self.validation:Show(false)
    local started = begin_start(self.owner, axr_main.config, request.value, self.ports)
    debug_trace("GA_DEBUG_START_RESULT", "Arena Start pipeline returned", debug_result_context(started))
    if not started.ok then self:ShowFatal({ started }) end
end

function UIStart:RestoreOwner()
    if self.owner then
        if type(self.owner.ShowDialog) == "function" then
            self.owner:ShowDialog(true)
        end
        if type(self.owner.Show) == "function" then
            self.owner:Show(true)
        end
    end
    self:HideDialog()
    self:Show(false)
end

function UIStart:OnBack()
    self:RestoreOwner()
end

function UIStart:SetFatalMainMenuHandler(callback, context)
    if callback ~= nil and type(callback) ~= "function" then
        return gamma_arena_result.err("GA_FATAL_HANDLER_INVALID", "Fatal main-menu handler must be a function")
    end
    self.fatal_main_menu_callback = callback
    self.fatal_main_menu_context = context
    return gamma_arena_result.ok(true)
end

function UIStart:ShowFatal(errors, callback, context)
    if callback ~= nil then
        local handler = self:SetFatalMainMenuHandler(callback, context)
        if not handler.ok then
            errors = { handler }
        end
    end
    local lines = {}
    if type(errors) == "table" then
        for index = 1, #errors do
            local item = errors[index]
            if type(item) == "table" and item.error then
                gamma_arena_log.error(item.error.code or "GA_UNKNOWN", item.error.message or "Fatal UI error", item.error.context)
            end
            lines[#lines + 1] = result_line(errors[index])
        end
    end
    if #lines == 0 then
        lines[1] = "GA_UNKNOWN: " .. translated("st_gamma_arena_fatal_unknown")
    end
    self.start_form:Show(false)
    self.fatal_text:SetText(table.concat(lines, "\n"))
    self.fatal:Show(true)
end

function invoke_fatal_main_menu(callback, context, dialog)
    if type(callback) ~= "function" then
        return gamma_arena_result.err("GA_FATAL_HANDLER_INVALID", "Fatal main-menu handler must be a function")
    end
    local ok, result = pcall(callback, context, dialog)
    if not ok then
        return gamma_arena_result.err("GA_FATAL_ACTION_FAILED", "Fatal main-menu action failed safely", { reason = tostring(result) })
    end
    if result == false then
        return gamma_arena_result.err("GA_FATAL_ACTION_FAILED", "Fatal main-menu action reported failure")
    end
    if type(result) == "table" and type(result.ok) == "boolean" then return result end
    return gamma_arena_result.ok(result)
end

function UIStart:OnFatalMainMenu()
    if self.fatal_main_menu_callback then
        return invoke_fatal_main_menu(self.fatal_main_menu_callback, self.fatal_main_menu_context, self)
    end
    self:RestoreOwner()
    return gamma_arena_result.ok(false)
end

function UIStart:OnKeyboard(dik, keyboard_action)
    local result = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if result == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
        if self.fatal:IsShown() then
            self:OnFatalMainMenu()
        else
            self:OnBack()
        end
    end
    return result
end

function create(owner, ports)
    return UIStart(owner, ports)
end

function show_fatal(owner, errors, callback, context)
    fatal_dialog = create(owner, { fatal_only = true })
    fatal_dialog:ShowFatal(errors, callback, context)
    fatal_dialog:ShowDialog(true)
    if owner then
        if type(owner.HideDialog) == "function" then owner:HideDialog() end
        if type(owner.Show) == "function" then owner:Show(false) end
    end
    return fatal_dialog
end

function clear_fatal()
    local dialog = fatal_dialog
    if dialog == nil then return gamma_arena_result.ok(false) end
    local cleared, reason = pcall(function()
        dialog:HideDialog()
        dialog:Show(false)
    end)
    if not cleared then
        return gamma_arena_result.err("GA_FATAL_UI_CLEAR_FAILED", "Arena fatal dialog could not be dismissed safely", {
            reason = tostring(reason)
        })
    end
    if fatal_dialog == dialog then fatal_dialog = nil end
    return gamma_arena_result.ok(true)
end
