local MAX_NATIVE_PAYLOAD_BYTES = 1024
local CHUNK_BODY_BYTES = 896

local function safe_tostring(value)
    local ok, text = pcall(tostring, value)
    if ok then
        return text
    end
    return "<unserializable>"
end

local function canonical_key(key)
    local key_type = type(key)
    if key_type == "string" then
        return "string:" .. #key .. ":" .. key
    end
    if key_type == "boolean" then
        return key and "boolean:true" or "boolean:false"
    end
    if key_type == "number" then
        if key ~= key or key == math.huge or key == -math.huge then
            return nil
        end
        if key == 0 then
            key = 0
        end
        return "number:" .. string.format("%.17g", key)
    end
    return nil
end

local function serialize(value, seen)
    local value_type = type(value)
    if value_type == "nil" or value_type == "number" or value_type == "boolean" then
        return safe_tostring(value)
    end
    if value_type == "string" then
        return string.format("%q", value)
    end
    if value_type ~= "table" then
        return "<" .. value_type .. ":" .. safe_tostring(value) .. ">"
    end

    if seen[value] then
        return "<cycle>"
    end
    seen[value] = true

    local entries = {}
    local seen_keys = {}
    local collected, collect_error = pcall(function()
        for key, item in pairs(value) do
            local canonical = canonical_key(key)
            local existing_index = canonical and seen_keys[canonical]
            if existing_index then
                entries[existing_index].value = "<canonical-key-collision>"
            elseif canonical then
                seen_keys[canonical] = #entries + 1
                entries[#entries + 1] = {
                    key = canonical,
                    value = item
                }
            end
        end
    end)
    if not collected then
        seen[value] = nil
        return "<unserializable:" .. safe_tostring(collect_error) .. ">"
    end

    table.sort(entries, function(left, right)
        return left.key < right.key
    end)

    local values = {}
    for index = 1, #entries do
        local entry = entries[index]
        values[#values + 1] = entry.key .. "=" .. serialize(entry.value, seen)
    end
    seen[value] = nil
    return "{" .. table.concat(values, ",") .. "}"
end

local function format_context(context)
    if context == nil then
        return ""
    end

    local ok, text = pcall(serialize, context, {})
    if ok then
        return " context=" .. text
    end
    return " context=<unserializable>"
end

local function emit_native(native_payload)
    pcall(printf, "%s", native_payload)
end

local function write(code, message, context)
    local logical_line = "[GammaArena][" .. safe_tostring(code) .. "] "
        .. safe_tostring(message) .. format_context(context)
    if #logical_line <= MAX_NATIVE_PAYLOAD_BYTES then
        emit_native(logical_line)
        return
    end
    local total = math.ceil(#logical_line / CHUNK_BODY_BYTES)
    for part = 1, total do
        local first = ((part - 1) * CHUNK_BODY_BYTES) + 1
        local body = string.sub(logical_line, first, first + CHUNK_BODY_BYTES - 1)
        local native_payload = "[GammaArena][GA_LOG_CHUNK " .. tostring(part) .. "/" .. tostring(total) .. "] " .. body
        if #native_payload <= MAX_NATIVE_PAYLOAD_BYTES then emit_native(native_payload) end
    end
end

function info(code, message, context)
    write(code, message, context)
end

function warn(code, message, context)
    write(code, message, context)
end

function error(code, message, context)
    write(code, message, context)
end
