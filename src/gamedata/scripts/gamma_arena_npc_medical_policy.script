local SECTION = "plugin"

local function fail(message, context)
    return gamma_arena_result.err("GA_NPC_MEDICAL_POLICY_INVALID", message, context or {})
end

local function trim(value)
    return string.gsub(value, "^%s*(.-)%s*$", "%1")
end

local function read_entry(config, key)
    local methods_ok, line_exist, r_string_ex = pcall(function()
        return config.line_exist, config.r_string_ex
    end)
    if not methods_ok or type(line_exist) ~= "function" or type(r_string_ex) ~= "function" then
        return fail("NPC medical policy config lacks effective INI accessors", { key = key })
    end

    local presence_ok, present = pcall(line_exist, config, SECTION, key)
    if not presence_ok or type(present) ~= "boolean" then
        return fail("NPC medical policy key presence could not be read", { key = key })
    end
    if not present then return gamma_arena_result.ok({ present = false }) end

    local value_ok, value = pcall(r_string_ex, config, SECTION, key)
    if not value_ok or type(value) ~= "string" then
        return fail("NPC medical policy value is invalid", { key = key })
    end
    return gamma_arena_result.ok({ present = true, value = value })
end

local function parse_boolean(entry)
    if not entry.present then return true, false end
    local value = string.lower(trim(entry.value))
    if value == "true" or value == "on" or value == "yes" or value == "1" then return true, true end
    if value == "false" or value == "off" or value == "no" or value == "0" then return true, false end
    return false, nil
end

local function contains_exact(list, target)
    for token in string.gmatch(list, "[^,]+") do
        if trim(token) == target then return true end
    end
    return false
end

function read(config)
    local entries = {}
    for _, key in ipairs({ "enable", "in_combat", "medkits", "bandages" }) do
        local entry = read_entry(config, key)
        if not entry.ok then return entry end
        entries[key] = entry.value
    end

    local enable_ok, enable = parse_boolean(entries.enable)
    if not enable_ok then return fail("NPC medical policy enable is malformed", { key = "enable" }) end
    local combat_ok, in_combat = parse_boolean(entries.in_combat)
    if not combat_ok then return fail("NPC medical policy in_combat is malformed", { key = "in_combat" }) end

    local medkit_overlap = entries.medkits.present and contains_exact(entries.medkits.value, "medkit") or false
    local bandage_overlap = entries.bandages.present and contains_exact(entries.bandages.value, "bandage") or false
    local owner = enable and in_combat and (medkit_overlap or bandage_overlap) and "external" or "arena"
    return gamma_arena_result.ok({
        owner = owner,
        enable = enable,
        in_combat = in_combat,
        medkit_overlap = medkit_overlap,
        bandage_overlap = bandage_overlap
    })
end
